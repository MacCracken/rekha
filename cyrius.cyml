[package]
name = "rekha"
version = "${file:VERSION}"
description = "rekha (रेखा — line/outline) — pure-Cyrius vector/outline font subsystem for AGNOS: TrueType/OpenType (SFNT) table parser + glyph-outline loader that emits paths for the sadish 2D vector core to rasterize. The scalable-typography sibling to kashi's bitmap glyphs."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/rekha"
language = "cyrius"
cyrius = "6.6.20"

# rekha is a library — no CLI binary. `cyrius build` targets a smoke
# program that links the full include chain to prove lib.cyr parses clean.
# Consumers pull `dist/rekha.cyr` via a `[deps.rekha]` entry at a git tag.
[build]
entry = "programs/smoke.cyr"
output = "build/rekha-smoke"

# `[lib]` feeds `cyrius distlib` — module order matters: stdlib first
# (declared in src/lib.cyr), then domain modules in dependency order.
# error.cyr is dep-free; sfnt.cyr uses it; glyf.cyr sits atop sfnt.cyr.
# Don't reorder without re-running `cyrius distlib` and verifying the
# concatenated bundle still compiles clean.
# ⭐ src/freeze.cyr FIRST in both lists (0.9.0): its one code line, `private`, makes the whole
# concatenated bundle private-by-default, so a consumer reaches exactly the `public fn` /
# `public var` items. It is not in src/lib.cyr's include chain — the tests keep every internal.
[lib]
modules = [
    "src/freeze.cyr",
    "src/error.cyr",
    "src/sfnt.cyr",
    "src/glyf.cyr",
    "src/cmap.cyr",
    "src/cff.cyr",
    "src/cff2.cyr",
    "src/var.cyr",
    "src/gvar.cyr",
    "src/hvar.cyr",
    "src/os2.cyr",
    "src/name.cyr",
    "src/stat.cyr",
    "src/post.cyr",
    "src/vert.cyr",
    "src/gpos.cyr",
    "src/kern.cyr",
    "src/hint.cyr",
]

# `[lib.woff]` (`cyrius distlib woff` -> dist/rekha-woff.cyr) is rekha PLUS the two web-container
# readers: src/woff.cyr (WOFF 1.0, zlib per table) and src/woff2.cyr (WOFF2 — one Brotli stream and
# the glyf / loca and hmtx transforms, 0.4.6). Both call into sankoch — `zlib_decompress_capped`
# (>= 2.7.13) and `brotli_decompress_capped` (>= 2.8.0) — so this stays a separate bundle:
# `dist/rekha.cyr` must never require sankoch. A consumer that wants either container takes this
# bundle INSTEAD of dist/rekha.cyr and brings sankoch itself (the stdlib `sankoch` leaf + `sync`).
# ⭐ ONE bundle for both, deliberately: sankoch's ADR 0001 shaped its own `[lib.woff]` profile the
# same way — the zlib module list PLUS Brotli — so a consumer links one sankoch and gets both.
# ⚠ ORDER: woff2.cyr must FOLLOW woff.cyr, whose rekha_wr_u16 / rekha_wr_u32 / rekha_pad4 it uses.
# rekha's own tests include lib/sync.cyr and lib/sankoch.cyr from the toolchain pin.
[lib.woff]
modules = [
    "src/freeze.cyr",
    "src/error.cyr",
    "src/sfnt.cyr",
    "src/glyf.cyr",
    "src/cmap.cyr",
    "src/cff.cyr",
    "src/cff2.cyr",
    "src/var.cyr",
    "src/gvar.cyr",
    "src/hvar.cyr",
    "src/os2.cyr",
    "src/name.cyr",
    "src/stat.cyr",
    "src/post.cyr",
    "src/vert.cyr",
    "src/gpos.cyr",
    "src/kern.cyr",
    "src/hint.cyr",
    "src/woff.cyr",
    "src/woff2.cyr",
]

[deps]
# What rekha's OWN builds need from the stdlib — `memcpy`, for the two WOFF modules — and,
# since cyrius 6.6.18, nothing a consumer pays for.
# ⭐ THE PUBLISHED SIDECAR IS EMPTY AS OF 1.0.0 (ADR 0010). From 6.6.18 `cyrius distlib` writes a
# bundle's `.deps` from its compile-verify fixpoint ALONE — six targets, the bundle compiled with
# exactly the leaves under test — and no longer unions in this array or the include scan of
# src/lib.cyr (rekha's own filing, cyrius proposal 2026-09-16, shipped as option 2). The base
# modules have called nothing in `lib/string.cyr` since 0.5.0 took `strlen` out with
# `rekha_err_print_name`, so the fixpoint proves NO leaf and dist/rekha.deps is not written at all;
# dist/rekha-woff.deps is `string` (woff.cyr / woff2.cyr call memcpy) + `sankoch`, and the WOFF
# bundle opens with those two as a compile-verified requires block.
# History, kept because CI's leaf pin cites it: through 0.4.3 this array and the umbrella named
# nine leaves and the sidecar said nine; 0.4.4 cut it to `string` + `alloc`, 0.4.5 to `string`
# (cyrius 6.6.6 made lib/string.cyr include alloc itself), and from 0.5.0 to 0.9.0 that `string`
# was the union's doing — a leaf every consumer vendored for nothing.
#
# rekha's own harness wants eight more (fmt_int_fd, arena_*, str_same, assert_*, bench_*) —
# declared in programs/prelude.cyr. An include resolves from vendored lib/ first and from the
# pinned toolchain snapshot otherwise, the path programs/woff_test.cyr has always used for
# sync + sankoch (lib/ has never held either).
#
# sankoch is deliberately NOT here: rekha's base build never calls it. WOFF 1.0 and WOFF2
# (src/woff.cyr, src/woff2.cyr, [lib.woff]) resolve `sync` + `sankoch` from the toolchain pin in
# their own tests. The 6.6.20 snapshot carries sankoch 2.8.1 — a toolchain release with NO source
# change from 2.8.0, whose `brotli_decompress_capped` and `[lib.woff]` profile (the zlib modules
# PLUS Brotli, sankoch ADR 0001-brotli-decoder-placement.md) src/woff2.cyr has consumed since 0.4.6.
# The published floor for dist/rekha-woff.cyr stays sankoch >= 2.8.0.
stdlib = ["string"]

# sadish — the rasterize target. rekha emits glyph-outline PATHS
# (moveto/lineto/quadto/close); sadish fills them to coverage. rekha does NOT
# bundle its own Bézier rasterizer.
# ⛔ FLOOR >= 0.9.0, HARD (0.4.3); PINNED AT 0.11.2 (0.4.5). Three sadish releases are load-bearing
# here: `sd_alloc` (0.5.5) takes every allocation rekha makes, `sd_path_new_cap` (0.7.2) opens a path
# at the glyph's own size, and 0.9.0 stores a path's points INLINE — rekha's tests read them through
# `sd_path_point_x` / `_y`, which 0.8.0 and below do not define. ⛔ Against an older pin the build MAY
# still go green: cyrius judges an undefined name by its FIRST call site in code order, and rekha's is
# rekha_err_new (src/error.cyr), dead in every suite — so a suite COMPILES with `warning: undefined
# function` and dies (SIGILL, rc 132) at the first call, while a fold whose first site is live is
# refused outright. MEASURED both ways on 6.6.4; see CHANGELOG 0.3.10. Grep build output for
# `undefined function` — printed in both cases. ⚠ The reverse mistake is silent: rekha builds against
# sadish's DIST, so a stale lib/ looks fine. The provenance check that does not rot is
# `grep -c '^fn sd_path_point_x' lib/sadish.cyr` — 1 on 0.9.0 and up, 0 below (sadish's filing,
# 2026-09-16).
# ⚠ 0.10.0 IS AN ABI BREAK AND IT DOES NOT TOUCH REKHA: it moved `SdPolyline`'s points inline, so
# `sd_polyline_points` now strides 16 and an open-coded `load64(points + i * 8)` reads a COORDINATE as
# an address. VERIFIED at the 0.4.5 bump — `grep -rn polyline src programs` is empty; rekha consumes
# `sd_path_*` and never a flatten output. A consumer that does walk polylines must port to
# `sd_polyline_point_x` / `_y` before taking this pin.
# dhancha vendors dist/rekha.cyr AND dist/sadish.cyr separately, so its own sadish pin must clear
# the same floor.
[deps.sadish]
git = "https://github.com/MacCracken/sadish.git"
# ⛔ NO `path` LINE IN THE COMMITTED MANIFEST (removed 0.3.11). `path` WINS over `tag` and skips
# the commit-pin verify, so while it was here cyrius.lock could never carry a sadish `commit` line
# and a green local build was not evidence the tag resolves. 0.3.10 re-added it only because the
# 0.5.5 tag did not exist yet; it is published now (9760ead), so the tag is the source of truth.
# For cross-repo dev, add `path = "../sadish"` in an UNCOMMITTED working copy — CI refuses a
# manifest with a live `path =` line.
tag = "0.11.2"
modules = ["dist/sadish.cyr"]

# fonts/face_data.cyr — the embedded DEFAULT FACE, a freestanding data module (no stdlib) a
# kernel consumes by PATH, the way agnos consumes kashi's src/font_data.cyr:
#     [deps.rekha]
#     path    = "../rekha"
#     modules = ["fonts/face_data.cyr"]
# Deliberately NOT in [lib].modules: it is 1.6 MB of generated literals and must never ride
# into dist/rekha.cyr. Regenerate with `python3 scripts/face2cyr.py fonts/<face>.ttf
# fonts/face_data.cyr`; CI requires the committed module to match a fresh regeneration.
