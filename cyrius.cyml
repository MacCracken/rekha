[package]
name = "rekha"
version = "${file:VERSION}"
description = "rekha (रेखा — line/outline) — pure-Cyrius vector/outline font subsystem for AGNOS: TrueType/OpenType (SFNT) table parser + glyph-outline loader that emits paths for the sadish 2D vector core to rasterize. The scalable-typography sibling to kashi's bitmap glyphs."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/rekha"
language = "cyrius"
cyrius = "6.6.4"

# rekha is a library — no CLI binary. `cyrius build` targets a smoke
# program that links the full include chain to prove lib.cyr parses clean.
# Consumers pull `dist/rekha.cyr` via a `[deps.rekha]` entry at a git tag.
[build]
entry = "programs/smoke.cyr"
output = "build/rekha-smoke"

# `[lib]` feeds `cyrius distlib` — module order matters: stdlib first
# (declared in src/lib.cyr), then domain modules in dependency order.
# error.cyr is dep-free; sfnt.cyr uses it; glyf.cyr sits atop sfnt.cyr.
# Don't reorder without re-running `cyrius distlib` and verifying the
# concatenated bundle still compiles clean.
[lib]
modules = [
    "src/error.cyr",
    "src/sfnt.cyr",
    "src/glyf.cyr",
    "src/cmap.cyr",
]

[deps]
# Stdlib base set — byte readers + struct alloc + smoke banner + the
# assert/bench harness. No inflate/thread here: SFNT tables are read
# raw (uncompressed) at v0.1.0. WOFF/WOFF2 (which DO need sankoch
# inflate + Brotli) are a later scope.
stdlib = [
    "string",
    "fmt",
    "alloc",
    "io",
    "vec",
    "str",
    "syscalls",
    "assert",
    "bench",
]

# sadish — the rasterize target. rekha emits glyph-outline PATHS
# (moveto/lineto/quadto/close); sadish fills them to coverage. rekha does NOT
# bundle its own Bézier rasterizer.
# ⛔ FLOOR >= 0.5.5, HARD: every allocation rekha makes goes through `sd_alloc`
# (0.3.10), which 0.5.4 and below do not define. ⛔ Against an older pin the
# build MAY still go green: cyrius 6.6.4 judges an undefined name by its FIRST
# call site in code order, and rekha's is rekha_err_new (src/error.cyr), dead
# in every suite — so path_test/glyf_test COMPILE with `warning: undefined
# function 'sd_alloc'` and die (SIGILL, rc 132) at the first rekha_font_open,
# while a fold whose first site is live (crab via dhancha 0.10.0) is refused
# outright. MEASURED both ways; see CHANGELOG 0.3.10. Grep build output for
# `undefined function` — it is printed in both cases. dhancha vendors
# dist/rekha.cyr AND dist/sadish.cyr separately, so its own sadish pin must
# clear the same floor.
[deps.sadish]
git = "https://github.com/MacCracken/sadish.git"
# ⚠ `path` re-added 0.3.10, for the same reason dhancha carries one: without it rekha can only
# build against a PUBLISHED sadish tag, and 0.3.10 depends on `sd_alloc`, which landed in sadish
# 0.5.5 minutes earlier and was not yet tagged.
# ⛔ `path` WINS over `tag`, so a green build here is NOT evidence the declared tag resolves.
# Re-verify with the `path` line disabled before any release that moves this tag.
path = "../sadish"
tag = "0.5.5"
modules = ["dist/sadish.cyr"]

# fonts/face_data.cyr — the embedded DEFAULT FACE, a freestanding data module (no stdlib) a
# kernel consumes by PATH, the way agnos consumes kashi's src/font_data.cyr:
#     [deps.rekha]
#     path    = "../rekha"
#     modules = ["fonts/face_data.cyr"]
# Deliberately NOT in [lib].modules: it is 1.6 MB of generated literals and must never ride
# into dist/rekha.cyr. Regenerate with `python3 scripts/face2cyr.py fonts/<face>.ttf
# fonts/face_data.cyr`; CI requires the committed module to match a fresh regeneration.
