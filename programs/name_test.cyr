# programs/name_test.cyr — RUN test for the `name` table (src/name.cyr).
#
# ⭐ THE FONT IS BUILT HERE — head / maxp / hhea / hmtx / loca / glyf / name, with the records and
# their raw string bytes written a byte at a time, so a record can be given any platform, any
# encoding and any malformed string the decoder has to refuse.
#
# ⭐ GROUP D IS THE ONE THAT MATTERS MOST. Macintosh Roman's high half is 128 entries that nothing
# derives, and a single wrong one puts a single wrong character in a name — the quietest possible
# failure. It is checked against programs/mac_roman_vectors.cyr, generated by
# scripts/mac_roman.py from PYTHON'S OWN `mac_roman` codec and from nothing in rekha, and the
# UTF-8 that comes back is decoded HERE rather than compared against rekha's own encoder.
#
# Exit code = failed checks; each failure prints its number, group, got and want.

include "programs/prelude.cyr"
include "programs/mac_roman_vectors.cyr"

var g_fails = 0;
var g_n = 0;
var g_group = "";

fn check(got, want): i64 {
    g_n = g_n + 1;
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    var m = "name_test: check failed at #";
    syscall(1, 2, m, strlen(m));
    fmt_int_fd(2, g_n);
    syscall(1, 2, " (", 2);
    syscall(1, 2, g_group, strlen(g_group));
    syscall(1, 2, ") got ", 6);
    fmt_int_fd(2, got);
    syscall(1, 2, " want ", 6);
    fmt_int_fd(2, want);
    syscall(1, 2, "\n", 1);
    return 1;
}

var FB = 0;
var FB_CAP = 16384;
var NG = 2;
var OUT = 0;
var OUT_CAP = 1024;

fn pu16(off, v): i64 {
    store8(FB + off, (v >> 8) & 255);
    store8(FB + off + 1, v & 255);
    return 0;
}

fn pu32(off, v): i64 {
    pu16(off, (v >> 16) & 65535);
    pu16(off + 2, v & 65535);
    return 0;
}

# ── records under construction ────────────────────────────
var REC_MAX = 24;
var g_rec = 0;          # i64[REC_MAX * 6]: plat, enc, lang, id, str offset, str length
var g_nrec = 0;
var g_pool = 0;
var g_pooln = 0;
var g_cur = 0;

fn nr_reset(): i64 {
    g_nrec = 0;
    g_pooln = 0;
    return 0;
}

fn nr_begin(plat, enc, lang, id): i64 {
    g_cur = g_nrec;
    store64(g_rec + g_cur * 48, plat);
    store64(g_rec + g_cur * 48 + 8, enc);
    store64(g_rec + g_cur * 48 + 16, lang);
    store64(g_rec + g_cur * 48 + 24, id);
    store64(g_rec + g_cur * 48 + 32, g_pooln);
    store64(g_rec + g_cur * 48 + 40, 0);
    g_nrec = g_nrec + 1;
    return g_cur;
}

fn nr_b(v): i64 {
    store8(g_pool + g_pooln, v & 255);
    g_pooln = g_pooln + 1;
    store64(g_rec + g_cur * 48 + 40, load64(g_rec + g_cur * 48 + 40) + 1);
    return 0;
}

fn nr_u16(v): i64 {
    nr_b((v >> 8) & 255);
    return nr_b(v & 255);
}

# an ASCII cstring as UTF-16BE
fn nr_utf16(s): i64 {
    var i = 0;
    var n = strlen(s);
    while (i < n) {
        nr_u16(load8(s + i));
        i = i + 1;
    }
    return 0;
}

# an ASCII cstring as Macintosh Roman (which agrees with ASCII below 0x80)
fn nr_mac(s): i64 {
    var i = 0;
    var n = strlen(s);
    while (i < n) {
        nr_b(load8(s + i));
        i = i + 1;
    }
    return 0;
}

# ── build options ────────────────────────────────
var o_noname = 0;       # omit the table
var o_fmt = 0;          # the format to write (2 must be refused)
var o_shortrec = 0;     # declare more records than the table holds
var o_badstr = 0;       # push the last record's string past the table
var o_nofvar = 1;

var g_name = 0;
var g_namelen = 0;
var g_flen = 0;

fn put_name(at): i64 {
    var extra = 0;
    if (o_fmt == 1) { extra = 2; }                      # langTagCount, with no records after it
    var so = 6 + extra + g_nrec * 12;
    pu16(at, o_fmt);
    var dn = g_nrec;
    if (o_shortrec != 0) { dn = g_nrec + 4; }
    pu16(at + 2, dn);
    pu16(at + 4, so);
    if (o_fmt == 1) { pu16(at + 6 + g_nrec * 12, 0); }
    var i = 0;
    while (i < g_nrec) {
        var r = at + 6 + i * 12;
        pu16(r, load64(g_rec + i * 48));
        pu16(r + 2, load64(g_rec + i * 48 + 8));
        pu16(r + 4, load64(g_rec + i * 48 + 16));
        pu16(r + 6, load64(g_rec + i * 48 + 24));
        pu16(r + 8, load64(g_rec + i * 48 + 40));
        var off = load64(g_rec + i * 48 + 32);
        if (o_badstr != 0 && i == g_nrec - 1) { off = off + 8192; }
        pu16(r + 10, off);
        i = i + 1;
    }
    memcpy(FB + at + so, g_pool, g_pooln);
    return so + g_pooln;
}

fn build(): i64 {
    memset(FB, 0, FB_CAP);
    var ntab = 6;
    if (o_noname == 0) { ntab = ntab + 1; }
    if (o_nofvar == 0) { ntab = ntab + 1; }
    pu32(0, 0x00010000);
    pu16(4, ntab);
    var at = 12 + ntab * 16;
    var head_at = at;
    var maxp_at = head_at + 56;
    var hhea_at = maxp_at + 8;
    var hmtx_at = hhea_at + 40;
    var loca_at = hmtx_at + NG * 4;
    var glyf_at = loca_at + (NG + 1) * 4;
    var fvar_at = glyf_at + 4;
    var fvlen = 0;
    if (o_nofvar == 0) { fvlen = 36 + 20; }             # two axes
    var name_at = fvar_at + fvlen;
    g_name = name_at;
    g_namelen = 0;
    if (o_noname == 0) { g_namelen = put_name(name_at); }

    pu16(head_at + 18, 1000);
    pu16(head_at + 50, 1);
    pu16(maxp_at + 4, NG);
    pu16(hhea_at + 34, NG);
    var i = 0;
    while (i < NG) {
        pu16(hmtx_at + i * 4, 500);
        i = i + 1;
    }
    i = 0;
    while (i <= NG) {
        pu32(loca_at + i * 4, 0);
        i = i + 1;
    }
    if (o_nofvar == 0) {
        pu16(fvar_at, 1);
        pu16(fvar_at + 4, 16);
        pu16(fvar_at + 8, 2);
        pu16(fvar_at + 10, 20);
        pu32(fvar_at + 16, 0x77676874);                 # 'wght', nameID 300
        pu32(fvar_at + 20, 100 * 65536);
        pu32(fvar_at + 24, 400 * 65536);
        pu32(fvar_at + 28, 900 * 65536);
        pu16(fvar_at + 34, 300);
        pu32(fvar_at + 36, 0x77647468);                 # 'wdth', nameID 301
        pu32(fvar_at + 40, 50 * 65536);
        pu32(fvar_at + 44, 100 * 65536);
        pu32(fvar_at + 48, 200 * 65536);
        pu16(fvar_at + 54, 301);
    }

    var d = 12;
    pu32(d, REKHA_TAG_HEAD); pu32(d + 8, head_at); pu32(d + 12, 54); d = d + 16;
    pu32(d, REKHA_TAG_MAXP); pu32(d + 8, maxp_at); pu32(d + 12, 6);  d = d + 16;
    pu32(d, REKHA_TAG_HHEA); pu32(d + 8, hhea_at); pu32(d + 12, 36); d = d + 16;
    pu32(d, REKHA_TAG_HMTX); pu32(d + 8, hmtx_at); pu32(d + 12, NG * 4); d = d + 16;
    pu32(d, REKHA_TAG_LOCA); pu32(d + 8, loca_at); pu32(d + 12, (NG + 1) * 4); d = d + 16;
    pu32(d, REKHA_TAG_GLYF); pu32(d + 8, glyf_at); pu32(d + 12, 4); d = d + 16;
    if (o_nofvar == 0) {
        pu32(d, 0x66766172); pu32(d + 8, fvar_at); pu32(d + 12, fvlen); d = d + 16;
    }
    if (o_noname == 0) {
        pu32(d, REKHA_TAG_NAME); pu32(d + 8, name_at); pu32(d + 12, g_namelen); d = d + 16;
    }
    g_flen = name_at + g_namelen;
    return g_flen;
}

fn opts_reset(): i64 {
    o_noname = 0;
    o_fmt = 0;
    o_shortrec = 0;
    o_badstr = 0;
    o_nofvar = 1;
    nr_reset();
    return 0;
}

var g_f = 0;

fn openf(): i64 {
    build();
    g_f = rekha_font_open(FB, g_flen);
    return g_f;
}

# Read name id `id` into OUT and compare with the ASCII cstring `want`.
fn want_ascii(id, want): i64 {
    memset(OUT, 0, OUT_CAP);
    var n = rekha_name_utf8(g_f, id, OUT, OUT_CAP);
    check(n, strlen(want));
    if (n != strlen(want)) { return 1; }
    var i = 0;
    var same = 1;
    while (i < n) {
        if (load8(OUT + i) != load8(want + i)) { same = 0; }
        i = i + 1;
    }
    check(same, 1);
    return 0;
}

# Decode the UTF-8 in OUT at `at` back to a code point. Returns -1 when it is not well formed.
# ⚠ THE TEST'S OWN DECODER, deliberately: comparing rekha's output against rekha's own encoder
# would agree on any shared mistake.
fn utf8_cp(at, n): i64 {
    if (n < 1) { return 0 - 1; }
    var b0 = load8(OUT + at);
    if (b0 < 128) { return b0; }
    if (b0 >= 192 && b0 < 224) {
        if (n < 2) { return 0 - 1; }
        return ((b0 & 31) << 6) | (load8(OUT + at + 1) & 63);
    }
    if (b0 >= 224 && b0 < 240) {
        if (n < 3) { return 0 - 1; }
        return ((b0 & 15) << 12) | ((load8(OUT + at + 1) & 63) << 6) | (load8(OUT + at + 2) & 63);
    }
    if (b0 >= 240) {
        if (n < 4) { return 0 - 1; }
        return ((b0 & 7) << 18) | ((load8(OUT + at + 1) & 63) << 12)
        | ((load8(OUT + at + 2) & 63) << 6) | (load8(OUT + at + 3) & 63);
    }
    return 0 - 1;
}

# ── A) the plain case, and the record accessors ──────────────────────
fn t_basic(): i64 {
    g_group = "A basic";
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Rekha Sans");
    nr_begin(3, 1, 1033, REKHA_NAME_SUBFAMILY); nr_utf16("Bold Italic");
    nr_begin(3, 1, 1033, REKHA_NAME_POSTSCRIPT); nr_utf16("RekhaSans-BoldItalic");
    check(openf() != 0, 1);
    check(rekha_name_count(g_f), 3);
    want_ascii(REKHA_NAME_FAMILY, "Rekha Sans");
    want_ascii(REKHA_NAME_SUBFAMILY, "Bold Italic");
    want_ascii(REKHA_NAME_POSTSCRIPT, "RekhaSans-BoldItalic");
    # an id the font does not carry
    check(rekha_name_utf8(g_f, REKHA_NAME_LICENSE, OUT, OUT_CAP), 0);
    # the record accessors, for a consumer walking the table itself
    check(rekha_name_platform_at(g_f, 0), 3);
    check(rekha_name_encoding_at(g_f, 0), 1);
    check(rekha_name_language_at(g_f, 0), 1033);
    check(rekha_name_id_at(g_f, 1), REKHA_NAME_SUBFAMILY);
    check(rekha_name_id_at(g_f, 3), 0 - 1);
    check(rekha_name_id_at(g_f, 0 - 1), 0 - 1);
    check(rekha_name_at_utf8(g_f, 2, OUT, OUT_CAP), 20);
    check(rekha_name_at_utf8(g_f, 9, OUT, OUT_CAP), 0);
    # the null handle, and a font with no table at all
    check(rekha_name_count(0), 0);
    check(rekha_name_utf8(0, 1, OUT, OUT_CAP), 0);
    opts_reset();
    o_noname = 1;
    check(openf() != 0, 1);
    check(rekha_name_count(g_f), 0);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    return 0;
}

# ── B) ranking: the same id on four platforms ───────────────────────
fn t_rank(): i64 {
    g_group = "B ranking";
    # ⭐ IN A DELIBERATELY UNHELPFUL ORDER, with the best record FIRST and last-wins would pick the
    # Macintosh one. The Windows/BMP/English record must win wherever it sits.
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Windows English");
    nr_begin(0, 3, 0, REKHA_NAME_FAMILY);    nr_utf16("Unicode");
    nr_begin(3, 1, 1031, REKHA_NAME_FAMILY); nr_utf16("Windows German");
    nr_begin(1, 0, 0, REKHA_NAME_FAMILY);    nr_mac("Macintosh");
    check(openf() != 0, 1);
    want_ascii(REKHA_NAME_FAMILY, "Windows English");
    # with the Windows English one gone, the next rank down is any Windows record
    opts_reset();
    nr_begin(1, 0, 0, REKHA_NAME_FAMILY);    nr_mac("Macintosh");
    nr_begin(0, 3, 0, REKHA_NAME_FAMILY);    nr_utf16("Unicode");
    nr_begin(3, 1, 1031, REKHA_NAME_FAMILY); nr_utf16("Windows German");
    check(openf() != 0, 1);
    want_ascii(REKHA_NAME_FAMILY, "Windows German");
    # then the Unicode platform, then Macintosh Roman
    opts_reset();
    nr_begin(1, 0, 0, REKHA_NAME_FAMILY); nr_mac("Macintosh");
    nr_begin(0, 3, 0, REKHA_NAME_FAMILY); nr_utf16("Unicode");
    check(openf() != 0, 1);
    want_ascii(REKHA_NAME_FAMILY, "Unicode");
    opts_reset();
    nr_begin(1, 0, 7, REKHA_NAME_FAMILY); nr_mac("Mac Other");
    nr_begin(1, 0, 0, REKHA_NAME_FAMILY); nr_mac("Mac English");
    check(openf() != 0, 1);
    want_ascii(REKHA_NAME_FAMILY, "Mac English");
    # ⛔ a platform rekha cannot decode is not a CANDIDATE, so a readable record behind it wins
    opts_reset();
    nr_begin(2, 0, 0, REKHA_NAME_FAMILY); nr_mac("ISO deprecated");
    nr_begin(1, 0, 0, REKHA_NAME_FAMILY); nr_mac("Mac English");
    check(openf() != 0, 1);
    want_ascii(REKHA_NAME_FAMILY, "Mac English");
    # ...and when it is the only one, the id is simply absent
    opts_reset();
    nr_begin(2, 0, 0, REKHA_NAME_FAMILY); nr_mac("ISO deprecated");
    check(openf() != 0, 1);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    return 0;
}

# ── C) UTF-16BE past ASCII, including a surrogate pair ────────────────────
fn t_utf16(): i64 {
    g_group = "C utf16";
    opts_reset();
    # U+00E9 (2 UTF-8 bytes), U+20AC (3), U+1F600 (4, a surrogate pair)
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY);
    nr_u16(65); nr_u16(0x00E9); nr_u16(0x20AC); nr_u16(0xD83D); nr_u16(0xDE00); nr_u16(66);
    check(openf() != 0, 1);
    memset(OUT, 0, OUT_CAP);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 1 + 2 + 3 + 4 + 1);
    check(utf8_cp(0, 1), 65);
    check(utf8_cp(1, 2), 0x00E9);
    check(utf8_cp(3, 3), 0x20AC);
    check(utf8_cp(6, 4), 0x1F600);
    check(utf8_cp(10, 1), 66);
    return 0;
}

# ── D) every Macintosh Roman byte, against the generated vectors ────────────────
fn t_macroman(): i64 {
    g_group = "D mac roman";
    check(REKHA_MR_VEC_N, 128);
    # the accessor, byte by byte
    var i = 0;
    var bad = 0;
    while (i < 128) {
        if (rekha_mac_roman_cp(128 + i) != rekha_mr_vec(i)) { bad = bad + 1; }
        i = i + 1;
    }
    check(bad, 0);
    check(rekha_mac_roman_cp(65), 65);                  # ASCII passes through
    check(rekha_mac_roman_cp(0), 0);
    check(rekha_mac_roman_cp(256), 0 - 1);
    check(rekha_mac_roman_cp(0 - 1), 0 - 1);
    # ⭐ AND THROUGH THE WHOLE DECODER: one name per high byte, decoded back here.
    i = 0;
    bad = 0;
    while (i < 128) {
        opts_reset();
        nr_begin(1, 0, 0, REKHA_NAME_FAMILY);
        nr_b(128 + i);
        if (openf() == 0) {
            bad = bad + 1;
        } else {
            memset(OUT, 0, OUT_CAP);
            var n = rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP);
            if (n < 2 || n > 3) { bad = bad + 1; }
            if (utf8_cp(0, n) != rekha_mr_vec(i)) { bad = bad + 1; }
        }
        i = i + 1;
    }
    check(bad, 0);
    return 0;
}

# ── E) the buffer contract ─────────────────────────────
fn t_buffer(): i64 {
    g_group = "E buffer";
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Rekha");
    check(openf() != 0, 1);
    # sizing: dst 0 asks how long it is and writes nothing
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, 0, 0), 5);
    # ⛔ A CAP THAT IS ONE SHORT WRITES NOTHING AT ALL. Half a name is worse than no name, and a
    # truncated UTF-8 string can end inside a character.
    memset(OUT, 0xAA, 16);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, 4), 5);
    check(load8(OUT), 0xAA);
    check(load8(OUT + 4), 0xAA);
    # exactly enough writes all of it and touches nothing past it
    memset(OUT, 0xAA, 16);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, 5), 5);
    check(load8(OUT), 82);
    check(load8(OUT + 4), 97);
    check(load8(OUT + 5), 0xAA);                        # ⚠ not NUL-terminated: the length is the answer
    return 0;
}

# ── F) refusals ─────────────────────────────────
fn t_refuse(): i64 {
    g_group = "F refusals";
    # a format rekha does not read
    opts_reset();
    o_fmt = 2;
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Rekha");
    check(openf() != 0, 1);
    check(rekha_name_count(g_f), 0);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    # format 1 IS read: its langTag array sits after the records and changes nothing here
    opts_reset();
    o_fmt = 1;
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Rekha");
    check(openf() != 0, 1);
    want_ascii(REKHA_NAME_FAMILY, "Rekha");
    # a record array that does not fit
    opts_reset();
    o_shortrec = 1;
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Rekha");
    check(openf() != 0, 1);
    check(rekha_name_count(g_f), 0);
    # a string that runs past the table
    opts_reset();
    o_badstr = 1;
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Rekha");
    check(openf() != 0, 1);
    check(rekha_name_count(g_f), 1);                    # the RECORD is fine
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);   # its string is not
    # an odd UTF-16 byte length
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_u16(65); nr_b(66);
    check(openf() != 0, 1);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    # a high surrogate with nothing after it
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_u16(65); nr_u16(0xD83D);
    check(openf() != 0, 1);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    # a high surrogate followed by something that is not a low one
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_u16(0xD83D); nr_u16(65);
    check(openf() != 0, 1);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    # a low surrogate on its own
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_u16(0xDE00);
    check(openf() != 0, 1);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    # an empty string
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY);
    check(openf() != 0, 1);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    # a Windows encoding rekha does not decode
    opts_reset();
    nr_begin(3, 4, 1033, REKHA_NAME_FAMILY); nr_utf16("Big5");
    check(openf() != 0, 1);
    check(rekha_name_utf8(g_f, REKHA_NAME_FAMILY, OUT, OUT_CAP), 0);
    return 0;
}

# ── G) the fvar axes get their labels ─────────────────────────
fn t_axes(): i64 {
    g_group = "G axis names";
    opts_reset();
    o_nofvar = 0;
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Rekha Variable");
    nr_begin(3, 1, 1033, 300); nr_utf16("Weight");
    nr_begin(3, 1, 1033, 301); nr_utf16("Width");
    check(openf() != 0, 1);
    check(rekha_var_axis_count(g_f), 2);
    # ⭐ AN AXIS HAS BEEN ENUMERABLE SINCE 0.4.11 AND UNLABELABLE UNTIL NOW. The record's
    # axisNameID was parsed past and never resolved.
    check(rekha_var_axis_name_id(g_f, 0), 300);
    check(rekha_var_axis_name_id(g_f, 1), 301);
    check(rekha_var_axis_name_id(g_f, 2), 0);
    check(rekha_var_axis_name_id(0, 0), 0);
    want_ascii(rekha_var_axis_name_id(g_f, 0), "Weight");
    want_ascii(rekha_var_axis_name_id(g_f, 1), "Width");
    return 0;
}

# ── H) every byte of the table, flipped ─────────────────────────
fn t_guard(): i64 {
    g_group = "H guard";
    opts_reset();
    nr_begin(3, 1, 1033, REKHA_NAME_FAMILY); nr_utf16("Rekha Sans");
    nr_begin(1, 0, 0, REKHA_NAME_SUBFAMILY); nr_mac("Regular");
    build();
    var lo = g_name;
    var hi = g_name + g_namelen;
    var bad = 0;
    var at = lo;
    while (at < hi) {
        var bit = 0;
        while (bit < 8) {
            var orig = load8(FB + at);
            store8(FB + at, orig ^ (1 << bit));
            var f = rekha_font_open(FB, g_flen);
            if (f != 0) {
                # ⛔ Whatever these bytes say, a name must never report more than it writes, and
                # must never write outside the buffer it was given.
                memset(OUT, 0xAA, OUT_CAP);
                var n = rekha_name_utf8(f, REKHA_NAME_FAMILY, OUT, 64);
                if (n < 0) { bad = bad + 1; }
                if (n > 64) {
                    if (load8(OUT) != 0xAA) { bad = bad + 1; }   # over cap: nothing written
                }
                if (load8(OUT + 64) != 0xAA) { bad = bad + 1; }  # never past cap
                var k = 0;
                while (k < rekha_name_count(f)) {
                    if (rekha_name_at_utf8(f, k, OUT, 64) < 0) { bad = bad + 1; }
                    k = k + 1;
                }
            }
            store8(FB + at, orig);
            bit = bit + 1;
        }
        at = at + 1;
    }
    check(bad, 0);
    g_f = rekha_font_open(FB, g_flen);
    check(g_f != 0, 1);
    want_ascii(REKHA_NAME_FAMILY, "Rekha Sans");
    want_ascii(REKHA_NAME_SUBFAMILY, "Regular");
    return 0;
}

fn main(): i64 {
    alloc_init();
    FB = alloc(FB_CAP);
    OUT = alloc(OUT_CAP);
    g_rec = alloc(REC_MAX * 48);
    g_pool = alloc(4096);
    t_basic();
    t_rank();
    t_utf16();
    t_macroman();
    t_buffer();
    t_refuse();
    t_axes();
    t_guard();
    if (g_fails == 0) {
        var ok = "name_test: PASS (records, ranking, UTF-16, Mac Roman, buffers, refusals, axes, guard; ";
        syscall(1, 1, ok, strlen(ok));
        fmt_int(g_n);
        syscall(1, 1, " checks)\n", 9);
    }
    return g_fails;
}

var exit_code = main();
syscall(60, exit_code);
