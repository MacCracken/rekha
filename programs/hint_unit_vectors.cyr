    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 227, 73, 1); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 224, 227, 1); }
    if (i == 12) { return hu_pick(f, 4096, 223, 8); }  if (i == 13) { return hu_pick(f, 177, 152, 9); }
    return 0;
}

# 126 fdef_count_floor — font 9, 12 ppem, 11 bytes: two functions (5 and 9) defined under
#   maxp.maxFunctionDefs 1: FreeType floors the count at 64 (65 definitions fail, measured), so CALL 9 shifts
#   13 by 32 and CALL 5 shifts 12 by 64
#   SVTCA[x] PUSHB 13 PUSHB 9 CALL PUSHB 12 PUSHB 5 CALL
fn hu_c126(k): i64 {
    if (k == 0) { return "\x01\xb0\x0d\xb0\x09\x2b\xb0\x0c\xb0\x05\x2b"; }
    return 0;
}

