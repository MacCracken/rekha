fn hu_contour_end(g, c): i64 {
    if (g == 1) { if (c == 0) { return 7; } }  if (g == 1) { if (c == 1) { return 13; } }
    if (g == 2) { if (c == 0) { return 7; } }  if (g == 2) { if (c == 1) { return 13; } }
