fn hu_font_copy(f, dst): i64 {
    if (dst == 0) { return 0; }
    var n = hu_font_len(f);
    var i = 0;
    while (i < n) {
        store8(dst + i, load8(hu_font_chunk(f, i / 20) + (i % 20)));
        i = i + 1;
    }
    return n;
}

