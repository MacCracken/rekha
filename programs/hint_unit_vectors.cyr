    return 0;
}

# The programs. Each hu_c<p>(k) holds glyph 1's bytes in 20-byte literals (hu_k<p>(k) a composite
# program's, listed as `composite:`); hu_e<p>(i, f) the expected x (f 0), y (f 1) and tag (f 2) of
# outline point i of the glyph FreeType loaded (`gid`). The comment above each is the program's
# purpose and its listing; `font N` names the variant it ran on.
fn hu_pick(f, x, y, t): i64 {
    if (f == 0) { return x; }
    if (f == 1) { return y; }
    return t;
}

fn hu_program_count(): i64 { return 167; }

# 0 mdap — font 0, gid 1, 12 ppem, 14 bytes: MDAP[1] rounds the projection and touches, MDAP[0] touches
#   without moving, on either axis
