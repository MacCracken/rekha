    if (k == 0) { return "\x01\xb0\x0d\x28\xb0\x0c\x7b\xb0\x0b\x8f\xb0\x0a\xa0"; }
    return 0;
}

fn hu_e122(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 305, 5, 1); }  if (i == 3) { return hu_pick(f, 377, 77, 0); }
    if (i == 4) { return hu_pick(f, 374, 226, 1); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 227, 73, 1); }
    if (i == 10) { return hu_pick(f, 235, 149, 8); }  if (i == 11) { return hu_pick(f, 240, 227, 9); }
    if (i == 12) { return hu_pick(f, 181, 223, 8); }  if (i == 13) { return hu_pick(f, 177, 152, 9); }
    return 0;
}

# 123 idef_standard_opcode — font 6, 12 ppem, 9 bytes: an IDEF of 0x60 does not shadow ADD: 1 2 ADD is 3,
#   read into 13 (the IDEF's SHPIX 64 would have moved point 1)
#   SVTCA[x] PUSHB 1 2 ADD PUSHB 13 SWAP SCFS
fn hu_c123(k): i64 {
    if (k == 0) { return "\x01\xb1\x01\x02\x60\xb0\x0d\x23\x48"; }
    return 0;
}

fn hu_e123(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 305, 5, 1); }  if (i == 3) { return hu_pick(f, 377, 77, 0); }
    if (i == 4) { return hu_pick(f, 374, 226, 1); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 227, 73, 1); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 224, 227, 1); }
    if (i == 12) { return hu_pick(f, 149, 223, 0); }  if (i == 13) { return hu_pick(f, 3, 152, 9); }
    return 0;
}

# 124 fdef_sparse_numbers — font 7, 12 ppem, 16 bytes: functions 0, 1 and 100 defined by an fpgm under
#   maxp.maxFunctionDefs 3: CALL 100 shifts 13 by 64, CALL 0 shifts 12 by 32, CALL 1 shifts 11 by 16 — the
#   number is free, the count is bounded
#   SVTCA[x] PUSHB 13 PUSHB 100 CALL PUSHB 12 PUSHB 0 CALL PUSHB 11 PUSHB 1 CALL
fn hu_c124(k): i64 {
    if (k == 0) { return "\x01\xb0\x0d\xb0\x64\x2b\xb0\x0c\xb0\x00\x2b\xb0\x0b\xb0\x01\x2b"; }
    return 0;
}

fn hu_e124(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 305, 5, 1); }  if (i == 3) { return hu_pick(f, 377, 77, 0); }
    if (i == 4) { return hu_pick(f, 374, 226, 1); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 227, 73, 1); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 240, 227, 9); }
    if (i == 12) { return hu_pick(f, 181, 223, 8); }  if (i == 13) { return hu_pick(f, 177, 152, 9); }
    return 0;
}

# 125 fpgm_getinfo_grayscale — font 8, 12 ppem, 13 bytes: GETINFO's grayscale bit is 0 while the fpgm runs,
#   so function 9 was defined as SHPIX 64 (13 shifts by 64, not 128); called from the glyph program, function
#   10's GETINFO 32 answers 0x1000 (into 12)
#   SVTCA[x] PUSHB 13 PUSHB 9 CALL PUSHB 10 CALL PUSHB 12 SWAP SCFS
fn hu_c125(k): i64 {
    if (k == 0) { return "\x01\xb0\x0d\xb0\x09\x2b\xb0\x0a\x2b\xb0\x0c\x23\x48"; }
    return 0;
}

fn hu_e125(i, f): i64 {
