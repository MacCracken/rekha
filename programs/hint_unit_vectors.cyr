# programs/hint_unit_vectors.cyr — GENERATED by scripts/hint_unit_vectors.py from FreeType 2.14.3
# (classic interpreter, GETINFO version 35, grayscale, FT_LOAD_NO_AUTOHINT). DO NOT EDIT.
#
# A synthetic TrueType font — one simple glyph of two contours, 14 points, a 16-entry cvt, a
# two-function fpgm — in 10 VARIANTS that differ from font 0 (prep RTG) in their prep, their fpgm
# and/or one maxp field (each says which below), and 127 glyph PROGRAMS run through FreeType
# itself at their ppem on their font. For each program: the bytes, and what FreeType's glyph
# slot held afterwards — every outline point's hinted position (F26Dot6), its tag byte, and the
# advance. Every program was ALSO loaded under FT_LOAD_PEDANTIC on a fresh face and loaded clean,
# so no instruction was skipped silently. Nothing here was computed by rekha or by a second
# hand-written interpreter.
#
# ⛔ NOT REGENERATED IN CI. CI's Ubuntu ships FreeType 2.13.2, whose move arithmetic (the
# fv * 0x10000 / F_dot_P quotient), ODD/EVEN test, stack margin and DELTAP pop discipline differ
# from the 2.14.3 rekha targets; `fv_b1_regime` below is a move the two versions disagree on.
# Regenerate by hand on a 2.14.x host with
#   python3 scripts/hint_unit_vectors.py emit programs/hint_unit_vectors.cyr
# and review the diff like any other transcription. The emitter lints and formats its output
# before writing it, so this file is gate-clean by construction.
#
# Rules a consumer needs (each measured on FreeType, not read from a spec):
#   * hu_expect_x(p, i) is FreeType's REPORTED x of outline point i: the interpreter's cur.x MINUS
#     cur[pp1].x, because TT_Load_Glyph translates the hinted outline so that pp1 is the origin
#     (ref2143/ttgload.c:2578-2583); hu_expect_y is cur.y as it is. No program here moves pp1,
#     so the subtraction is of 0 — compare cur.x - cur[pp1].x anyway; that is the contract.
#   * hu_expect_tag(p, i) is the tag byte: 1 on-curve, 8 touched in x, 16 touched in y, and on
#     point 0 ALSO 4 (FT_CURVE_TAG_HAS_SCANMODE) with scan_type << 5, which TT_Hint_Glyph sets
#     after any glyph program ran (ref2143/ttgload.c:839-840). Mask with 0x19 (25) for the
#     interpreter's bits: 1 -> ONCURVE, 8 -> TOUCHX, 16 -> TOUCHY.
#   * hu_expect_advance(p) is slot->advance.x: pp2.x - pp1.x after the base layer's grid fit,
#     equal to ((cur[pp2].x - cur[pp1].x) + 32) & -64, which is cur[pp2].x - cur[pp1].x whenever
#     both phantoms sit on the grid, as they do here.
#   * hu_phantom_x/y(k) are pp1..pp4 in FONT UNITS before scaling, per tt_loader_set_pp
#     (ref2143/ttgload.c:1336-1347) for a font with NO `vmtx` and NO `OS/2`: pp1 = (xMin - lsb, 0)
#     = (0, 0) because lsb == xMin, pp2 = (pp1.x + advanceWidth, 0), and TT_Get_VMetrics
#     (ttgload.c:112-138) gives tsb = hhea.ascender - yMax and ah = |ascender - descender|, so
#     pp3 = (0, yMax + tsb) = (0, ascender) and pp4 = (0, pp3.y - ah) = (0, descender). The
#     interpreter then scales all four and rounds pp1.x, pp2.x, pp3.y, pp4.y in cur only
#     (`phantoms` reads back cur 0/448/576/-128 and org 450/600/-150 at 12 ppem).
#   * twilight points are never in the outline; a program that needs one observed reads it out
#     with GC[0] on zone 0 and SCFS on a glyph point (the `read_twilight` idiom in the script).
#     Every twilight index used is below 16, the font's maxTwilightPoints and FreeType's own
#     per-run bound for this glyph.
#   * a program on font 1..9 runs AFTER that font's fpgm and prep ran (the prep at the program's
#     ppem); the outline, phantoms and cvt are the same in every font, so what its expected values
#     show that font 0 would not is the carry-over of that font's prep, fpgm or maxp field alone.
#
# Accessors (all null-safe: anything out of range answers 0):
#   hu_ft_version()                  cstring, the FreeType that produced this file
#   hu_font_count()                  10 font variants, f in 0..9 (font 0 first, unchanged)
#   hu_font_len(f) / hu_font_copy(f, dst)   font f's bytes; copy writes them at dst, answers len
#   hu_outline_points/contours()     14 points (phantoms excluded), 2 contours
#   hu_outline_x/y(i), hu_outline_on(i), hu_contour_end(c)    font units; 0/1; last index
#   hu_phantom_x/y(k)                k 0..3, font units (see above)
#   hu_program_count/name/ppem/font/len(p), hu_program_byte(p, i)    the programs
#   hu_expect_x/y/tag(p, i)          hinted cur (see above) and tag of point i < points
#   hu_expect_advance(p)             hinted advance.x

fn hu_ft_version(): i64 { return "2.14.3"; }

# The fonts: sfnt tables cmap cvt fpgm glyf head hhea hmtx loca maxp post prep.
# maxp of font 0: 14 points, 2 contours, 2 zones, 16 twilight points, 32 storage, 64 functions,
# 4 IDEFs, 128 stack elements, 159 bytes of instructions. cvt entry i is i * 101 - 505
# (programs/hint_test.cyr's). fpgm of font 0 defines function 3 (adds 5) and 7 (adds 1):
#   PUSHB 3 FDEF PUSHB 5 ADD ENDF PUSHB 7 FDEF PUSHB 1 ADD ENDF
# Glyph 1 carries no program in these copies. Each font's prep (`prep:`), and, where a font
# differs from font 0 in more than its prep, which tables (`differs:`) and the fpgm listing:
#   font 0 `rtg`, 776 bytes: the default round state restated; every program not about a table runs under it
#     prep: RTG
#   font 1 `gs_carry`, 784 bytes: four of the graphics-state fields FreeType keeps from a prep for every glyph
#   program
#     prep: PUSHB 96 SMD PUSHB 40 SCVTCI PUSHB 10 SDB PUSHB 4 SDS
#   font 2 `wcvtf`, 780 bytes: cvt 8 becomes 400 font units (300 at 12 ppem) for the size
#     prep: PUSHB 8 PUSHW 400 WCVTF
#   font 3 `deltac`, 780 bytes: cvt 8 gains 8 steps of 1/8 px at 12 ppem (band 3 of base 9) and nothing at 28
#     prep: PUSHB 63 8 1 DELTAC1
#   font 4 `idef_91`, 780 bytes: prep defines opcode 0x91 (GETVARIATION on a variation face) as SHPIX 64: on a
#   static face FreeType runs the IDEF (ref2143/ttinterp.c:7306-7314; LaoUI.ttf does this)
#     prep: RTG PUSHB 145 IDEF PUSHB 64 SHPIX ENDF
#   font 5 `idef_four`, 804 bytes: prep defines the unassigned opcodes 0x28, 0x7B, 0x8F and 0xA0 (all four
#   maxInstructionDefs slots) as SHPIX by 64, 32, 16 and 8
#     prep: RTG PUSHB 40 IDEF PUSHB 64 SHPIX ENDF PUSHB 123 IDEF PUSHB 32 SHPIX ENDF PUSHB 143 IDEF PUSHB 16
#   SHPIX ENDF PUSHB 160 IDEF PUSHB 8 SHPIX ENDF
#   font 6 `idef_std`, 780 bytes: prep IDEFs 0x60 (ADD): a standard instruction is dispatched before the IDEF
#   table is looked at, so the definition is never reached
#     prep: RTG PUSHB 96 IDEF PUSHB 64 SHPIX ENDF
#   font 7 `fdef_sparse`, 784 bytes: fpgm REPLACED: functions 0 (SHPIX 32), 1 (SHPIX 16) and 100 (SHPIX 64)
#   with maxp.maxFunctionDefs 3 — FreeType bounds the COUNT of definitions, not the numbers
#   (ref2143/ttinterp.c:3283-3309)
#     prep: RTG
#     differs: fpgm, maxp.maxFunctionDefs 3
#     fpgm: PUSHB 0 FDEF PUSHB 32 SHPIX ENDF PUSHB 1 FDEF PUSHB 16 SHPIX ENDF PUSHB 100 FDEF PUSHB 64 SHPIX
#   ENDF
#   font 8 `fpgm_getinfo`, 804 bytes: fpgm EXTENDED: function 9 is defined under IF on GETINFO's grayscale bit
#   AT FPGM TIME (SHPIX 128 when set, 64 when clear) and function 10 answers GETINFO 32 when called
#     prep: RTG
#     differs: fpgm
#     fpgm: PUSHB 3 FDEF PUSHB 5 ADD ENDF PUSHB 7 FDEF PUSHB 1 ADD ENDF PUSHB 32 GETINFO IF PUSHB 9 FDEF PUSHB
#   128 SHPIX ENDF ELSE PUSHB 9 FDEF PUSHB 64 SHPIX ENDF EIF PUSHB 10 FDEF PUSHB 32 GETINFO ENDF
#   font 9 `fdef_floor`, 776 bytes: fpgm REPLACED: functions 5 (SHPIX 64) and 9 (SHPIX 32) with
#   maxp.maxFunctionDefs 1 — FreeType's maxp loader floors maxFunctionDefs at 64 (measured on 2.14.3: 64
#   definitions load under a declared 1, 65 fail), so two definitions fit
#     prep: RTG
#     differs: fpgm, maxp.maxFunctionDefs 1
#     fpgm: PUSHB 5 FDEF PUSHB 64 SHPIX ENDF PUSHB 9 FDEF PUSHB 32 SHPIX ENDF
fn hu_font_count(): i64 { return 10; }

fn hu_font_len(f): i64 {
    if (f == 0) { return 776; }  if (f == 1) { return 784; }  if (f == 2) { return 780; }
    if (f == 3) { return 780; }  if (f == 4) { return 780; }  if (f == 5) { return 804; }
    if (f == 6) { return 780; }  if (f == 7) { return 784; }  if (f == 8) { return 804; }
    if (f == 9) { return 776; }
    return 0;
}

