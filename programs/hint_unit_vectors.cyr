    if (f == 2) { return hu_f2_chunk(k); }  if (f == 3) { return hu_f3_chunk(k); }
    if (f == 4) { return hu_f4_chunk(k); }  if (f == 5) { return hu_f5_chunk(k); }
    if (f == 6) { return hu_f6_chunk(k); }  if (f == 7) { return hu_f7_chunk(k); }
    if (f == 8) { return hu_f8_chunk(k); }  if (f == 9) { return hu_f9_chunk(k); }
    return 0;
}

fn hu_font_copy(f, dst): i64 {
    if (dst == 0) { return 0; }
    var n = hu_font_len(f);
    var i = 0;
    while (i < n) {
        store8(dst + i, load8(hu_font_chunk(f, i / 20) + (i % 20)));
        i = i + 1;
    }
    return n;
}

# The outline in font units: upem 1024, advance 600, lsb 98 (= xMin), bbox 98 2 503 406,
# hhea ascender 800 / descender -200. No coordinate is a multiple of 4, so scale 0.75 (12 ppem) rounds
# every one of them and orus-scaled distances differ from org distances by 1/64 where it matters.
fn hu_outline_points(): i64 { return 14; }
fn hu_outline_contours(): i64 { return 2; }

fn hu_outline_x(i): i64 {
    if (i == 0) { return 101; }  if (i == 1) { return 199; }  if (i == 2) { return 407; }
    if (i == 3) { return 503; }  if (i == 4) { return 498; }  if (i == 5) { return 405; }
    if (i == 6) { return 207; }  if (i == 7) { return 98; }  if (i == 8) { return 201; }
    if (i == 9) { return 302; }  if (i == 10) { return 303; }  if (i == 11) { return 299; }
    if (i == 12) { return 198; }  if (i == 13) { return 150; }
    return 0;
}

fn hu_outline_y(i): i64 {
    if (i == 0) { return 5; }  if (i == 1) { return 2; }  if (i == 2) { return 6; }
    if (i == 3) { return 102; }  if (i == 4) { return 301; }  if (i == 5) { return 406; }
    if (i == 6) { return 398; }  if (i == 7) { return 203; }  if (i == 8) { return 101; }
    if (i == 9) { return 97; }  if (i == 10) { return 199; }  if (i == 11) { return 302; }
    if (i == 12) { return 297; }  if (i == 13) { return 203; }
    return 0;
}

fn hu_outline_on(i): i64 {
    if (i == 0) { return 1; }  if (i == 1) { return 0; }  if (i == 2) { return 1; }
    if (i == 3) { return 0; }  if (i == 4) { return 1; }  if (i == 5) { return 0; }
    if (i == 6) { return 1; }  if (i == 7) { return 0; }  if (i == 8) { return 1; }
    if (i == 9) { return 1; }  if (i == 10) { return 0; }  if (i == 11) { return 1; }
    if (i == 12) { return 0; }  if (i == 13) { return 1; }
    return 0;
}

fn hu_contour_end(c): i64 {
    if (c == 0) { return 7; }  if (c == 1) { return 13; }
    return 0;
}

fn hu_phantom_x(k): i64 {
    if (k == 0) { return 0; }  if (k == 1) { return 600; }
    if (k == 2) { return 0; }  if (k == 3) { return 0; }
    return 0;
}

fn hu_phantom_y(k): i64 {
    if (k == 0) { return 0; }  if (k == 1) { return 0; }
    if (k == 2) { return 800; }  if (k == 3) { return -200; }
    return 0;
}

# The programs. Each hu_c<p>(k) holds the bytes in 20-byte literals; hu_e<p>(i, f) the expected
# x (f 0), y (f 1) and tag (f 2) of outline point i. The comment above each is the program's
# purpose and its listing; `font N` names the variant it ran on.
fn hu_pick(f, x, y, t): i64 {
    if (f == 0) { return x; }
    if (f == 1) { return y; }
    return t;
}

fn hu_program_count(): i64 { return 127; }

# 0 mdap — font 0, 12 ppem, 14 bytes: MDAP[1] rounds the projection and touches, MDAP[0] touches without
#   moving, on either axis
#   SVTCA[x] PUSHB 2 MDAP[1] PUSHB 4 MDAP[0] SVTCA[y] PUSHB 6 MDAP[1] PUSHB 8 MDAP[0]
fn hu_c0(k): i64 {
    if (k == 0) { return "\x01\xb0\x02\x2f\xb0\x04\x2e\x00\xb0\x06\x2f\xb0\x08\x2e"; }
    return 0;
}

fn hu_e0(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 320, 5, 9); }  if (i == 3) { return hu_pick(f, 377, 77, 0); }
    if (i == 4) { return hu_pick(f, 374, 226, 9); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 320, 17); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 17); }  if (i == 9) { return hu_pick(f, 227, 73, 1); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 224, 227, 1); }
    if (i == 12) { return hu_pick(f, 149, 223, 0); }  if (i == 13) { return hu_pick(f, 113, 152, 1); }
    return 0;
}

# 1 rp_mdap — font 0, 12 ppem, 10 bytes: MDAP sets rp0 AND rp1: MDRP[00000] measures from rp0, SHP[1] shifts
#   by rp1's displacement
#   SVTCA[x] PUSHB 2 MDAP[1] PUSHB 9 MDRP[00000] PUSHB 11 SHP[1]
fn hu_c1(k): i64 {
    if (k == 0) { return "\x01\xb0\x02\x2f\xb0\x09\xc0\xb0\x0b\x33"; }
    return 0;
}

fn hu_e1(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 320, 5, 9); }  if (i == 3) { return hu_pick(f, 377, 77, 0); }
    if (i == 4) { return hu_pick(f, 374, 226, 1); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 241, 73, 9); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 239, 227, 9); }
    if (i == 12) { return hu_pick(f, 149, 223, 0); }  if (i == 13) { return hu_pick(f, 113, 152, 1); }
    return 0;
}

# 2 mdrp_orus — font 0, 12 ppem, 7 bytes: MDRP between two glyph points scales the FONT-UNIT distance once;
#   org-org differs by 1/64 here
#   SVTCA[x] PUSHB 0 SRP0 PUSHB 3 MDRP[00000]
fn hu_c2(k): i64 {
    if (k == 0) { return "\x01\xb0\x00\x10\xb0\x03\xc0"; }
    return 0;
}

fn hu_e2(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 305, 5, 1); }  if (i == 3) { return hu_pick(f, 378, 77, 8); }
    if (i == 4) { return hu_pick(f, 374, 226, 1); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 227, 73, 1); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 224, 227, 1); }
    if (i == 12) { return hu_pick(f, 149, 223, 0); }  if (i == 13) { return hu_pick(f, 113, 152, 1); }
    return 0;
}

# 3 mdrp_sweep_lo — font 0, 12 ppem, 53 bytes: MDRP[00000..01111] from rp0 = 0: eight along x on points
#   1..8, eight along y, min-distance both signs
#   PUSHB 0 SRP0 SVTCA[x] PUSHB 1 MDRP[00000] PUSHB 2 MDRP[00001] PUSHB 3 MDRP[00010] PUSHB 4 MDRP[00011]
#   PUSHB 5 MDRP[00100] PUSHB 6 MDRP[00101] PUSHB 7 MDRP[00110] PUSHB 8 MDRP[00111] SVTCA[y] PUSHB 9
#   MDRP[01000] PUSHB 10 MDRP[01001] PUSHB 11 MDRP[01010] PUSHB 12 MDRP[01011] PUSHB 13 MDRP[01100] PUSHB 1
#   MDRP[01101] PUSHB 2 MDRP[01110] PUSHB 3 MDRP[01111]
fn hu_c3(k): i64 {
    if (k == 0) { return "\xb0\x00\x10\x01\xb0\x01\xc0\xb0\x02\xc1\xb0\x03\xc2\xb0\x04\xc3\xb0\x05\xc4\xb0"; }
    if (k == 1) { return "\x06\xc5\xb0\x07\xc6\xb0\x08\xc7\x00\xb0\x09\xc8\xb0\x0a\xc9\xb0\x0b\xca\xb0\x0c"; }
    if (k == 2) { return "\xcb\xb0\x0d\xcc\xb0\x01\xcd\xb0\x02\xce\xb0\x03\xcf"; }
    return 0;
}

fn hu_e3(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 150, -60, 24); }
    if (i == 2) { return hu_pick(f, 306, 68, 25); }  if (i == 3) { return hu_pick(f, 378, 68, 24); }
    if (i == 4) { return hu_pick(f, 374, 226, 9); }  if (i == 5) { return hu_pick(f, 332, 305, 8); }
    if (i == 6) { return hu_pick(f, 140, 299, 9); }  if (i == 7) { return hu_pick(f, 76, 152, 8); }
    if (i == 8) { return hu_pick(f, 140, 76, 9); }  if (i == 9) { return hu_pick(f, 227, 73, 17); }
    if (i == 10) { return hu_pick(f, 227, 150, 16); }  if (i == 11) { return hu_pick(f, 224, 227, 17); }
    if (i == 12) { return hu_pick(f, 149, 223, 16); }  if (i == 13) { return hu_pick(f, 113, 132, 17); }
    return 0;
}

# 4 mdrp_sweep_hi — font 0, 12 ppem, 53 bytes: MDRP[10000..11111]: the same sweep with bit 4 moving rp0 to
#   each point just placed, chained
#   PUSHB 0 SRP0 SVTCA[x] PUSHB 1 MDRP[10000] PUSHB 2 MDRP[10001] PUSHB 3 MDRP[10010] PUSHB 4 MDRP[10011]
#   PUSHB 5 MDRP[10100] PUSHB 6 MDRP[10101] PUSHB 7 MDRP[10110] PUSHB 8 MDRP[10111] SVTCA[y] PUSHB 9
#   MDRP[11000] PUSHB 10 MDRP[11001] PUSHB 11 MDRP[11010] PUSHB 12 MDRP[11011] PUSHB 13 MDRP[11100] PUSHB 1
#   MDRP[11101] PUSHB 2 MDRP[11110] PUSHB 3 MDRP[11111]
fn hu_c4(k): i64 {
    if (k == 0) { return "\xb0\x00\x10\x01\xb0\x01\xd0\xb0\x02\xd1\xb0\x03\xd2\xb0\x04\xd3\xb0\x05\xd4\xb0"; }
    if (k == 1) { return "\x06\xd5\xb0\x07\xd6\xb0\x08\xd7\x00\xb0\x09\xd8\xb0\x0a\xd9\xb0\x0b\xda\xb0\x0c"; }
    if (k == 2) { return "\xdb\xb0\x0d\xdc\xb0\x01\xdd\xb0\x02\xde\xb0\x03\xdf"; }
    return 0;
}

fn hu_e4(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 150, -90, 24); }
    if (i == 2) { return hu_pick(f, 306, -26, 25); }  if (i == 3) { return hu_pick(f, 378, 38, 24); }
    if (i == 4) { return hu_pick(f, 374, 226, 9); }  if (i == 5) { return hu_pick(f, 310, 305, 8); }
    if (i == 6) { return hu_pick(f, 182, 299, 9); }  if (i == 7) { return hu_pick(f, 118, 152, 8); }
    if (i == 8) { return hu_pick(f, 182, 76, 9); }  if (i == 9) { return hu_pick(f, 227, 12, 17); }
    if (i == 10) { return hu_pick(f, 227, 89, 16); }  if (i == 11) { return hu_pick(f, 224, 166, 17); }
    if (i == 12) { return hu_pick(f, 149, 102, 16); }  if (i == 13) { return hu_pick(f, 113, 38, 17); }
    return 0;
}

# 5 mdrp_mindist — font 0, 12 ppem, 19 bytes: SMD 150: MDRP[01000] lifts a short positive distance to +150,
#   a short negative one to -150, longer ones stay
#   SVTCA[x] PUSHB 150 SMD PUSHB 0 SRP0 PUSHB 13 MDRP[01000] PUSHB 7 MDRP[01000] PUSHB 9 MDRP[01000] PUSHB 12
#   MDRP[01100]
fn hu_c5(k): i64 {
    if (k == 0) { return "\x01\xb0\x96\x1a\xb0\x00\x10\xb0\x0d\xc8\xb0\x07\xc8\xb0\x09\xc8\xb0\x0c\xcc"; }
    return 0;
}

fn hu_e5(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 305, 5, 1); }  if (i == 3) { return hu_pick(f, 377, 77, 0); }
    if (i == 4) { return hu_pick(f, 374, 226, 1); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, -74, 152, 8); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 227, 73, 9); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 224, 227, 1); }
    if (i == 12) { return hu_pick(f, 226, 223, 8); }  if (i == 13) { return hu_pick(f, 226, 152, 9); }
    return 0;
}

# 6 mdrp_swidth — font 0, 12 ppem, 22 bytes: SSW 200 (font units, scaled to 150) and SSWCI 6: an orus
#   distance within 6/64 snaps to 150, one outside does not
#   SVTCA[x] PUSHB 200 SSW PUSHB 6 SSWCI PUSHB 0 SRP0 PUSHB 9 MDRP[00000] PUSHB 11 MDRP[00000] PUSHB 2 SRP0
#   PUSHB 13 MDRP[00000]
fn hu_c6(k): i64 {
    if (k == 0) { return "\x01\xb0\xc8\x1f\xb0\x06\x1e\xb0\x00\x10\xb0\x09\xc0\xb0\x0b\xc0\xb0\x02\x10\xb0"; }
    if (k == 1) { return "\x0d\xc0"; }
    return 0;
}

fn hu_e6(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 305, 5, 1); }  if (i == 3) { return hu_pick(f, 377, 77, 0); }
    if (i == 4) { return hu_pick(f, 374, 226, 1); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 226, 73, 9); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 226, 227, 9); }
    if (i == 12) { return hu_pick(f, 149, 223, 0); }  if (i == 13) { return hu_pick(f, 112, 152, 9); }
    return 0;
}

# 7 rp_mdrp — font 0, 12 ppem, 16 bytes: MDRP[10000] leaves rp1 = old rp0, rp2 = point, rp0 = point; MDRP,
#   SHP[0] and SHP[1] read them back
#   SVTCA[x] PUSHB 2 MDAP[1] PUSHB 9 MDRP[10100] PUSHB 13 SHP[1] PUSHB 11 SHP[0] PUSHB 12 MDRP[00000]
fn hu_c7(k): i64 {
    if (k == 0) { return "\x01\xb0\x02\x2f\xb0\x09\xd4\xb0\x0d\x33\xb0\x0b\x32\xb0\x0c\xc0"; }
    return 0;
}

fn hu_e7(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 149, 2, 0); }
    if (i == 2) { return hu_pick(f, 320, 5, 9); }  if (i == 3) { return hu_pick(f, 377, 77, 0); }
    if (i == 4) { return hu_pick(f, 374, 226, 1); }  if (i == 5) { return hu_pick(f, 304, 305, 0); }
    if (i == 6) { return hu_pick(f, 155, 299, 1); }  if (i == 7) { return hu_pick(f, 74, 152, 0); }
    if (i == 8) { return hu_pick(f, 151, 76, 1); }  if (i == 9) { return hu_pick(f, 256, 73, 9); }
    if (i == 10) { return hu_pick(f, 227, 149, 0); }  if (i == 11) { return hu_pick(f, 253, 227, 9); }
    if (i == 12) { return hu_pick(f, 178, 223, 8); }  if (i == 13) { return hu_pick(f, 128, 152, 9); }
    return 0;
}

# 8 mirp_sweep_lo — font 0, 12 ppem, 73 bytes: MIRP[00000..01111] from rp0 = 0 with cvt 6..13 and the cut-in
#   disabled: cvt distance, round bit, min-distance bit
#   PUSHW 2000 SCVTCI PUSHB 0 SRP0 SVTCA[x] PUSHB 1 6 MIRP[00000] PUSHB 2 7 MIRP[00001] PUSHB 3 8 MIRP[00010]
#   PUSHB 4 9 MIRP[00011] PUSHB 5 10 MIRP[00100] PUSHB 6 11 MIRP[00101] PUSHB 7 12 MIRP[00110] PUSHB 8 13
#   MIRP[00111] SVTCA[y] PUSHB 9 6 MIRP[01000] PUSHB 10 7 MIRP[01001] PUSHB 11 8 MIRP[01010] PUSHB 12 9
#   MIRP[01011] PUSHB 13 10 MIRP[01100] PUSHB 1 11 MIRP[01101] PUSHB 2 12 MIRP[01110] PUSHB 3 13 MIRP[01111]
fn hu_c8(k): i64 {
    if (k == 0) { return "\xb8\x07\xd0\x1d\xb0\x00\x10\x01\xb1\x01\x06\xe0\xb1\x02\x07\xe1\xb1\x03\x08\xe2"; }
    if (k == 1) { return "\xb1\x04\x09\xe3\xb1\x05\x0a\xe4\xb1\x06\x0b\xe5\xb1\x07\x0c\xe6\xb1\x08\x0d\xe7"; }
    if (k == 2) { return "\x00\xb1\x09\x06\xe8\xb1\x0a\x07\xe9\xb1\x0b\x08\xea\xb1\x0c\x09\xeb\xb1\x0d\x0a"; }
    if (k == 3) { return "\xec\xb1\x01\x0b\xed\xb1\x02\x0c\xee\xb1\x03\x0d\xef"; }
    return 0;
}

fn hu_e8(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 152, -444, 24); }
    if (i == 2) { return hu_pick(f, 228, 516, 25); }  if (i == 3) { return hu_pick(f, 303, 580, 24); }
    if (i == 4) { return hu_pick(f, 379, 226, 9); }  if (i == 5) { return hu_pick(f, 460, 305, 8); }
    if (i == 6) { return hu_pick(f, 524, 299, 9); }  if (i == 7) { return hu_pick(f, -436, 152, 8); }
    if (i == 8) { return hu_pick(f, 652, 76, 9); }  if (i == 9) { return hu_pick(f, 227, 80, 17); }
    if (i == 10) { return hu_pick(f, 227, 156, 16); }  if (i == 11) { return hu_pick(f, 224, 231, 17); }
    if (i == 12) { return hu_pick(f, 149, 307, 16); }  if (i == 13) { return hu_pick(f, 113, 388, 17); }
    return 0;
}

# 9 mirp_sweep_hi — font 0, 12 ppem, 73 bytes: MIRP[10000..11111]: the same sweep with bit 4 moving rp0
#   along the chain
#   PUSHW 2000 SCVTCI PUSHB 0 SRP0 SVTCA[x] PUSHB 1 6 MIRP[10000] PUSHB 2 7 MIRP[10001] PUSHB 3 8 MIRP[10010]
#   PUSHB 4 9 MIRP[10011] PUSHB 5 10 MIRP[10100] PUSHB 6 11 MIRP[10101] PUSHB 7 12 MIRP[10110] PUSHB 8 13
#   MIRP[10111] SVTCA[y] PUSHB 9 6 MIRP[11000] PUSHB 10 7 MIRP[11001] PUSHB 11 8 MIRP[11010] PUSHB 12 9
#   MIRP[11011] PUSHB 13 10 MIRP[11100] PUSHB 1 11 MIRP[11101] PUSHB 2 12 MIRP[11110] PUSHB 3 13 MIRP[11111]
fn hu_c9(k): i64 {
    if (k == 0) { return "\xb8\x07\xd0\x1d\xb0\x00\x10\x01\xb1\x01\x06\xf0\xb1\x02\x07\xf1\xb1\x03\x08\xf2"; }
    if (k == 1) { return "\xb1\x04\x09\xf3\xb1\x05\x0a\xf4\xb1\x06\x0b\xf5\xb1\x07\x0c\xf6\xb1\x08\x0d\xf7"; }
    if (k == 2) { return "\x00\xb1\x09\x06\xf8\xb1\x0a\x07\xf9\xb1\x0b\x08\xfa\xb1\x0c\x09\xfb\xb1\x0d\x0a"; }
    if (k == 3) { return "\xfc\xb1\x01\x0b\xfd\xb1\x02\x0c\xfe\xb1\x03\x0d\xff"; }
    return 0;
}

fn hu_e9(i, f): i64 {
    if (i == 0) { return hu_pick(f, 76, 4, 5); }  if (i == 1) { return hu_pick(f, 152, -756, 24); }
    if (i == 2) { return hu_pick(f, 304, -244, 25); }  if (i == 3) { return hu_pick(f, 531, 332, 24); }
    if (i == 4) { return hu_pick(f, 228, 226, 9); }  if (i == 5) { return hu_pick(f, -156, 305, 8); }
    if (i == 6) { return hu_pick(f, -604, 299, 9); }  if (i == 7) { return hu_pick(f, -1116, 152, 8); }
    if (i == 8) { return hu_pick(f, -540, 76, 9); }  if (i == 9) { return hu_pick(f, 227, 0, 17); }
    if (i == 10) { return hu_pick(f, 227, 152, 16); }  if (i == 11) { return hu_pick(f, 224, 379, 17); }
