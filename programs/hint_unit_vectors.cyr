    if (p == 138) { return hu_x138(k); }  if (p == 139) { return hu_x139(k); }  if (p == 140) { return hu_x140(k); }
    if (p == 141) { return hu_x141(k); }  if (p == 142) { return hu_x142(k); }  if (p == 143) { return hu_x143(k); }
    if (p == 144) { return hu_x144(k); }  if (p == 145) { return hu_x145(k); }  if (p == 146) { return hu_x146(k); }
    if (p == 147) { return hu_x147(k); }  if (p == 148) { return hu_x148(k); }  if (p == 149) { return hu_x149(k); }
    if (p == 150) { return hu_x150(k); }  if (p == 151) { return hu_x151(k); }  if (p == 152) { return hu_x152(k); }
    if (p == 153) { return hu_x153(k); }  if (p == 154) { return hu_x154(k); }  if (p == 155) { return hu_x155(k); }
    if (p == 156) { return hu_x156(k); }  if (p == 157) { return hu_x157(k); }  if (p == 158) { return hu_x158(k); }
    if (p == 159) { return hu_x159(k); }  if (p == 160) { return hu_x160(k); }  if (p == 161) { return hu_x161(k); }
    if (p == 162) { return hu_x162(k); }  if (p == 163) { return hu_x163(k); }  if (p == 164) { return hu_x164(k); }
    if (p == 165) { return hu_x165(k); }  if (p == 166) { return hu_x166(k); }
    return 0;
}

fn hu_num(p, k): i64 {
    if (k < 0) { return 0; }
    var seen = 0;
    var c = 0;
    var s = hu_xchunk(p, c);
    while (s != 0) {
        var j = 0;
        while (load8(s + j) != 0) {
            if (load8(s + j) == 32) {
                j = j + 1;
            } else {
                var neg = 0;
                if (load8(s + j) == 45) { neg = 1; j = j + 1; }
                var v = 0;
                while ((load8(s + j) >= 48) && (load8(s + j) <= 57)) {
                    v = (v * 10) + (load8(s + j) - 48);
                    j = j + 1;
                }
                if (neg == 1) { v = 0 - v; }
                if (seen == k) { return v; }
                seen = seen + 1;
            }
        }
        c = c + 1;
        s = hu_xchunk(p, c);
    }
    return 0;
}

# Where glyph 3's record starts: after glyph 2's `points contours advance`, its ends and its
# points, or after the single -1.
fn hu_rec3(p): i64 {
    var n2 = hu_num(p, 0);
    if (n2 < 0) { return 1; }
    return 3 + hu_num(p, 1) + (3 * n2);
}

# The record at number offset `b`: field f 0 points, 1 contours, 2 advance; end c; point i's
# x (0), y (1), tag (2). Out of range answers 0; a glyph not recorded answers -1 for points and
# 0 for everything else.
fn hu_rec_field(p, b, f): i64 {
    if (hu_num(p, b) < 0) { if (f == 0) { return 0 - 1; } return 0; }
    return hu_num(p, b + f);
}

fn hu_rec_end(p, b, c): i64 {
    if (c < 0) { return 0; }
    if (c >= hu_rec_field(p, b, 1)) { return 0; }
    return hu_num(p, b + 3 + c);
}

fn hu_rec_point(p, b, i, f): i64 {
    if (i < 0) { return 0; }
    if (i >= hu_rec_field(p, b, 0)) { return 0; }
    if (f < 0) { return 0; }
    if (f > 2) { return 0; }
    return hu_num(p, b + 3 + hu_num(p, b + 1) + (3 * i) + f);
}

fn hu_expect2_points(p): i64 { return hu_rec_field(p, 0, 0); }
fn hu_expect2_contours(p): i64 { return hu_rec_field(p, 0, 1); }
fn hu_expect2_advance(p): i64 { return hu_rec_field(p, 0, 2); }
fn hu_expect2_end(p, c): i64 { return hu_rec_end(p, 0, c); }
fn hu_expect2_x(p, i): i64 { return hu_rec_point(p, 0, i, 0); }
fn hu_expect2_y(p, i): i64 { return hu_rec_point(p, 0, i, 1); }
fn hu_expect2_tag(p, i): i64 { return hu_rec_point(p, 0, i, 2); }

fn hu_expect3_points(p): i64 { return hu_rec_field(p, hu_rec3(p), 0); }
fn hu_expect3_contours(p): i64 { return hu_rec_field(p, hu_rec3(p), 1); }
fn hu_expect3_advance(p): i64 { return hu_rec_field(p, hu_rec3(p), 2); }
fn hu_expect3_end(p, c): i64 { return hu_rec_end(p, hu_rec3(p), c); }
fn hu_expect3_x(p, i): i64 { return hu_rec_point(p, hu_rec3(p), i, 0); }
fn hu_expect3_y(p, i): i64 { return hu_rec_point(p, hu_rec3(p), i, 1); }
fn hu_expect3_tag(p, i): i64 { return hu_rec_point(p, hu_rec3(p), i, 2); }
