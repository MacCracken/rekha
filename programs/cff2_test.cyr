# programs/cff2_test.cyr — RUN test for CFF2 (src/cff2.cyr): the variable-font charstring table,
# decoded at its DEFAULT instance.
#
# ⭐ EVERY FONT HERE IS BUILT IN CODE — a CFF2 table (5-byte header, a Top DICT that is NOT an INDEX,
# u32-counted INDEXes, a required FDArray, an optional FDSelect and an ItemVariationStore) inside an
# OTTO SFNT with head / maxp / hhea / hmtx. Group A decodes one glyph per shape and asserts every
# point by hand; group B drives `blend` and `vsindex` against a real two-subtable variation store;
# group C the refusals, each an EMPTY glyph or a table that does not resolve; group D a guard
# differential over every cut of the CFF2 table.
#
# ⚠ WHAT "DEFAULT INSTANCE" MEANS FOR THE ASSERTIONS. At the default location every region scalar is
# zero, so a blended value IS its default and the deltas are dead weight. Group B therefore encodes
# deltas that would move a point a long way and requires the point NOT to move — if rekha ever
# started applying them, or dropped the wrong number of stack entries, these coordinates change.
#
# Exit code = failed checks; each failure prints its number, group, got and want.

include "programs/prelude.cyr"

var g_fails = 0;
var g_n = 0;
var g_group = "";

fn check(got, want): i64 {
    g_n = g_n + 1;
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    var m = "cff2_test: check failed at #";
    syscall(1, 2, m, strlen(m));
    fmt_int_fd(2, g_n);
    syscall(1, 2, " (", 2);
    syscall(1, 2, g_group, strlen(g_group));
    syscall(1, 2, ") got ", 6);
    fmt_int_fd(2, got);
    syscall(1, 2, " want ", 6);
    fmt_int_fd(2, want);
    syscall(1, 2, "\n", 1);
    return 1;
}

var FB = 0;
var FB_CAP = 262144;

fn put_u16(buf, off, v): i64 {
    store8(buf + off, (v >> 8) & 255);
    store8(buf + off + 1, v & 255);
    return 0;
}

fn put_u32(buf, off, v): i64 {
    put_u16(buf, off, (v >> 16) & 65535);
    put_u16(buf, off + 2, v & 65535);
    return 0;
}

# ── a charstring under construction ──
var g_cs = 0;
var g_csn = 0;

fn cs_reset(): i64 { g_csn = 0; return 0; }
fn cs_b(v): i64 { store8(g_cs + g_csn, v & 255); g_csn = g_csn + 1; return 0; }
fn cs_op(op): i64 { return cs_b(op); }

# Type 2 number encoding, the three integer forms a CFF2 charstring uses.
fn cs_n(v): i64 {
    if (v >= 0 - 107 && v <= 107) { return cs_b(v + 139); }
    if (v >= 108 && v <= 1131) {
        var w = v - 108;
        cs_b((w >> 8) + 247);
        return cs_b(w & 255);
    }
    if (v <= 0 - 108 && v >= 0 - 1131) {
        var u = 0 - v - 108;
        cs_b((u >> 8) + 251);
        return cs_b(u & 255);
    }
    cs_b(28);
    cs_b((v >> 8) & 255);
    return cs_b(v & 255);
}

# ── a table of charstrings ──
var g_tab = 0;        # i64[64] of (offset, length) pairs into g_pool
var g_tabn = 0;
var g_pool = 0;
var g_pooln = 0;

fn tab_reset(): i64 { g_tabn = 0; g_pooln = 0; return 0; }

fn tab_add(): i64 {
    memcpy(g_pool + g_pooln, g_cs, g_csn);
    store64(g_tab + g_tabn * 16, g_pooln);
    store64(g_tab + g_tabn * 16 + 8, g_csn);
    g_pooln = g_pooln + g_csn;
    g_tabn = g_tabn + 1;
    return 0;
}

# A CFF2 INDEX (u32 count, 1-byte offsets — every object here is small). Returns its byte length.
fn idx32(at, first, cnt): i64 {
    put_u32(FB, at, cnt);
    if (cnt == 0) { return 4; }
    store8(FB + at + 4, 1);
    var total = 1;
    var i = 0;
    while (i <= cnt) {
        store8(FB + at + 5 + i, total);
        if (i < cnt) { total = total + load64(g_tab + (first + i) * 16 + 8); }
        i = i + 1;
    }
    var data = at + 5 + cnt + 1;
    i = 0;
    var w = 0;
    while (i < cnt) {
        var ln = load64(g_tab + (first + i) * 16 + 8);
        memcpy(FB + data + w, g_pool + load64(g_tab + (first + i) * 16), ln);
        w = w + ln;
        i = i + 1;
    }
    return 5 + cnt + 1 + w;
}

fn d_int(at, v): i64 {
    store8(FB + at, 29);
    put_u32(FB, at + 1, v);
    return 5;
}

# ── build options ──
var o_major = 2;
var o_hdrsize = 5;
var o_nocs = 0;         # omit the CharStrings operator
var o_nofd = 0;         # omit the FDArray operator
var o_vstore = 1;       # 1 = emit an ItemVariationStore, 0 = none
var o_fdsel = 0;        # 0 = none, 3 = format 3, 4 = format 4 (which rekha must refuse)
var o_privvs = 0 - 1;   # >= 0 = write that vsindex into the Private DICT
var o_fvar = 0;         # 1 = emit an fvar with one 'wght' axis, 100 / 400 / 900
var o_avar = 0;         # 1 = emit an avar mapping the positive half through 0.3 -> 0.8

fn opts_reset(): i64 {
    o_major = 2;
    o_hdrsize = 5;
    o_nocs = 0;
    o_nofd = 0;
    o_vstore = 1;
    o_fdsel = 0;
    o_privvs = 0 - 1;
    o_fvar = 0;
    o_avar = 0;
    return 0;
}

var g_cff = 0;
var g_cfflen = 0;
var g_flen = 0;

# Build an OTTO font whose only outline table is CFF2, over the charstrings in g_tab.
fn build(): i64 {
    memset(FB, 0, FB_CAP);
    var ng = g_tabn;
    put_u32(FB, 0, 0x4F54544F);
    # ⚠ EVERY TABLE STARTS PAST THE DIRECTORY, and the layout is COMPUTED rather than written down:
    # rekha refuses a table beginning below dir_end (sfnt.cyr's bounds invariant), and a hardcoded
    # layout silently breaks the moment the directory grows by an entry. programs/cff_test.cyr had
    # exactly that bug from 0.4.2 to 0.4.10 — an unreadable head and unitsPerEm 0, unnoticed.
    var ntab = 4;
    if (o_fvar != 0) { ntab = ntab + 1; }
    if (o_avar != 0) { ntab = ntab + 1; }
    ntab = ntab + 1;                                    # CFF2
    put_u16(FB, 4, ntab);
    var at0 = 12 + ntab * 16;
    var head_at = at0;
    var maxp_at = head_at + 56;
    var hhea_at = maxp_at + 8;
    var hmtx_at = hhea_at + 40;
    var fvar_at = hmtx_at + ((ng * 4 + 3) & (0 - 4));
    var fvlen = 0;
    if (o_fvar != 0) { fvlen = 36; }
    var avar_at = fvar_at + fvlen;
    var avlen = 0;
    if (o_avar != 0) { avlen = 26; }
    var cff = avar_at + ((avlen + 3) & (0 - 4));
    var de = 12;
    put_u32(FB, de, REKHA_TAG_HEAD); put_u32(FB, de + 8, head_at); put_u32(FB, de + 12, 54);
    de = de + 16;
    put_u32(FB, de, REKHA_TAG_MAXP); put_u32(FB, de + 8, maxp_at); put_u32(FB, de + 12, 6);
    de = de + 16;
    put_u32(FB, de, REKHA_TAG_HHEA); put_u32(FB, de + 8, hhea_at); put_u32(FB, de + 12, 36);
    de = de + 16;
    put_u32(FB, de, REKHA_TAG_HMTX); put_u32(FB, de + 8, hmtx_at); put_u32(FB, de + 12, ng * 4);
    de = de + 16;
    if (o_fvar != 0) {
        put_u32(FB, de, 0x66766172); put_u32(FB, de + 8, fvar_at); put_u32(FB, de + 12, fvlen);
        de = de + 16;
        # one axis, 'wght' 100 / 400 / 900, in fvar's own 16.16 Fixed
        put_u16(FB, fvar_at, 1);
        put_u16(FB, fvar_at + 4, 16);
        put_u16(FB, fvar_at + 8, 1);
        put_u16(FB, fvar_at + 10, 20);
        put_u32(FB, fvar_at + 16, 0x77676874);
        put_u32(FB, fvar_at + 20, 100 * 65536);
        put_u32(FB, fvar_at + 24, 400 * 65536);
        put_u32(FB, fvar_at + 28, 900 * 65536);
        put_u16(FB, fvar_at + 34, 256);
    }
    if (o_avar != 0) {
        put_u32(FB, de, 0x61766172); put_u32(FB, de + 8, avar_at); put_u32(FB, de + 12, avlen);
        de = de + 16;
        put_u16(FB, avar_at, 1);
        put_u16(FB, avar_at + 6, 1);                    # one SegmentMap
        put_u16(FB, avar_at + 8, 4);                    # four positions
        put_u16(FB, avar_at + 10, 49152); put_u16(FB, avar_at + 12, 49152);   # -1 -> -1
        put_u16(FB, avar_at + 14, 0);     put_u16(FB, avar_at + 16, 0);       #  0 ->  0
        put_u16(FB, avar_at + 18, 4915);  put_u16(FB, avar_at + 20, 13107);   # 0.3 -> 0.8
        put_u16(FB, avar_at + 22, 16384); put_u16(FB, avar_at + 24, 16384);   #  1 ->  1
    }
    put_u16(FB, head_at + 18, 1000);
    put_u16(FB, maxp_at + 4, ng);
    put_u16(FB, hhea_at + 34, ng);
    var i = 0;
    while (i < ng) {
        put_u16(FB, hmtx_at + i * 4, 500 + i);
        i = i + 1;
    }
    g_cff = cff;

    # the Top DICT is a fixed 19 / 25 bytes: CharStrings, FDArray, and optionally vstore + FDSelect
    var tdl = 0;
    if (o_nocs == 0) { tdl = tdl + 6; }
    if (o_nofd == 0) { tdl = tdl + 7; }
    if (o_vstore != 0) { tdl = tdl + 6; }
    if (o_fdsel != 0) { tdl = tdl + 7; }
    store8(FB + cff, o_major);
    store8(FB + cff + 1, 0);
    store8(FB + cff + 2, o_hdrsize);
    put_u16(FB, cff + 3, tdl);
    var top = cff + o_hdrsize;
    var p = top + tdl;

    put_u32(FB, p, 0);                                  # Global Subr INDEX, count 0 (four bytes)
    p = p + 4;
    var cs_at = p;
    p = p + idx32(p, 0, ng);

    var fdsel_at = p;
    if (o_fdsel == 3) {
        store8(FB + p, 3);
        put_u16(FB, p + 1, 1);
        put_u16(FB, p + 3, 0);
        store8(FB + p + 5, 0);
        put_u16(FB, p + 6, ng);
        p = p + 8;
    }
    if (o_fdsel == 4) {
        store8(FB + p, 4);
        put_u32(FB, p + 1, 1);
        put_u32(FB, p + 5, 0);
        put_u16(FB, p + 9, 0);
        put_u32(FB, p + 11, ng);
        p = p + 15;
    }

    # the Private DICT, then the Font DICT that names it, then the FDArray holding that
    var priv_at = p;
    var privlen = 0;
    if (o_privvs >= 0) {
        privlen = d_int(p, o_privvs);
        store8(FB + p + privlen, 22);                   # vsindex
        privlen = privlen + 1;
    }
    p = p + privlen;
    var fd_at = p;
    var fdlen = d_int(p, privlen);
    fdlen = fdlen + d_int(p + fdlen, priv_at - cff);
    store8(FB + p + fdlen, 18);                         # Private (size, offset)
    fdlen = fdlen + 1;
    p = p + fdlen;
    var fdarray_at = p;
    put_u32(FB, p, 1);
    store8(FB + p + 4, 1);
    store8(FB + p + 5, 1);
    store8(FB + p + 6, 1 + fdlen);
    memcpy(FB + p + 7, FB + fd_at, fdlen);
    p = p + 7 + fdlen;

    # the ItemVariationStore: two subtables over two regions, 2 and 1 regions wide
    var vstore_at = p;
    if (o_vstore != 0) {
        var ivs = p + 2;
        var ivd0 = 16;
        var ivd1 = ivd0 + 10;
        var rl = ivd1 + 8;
        put_u16(FB, ivs, 1);                            # format
        put_u32(FB, ivs + 2, rl);
        put_u16(FB, ivs + 6, 2);                        # itemVariationDataCount
        put_u32(FB, ivs + 8, ivd0);
        put_u32(FB, ivs + 12, ivd1);
        put_u16(FB, ivs + ivd0, 0);
        put_u16(FB, ivs + ivd0 + 2, 0);
        put_u16(FB, ivs + ivd0 + 4, 2);                 # regionIndexCount = 2
        put_u16(FB, ivs + ivd0 + 6, 0);
        put_u16(FB, ivs + ivd0 + 8, 1);
        put_u16(FB, ivs + ivd1, 0);
        put_u16(FB, ivs + ivd1 + 2, 0);
        put_u16(FB, ivs + ivd1 + 4, 1);                 # regionIndexCount = 1
        put_u16(FB, ivs + ivd1 + 6, 0);
        put_u16(FB, ivs + rl, 1);                       # axisCount
        put_u16(FB, ivs + rl + 2, 2);                   # regionCount
        # ⭐ Real tents, in F2Dot14: region 0 peaks at +0.5 over (0, 1], region 1 at -0.5 over
        # [-1, 0). At the DEFAULT location both are zero — every coordinate sits on an edge — which
        # is why group B's default-instance results are unaffected by their presence.
        var rb = ivs + rl + 4;
        put_u16(FB, rb, 0);         put_u16(FB, rb + 2, 8192);  put_u16(FB, rb + 4, 16384);
        put_u16(FB, rb + 6, 49152); put_u16(FB, rb + 8, 57344); put_u16(FB, rb + 10, 0);
        var ivslen = rl + 4 + 12;
        put_u16(FB, p, ivslen);
        p = p + 2 + ivslen;
    }

    var q = top;
    if (o_nocs == 0) {
        q = q + d_int(q, cs_at - cff);
        store8(FB + q, 17);
        q = q + 1;
    }
    if (o_nofd == 0) {
        q = q + d_int(q, fdarray_at - cff);
        store8(FB + q, 12);
        store8(FB + q + 1, 36);
        q = q + 2;
    }
    if (o_fdsel != 0) {
        q = q + d_int(q, fdsel_at - cff);
        store8(FB + q, 12);
        store8(FB + q + 1, 37);
        q = q + 2;
    }
    if (o_vstore != 0) {
        q = q + d_int(q, vstore_at - cff);
        store8(FB + q, 24);                             # vstore
        q = q + 1;
    }

    g_cfflen = p - cff;
    put_u32(FB, de, REKHA_TAG_CFF2);
    put_u32(FB, de + 8, cff);
    put_u32(FB, de + 12, g_cfflen);
    g_flen = cff + g_cfflen;
    return g_flen;
}

var g_f = 0;
var g_o = 0;

fn load(gid): i64 {
    g_o = rekha_load_glyph(g_f, gid);
    return rekha_outline_n_points(g_o);
}

fn pt(k, x, y, flag): i64 {
    check(load64(rekha_outline_xs(g_o) + k * 8), x);
    check(load64(rekha_outline_ys(g_o) + k * 8), y);
    check(load8(rekha_outline_on_curve(g_o) + k), flag);
    return 0;
}

fn empty(gid): i64 {
    load(gid);
    check(g_o != 0, 1);
    check(rekha_outline_n_contours(g_o), 0);
    check(rekha_outline_n_points(g_o), 0);
    return 0;
}

fn open_it(): i64 {
    var len = build();
    g_f = rekha_font_open(FB, len);
    return len;
}

# ── A) the container, and one glyph per shape ───────────────────────
fn t_shapes(): i64 {
    g_group = "A shapes";
    tab_reset();
    # 0: rmoveto + two rlinetos, and NO endchar — the charstring simply ends
    cs_reset(); cs_n(0); cs_n(0); cs_op(21); cs_n(10); cs_n(0); cs_op(5); cs_n(0); cs_n(10);
    cs_op(5); tab_add();
    # 1: hmoveto, vlineto, hlineto
    cs_reset(); cs_n(15); cs_op(22); cs_n(20); cs_op(7); cs_n(30); cs_op(6); tab_add();
    # 2: rrcurveto — a cubic, control points flagged 2
    cs_reset(); cs_n(0); cs_n(0); cs_op(21);
    cs_n(10); cs_n(0); cs_n(20); cs_n(10); cs_n(0); cs_n(20); cs_op(8); tab_add();
    # 3: two contours, the second opened by a second rmoveto
    cs_reset(); cs_n(0); cs_n(0); cs_op(21); cs_n(5); cs_n(0); cs_op(5);
    cs_n(20); cs_n(20); cs_op(21); cs_n(5); cs_n(0); cs_op(5); tab_add();
    # 4: a hint operator, then drawing — hints are read for their count and otherwise ignored
    cs_reset(); cs_n(0); cs_n(100); cs_op(1); cs_n(0); cs_n(0); cs_op(21);
    cs_n(8); cs_n(0); cs_op(5); tab_add();
    opts_reset();
    o_vstore = 0;
    check(open_it() > 0, 1);
    check(g_f != 0, 1);
    check(rekha_glyph_count(g_f), 5);
    check(rekha_units_per_em(g_f), 1000);

    check(load(0), 3);
    pt(0, 0, 0, 1); pt(1, 10, 0, 1); pt(2, 10, 10, 1);
    check(rekha_outline_n_contours(g_o), 1);
    check(load(1), 3);
    pt(0, 15, 0, 1); pt(1, 15, 20, 1); pt(2, 45, 20, 1);
    check(load(2), 4);
    pt(0, 0, 0, 1); pt(1, 10, 0, 2); pt(2, 30, 10, 2); pt(3, 30, 30, 1);
    check(load(3), 4);
    check(rekha_outline_n_contours(g_o), 2);
    pt(0, 0, 0, 1); pt(1, 5, 0, 1); pt(2, 25, 20, 1); pt(3, 30, 20, 1);
    check(load(4), 2);
    pt(0, 0, 0, 1); pt(1, 8, 0, 1);
    # ⛔ NO WIDTH IN CFF2. A CFF charstring's first stack-clearing operator may carry one; a CFF2 one
    # never does, and dropping a phantom width here would eat a real coordinate.
    check(load(1), 3);
    pt(0, 15, 0, 1);
    return 0;
}

# ── B) blend and vsindex, against a real variation store ───────────────────
fn t_blend(): i64 {
    g_group = "B blend";
    tab_reset();
    # 0: blend two values over the Private DICT's default subtable (0), which has TWO regions.
    #    The four deltas would move the point to (140, 260) if they were ever applied.
    cs_reset();
    cs_n(100); cs_n(200); cs_n(10); cs_n(20); cs_n(30); cs_n(40); cs_n(2); cs_op(16);
    cs_op(21); cs_n(300); cs_n(0); cs_op(5); tab_add();
    # 1: vsindex 1 first — subtable 1 has ONE region, so a blend of two values drops two deltas
    cs_reset();
    cs_n(1); cs_op(15);
    cs_n(50); cs_n(60); cs_n(5); cs_n(6); cs_n(2); cs_op(16);
    cs_op(21); cs_n(100); cs_n(0); cs_op(5); tab_add();
    # 2: a blend of ONE value, then an ordinary argument beside it
    cs_reset();
    cs_n(70); cs_n(7); cs_n(8); cs_n(1); cs_op(16);
    cs_n(80); cs_op(21); cs_n(9); cs_n(0); cs_op(5); tab_add();
    # 3: no blend at all, in the same font
    cs_reset(); cs_n(7); cs_n(8); cs_op(21); cs_n(70); cs_n(0); cs_op(5); tab_add();
    opts_reset();
    check(open_it() > 0, 1);
    check(g_f != 0, 1);

    check(load(0), 2);
    pt(0, 100, 200, 1);                                  # the defaults, NOT 140 / 260
    pt(1, 400, 200, 1);
    check(load(1), 2);
    pt(0, 50, 60, 1);
    pt(1, 150, 60, 1);
    check(load(2), 2);
    pt(0, 70, 80, 1);
    pt(1, 79, 80, 1);
    check(load(3), 2);
    pt(0, 7, 8, 1);

    # the Private DICT may name the subtable instead: vsindex 1 there gives every glyph k = 1
    tab_reset();
    cs_reset();
    cs_n(100); cs_n(200); cs_n(10); cs_n(20); cs_n(2); cs_op(16);
    cs_op(21); cs_n(300); cs_n(0); cs_op(5); tab_add();
    opts_reset();
    o_privvs = 1;
    check(open_it() > 0, 1);
    check(load(0), 2);
    pt(0, 100, 200, 1);
    pt(1, 400, 200, 1);
    return 0;
}

# ── C) refusals ─────────────────────────────────
fn t_refuse(): i64 {
    g_group = "C refusals";
    # a table that does not resolve at all: the face opens, with no outlines
    var mode = 0;
    while (mode < 6) {
        tab_reset();
        cs_reset(); cs_n(0); cs_n(0); cs_op(21); cs_n(5); cs_n(0); cs_op(5); tab_add();
        opts_reset();
        if (mode == 0) { o_major = 1; }                  # a CFF 1 major in a CFF2 table
        if (mode == 1) { o_major = 3; }
        if (mode == 2) { o_hdrsize = 4; }                # a header shorter than the spec's
        if (mode == 3) { o_nocs = 1; }                   # no CharStrings
        if (mode == 4) { o_nofd = 1; }                   # no FDArray — required in CFF2
        if (mode == 5) { o_fdsel = 4; }                  # FDSelect format 4, which rekha refuses
        open_it();
        check(g_f != 0, 1);                              # the FONT still opens
        check(rekha_outline_n_contours(rekha_load_glyph(g_f, 0)), 0);
        mode = mode + 1;
    }
    # charstring-level refusals: the table resolves, the glyph does not
    tab_reset();
    cs_reset(); cs_n(0); cs_n(0); cs_op(21); cs_n(5); cs_n(0); cs_op(5); cs_op(14); tab_add();
    cs_reset(); cs_n(9); cs_op(15); cs_n(0); cs_n(0); cs_op(21); tab_add();
    cs_reset(); cs_n(0); cs_op(15); cs_n(0); cs_op(15); cs_n(0); cs_n(0); cs_op(21); tab_add();
    cs_reset(); cs_n(1); cs_n(2); cs_n(1); cs_op(16); cs_n(0); cs_op(15);
    cs_n(0); cs_n(0); cs_op(21); tab_add();
    cs_reset(); cs_op(16); tab_add();
    cs_reset(); cs_n(1); cs_n(9); cs_op(16); cs_n(0); cs_n(0); cs_op(21); tab_add();
    cs_reset(); cs_n(0); cs_n(0); cs_op(21); cs_n(5); cs_n(0); cs_op(5); tab_add();
    opts_reset();
    check(open_it() > 0, 1);
    empty(0);                                            # endchar, which CFF2 does not have
    empty(1);                                            # vsindex past the store's subtables
    empty(2);                                            # a second vsindex
    empty(3);                                            # vsindex after a blend
    empty(4);                                            # blend with an empty stack
    empty(5);                                            # blend asking for more than the stack holds
    check(load(6), 2);                                   # and the control, in the same font
    pt(0, 0, 0, 1);

    # a vsindex with NO variation store names something that is not there
    tab_reset();
    cs_reset(); cs_n(0); cs_op(15); cs_n(0); cs_n(0); cs_op(21); cs_n(5); cs_n(0); cs_op(5); tab_add();
    # ⚠ but a BLEND without a store is a no-op that keeps its defaults — there is nothing to drop
    cs_reset(); cs_n(3); cs_n(4); cs_n(2); cs_op(16); cs_op(21); cs_n(5); cs_n(0); cs_op(5); tab_add();
    opts_reset();
    o_vstore = 0;
    check(open_it() > 0, 1);
    empty(0);
    check(load(1), 2);
    pt(0, 3, 4, 1);
    return 0;
}

# ── D) a guard differential over every cut of the CFF2 table ──────────────────
var g_gb = 0;

fn guarded(len, fill): i64 {
    var p = g_gb + 512;
    memset(p - 256, fill, 256);
    memcpy(p, FB, len);
    memset(p + len, fill, 256);
    var f = rekha_font_open(p, len);
    var h = 0;
    if (f == 0) { return 1; }
    var ng = rekha_glyph_count(f);
    h = (h ^ ng) * 0x100000001b3;
    var gid = 0;
    while (gid < ng) {
        var o = rekha_load_glyph(f, gid);
        h = (h ^ rekha_outline_n_contours(o)) * 0x100000001b3;
        var np = rekha_outline_n_points(o);
        h = (h ^ np) * 0x100000001b3;
        var k = 0;
        while (k < np) {
            h = (h ^ load64(rekha_outline_xs(o) + k * 8)) * 0x100000001b3;
            h = (h ^ load64(rekha_outline_ys(o) + k * 8)) * 0x100000001b3;
            k = k + 1;
        }
        gid = gid + 1;
    }
    return h;
}

fn t_guard(): i64 {
    g_group = "D guard";
    tab_reset();
    cs_reset();
    cs_n(100); cs_n(200); cs_n(10); cs_n(20); cs_n(30); cs_n(40); cs_n(2); cs_op(16);
    cs_op(21); cs_n(300); cs_n(0); cs_op(5); tab_add();
    cs_reset(); cs_n(1); cs_op(15); cs_n(50); cs_n(60); cs_n(5); cs_n(6); cs_n(2); cs_op(16);
    cs_op(21); cs_n(100); cs_n(0); cs_op(5); tab_add();
    var len = open_it();
    check(guarded(len, 0xA5), guarded(len, 0x5A));
    # every truncation of the whole font, with the CFF2 table's declared length left as it was
    var cut = 0;
    var bad = 0;
    while (cut < len) {
        if (guarded(cut, 0xA5) != guarded(cut, 0x5A)) { bad = bad + 1; }
        cut = cut + 1;
    }
    check(bad, 0);
    # and a byte-mutation sweep over the CFF2 table itself: no read may leave the file
    var seed = 12345;
    var i = 0;
    var mbad = 0;
    while (i < 900) {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
        var at = g_cff + seed % g_cfflen;
        var old = load8(FB + at);
        store8(FB + at, (old + 1 + (seed >> 16)) & 255);
        if (guarded(len, 0xA5) != guarded(len, 0x5A)) { mbad = mbad + 1; }
        store8(FB + at, old);
        i = i + 1;
    }
    check(mbad, 0);
    return 0;
}

# ================================================================
# F) INSTANCING (0.4.11): fvar, avar, and blend applying its deltas instead of dropping them.
#
# The font is group B's, plus a real fvar ('wght' 100 / 400 / 900) and the store's two region tents
# — region 0 peaking at +0.5 over (0, 1], region 1 at -0.5 over [-1, 0). Every expected coordinate
# below is worked out from those tents and the charstrings' own deltas, not read back off rekha.
# ================================================================

fn t_instance(): i64 {
    g_group = "F instancing";
    tab_reset();
    # 0: two values blended over BOTH regions — v0 = 100 (+10 r0, +20 r1), v1 = 200 (+30, +40)
    cs_reset();
    cs_n(100); cs_n(200); cs_n(10); cs_n(20); cs_n(30); cs_n(40); cs_n(2); cs_op(16);
    cs_op(21); cs_n(300); cs_n(0); cs_op(5); tab_add();
    # 1: vsindex 1 — one region (r0) — v0 = 50 (+5), v1 = 60 (+6)
    cs_reset();
    cs_n(1); cs_op(15);
    cs_n(50); cs_n(60); cs_n(5); cs_n(6); cs_n(2); cs_op(16);
    cs_op(21); cs_n(100); cs_n(0); cs_op(5); tab_add();
    # 2: ONE value blended, beside an ordinary argument — v0 = 70 (+7 r0, +8 r1), then a plain 80
    cs_reset();
    cs_n(70); cs_n(7); cs_n(8); cs_n(1); cs_op(16);
    cs_n(80); cs_op(21); cs_n(9); cs_n(0); cs_op(5); tab_add();
    # 3: no blend at all — this glyph must never move
    cs_reset(); cs_n(7); cs_n(8); cs_op(21); cs_n(70); cs_n(0); cs_op(5); tab_add();
    opts_reset();
    o_fvar = 1;
    check(open_it() > 0, 1);
    check(g_f != 0, 1);

    # the axes rekha reports are fvar's own
    check(rekha_var_axis_count(g_f), 1);
    check(rekha_var_axis_tag(g_f, 0), 0x77676874);
    check(sd_asr(rekha_var_axis_min(g_f, 0), 16), 100);
    check(sd_asr(rekha_var_axis_default(g_f, 0), 16), 400);
    check(sd_asr(rekha_var_axis_max(g_f, 0), 16), 900);
    check(rekha_var_axis_tag(g_f, 1), 0);
    check(rekha_var_axis_count(0), 0);

    # ⭐ AT THE DEFAULT, NOTHING MOVES — every region's coordinate sits on one of its edges, so every
    # scalar is zero and a blend keeps its defaults. This is the 0.4.9 behaviour, unchanged.
    check(rekha_var_coord(g_f, 0), 0);
    check(load(0), 2);
    pt(0, 100, 200, 1);
    check(rekha_var_set_axis(g_f, 0, 400 * 65536), 1);
    check(rekha_var_coord(g_f, 0), 0);
    check(load(0), 2);
    pt(0, 100, 200, 1);

    # at the far ends the coordinate is ON an edge of the only region that could reach it: still zero
    check(rekha_var_set_axis(g_f, 0, 900 * 65536), 1);
    check(rekha_var_coord(g_f, 0), 65536);
    check(load(0), 2);
    pt(0, 100, 200, 1);
    check(rekha_var_set_axis(g_f, 0, 100 * 65536), 1);
    check(rekha_var_coord(g_f, 0), 0 - 65536);
    pt(0, 100, 200, 1);

    # ⭐ AT THE PEAK of region 0 (wght 650 -> normalized +0.5) its scalar is 1 and region 1's is 0
    check(rekha_var_set_axis(g_f, 0, 650 * 65536), 1);
    check(rekha_var_coord(g_f, 0), 32768);
    check(load(0), 2);
    pt(0, 110, 230, 1);                                  # 100 + 10, 200 + 30
    pt(1, 410, 230, 1);
    check(load(1), 2);
    pt(0, 55, 66, 1);                                    # 50 + 5, 60 + 6, over one region
    pt(1, 155, 66, 1);
    check(load(2), 2);
    pt(0, 77, 80, 1);                                    # 70 + 7 blended, 80 plain
    check(load(3), 2);
    pt(0, 7, 8, 1);                                      # a glyph with no blend never moves

    # ⭐ HALFWAY UP THE TENT (wght 525 -> +0.25, scalar 0.5): the deltas arrive halved
    check(rekha_var_set_axis(g_f, 0, 525 * 65536), 1);
    check(rekha_var_coord(g_f, 0), 16384);
    check(load(0), 2);
    pt(0, 105, 215, 1);                                  # 100 + 5, 200 + 15
    check(load(1), 2);
    pt(0, 53, 63, 1);                                    # 50 + 2.5 -> 53 (half up), 60 + 3
    # the NEGATIVE half reaches region 1 instead
    check(rekha_var_set_axis(g_f, 0, 250 * 65536), 1);
    check(rekha_var_coord(g_f, 0), 0 - 32768);
    check(load(0), 2);
    pt(0, 120, 240, 1);                                  # 100 + 20, 200 + 40, region 1 at its peak
    check(load(1), 2);
    pt(0, 50, 60, 1);                                    # vsindex 1 names region 0 only: unmoved

    # ⭐ AND BACK: reset returns the font to the instance it opened at
    check(rekha_var_reset(g_f), 1);
    check(rekha_var_coord(g_f, 0), 0);
    check(load(0), 2);
    pt(0, 100, 200, 1);

    # a bad axis index moves nothing, and a font with no fvar has no axes to move
    check(rekha_var_set_axis(g_f, 1, 650 * 65536), 0);
    check(rekha_var_set_axis(g_f, 0 - 1, 650 * 65536), 0);
    check(rekha_var_set_axis(0, 0, 0), 0);
    check(load(0), 2);
    pt(0, 100, 200, 1);
    opts_reset();
    check(open_it() > 0, 1);
    check(rekha_var_axis_count(g_f), 0);
    check(rekha_var_set_axis(g_f, 0, 650 * 65536), 0);
    check(rekha_var_reset(g_f), 0);
    check(load(0), 2);
    pt(0, 100, 200, 1);
    return 0;
}

# ── G) avar: the same axis, mapped ──────────────────────────
fn t_avar(): i64 {
    g_group = "G avar";
    tab_reset();
    cs_reset();
    cs_n(100); cs_n(200); cs_n(10); cs_n(20); cs_n(30); cs_n(40); cs_n(2); cs_op(16);
    cs_op(21); cs_n(300); cs_n(0); cs_op(5); tab_add();
    opts_reset();
    o_fvar = 1;
    o_avar = 1;
    check(open_it() > 0, 1);
    # the map is {-1 -> -1, 0 -> 0, 0.3 -> 0.8, 1 -> 1}, so the lower positive half is stretched
    check(rekha_var_set_axis(g_f, 0, 400 * 65536), 1);
    check(rekha_var_coord(g_f, 0), 0);                   # the default is a fixed point of the map
    check(rekha_var_set_axis(g_f, 0, 900 * 65536), 1);
    check(rekha_var_coord(g_f, 0), 65536);               # so is the top
    # wght 550 normalizes to +0.3, which the map sends to +0.8 — past region 0's peak, on its way
    # down: scalar = (1 - 0.8) / (1 - 0.5) = 0.4
    check(rekha_var_set_axis(g_f, 0, 550 * 65536), 1);
    check(rekha_var_coord(g_f, 0) > 52000, 1);
    check(rekha_var_coord(g_f, 0) < 53000, 1);
    check(load(0), 2);
    pt(0, 104, 212, 1);                                  # 100 + 0.4*10, 200 + 0.4*30
    # and without the avar the same setting lands at +0.3, BELOW the peak: scalar = 0.3/0.5 = 0.6
    opts_reset();
    o_fvar = 1;
    check(open_it() > 0, 1);
    check(rekha_var_set_axis(g_f, 0, 550 * 65536), 1);
    check(load(0), 2);
    pt(0, 106, 218, 1);                                  # 100 + 0.6*10, 200 + 0.6*30
    return 0;
}

fn main(): i64 {
    alloc_init();
    FB = alloc(FB_CAP);
    g_cs = alloc(4096);
    g_pool = alloc(65536);
    g_tab = alloc(64 * 16);
    g_gb = alloc(FB_CAP);
    t_shapes();
    t_blend();
    t_refuse();
    t_guard();
    t_instance();
    t_avar();
    if (g_fails == 0) {
        var ok = "cff2_test: PASS (container, shapes, blend, instancing, avar, refusals, guard; ";
        syscall(1, 1, ok, strlen(ok));
        fmt_int(g_n);
        syscall(1, 1, " checks)\n", 9);
    }
    return g_fails;
}

var exit_code = main();
syscall(60, exit_code);
