fn hg_row_gid(r): i64 { return hg_glyph_gid(hg_row_glyph(r)); }
fn hg_row_points(r): i64 { return hg_glyph_points(hg_row_glyph(r)); }
fn hg_row_contours(r): i64 { return hg_glyph_contours(hg_row_glyph(r)); }
fn hg_row_end(r, c): i64 { return hg_glyph_end(hg_row_glyph(r), c); }

