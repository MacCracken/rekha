# programs/woff_dist_test.cyr — RUN test for the SHIPPED WOFF bundle, dist/rekha-woff.cyr, compiled
# the way a WOFF consumer compiles it.
#
# ⭐ WHAT THIS EXISTS TO PROVE. programs/woff_test.cyr includes src/, so a `[lib.woff]` profile that
# `cyrius distlib woff` folded wrong would pass it and fail the first consumer. This suite never
# touches src/ and never touches programs/prelude.cyr: the leaves dist/rekha-woff.deps NAMES,
# sadish, then `sync` (which the sankoch leaf needs), then dist/rekha-woff.cyr INSTEAD of
# dist/rekha.cyr, then the embedded face. It wraps the face into a WOFF with sankoch's
# zlib_compress and opens it through the bundle's public API, and measures what that open
# allocates.
#
# Since 0.4.4 the leaf list below is dist/rekha-woff.deps, by hand, instead of all nine leaves,
# so the file documents the chain a WOFF consumer actually compiles. 0.4.5 dropped
# `include "lib/alloc.cyr"` with the 6.6.6 pin — that toolchain's lib/string.cyr includes alloc
# itself, so it left the sidecar. It does NOT enforce it:
# cyrius auto-prepends every resolved leaf inside rekha's tree, so the suite builds whichever
# lines are here. Sufficiency is distlib's compile-verify pass (`--check`, gated in CI).
#
# ⚠ The bundle must be CURRENT for this to mean anything: `cyrius distlib --check` (every profile) is
# the companion gate. Exit code = failed checks; each failure prints its check number to fd 2.

# ---- a WOFF consumer's include chain: dist/rekha-woff.deps, then sadish and sync ----
include "lib/string.cyr"
# harness-only, NOT in dist/rekha-woff.deps: fmt_int_fd for the failure lines.
include "lib/fmt.cyr"
include "lib/sadish.cyr"
# `sync` is not in the sidecar either — it is the sankoch LEAF's own requirement, which a
# consumer picks up from sankoch's sidecar, not from rekha's.
include "lib/sync.cyr"
include "lib/sankoch.cyr"
include "dist/rekha-woff.cyr"
include "fonts/face_data.cyr"

var g_fails = 0;
var g_n = 0;

fn check(got, want): i64 {
    g_n = g_n + 1;
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    var m = "woff_dist_test: check failed at #";
    syscall(1, 2, m, strlen(m));
    fmt_int_fd(2, g_n);
    syscall(1, 2, "\n", 1);
    return 1;
}

var g_arena = 0;

# ── a consumer's own byte helpers. ⛔ Since 0.9.0 the bundle is PRIVATE: rekha_rd_u16 / rekha_wr_u32 /
# rekha_pad4 and the WOFF header constants are internals a consumer cannot name (the compile error
# is `'rekha_rd_u16' is private to its file`), so this test, which IS a consumer's include chain,
# carries its own — 20 lines, and the proof that the surface suffices to build a WOFF by hand. ──
var WD_HDR_LEN = 44;      # the WOFF 1.0 header
var WD_DIR_LEN = 20;      # one table directory entry
var WD_SIG = 0x774F4646;  # 'wOFF'

fn wd_rd_u16(buf, off): i64 { return (load8(buf + off) << 8) | load8(buf + off + 1); }
fn wd_rd_u32(buf, off): i64 { return (wd_rd_u16(buf, off) << 16) | wd_rd_u16(buf, off + 2); }
fn wd_wr_u16(buf, off, v): i64 {
    store8(buf + off, (v >> 8) & 255); store8(buf + off + 1, v & 255);
    return 0;
}
fn wd_wr_u32(buf, off, v): i64 {
    wd_wr_u16(buf, off, (v >> 16) & 65535); wd_wr_u16(buf, off + 2, v & 65535);
    return 0;
}
fn wd_pad4(n): i64 { return (n + 3) & (0 - 4); }

fn hook_alloc(n): i64 {
    return arena_alloc(g_arena, n);
}

fn main(): i64 {
    alloc_init();
    var n = rekha_face_default_len();
    var face = alloc(n);
    rekha_face_default_copy(face, n);
    check(rekha_face_default_verify(face, n), 1);                     # 1

    # wrap the face: every table zlib-compressed where that is shorter
    var cap = 1048576;
    var w = alloc(cap);
    memset(w, 0, cap);
    var nt = wd_rd_u16(face, 4);
    var at = WD_HDR_LEN + nt * WD_DIR_LEN;
    var total = 12 + nt * 16;
    var i = 0;
    while (i < nt) {
        var d = 12 + i * 16;
        var off = wd_rd_u32(face, d + 8);
        var olen = wd_rd_u32(face, d + 12);
        var e = WD_HDR_LEN + i * WD_DIR_LEN;
        var clen = zlib_compress(face + off, olen, w + at, cap - at);
        if (clen <= 0 || clen >= olen) {
            memcpy(w + at, face + off, olen);
            clen = olen;
        }
        wd_wr_u32(w, e, wd_rd_u32(face, d));
        wd_wr_u32(w, e + 4, at);
        wd_wr_u32(w, e + 8, clen);
        wd_wr_u32(w, e + 12, olen);
        wd_wr_u32(w, e + 16, wd_rd_u32(face, d + 4));
        at = at + wd_pad4(clen);
        total = total + wd_pad4(olen);
        i = i + 1;
    }
    wd_wr_u32(w, 0, WD_SIG);
    wd_wr_u32(w, 4, wd_rd_u32(face, 0));
    wd_wr_u32(w, 8, at);
    wd_wr_u16(w, 12, nt);
    wd_wr_u32(w, 16, total);

    check(rekha_woff_sfnt_size(w, at), total);                        # 2
    var f = rekha_font_open_any(w, at);
    check(f != 0, 1);                                                  # 3
    check(rekha_units_per_em(f), 2048);                                # 4
    check(rekha_char_to_glyph(f, 65), rekha_char_to_glyph(rekha_font_open(face, n), 65));   # 5
    check(sd_path_verb_count(rekha_char_to_sdpath(f, 65, 65536 / 64, 0, 0)) > 0, 1);         # 6
    check(rekha_char_advance_px(f, 65, 16) > 0, 1);                    # 7

    # ── what an open costs: the SFNT buffer + the RekhaFont on the sd_alloc seam; sankoch's inflate
    # bookkeeping on the global heap. MEASURED (sankoch 2.7.15): 448 B per rekha_woff_decode, flat —
    # asserted as a bound, not an exact count, since it is sankoch's to change ──
    g_arena = arena_new_growable(4194304);
    sd_alloc_set(&hook_alloc);
    var a0 = arena_used(g_arena);
    var f2 = rekha_font_open_woff(w, at);
    var arena_cost = arena_used(g_arena) - a0;
    var g0 = alloc_used();
    var f3 = rekha_font_open_woff(w, at);
    var heap_second = alloc_used() - g0;
    sd_alloc_set(0);
    check(f2 != 0, 1);                                                 # 8
    check(f3 != 0, 1);                                                 # 9
    check(arena_cost, ((total + 7) & (0 - 8)) + REKHA_FONT_SIZE);      # 10 — exactly the SFNT + the font
    check(heap_second < 4096, 1);                                      # 11 — the 410 KB SFNT is NOT here

    # ── the WOFF2 half of the same bundle is really in it (0.4.6) ──
    # ⭐ WHAT THIS CATCHES. `distlib --check` proves the bundle matches src/; it cannot prove the
    # [lib.woff] MODULE LIST names woff2.cyr at all. Drop that line from cyrius.cyml and the bundle
    # is still "current" and every other suite still passes, because they include src/ directly.
    # These calls only link if woff2.cyr folded in, and only answer if it folded in ORDER (it calls
    # woff.cyr's rekha_wr_u32 / rekha_pad4). ⚠ Through 0.8.2 two more checks here reached the
    # internals rekha_w2_known_tag / rekha_w2_triplet; the private bundle (0.9.0) refuses them to
    # a consumer, so they moved to programs/woff2_test.cyr (group "bundle internals").
    # ⚠ The WOFF2 ROUND TRIP lives in programs/woff2_test.cyr, which needs a WOFF2 encoder; this is
    # a presence-and-refusal check on the shipped bundle, not a second copy of it.
    check(rekha_woff2_block_size(w, at), 0);                           # 12 — a WOFF 1.0 is not a WOFF2
    check(rekha_font_open_woff2(w, at), 0);                            # 13
    check(rekha_woff2_face_count(w, at), 0);                           # 14 — nor a WOFF2 collection
    check(rekha_font_open_any(face, n) != 0, 1);                       # 15 — the dispatcher moved here

    if (g_fails == 0) {
        var ok = "woff_dist_test: PASS (bundle compiles, opens a WOFF, WOFF2 folded in, SFNT + font on the seam)\n";
        syscall(1, 1, ok, strlen(ok));
    }
    return g_fails;
}

var exit_code = main();
syscall(60, exit_code);
