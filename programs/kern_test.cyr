# programs/kern_test.cyr — RUN test for the legacy `kern` table (src/kern.cyr).
#
# ⭐ THE FONT IS BUILT HERE — head / maxp / hhea / hmtx / loca / glyf / cmap / kern, with the kern
# table written in EITHER of the two incompatible forms that share the tag: Microsoft's version 0
# (u16 count, u16 subtable length, u16 coverage) and Apple's version 1.0 (u32 count, u32 length, a
# coverage BYTE and a separate format byte). Group C builds the same pairs both ways and requires
# the same answers, because reading one as the other does not fail — it walks into the middle of a
# pair array and returns a number.
#
# ⛔ GROUP E IS THE ONE WITH TEETH. A MINIMUM subtable's value is a FLOOR on a pair's spacing, not
# an adjustment to it, and a decoder that adds it anyway turns a minimum into a visible gap. So are
# cross-stream and vertical subtables skipped, and format 2, which rekha does not read.
#
# Exit code = failed checks; each failure prints its number, group, got and want.

include "programs/prelude.cyr"

var g_fails = 0;
var g_n = 0;
var g_group = "";

fn check(got, want): i64 {
    g_n = g_n + 1;
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    var m = "kern_test: check failed at #";
    syscall(1, 2, m, strlen(m));
    fmt_int_fd(2, g_n);
    syscall(1, 2, " (", 2);
    syscall(1, 2, g_group, strlen(g_group));
    syscall(1, 2, ") got ", 6);
    fmt_int_fd(2, got);
    syscall(1, 2, " want ", 6);
    fmt_int_fd(2, want);
    syscall(1, 2, "\n", 1);
    return 1;
}

var FB = 0;
var FB_CAP = 32768;
var NG = 300;

fn pu16(off, v): i64 {
    store8(FB + off, (v >> 8) & 255);
    store8(FB + off + 1, v & 255);
    return 0;
}

fn pu32(off, v): i64 {
    pu16(off, (v >> 16) & 65535);
    pu16(off + 2, v & 65535);
    return 0;
}

# ── build options ────────────────────────────────
var o_nokern = 0;
var o_apple = 0;        # write Apple's version 1.0 form instead of Microsoft's version 0
var o_ver = 0;          # override the version word (2 = neither form)
var o_fmt = 0;          # the subtable format to declare
var o_cov = 1;          # Microsoft coverage bits; the Apple byte is derived from them
var o_nsub = 1;         # how many subtables
var o_big = 0;          # a 200-pair array instead of the five below
var o_badlen = 0;       # declare a subtable length below its own header
var o_shortpairs = 0;   # declare more pairs than the subtable holds

var g_kern = 0;
var g_kernlen = 0;
var g_flen = 0;

# Five pairs, sorted by (left, right) as the format requires.
fn kp_n(): i64 { return 5; }
fn kp_l(i): i64 {
    if (i == 0) { return 1; }
    if (i == 1) { return 1; }
    if (i == 2) { return 2; }
    if (i == 3) { return 3; }
    return 5;
}
fn kp_r(i): i64 {
    if (i == 0) { return 2; }
    if (i == 1) { return 3; }
    if (i == 2) { return 3; }
    if (i == 3) { return 1; }
    return 7;
}
fn kp_v(i): i64 {
    if (i == 0) { return 0 - 40; }
    if (i == 1) { return 0 - 25; }
    if (i == 2) { return 0 - 60; }
    if (i == 3) { return 15; }
    return 0 - 100;
}

# ⭐ THE BIG ARRAY, for the binary search: 200 pairs at left 10, right 0, 2, 4, ... so half the
# keys a search can be asked for are deliberately absent.
fn big_n(): i64 { return 200; }
fn big_r(i): i64 { return i * 2; }
fn big_v(i): i64 { return 0 - (i + 1); }

# One format 0 body at `at`, with `sub` telling which subtable this is (for the accumulate group).
fn put_f0(at, sub): i64 {
    var n = kp_n();
    if (o_big != 0) { n = big_n(); }
    var dn = n;
    if (o_shortpairs != 0) { dn = n + 400; }
    pu16(at, dn);
    pu16(at + 2, 0);
    pu16(at + 4, 0);
    pu16(at + 6, 0);
    var i = 0;
    while (i < n) {
        var p = at + 8 + i * 6;
        if (o_big != 0) {
            pu16(p, 10);
            pu16(p + 2, big_r(i));
            pu16(p + 4, big_v(i) & 65535);
        } else {
            pu16(p, kp_l(i));
            pu16(p + 2, kp_r(i));
            # ⚠ the SECOND subtable halves every value, so the accumulate group can tell the two
            # apart from their sum
            var v = kp_v(i);
            if (sub == 1) { v = v / 2; }
            pu16(p + 4, v & 65535);
        }
        i = i + 1;
    }
    return 8 + n * 6;
}

fn put_kern(at): i64 {
    var hdr = 6;
    if (o_apple != 0) { hdr = 8; }
    var p = 4;
    if (o_apple != 0) {
        pu32(at, 0x00010000);
        pu32(at + 4, o_nsub);
        p = 8;
    } else {
        pu16(at, o_ver);
        pu16(at + 2, o_nsub);
    }
    var s = 0;
    while (s < o_nsub) {
        var sat = at + p;
        var body = put_f0(sat + hdr, s);
        var slen = hdr + body;
        if (o_badlen != 0) { slen = hdr - 1; }
        if (o_apple != 0) {
            pu32(sat, slen);
            var acov = 0;
            if ((o_cov & 1) == 0) { acov = acov + 128; }      # not horizontal -> VERTICAL
            if ((o_cov & 4) != 0) { acov = acov + 64; }       # CROSS_STREAM
            store8(FB + sat + 4, acov);
            store8(FB + sat + 5, o_fmt);
            pu16(sat + 6, 0);
        } else {
            pu16(sat, 0);
            pu16(sat + 2, slen);
            pu16(sat + 4, (o_fmt << 8) | o_cov);
        }
        p = p + hdr + body;
        s = s + 1;
    }
    return p;
}

fn build(): i64 {
    memset(FB, 0, FB_CAP);
    var ntab = 7;
    if (o_nokern == 0) { ntab = ntab + 1; }
    pu32(0, 0x00010000);
    pu16(4, ntab);
    var at = 12 + ntab * 16;
    var head_at = at;
    var maxp_at = head_at + 56;
    var hhea_at = maxp_at + 8;
    var hmtx_at = hhea_at + 40;
    var loca_at = hmtx_at + 4;
    var glyf_at = loca_at + (NG + 1) * 4;
    var cmap_at = glyf_at + 4;
    var kern_at = cmap_at + 12 + 262;
    g_kern = kern_at;
    g_kernlen = 0;
    if (o_nokern == 0) { g_kernlen = put_kern(kern_at); }

    pu16(head_at + 18, 1000);
    pu16(head_at + 50, 1);
    pu16(maxp_at + 4, NG);
    pu16(hhea_at + 34, 1);
    pu16(hmtx_at, 500);
    var i = 0;
    while (i <= NG) {
        pu32(loca_at + i * 4, 0);
        i = i + 1;
    }
    # cmap: one (0, 3) record with a format 0 byte map, so 'A' is glyph 1 and 'B' glyph 2
    pu16(cmap_at, 0);
    pu16(cmap_at + 2, 1);
    pu16(cmap_at + 4, 0);
    pu16(cmap_at + 6, 3);
    pu32(cmap_at + 8, 12);
    var sub = cmap_at + 12;
    pu16(sub, 0);
    pu16(sub + 2, 262);
    pu16(sub + 4, 0);
    store8(FB + sub + 6 + 65, 1);                        # 'A' -> 1
    store8(FB + sub + 6 + 66, 2);                        # 'B' -> 2
    store8(FB + sub + 6 + 67, 3);                        # 'C' -> 3

    var d = 12;
    pu32(d, REKHA_TAG_HEAD); pu32(d + 8, head_at); pu32(d + 12, 54); d = d + 16;
    pu32(d, REKHA_TAG_MAXP); pu32(d + 8, maxp_at); pu32(d + 12, 6);  d = d + 16;
    pu32(d, REKHA_TAG_HHEA); pu32(d + 8, hhea_at); pu32(d + 12, 36); d = d + 16;
    pu32(d, REKHA_TAG_HMTX); pu32(d + 8, hmtx_at); pu32(d + 12, 4); d = d + 16;
    pu32(d, REKHA_TAG_LOCA); pu32(d + 8, loca_at); pu32(d + 12, (NG + 1) * 4); d = d + 16;
    pu32(d, REKHA_TAG_GLYF); pu32(d + 8, glyf_at); pu32(d + 12, 4); d = d + 16;
    pu32(d, REKHA_TAG_CMAP); pu32(d + 8, cmap_at); pu32(d + 12, 12 + 262); d = d + 16;
    if (o_nokern == 0) {
        pu32(d, REKHA_TAG_KERN); pu32(d + 8, kern_at); pu32(d + 12, g_kernlen); d = d + 16;
    }
    g_flen = kern_at + g_kernlen;
    return g_flen;
}

fn opts_reset(): i64 {
    o_nokern = 0;
    o_apple = 0;
    o_ver = 0;
    o_fmt = 0;
    o_cov = 1;
    o_nsub = 1;
    o_big = 0;
    o_badlen = 0;
    o_shortpairs = 0;
    return 0;
}

var g_f = 0;

fn openf(): i64 {
    build();
    g_f = rekha_font_open(FB, g_flen);
    return g_f;
}

fn all_five(scale): i64 {
    check(rekha_kern_pair(g_f, 1, 2), 0 - 40 * scale);
    check(rekha_kern_pair(g_f, 1, 3), 0 - 25 * scale);
    check(rekha_kern_pair(g_f, 2, 3), 0 - 60 * scale);
    check(rekha_kern_pair(g_f, 3, 1), 15 * scale);
    check(rekha_kern_pair(g_f, 5, 7), 0 - 100 * scale);
    return 0;
}

# ── A) the plain lookup ──────────────────────────────
fn t_basic(): i64 {
    g_group = "A basic";
    opts_reset();
    check(openf() != 0, 1);
    check(rekha_kern_present(g_f), 1);
    all_five(1);
    # ⛔ a pair that is not there is 0, and so is the REVERSE of one that is: kerning is ordered
    check(rekha_kern_pair(g_f, 2, 1), 0);
    check(rekha_kern_pair(g_f, 7, 5), 0);
    check(rekha_kern_pair(g_f, 0, 0), 0);
    check(rekha_kern_pair(g_f, 99, 99), 0);
    # out of range, and the null handle
    check(rekha_kern_pair(g_f, 0 - 1, 2), 0);
    check(rekha_kern_pair(g_f, 1, 70000), 0);
    check(rekha_kern_pair(0, 1, 2), 0);
    check(rekha_kern_present(0), 0);
    # no table at all
    opts_reset();
    o_nokern = 1;
    check(openf() != 0, 1);
    check(rekha_kern_present(g_f), 0);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    return 0;
}

# ── B) the binary search, over 200 pairs with every other key absent ───────────────
fn t_search(): i64 {
    g_group = "B search";
    opts_reset();
    o_big = 1;
    check(openf() != 0, 1);
    var i = 0;
    var bad = 0;
    while (i < big_n()) {
        if (rekha_kern_pair(g_f, 10, big_r(i)) != big_v(i)) { bad = bad + 1; }
        # the odd key between this one and the next is deliberately not in the array
        if (rekha_kern_pair(g_f, 10, big_r(i) + 1) != 0) { bad = bad + 1; }
        i = i + 1;
    }
    check(bad, 0);
    check(rekha_kern_pair(g_f, 10, 400), 0);             # past the last
    check(rekha_kern_pair(g_f, 9, 4), 0);                # a left that is not there
    check(rekha_kern_pair(g_f, 11, 4), 0);
    return 0;
}

# ── C) Apple's form answers the same ──────────────────────────
fn t_apple(): i64 {
    g_group = "C apple";
    opts_reset();
    o_apple = 1;
    check(openf() != 0, 1);
    check(rekha_kern_present(g_f), 1);
    all_five(1);
    check(rekha_kern_pair(g_f, 2, 1), 0);
    # ⛔ its coverage byte reads the other way round: bit 7 set means VERTICAL, so an unset bit 7
    # is what horizontal looks like. Asking for a vertical table here must yield nothing.
    opts_reset();
    o_apple = 1;
    o_cov = 0;
    check(openf() != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    return 0;
}

# ── D) two subtables: accumulate, then override ──────────────────────
fn t_accumulate(): i64 {
    g_group = "D accumulate";
    # ⭐ the second subtable carries HALF of each value, so a sum is visible: -40 + -20 = -60
    opts_reset();
    o_nsub = 2;
    check(openf() != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0 - 60);
    check(rekha_kern_pair(g_f, 3, 1), 22);               # 15 + 7
    check(rekha_kern_pair(g_f, 2, 1), 0);
    # ⛔ OVERRIDE REPLACES what came before, so only the second subtable's value survives
    opts_reset();
    o_nsub = 2;
    o_cov = 1 + 8;
    check(openf() != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0 - 20);
    check(rekha_kern_pair(g_f, 3, 1), 7);
    return 0;
}

# ── E) the subtables that are skipped ─────────────────────────
fn t_skip(): i64 {
    g_group = "E skip";
    # ⛔ MINIMUM: the value is a FLOOR on the pair's spacing, not an adjustment to it. Adding it is
    # how a minimum becomes a visible gap.
    opts_reset();
    o_cov = 1 + 2;
    check(openf() != 0, 1);
    check(rekha_kern_present(g_f), 1);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    # cross-stream moves text off the baseline
    opts_reset();
    o_cov = 1 + 4;
    check(openf() != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    # not horizontal
    opts_reset();
    o_cov = 0;
    check(openf() != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    # ⚠ format 2 is not read, and a font carrying one alongside a format 0 still kerns from the
    # format 0. Here it is the only subtable, so nothing does.
    opts_reset();
    o_fmt = 2;
    check(openf() != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    # ...and a skipped subtable does not stop the walk: two subtables, the first minimum
    opts_reset();
    o_nsub = 2;
    o_cov = 1 + 2;
    check(openf() != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0);                # both are minimum here
    return 0;
}

# ── F) refusals ─────────────────────────────────
fn t_refuse(): i64 {
    g_group = "F refusals";
    # a version that is neither Microsoft's 0 nor Apple's 1.0
    opts_reset();
    o_ver = 2;
    check(openf() != 0, 1);
    check(rekha_kern_present(g_f), 0);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    # ⛔ a subtable that does not declare at least its own header. A zero-length one would walk the
    # loop forever, which is why the length is checked before the step and not after.
    opts_reset();
    o_badlen = 1;
    check(openf() != 0, 1);
    check(rekha_kern_present(g_f), 1);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    # a pair count the subtable does not hold
    opts_reset();
    o_shortpairs = 1;
    check(openf() != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0);
    # a count far past what the table holds: the walk stops at the table's end
    opts_reset();
    o_nsub = 1;
    check(openf() != 0, 1);
    pu16(g_kern + 2, 400);
    g_f = rekha_font_open(FB, g_flen);
    check(g_f != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0 - 40);           # the one real subtable still answers
    check(rekha_kern_pair(g_f, 9, 9), 0);
    return 0;
}

# ── G) characters, and pixels ────────────────────────────
fn t_chars(): i64 {
    g_group = "G chars";
    opts_reset();
    check(openf() != 0, 1);
    check(rekha_char_to_glyph(g_f, 65), 1);
    check(rekha_char_kern(g_f, 65, 66), 0 - 40);         # 'A' 'B' -> glyphs 1, 2
    check(rekha_char_kern(g_f, 65, 67), 0 - 25);         # 'A' 'C'
    check(rekha_char_kern(g_f, 66, 65), 0);
    check(rekha_char_kern(g_f, 90, 65), 0);              # 'Z' is unmapped
    check(rekha_char_kern(0, 65, 66), 0);
    # ⚠ HALF UP, NOT HALF AWAY FROM ZERO. -40/1000 em at 16 px is -0.64, which rounds to -1;
    # -5/1000 em at 100 px is exactly -0.5, which rounds to 0.
    check(rekha_kern_pair_px(g_f, 1, 2, 16), 0 - 1);
    check(rekha_kern_pair_px(g_f, 1, 2, 1000), 0 - 40);
    check(rekha_kern_pair_px(g_f, 3, 1, 1000), 15);
    check(rekha_kern_pair_px(g_f, 2, 1, 16), 0);
    check(rekha_kern_pair_px(0, 1, 2, 16), 0);
    return 0;
}

# ── H) every byte of the table, flipped ─────────────────────────
fn t_guard(): i64 {
    g_group = "H guard";
    opts_reset();
    o_nsub = 2;
    build();
    var lo = g_kern;
    var hi = g_kern + g_kernlen;
    var bad = 0;
    var at = lo;
    while (at < hi) {
        var bit = 0;
        while (bit < 8) {
            var orig = load8(FB + at);
            store8(FB + at, orig ^ (1 << bit));
            var f = rekha_font_open(FB, g_flen);
            if (f != 0) {
                # ⛔ Whatever these bytes say, a kern must stay a plausible design-unit number and
                # the walk must TERMINATE — a zero-length subtable is the way it would not.
                var v = rekha_kern_pair(f, 1, 2);
                if (v > 100000 || v < 0 - 100000) { bad = bad + 1; }
                v = rekha_kern_pair(f, 5, 7);
                if (v > 100000 || v < 0 - 100000) { bad = bad + 1; }
                if (rekha_char_kern(f, 65, 66) > 100000) { bad = bad + 1; }
            }
            store8(FB + at, orig);
            bit = bit + 1;
        }
        at = at + 1;
    }
    check(bad, 0);
    g_f = rekha_font_open(FB, g_flen);
    check(g_f != 0, 1);
    check(rekha_kern_pair(g_f, 1, 2), 0 - 60);
    return 0;
}

fn main(): i64 {
    alloc_init();
    FB = alloc(FB_CAP);
    t_basic();
    t_search();
    t_apple();
    t_accumulate();
    t_skip();
    t_refuse();
    t_chars();
    t_guard();
    if (g_fails == 0) {
        var ok = "kern_test: PASS (lookup, 200-pair search, Apple's form, accumulate, skips; ";
        syscall(1, 1, ok, strlen(ok));
        fmt_int(g_n);
        syscall(1, 1, " checks)\n", 9);
    }
    return g_fails;
}

var exit_code = main();
syscall(60, exit_code);
