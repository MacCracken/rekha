# @internal — CFF: OpenType 'OTTO' outlines (the 'CFF ' table, Type 2 charstrings).
#
# cff.cyr — resolve a CFF table once at rekha_font_open and decode a glyph's Type 2 charstring into
# the SAME RekhaOutline glyf.cyr produces, so rekha_load_glyph / rekha_glyph_to_sdpath /
# rekha_char_to_sdpath draw OTTO faces with no consumer change. A cubic control point carries
# on_curve flag 2 (glyf's 0 = quadratic control, 1 = on-curve); rekha_emit_contour turns
# control, control, on-curve into sd_path_cubicto.
#
# CFF (Adobe TN 5176) layout, big-endian: Header (major u8, minor u8, hdrSize u8, offSize u8), then
# four INDEXes — Name, Top DICT, String, Global Subr. An INDEX is count u16; (count > 0) offSize u8,
# offset[count + 1] (offSize bytes each, 1-based from the byte before the data), data.
# Top DICT operators read: CharStrings (17), Private (18: size offset), CharstringType (12 6, must be
# 2), ROS (12 30: CID-keyed), FDArray (12 36), FDSelect (12 37). Private DICT: Subrs (19, relative to
# the Private DICT). A CID-keyed font's glyph takes its local Subrs from FDArray[FDSelect(gid)].
#
# ⛔ BOUNDS. Every read is inside the CFF table's DECLARED extent (rekha_find_table_len's rule): each
# INDEX header and offset array is checked where it is read, each object's [start, end) is checked on
# every access, every DICT operand walk stops at its DICT's end, and a charstring is interpreted only
# inside its own object's bytes (a subroutine inside its own). Offsets a DICT carries are refused when
# negative or past the extent.
# ⛔ WORK. One glyph decode is bounded whatever the font says: 65,536 interpreted operators and
# numbers per pass, subroutine nesting 10, an argument stack of 48, REKHA_COMPOSITE_MAXP points (the
# glyf ceiling) — past any of them the glyph is EMPTY — and the load budget rekha_load_glyph carries.
#
# DECODE CONTRACT (what programs/cff_test.cyr and the reference differential pin):
#   - coordinates accumulate in 16.16; each point is rounded floor(v + 1/2) into design units
#     (charstring units — every CFF face surveyed has FontMatrix = 1 / unitsPerEm);
#   - rmoveto / hmoveto / vmoveto start a contour; a contour holding only its moveto point is dropped;
#   - lineto -> 1 on-curve point; curveto -> control (2), control (2), on-curve (1);
#   - hint operators are read for their stem count (hintmask / cntrmask byte length) and otherwise
#     ignored; the optional leading width argument is consumed and ignored (advances come from hmtx);
#   - flex, hflex, hflex1, flex1 draw their two curves;
#   - a four-argument endchar is `seac`: the glyph is glyph `bchar` at the origin followed by glyph
#     `achar` displaced by (adx, ady), both named by STANDARD ENCODING CODE and resolved through the
#     font's charset (0.4.7). EMPTY when either code is unassigned, either SID is not in the charset,
#     the charset is one rekha does not carry, the font is CID-keyed, a component is this same glyph,
#     or a component is itself a seac;
#   - EMPTY (not partial) for: the deprecated arithmetic / storage operators, an operator with too few
#     arguments, a lineto or curveto before any moveto, a charstring that ends without endchar, and
#     any bound above.
# ⚠ A number cut by the end of its charstring (28 needs 2 bytes, 255 needs 4, 247..254 need 1) is
# refused by a byte check that keeps the read inside the object and changes no RESULT — a number with
# nothing after it can never be consumed. A hint mask running past its charstring IS a broken rule
# (a subroutine's caller would otherwise go on drawing).

var REKHA_CFF_MAXOPS    = 65536;
var REKHA_CFF_MAXDEPTH  = 10;
var REKHA_CFF_MAXSTACK  = 48;

# ================================================================
# INDEX + DICT readers
# ================================================================

fn rekha_cff_offn(buf, p, osz): i64 {
    var v = 0;
    var k = 0;
    while (k < osz) {
        v = v * 256 + load8(buf + p + k);
        k = k + 1;
    }
    return v;
}

# An INDEX's count field is u16 in CFF and u32 in CFF2 (0.4.9); everything after it is identical, so
# the three readers below take the width and the bounds logic is written ONCE. `csz` is 2 or 4.
fn rekha_cff_idx_count_at(buf, at, csz): i64 {
    if (csz == 2) { return rekha_rd_u16(buf, at); }
    return rekha_rd_u32(buf, at);
}

# Validate the INDEX at `at` (inside `end`): returns the position just past it, or 0 when its count,
# offSize, offset array or last offset does not fit. A count-0 INDEX is just its count field.
# ⚠ A u32 count can reach 2^32-1, so `(count + 1) * osz` reaches ~1.7e10 — inside i64 with room,
# and the very next line refuses it against `end`.
fn rekha_cff_idx_next(buf, at, end, csz): i64 {
    if (at + csz > end) { return 0; }
    var count = rekha_cff_idx_count_at(buf, at, csz);
    if (count < 0) { return 0; }
    if (count == 0) { return at + csz; }
    if (at + csz + 1 > end) { return 0; }
    var osz = load8(buf + at + csz);
    if (osz < 1 || osz > 4) { return 0; }
    var offs = at + csz + 1;
    if (offs + (count + 1) * osz > end) { return 0; }
    var data = offs + (count + 1) * osz - 1;
    var last = rekha_cff_offn(buf, offs + count * osz, osz);
    if (last < 1) { return 0; }
    if (data + last > end) { return 0; }
    return data + last;
}

fn rekha_cff_idx_obj(buf, at, end, i, out, csz): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    if (rekha_cff_idx_next(buf, at, end, csz) == 0) { return 0; }
    var count = rekha_cff_idx_count_at(buf, at, csz);
    if (i < 0 || i >= count) { return 0; }
    var osz = load8(buf + at + csz);
    var offs = at + csz + 1;
    var data = offs + (count + 1) * osz - 1;
    var a = rekha_cff_offn(buf, offs + i * osz, osz);
    var b = rekha_cff_offn(buf, offs + (i + 1) * osz, osz);
    if (a < 1) { return 0; }
    if (b < a) { return 0; }
    if (data + b > end) { return 0; }
    store64(out, data + a);
    store64(out + 8, b - a);
    return 1;
}

fn rekha_cff_index_next(buf, at, end): i64 {
    return rekha_cff_idx_next(buf, at, end, 2);
}

# The count of the INDEX at `at`, or -1 when its header does not validate.
fn rekha_cff_index_count(buf, at, end): i64 {
    if (rekha_cff_index_next(buf, at, end) == 0) { return 0 - 1; }
    return rekha_rd_u16(buf, at);
}

# Object `i` of the INDEX at `at`: out+0 = absolute start, out+8 = byte length. 1, or 0 when the
# INDEX is invalid, `i` is out of range, or the object's offsets are not 1 <= start <= stop inside end.
fn rekha_cff_obj(buf, at, end, i, out): i64 {
    return rekha_cff_idx_obj(buf, at, end, i, out, 2);
}

# Find operator `op` (a byte 0..21, or 1200 + the second byte of a 12-escape) in the DICT [a, b).
# On a hit: out+0 = operands before it, out+8 = the last operand, out+16 = the one before (reals
# count as operands of value 0). Returns 1 / 0 (absent, or a malformed operand stops the walk).
# `maxop` is the highest byte that counts as an OPERATOR. ⛔ It is 21 in CFF, where 22..27 are
# reserved and a DICT holding one is malformed — the scan stops. CFF2 puts real operators up there:
# `vstore` is 24 in the Top DICT, and `vsindex` (22) and `blend` (23) live in a Private DICT. Reading
# a CFF2 DICT with the CFF ceiling stops the scan AT the operator being looked for, which is how the
# variation store went missing the first time this was wired up: CharStrings and FDArray were found
# because they happened to come first, and `vstore` never was. Bytes 28..30 stay operand prefixes at
# either ceiling.
fn rekha_cff_dict_op_max(buf, a, b, op, out, maxop): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    var n = 0;
    var last = 0;
    var prev = 0;
    var p = a;
    while (p < b) {
        var b0 = load8(buf + p);
        if (b0 <= maxop) {
            var o = b0;
            p = p + 1;
            if (b0 == 12) {
                if (p >= b) { return 0; }
                o = 1200 + load8(buf + p);
                p = p + 1;
            }
            if (o == op) {
                store64(out, n);
                store64(out + 8, last);
                store64(out + 16, prev);
                return 1;
            }
            n = 0;
            last = 0;
            prev = 0;
        } else {
            var v = 0;
            if (b0 == 28) {
                if (p + 3 > b) { return 0; }
                v = rekha_rd_i16(buf, p + 1);
                p = p + 3;
            } else {
                if (b0 == 29) {
                    if (p + 5 > b) { return 0; }
                    v = rekha_rd_u32(buf, p + 1);
                    if (v >= 0x80000000) { v = v - 0x100000000; }
                    p = p + 5;
                } else {
                    if (b0 == 30) {
                        p = p + 1;
                        var more = 1;
                        while (more != 0) {
                            if (p >= b) { return 0; }
                            var nb = load8(buf + p);
                            p = p + 1;
                            if ((nb >> 4) == 15 || (nb & 15) == 15) { more = 0; }
                        }
                    } else {
                        if (b0 >= 32 && b0 <= 246) {
                            v = b0 - 139;
                            p = p + 1;
                        } else {
                            if (b0 >= 247 && b0 <= 254) {
                                if (p + 2 > b) { return 0; }
                                if (b0 <= 250) {
                                    v = (b0 - 247) * 256 + load8(buf + p + 1) + 108;
                                } else {
                                    v = 0 - (b0 - 251) * 256 - load8(buf + p + 1) - 108;
                                }
                                p = p + 2;
                            } else {
                                return 0;           # above maxop, 31, 255: reserved in a DICT
                            }
                        }
                    }
                }
            }
            prev = last;
            last = v;
            n = n + 1;
        }
    }
    return 0;
}

fn rekha_cff_dict_op(buf, a, b, op, out): i64 {
    return rekha_cff_dict_op_max(buf, a, b, op, out, 21);
}

# The absolute offset of the Subrs INDEX named by the Private DICT that `dict` [a, b) points at, or 0
# (no Private, no Subrs, or anything out of range). `cff` is the CFF table's start.
fn rekha_cff_priv_subrs_csz(buf, cff, end, a, b, csz): i64 {
    # ⚠ The INDEX width and the DICT dialect always travel together: a u32 INDEX means CFF2, and a
    # CFF2 Private DICT may hold `vsindex` (22) or `blend` (23) AHEAD of its Subrs (19).
    var mx = 21;
    if (csz == 4) { mx = 27; }
    var d: i64[3];
    if (rekha_cff_dict_op_max(buf, a, b, 18, &d, mx) == 0) { return 0; }
    if (load64(&d) < 2) { return 0; }
    var size = load64(&d + 16);
    var poff = load64(&d + 8);
    if (size < 0 || poff < 0) { return 0; }
    var pa = cff + poff;
    var pb = pa + size;
    if (pb > end) { return 0; }
    if (rekha_cff_dict_op_max(buf, pa, pb, 19, &d, mx) == 0) { return 0; }
    var rel = load64(&d + 8);
    if (rel < 0) { return 0; }
    var at = pa + rel;
    # ⚠ A CFF2 local Subrs INDEX counts in u32, so validating it as a CFF INDEX would read the
    # wrong header and either refuse a good font or accept a short one.
    if (rekha_cff_idx_next(buf, at, end, csz) == 0) { return 0; }
    return at;
}

fn rekha_cff_private_subrs(buf, cff, end, a, b): i64 {
    return rekha_cff_priv_subrs_csz(buf, cff, end, a, b, 2);
}

# ================================================================
# Resolve at open — the RekhaFont CFF cache (+176..+239, see sfnt.cyr)
# ================================================================
fn rekha_cff_resolve(f): i64 {
    var k = 176;
    while (k < REKHA_FONT_SIZE) {
        store64(f + k, 0);
        k = k + 8;
    }
    if (load64(f + 16) != REKHA_SFNT_VER_OTTO) { return 0; }
    var c: i64[1];
    var cff = rekha_find_table_len(f, REKHA_TAG_CFF, &c);
    # ⚠ No 'CFF ' is not the end of it: an OpenType face may carry 'CFF2' instead (0.4.9). A font
    # with BOTH keeps the 'CFF ' it had before, so nothing that opened one way starts opening the
    # other.
    if (cff == 0) { return rekha_cff2_resolve(f); }
    var end = cff + load64(&c);
    var buf = load64(f);
    if (cff + 4 > end) { return 0; }
    if (load8(buf + cff) != 1) { return 0; }               # major version 1 (CFF2 is not this table)
    var hs = load8(buf + cff + 2);
    if (hs < 4) { return 0; }
    var p = rekha_cff_index_next(buf, cff + hs, end);      # Name INDEX
    if (p == 0) { return 0; }
    var top_at = p;
    p = rekha_cff_index_next(buf, top_at, end);            # Top DICT INDEX
    if (p == 0) { return 0; }
    var o: i64[2];
    if (rekha_cff_obj(buf, top_at, end, 0, &o) == 0) { return 0; }
    var ta = load64(&o);
    var tb = ta + load64(&o + 8);
    p = rekha_cff_index_next(buf, p, end);                 # String INDEX
    if (p == 0) { return 0; }
    var gs = p;
    if (rekha_cff_index_next(buf, gs, end) == 0) { return 0; }   # Global Subr INDEX

    var d: i64[3];
    if (rekha_cff_dict_op(buf, ta, tb, 1206, &d) != 0) {
        if (load64(&d + 8) != 2) { return 0; }
    }
    if (rekha_cff_dict_op(buf, ta, tb, 17, &d) == 0) { return 0; }
    if (load64(&d + 8) < 0) { return 0; }
    var cs = cff + load64(&d + 8);
    var n = rekha_cff_index_count(buf, cs, end);
    if (n <= 0) { return 0; }

    var subrs = 0;
    var fdarray = 0;
    var fdselect = 0;
    if (rekha_cff_dict_op(buf, ta, tb, 1230, &d) != 0) {
        if (rekha_cff_dict_op(buf, ta, tb, 1236, &d) == 0) { return 0; }
        if (load64(&d + 8) < 0) { return 0; }
        fdarray = cff + load64(&d + 8);
        if (rekha_cff_index_count(buf, fdarray, end) <= 0) { return 0; }
        if (rekha_cff_dict_op(buf, ta, tb, 1237, &d) == 0) { return 0; }
        if (load64(&d + 8) < 0) { return 0; }
        fdselect = cff + load64(&d + 8);
        if (fdselect + 1 > end) { return 0; }
        var fmt = load8(buf + fdselect);
        if (fmt == 0) {
            if (fdselect + 1 + n > end) { return 0; }
        } else {
            if (fmt != 3) { return 0; }
            if (fdselect + 3 > end) { return 0; }
            var nr = rekha_rd_u16(buf, fdselect + 1);
            if (nr < 1) { return 0; }
            if (fdselect + 3 + nr * 3 + 2 > end) { return 0; }
        }
    } else {
        subrs = rekha_cff_private_subrs(buf, cff, end, ta, tb);
    }
    # charset (Top DICT 15) — GID -> SID, which is the only way a `seac` can turn a Standard
    # Encoding code into a glyph. ⛔ Absent means 0, the ISOAdobe PREDEFINED charset, in which SID i
    # is glyph i; 1 and 2 are the Expert charsets, which rekha does not carry (seac refuses on them
    # rather than guess). A custom charset is kept as an absolute offset and bounds-checked here so
    # the lookup below can walk it.
    # ⚠ This never fails the open. A charset rekha cannot use is recorded as -1 and costs only the
    # seac path; every other reader is untouched.
    var charset = 0;
    if (rekha_cff_dict_op(buf, ta, tb, 15, &d) != 0) {
        var cv = load64(&d + 8);
        if (cv < 0) {
            charset = 0 - 1;
        } else {
            if (cv <= 2) {
                charset = cv;
            } else {
                charset = cff + cv;
                if (charset + 1 > end) { charset = 0 - 1; }
            }
        }
    }
    store64(f + 240, charset);
    store64(f + 176, cs);
    store64(f + 184, gs);
    store64(f + 192, subrs);
    store64(f + 200, fdarray);
    store64(f + 208, fdselect);
    store64(f + 216, cff);
    store64(f + 224, end);
    store64(f + 232, n);
    return 0;
}

# The FD index FDSelect assigns glyph `gid` (validated at open), or -1.
fn rekha_cff_fd(font, gid): i64 {
    var buf = load64(font);
    var sel = load64(font + 208);
    # ⚠ CFF2 requires an FDArray but not an FDSelect: with one Font DICT every glyph takes it, and
    # the table is omitted. A CFF with ROS always has one (rekha_cff_resolve refuses it otherwise).
    if (sel == 0) { return 0; }
    if (load8(buf + sel) == 0) { return load8(buf + sel + 1 + gid); }
    var nr = rekha_rd_u16(buf, sel + 1);
    var lo = 0;
    var hi = nr;
    while (lo < hi) {                       # the last range whose first <= gid
        var mid = (lo + hi) / 2;
        if (rekha_rd_u16(buf, sel + 3 + mid * 3) <= gid) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if (lo == 0) { return 0 - 1; }
    var r = sel + 3 + (lo - 1) * 3;
    if (gid >= rekha_rd_u16(buf, r + 3)) { return 0 - 1; }   # the next first / the sentinel
    return load8(buf + r + 2);
}

# ================================================================
# The Type 2 interpreter. State `s` (i64 slots):
# ================================================================
var RC_BUF   = 0;     # font data
var RC_END   = 8;     # CFF extent end
var RC_GS    = 16;    # Global Subr INDEX
var RC_LS    = 24;    # local Subrs INDEX (0 = none)
var RC_SP    = 32;    # argument stack depth
var RC_X     = 40;    # current point, 16.16
var RC_Y     = 48;
var RC_STEMS = 56;    # stem hints seen (hintmask length)
var RC_WDONE = 64;    # the first stack-clearing operator has been seen
var RC_OPEN  = 72;    # a contour is open
var RC_NP    = 80;    # points emitted
var RC_NC    = 88;    # contours closed
var RC_CST   = 96;    # index of the open contour's first point
var RC_OPS   = 104;   # operators + numbers interpreted
var RC_FILL  = 112;   # 0 = count pass, 1 = fill pass
var RC_XS    = 120;
var RC_YS    = 128;
var RC_OC    = 136;
var RC_EPS   = 144;
var RC_BAD   = 152;   # a rule was broken: the glyph is empty
var RC_NPMAX = 160;   # the most points ever held at once (a dropped moveto point counts)
var RC_STK   = 168;   # pointer to the i64[48] argument stack
# The four-argument endchar (`seac`) parks its request here rather than recursing from inside the
# interpreter: rekha_cff_run picks it up once the charstring has ended. 0.4.7.
var RC_SEAC  = 176;   # 1 = the charstring ended with seac arguments
var RC_ADX   = 184;   # 16.16, as the accent is displaced
var RC_ADY   = 192;
var RC_BCH   = 200;   # base and accent STANDARD ENCODING CODES, not glyph ids
var RC_ACH   = 208;
# CFF2 (0.4.9). A CFF2 charstring is Type 2 with three differences the interpreter has to know
# about: no leading width, no `endchar` at all (the bytes simply run out), and two operators of its
# own. Everything else — the drawing operators, the subroutine machinery, the hint operators, flex —
# is shared, which is why this is a mode rather than a second interpreter.
var RC_V2    = 216;   # 1 = CFF2 charstring
var RC_NREG  = 224;   # regions in the CURRENT variation-store index: what one `blend` drops per value
var RC_VST   = 232;   # absolute offset of the ItemVariationStore, 0 = none
var RC_VSOK  = 240;   # 1 while a `vsindex` is still permitted (before any blend, and only once)
var RC_SLOTS = 31;

fn rekha_cff_arg(s, i): i64 { return load64(load64(s + RC_STK) + i * 8); }

# Consume the optional leading width: if the first stack-clearing operator finds `extra` more args
# than it takes, drop the first one.
fn rekha_cff_width(s, extra): i64 {
    # ⛔ A CFF2 charstring has NO leading width — advances come from hmtx and nowhere else. Dropping
    # a "width" there eats a real argument: MEASURED, a blended rmoveto whose two values survived the
    # blend was handed the wrong pair the moment this fired.
    if (load64(s + RC_V2) != 0) { return 0; }
    if (load64(s + RC_WDONE) != 0) { return 0; }
    store64(s + RC_WDONE, 1);
    if (extra == 0) { return 0; }
    var stk = load64(s + RC_STK);
    var sp = load64(s + RC_SP);
    var i = 1;
    while (i < sp) {
        store64(stk + (i - 1) * 8, load64(stk + i * 8));
        i = i + 1;
    }
    store64(s + RC_SP, sp - 1);
    return 0;
}

fn rekha_cff_point(s, flag): i64 {
    var np = load64(s + RC_NP);
    if (np >= REKHA_COMPOSITE_MAXP + 1) {
        store64(s + RC_BAD, 1);
        return 0;
    }
    if (load64(s + RC_FILL) != 0) {
        store64(load64(s + RC_XS) + np * 8, sd_asr(load64(s + RC_X) + 32768, 16));
        store64(load64(s + RC_YS) + np * 8, sd_asr(load64(s + RC_Y) + 32768, 16));
        store8(load64(s + RC_OC) + np, flag);
    }
    np = np + 1;
    store64(s + RC_NP, np);
    if (np > load64(s + RC_NPMAX)) { store64(s + RC_NPMAX, np); }
    return 0;
}

fn rekha_cff_close(s): i64 {
    if (load64(s + RC_OPEN) == 0) { return 0; }
    store64(s + RC_OPEN, 0);
    var np = load64(s + RC_NP);
    var cst = load64(s + RC_CST);
    if (np - cst <= 1) {
        store64(s + RC_NP, cst);            # a moveto with nothing drawn from it is no contour
        return 0;
    }
    var nc = load64(s + RC_NC);
    if (load64(s + RC_FILL) != 0) { store64(load64(s + RC_EPS) + nc * 8, np - 1); }
    store64(s + RC_NC, nc + 1);
    return 0;
}

fn rekha_cff_moveto(s, dx, dy): i64 {
    rekha_cff_close(s);
    store64(s + RC_X, load64(s + RC_X) + dx);
    store64(s + RC_Y, load64(s + RC_Y) + dy);
    store64(s + RC_CST, load64(s + RC_NP));
    store64(s + RC_OPEN, 1);
    return rekha_cff_point(s, 1);
}

fn rekha_cff_line(s, dx, dy): i64 {
    store64(s + RC_X, load64(s + RC_X) + dx);
    store64(s + RC_Y, load64(s + RC_Y) + dy);
    return rekha_cff_point(s, 1);
}

fn rekha_cff_curve(s, a, b, c, d, e, f): i64 {
    var x = load64(s + RC_X) + a;
    var y = load64(s + RC_Y) + b;
    store64(s + RC_X, x);
    store64(s + RC_Y, y);
    rekha_cff_point(s, 2);
    store64(s + RC_X, x + c);
    store64(s + RC_Y, y + d);
    rekha_cff_point(s, 2);
    store64(s + RC_X, x + c + e);
    store64(s + RC_Y, y + d + f);
    return rekha_cff_point(s, 1);
}

# The bias Type 2 adds to a subroutine number, by the INDEX's count.
fn rekha_cff_bias(n): i64 {
    if (n < 1240) { return 107; }
    if (n < 33900) { return 1131; }
    return 32768;
}

# Interpret the charstring bytes [a, b). Returns 1 at endchar, 0 at return / the end of the bytes,
# -1 when a rule is broken (RC_BAD is set too).
fn rekha_cff_exec(s, a, b, depth): i64 {
    if (depth > REKHA_CFF_MAXDEPTH) {
        store64(s + RC_BAD, 1);
        return 0 - 1;
    }
    var buf = load64(s + RC_BUF);
    var stk = load64(s + RC_STK);
    var p = a;
    while (p < b) {
        if (load64(s + RC_BAD) != 0) { return 0 - 1; }
        var ops = load64(s + RC_OPS) + 1;
        store64(s + RC_OPS, ops);
        if (ops > REKHA_CFF_MAXOPS) {
            store64(s + RC_BAD, 1);
            return 0 - 1;
        }
        var v = load8(buf + p);
        var sp = load64(s + RC_SP);
        if (v >= 32 || v == 28) {
            var num = 0;
            if (v == 28) {
                if (p + 3 > b) { store64(s + RC_BAD, 1); return 0 - 1; }
                num = rekha_rd_i16(buf, p + 1) * 65536;
                p = p + 3;
            } else {
                if (v == 255) {
                    if (p + 5 > b) { store64(s + RC_BAD, 1); return 0 - 1; }
                    num = rekha_rd_u32(buf, p + 1);
                    if (num >= 0x80000000) { num = num - 0x100000000; }
                    p = p + 5;
                } else {
                    if (v <= 246) {
                        num = (v - 139) * 65536;
                        p = p + 1;
                    } else {
                        if (p + 2 > b) { store64(s + RC_BAD, 1); return 0 - 1; }
                        if (v <= 250) {
                            num = ((v - 247) * 256 + load8(buf + p + 1) + 108) * 65536;
                        } else {
                            num = (0 - (v - 251) * 256 - load8(buf + p + 1) - 108) * 65536;
                        }
                        p = p + 2;
                    }
                }
            }
            if (sp >= REKHA_CFF_MAXSTACK) { store64(s + RC_BAD, 1); return 0 - 1; }
            store64(stk + sp * 8, num);
            store64(s + RC_SP, sp + 1);
        } else {
            p = p + 1;
            var op = v;
            if (v == 12) {
                if (p >= b) { store64(s + RC_BAD, 1); return 0 - 1; }
                op = 1200 + load8(buf + p);
                p = p + 1;
            }
            var r = rekha_cff_op(s, op, depth);
            if (r == 2) {                           # hintmask / cntrmask: skip the mask bytes
                p = p + (load64(s + RC_STEMS) + 7) / 8;
                if (p > b) { store64(s + RC_BAD, 1); return 0 - 1; }
            } else {
                if (r != 0) { return r; }
            }
        }
    }
    return 0;
}

# Execute one operator. 0 = continue, 1 = endchar, -1 = broken, 0 - 2 = return (subroutine end),
# 2 = a mask operator whose bytes the caller skips.
fn rekha_cff_op(s, op, depth): i64 {
    var sp = load64(s + RC_SP);
    var i = 0;
    if (op == 1 || op == 3 || op == 18 || op == 23 || op == 19 || op == 20) {
        # A width here would make the count odd; dropping it changes no stem count (floor(n / 2) =
        # (n - 1) / 2 for odd n), so the width is only marked consumed.
        rekha_cff_width(s, 0);
        store64(s + RC_STEMS, load64(s + RC_STEMS) + sp / 2);
        store64(s + RC_SP, 0);
        if (op == 19 || op == 20) { return 2; }
        return 0;
    }
    if (op == 21 || op == 22 || op == 4) {
        var need = 1;
        if (op == 21) { need = 2; }
        if (sp > need) { rekha_cff_width(s, 1); } else { rekha_cff_width(s, 0); }
        sp = load64(s + RC_SP);
        if (sp < need) { store64(s + RC_BAD, 1); return 0 - 1; }
        if (op == 21) { rekha_cff_moveto(s, rekha_cff_arg(s, 0), rekha_cff_arg(s, 1)); }
        if (op == 22) { rekha_cff_moveto(s, rekha_cff_arg(s, 0), 0); }
        if (op == 4) { rekha_cff_moveto(s, 0, rekha_cff_arg(s, 0)); }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 14) {                                 # endchar
        # endchar takes nothing, or the four `seac` arguments — and either form may carry a leading
        # width when endchar is the FIRST stack-clearing operator. Five arguments is therefore
        # width + seac, and the width is dropped so the four below are the seac's own.
        # ⚠ rekha_cff_width returns early once a width has already been consumed, so a 5-argument
        # endchar AFTER another stack-clearing operator keeps five and is not read as a seac.
        # ⛔ CFF2 has no `endchar`: a charstring ends when its bytes do. The operator is not merely
        # unused there, it is not in the dialect, so meeting one is a broken charstring.
        if (load64(s + RC_V2) != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        if (sp == 5) { rekha_cff_width(s, 1); } else { rekha_cff_width(s, 0); }
        if (load64(s + RC_SP) == 4) {
            # ⭐ adx ady bchar achar — an accented glyph built from two OTHER glyphs of this font,
            # named by Standard Encoding code. Parked, not recursed: the interpreter has no business
            # resolving a charset mid-charstring, and rekha_cff_run composes the two once this one
            # has properly ended. The stack is cleared so nothing downstream reads it as coordinates.
            store64(s + RC_ADX, rekha_cff_arg(s, 0));
            store64(s + RC_ADY, rekha_cff_arg(s, 1));
            store64(s + RC_BCH, sd_asr(rekha_cff_arg(s, 2), 16));
            store64(s + RC_ACH, sd_asr(rekha_cff_arg(s, 3), 16));
            store64(s + RC_SEAC, 1);
            store64(s + RC_SP, 0);
        }
        rekha_cff_close(s);
        return 1;
    }
    if (op == 10 || op == 29) {                     # callsubr / callgsubr
        if (sp < 1) { store64(s + RC_BAD, 1); return 0 - 1; }
        var at = load64(s + RC_GS);
        if (op == 10) { at = load64(s + RC_LS); }
        if (at == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        var buf = load64(s + RC_BUF);
        var end = load64(s + RC_END);
        var csz = 2;
        if (load64(s + RC_V2) != 0) { csz = 4; }
        if (rekha_cff_idx_next(buf, at, end, csz) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        var count = rekha_cff_idx_count_at(buf, at, csz);
        var idx = sd_asr(rekha_cff_arg(s, sp - 1), 16) + rekha_cff_bias(count);
        store64(s + RC_SP, sp - 1);
        var o: i64[2];
        if (rekha_cff_idx_obj(buf, at, end, idx, &o, csz) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        var r = rekha_cff_exec(s, load64(&o), load64(&o) + load64(&o + 8), depth + 1);
        if (r == 1) { return 1; }
        if (r < 0) {
            if (load64(s + RC_BAD) != 0) { return 0 - 1; }
        }
        return 0;
    }
    if (op == 11) { return 0 - 2; }                 # return

    # ── the two CFF2 operators. Both sit ABOVE the "drawing before a moveto" test below, because a
    # blend builds the arguments an rmoveto is about to take and so legitimately runs before one.
    if (op == 15) {                                 # vsindex
        if (load64(s + RC_V2) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        # ⛔ The spec makes this a MUST twice over: vsindex "must precede all blend operators" and
        # may appear "only once". One flag covers both — a blend clears it too.
        if (load64(s + RC_VSOK) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        if (sp < 1) { store64(s + RC_BAD, 1); return 0 - 1; }
        var vi = sd_asr(rekha_cff_arg(s, sp - 1), 16);
        store64(s + RC_SP, 0);                      # vsindex clears the stack
        store64(s + RC_VSOK, 0);
        var nr = rekha_cff2_regions(load64(s + RC_BUF), load64(s + RC_VST), load64(s + RC_END), vi);
        if (nr < 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        store64(s + RC_NREG, nr);
        return 0;
    }
    if (op == 16) {                                 # blend
        if (load64(s + RC_V2) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        if (sp < 1) { store64(s + RC_BAD, 1); return 0 - 1; }
        var nb = sd_asr(rekha_cff_arg(s, sp - 1), 16);
        sp = sp - 1;
        store64(s + RC_SP, sp);
        store64(s + RC_VSOK, 0);
        if (nb < 0 || nb > REKHA_CFF_MAXSTACK) { store64(s + RC_BAD, 1); return 0 - 1; }
        # ⭐ THE DEFAULT INSTANCE, AND WHY IT IS THIS CHEAP. The stack holds n default values, then
        # n x k deltas, then n. At the default location every region's scalar is zero, so each
        # blended value IS its default — which is already sitting in place, below the deltas. So the
        # whole operator is: drop the count, drop the deltas, leave the defaults.
        var k = load64(s + RC_NREG);
        if (nb + nb * k > sp) { store64(s + RC_BAD, 1); return 0 - 1; }
        store64(s + RC_SP, sp - nb * k);
        return 0;
    }
    if (load64(s + RC_OPEN) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }   # drawing before moveto
    if (op == 5) {                                  # rlineto
        if (sp < 2 || sp % 2 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp) {
            rekha_cff_line(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1));
            i = i + 2;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 6 || op == 7) {                       # hlineto / vlineto
        if (sp < 1) { store64(s + RC_BAD, 1); return 0 - 1; }
        var hor = 0;
        if (op == 6) { hor = 1; }
        while (i < sp) {
            if (hor != 0) {
                rekha_cff_line(s, rekha_cff_arg(s, i), 0);
            } else {
                rekha_cff_line(s, 0, rekha_cff_arg(s, i));
            }
            hor = 1 - hor;
            i = i + 1;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 8) {                                  # rrcurveto
        if (sp < 6 || sp % 6 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp) {
            rekha_cff_curve(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1), rekha_cff_arg(s, i + 2),
              rekha_cff_arg(s, i + 3), rekha_cff_arg(s, i + 4), rekha_cff_arg(s, i + 5));
            i = i + 6;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 24) {                                 # rcurveline
        if (sp < 8 || (sp - 2) % 6 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp - 2) {
            rekha_cff_curve(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1), rekha_cff_arg(s, i + 2),
              rekha_cff_arg(s, i + 3), rekha_cff_arg(s, i + 4), rekha_cff_arg(s, i + 5));
            i = i + 6;
        }
        rekha_cff_line(s, rekha_cff_arg(s, sp - 2), rekha_cff_arg(s, sp - 1));
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 25) {                                 # rlinecurve
        if (sp < 8 || (sp - 6) % 2 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp - 6) {
            rekha_cff_line(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1));
            i = i + 2;
        }
        rekha_cff_curve(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1), rekha_cff_arg(s, i + 2),
          rekha_cff_arg(s, i + 3), rekha_cff_arg(s, i + 4), rekha_cff_arg(s, i + 5));
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 26 || op == 27) {                     # vvcurveto / hhcurveto
        var first = 0;
        if (sp % 4 == 1) {
            first = rekha_cff_arg(s, 0);
            i = 1;
        }
        if (sp - i < 4 || (sp - i) % 4 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp) {
            if (op == 26) {
                rekha_cff_curve(s, first, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1),
                  rekha_cff_arg(s, i + 2), 0, rekha_cff_arg(s, i + 3));
            } else {
                rekha_cff_curve(s, rekha_cff_arg(s, i), first, rekha_cff_arg(s, i + 1),
                  rekha_cff_arg(s, i + 2), rekha_cff_arg(s, i + 3), 0);
            }
            first = 0;
            i = i + 4;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 30 || op == 31) {                     # vhcurveto / hvcurveto
        if (sp < 4 || (sp % 4 != 0 && sp % 4 != 1)) { store64(s + RC_BAD, 1); return 0 - 1; }
        var hstart = 0;
        if (op == 31) { hstart = 1; }
        var full = sp - sp % 4;
        while (i < full) {
            var extra = 0;
            if (i + 4 == full && sp % 4 == 1) { extra = rekha_cff_arg(s, sp - 1); }
            if (hstart != 0) {
                rekha_cff_curve(s, rekha_cff_arg(s, i), 0, rekha_cff_arg(s, i + 1),
                  rekha_cff_arg(s, i + 2), extra, rekha_cff_arg(s, i + 3));
            } else {
                rekha_cff_curve(s, 0, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1),
                  rekha_cff_arg(s, i + 2), rekha_cff_arg(s, i + 3), extra);
            }
            hstart = 1 - hstart;
            i = i + 4;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 1235) {                               # flex: 12 curve args + flex depth
        if (sp != 13) { store64(s + RC_BAD, 1); return 0 - 1; }
        rekha_cff_curve(s, rekha_cff_arg(s, 0), rekha_cff_arg(s, 1), rekha_cff_arg(s, 2),
          rekha_cff_arg(s, 3), rekha_cff_arg(s, 4), rekha_cff_arg(s, 5));
        rekha_cff_curve(s, rekha_cff_arg(s, 6), rekha_cff_arg(s, 7), rekha_cff_arg(s, 8),
          rekha_cff_arg(s, 9), rekha_cff_arg(s, 10), rekha_cff_arg(s, 11));
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 1234) {                               # hflex: dx1 dx2 dy2 dx3 dx4 dx5 dx6
        if (sp != 7) { store64(s + RC_BAD, 1); return 0 - 1; }
        var dy2 = rekha_cff_arg(s, 2);
        rekha_cff_curve(s, rekha_cff_arg(s, 0), 0, rekha_cff_arg(s, 1), dy2, rekha_cff_arg(s, 3), 0);
        rekha_cff_curve(s, rekha_cff_arg(s, 4), 0, rekha_cff_arg(s, 5), 0 - dy2, rekha_cff_arg(s, 6), 0);
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 1236) {                               # hflex1: dx1 dy1 dx2 dy2 dx3 dx4 dx5 dy5 dx6
        if (sp != 9) { store64(s + RC_BAD, 1); return 0 - 1; }
        var dy1 = rekha_cff_arg(s, 1);
        var dy2b = rekha_cff_arg(s, 3);
        var dy5 = rekha_cff_arg(s, 7);
        rekha_cff_curve(s, rekha_cff_arg(s, 0), dy1, rekha_cff_arg(s, 2), dy2b, rekha_cff_arg(s, 4), 0);
        rekha_cff_curve(s, rekha_cff_arg(s, 5), 0, rekha_cff_arg(s, 6), dy5, rekha_cff_arg(s, 8),
          0 - (dy1 + dy2b + dy5));
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 1237) {                               # flex1: dx1 dy1 .. dx5 dy5 d6
        if (sp != 11) { store64(s + RC_BAD, 1); return 0 - 1; }
        var sdx = rekha_cff_arg(s, 0) + rekha_cff_arg(s, 2) + rekha_cff_arg(s, 4) + rekha_cff_arg(s, 6)
        + rekha_cff_arg(s, 8);
        var sdy = rekha_cff_arg(s, 1) + rekha_cff_arg(s, 3) + rekha_cff_arg(s, 5) + rekha_cff_arg(s, 7)
        + rekha_cff_arg(s, 9);
        var lx = 0 - sdx;
        var ly = rekha_cff_arg(s, 10);
        if (sd_abs(sdx) > sd_abs(sdy)) {
            lx = rekha_cff_arg(s, 10);
            ly = 0 - sdy;
        }
        rekha_cff_curve(s, rekha_cff_arg(s, 0), rekha_cff_arg(s, 1), rekha_cff_arg(s, 2),
          rekha_cff_arg(s, 3), rekha_cff_arg(s, 4), rekha_cff_arg(s, 5));
        rekha_cff_curve(s, rekha_cff_arg(s, 6), rekha_cff_arg(s, 7), rekha_cff_arg(s, 8),
          rekha_cff_arg(s, 9), lx, ly);
        store64(s + RC_SP, 0);
        return 0;
    }
    store64(s + RC_BAD, 1);                         # reserved, arithmetic / storage: not read
    return 0 - 1;
}

# Run glyph `gid`'s charstring once (count pass when `fill` is 0). Returns 1 when it decoded under
# every rule, else 0.
# ================================================================
# `seac` — the accented glyph an old CFF face builds from two others (0.4.7).
#
# A four-argument `endchar` says: draw glyph `bchar` at the origin, then glyph `achar` displaced by
# (adx, ady). Both are named by STANDARD ENCODING CODE, so resolving one takes two tables — the
# Standard Encoding (code -> SID) and the font's own charset (SID -> glyph id).
# ⚠ The Type 1 `seac` had a fifth argument, `asb`. Type 2's endchar form drops it and the accent is
# placed at (adx, ady) directly, which is what every decoder this was checked against does.
# ================================================================

# The Standard Encoding SID for `code`, or 0 (which is .notdef, and also what an unassigned code
# means). ⭐ Fourteen contiguous ranges, not a 256-entry table — the encoding happens to be almost
# entirely runs. ⛔ A wrong range picks the wrong accent SILENTLY, so this is gated against all 256
# codes by programs/cff_stdenc_vectors.cyr, generated from the table by scripts/cff_stdenc.py and
# cross-checked there against fontTools.
fn rekha_cff_stdenc(code): i64 {
    if (code >= 32 && code <= 126) { return code - 31; }        # space .. asciitilde -> 1 .. 95
    if (code >= 161 && code <= 175) { return code - 65; }       # exclamdown .. fl    -> 96 .. 110
    if (code >= 177 && code <= 180) { return code - 66; }       # endash .. periodcentered
    if (code >= 182 && code <= 189) { return code - 67; }       # paragraph .. perthousand
    if (code == 191) { return 123; }                            # questiondown
    if (code >= 193 && code <= 200) { return code - 69; }       # grave .. dieresis
    if (code >= 202 && code <= 203) { return code - 70; }       # ring, cedilla
    if (code >= 205 && code <= 208) { return code - 71; }       # hungarumlaut .. emdash
    if (code == 225) { return 138; }                            # AE
    if (code == 227) { return 139; }                            # ordfeminine
    if (code >= 232 && code <= 235) { return code - 92; }       # Lslash .. ordmasculine
    if (code == 241) { return 144; }                            # ae
    if (code == 245) { return 145; }                            # dotlessi
    if (code >= 248 && code <= 251) { return code - 102; }      # lslash .. germandbls
    return 0;
}

# The glyph id whose charset entry is `sid`, or -1. Glyph 0 is .notdef (SID 0) and is never stored in
# a charset, so a hit is always >= 1.
# ⛔ Every read is bounded by the CFF extent, and the walk stops at the CharStrings count: a charset
# is allowed to describe more glyphs than the font has, and following it past `n` would hand back a
# glyph id the CharStrings INDEX cannot resolve.
# ⚠ The Expert and ExpertSubset predefined charsets (1 and 2) are NOT carried. They return -1, so a
# seac in such a font yields an empty glyph rather than a wrong one. No surveyed face uses either.
fn rekha_cff_sid_to_gid(font, sid): i64 {
    if (sid <= 0) { return 0 - 1; }
    var cset = load64(font + 240);
    var n = load64(font + 232);
    if (cset == 0) {                                    # ISOAdobe: SID i IS glyph i, up to 228
        if (sid > 228) { return 0 - 1; }
        if (sid >= n) { return 0 - 1; }
        return sid;
    }
    if (cset < 12) { return 0 - 1; }                    # 1 / 2 Expert, or -1 unusable
    var buf = load64(font);
    var end = load64(font + 224);
    var fmt = load8(buf + cset);
    var p = cset + 1;
    if (fmt == 0) {
        var g = 1;
        while (g < n) {
            if (p + 2 > end) { return 0 - 1; }
            if (rekha_rd_u16(buf, p) == sid) { return g; }
            p = p + 2;
            g = g + 1;
        }
        return 0 - 1;
    }
    if (fmt != 1 && fmt != 2) { return 0 - 1; }
    var w = 3;                                          # first u16 + nLeft u8
    if (fmt == 2) { w = 4; }                            # first u16 + nLeft u16
    var gid = 1;
    while (gid < n) {
        if (p + w > end) { return 0 - 1; }
        var first = rekha_rd_u16(buf, p);
        var nleft = load8(buf + p + 2);
        if (fmt == 2) { nleft = rekha_rd_u16(buf, p + 2); }
        if (sid >= first && sid <= first + nleft) {
            var hit = gid + sid - first;
            if (hit >= n) { return 0 - 1; }
            return hit;
        }
        gid = gid + nleft + 1;
        p = p + w;
    }
    return 0 - 1;
}

# Draw glyph `g` into the running state, starting from (x0, y0) in 16.16. Everything a charstring
# owns is reset first — the stack, the current point, the stem count, the width flag and the open
# contour — while the POINT counters, the operator budget and the output pointers carry over, which
# is what makes this a composition rather than a second glyph.
fn rekha_cff_seac_part(font, s, g, x0, y0): i64 {
    store64(s + RC_SP, 0);
    store64(s + RC_X, x0);
    store64(s + RC_Y, y0);
    store64(s + RC_STEMS, 0);
    store64(s + RC_WDONE, 0);
    store64(s + RC_OPEN, 0);
    store64(s + RC_SEAC, 0);
    var buf = load64(s + RC_BUF);
    var end = load64(s + RC_END);
    var o: i64[2];
    if (rekha_cff_obj(buf, load64(font + 176), end, g, &o) == 0) { return 0; }
    var r = rekha_cff_exec(s, load64(&o), load64(&o) + load64(&o + 8), 0);
    if (load64(s + RC_BAD) != 0) { return 0; }
    if (r != 1) { return 0; }
    # ⛔ A component that is ITSELF a seac is refused rather than followed. One level is what the
    # operator means, and nesting it is how a font turns two glyph loads into a tree.
    if (load64(s + RC_SEAC) != 0) { return 0; }
    return 1;
}

# Compose the seac the charstring for `gid` parked. 1 on success, 0 to leave the glyph EMPTY.
fn rekha_cff_seac(font, s, gid): i64 {
    # ⛔ A CID-keyed font has no Standard Encoding and no seac: its charset maps glyph ids to CIDs,
    # not to the SIDs this resolves through, so the lookup would be nonsense rather than a miss.
    if (load64(font + 200) != 0) { return 0; }
    var bgid = rekha_cff_sid_to_gid(font, rekha_cff_stdenc(load64(s + RC_BCH)));
    var agid = rekha_cff_sid_to_gid(font, rekha_cff_stdenc(load64(s + RC_ACH)));
    if (bgid <= 0 || agid <= 0) { return 0; }
    # ⛔ Not even one level of self-reference: a base that is this glyph would re-enter the same
    # charstring and park the same request again.
    if (bgid == gid || agid == gid) { return 0; }
    if (rekha_cff_seac_part(font, s, bgid, 0, 0) == 0) { return 0; }
    return rekha_cff_seac_part(font, s, agid, load64(s + RC_ADX), load64(s + RC_ADY));
}

fn rekha_cff_run(font, gid, s, stk, fill): i64 {
    var buf = load64(font);
    var end = load64(font + 224);
    var k = 0;
    while (k < RC_SLOTS) {
        if (k * 8 < RC_XS || k * 8 > RC_EPS || fill == 0) { store64(s + k * 8, 0); }
        k = k + 1;
    }
    store64(s + RC_BUF, buf);
    store64(s + RC_END, end);
    store64(s + RC_GS, load64(font + 184));
    store64(s + RC_LS, load64(font + 192));
    store64(s + RC_FILL, fill);
    store64(s + RC_STK, stk);
    var v2 = load64(font + 256);
    store64(s + RC_V2, v2);
    store64(s + RC_VST, load64(font + 264));
    store64(s + RC_VSOK, v2);
    if (load64(font + 200) != 0) {                  # CID-keyed, or ANY CFF2: FDArray[FDSelect(gid)]
        var fd = rekha_cff_fd(font, gid);           # -1 (no range) fails the object lookup below
        var fo: i64[2];
        var csz = 2;
        if (v2 != 0) { csz = 4; }
        if (rekha_cff_idx_obj(buf, load64(font + 200), end, fd, &fo, csz) == 0) { return 0; }
        var fa = load64(&fo);
        var fb = fa + load64(&fo + 8);
        store64(s + RC_LS, rekha_cff_priv_subrs_csz(buf, load64(font + 216), end, fa, fb, csz));
        # A CFF2 Private DICT may name the variation-store index every blend in its glyphs starts
        # from; without one that is 0. A charstring's own `vsindex` overrides it.
        if (v2 != 0) {
            var nr0 = rekha_cff2_priv_regions(buf, load64(font + 216), end, fa, fb, load64(font + 264));
            if (nr0 < 0) { return 0; }
            store64(s + RC_NREG, nr0);
        }
    }
    var o: i64[2];
    var ccsz = 2;
    if (v2 != 0) { ccsz = 4; }
    if (rekha_cff_idx_obj(buf, load64(font + 176), end, gid, &o, ccsz) == 0) { return 0; }
    var r = rekha_cff_exec(s, load64(&o), load64(&o) + load64(&o + 8), 0);
    if (load64(s + RC_BAD) != 0) { return 0; }
    if (load64(s + RC_V2) != 0) {
        # ⛔ A CFF2 charstring ENDS WHEN ITS BYTES DO — there is no terminator to look for, so the
        # success condition is the exact opposite of CFF's. `rekha_cff_exec` answers 0 both at the
        # end of the bytes and at a top-level `return`; either way the open contour is ours to close,
        # which `endchar` would have done in a CFF.
        if (r != 0) { return 0; }
        rekha_cff_close(s);
    } else {
        if (r != 1) { return 0; }                   # no endchar
        # A parked seac is composed HERE, outside the interpreter, and its two component charstrings
        # spend the same operator budget and the same point ceiling as everything above.
        if (load64(s + RC_SEAC) != 0) {
            if (rekha_cff_seac(font, s, gid) == 0) { return 0; }
        }
    }
    if (load64(s + RC_NP) > REKHA_COMPOSITE_MAXP) { return 0; }
    return 1;
}

# Decode glyph `gid` of a CFF font into a RekhaOutline. Empty for an out-of-range gid (the CharStrings
# lookup refuses it), a broken rule or a bound (see the head of this file); 0 only on OOM.
# ⚠ No load context: a CFF glyph has no components, so one decode is one load, and its points are
# already capped at REKHA_COMPOSITE_MAXP — below any budget a context would carry.
fn rekha_cff_load(font, gid): i64 {
    var s: i64[31];
    var stk: i64[48];
    if (rekha_cff_run(font, gid, &s, &stk, 0) == 0) { return rekha_outline_empty(); }
    var np = load64(&s + RC_NP);
    var nc = load64(&s + RC_NC);
    var cap = load64(&s + RC_NPMAX);
    if (nc == 0) { return rekha_outline_empty(); }
    var o = sd_alloc(REKHA_OUTLINE_SIZE + nc * 8 + cap * 17);
    if (o == 0) { return 0; }
    var eps = o + REKHA_OUTLINE_SIZE;
    var xs = eps + nc * 8;
    var ys = xs + cap * 8;
    var oc = ys + cap * 8;
    store64(&s + RC_XS, xs);
    store64(&s + RC_YS, ys);
    store64(&s + RC_OC, oc);
    store64(&s + RC_EPS, eps);
    if (rekha_cff_run(font, gid, &s, &stk, 1) == 0) { return rekha_outline_clear(o); }
    if (load64(&s + RC_NP) != np || load64(&s + RC_NC) != nc) { return rekha_outline_clear(o); }
    store64(o, nc);
    store64(o + 8, np);
    store64(o + 16, eps);
    store64(o + 24, xs);
    store64(o + 32, ys);
    store64(o + 40, oc);
    return o;
}
