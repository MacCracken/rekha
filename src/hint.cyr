# @internal — TrueType hinting, part two: the machine, the zones, and the control-value program
# (0.8.0, 0.8.1).
#
# hint.cyr — the bytecode interpreter a TrueType face carries its own hints in. `fpgm` holds the
# font's function library, `prep` the program run once per size, `cvt ` the control values both
# read, and every glyph may carry a program of its own. Together they are the last thing between
# rekha's outlines and a legible 9-pixel glyph, and the standing roadmap item since 0.4.x.
#
# ⛔ 0.8.1 IS THE WHOLE MACHINE AND STILL NOT A HINTED GLYPH. 0.8.0 built the interpreter and ran
# the font program; 0.8.1 adds the two zones, every instruction that reads or moves a point
# except IUP, and runs `prep` once per size inside `rekha_hint_ctx`. What is left — loading a
# glyph's outline into zone 1, its own program, IUP, composites, and the call that answers a
# hinted outline — is 0.8.2's, booked in docs/development/roadmap.md, and IUP is the one opcode
# still REFUSED with `REKHA_ERR_UNSUPPORTED` naming itself rather than skipped. Skipping one would
# leave the stack at a depth the next instruction is not written for, which is how a
# half-interpreter produces a plausible wrong glyph instead of a refusal.
# ⭐ THE REFERENCE IS FreeType 2.14.3's CLASSIC INTERPRETER (GETINFO version 35), non-pedantic,
# grayscale, square pixels — the library on the development host, and the one every oracle script
# under scripts/ links through ctypes. Every point instruction here agrees with it point for point
# on programs/hint_unit_vectors.cyr, whose expected values FreeType itself produced. THE
# DEPARTURES, each stated at its site and pinned in docs/development/roadmap.md:
#   · rekha REFUSES what FreeType silently tolerates — an index outside a zone, a control value
#     outside the table, a short stack — and every such site names its instruction;
#   · a point index at or above 65536 is refused where FreeType's 16-bit casts wrap it onto a real
#     point (rekha_hint_pt_ok), and a backward jump to before a function's own start is refused
#     where FreeType runs whatever bytes precede the body (rekha_hint_exec);
#   · before every `prep` the twilight zone's tags and font-unit positions are zeroed with its
#     positions, and its per-run bound has no +4 band above maxTwilightPoints
#     (rekha_hint_run_prep, rekha_hint_twilight_bound);
#   · a face whose `prep` is absent or empty starts each size from the defaults, where FreeType
#     hands it a stale graphics state (rekha_hint_run_prep);
#   · FreeType's LOOPCALL and backward-jump budgets and its call depth of 32 are not modelled:
#     rekha has one instruction budget and a call depth of 64 (rekha_hint_exec, rekha_hint_call).
# ⭐ AND THE FONT PROGRAM IS REACHABLE WITHOUT A GLYPH, because an `FDEF` body is SCANNED, not
# executed. Liberation Sans's real 1,972-byte `fpgm` reaches its top level with exactly THREE
# opcodes — NPUSHB, FDEF and the ENDF that closes each body — and rekha runs it and defines all 71
# of its functions. Its 835-byte `prep` then CALLs five of them 65 times at every size and
# reaches no point instruction at all, so the point group is measured on the unit programs and
# unmeasured on a face in the wild until 0.8.2 runs a glyph program.
#
# The three tables, and the one that says whether to bother:
#   cvt  — an array of i16 in FONT UNITS. Scaled to F26Dot6 at a ppem and then owned by the
#          interpreter: `prep` rewrites entries through WCVTP / WCVTF / DELTAC, so the scaled copy
#          is per-size state and never a view onto the font bytes.
#   fpgm — one program, run ONCE per face. Almost entirely FDEFs.
#   prep — the control-value program, run once per SIZE by rekha_hint_run_prep, after fpgm and
#          before any glyph, on a size whose control values, storage, twilight zone and graphics
#          state were just rebuilt for it.
#   gasp — not code: a ppem-ordered table saying at which sizes to grid-fit and at which to smooth.
#          The first question a consumer of hinting asks, and rekha answers it at 0.8.0.
#
# ⚠ ppem IS THE ONLY SIZE rekha HAS. The interpreter's x and y scales are equal, MPPEM answers the
# same number on both axes, and MPS answers the ppem too, as the classic interpreter does; rekha
# carries no dpi. A consumer with non-square pixels cannot express that here.
# ⛔ WHY THE ROUNDING DIVERGES FROM THE REST OF rekha, DELIBERATELY. Everywhere else rekha rounds
# HALF UP (`sd_asr(v + 32768, 16)`), which is fontTools' `otRound` and what every differential
# since 0.5.0 was measured against. This file rounds HALF AWAY FROM ZERO, because its reference is
# not fontTools but the interpreter a hinted glyph was drawn against — FreeType's `FT_MulFix` and
# `FT_DivFix` both take the absolute value, add a half, and re-sign. The two differ only when a
# NEGATIVE value lands exactly on .5, and a `cvt ` full of descender depths is exactly where that
# happens. One 1/64 pixel there moves a point, so the reference wins over the house convention.
#
# ⭐ THREE OPERAND ORDERS WERE SETTLED AGAINST REAL FONTS, because the published specs contradict
# each other on whether a "Pops:" list is written top-first or push-first:
#   LOOPCALL — the FUNCTION is on top, the count below. A `prep` in the host corpus pushes
#     `0 0 65 49 33 5 0` then LOOPCALL: as (f=0, count=5) that consumes the five values below and
#     leaves nothing, and as (count=0, f=5) it calls nothing and the seven pushes are dead.
#   DELTAC — after the pair count, each pair is (exception spec, then INDEX on top). A host `prep`
#     pushes `64 21` against a 37-entry `cvt `, and `63 18` against a 34-entry one; the other
#     reading indexes entry 64 of 37.
#   WCVTP / WS — the VALUE is on top and the location below, from `DUP RCVT RTG ROUND WCVTP` in
#     Liberation Sans's own fpgm, which can only mean "write the rounded value to the index under
#     it".
# ⚠ INSTCTRL's order (selector on top) is NOT observed: the one real site pushes `1 1`. It follows
# FreeType and is marked here rather than presented as measured.

# ================================================================
# Tables, caps and the rounding modes
# ================================================================
var REKHA_TAG_CVT  = 0x63767420;   # 'cvt '
var REKHA_TAG_FPGM = 0x6670676D;   # 'fpgm'
var REKHA_TAG_PREP = 0x70726570;   # 'prep'
var REKHA_TAG_GASP = 0x67617370;   # 'gasp'

# ⛔ EVERY CAP BELOW IS A REFUSAL, NOT A CLAMP. A font declaring more than one of these gets no
# interpreter at all and `rekha_hint_error` names which cap it tripped, because an interpreter
# running with a stack shorter than the font asked for silently computes a different glyph.
# The numbers are an order of magnitude above the host corpus: Liberation Sans declares a 676-slot
# stack, 47 storage locations, 92 functions, 0 instruction definitions and 324 control values.
var REKHA_HINT_MAXSTACK = 8192;
var REKHA_HINT_MAXSTORE = 8192;
var REKHA_HINT_MAXFDEF  = 4096;
var REKHA_HINT_MAXIDEF  = 256;
var REKHA_HINT_MAXCVT   = 16384;
# A CALL nest deeper than this, or a program longer than this many instructions, is refused. Both
# are halting guards: JMPR can jump backwards and LOOPCALL can be handed any count.
var REKHA_HINT_MAXDEPTH = 64;
var REKHA_HINT_BUDGET   = 1000000;
# ⚠ TrueType is specified on 32-bit signed integers. rekha computes in i64 and CLAMPS every
# arithmetic result to that range instead of wrapping: a wrap is never what a font meant, and the
# clamp is what keeps the products in rekha_hint_muldiv inside i64.
var REKHA_HINT_CLAMP = 2147483647;

var REKHA_RND_GRID    = 0;   # RTG  — to the nearest pixel
var REKHA_RND_HALF    = 1;   # RTHG — to the nearest half pixel
var REKHA_RND_DOUBLE  = 2;   # RTDG — to the nearest half pixel, on a half-pixel grid
var REKHA_RND_DOWN    = 3;   # RDTG
var REKHA_RND_UP      = 4;   # RUTG
var REKHA_RND_OFF     = 5;   # ROFF — no rounding at all
var REKHA_RND_SUPER   = 6;   # SROUND
var REKHA_RND_SUPER45 = 7;   # S45ROUND

# The two grid periods SROUND and S45ROUND decompose, in 1/16384 pixel so the 45-degree one keeps
# its precision: 0x4000 is 1.0 pixel and 0x2D41 / 16384 = 0.70709, which is sqrt(2)/2. Both are
# brought down to F26Dot6 (0x4000 -> 64, 0x2D41 -> 45) once period, phase and threshold are fixed.
var REKHA_HINT_GRID   = 0x4000;
var REKHA_HINT_GRID45 = 0x2D41;

# ================================================================
# RekhaHintCtx — the execution context. ONE sd_alloc, header then arrays inline, so its cost is a
# number a test can assert: REKHA_HINT_HDR + stack * 8 + storage * 8 + fdefs * 32 + idefs * 32 +
# cvt * 8 + twilight * 48 + glyph points * 48 + contours * 8 + the two zones' tag bytes rounded up
# to 8, with stack = maxStackElements + max(maxStackElements / 2, 128), fdefs = max(64,
# maxFunctionDefs) and glyph points = the larger maxp point count + 4 (32,888 for Liberation Sans,
# 7,040 for hint_test's synthetic face).
# ⚠ It is built LAZILY and cached on the font at +808, the same shape GPOS's lookup list uses, so
# `rekha_font_open` still costs exactly REKHA_FONT_SIZE and a consumer that never hints never pays.
# ⛔ ONE CONTEXT PER FONT HANDLE, and changing ppem REBUILDS the per-size state in place rather
# than allocating again — `sd_alloc` has no free, and a text run that walks sizes would otherwise
# leak one context per size. The same "one handle, one thread" obligation 0.7.0 wrote down applies.
# ================================================================
var HC_FONT     = 0;     # the RekhaFont this belongs to
var HC_BUF      = 8;     # its byte buffer, cached
var HC_PPEM     = 16;    # the size this context is scaled for; 0 = not scaled yet
var HC_SCALE    = 24;    # 16.16 multiplier taking FONT UNITS to F26Dot6
var HC_ERR      = 32;    # REKHA_OK, or why the last run refused
var HC_DETAIL   = 40;    # a static cstring naming where; never allocated, never owned
var HC_SP       = 48;    # stack depth
var HC_STACK    = 56;
var HC_STKCAP   = 64;
var HC_STORE    = 72;
var HC_STORECAP = 80;
var HC_FDEF     = 88;    # 4 i64 per function: ITS NUMBER, body start, body end, AND THE BUFFER
# THEY ARE IN — a function is a range into the bytes of the program that defined it, and `fpgm`
# is not the only program there is. ⭐ THE TABLE IS A LIST OF RECORDS, NOT AN ARRAY INDEXED BY
# NUMBER: FreeType keeps (opc, start, end, range) records, caps how many DISTINCT functions a font
# may define at maxFunctionDefs, and lets the numbers themselves run to 0xFFFF
# (ref2143/ttinterp.c:3266-3323 Ins_FDEF; :3395-3465 Ins_CALL looks a number up). A font whose
# maxp says 3 and whose fpgm defines 0, 1 and 100 is within its declaration. HC_FDEFN counts them.
var HC_FDEFCAP  = 96;
var HC_IDEF     = 104;   # 4 i64 per definition: opcode, body start, body end, buffer
var HC_IDEFCAP  = 112;
var HC_IDEFN    = 120;
var HC_CVT      = 128;   # the SCALED control values, in F26Dot6. Owned, rewritable, per size
var HC_CVTCAP   = 136;
var HC_BUDGET   = 144;   # instructions left in the current run
var HC_DEPTH    = 152;   # current CALL nesting
var HC_FPGMOK   = 160;   # 1 once the font program has run for this face
var HC_BYTES    = 168;   # the allocation's own size, so programs/hint_test.cyr can pin it
# ---- the graphics state ----
# ⚠ The vectors are F2Dot14 (16384 = 1.0), the distances F26Dot6 (64 = one pixel), and the zone,
# reference-point and loop fields plain integers. The setters live in rekha_hint_op_gs and the
# readers in the point group below it: zp0..zp2 are validated where they are set and trusted
# where they are used.
var HC_PVX = 176;  var HC_PVY = 184;     # projection vector
var HC_FVX = 192;  var HC_FVY = 200;     # freedom vector
var HC_DVX = 208;  var HC_DVY = 216;     # dual projection vector
var HC_RP0 = 224;  var HC_RP1 = 232;  var HC_RP2 = 240;
var HC_ZP0 = 248;  var HC_ZP1 = 256;  var HC_ZP2 = 264;
var HC_LOOP     = 272;
var HC_RSTATE   = 280;
var HC_PERIOD   = 288;  var HC_PHASE = 296;  var HC_THRESH = 304;
var HC_MINDIST  = 312;
var HC_CVTCUT   = 320;
var HC_SWCUT    = 328;  var HC_SWVAL = 336;
var HC_AUTOFLIP = 344;
var HC_DBASE    = 352;  var HC_DSHIFT = 360;
var HC_INSTCTL  = 368;
var HC_SCANCTL  = 376;  var HC_SCANTYPE = 384;
# ---- the two zones (0.8.1) ----
# ⛔ THERE ARE EXACTLY TWO AND THE SPEC NAMES THEM: zone 0 is the TWILIGHT zone, `maxTwilightPoints`
# scratch points that belong to no contour and start at the origin, and zone 1 is the GLYPH zone,
# the outline being hinted plus its four phantom points. `zp0` / `zp1` / `zp2` choose which one
# each operand of a point instruction is read through, which is why the two are laid out
# identically and reached by index rather than by name.
var HC_ZONE0 = 392;     # the twilight zone descriptor, ZN_SIZE bytes
var HC_ZONE1 = 472;     # the glyph zone descriptor
var HC_GZCAP  = 552;    # points the glyph zone can hold, phantom points included
var HC_GZCCAP = 560;    # contours it can hold
var HC_GZGID  = 568;    # the gid currently loaded into it, or -1
# ---- the standing refusals, the code range, and the move vector ----
# ⛔ A REFUSED FONT PROGRAM OR CONTROL-VALUE PROGRAM IS A PROPERTY OF THE FACE OR THE SIZE, not of
# the last run: FreeType keeps `bytecode_ready` / `cvt_ready` per size and fails every later load
# with the same error (ref2143/ttgload.c:2211-2212, 2257-2258). These four slots are what lets
# `rekha_hint_ctx` re-raise the same code and detail on every call for that size.
var HC_FPGMERR = 576;   # why `fpgm` refused, or REKHA_OK
var HC_FPGMDET = 584;
var HC_PREPERR = 592;   # why `prep` refused at this size, or REKHA_OK
var HC_PREPDET = 600;
# Which program is running: 0 none, 1 `fpgm`, 2 `prep`, 3 a program handed to rekha_hint_run.
# INSTCTRL binds only inside `prep` and GETINFO's grayscale bit is off inside `fpgm`
# (ref2143/ttinterp.c:4714-4718, ttgload.c:2248-2255), so two instructions have to know.
var HC_RANGE   = 608;
# ⭐ THE MOVE VECTOR, 16.16, recomputed whenever the projection or freedom vector changes. It is
# freedom / (freedom . projection) with three regimes (ref2143/ttinterp.c:2238-2262) and a
# selection saying whether the move is a plain add along x or y (HC_MVSEL 1 / 2) or the general
# per-axis multiply (0). See rekha_hint_movevec.
var HC_MVX     = 616;   var HC_MVY = 624;
var HC_MVSEL   = 632;
# How many function records HC_FDEF holds (0.8.1: the table stopped being indexed by number).
var HC_FDEFN   = 640;
var REKHA_HINT_HDR = 648;

# A zone descriptor. ⭐ THREE POSITIONS PER POINT, NOT ONE, and the distinction is load-bearing:
#   orus — the ORIGINAL position in FONT UNITS. `IP` and the dual projection measure here, because
#          measuring a proportion in already-rounded pixels compounds the rounding into the answer.
#   org  — the original position SCALED to F26Dot6, before any move. `MD[1]`, `GC[1]` and every
#          "distance in the original outline" read this.
#   cur  — where the point is now. This is what comes out.
# Plus one byte of tags per point: on-curve, and touched in x / in y, which is what IUP interpolates
# between and what `UTP` clears.
var ZN_N     = 0;       # points in this zone
var ZN_NC    = 8;       # contours (the twilight zone has none)
var ZN_ORUSX = 16;  var ZN_ORUSY = 24;
var ZN_ORGX  = 32;  var ZN_ORGY  = 40;
var ZN_CURX  = 48;  var ZN_CURY  = 56;
var ZN_TAGS  = 64;
var ZN_CTRS  = 72;
var ZN_SIZE  = 80;

var REKHA_TAG_ONCURVE = 1;
var REKHA_TAG_TOUCHX  = 2;
var REKHA_TAG_TOUCHY  = 4;

# The fields of one point, for rekha_hint_point. ⚠ The first six ARE the zone descriptor's array
# order from ZN_ORUSX, so an index is an offset there too; the tag byte is the seventh.
var REKHA_PT_ORUSX = 0;  var REKHA_PT_ORUSY = 1;    # original position, FONT UNITS (twilight: 0)
var REKHA_PT_ORGX  = 2;  var REKHA_PT_ORGY  = 3;    # original position scaled to F26Dot6
var REKHA_PT_CURX  = 4;  var REKHA_PT_CURY  = 5;    # where the point is now, F26Dot6
var REKHA_PT_TAGS  = 6;                              # REKHA_TAG_ONCURVE | TOUCHX | TOUCHY
var REKHA_PT_COUNT = 7;

# ⛔ THE GLYPH ZONE IS SIZED BY THE FONT'S OWN `maxp`, NOT BY rekha's outline cap. Sizing it at
# REKHA_COMPOSITE_MAXP would cost 197 KB per context for a font whose largest glyph has 338 points.
# A glyph that turns out not to fit is REFUSED and says so, because a font whose maxp understates
# its own glyphs has contradicted itself.
var REKHA_HINT_MAXZONE = 4096;

# ================================================================
# Table resolution — called once by rekha_font_open, like every other module's _resolve.
# ⚠ A MISSING TABLE IS NOT A FAILED OPEN, as everywhere else in rekha: it is cached as absent and
# rekha_hint_present says so.
# ================================================================
fn rekha_hint_resolve(f): i64 {
    store64(f + 688, 0);   store64(f + 696, 0);
    store64(f + 704, 0);   store64(f + 712, 0);
    store64(f + 720, 0);   store64(f + 728, 0);
    store64(f + 736, 0);   store64(f + 744, 0);
    store64(f + 752, 0);
    store64(f + 760, 0);   store64(f + 768, 0);   store64(f + 776, 0);
    store64(f + 784, 0);   store64(f + 792, 0);   store64(f + 800, 0);
    store64(f + 808, 0);
    store64(f + 816, 0);   store64(f + 824, 0);
    var buf = load64(f);
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_CVT, &c);
    if (t != 0) { store64(f + 688, t); store64(f + 696, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_FPGM, &c);
    if (t != 0) { store64(f + 704, t); store64(f + 712, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_PREP, &c);
    if (t != 0) { store64(f + 720, t); store64(f + 728, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_GASP, &c);
    if (t != 0) {
        if (load64(&c) >= 4) { store64(f + 736, t); store64(f + 744, t + load64(&c)); }
    }
    # ⛔ maxp VERSION 1.0 IS WHAT MAKES THE INTERPRETER SIZEABLE. Version 0.5 is the CFF form and
    # carries numGlyphs alone: no stack depth, no function count, no storage. A TrueType face with
    # bytecode and a 0.5 maxp is malformed, and rekha answers "no hinting" rather than guessing
    # limits, because every guess is either a refusal the font did not earn or a buffer too small.
    var mx = rekha_find_table_len(f, REKHA_TAG_MAXP, &c);
    if (mx == 0) { return 0; }
    if (load64(&c) < 32) { return 0; }
    if (rekha_rd_u32(buf, mx) != 0x00010000) { return 0; }
    store64(f + 752, 1);
    store64(f + 760, rekha_rd_u16(buf, mx + 18));   # maxStorage
    store64(f + 768, rekha_rd_u16(buf, mx + 20));   # maxFunctionDefs
    store64(f + 776, rekha_rd_u16(buf, mx + 22));   # maxInstructionDefs
    store64(f + 784, rekha_rd_u16(buf, mx + 24));   # maxStackElements
    store64(f + 792, rekha_rd_u16(buf, mx + 26));   # maxSizeOfInstructions
    store64(f + 800, rekha_rd_u16(buf, mx + 16));   # maxTwilightPoints
    # ⚠ The glyph zone has to hold whichever is bigger. A font whose composites are larger than any
    # of its simple glyphs — which is most fonts with accents — declares that in the second pair.
    var mp = rekha_rd_u16(buf, mx + 6);             # maxPoints
    var mcp = rekha_rd_u16(buf, mx + 10);           # maxCompositePoints
    if (mcp > mp) { mp = mcp; }
    var mc = rekha_rd_u16(buf, mx + 8);             # maxContours
    var mcc = rekha_rd_u16(buf, mx + 12);           # maxCompositeContours
    if (mcc > mc) { mc = mcc; }
    store64(f + 816, mp);
    store64(f + 824, mc);
    return 0;
}

# @public — the point and contour capacity the interpreter's glyph zone is built at, taken from
# `maxp` and NOT from rekha's own outline cap. 0 when the table is not version 1.0.
fn rekha_max_zone_points(font): i64   { if (font == 0) { return 0; } return load64(font + 816); }
fn rekha_max_zone_contours(font): i64 { if (font == 0) { return 0; } return load64(font + 824); }

# @public — 1 when this face carries TrueType bytecode rekha could run: a version 1.0 `maxp`, and
# at least one of `fpgm` / `prep` / a glyph program. ⚠ It does NOT mean a glyph will be hinted:
# 0.8.1 runs the font program and each size's control-value program, and a glyph outline through
# its own program is 0.8.2's. `rekha_hint_error` on the context says how far a size got.
fn rekha_hint_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 752) == 0) { return 0; }
    if (load64(font + 712) > 0) { return 1; }
    if (load64(font + 728) > 0) { return 1; }
    if (load64(font + 696) > 0) { return 1; }
    return 0;
}

# @public — the six `maxp` version 1.0 limits the interpreter is sized by. 0 when the table is
# version 0.5, absent or short, which is also a legal answer for a font that declares 0.
fn rekha_max_storage(font): i64          { if (font == 0) { return 0; } return load64(font + 760); }
fn rekha_max_function_defs(font): i64    { if (font == 0) { return 0; } return load64(font + 768); }
fn rekha_max_instruction_defs(font): i64 { if (font == 0) { return 0; } return load64(font + 776); }
fn rekha_max_stack_elements(font): i64   { if (font == 0) { return 0; } return load64(font + 784); }
fn rekha_max_instruction_size(font): i64 { if (font == 0) { return 0; } return load64(font + 792); }
fn rekha_max_twilight_points(font): i64  { if (font == 0) { return 0; } return load64(font + 800); }

# @public — the byte length of the font program and the control-value program. 0 = absent.
fn rekha_fpgm_length(font): i64 { if (font == 0) { return 0; } return load64(font + 712); }
fn rekha_prep_length(font): i64 { if (font == 0) { return 0; } return load64(font + 728); }

# @public — how many entries the `cvt ` table holds, and entry `i` in FONT UNITS, unscaled and
# unhinted. ⚠ This reads the FONT; `rekha_hint_cvt_px` reads the interpreter's own copy, which
# `prep` is entitled to have rewritten. They answer different questions at the same index.
fn rekha_cvt_count(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 696) / 2;
}

fn rekha_cvt_value(font, i): i64 {
    if (font == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= rekha_cvt_count(font)) { return 0; }
    return rekha_rd_i16(load64(font), load64(font + 688) + i * 2);
}

# ================================================================
# gasp — not bytecode: the table that says at which sizes to grid-fit at all.
#   +0 version u16 (0 or 1) · +2 numRanges u16 · then numRanges x (rangeMaxPPEM u16, behavior u16),
#   SORTED by rangeMaxPPEM, the last one 0xFFFF.
# Version 0 defines the low two behavior bits; version 1 adds the symmetric pair, which describe
# ClearType and are reported unchanged rather than folded into the other two.
# ================================================================
var REKHA_GASP_GRIDFIT           = 1;
var REKHA_GASP_DOGRAY            = 2;
var REKHA_GASP_SYMMETRIC_GRIDFIT = 4;
var REKHA_GASP_SYMMETRIC_SMOOTH  = 8;

# @public — 1 when the face carries a `gasp` rekha can read.
fn rekha_gasp_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 736) == 0) { return 0; }
    return 1;
}

# @public — the behavior flags for `ppem`: the first range whose rangeMaxPPEM is at least ppem.
# -1 when there is no `gasp`, which is NOT 0: 0 is a real answer meaning "neither grid-fit nor
# smooth at this size", and a font without the table has said nothing at all.
# ⚠ A font with no `gasp` is conventionally grid-fit at every size; rekha reports the absence and
# leaves that convention to `rekha_should_gridfit`, so the two questions stay separable.
fn rekha_gasp_behavior(font, ppem): i64 {
    if (rekha_gasp_present(font) == 0) { return 0 - 1; }
    var buf = load64(font);
    var t = load64(font + 736);
    var end = load64(font + 744);
    var n = rekha_rd_u16(buf, t + 2);
    if (t + 4 + n * 4 > end) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        var r = t + 4 + i * 4;
        if (rekha_rd_u16(buf, r) >= ppem) { return rekha_rd_u16(buf, r + 2); }
        i = i + 1;
    }
    return 0;
}

# @public — 1 when this size should be grid-fit, 0 when it should not. ⚠ A face with no `gasp`
# answers 1: that is the long-standing convention and it is stated here rather than left implicit.
fn rekha_should_gridfit(font, ppem): i64 {
    var b = rekha_gasp_behavior(font, ppem);
    if (b < 0) { return 1; }
    if ((b & REKHA_GASP_GRIDFIT) != 0) { return 1; }
    return 0;
}

# ================================================================
# Fixed point — F26Dot6 for distances, 16.16 for the scale, F2Dot14 for the vectors.
# ⛔ ROUNDED HALF AWAY FROM ZERO, not half up. See the header: the reference here is FreeType's
# interpreter, not fontTools, and a `cvt ` of descender depths is where the two disagree.
# ================================================================

# 16.16 x value -> value, i.e. FT_MulFix.
fn rekha_hint_mulfix(a, b): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    var c = sd_asr(a * b + 32768, 16);
    if (s < 0) { return 0 - c; }
    return c;
}

# a / b as 16.16, i.e. FT_DivFix. b == 0 answers 0 rather than trapping; the caller has already
# refused a font with unitsPerEm 0 long before this.
fn rekha_hint_divfix(a, b): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    if (b == 0) { return 0; }
    var c = (a * 65536 + b / 2) / b;
    if (s < 0) { return 0 - c; }
    return c;
}

# round(a * b / c), half away from zero — FT_MulDiv, which MUL and DIV are defined in terms of.
fn rekha_hint_muldiv(a, b, c): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    if (c < 0) { c = 0 - c; s = 0 - s; }
    if (c == 0) { return 0; }
    var v = (a * b + c / 2) / c;
    if (s < 0) { return 0 - v; }
    return v;
}

# The largest multiple of `p` at or below `v`. ⛔ NOT `v / p * p`: Cyrius divides toward zero, so
# that rounds a negative value UP and turns a round-down into a round-up on exactly the half of
# the number line a descender lives on. This is the `& -p` of a power-of-two grid, generalised to
# the 45-degree period, which is 45 and not a power of two.
fn rekha_hint_floor_mul(v, p): i64 {
    if (p <= 0) { return v; }
    var q = v / p;
    if (v < 0) {
        if (q * p != v) { q = q - 1; }
    }
    return q * p;
}

# Keep a value inside the 32-bit signed range TrueType is specified on.
fn rekha_hint_clamp(v): i64 {
    if (v > REKHA_HINT_CLAMP) { return REKHA_HINT_CLAMP; }
    if (v < (0 - REKHA_HINT_CLAMP) - 1) { return (0 - REKHA_HINT_CLAMP) - 1; }
    return v;
}

# ================================================================
# Refusal reporting — the 0.7.0 shape, on the context rather than the font handle, because a
# context outlives one call and a program's refusal is the answer to "why is this size unhinted".
# ================================================================

# @public — why the last run on this context refused, as a RekhaErrCode. REKHA_OK when it did not.
# ⛔ IT IS NOT A SUCCESS TEST: `rekha_hint_run` already returns 1 or 0. This says WHICH refusal.
fn rekha_hint_error(ctx): i64 {
    if (ctx == 0) { return REKHA_OK; }
    return load64(ctx + HC_ERR);
}

# @public — a short STATIC cstring naming the instruction or invariant, never allocated and never
# owned by the caller. 0 when there is nothing to name.
fn rekha_hint_error_detail(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + HC_DETAIL);
}

# @public — clear it. Every run clears first, so a code describes the LAST run.
fn rekha_hint_error_clear(ctx): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + HC_ERR, REKHA_OK);
    store64(ctx + HC_DETAIL, 0);
    return 0;
}

# Record a refusal and answer 0, so a caller can `return rekha_hint_fail(...)`.
fn rekha_hint_fail(ctx, code, detail): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + HC_ERR, code);
    store64(ctx + HC_DETAIL, detail);
    return 0;
}

# ================================================================
# The stack. ⚠ Bounded by the font's OWN maxStackElements, not by a rekha constant: a font that
# declares 676 gets 676, and overflowing it is the font contradicting itself.
# ================================================================

# @public — how deep the stack is, and the value `i` from the BOTTOM. Both for a consumer reading
# out what a program computed, and for programs/hint_test.cyr.
fn rekha_hint_depth(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + HC_SP);
}

fn rekha_hint_at(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_SP)) { return 0; }
    return load64(load64(ctx + HC_STACK) + i * 8);
}

# @public — push a value. 1 on success, 0 when the stack is full (and the refusal is recorded).
fn rekha_hint_push(ctx, v): i64 {
    if (ctx == 0) { return 0; }
    var sp = load64(ctx + HC_SP);
    if (sp >= load64(ctx + HC_STKCAP)) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "stack overflow");
    }
    store64(load64(ctx + HC_STACK) + sp * 8, rekha_hint_clamp(v));
    store64(ctx + HC_SP, sp + 1);
    return 1;
}

# 1 when at least `n` values are on the stack; otherwise records the underflow and answers 0.
fn rekha_hint_need(ctx, n): i64 {
    if (load64(ctx + HC_SP) >= n) { return 1; }
    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "stack underflow");
}

# @public — pop. ⚠ Answers 0 on an EMPTY stack, which is also a legal value; call rekha_hint_need
# first, as every instruction here does.
fn rekha_hint_pop(ctx): i64 {
    if (ctx == 0) { return 0; }
    var sp = load64(ctx + HC_SP);
    if (sp <= 0) { return 0; }
    store64(ctx + HC_SP, sp - 1);
    return load64(load64(ctx + HC_STACK) + (sp - 1) * 8);
}

# ================================================================
# The rounding engine. Six fixed modes plus the two the font composes itself.
# ⚠ THE FOUR ENGINE COMPENSATIONS ARE ZERO, as FreeType's are. They modelled the pixel spread of a
# CRT and the distance-type bits in ROUND[ab] / NROUND[ab] select between them; with all four zero
# the bits are read, validated and then make no difference, and NROUND becomes the identity. That
# is stated rather than left as an accident of the table being empty.
# ================================================================

# Decompose an SROUND / S45ROUND selector byte into period, phase and threshold. `grid` is in
# 1/16384 pixel (see REKHA_HINT_GRID); all three come out in F26Dot6.
fn rekha_hint_set_super(ctx, grid, sel): i64 {
    var period = grid;
    var b = sel & 0xC0;
    if (b == 0x00)    { period = grid / 2; }
    if (b == 0x80)    { period = grid * 2; }
    var phase = 0;
    var ph = sel & 0x30;
    if (ph == 0x10) { phase = period / 4; }
    if (ph == 0x20) { phase = period / 2; }
    if (ph == 0x30) { phase = period * 3 / 4; }
    # ⚠ The default threshold is `period - 1` IN 1/16384 PIXEL, before the shift down to F26Dot6
    # (ref2143/ttinterp.c:2093-2098). It makes no difference on the pixel grids, where the period
    # is a multiple of 256, and one 1/64 on the 45-degree grid: 0x2D41 - 1 >> 8 is 45, and
    # 0x2D41 - 256 >> 8 was 44 — 0.8.0's slip, found by reading FreeType.
    var th = sel & 0x0F;
    var thresh = period - 1;
    if (th != 0) { thresh = (th - 4) * period / 8; }
    store64(ctx + HC_PERIOD, sd_asr(period, 8));
    store64(ctx + HC_PHASE,  sd_asr(phase, 8));
    store64(ctx + HC_THRESH, sd_asr(thresh, 8));
    return 0;
}

# @public — put `d` (an F26Dot6 distance) through the current rounding state. Exposed because it
# is the one piece of the graphics state whose effect a consumer can see without a glyph, and
# because every mode below has a spec-stated answer a test can pin.
fn rekha_hint_round(ctx, d): i64 {
    if (ctx == 0) { return d; }
    var st = load64(ctx + HC_RSTATE);
    if (st == REKHA_RND_OFF) { return d; }
    if (st == REKHA_RND_SUPER)   { return rekha_hint_round_super(ctx, d); }
    if (st == REKHA_RND_SUPER45) { return rekha_hint_round_super(ctx, d); }
    # The five fixed grids, each written as "fold to a non-negative distance, round, put the sign
    # back, and never let a rounding carry a distance across zero".
    var neg = 0;
    var v = d;
    if (v < 0) { neg = 1; v = 0 - v; }
    if (st == REKHA_RND_GRID)   { v = rekha_hint_floor_mul(v + 32, 64); }
    if (st == REKHA_RND_HALF)   { v = rekha_hint_floor_mul(v, 64) + 32; }
    if (st == REKHA_RND_DOUBLE) { v = rekha_hint_floor_mul(v + 16, 32); }
    if (st == REKHA_RND_DOWN)   { v = rekha_hint_floor_mul(v, 64); }
    if (st == REKHA_RND_UP)     { v = rekha_hint_floor_mul(v + 63, 64); }
    if (v < 0) { v = 0; }
    if (neg == 1) { return 0 - v; }
    return v;
}

# SROUND / S45ROUND: a period, a phase and a threshold the font chose.
fn rekha_hint_round_super(ctx, d): i64 {
    var period = load64(ctx + HC_PERIOD);
    var phase = load64(ctx + HC_PHASE);
    var thresh = load64(ctx + HC_THRESH);
    if (period <= 0) { return d; }
    if (d >= 0) {
        var v = rekha_hint_floor_mul(d - phase + thresh, period) + phase;
        if (v < 0) { v = phase; }
        return v;
    }
    var w = 0 - rekha_hint_floor_mul(thresh - phase - d, period);
    w = w - phase;
    if (w > 0) { w = 0 - phase; }
    return w;
}

# ================================================================
# The context: build it once, re-scale it per size.
# ================================================================

# Put the graphics state back to the values the spec calls default, and empty the stack. Called
# before the font program, before and after each size's control-value program (see
# rekha_hint_run_prep), never between two instructions.
fn rekha_hint_reset(ctx): i64 {
    store64(ctx + HC_SP, 0);
    store64(ctx + HC_PVX, 16384);   store64(ctx + HC_PVY, 0);
    store64(ctx + HC_FVX, 16384);   store64(ctx + HC_FVY, 0);
    store64(ctx + HC_DVX, 16384);   store64(ctx + HC_DVY, 0);
    store64(ctx + HC_RP0, 0);   store64(ctx + HC_RP1, 0);   store64(ctx + HC_RP2, 0);
    store64(ctx + HC_ZP0, 1);   store64(ctx + HC_ZP1, 1);   store64(ctx + HC_ZP2, 1);
    store64(ctx + HC_LOOP, 1);
    store64(ctx + HC_RSTATE, REKHA_RND_GRID);
    store64(ctx + HC_PERIOD, 64);   store64(ctx + HC_PHASE, 0);   store64(ctx + HC_THRESH, 32);
    store64(ctx + HC_MINDIST, 64);          # one pixel
    store64(ctx + HC_CVTCUT, 68);           # 17/16 of a pixel, the spec's own default
    store64(ctx + HC_SWCUT, 0);   store64(ctx + HC_SWVAL, 0);
    store64(ctx + HC_AUTOFLIP, 1);
    store64(ctx + HC_DBASE, 9);   store64(ctx + HC_DSHIFT, 3);
    store64(ctx + HC_INSTCTL, 0);
    store64(ctx + HC_SCANCTL, 0);   store64(ctx + HC_SCANTYPE, 0);
    rekha_hint_movevec(ctx);
    return 0;
}

# Re-scale the control values from the font bytes at the context's ppem. ⛔ FROM THE FONT, not from
# the previous size's copy: `prep` rewrites entries, and re-scaling a rewritten value would
# compound one size's exceptions into the next.
fn rekha_hint_scale_cvt(ctx): i64 {
    var font = load64(ctx + HC_FONT);
    var buf = load64(ctx + HC_BUF);
    var at = load64(font + 688);
    var n = load64(ctx + HC_CVTCAP);
    var dst = load64(ctx + HC_CVT);
    var sc = load64(ctx + HC_SCALE);
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, rekha_hint_mulfix(rekha_rd_i16(buf, at + i * 2), sc));
        i = i + 1;
    }
    return 0;
}

# @public — the scaled control value at `i`, in F26Dot6, as the interpreter currently holds it —
# which, once `rekha_hint_ctx` has answered, is AFTER this size's `prep` rewrote it: Liberation
# Sans's rewrites 22 to 59 of its 324 entries depending on the size. ⚠ Not `rekha_cvt_value`,
# which reads the font; the fresh scale is `rekha_hint_mulfix(rekha_cvt_value(font, i), scale)`.
fn rekha_hint_cvt_px(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_CVTCAP)) { return 0; }
    return load64(load64(ctx + HC_CVT) + i * 8);
}

# @public — the storage area at `i`. 0 outside it, which is also a legal stored value. Cleared
# before every `prep` run, so it holds what this size's `prep` wrote and nothing older.
fn rekha_hint_storage(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_STORECAP)) { return 0; }
    return load64(load64(ctx + HC_STORE) + i * 8);
}

# @public — the size this context is scaled for, the 16.16 font-unit-to-F26Dot6 multiplier, and
# the exact byte count of its single allocation.
fn rekha_hint_ppem(ctx): i64  { if (ctx == 0) { return 0; } return load64(ctx + HC_PPEM); }
fn rekha_hint_scale(ctx): i64 { if (ctx == 0) { return 0; } return load64(ctx + HC_SCALE); }
fn rekha_hint_bytes(ctx): i64 { if (ctx == 0) { return 0; } return load64(ctx + HC_BYTES); }

# The record of function `n` — [number, start, end, buffer] — or 0 when no program defined it.
# FreeType's lookup (ref2143/ttinterp.c:3404-3435): when every function so far is numbered by its
# position the record IS the n-th, else the table is searched.
fn rekha_hint_find_fdef(ctx, n): i64 {
    var cnt = load64(ctx + HC_FDEFN);
    var at = load64(ctx + HC_FDEF);
    if (n >= 0) {
        if (n < cnt) {
            if (load64(at + n * 32) == n) { return at + n * 32; }
        }
    }
    var i = 0;
    while (i < cnt) {
        if (load64(at + i * 32) == n) { return at + i * 32; }
        i = i + 1;
    }
    return 0;
}

# @public — how many functions the font program defined, and whether `n` is one of them. ⚠ The
# count is of DISTINCT numbers: a function redefined takes no second record, and the numbers need
# not be 0..count-1 — Liberation Sans's 71 functions run up to 91 with gaps.
fn rekha_hint_func_defined(ctx, n): i64 {
    if (ctx == 0) { return 0; }
    if (rekha_hint_find_fdef(ctx, n) == 0) { return 0; }
    return 1;
}

fn rekha_hint_func_count(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + HC_FDEFN);
}

# @public — the interpreter for `font` at `ppem`: built on first use, then the font program is run
# once, and on EVERY size change (the first included) the control-value program is run for that
# size through `rekha_hint_run_prep`. 0 when the face carries no bytecode, when ppem is not
# positive, when a declared `maxp` limit is over one of rekha's caps, or when the allocation
# failed — and in every one of those cases `rekha_font_error(font)` says which, because there is
# no context to ask.
# ⛔ THIS IS THE ONE PUBLIC CALL WHOSE NON-ZERO ANSWER DOES NOT MEAN SUCCESS. A refused `fpgm` or a
# refused `prep` is a property of the face or of the size, and the consumer needs the context to
# read it: the handle is still answered, `rekha_hint_error(ctx)` carries the standing refusal —
# the font program's first, else this size's control-value program's — on every call for that
# size, and `rekha_font_error(font)` mirrors it so the two agree. 0.8.2's glyph call is the one
# that answers 0.
# ⛔ THE CONTEXT IS CACHED ON THE FONT AND RE-SCALED, NEVER REALLOCATED. `sd_alloc` has no free, so
# a text run walking sizes would otherwise leak one interpreter per size. The function table and
# the instruction table are the one thing a size change keeps: a function is a range into font
# bytes and does not move with size. Everything else the size owns — the scaled control values,
# the storage area, the twilight zone, the graphics state, the glyph zone — is rebuilt by
# `rekha_hint_run_prep`, as FreeType rebuilds it before every `prep` (ref2143/ttobjs.c:951-975).
fn rekha_hint_ctx(font, ppem): i64 {
    if (font == 0) { return 0; }
    rekha_font_error_clear(font);
    if (rekha_hint_present(font) == 0) {
        return rekha_fail(font, REKHA_ERR_NO_TABLE, "hint tables");
    }
    if (ppem <= 0) { return rekha_fail(font, REKHA_ERR_OTHER, "ppem"); }
    var upem = load64(font + 40);
    if (upem <= 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "head"); }
    var ctx = load64(font + 808);
    if (ctx == 0) {
        ctx = rekha_hint_ctx_new(font);
        if (ctx == 0) { return 0; }
        store64(font + 808, ctx);
    }
    var changed = 0;
    if (load64(ctx + HC_PPEM) != ppem) {
        store64(ctx + HC_PPEM, ppem);
        store64(ctx + HC_SCALE, rekha_hint_divfix(ppem * 64, upem));
        changed = 1;
    }
    # ⚠ The font program runs AFTER the scale is set, at the first size asked for, so an MPPEM
    # inside it answers that size and not 0 — which is 2.14.3 (ref2143/ttobjs.c:891-909), and
    # harmless either way because `prep` then starts from a clean slate.
    if (load64(ctx + HC_FPGMOK) == 0) {
        rekha_hint_run_fpgm(ctx);
        changed = 1;
    }
    if (changed == 1) { rekha_hint_run_prep(ctx); }
    rekha_hint_error_clear(ctx);
    var code = load64(ctx + HC_FPGMERR);
    var det = load64(ctx + HC_FPGMDET);
    if (code == REKHA_OK) {
        code = load64(ctx + HC_PREPERR);
        det = load64(ctx + HC_PREPDET);
    }
    if (code != REKHA_OK) {
        rekha_hint_fail(ctx, code, det);
        rekha_fail(font, code, det);
    }
    return ctx;
}

# One sd_alloc: the header, then the stack, the storage area, the function table, the instruction
# table, the scaled control values, the two zones' coordinate arrays and last their tag bytes, all
# inline.
# ⚠ THE STACK GETS max(maxStackElements / 2, 128) SLOTS MORE THAN THE FONT DECLARED, which is
# FreeType's margin (ref2143/ttobjs.c:1078-1079) and is here for the same reason: a
# maxStackElements short of what the font's own program pushes is a common enough authoring slip
# that refusing it would refuse fonts FreeType hints.
fn rekha_hint_ctx_new(font): i64 {
    var ms = load64(font + 784);
    var margin = ms / 2;
    if (margin < 128) { margin = 128; }
    var stk = ms + margin;
    var sto = load64(font + 760);
    var fdn = load64(font + 768);
    var idn = load64(font + 776);
    var cvn = load64(font + 696) / 2;
    if (stk > REKHA_HINT_MAXSTACK) { return rekha_fail(font, REKHA_ERR_OOM, "stack cap"); }
    if (sto > REKHA_HINT_MAXSTORE) { return rekha_fail(font, REKHA_ERR_OOM, "storage cap"); }
    if (fdn > REKHA_HINT_MAXFDEF)  { return rekha_fail(font, REKHA_ERR_OOM, "function cap"); }
    if (idn > REKHA_HINT_MAXIDEF)  { return rekha_fail(font, REKHA_ERR_OOM, "instruction cap"); }
    if (cvn > REKHA_HINT_MAXCVT)   { return rekha_fail(font, REKHA_ERR_OOM, "cvt cap"); }
    # ⚠ THE FUNCTION TABLE HOLDS AT LEAST 64 RECORDS whatever maxFunctionDefs says: FreeType's
    # `maxp` reader floors the declared count at 64 for old fonts that under-declare it (its sfnt
    # loader, tt_face_load_maxp, not in the interpreter sources; the interpreter takes the floored
    # value at ref2143/ttobjs.c:1050), and the host's libfreetype 2.14.3 was measured: under a
    # declared 1, 64 distinct definitions load and a 65th fails, numbered densely or sparsely.
    # The cap above is on the DECLARED count, so the floor never exceeds it.
    if (fdn < 64) { fdn = 64; }
    var tz = load64(font + 800);                    # twilight points
    var gz = load64(font + 816) + 4;                # glyph points, plus the four phantom
    var gc = load64(font + 824);
    if (tz > REKHA_HINT_MAXZONE) { return rekha_fail(font, REKHA_ERR_OOM, "twilight cap"); }
    if (gz > REKHA_HINT_MAXZONE) { return rekha_fail(font, REKHA_ERR_OOM, "glyph zone cap"); }
    if (gc > REKHA_HINT_MAXZONE) { return rekha_fail(font, REKHA_ERR_OOM, "contour cap"); }
    # ⚠ The two tag arrays are BYTES and go last, so no i64 array starts on an odd address; the
    # total is rounded up to 8 for the same reason.
    var tagb = (tz + gz + 7) & (0 - 8);
    var bytes = REKHA_HINT_HDR + stk * 8 + sto * 8 + fdn * 32 + idn * 32 + cvn * 8
    + tz * 48 + gz * 48 + gc * 8 + tagb;
    var ctx = sd_alloc(bytes);
    if (ctx == 0) { return rekha_fail(font, REKHA_ERR_OOM, "hint context"); }
    var at = ctx + REKHA_HINT_HDR;
    store64(ctx + HC_FONT, font);
    store64(ctx + HC_BUF, load64(font));
    store64(ctx + HC_PPEM, 0);
    store64(ctx + HC_SCALE, 0);
    store64(ctx + HC_ERR, REKHA_OK);
    store64(ctx + HC_DETAIL, 0);
    store64(ctx + HC_SP, 0);
    store64(ctx + HC_STACK, at);      store64(ctx + HC_STKCAP, stk);     at = at + stk * 8;
    store64(ctx + HC_STORE, at);      store64(ctx + HC_STORECAP, sto);   at = at + sto * 8;
    store64(ctx + HC_FDEF, at);       store64(ctx + HC_FDEFCAP, fdn);    at = at + fdn * 32;
    store64(ctx + HC_FDEFN, 0);
    store64(ctx + HC_IDEF, at);       store64(ctx + HC_IDEFCAP, idn);    at = at + idn * 32;
    store64(ctx + HC_IDEFN, 0);
    store64(ctx + HC_CVT, at);        store64(ctx + HC_CVTCAP, cvn);    at = at + cvn * 8;
    at = rekha_hint_zone_carve(ctx + HC_ZONE0, at, tz, 0);
    at = rekha_hint_zone_carve(ctx + HC_ZONE1, at, gz, gc);
    store64(ctx + HC_GZCAP, gz);
    store64(ctx + HC_GZCCAP, gc);
    store64(ctx + HC_GZGID, 0 - 1);
    # the tag arrays, bytes, after every i64 array
    store64(ctx + HC_ZONE0 + ZN_TAGS, at);   at = at + tz;
    store64(ctx + HC_ZONE1 + ZN_TAGS, at);
    store64(ctx + HC_BUDGET, 0);
    store64(ctx + HC_DEPTH, 0);
    store64(ctx + HC_FPGMOK, 0);
    store64(ctx + HC_BYTES, bytes);
    store64(ctx + HC_FPGMERR, REKHA_OK);   store64(ctx + HC_FPGMDET, 0);
    store64(ctx + HC_PREPERR, REKHA_OK);   store64(ctx + HC_PREPDET, 0);
    store64(ctx + HC_RANGE, 0);
    # ⚠ sd_alloc does not promise zeroed memory. The two definition tables need no zeroing: each
    # is read only up to its count, and both counts start at 0.
    var i = 0;
    while (i < sto) { store64(load64(ctx + HC_STORE) + i * 8, 0); i = i + 1; }
    i = 0;
    while (i < cvn) { store64(load64(ctx + HC_CVT) + i * 8, 0); i = i + 1; }
    # ⚠ The twilight zone is the font's own scratch space and the spec starts it at the origin, so
    # it is zeroed here and RE-ZEROED before every `prep` run, never per glyph: a glyph program
    # is entitled to the twilight points `prep` set up for its size, which is the whole point of
    # MIAP in the twilight zone (ref2143/ttobjs.c:954-955).
    rekha_hint_zone_clear(ctx + HC_ZONE0, tz);
    store64(ctx + HC_ZONE0 + ZN_N, tz);
    store64(ctx + HC_ZONE1 + ZN_N, 0);
    store64(ctx + HC_ZONE1 + ZN_NC, 0);
    rekha_hint_reset(ctx);
    return ctx;
}

# Hand a zone descriptor its six i64 arrays out of the block at `at`, and answer the new `at`.
# The tag array is a byte array and is carved separately, after every i64 array in the context.
fn rekha_hint_zone_carve(zn, at, n, nc): i64 {
    store64(zn + ZN_N, 0);
    store64(zn + ZN_NC, 0);
    store64(zn + ZN_ORUSX, at);   at = at + n * 8;
    store64(zn + ZN_ORUSY, at);   at = at + n * 8;
    store64(zn + ZN_ORGX, at);    at = at + n * 8;
    store64(zn + ZN_ORGY, at);    at = at + n * 8;
    store64(zn + ZN_CURX, at);    at = at + n * 8;
    store64(zn + ZN_CURY, at);    at = at + n * 8;
    store64(zn + ZN_CTRS, at);    at = at + nc * 8;
    return at;
}

# Put `n` points of a zone back to the origin, untouched and off-curve.
fn rekha_hint_zone_clear(zn, n): i64 {
    var i = 0;
    while (i < n) {
        store64(load64(zn + ZN_ORUSX) + i * 8, 0);
        store64(load64(zn + ZN_ORUSY) + i * 8, 0);
        store64(load64(zn + ZN_ORGX) + i * 8, 0);
        store64(load64(zn + ZN_ORGY) + i * 8, 0);
        store64(load64(zn + ZN_CURX) + i * 8, 0);
        store64(load64(zn + ZN_CURY) + i * 8, 0);
        store8(load64(zn + ZN_TAGS) + i, 0);
        i = i + 1;
    }
    return 0;
}

# The zone `z` selects: 0 twilight, 1 glyph. ⚠ SZP already refused anything else, so this is the
# only place that has to trust the number and it still clamps rather than indexing off the end.
fn rekha_hint_zone(ctx, z): i64 {
    if (z == 0) { return ctx + HC_ZONE0; }
    return ctx + HC_ZONE1;
}

# ================================================================
# Points: projecting, and moving.
# ⛔ A POINT INSTRUCTION NEVER READS OR WRITES x AND y DIRECTLY. It measures along the PROJECTION
# vector and moves along the FREEDOM vector, and the two are independent — that is the whole reason
# a hinting program can round a stem's width while letting the stem slide along an italic angle.
# ⛔ THE PROJECTION'S FAST PATHS ARE NOT AN OPTIMISATION EITHER. FreeType picks Project_x — answer
# dx, IGNORE dy — whenever the vector's x component is exactly +0x4000, and Project_y whenever its
# y component is, WHATEVER THE OTHER COMPONENT HOLDS (ref2143/ttinterp.c:2281-2291, per vector for
# the projection and the dual). A unit vector can be (0x4000, 69): that is what SPVFS 236 1
# normalises to, and what SPVTL gives on any line within a quarter of a degree of an axis. There
# the general dot product adds round(dy * 69 / 16384) that FreeType never sees, and the two
# disagree by a 1/64 on every measurement — a difference the K group found on five programs.
# Only +0x4000 selects; -0x4000 stays general, as in FreeType. The MOVE has its own selection —
# see rekha_hint_movevec.
# ================================================================

# (x, y) . (ax, ay) with the vector in F2Dot14 — FreeType's TT_DotFix14, rounded half AWAY from
# zero at 1/16384. ⚠ Cyrius divides toward zero, which is what makes the two-sided bias correct.
# `rekha_hint_dot14(d, 0, v, 0)` is TT_MulFix14(d, v), the same rounding on one product.
fn rekha_hint_dot14(x, y, ax, ay): i64 {
    var t = x * ax + y * ay;
    if (t >= 0) { t = t + 8192; }
    if (t < 0)  { t = t - 8192; }
    return t / 16384;
}

# The projection of (dx, dy) — how far it counts as, in the direction the program is measuring.
# x is tested before y, as Compute_Funcs tests it (ref2143/ttinterp.c:2281-2286): a component of
# exactly +0x4000 answers that axis alone and the other component is not read.
fn rekha_hint_project(ctx, dx, dy): i64 {
    var px = load64(ctx + HC_PVX);
    if (px == 0x4000) { return dx; }
    var py = load64(ctx + HC_PVY);
    if (py == 0x4000) { return dy; }
    return rekha_hint_dot14(dx, dy, px, py);
}

# The same along the DUAL vector, which is the projection vector as it was BEFORE the outline
# moved. `IP`, `MD[1]`, `GC[1]` and the original distance of `MDRP` / `MIRP` measure here so that
# a proportion taken from the original outline is not computed out of already-fitted coordinates.
# The same selection, on the dual's own components (ref2143/ttinterp.c:2288-2293).
fn rekha_hint_dualproj(ctx, dx, dy): i64 {
    var vx = load64(ctx + HC_DVX);
    if (vx == 0x4000) { return dx; }
    var vy = load64(ctx + HC_DVY);
    if (vy == 0x4000) { return dy; }
    return rekha_hint_dot14(dx, dy, vx, vy);
}

# Recompute the move vector from the projection and freedom vectors. Every setter of either calls
# this, and so does rekha_hint_reset. ⭐ THREE REGIMES, AND THE THRESHOLDS ARE FreeType 2.14.3's
# (ref2143/ttinterp.c:2238-2279), because a font observes all three:
#   freedom . projection is rounded to F2Dot14. At 0x3FFE and above the two are treated as
#   collinear and the move vector is the freedom vector itself (times 4: F2Dot14 to 16.16); when
#   an axis of the freedom vector is exactly 1.0 the move is a plain add on that axis and the
#   other axis is not written at all (HC_MVSEL 1 for x, 2 for y).
#   Below 0x400 in magnitude the two are "prohibitively orthogonal": the move vector is ZERO, so a
#   point asked to move perpendicular to what was just measured neither moves nor is touched.
#   Between the two, freedom * 65536 / (freedom . projection), the quotient truncated toward zero
#   and the product with the distance rounded once by rekha_hint_mulfix.
# 2.13.2 divided exactly per move and floored the spike at 0x400 back to 1.0; the two disagree by
# 1/64 on a few percent of oblique moves, and the host's 2.14.3 is the reference.
fn rekha_hint_movevec(ctx): i64 {
    var px = load64(ctx + HC_PVX);
    var py = load64(ctx + HC_PVY);
    var fx = load64(ctx + HC_FVX);
    var fy = load64(ctx + HC_FVY);
    var fdp = sd_asr((px * fx) + (py * fy) + 0x2000, 14);
    var mx = 0;
    var my = 0;
    var sel = 0;
    var general = 1;
    if (fdp >= 0x3FFE) {
        mx = fx * 4;
        my = fy * 4;
        general = 0;
        if (fx == 0x4000) { sel = 1; }
        if (sel == 0) { if (fy == 0x4000) { sel = 2; } }
    }
    if (fdp > (0 - 0x400)) { if (fdp < 0x400) { general = 0; } }
    if (general == 1) {
        mx = (fx * 0x10000) / fdp;
        my = (fy * 0x10000) / fdp;
    }
    store64(ctx + HC_MVX, mx);
    store64(ctx + HC_MVY, my);
    store64(ctx + HC_MVSEL, sel);
    return 0;
}

fn rekha_hint_zpt_x(zn, i): i64 { return load64(load64(zn + ZN_CURX) + i * 8); }
fn rekha_hint_zpt_y(zn, i): i64 { return load64(load64(zn + ZN_CURY) + i * 8); }
fn rekha_hint_zorg_x(zn, i): i64 { return load64(load64(zn + ZN_ORGX) + i * 8); }
fn rekha_hint_zorg_y(zn, i): i64 { return load64(load64(zn + ZN_ORGY) + i * 8); }
fn rekha_hint_zorus_x(zn, i): i64 { return load64(load64(zn + ZN_ORUSX) + i * 8); }
fn rekha_hint_zorus_y(zn, i): i64 { return load64(load64(zn + ZN_ORUSY) + i * 8); }

# The zone descriptor behind zone pointer `k` (0..2), and the zone number it holds.
fn rekha_hint_zp(ctx, k): i64 { return rekha_hint_zone(ctx, load64(ctx + HC_ZP0 + k * 8)); }
fn rekha_hint_gep(ctx, k): i64 { return load64(ctx + HC_ZP0 + k * 8); }

# 1 when `i` is a point of `zn`; otherwise records the refusal — `detail` names the instruction,
# "<MNEMONIC> point" — and answers 0. ⛔ EVERY POINT INDEX IN EVERY INSTRUCTION GOES THROUGH HERE,
# BEFORE ANYTHING IS WRITTEN. A font chooses these numbers and a glyph program that names a point
# its glyph does not have is the single most likely way an outline reads out of bounds — 0.3.11
# closed four of those in the plain loader. FreeType outside its pedantic mode skips the point
# (or answers 0) and carries on; rekha refuses the run, which is the policy stated at the head of
# rekha_hint_op_mem, and the two exceptions to it are IP's reference point 2 and DELTAP's pairs
# outside the ppem band, which FreeType tolerates in BOTH modes and rekha therefore does too.
# ⚠ ONE MORE STATED DIVERGENCE, HOSTILE-ONLY: FreeType reads a point operand through an FT_UShort
# cast before its bounds check (ref2143/ttinterp.c:5235, 5284, 5325, 5406, 5535 and the reference
# points at :4031-4035), so a stack value of 65536 + k names point k there, in both modes, with no
# error. rekha refuses it. No push can produce such an index — it takes arithmetic on the stack —
# and no font means one, so the refusal is kept and pinned rather than the wrap copied.
fn rekha_hint_pt_ok(ctx, zn, i, detail): i64 {
    if (i < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, detail); }
    if (i >= load64(zn + ZN_N)) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, detail); }
    return 1;
}

# 1 when the top `n` stack values are all points of `zn` — the pre-check a looped instruction
# makes before it moves the first of them, so a refusal leaves the zone untouched.
fn rekha_hint_pts_ok(ctx, zn, n, detail): i64 {
    var sp = load64(ctx + HC_SP);
    var st = load64(ctx + HC_STACK);
    var k = 1;
    while (k <= n) {
        if (rekha_hint_pt_ok(ctx, zn, load64(st + (sp - k) * 8), detail) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# Move point `i` of `zn` by `dist` along the freedom vector — FreeType's `func_move` — and mark it
# touched on each axis the move vector has a component on. ⚠ The touch flags are not
# bookkeeping: IUP interpolates the untouched points between the touched ones, so a move that
# forgets to set one drags a neighbour with it later. ⛔ A ZERO MOVE VECTOR MOVES AND TOUCHES
# NOTHING (the orthogonal regime), and a plain-add selection writes ONE axis and touches one, even
# though the freedom vector's other component may be a few units off zero — both are what
# Direct_Move / Direct_Move_X / Direct_Move_Y do (ref2143/ttinterp.c:1504-1540, 1597-1627).
fn rekha_hint_move(ctx, zn, i, dist): i64 {
    var sel = load64(ctx + HC_MVSEL);
    var tg = load64(zn + ZN_TAGS) + i;
    var ax = load64(zn + ZN_CURX) + i * 8;
    var ay = load64(zn + ZN_CURY) + i * 8;
    if (sel == 1) {
        store64(ax, load64(ax) + dist);
        store8(tg, load8(tg) | REKHA_TAG_TOUCHX);
        return 1;
    }
    if (sel == 2) {
        store64(ay, load64(ay) + dist);
        store8(tg, load8(tg) | REKHA_TAG_TOUCHY);
        return 1;
    }
    var mx = load64(ctx + HC_MVX);
    if (mx != 0) {
        store64(ax, load64(ax) + rekha_hint_mulfix(dist, mx));
        store8(tg, load8(tg) | REKHA_TAG_TOUCHX);
    }
    var my = load64(ctx + HC_MVY);
    if (my != 0) {
        store64(ay, load64(ay) + rekha_hint_mulfix(dist, my));
        store8(tg, load8(tg) | REKHA_TAG_TOUCHY);
    }
    return 1;
}

# The same move applied to the ORIGINAL position, and no touch — FreeType's `func_move_orig`,
# which only MSIRP into the twilight zone uses (ref2143/ttinterp.c:1563-1583, 5236-5241).
fn rekha_hint_move_orig(ctx, zn, i, dist): i64 {
    var sel = load64(ctx + HC_MVSEL);
    var ax = load64(zn + ZN_ORGX) + i * 8;
    var ay = load64(zn + ZN_ORGY) + i * 8;
    if (sel == 1) { store64(ax, load64(ax) + dist); return 0; }
    if (sel == 2) { store64(ay, load64(ay) + dist); return 0; }
    var mx = load64(ctx + HC_MVX);
    if (mx != 0) { store64(ax, load64(ax) + rekha_hint_mulfix(dist, mx)); }
    var my = load64(ctx + HC_MVY);
    if (my != 0) { store64(ay, load64(ay) + rekha_hint_mulfix(dist, my)); }
    return 0;
}

# Shift point `i` of `zn` by a displacement already split into axes — what SHP, SHC, SHZ and
# SHPIX do when they carry a point along with one that was moved deliberately. ⚠ Both the add and
# the touch are keyed on the FREEDOM vector's components, not on the move vector's: a shift under
# a near-orthogonal pair adds 0 and still touches, where rekha_hint_move would do neither. That
# asymmetry is FreeType's own (Move_Zp2_Point, ref2143/ttinterp.c:4965-4996) and is kept. SHZ
# passes `touch` 0; the other three pass 1.
fn rekha_hint_move_zp2(ctx, zn, i, dx, dy, touch): i64 {
    var tg = load64(zn + ZN_TAGS) + i;
    if (load64(ctx + HC_FVX) != 0) {
        var ax = load64(zn + ZN_CURX) + i * 8;
        store64(ax, load64(ax) + dx);
        if (touch == 1) { store8(tg, load8(tg) | REKHA_TAG_TOUCHX); }
    }
    if (load64(ctx + HC_FVY) != 0) {
        var ay = load64(zn + ZN_CURY) + i * 8;
        store64(ay, load64(ay) + dy);
        if (touch == 1) { store8(tg, load8(tg) | REKHA_TAG_TOUCHY); }
    }
    return 0;
}

# How far the reference point of SHP / SHC / SHZ has moved from its original position, projected
# and then split along the move vector into a displacement the other points are shifted by.
# Opcode bit 0 picks rp1 in zp0, else rp2 in zp1. Writes dx, dy, the reference's zone descriptor
# and its index into the four-slot `out`; 0 and the refusal when the reference point is not in its
# zone (ref2143/ttinterp.c:4922-4962).
fn rekha_hint_displacement(ctx, op, out, detail): i64 {
    var zn = rekha_hint_zp(ctx, 1);
    var p = load64(ctx + HC_RP2);
    if ((op & 1) != 0) {
        zn = rekha_hint_zp(ctx, 0);
        p = load64(ctx + HC_RP1);
    }
    if (rekha_hint_pt_ok(ctx, zn, p, detail) == 0) { return 0; }
    var d = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p) - rekha_hint_zorg_x(zn, p),
      rekha_hint_zpt_y(zn, p) - rekha_hint_zorg_y(zn, p));
    store64(out, rekha_hint_mulfix(d, load64(ctx + HC_MVX)));
    store64(out + 8, rekha_hint_mulfix(d, load64(ctx + HC_MVY)));
    store64(out + 16, zn);
    store64(out + 24, p);
    return 1;
}

# ---- making a vector a unit vector ----
# ⛔ PORTED FROM FT_Vector_NormLen (ref2143/ftcalc.c:786-874) STEP FOR STEP, because the answer is
# compared bit for bit with FreeType's and a Newton iteration that converges to the same unit
# vector from a different starting estimate lands one 1/16384 away often enough to move points.
# Its inputs are 32-bit and its squared length wraps at 32 bits ON PURPOSE — the code recovers the
# difference from 2^32 through the conversion to signed — so both are reproduced with masks
# rather than left to i64.

# Truncate to a signed 32-bit value, the way a C cast to FT_Int32 does.
fn rekha_hint_i32(v): i64 {
    var x = v & 0xFFFFFFFF;
    if (x >= 0x80000000) { return x - 0x100000000; }
    return x;
}

# The index of the highest set bit of a positive value — FT_MSB.
fn rekha_hint_msb(v): i64 {
    var n = 0;
    while (v > 1) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# (vx, vy), not both zero, as a 16.16 unit vector into the two-slot `out`.
fn rekha_hint_normlen(vx, vy, out): i64 {
    var x = rekha_hint_i32(vx);
    var y = rekha_hint_i32(vy);
    var sx = 1;
    var sy = 1;
    if (x < 0) { x = 0 - x; sx = 0 - 1; }
    if (y < 0) { y = 0 - y; sy = 0 - 1; }
    # the axis-aligned cases are exact and skip the iteration
    if (x == 0) {
        store64(out, 0);
        store64(out + 8, sy * 0x10000);
        return 0;
    }
    if (y == 0) {
        store64(out, sx * 0x10000);
        store64(out + 8, 0);
        return 0;
    }
    # estimate the length as max + min / 2 and shift so that it lands between 2/3 and 4/3 of 1.0
    var l = y + (x >> 1);
    if (x > y) { l = x + (y >> 1); }
    var shift = 31 - rekha_hint_msb(l);
    var bump = 15;
    if (l >= (0xAAAAAAAA >> shift)) { bump = 16; }
    shift = shift - bump;
    if (shift > 0) {
        x = x << shift;
        y = y << shift;
        l = y + (x >> 1);
        if (x > y) { l = x + (y >> 1); }
    }
    if (shift <= 0) {
        x = x >> (0 - shift);
        y = y >> (0 - shift);
        l = l >> (0 - shift);
    }
    # b approximates 1 / length - 1; Newton's iterations refine it until the correction is not
    # positive. ⚠ The products below are SIGNED shifts: b goes negative whenever the estimated
    # length is over 1.0, and a logical shift of that product is a different number.
    var b = 0x10000 - l;
    var u = 0;
    var v = 0;
    var z = 1;
    while (z > 0) {
        u = x + sd_asr(x * b, 16);
        v = y + sd_asr(y * b, 16);
        var s = rekha_hint_i32(u * u + v * v);
        z = (0 - s) / 0x200;
        z = (z * ((0x10000 + b) >> 8)) / 0x10000;
        b = b + z;
    }
    if (sx < 0) { u = 0 - u; }
    if (sy < 0) { v = 0 - v; }
    store64(out, u);
    store64(out + 8, v);
    return 0;
}

# (x, y) as an F2Dot14 unit vector into the two-slot `out` — FreeType's Normalize
# (ref2143/ttinterp.c:2326-2349): the 16.16 result divided by 4 toward zero. ⚠ Answers 0 for the
# ZERO VECTOR AND WRITES NOTHING, and the caller leaves the graphics state as it was: that is what
# SPVFS / SFVFS do with (0, 0), and SPVTL / SFVTL / SDPVTL never pass one because two coincident
# points are turned into the x axis first. 1 when it wrote.
fn rekha_hint_normalize(x, y, out): i64 {
    if (x == 0) { if (y == 0) { return 0; } }
    var u: i64[2];
    rekha_hint_normlen(x, y, &u);
    store64(out, load64(&u) / 4);
    store64(out + 8, load64(&u + 8) / 4);
    return 1;
}

# The line from the point on top of the stack (in zp2) to the one below it (in zp1), rotated a
# quarter turn counter-clockwise when the opcode's low bit is set, as a unit vector into `out` —
# the shared body of SPVTL and SFVTL (ref2143/ttinterp.c:3796-3846). Two coincident points give
# the x axis and skip the rotation. 0 and the refusal when a point is not in its zone.
fn rekha_hint_sxvtl(ctx, op, p1, p2, out, detail): i64 {
    var zn2 = rekha_hint_zp(ctx, 2);
    var zn1 = rekha_hint_zp(ctx, 1);
    if (rekha_hint_pt_ok(ctx, zn2, p1, detail) == 0) { return 0; }
    if (rekha_hint_pt_ok(ctx, zn1, p2, detail) == 0) { return 0; }
    var a = rekha_hint_zpt_x(zn1, p2) - rekha_hint_zpt_x(zn2, p1);
    var b = rekha_hint_zpt_y(zn1, p2) - rekha_hint_zpt_y(zn2, p1);
    var rot = op & 1;
    if (a == 0) { if (b == 0) { a = 0x4000; rot = 0; } }
    if (rot != 0) {
        var c = b;
        b = a;
        a = 0 - c;
    }
    rekha_hint_normalize(a, b, out);
    return 1;
}

# ================================================================
# Walking bytecode. ⛔ AN INSTRUCTION IS NOT ONE BYTE. The eighteen push opcodes carry their
# operands INLINE, so every walk — skipping a false IF, scanning an FDEF body, stepping the
# interpreter — has to ask how long the instruction is or it will resume inside a literal and
# execute data. This is the single function all three use.
# ================================================================

# Total byte length of the instruction at `ip`, operands included. -1 when its operands run past
# `end`, which is a truncated program and not a decodable one.
fn rekha_hint_ilen(buf, ip, end): i64 {
    var op = load8(buf + ip);
    if (op == 0x40) {                                    # NPUSHB
        if (ip + 2 > end) { return 0 - 1; }
        return 2 + load8(buf + ip + 1);
    }
    if (op == 0x41) {                                    # NPUSHW
        if (ip + 2 > end) { return 0 - 1; }
        return 2 + load8(buf + ip + 1) * 2;
    }
    if (op >= 0xB0) {
        if (op <= 0xB7) { return 2 + (op - 0xB0); }       # PUSHB[0..7]
        if (op <= 0xBF) { return 1 + (op - 0xB8 + 1) * 2; }   # PUSHW[0..7]
    }
    return 1;
}

# From the byte after an IF whose condition was false, find where execution resumes: the byte after
# the matching ELSE when `want_else` is 1, otherwise the byte after the matching EIF. -1 when the
# IF is never closed. ⚠ Nested IFs are counted; an FDEF inside one is not, because the spec forbids
# defining a function inside a conditional and rekha_hint_scan_endf refuses the nesting anyway.
fn rekha_hint_skip_if(buf, ip, end, want_else): i64 {
    var nest = 0;
    while (ip < end) {
        var op = load8(buf + ip);
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return 0 - 1; }
        if (ip + ln > end) { return 0 - 1; }
        if (op == 0x58) { nest = nest + 1; }             # IF
        if (op == 0x59) {                                # EIF
            if (nest == 0) { return ip + ln; }
            nest = nest - 1;
        }
        if (op == 0x1B) {                                # ELSE
            if (nest == 0) {
                if (want_else == 1) { return ip + ln; }
            }
        }
        ip = ip + ln;
    }
    return 0 - 1;
}

# From the byte after an FDEF or IDEF, find the offset of its ENDF. -1 when there is none, or when
# another definition opens before it: the spec forbids nesting and a font that does it is telling
# rekha two different things about where the body ends.
fn rekha_hint_scan_endf(buf, ip, end): i64 {
    while (ip < end) {
        var op = load8(buf + ip);
        if (op == 0x2D) { return ip; }                   # ENDF
        if (op == 0x2C) { return 0 - 1; }                # FDEF inside a definition
        if (op == 0x89) { return 0 - 1; }                # IDEF inside a definition
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return 0 - 1; }
        if (ip + ln > end) { return 0 - 1; }
        ip = ip + ln;
    }
    return 0 - 1;
}

# Sign-extend the low 16 bits, which is how a vector component reaches the graphics state from
# the stack: SPVFS and SFVFS read their operands as 16-bit values (ref2143/ttinterp.c:3959-3960).
fn rekha_hint_s16(v): i64 {
    var x = v & 0xFFFF;
    if (x >= 32768) { return x - 65536; }
    return x;
}

# ================================================================
# The instruction set, part one: the stack, arithmetic, comparison and rounding.
# Every handler answers 1 (done), 0 (not mine — try the next group) or -1 (refused, and the reason
# is on the context). ⚠ The refusal is checked BEFORE the pops in every case, through
# rekha_hint_need: popping first and testing afterwards is how an underflow becomes a 0 operand.
# ================================================================
fn rekha_hint_op_alu(ctx, op): i64 {
    # ── comparison: LT LTEQ GT GTEQ EQ NEQ ──
    if (op >= 0x50) {
        if (op <= 0x55) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
            var b = rekha_hint_pop(ctx);
            var a = rekha_hint_pop(ctx);
            var r = 0;
            if (op == 0x50) { if (a < b)  { r = 1; } }
            if (op == 0x51) { if (a <= b) { r = 1; } }
            if (op == 0x52) { if (a > b)  { r = 1; } }
            if (op == 0x53) { if (a >= b) { r = 1; } }
            if (op == 0x54) { if (a == b) { r = 1; } }
            if (op == 0x55) { if (a != b) { r = 1; } }
            if (rekha_hint_push(ctx, r) == 0) { return 0 - 1; }
            return 1;
        }
    }
    # ── ODD / EVEN: the spec ROUNDS first, so they answer about the fitted distance. ⚠ Then
    #    they test BIT 6 ALONE — the parity of the whole pixel — not the low seven bits
    #    (ref2143/ttinterp.c:2567, 2581): under a rounding state that answers half pixels, 2.13.2
    #    called 96 neither odd nor even and 2.14.3 calls it odd. 0.8.0 had 2.13.2's test. ──
    if (op == 0x56) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var v1 = rekha_hint_round(ctx, rekha_hint_pop(ctx)) & 64;
        var o1 = 0;
        if (v1 == 64) { o1 = 1; }
        if (rekha_hint_push(ctx, o1) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x57) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var v2 = rekha_hint_round(ctx, rekha_hint_pop(ctx)) & 64;
        var o2 = 0;
        if (v2 == 0) { o2 = 1; }
        if (rekha_hint_push(ctx, o2) == 0) { return 0 - 1; }
        return 1;
    }
    # ── AND / OR / NOT, on truth rather than on bits ──
    if (op == 0x5A) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b3 = rekha_hint_pop(ctx);
        var a3 = rekha_hint_pop(ctx);
        var r3 = 0;
        if (a3 != 0) { if (b3 != 0) { r3 = 1; } }
        if (rekha_hint_push(ctx, r3) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x5B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b4 = rekha_hint_pop(ctx);
        var a4 = rekha_hint_pop(ctx);
        var r4 = 1;
        if (a4 == 0) { if (b4 == 0) { r4 = 0; } }
        if (rekha_hint_push(ctx, r4) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x5C) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var r5 = 0;
        if (rekha_hint_pop(ctx) == 0) { r5 = 1; }
        if (rekha_hint_push(ctx, r5) == 0) { return 0 - 1; }
        return 1;
    }
    # ── ADD SUB DIV MUL, all F26Dot6 ──
    if (op >= 0x60) {
        if (op <= 0x63) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
            var b6 = rekha_hint_pop(ctx);
            var a6 = rekha_hint_pop(ctx);
            var r6 = 0;
            if (op == 0x60) { r6 = a6 + b6; }
            if (op == 0x61) { r6 = a6 - b6; }
            if (op == 0x62) {
                # ⛔ A DIVIDE BY ZERO IS A REFUSAL, not a saturated maximum. The instruction has no
                # defined answer and a font that reaches it has computed something rekha cannot
                # reproduce; continuing would put an invented number into a glyph's metrics.
                if (b6 == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DIV by zero") - 1; }
                r6 = rekha_hint_muldiv(a6, 64, b6);
            }
            if (op == 0x63) { r6 = rekha_hint_muldiv(a6, b6, 64); }
            if (rekha_hint_push(ctx, r6) == 0) { return 0 - 1; }
            return 1;
        }
        # ── ABS NEG FLOOR CEILING ──
        if (op <= 0x67) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            var v7 = rekha_hint_pop(ctx);
            if (op == 0x64) { if (v7 < 0) { v7 = 0 - v7; } }
            if (op == 0x65) { v7 = 0 - v7; }
            if (op == 0x66) { v7 = rekha_hint_floor_mul(v7, 64); }
            if (op == 0x67) { v7 = rekha_hint_floor_mul(v7 + 63, 64); }
            if (rekha_hint_push(ctx, v7) == 0) { return 0 - 1; }
            return 1;
        }
        # ── ROUND[ab] and NROUND[ab]. The two low bits pick an engine compensation; all four are
        #    zero here, so NROUND is the identity and ROUND ignores the distance type. ──
        if (op <= 0x6B) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            if (rekha_hint_push(ctx, rekha_hint_round(ctx, rekha_hint_pop(ctx))) == 0) {
                return 0 - 1;
            }
            return 1;
        }
        if (op <= 0x6F) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            if (rekha_hint_push(ctx, rekha_hint_pop(ctx)) == 0) { return 0 - 1; }
            return 1;
        }
    }
    # ── MAX / MIN ──
    if (op == 0x8B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b8 = rekha_hint_pop(ctx);
        var a8 = rekha_hint_pop(ctx);
        if (b8 > a8) { a8 = b8; }
        if (rekha_hint_push(ctx, a8) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x8C) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b9 = rekha_hint_pop(ctx);
        var a9 = rekha_hint_pop(ctx);
        if (b9 < a9) { a9 = b9; }
        if (rekha_hint_push(ctx, a9) == 0) { return 0 - 1; }
        return 1;
    }
    return rekha_hint_op_stack(ctx, op);
}

# DUP POP CLEAR SWAP DEPTH CINDEX MINDEX ROLL — the stack as a data structure.
fn rekha_hint_op_stack(ctx, op): i64 {
    if (op == 0x20) {                                     # DUP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var sp = load64(ctx + HC_SP);
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STACK) + (sp - 1) * 8)) == 0) {
            return 0 - 1;
        }
        return 1;
    }
    if (op == 0x21) {                                     # POP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    if (op == 0x22) {                                     # CLEAR
        store64(ctx + HC_SP, 0);
        return 1;
    }
    if (op == 0x23) {                                     # SWAP
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var s2 = load64(ctx + HC_SP);
        var at = load64(ctx + HC_STACK);
        var t = load64(at + (s2 - 1) * 8);
        store64(at + (s2 - 1) * 8, load64(at + (s2 - 2) * 8));
        store64(at + (s2 - 2) * 8, t);
        return 1;
    }
    if (op == 0x24) {                                     # DEPTH
        if (rekha_hint_push(ctx, load64(ctx + HC_SP)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x25) {                                     # CINDEX — copy the k-th from the top
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var k = rekha_hint_pop(ctx);
        if (k < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "CINDEX") - 1; }
        if (rekha_hint_need(ctx, k) == 0) { return 0 - 1; }
        var s3 = load64(ctx + HC_SP);
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STACK) + (s3 - k) * 8)) == 0) {
            return 0 - 1;
        }
        return 1;
    }
    if (op == 0x26) {                                     # MINDEX — move it, closing the gap
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var m = rekha_hint_pop(ctx);
        if (m < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MINDEX") - 1; }
        if (rekha_hint_need(ctx, m) == 0) { return 0 - 1; }
        var s4 = load64(ctx + HC_SP);
        var a4 = load64(ctx + HC_STACK);
        var v = load64(a4 + (s4 - m) * 8);
        var i = s4 - m;
        while (i < s4 - 1) {
            store64(a4 + i * 8, load64(a4 + (i + 1) * 8));
            i = i + 1;
        }
        store64(a4 + (s4 - 1) * 8, v);
        return 1;
    }
    if (op == 0x8A) {                                     # ROLL — (a b c) becomes (b c a)
        if (rekha_hint_need(ctx, 3) == 0) { return 0 - 1; }
        var s5 = load64(ctx + HC_SP);
        var a5 = load64(ctx + HC_STACK);
        var x = load64(a5 + (s5 - 3) * 8);
        store64(a5 + (s5 - 3) * 8, load64(a5 + (s5 - 2) * 8));
        store64(a5 + (s5 - 2) * 8, load64(a5 + (s5 - 1) * 8));
        store64(a5 + (s5 - 1) * 8, x);
        return 1;
    }
    return 0;
}

# ================================================================
# The instruction set, part two: the graphics state, the storage area and the control values.
# ================================================================
fn rekha_hint_op_gs(ctx, op): i64 {
    # ── SVTCA / SPVTCA / SFVTCA. The low bit picks the axis: 1 is x, 0 is y. ──
    if (op <= 0x05) {
        var ax = op & 1;
        var vx = 0;
        var vy = 16384;
        if (ax == 1) { vx = 16384; vy = 0; }
        if (op <= 0x03) {
            store64(ctx + HC_PVX, vx);   store64(ctx + HC_PVY, vy);
            store64(ctx + HC_DVX, vx);   store64(ctx + HC_DVY, vy);
        }
        if (op <= 0x01) { store64(ctx + HC_FVX, vx);   store64(ctx + HC_FVY, vy); }
        if (op >= 0x04) { store64(ctx + HC_FVX, vx);   store64(ctx + HC_FVY, vy); }
        rekha_hint_movevec(ctx);
        return 1;
    }
    # ── SPVFS / SFVFS: a vector straight from the stack, y on top, each operand's low 16 bits.
    #    ⚠ NORMALISED here rather than stored raw, so GPV and GFV answer what the machine would
    #    actually project along; a (0, 0) operand leaves the vector as it was, and SPVFS still
    #    copies the projection vector onto the dual (ref2143/ttinterp.c:3948-3969). ──
    if (op == 0x0A) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var y1 = rekha_hint_s16(rekha_hint_pop(ctx));
        var x1 = rekha_hint_s16(rekha_hint_pop(ctx));
        var u1: i64[2];
        if (rekha_hint_normalize(x1, y1, &u1) == 1) {
            store64(ctx + HC_PVX, load64(&u1));   store64(ctx + HC_PVY, load64(&u1 + 8));
        }
        store64(ctx + HC_DVX, load64(ctx + HC_PVX));
        store64(ctx + HC_DVY, load64(ctx + HC_PVY));
        rekha_hint_movevec(ctx);
        return 1;
    }
    if (op == 0x0B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var y2 = rekha_hint_s16(rekha_hint_pop(ctx));
        var x2 = rekha_hint_s16(rekha_hint_pop(ctx));
        var u2: i64[2];
        if (rekha_hint_normalize(x2, y2, &u2) == 1) {
            store64(ctx + HC_FVX, load64(&u2));   store64(ctx + HC_FVY, load64(&u2 + 8));
        }
        rekha_hint_movevec(ctx);
        return 1;
    }
    if (op == 0x0C) {                                     # GPV — x first, y on top
        if (rekha_hint_push(ctx, load64(ctx + HC_PVX)) == 0) { return 0 - 1; }
        if (rekha_hint_push(ctx, load64(ctx + HC_PVY)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x0D) {                                     # GFV
        if (rekha_hint_push(ctx, load64(ctx + HC_FVX)) == 0) { return 0 - 1; }
        if (rekha_hint_push(ctx, load64(ctx + HC_FVY)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x0E) {                                     # SFVTPV
        store64(ctx + HC_FVX, load64(ctx + HC_PVX));
        store64(ctx + HC_FVY, load64(ctx + HC_PVY));
        rekha_hint_movevec(ctx);
        return 1;
    }
    # ── SRP0 / SRP1 / SRP2 and SZP0 / SZP1 / SZP2 / SZPS ──
    if (op >= 0x10) {
        if (op <= 0x12) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            store64(ctx + HC_RP0 + (op - 0x10) * 8, rekha_hint_pop(ctx));
            return 1;
        }
        if (op <= 0x16) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            var z = rekha_hint_pop(ctx);
            # ⛔ THERE ARE EXACTLY TWO ZONES. 0 is the twilight zone and 1 the glyph; anything else
            # is refused here rather than at the first point access, so the reason names SZP.
            if (z < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SZP zone") - 1; }
            if (z > 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SZP zone") - 1; }
            if (op == 0x16) {
                store64(ctx + HC_ZP0, z);
                store64(ctx + HC_ZP1, z);
                store64(ctx + HC_ZP2, z);
                return 1;
            }
            store64(ctx + HC_ZP0 + (op - 0x13) * 8, z);
            return 1;
        }
    }
    if (op == 0x17) {                                     # SLOOP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var lp = rekha_hint_pop(ctx);
        if (lp < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SLOOP") - 1; }
        store64(ctx + HC_LOOP, lp);
        return 1;
    }
    # ── the six fixed rounding states ──
    if (op == 0x18) { store64(ctx + HC_RSTATE, REKHA_RND_GRID);   return 1; }
    if (op == 0x19) { store64(ctx + HC_RSTATE, REKHA_RND_HALF);   return 1; }
    if (op == 0x3D) { store64(ctx + HC_RSTATE, REKHA_RND_DOUBLE); return 1; }
    if (op == 0x7A) { store64(ctx + HC_RSTATE, REKHA_RND_OFF);    return 1; }
    if (op == 0x7C) { store64(ctx + HC_RSTATE, REKHA_RND_UP);     return 1; }
    if (op == 0x7D) { store64(ctx + HC_RSTATE, REKHA_RND_DOWN);   return 1; }
    # ── and the two the font composes. SROUND's grid is one pixel, S45ROUND's is sqrt(2)/2. ──
    if (op == 0x76) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_set_super(ctx, REKHA_HINT_GRID, rekha_hint_pop(ctx) & 0xFF);
        store64(ctx + HC_RSTATE, REKHA_RND_SUPER);
        return 1;
    }
    if (op == 0x77) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_set_super(ctx, REKHA_HINT_GRID45, rekha_hint_pop(ctx) & 0xFF);
        store64(ctx + HC_RSTATE, REKHA_RND_SUPER45);
        return 1;
    }
    # ── the single-value graphics-state setters ──
    if (op == 0x1A) {                                     # SMD — minimum distance, F26Dot6
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_MINDIST, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1D) {                                     # SCVTCI — control-value cut-in
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_CVTCUT, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1E) {                                     # SSWCI — single-width cut-in
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_SWCUT, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1F) {
        # ⚠ SSW's operand is in FONT UNITS while every other distance here is F26Dot6, so it is the
        # one setter that scales. Storing it raw would make a single width tens of pixels wide.
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_SWVAL, rekha_hint_mulfix(rekha_hint_pop(ctx), load64(ctx + HC_SCALE)));
        return 1;
    }
    if (op == 0x4D) { store64(ctx + HC_AUTOFLIP, 1); return 1; }
    if (op == 0x4E) { store64(ctx + HC_AUTOFLIP, 0); return 1; }
    if (op == 0x5E) {
        # ⚠ SDB KEEPS THE LOW 16 BITS, UNSIGNED, as FreeType's GS.delta_base is an FT_UShort
        # (ref2143/ttinterp.c:4169-4173): `SDB -1` is a base of 65535, which puts every DELTAP /
        # DELTAC band out of reach, and 65545 is a base of 9. Storing the raw value would fire
        # exceptions FreeType never applies.
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_DBASE, rekha_hint_pop(ctx) & 0xFFFF);
        return 1;
    }
    if (op == 0x5F) {                                     # SDS
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var ds = rekha_hint_pop(ctx);
        if (ds < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SDS") - 1; }
        if (ds > 6) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SDS") - 1; }
        store64(ctx + HC_DSHIFT, ds);
        return 1;
    }
    if (op == 0x85) {
        # ⭐ SCANCTRL STORES A DECISION, NOT ITS OPERAND. The low byte is a ppem threshold (0xFF:
        # always on, 0: always off) and bits 8 and 11 say "on at or below it" / "off above it";
        # the rotated and stretched bits never apply here. What a consumer reads back through
        # REKHA_GS_SCANCTRL is FreeType's resulting Bool (ref2143/ttinterp.c:4740-4775), which is
        # also the value `prep` hands the glyph programs — Liberation Sans pushes 0x190 and the
        # answer is 1 at every size.
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var sc = rekha_hint_pop(ctx);
        var th = sc & 0xFF;
        if (th == 0xFF) { store64(ctx + HC_SCANCTL, 1); return 1; }
        if (th == 0)    { store64(ctx + HC_SCANCTL, 0); return 1; }
        var ppem = load64(ctx + HC_PPEM);
        if ((sc & 0x100) != 0) { if (ppem <= th) { store64(ctx + HC_SCANCTL, 1); } }
        if ((sc & 0x800) != 0) { if (ppem > th)  { store64(ctx + HC_SCANCTL, 0); } }
        return 1;
    }
    if (op == 0x8D) {                                     # SCANTYPE — low 16 bits; negative ignored
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var sty = rekha_hint_pop(ctx);
        if (sty >= 0) { store64(ctx + HC_SCANTYPE, sty & 0xFFFF); }
        return 1;
    }
    if (op == 0x8E) {
        # ⚠ INSTCTRL takes the SELECTOR on top and the value below. This is the one operand order
        # here that real bytecode did not settle: the only site in the host corpus pushes `1 1`.
        # The selector is an index 1..3 naming a bit; the value is 0 or that bit's flag.
        # ⛔ IT BINDS ONLY INSIDE `prep` (ref2143/ttinterp.c:4714-4718): in the font program or a
        # program handed to rekha_hint_run it pops its operands and changes nothing.
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var sel = rekha_hint_pop(ctx);
        var val = rekha_hint_pop(ctx);
        if (sel < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        if (sel > 3) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        var kf = 1 << (sel - 1);
        if (val != 0) {
            if (val != kf) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        }
        if (load64(ctx + HC_RANGE) == 2) {
            store64(ctx + HC_INSTCTL, (load64(ctx + HC_INSTCTL) & (0xFF - kf)) | val);
        }
        return 1;
    }
    if (op == 0x4F) {
        # ⛔ DEBUG IS A REFUSAL. The spec calls it a no-op that pops one value, but FreeType's
        # Ins_DEBUG raises Debug_OpCode unconditionally, in every code range and both its modes
        # (ref2143/ttinterp.c:2895-2898): a font program or `prep` that reaches it is unhintable
        # there, and a glyph program stops at it. The operand is not popped, since nothing after
        # this instruction runs.
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DEBUG") - 1;
    }
    if (op == 0x7E) {                                     # SANGW — obsolete, pops one
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    if (op == 0x7F) {                                     # AA — obsolete, pops one
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    return rekha_hint_op_mem(ctx, op);
}

# ================================================================
# The instruction set, part three: the storage area, the control values, and what the machine can
# be asked about itself.
# ⛔ AN INDEX OUTSIDE THE FONT'S OWN DECLARED LIMIT IS A REFUSAL. FreeType, outside its pedantic
# mode, ignores the write and reads back 0; rekha refuses the run and names the instruction,
# because a `prep` writing past maxStorage has contradicted its own `maxp` and the glyph that
# comes out either way is not the one the font describes. ⚠ It is a real divergence, and the one
# to revisit first if a face in the wild trips it.
# ================================================================
fn rekha_hint_op_mem(ctx, op): i64 {
    if (op == 0x43) {                                     # RS — read storage
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var l1 = rekha_hint_pop(ctx);
        if (l1 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RS index") - 1; }
        if (l1 >= load64(ctx + HC_STORECAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RS index") - 1;
        }
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STORE) + l1 * 8)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x42) {                                     # WS — value on top, location below
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v2 = rekha_hint_pop(ctx);
        var l2 = rekha_hint_pop(ctx);
        if (l2 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WS index") - 1; }
        if (l2 >= load64(ctx + HC_STORECAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WS index") - 1;
        }
        store64(load64(ctx + HC_STORE) + l2 * 8, v2);
        return 1;
    }
    if (op == 0x45) {                                     # RCVT
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var l3 = rekha_hint_pop(ctx);
        if (l3 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RCVT index") - 1; }
        if (l3 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RCVT index") - 1;
        }
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_CVT) + l3 * 8)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x44) {                                     # WCVTP — already in pixels
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v4 = rekha_hint_pop(ctx);
        var l4 = rekha_hint_pop(ctx);
        if (l4 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTP index") - 1; }
        if (l4 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTP index") - 1;
        }
        store64(load64(ctx + HC_CVT) + l4 * 8, v4);
        return 1;
    }
    if (op == 0x70) {                                     # WCVTF — in font units, so it scales
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v5 = rekha_hint_pop(ctx);
        var l5 = rekha_hint_pop(ctx);
        if (l5 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTF index") - 1; }
        if (l5 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTF index") - 1;
        }
        store64(load64(ctx + HC_CVT) + l5 * 8, rekha_hint_mulfix(v5, load64(ctx + HC_SCALE)));
        return 1;
    }
    if (op == 0x4B) {                                     # MPPEM
        if (rekha_hint_push(ctx, load64(ctx + HC_PPEM)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x4C) {
        # ⚠ MPS answers the PPEM, as an integer, exactly as MPPEM does. That is what the classic
        # interpreter answers (ref2143/ttinterp.c:2390-2395, the version-35 branch); the F26Dot6
        # point size is the version-40 engine's, which rekha is not. 0.8.0 answered ppem * 64.
        if (rekha_hint_push(ctx, load64(ctx + HC_PPEM)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x88) { return rekha_hint_op_getinfo(ctx); }
    # ── DELTAC1 / DELTAC2 / DELTAC3: per-size exceptions to the control values ──
    if (op >= 0x73) {
        if (op <= 0x75) { return rekha_hint_op_deltac(ctx, op); }
    }
    return 0;
}

# GETINFO — what the font is allowed to ask about the machine it is running on.
# ⛔ EVERY ANSWER BELOW IS A DECISION, and a font program branches on them:
#   version 35. rekha implements the CLASSIC interpreter. Claiming 38 or 40 would promise subpixel
#     positioning and y-only hinting that this file does not do, and modern font programs take a
#     very different path when they see it.
#   rotated 0, stretched 0. rekha applies no transform; a consumer that does applies it after.
#   variations, when the face has live axes — the one bit rekha can answer from its own state.
#   grayscale smoothing ON. rekha's output is filled to COVERAGE by sadish, which is grayscale
#     anti-aliasing; saying otherwise would make a font hint for a bi-level device rekha has none.
#     ⚠ EXCEPT INSIDE `fpgm`, where it answers 0: FreeType runs the font program before the
#     render mode of the first load has been set (ref2143/ttgload.c:2213-2255), and a function
#     defined under one answer is a different function.
#   every ClearType bit 0, because there is no subpixel geometry anywhere in this stack.
fn rekha_hint_op_getinfo(ctx): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var sel = rekha_hint_pop(ctx);
    var r = 0;
    if ((sel & 0x0001) != 0) { r = r | 35; }
    if ((sel & 0x0008) != 0) {
        if (rekha_var_live(load64(ctx + HC_FONT)) != 0) { r = r | 0x0400; }
    }
    if ((sel & 0x0020) != 0) {
        if (load64(ctx + HC_RANGE) != 1) { r = r | 0x1000; }
    }
    if (rekha_hint_push(ctx, r) == 0) { return 0 - 1; }
    return 1;
}

# DELTAC — n, then n pairs of (exception spec, control-value index), index on top.
# The spec byte splits into a ppem selector in its high nibble and a magnitude in its low one:
# the selector plus the delta base (plus 16 for C2 and 32 for C3) is the ppem this applies at, and
# the magnitude runs -8..-1, 1..8 in units of 1/(2^delta_shift) pixels.
# ⚠ THE PAIRS ARE POPPED BEFORE THE PPEM IS LOOKED AT, AND WHEN THIS SIZE IS OUTSIDE THE
# INSTRUCTION'S SIXTEEN-PPEM BAND THE INDICES ARE NOT CHECKED AT ALL (ref2143/ttinterp.c:6389-6465):
# that is FreeType's behaviour in both its modes, so an index past the table in a band the size
# never reaches is not a refusal. Inside the band it is — and every pair's index is checked BEFORE
# the first entry is rewritten, as DELTAP checks its points, so a refused DELTAC leaves the
# control values as they were (FreeType's own loop, ref2143/ttinterp.c:6443-6465, refuses in the
# middle and keeps the entries it already moved). A short stack is a refusal too, before anything
# is popped; FreeType's clamp of the pair count is not copied (design D2).
fn rekha_hint_op_deltac(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var n = rekha_hint_pop(ctx);
    if (n < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC count") - 1; }
    if (rekha_hint_need(ctx, n * 2) == 0) { return 0 - 1; }
    var band = load64(ctx + HC_PPEM) - load64(ctx + HC_DBASE);
    if (op == 0x74) { band = band - 16; }
    if (op == 0x75) { band = band - 32; }
    if (band < 0)  { store64(ctx + HC_SP, load64(ctx + HC_SP) - n * 2); return 1; }
    if (band > 15) { store64(ctx + HC_SP, load64(ctx + HC_SP) - n * 2); return 1; }
    # every index of every pair is checked before the first entry moves
    var sp = load64(ctx + HC_SP);
    var st = load64(ctx + HC_STACK);
    var cap = load64(ctx + HC_CVTCAP);
    var k = 0;
    while (k < n) {
        var ci = load64(st + (sp - 1 - k * 2) * 8);
        if (ci < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC index") - 1; }
        if (ci >= cap) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC index") - 1; }
        k = k + 1;
    }
    var shift = load64(ctx + HC_DSHIFT);
    k = 0;
    while (k < n) {
        var idx = rekha_hint_pop(ctx);
        var spec = rekha_hint_pop(ctx);
        if ((spec & 0xF0) == (band << 4)) {
            var mag = (spec & 15) - 8;
            if (mag >= 0) { mag = mag + 1; }
            var at = load64(ctx + HC_CVT) + idx * 8;
            store64(at, load64(at) + sd_asr(mag * 64, shift));
        }
        k = k + 1;
    }
    return 1;
}

# GETVARIATION 0x91 — the current normalized axis coordinates, one F2Dot14 per axis, first axis
# deepest (ref2143/ttinterp.c:6609-6638). ⚠ rekha's own coordinates are 16.16 (src/var.cyr) and
# FreeType's conversion is a plain arithmetic shift by two — TRUNCATED toward minus infinity, not
# rounded — so a font asking this is asked what `rekha_var_set_axis` was last told, shifted.
# ⛔ ONLY ON A FACE WHOSE AXES ARE LIVE. FreeType routes 0x91 and 0x92 to these bodies only when
# the face's blend is active and otherwise to Ins_UNKNOWN — a font-defined IDEF for the opcode,
# else the Invalid_Opcode error (ref2143/ttinterp.c:7306-7324; the comment there names a
# shipping font whose fpgm IDEFs both). rekha_hint_exec makes the same choice, on
# `rekha_var_live`. ⚠ FreeType's "active" is any variation API call on the face, even one that
# selects the default instance; rekha's is an axis actually off its default, which is what
# `rekha_var_live` answers — a font that IDEFs 0x91 and is then set to its defaults sees its own
# instruction here and GETVARIATION there.
fn rekha_hint_op_getvariation(ctx): i64 {
    var font = load64(ctx + HC_FONT);
    var n = rekha_var_axis_count(font);
    var i = 0;
    while (i < n) {
        if (rekha_hint_push(ctx, sd_asr(rekha_var_coord(font, i), 2)) == 0) { return 0 - 1; }
        i = i + 1;
    }
    return 1;
}

# GETDATA 0x92 — pushes 17, under the same gate as GETVARIATION (ref2143/ttinterp.c:6649-6653,
# 7316-7324). Nobody knows what it is for; FreeType's own comment says as much.
fn rekha_hint_op_getdata(ctx): i64 {
    if (rekha_hint_push(ctx, 17) == 0) { return 0 - 1; }
    return 1;
}

# ================================================================
# The instruction set, part four: the points. Every instruction that reads or moves a point of
# either zone, except IUP, which needs the glyph loader and is 0.8.2's (see rekha_hint_point_op).
# Semantics are FreeType 2.14.3's classic interpreter, instruction by instruction, with the
# path:line of each body cited at its handler; the departures in this group are refusals — where
# FreeType outside its pedantic mode skips a point that is not in its zone, answers 0, or pops
# what it can, rekha refuses the run and names the instruction and the operand: "<MNEMONIC>
# point", "<MNEMONIC> cvt", "<MNEMONIC> contour", "<MNEMONIC> zone" — plus the one index class
# FreeType wraps rather than skips, stated at rekha_hint_pt_ok. Every operand is checked BEFORE
# anything is written, so a refused instruction leaves both zones and the reference points as
# they were.
# ⚠ Three different "original distance" recipes are in play and a font can see which is used:
# MDRP and MD[1] between two GLYPH points take the FONT-UNIT distance and scale it once (the two
# scaled positions can differ from that by 1/64); with a twilight point on either end they use the
# scaled originals; MIRP always uses the scaled originals; IP's proportion is taken in font units,
# unscaled, unless a twilight zone is involved. The twilight zone's font-unit positions are 0
# forever, which is why every one of them branches.
# ================================================================
fn rekha_hint_op_point(ctx, op): i64 {
    if (op >= 0x06) {
        if (op <= 0x09) { return rekha_hint_op_sxvtl(ctx, op); }
    }
    if (op == 0x0F) { return rekha_hint_op_isect(ctx); }
    if (op == 0x27) { return rekha_hint_op_alignpts(ctx); }
    if (op == 0x29) { return rekha_hint_op_utp(ctx); }
    if (op == 0x2E) { return rekha_hint_op_mdap(ctx, op); }
    if (op == 0x2F) { return rekha_hint_op_mdap(ctx, op); }
    if (op >= 0x32) {
        if (op <= 0x33) { return rekha_hint_op_shp(ctx, op); }
        if (op <= 0x35) { return rekha_hint_op_shc(ctx, op); }
        if (op <= 0x37) { return rekha_hint_op_shz(ctx, op); }
        if (op == 0x38) { return rekha_hint_op_shpix(ctx); }
        if (op == 0x39) { return rekha_hint_op_ip(ctx); }
        if (op <= 0x3B) { return rekha_hint_op_msirp(ctx, op); }
        if (op == 0x3C) { return rekha_hint_op_alignrp(ctx); }
        if (op == 0x3E) { return rekha_hint_op_miap(ctx, op); }
        if (op == 0x3F) { return rekha_hint_op_miap(ctx, op); }
    }
    if (op >= 0x46) {
        if (op <= 0x47) { return rekha_hint_op_gc(ctx, op); }
        if (op == 0x48) { return rekha_hint_op_scfs(ctx); }
        if (op <= 0x4A) { return rekha_hint_op_md(ctx, op); }
    }
    if (op == 0x5D) { return rekha_hint_op_deltap(ctx, op); }
    if (op == 0x71) { return rekha_hint_op_deltap(ctx, op); }
    if (op == 0x72) { return rekha_hint_op_deltap(ctx, op); }
    if (op == 0x80) { return rekha_hint_op_flippt(ctx); }
    if (op == 0x81) { return rekha_hint_op_fliprg(ctx, op); }
    if (op == 0x82) { return rekha_hint_op_fliprg(ctx, op); }
    if (op == 0x86) { return rekha_hint_op_sdpvtl(ctx, op); }
    if (op == 0x87) { return rekha_hint_op_sdpvtl(ctx, op); }
    if (op >= 0xC0) {
        if (op <= 0xDF) { return rekha_hint_op_mdrp(ctx, op); }
        return rekha_hint_op_mirp(ctx, op);
    }
    return 0;
}

# SPVTL[a] 0x06-0x07 / SFVTL[a] 0x08-0x09 — a vector along (or across) the line between two
# points, the top of the stack in zp2 and the one below it in zp1 (ref2143/ttinterp.c:3893-3928).
# SPVTL also sets the dual vector.
fn rekha_hint_op_sxvtl(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var p1 = rekha_hint_pop(ctx);
    var p2 = rekha_hint_pop(ctx);
    var u: i64[2];
    if (op <= 0x07) {
        if (rekha_hint_sxvtl(ctx, op, p1, p2, &u, "SPVTL point") == 0) { return 0 - 1; }
        store64(ctx + HC_PVX, load64(&u));   store64(ctx + HC_PVY, load64(&u + 8));
        store64(ctx + HC_DVX, load64(&u));   store64(ctx + HC_DVY, load64(&u + 8));
        rekha_hint_movevec(ctx);
        return 1;
    }
    if (rekha_hint_sxvtl(ctx, op, p1, p2, &u, "SFVTL point") == 0) { return 0 - 1; }
    store64(ctx + HC_FVX, load64(&u));   store64(ctx + HC_FVY, load64(&u + 8));
    rekha_hint_movevec(ctx);
    return 1;
}

# SDPVTL[a] 0x86-0x87 — the dual vector from the ORIGINAL positions of the two points and the
# projection vector from their CURRENT positions (ref2143/ttinterp.c:4463-4543). ⚠ The rotation
# flag is one local shared by both halves: when the original points coincide it is cleared, and
# the projection vector is then not rotated either, even if the current points differ.
fn rekha_hint_op_sdpvtl(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var p1 = rekha_hint_pop(ctx);
    var p2 = rekha_hint_pop(ctx);
    var zn2 = rekha_hint_zp(ctx, 2);
    var zn1 = rekha_hint_zp(ctx, 1);
    if (rekha_hint_pt_ok(ctx, zn1, p2, "SDPVTL point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn2, p1, "SDPVTL point") == 0) { return 0 - 1; }
    var rot = op & 1;
    var a = rekha_hint_zorg_x(zn1, p2) - rekha_hint_zorg_x(zn2, p1);
    var b = rekha_hint_zorg_y(zn1, p2) - rekha_hint_zorg_y(zn2, p1);
    if (a == 0) { if (b == 0) { a = 0x4000; rot = 0; } }
    if (rot != 0) {
        var c = b;
        b = a;
        a = 0 - c;
    }
    var u: i64[2];
    rekha_hint_normalize(a, b, &u);
    store64(ctx + HC_DVX, load64(&u));   store64(ctx + HC_DVY, load64(&u + 8));
    a = rekha_hint_zpt_x(zn1, p2) - rekha_hint_zpt_x(zn2, p1);
    b = rekha_hint_zpt_y(zn1, p2) - rekha_hint_zpt_y(zn2, p1);
    if (a == 0) { if (b == 0) { a = 0x4000; rot = 0; } }
    if (rot != 0) {
        var c2 = b;
        b = a;
        a = 0 - c2;
    }
    rekha_hint_normalize(a, b, &u);
    store64(ctx + HC_PVX, load64(&u));   store64(ctx + HC_PVY, load64(&u + 8));
    rekha_hint_movevec(ctx);
    return 1;
}

# ISECT 0x0F — move a point of zp2 to where line A (two points of zp1) crosses line B (two of
# zp0), by Cramer's rule in F26Dot6; two lines within about three degrees of parallel put the
# point at the mean of the four ends instead (ref2143/ttinterp.c:5723-5808). ⚠ Neither the
# projection nor the freedom vector is consulted: the point is written on both axes and touched
# on both.
fn rekha_hint_op_isect(ctx): i64 {
    if (rekha_hint_need(ctx, 5) == 0) { return 0 - 1; }
    var b1 = rekha_hint_pop(ctx);
    var b0 = rekha_hint_pop(ctx);
    var a1 = rekha_hint_pop(ctx);
    var a0 = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var zn2 = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pt_ok(ctx, zn0, b0, "ISECT point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn0, b1, "ISECT point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn1, a0, "ISECT point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn1, a1, "ISECT point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn2, p, "ISECT point") == 0) { return 0 - 1; }
    var dbx = rekha_hint_zpt_x(zn0, b1) - rekha_hint_zpt_x(zn0, b0);
    var dby = rekha_hint_zpt_y(zn0, b1) - rekha_hint_zpt_y(zn0, b0);
    var dax = rekha_hint_zpt_x(zn1, a1) - rekha_hint_zpt_x(zn1, a0);
    var day = rekha_hint_zpt_y(zn1, a1) - rekha_hint_zpt_y(zn1, a0);
    var dx = rekha_hint_zpt_x(zn0, b0) - rekha_hint_zpt_x(zn1, a0);
    var dy = rekha_hint_zpt_y(zn0, b0) - rekha_hint_zpt_y(zn1, a0);
    var disc = rekha_hint_muldiv(dax, 0 - dby, 0x40) + rekha_hint_muldiv(day, dbx, 0x40);
    var dot = rekha_hint_muldiv(dax, dbx, 0x40) + rekha_hint_muldiv(day, dby, 0x40);
    var adisc = disc;
    if (adisc < 0) { adisc = 0 - adisc; }
    var adot = dot;
    if (adot < 0) { adot = 0 - adot; }
    var cx = load64(zn2 + ZN_CURX) + p * 8;
    var cy = load64(zn2 + ZN_CURY) + p * 8;
    if (19 * adisc > adot) {
        var val = rekha_hint_muldiv(dx, 0 - dby, 0x40) + rekha_hint_muldiv(dy, dbx, 0x40);
        store64(cx, rekha_hint_zpt_x(zn1, a0) + rekha_hint_muldiv(val, dax, disc));
        store64(cy, rekha_hint_zpt_y(zn1, a0) + rekha_hint_muldiv(val, day, disc));
    }
    if (19 * adisc <= adot) {
        store64(cx, (rekha_hint_zpt_x(zn1, a0) + rekha_hint_zpt_x(zn1, a1)
            + rekha_hint_zpt_x(zn0, b0) + rekha_hint_zpt_x(zn0, b1)) / 4);
        store64(cy, (rekha_hint_zpt_y(zn1, a0) + rekha_hint_zpt_y(zn1, a1)
            + rekha_hint_zpt_y(zn0, b0) + rekha_hint_zpt_y(zn0, b1)) / 4);
    }
    var tg = load64(zn2 + ZN_TAGS) + p;
    store8(tg, load8(tg) | (REKHA_TAG_TOUCHX | REKHA_TAG_TOUCHY));
    return 1;
}

# ALIGNPTS 0x27 — move two points, the top of the stack in zp0 and the one below it in zp1, each
# halfway toward the other along the projection (ref2143/ttinterp.c:5817-5842). The half is
# truncated toward zero, so an odd distance leaves them one 1/64 apart.
fn rekha_hint_op_alignpts(ctx): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var p2 = rekha_hint_pop(ctx);
    var p1 = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    if (rekha_hint_pt_ok(ctx, zn1, p1, "ALIGNPTS point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn0, p2, "ALIGNPTS point") == 0) { return 0 - 1; }
    var d = rekha_hint_project(ctx, rekha_hint_zpt_x(zn0, p2) - rekha_hint_zpt_x(zn1, p1),
      rekha_hint_zpt_y(zn0, p2) - rekha_hint_zpt_y(zn1, p1)) / 2;
    rekha_hint_move(ctx, zn1, p1, d);
    rekha_hint_move(ctx, zn0, p2, 0 - d);
    return 1;
}

# UTP 0x29 — clear the touch bit of each axis the freedom vector has a component on, for a point
# of zp0 (ref2143/ttinterp.c:6018-6044).
fn rekha_hint_op_utp(ctx): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 0);
    if (rekha_hint_pt_ok(ctx, zn, p, "UTP point") == 0) { return 0 - 1; }
    var mask = 0xFF;
    if (load64(ctx + HC_FVX) != 0) { mask = mask - REKHA_TAG_TOUCHX; }
    if (load64(ctx + HC_FVY) != 0) { mask = mask - REKHA_TAG_TOUCHY; }
    var tg = load64(zn + ZN_TAGS) + p;
    store8(tg, load8(tg) & mask);
    return 1;
}

# MDAP[a] 0x2E-0x2F — a point of zp0 becomes rp0 and rp1; with the low bit set its projection is
# rounded and it moves by the difference, without it the move is 0 and the point is still
# touched (ref2143/ttinterp.c:5269-5305). No control value, no cut-in, no minimum distance.
fn rekha_hint_op_mdap(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 0);
    if (rekha_hint_pt_ok(ctx, zn, p, "MDAP point") == 0) { return 0 - 1; }
    var d = 0;
    if ((op & 1) != 0) {
        var cd = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p), rekha_hint_zpt_y(zn, p));
        d = rekha_hint_round(ctx, cd) - cd;
    }
    rekha_hint_move(ctx, zn, p, d);
    store64(ctx + HC_RP0, p);
    store64(ctx + HC_RP1, p);
    return 1;
}

# SHP[a] 0x32-0x33 — shift `loop` points of zp2, each popped from the stack, by how far the
# reference point (bit 0: rp1 in zp0, else rp2 in zp1) has moved from its original position
# (ref2143/ttinterp.c:4999-5047). A point listed twice moves twice; the reference itself is not
# excluded. ⛔ THE LOOP COUNTER IS CONSUMED AND RESET TO 1 ON EVERY EXIT, as by SHPIX, IP, ALIGNRP
# and FLIPPT — the five instructions that read it.
fn rekha_hint_op_shp(ctx, op): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop) == 0) { return 0 - 1; }
    var dp: i64[4];
    if (rekha_hint_displacement(ctx, op, &dp, "SHP point") == 0) { return 0 - 1; }
    var zn2 = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pts_ok(ctx, zn2, loop, "SHP point") == 0) { return 0 - 1; }
    while (loop > 0) {
        rekha_hint_move_zp2(ctx, zn2, rekha_hint_pop(ctx), load64(&dp), load64(&dp + 8), 1);
        loop = loop - 1;
    }
    return 1;
}

# SHC[a] 0x34-0x35 — shift every point of one contour of zp2 by the reference point's
# displacement, EXCEPT the reference point itself when it lies in that same zone
# (ref2143/ttinterp.c:5061-5101). ⚠ The twilight zone has one virtual contour, number 0, holding
# all its points; naming contour 1 there is a refusal.
# ⛔ THE CONTOUR-END TABLE IS NOT TRUSTED EITHER. FreeType walks from the previous contour's end
# to this one's and relies on its loader for both being inside the zone (:5087-5100); rekha
# refuses a contour whose ends put the walk before point 0, past ZN_N or backwards, so the
# descriptor defends itself before 0.8.2's loader validates the ends it copies in.
fn rekha_hint_op_shc(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var c = rekha_hint_pop(ctx);
    var zn2 = rekha_hint_zp(ctx, 2);
    var twilight = 0;
    if (rekha_hint_gep(ctx, 2) == 0) { twilight = 1; }
    var bounds = load64(zn2 + ZN_NC);
    if (twilight == 1) { bounds = 1; }
    if (c < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1; }
    if (c >= bounds) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1; }
    var start = 0;
    var limit = load64(zn2 + ZN_N);
    if (twilight == 0) {
        var ctrs = load64(zn2 + ZN_CTRS);
        if (c > 0) { start = load64(ctrs + (c - 1) * 8) + 1; }
        limit = load64(ctrs + c * 8) + 1;
        if (start < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1; }
        if (limit > load64(zn2 + ZN_N)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1;
        }
        if (start > limit) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1; }
    }
    var dp: i64[4];
    if (rekha_hint_displacement(ctx, op, &dp, "SHC point") == 0) { return 0 - 1; }
    var refzn = load64(&dp + 16);
    var refp = load64(&dp + 24);
    var i = start;
    while (i < limit) {
        var skip = 0;
        if (refzn == zn2) { if (refp == i) { skip = 1; } }
        if (skip == 0) { rekha_hint_move_zp2(ctx, zn2, i, load64(&dp), load64(&dp + 8), 1); }
        i = i + 1;
    }
    return 1;
}

# SHZ[a] 0x36-0x37 — shift every point of zp2 by the reference point's displacement, without
# touching any of them and skipping the reference point when it is in that zone
# (ref2143/ttinterp.c:5111-5149). ⚠ The operand is a zone number, checked to be 0 or 1 and then
# NOT USED: the zone shifted is zp2. In the glyph zone the four phantom points are left where they
# are — the walk stops at the last contour's end, which is refused when it lies outside the zone
# (the same self-defence as SHC's; FreeType trusts its loader at :5137-5142).
fn rekha_hint_op_shz(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var z = rekha_hint_pop(ctx);
    if (z < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHZ zone") - 1; }
    if (z > 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHZ zone") - 1; }
    var zn2 = rekha_hint_zp(ctx, 2);
    var limit = load64(zn2 + ZN_N);
    if (rekha_hint_gep(ctx, 2) != 0) {
        var nc = load64(zn2 + ZN_NC);
        limit = 0;
        if (nc > 0) { limit = load64(load64(zn2 + ZN_CTRS) + (nc - 1) * 8) + 1; }
        if (limit < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHZ zone") - 1; }
        if (limit > load64(zn2 + ZN_N)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHZ zone") - 1;
        }
    }
    var dp: i64[4];
    if (rekha_hint_displacement(ctx, op, &dp, "SHZ point") == 0) { return 0 - 1; }
    var refzn = load64(&dp + 16);
    var refp = load64(&dp + 24);
    var i = 0;
    while (i < limit) {
        var skip = 0;
        if (refzn == zn2) { if (refp == i) { skip = 1; } }
        if (skip == 0) { rekha_hint_move_zp2(ctx, zn2, i, load64(&dp), load64(&dp + 8), 0); }
        i = i + 1;
    }
    return 1;
}

# SHPIX 0x38 — shift `loop` points of zp2 by an F26Dot6 amount (on top of the stack, above the
# points) along the freedom vector: the amount times each component, NOT through the move vector
# (ref2143/ttinterp.c:5152-5218). Consumes and resets the loop counter.
fn rekha_hint_op_shpix(ctx): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop + 1) == 0) { return 0 - 1; }
    var amount = rekha_hint_pop(ctx);
    var dx = rekha_hint_dot14(amount, 0, load64(ctx + HC_FVX), 0);
    var dy = rekha_hint_dot14(amount, 0, load64(ctx + HC_FVY), 0);
    var zn2 = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pts_ok(ctx, zn2, loop, "SHPIX point") == 0) { return 0 - 1; }
    while (loop > 0) {
        rekha_hint_move_zp2(ctx, zn2, rekha_hint_pop(ctx), dx, dy, 1);
        loop = loop - 1;
    }
    return 1;
}

# IP 0x39 — move `loop` points of zp2 so that each keeps, between rp1 (zp0) and rp2 (zp1), the
# proportion it had in the original outline (ref2143/ttinterp.c:5860-6010). The proportion is
# taken in FONT UNITS along the dual vector unless any of the three zone pointers is the twilight
# zone, in which case the scaled originals serve. ⚠ Two things FreeType does in BOTH modes and
# rekha therefore does too: rp2 outside zp1 makes both ranges 0 rather than a refusal, and a zero
# original range moves the point to its original distance from rp1.
fn rekha_hint_op_ip(ctx): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop) == 0) { return 0 - 1; }
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var zn2 = rekha_hint_zp(ctx, 2);
    var rp1 = load64(ctx + HC_RP1);
    var rp2 = load64(ctx + HC_RP2);
    if (rekha_hint_pt_ok(ctx, zn0, rp1, "IP point") == 0) { return 0 - 1; }
    if (rekha_hint_pts_ok(ctx, zn2, loop, "IP point") == 0) { return 0 - 1; }
    var twilight = 0;
    if (rekha_hint_gep(ctx, 0) == 0) { twilight = 1; }
    if (rekha_hint_gep(ctx, 1) == 0) { twilight = 1; }
    if (rekha_hint_gep(ctx, 2) == 0) { twilight = 1; }
    var obx = rekha_hint_zorus_x(zn0, rp1);
    var oby = rekha_hint_zorus_y(zn0, rp1);
    if (twilight == 1) {
        obx = rekha_hint_zorg_x(zn0, rp1);
        oby = rekha_hint_zorg_y(zn0, rp1);
    }
    var cbx = rekha_hint_zpt_x(zn0, rp1);
    var cby = rekha_hint_zpt_y(zn0, rp1);
    var old_range = 0;
    var cur_range = 0;
    var rp2ok = 0;
    if (rp2 >= 0) { if (rp2 < load64(zn1 + ZN_N)) { rp2ok = 1; } }
    if (rp2ok == 1) {
        if (twilight == 1) {
            old_range = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn1, rp2) - obx,
              rekha_hint_zorg_y(zn1, rp2) - oby);
        }
        if (twilight == 0) {
            old_range = rekha_hint_dualproj(ctx, rekha_hint_zorus_x(zn1, rp2) - obx,
              rekha_hint_zorus_y(zn1, rp2) - oby);
        }
        cur_range = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, rp2) - cbx,
          rekha_hint_zpt_y(zn1, rp2) - cby);
    }
    while (loop > 0) {
        var p = rekha_hint_pop(ctx);
        var org_dist = 0;
        if (twilight == 1) {
            org_dist = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn2, p) - obx,
              rekha_hint_zorg_y(zn2, p) - oby);
        }
        if (twilight == 0) {
            org_dist = rekha_hint_dualproj(ctx, rekha_hint_zorus_x(zn2, p) - obx,
              rekha_hint_zorus_y(zn2, p) - oby);
        }
        var cur_dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn2, p) - cbx,
          rekha_hint_zpt_y(zn2, p) - cby);
        var new_dist = 0;
        if (org_dist != 0) {
            new_dist = org_dist;
            if (old_range != 0) { new_dist = rekha_hint_muldiv(org_dist, cur_range, old_range); }
        }
        rekha_hint_move(ctx, zn2, p, new_dist - cur_dist);
        loop = loop - 1;
    }
    return 1;
}

# MSIRP[a] 0x3A-0x3B — set the distance of a point of zp1 from rp0 (zp0) to an F26Dot6 value from
# the stack, exactly: no rounding, no control value, no minimum distance
# (ref2143/ttinterp.c:5221-5266). ⚠ Into the twilight zone the point's ORIGINAL position is set
# first — rp0's original moved by the distance — and its current position made equal to it.
# rp1 becomes the old rp0, rp2 the point, and with the low bit set rp0 the point too.
fn rekha_hint_op_msirp(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var d = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var rp0 = load64(ctx + HC_RP0);
    if (rekha_hint_pt_ok(ctx, zn1, p, "MSIRP point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn0, rp0, "MSIRP point") == 0) { return 0 - 1; }
    if (rekha_hint_gep(ctx, 1) == 0) {
        store64(load64(zn1 + ZN_ORGX) + p * 8, rekha_hint_zorg_x(zn0, rp0));
        store64(load64(zn1 + ZN_ORGY) + p * 8, rekha_hint_zorg_y(zn0, rp0));
        rekha_hint_move_orig(ctx, zn1, p, d);
        store64(load64(zn1 + ZN_CURX) + p * 8, rekha_hint_zorg_x(zn1, p));
        store64(load64(zn1 + ZN_CURY) + p * 8, rekha_hint_zorg_y(zn1, p));
    }
    var dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, p) - rekha_hint_zpt_x(zn0, rp0),
      rekha_hint_zpt_y(zn1, p) - rekha_hint_zpt_y(zn0, rp0));
    rekha_hint_move(ctx, zn1, p, d - dist);
    store64(ctx + HC_RP1, rp0);
    store64(ctx + HC_RP2, p);
    if ((op & 1) != 0) { store64(ctx + HC_RP0, p); }
    return 1;
}

# ALIGNRP 0x3C — move `loop` points of zp1 onto rp0's (zp0) projection
# (ref2143/ttinterp.c:5666-5720). Consumes and resets the loop counter.
fn rekha_hint_op_alignrp(ctx): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop) == 0) { return 0 - 1; }
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var rp0 = load64(ctx + HC_RP0);
    if (rekha_hint_pt_ok(ctx, zn0, rp0, "ALIGNRP point") == 0) { return 0 - 1; }
    if (rekha_hint_pts_ok(ctx, zn1, loop, "ALIGNRP point") == 0) { return 0 - 1; }
    var rx = rekha_hint_zpt_x(zn0, rp0);
    var ry = rekha_hint_zpt_y(zn0, rp0);
    while (loop > 0) {
        var p = rekha_hint_pop(ctx);
        var d = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, p) - rx, rekha_hint_zpt_y(zn1, p) - ry);
        rekha_hint_move(ctx, zn1, p, 0 - d);
        loop = loop - 1;
    }
    return 1;
}

# MIAP[a] 0x3E-0x3F — move a point of zp0 to a control value's absolute distance along the
# projection; it becomes rp0 and rp1 (ref2143/ttinterp.c:5308-5389). With the low bit set the
# control value is dropped for the point's own projection when the two differ by MORE than the
# cut-in (strictly), and the result is rounded; without it the raw control value is used.
# ⚠ In the twilight zone the point's original AND current positions are first set to the control
# value along the freedom vector, absolutely — which is how a `prep` plants the heights its glyph
# programs will interpolate against.
fn rekha_hint_op_miap(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var ci = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 0);
    if (rekha_hint_pt_ok(ctx, zn, p, "MIAP point") == 0) { return 0 - 1; }
    if (ci < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MIAP cvt") - 1; }
    if (ci >= load64(ctx + HC_CVTCAP)) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MIAP cvt") - 1;
    }
    var dist = load64(load64(ctx + HC_CVT) + ci * 8);
    if (rekha_hint_gep(ctx, 0) == 0) {
        var ox = rekha_hint_dot14(dist, 0, load64(ctx + HC_FVX), 0);
        var oy = rekha_hint_dot14(dist, 0, load64(ctx + HC_FVY), 0);
        store64(load64(zn + ZN_ORGX) + p * 8, ox);
        store64(load64(zn + ZN_ORGY) + p * 8, oy);
        store64(load64(zn + ZN_CURX) + p * 8, ox);
        store64(load64(zn + ZN_CURY) + p * 8, oy);
    }
    var org_dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p), rekha_hint_zpt_y(zn, p));
    if ((op & 1) != 0) {
        var delta = dist - org_dist;
        if (delta < 0) { delta = 0 - delta; }
        if (delta > load64(ctx + HC_CVTCUT)) { dist = org_dist; }
        dist = rekha_hint_round(ctx, dist);
    }
    rekha_hint_move(ctx, zn, p, dist - org_dist);
    store64(ctx + HC_RP0, p);
    store64(ctx + HC_RP1, p);
    return 1;
}

# GC[a] 0x46-0x47 — push a point of zp2's coordinate: its current position along the projection
# vector, or with the low bit set its ORIGINAL position along the dual vector
# (ref2143/ttinterp.c:4318-4343).
fn rekha_hint_op_gc(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pt_ok(ctx, zn, p, "GC point") == 0) { return 0 - 1; }
    var r = 0;
    if ((op & 1) != 0) {
        r = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn, p), rekha_hint_zorg_y(zn, p));
    }
    if ((op & 1) == 0) {
        r = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p), rekha_hint_zpt_y(zn, p));
    }
    if (rekha_hint_push(ctx, r) == 0) { return 0 - 1; }
    return 1;
}

# SCFS 0x48 — move a point of zp2 so that its projection becomes the F26Dot6 value on top of the
# stack (ref2143/ttinterp.c:4356-4380). ⚠ In the twilight zone the original position follows the
# current one afterwards.
fn rekha_hint_op_scfs(ctx): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var v = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pt_ok(ctx, zn, p, "SCFS point") == 0) { return 0 - 1; }
    var k = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p), rekha_hint_zpt_y(zn, p));
    rekha_hint_move(ctx, zn, p, v - k);
    if (rekha_hint_gep(ctx, 2) == 0) {
        store64(load64(zn + ZN_ORGX) + p * 8, rekha_hint_zpt_x(zn, p));
        store64(load64(zn + ZN_ORGY) + p * 8, rekha_hint_zpt_y(zn, p));
    }
    return 1;
}

# MD[a] 0x49-0x4A — push the distance from a point of zp1 (top of the stack) to a point of zp0:
# with the low bit set between their current positions along the projection vector, without it
# between their originals along the dual vector — in font units scaled once when both are glyph
# points, else between the scaled originals (ref2143/ttinterp.c:4396-4460). ⚠ The flag reads
# inverted against the published spec; the code is what fonts were tested against.
fn rekha_hint_op_md(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var k = rekha_hint_pop(ctx);
    var l = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    if (rekha_hint_pt_ok(ctx, zn0, l, "MD point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn1, k, "MD point") == 0) { return 0 - 1; }
    var d = 0;
    if ((op & 1) != 0) {
        d = rekha_hint_project(ctx, rekha_hint_zpt_x(zn0, l) - rekha_hint_zpt_x(zn1, k),
          rekha_hint_zpt_y(zn0, l) - rekha_hint_zpt_y(zn1, k));
    }
    if ((op & 1) == 0) {
        var twilight = 0;
        if (rekha_hint_gep(ctx, 0) == 0) { twilight = 1; }
        if (rekha_hint_gep(ctx, 1) == 0) { twilight = 1; }
        if (twilight == 1) {
            d = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn0, l) - rekha_hint_zorg_x(zn1, k),
              rekha_hint_zorg_y(zn0, l) - rekha_hint_zorg_y(zn1, k));
        }
        if (twilight == 0) {
            d = rekha_hint_dualproj(ctx, rekha_hint_zorus_x(zn0, l) - rekha_hint_zorus_x(zn1, k),
              rekha_hint_zorus_y(zn0, l) - rekha_hint_zorus_y(zn1, k));
            d = rekha_hint_mulfix(d, load64(ctx + HC_SCALE));
        }
    }
    if (rekha_hint_push(ctx, d) == 0) { return 0 - 1; }
    return 1;
}

# DELTAP1/2/3 0x5D/0x71/0x72 — n, then n pairs of (exception spec, point index) with the point on
# top of each pair: at exactly one ppem per pair, move the point of zp0 by the spec's magnitude
# in units of 1/(2^delta_shift) pixels along the freedom vector (ref2143/ttinterp.c:6293-6386).
# The spec byte's high nibble plus the delta base (plus 16 for P2, 32 for P3) is the ppem it
# applies at; its low nibble runs -8..-1, 1..8. ⚠ The pairs are popped before the ppem is looked
# at, and OUTSIDE THIS SIZE'S BAND NO POINT INDEX IS CHECKED — FreeType's behaviour in both its
# modes, so a stale exception for a point the glyph lacks is not a refusal at sizes it never
# applies to. Inside the band it is. Does not read or reset the loop counter.
fn rekha_hint_op_deltap(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var n = rekha_hint_pop(ctx);
    if (n < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAP count") - 1; }
    if (rekha_hint_need(ctx, n * 2) == 0) { return 0 - 1; }
    var band = load64(ctx + HC_PPEM) - load64(ctx + HC_DBASE);
    if (op == 0x71) { band = band - 16; }
    if (op == 0x72) { band = band - 32; }
    if (band < 0)  { store64(ctx + HC_SP, load64(ctx + HC_SP) - n * 2); return 1; }
    if (band > 15) { store64(ctx + HC_SP, load64(ctx + HC_SP) - n * 2); return 1; }
    var zn = rekha_hint_zp(ctx, 0);
    # every point of every pair is checked before the first moves
    var sp = load64(ctx + HC_SP);
    var st = load64(ctx + HC_STACK);
    var k = 0;
    while (k < n) {
        if (rekha_hint_pt_ok(ctx, zn, load64(st + (sp - 1 - k * 2) * 8), "DELTAP point") == 0) {
            return 0 - 1;
        }
        k = k + 1;
    }
    var shift = load64(ctx + HC_DSHIFT);
    k = 0;
    while (k < n) {
        var p = rekha_hint_pop(ctx);
        var spec = rekha_hint_pop(ctx);
        if ((spec & 0xF0) == (band << 4)) {
            var mag = (spec & 15) - 8;
            if (mag >= 0) { mag = mag + 1; }
            rekha_hint_move(ctx, zn, p, sd_asr(mag * 64, shift));
        }
        k = k + 1;
    }
    return 1;
}

# FLIPPT 0x80 — toggle the on-curve bit of `loop` points (ref2143/ttinterp.c:4802-4849).
# ⛔ ON THE GLYPH ZONE WHATEVER THE ZONE POINTERS SAY, like FLIPRGON and FLIPRGOFF: FreeType reads
# `pts`, never zp0..2. Consumes and resets the loop counter.
fn rekha_hint_op_flippt(ctx): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop) == 0) { return 0 - 1; }
    var zn = rekha_hint_zone(ctx, 1);
    if (rekha_hint_pts_ok(ctx, zn, loop, "FLIPPT point") == 0) { return 0 - 1; }
    while (loop > 0) {
        var tg = load64(zn + ZN_TAGS) + rekha_hint_pop(ctx);
        store8(tg, load8(tg) ^ REKHA_TAG_ONCURVE);
        loop = loop - 1;
    }
    return 1;
}

# FLIPRGON 0x81 / FLIPRGOFF 0x82 — set or clear the on-curve bit of every glyph-zone point from
# the lower index (below) to the higher (on top), inclusive; a reversed range is empty
# (ref2143/ttinterp.c:4852-4919).
fn rekha_hint_op_fliprg(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var hi = rekha_hint_pop(ctx);
    var lo = rekha_hint_pop(ctx);
    var zn = rekha_hint_zone(ctx, 1);
    var nm = "FLIPRGON point";
    if (op == 0x82) { nm = "FLIPRGOFF point"; }
    if (rekha_hint_pt_ok(ctx, zn, hi, nm) == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn, lo, nm) == 0) { return 0 - 1; }
    var tags = load64(zn + ZN_TAGS);
    var i = lo;
    while (i <= hi) {
        if (op == 0x81) { store8(tags + i, load8(tags + i) | REKHA_TAG_ONCURVE); }
        if (op == 0x82) { store8(tags + i, load8(tags + i) & (0xFF - REKHA_TAG_ONCURVE)); }
        i = i + 1;
    }
    return 1;
}

# The original distance of MDRP and MD[0]: font units scaled once when both points are glyph
# points, the scaled originals when either is a twilight point (ref2143/ttinterp.c:5419-5450).
fn rekha_hint_org_dist(ctx, zn1, p, zn0, rp0): i64 {
    var twilight = 0;
    if (rekha_hint_gep(ctx, 0) == 0) { twilight = 1; }
    if (rekha_hint_gep(ctx, 1) == 0) { twilight = 1; }
    if (twilight == 1) {
        return rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn1, p) - rekha_hint_zorg_x(zn0, rp0),
          rekha_hint_zorg_y(zn1, p) - rekha_hint_zorg_y(zn0, rp0));
    }
    var d = rekha_hint_dualproj(ctx, rekha_hint_zorus_x(zn1, p) - rekha_hint_zorus_x(zn0, rp0),
      rekha_hint_zorus_y(zn1, p) - rekha_hint_zorus_y(zn0, rp0));
    return rekha_hint_mulfix(d, load64(ctx + HC_SCALE));
}

# The minimum-distance clamp of MDRP and MIRP: the distance may not fall short of the minimum in
# the direction the original distance points (a zero original counts as positive).
fn rekha_hint_min_dist(ctx, d, org_dist): i64 {
    var md = load64(ctx + HC_MINDIST);
    if (org_dist >= 0) {
        if (d < md) { return md; }
        return d;
    }
    if (d > (0 - md)) { return 0 - md; }
    return d;
}

# MDRP[abcde] 0xC0-0xDF — move a point of zp1 to its original distance from rp0 (zp0), through
# the single-width cut-in, the round bit (bit 2) and the minimum-distance bit (bit 3)
# (ref2143/ttinterp.c:5392-5510). Bits 0-1 name an engine compensation, all of which are 0. rp1
# becomes the old rp0, rp2 the point, and with bit 4 rp0 the point too. No control value, no
# control-value cut-in, no auto-flip, no twilight write.
fn rekha_hint_op_mdrp(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var p = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var rp0 = load64(ctx + HC_RP0);
    if (rekha_hint_pt_ok(ctx, zn1, p, "MDRP point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn0, rp0, "MDRP point") == 0) { return 0 - 1; }
    var org_dist = rekha_hint_org_dist(ctx, zn1, p, zn0, rp0);
    # single width: |org_dist - value| < cut-in, both strict, and only with a cut-in above 0.
    # ⚠ The sign is decided ONCE, on the ORIGINAL distance (ref2143/ttinterp.c:5464-5467, an
    # if/else): SSW takes any operand, so the single width can be negative, and a second test on
    # the value just written would flip a negative width back to positive.
    var swc = load64(ctx + HC_SWCUT);
    var swv = load64(ctx + HC_SWVAL);
    if (swc > 0) {
        if (org_dist < swv + swc) {
            if (org_dist > swv - swc) {
                var neg = 0;
                if (org_dist < 0) { neg = 1; }
                org_dist = swv;
                if (neg == 1) { org_dist = 0 - swv; }
            }
        }
    }
    var d = org_dist;
    if ((op & 4) != 0) { d = rekha_hint_round(ctx, org_dist); }
    if ((op & 8) != 0) { d = rekha_hint_min_dist(ctx, d, org_dist); }
    var cur_dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, p) - rekha_hint_zpt_x(zn0, rp0),
      rekha_hint_zpt_y(zn1, p) - rekha_hint_zpt_y(zn0, rp0));
    rekha_hint_move(ctx, zn1, p, d - cur_dist);
    store64(ctx + HC_RP1, rp0);
    store64(ctx + HC_RP2, p);
    if ((op & 16) != 0) { store64(ctx + HC_RP0, p); }
    return 1;
}

# MIRP[abcde] 0xE0-0xFF — move a point of zp1 to a control value's distance from rp0 (zp0),
# through the single-width cut-in on the control value, auto-flip, the control-value cut-in
# (only under the round bit, and only when both points are in the same zone), the round bit and
# the minimum-distance bit (ref2143/ttinterp.c:5513-5663). ⚠ Control value index -1 is legal and
# reads a distance of 0. In the twilight zone the point's original AND current positions are first
# set to rp0's original plus the control value along the freedom vector. The original distance
# here is ALWAYS between the scaled originals — never font units, unlike MDRP's. rp updates as
# MDRP's.
fn rekha_hint_op_mirp(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var ci = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var rp0 = load64(ctx + HC_RP0);
    if (rekha_hint_pt_ok(ctx, zn1, p, "MIRP point") == 0) { return 0 - 1; }
    if (ci < (0 - 1)) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MIRP cvt") - 1; }
    if (ci >= load64(ctx + HC_CVTCAP)) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MIRP cvt") - 1;
    }
    if (rekha_hint_pt_ok(ctx, zn0, rp0, "MIRP point") == 0) { return 0 - 1; }
    var cvt_dist = 0;
    if (ci >= 0) { cvt_dist = load64(load64(ctx + HC_CVT) + ci * 8); }
    # single width: |cvt_dist - value| < cut-in, strict; a cut-in of 0 never fires. The sign is
    # decided once, on the control value as it was (ref2143/ttinterp.c:5562-5565, an if/else) —
    # see MDRP for why a second test on the written value is wrong when the width is negative.
    var swv = load64(ctx + HC_SWVAL);
    var delta = cvt_dist - swv;
    if (delta < 0) { delta = 0 - delta; }
    if (delta < load64(ctx + HC_SWCUT)) {
        var neg = 0;
        if (cvt_dist < 0) { neg = 1; }
        cvt_dist = swv;
        if (neg == 1) { cvt_dist = 0 - swv; }
    }
    if (rekha_hint_gep(ctx, 1) == 0) {
        var ox = rekha_hint_zorg_x(zn0, rp0) + rekha_hint_dot14(cvt_dist, 0, load64(ctx + HC_FVX), 0);
        var oy = rekha_hint_zorg_y(zn0, rp0) + rekha_hint_dot14(cvt_dist, 0, load64(ctx + HC_FVY), 0);
        store64(load64(zn1 + ZN_ORGX) + p * 8, ox);
        store64(load64(zn1 + ZN_ORGY) + p * 8, oy);
        store64(load64(zn1 + ZN_CURX) + p * 8, ox);
        store64(load64(zn1 + ZN_CURY) + p * 8, oy);
    }
    var org_dist = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn1, p) - rekha_hint_zorg_x(zn0, rp0),
      rekha_hint_zorg_y(zn1, p) - rekha_hint_zorg_y(zn0, rp0));
    var cur_dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, p) - rekha_hint_zpt_x(zn0, rp0),
      rekha_hint_zpt_y(zn1, p) - rekha_hint_zpt_y(zn0, rp0));
    # auto-flip: a control value whose sign disagrees with the original distance is negated
    if (load64(ctx + HC_AUTOFLIP) != 0) {
        if ((org_dist ^ cvt_dist) < 0) { cvt_dist = 0 - cvt_dist; }
    }
    var d = cvt_dist;
    if ((op & 4) != 0) {
        if (rekha_hint_gep(ctx, 0) == rekha_hint_gep(ctx, 1)) {
            var cut = cvt_dist - org_dist;
            if (cut < 0) { cut = 0 - cut; }
            if (cut > load64(ctx + HC_CVTCUT)) { cvt_dist = org_dist; }
        }
        d = rekha_hint_round(ctx, cvt_dist);
    }
    if ((op & 8) != 0) { d = rekha_hint_min_dist(ctx, d, org_dist); }
    rekha_hint_move(ctx, zn1, p, d - cur_dist);
    store64(ctx + HC_RP1, rp0);
    store64(ctx + HC_RP2, p);
    if ((op & 16) != 0) { store64(ctx + HC_RP0, p); }
    return 1;
}

# The name of an instruction rekha knows and has not implemented, or 0 when the opcode is not one.
# ⛔ WHAT IS LEFT IS IUP, AND IUP ALONE: interpolating the untouched points of a contour between
# its touched ones needs the outline the glyph loader puts into zone 1, which is 0.8.2's, booked in
# docs/development/roadmap.md. It is named rather than skipped: skipping leaves the stack at a
# depth the next instruction is not written for — IUP pops nothing, but the rule is the rule — and
# a consumer testing for REKHA_ERR_UNSUPPORTED is asking "will this font ever hint here".
fn rekha_hint_point_op(op): i64 {
    if (op == 0x30) { return "IUP"; }
    if (op == 0x31) { return "IUP"; }
    return 0;
}

# An instruction the font defined for itself, as [start, end, buffer], or 0.
fn rekha_hint_find_idef(ctx, op): i64 {
    var n = load64(ctx + HC_IDEFN);
    var at = load64(ctx + HC_IDEF);
    var i = 0;
    while (i < n) {
        if (load64(at + i * 32) == op) { return at + i * 32 + 8; }
        i = i + 1;
    }
    return 0;
}

# Push `n` operands of `w` bytes each, starting at `at`. The two-byte form is SIGNED.
fn rekha_hint_do_push(ctx, buf, at, n, w): i64 {
    var i = 0;
    while (i < n) {
        var v = load8(buf + at + i);
        if (w == 2) { v = rekha_rd_i16(buf, at + i * 2); }
        if (rekha_hint_push(ctx, v) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# The executor. One program, from `ip` to `end`, both absolute offsets into `buf`.
# Answers 1 when the program ran to its end or hit an ENDF, 0 when it refused — and every 0 has a
# code and a detail on the context.
# ⚠ A CALL RECURSES HERE rather than pushing a return frame, which is how src/cff.cyr runs a subr
# and for the same reason: the nesting is the language's, the cap is rekha's.
# ================================================================
fn rekha_hint_exec(ctx, buf, ip, end): i64 {
    if (load64(ctx + HC_DEPTH) > REKHA_HINT_MAXDEPTH) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "call depth");
    }
    var base = ip;
    while (ip < end) {
        var bud = load64(ctx + HC_BUDGET);
        if (bud <= 0) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "instruction budget");
        }
        store64(ctx + HC_BUDGET, bud - 1);
        var op = load8(buf + ip);
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return rekha_hint_fail(ctx, REKHA_ERR_TRUNCATED, "push operands"); }
        if (ip + ln > end) { return rekha_hint_fail(ctx, REKHA_ERR_TRUNCATED, "instruction"); }
        var nip = ip + ln;
        var r = 0;
        # ── the eighteen push opcodes ──
        if (op == 0x40) {
            if (rekha_hint_do_push(ctx, buf, ip + 2, load8(buf + ip + 1), 1) == 0) { return 0; }
            r = 1;
        }
        if (op == 0x41) {
            if (rekha_hint_do_push(ctx, buf, ip + 2, load8(buf + ip + 1), 2) == 0) { return 0; }
            r = 1;
        }
        if (r == 0) {
            if (op >= 0xB0) {
                if (op <= 0xB7) {
                    if (rekha_hint_do_push(ctx, buf, ip + 1, op - 0xB0 + 1, 1) == 0) { return 0; }
                    r = 1;
                }
            }
        }
        if (r == 0) {
            if (op >= 0xB8) {
                if (op <= 0xBF) {
                    if (rekha_hint_do_push(ctx, buf, ip + 1, op - 0xB8 + 1, 2) == 0) { return 0; }
                    r = 1;
                }
            }
        }
        # ── IF / ELSE / EIF ──
        if (op == 0x58) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            if (rekha_hint_pop(ctx) == 0) {
                nip = rekha_hint_skip_if(buf, nip, end, 1);
                if (nip < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IF without EIF"); }
            }
            r = 1;
        }
        # An ELSE reached by execution means the THEN branch was taken and is over.
        if (op == 0x1B) {
            nip = rekha_hint_skip_if(buf, nip, end, 0);
            if (nip < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "ELSE without EIF"); }
            r = 1;
        }
        if (op == 0x59) { r = 1; }
        # ── the three jumps. ⛔ THE OFFSET IS RELATIVE TO THE JUMP INSTRUCTION ITSELF, not to the
        #    byte after it, so `JMPR 0` is an infinite loop and the instruction budget is what
        #    stops it. Both conditional forms take the CONDITION on top and the offset below. ──
        if (op == 0x1C) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            nip = ip + rekha_hint_pop(ctx);
            r = 1;
        }
        if (op == 0x78) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var c1 = rekha_hint_pop(ctx);
            var o1 = rekha_hint_pop(ctx);
            if (c1 != 0) { nip = ip + o1; }
            r = 1;
        }
        if (op == 0x79) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var c2 = rekha_hint_pop(ctx);
            var o2 = rekha_hint_pop(ctx);
            if (c2 == 0) { nip = ip + o2; }
            r = 1;
        }
        # ⚠ WHERE A JUMP MAY LAND. At the TOP LEVEL a target past the end of the program ENDS IT,
        # normally: FreeType's main loop treats an instruction pointer at or beyond the code size
        # with an empty call stack as the program being over (ref2143/ttinterp.c:7391-7401), and
        # Ins_JMPR itself refuses only a negative target there (:3204-3210). Inside a function the
        # target may not pass the function's end (the same lines refuse it), and rekha ALSO refuses
        # a target before the function's start — FreeType accepts one and runs whatever bytes
        # precede the body, which no font means; that refusal is a stated pin.
        if (r == 1) {
            if (nip < base) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "jump out of range"); }
            if (nip > end) {
                if (load64(ctx + HC_DEPTH) != 0) {
                    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "jump out of range");
                }
                nip = end;
            }
        }
        # ── FDEF / IDEF: the body is SCANNED, never executed, which is why a font program made
        #    entirely of function definitions runs on an interpreter with no points. ──
        if (op == 0x2C) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            var fn1 = rekha_hint_pop(ctx);
            # ⛔ THE NUMBER MAY BE ANYTHING IN 0..0xFFFF, AND THE TABLE IS A LIST (ref2143/ttinterp.c
            # :3284-3309): a number already defined is REDEFINED IN PLACE — some font programs do
            # that — and only a new one takes a record, so the refusal is on the COUNT of distinct
            # functions reaching maxFunctionDefs (floored at 64, see rekha_hint_ctx_new), never on
            # the number itself. FreeType casts the operand unsigned and refuses above 0xFFFF; a
            # negative one is the same refusal here.
            if (fn1 < 0)      { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF number"); }
            if (fn1 > 0xFFFF) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF number"); }
            var e1 = rekha_hint_scan_endf(buf, nip, end);
            if (e1 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF without ENDF"); }
            var fslot = rekha_hint_find_fdef(ctx, fn1);
            if (fslot == 0) {
                var nf = load64(ctx + HC_FDEFN);
                if (nf >= load64(ctx + HC_FDEFCAP)) {
                    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF over maxFunctionDefs");
                }
                fslot = load64(ctx + HC_FDEF) + nf * 32;
                store64(ctx + HC_FDEFN, nf + 1);
            }
            store64(fslot, fn1);
            store64(fslot + 8, nip);
            store64(fslot + 16, e1);
            store64(fslot + 24, buf);
            nip = e1 + 1;
            r = 1;
        }
        if (op == 0x89) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            var oc = rekha_hint_pop(ctx);
            # ⛔ THE OPCODE MUST BE A BYTE. An operand outside 0..255 is a refusal, not masked:
            # FreeType raises Too_Many_Instruction_Defs for it in both modes
            # (ref2143/ttinterp.c:3590-3595), so `PUSHW 0x100 IDEF` is unhintable there and must
            # not quietly define opcode 0 here.
            if (oc < 0)    { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF opcode"); }
            if (oc > 0xFF) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF opcode"); }
            # ⚠ An opcode already defined is REDEFINED IN PLACE, and only a new one takes a slot
            # (ref2143/ttinterp.c:3571-3588): a `prep` that defines an instruction runs once per
            # size, and appending each time would fill maxInstructionDefs on the second size.
            var e2 = rekha_hint_scan_endf(buf, nip, end);
            if (e2 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF without ENDF"); }
            var ni = load64(ctx + HC_IDEFN);
            var slot = rekha_hint_find_idef(ctx, oc);
            if (slot != 0) { slot = slot - 8; }
            if (slot == 0) {
                if (ni >= load64(ctx + HC_IDEFCAP)) {
                    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF over maxInstructionDefs");
                }
                slot = load64(ctx + HC_IDEF) + ni * 32;
                store64(ctx + HC_IDEFN, ni + 1);
            }
            store64(slot, oc);
            store64(slot + 8, nip);
            store64(slot + 16, e2);
            store64(slot + 24, buf);
            nip = e2 + 1;
            r = 1;
        }
        # ── ENDF ends this call. At the top level of a program there is nothing to end. ──
        if (op == 0x2D) {
            if (load64(ctx + HC_DEPTH) == 0) {
                return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "ENDF outside a function");
            }
            return 1;
        }
        # ── CALL and LOOPCALL. ⭐ The FUNCTION is on top in both; LOOPCALL's count is below it,
        #    which real bytecode settled (see the header). ──
        if (op == 0x2B) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            if (rekha_hint_call(ctx, rekha_hint_pop(ctx), 1) == 0) { return 0; }
            r = 1;
        }
        if (op == 0x2A) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var lf = rekha_hint_pop(ctx);
            var lc = rekha_hint_pop(ctx);
            if (rekha_hint_call(ctx, lf, lc) == 0) { return 0; }
            r = 1;
        }
        # ── GETVARIATION / GETDATA, only while the face's axes are live; on a static face the two
        #    opcodes fall through to the font's own IDEF or to the undefined-opcode refusal, which
        #    is FreeType's routing (ref2143/ttinterp.c:7306-7324). See rekha_hint_op_getvariation
        #    for what "live" means here against what it means there. ──
        if (op == 0x91) {
            if (rekha_var_live(load64(ctx + HC_FONT)) != 0) {
                if (rekha_hint_op_getvariation(ctx) < 0) { return 0; }
                r = 1;
            }
        }
        if (op == 0x92) {
            if (rekha_var_live(load64(ctx + HC_FONT)) != 0) {
                if (rekha_hint_op_getdata(ctx) < 0) { return 0; }
                r = 1;
            }
        }
        # ── everything else, in four groups ──
        if (r == 0) {
            var h = rekha_hint_op_alu(ctx, op);
            if (h < 0) { return 0; }
            if (h > 0) { r = 1; }
        }
        if (r == 0) {
            var h2 = rekha_hint_op_gs(ctx, op);
            if (h2 < 0) { return 0; }
            if (h2 > 0) { r = 1; }
        }
        if (r == 0) {
            var h3 = rekha_hint_op_point(ctx, op);
            if (h3 < 0) { return 0; }
            if (h3 > 0) { r = 1; }
        }
        if (r == 0) {
            var nm = rekha_hint_point_op(op);
            if (nm != 0) { return rekha_hint_fail(ctx, REKHA_ERR_UNSUPPORTED, nm); }
            # An opcode the font defined for itself is the last thing it can be.
            var d = rekha_hint_find_idef(ctx, op);
            if (d == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "undefined opcode"); }
            store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) + 1);
            var ok = rekha_hint_exec(ctx, load64(d + 16), load64(d), load64(d + 8));
            store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) - 1);
            if (ok == 0) { return 0; }
        }
        ip = nip;
    }
    return 1;
}

# Run function `f` `count` times. ⚠ Each repetition costs a unit of the instruction budget on top
# of the body's own, so a LOOPCALL handed a hostile count is stopped by the same guard a JMPR loop
# is, and not by a separate cap that would have to be kept in step with it.
fn rekha_hint_call(ctx, f, count): i64 {
    # The number is LOOKED UP, not used as an index (ref2143/ttinterp.c:3404-3435 and the same in
    # Ins_LOOPCALL): a number no program defined — negative, past 0xFFFF or simply never seen — is
    # one refusal, FreeType's Invalid_Reference.
    var at = rekha_hint_find_fdef(ctx, f);
    if (at == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "undefined function"); }
    var start = load64(at + 8);
    var stop = load64(at + 16);
    # ⛔ THE BODY'S OWN BUFFER, NOT THE CALLER'S. A function defined by `fpgm` is a range into the
    # font bytes; one defined by any other program is a range into that program. Running a body
    # against whichever buffer happens to be executing reads whatever lies at those offsets and
    # calls it bytecode — found by programs/hint_test.cyr's CALL check, which got the untouched
    # operand back instead of the sum.
    var bbuf = load64(at + 24);
    var i = 0;
    while (i < count) {
        var bud = load64(ctx + HC_BUDGET);
        if (bud <= 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "instruction budget"); }
        store64(ctx + HC_BUDGET, bud - 1);
        store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) + 1);
        var ok = rekha_hint_exec(ctx, bbuf, start, stop);
        store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) - 1);
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# @public — run `len` bytes of bytecode at `off` in `buf`. 1 when it ran, 0 when it refused, with
# `rekha_hint_error` saying why. This is how a test drives one instruction at a time; the font
# program and `prep` go through the same executor with their own code range (rekha_hint_run_fpgm,
# rekha_hint_run_prep). A program run this way is a GLYPH-RANGE program to two of the four
# instructions that ask: INSTCTRL does nothing and GETINFO reports grayscale on.
# ⚠ IN THE OTHER TWO WAYS IT IS NOT FreeType's GLYPH RANGE, and both are 0.8.2's glyph call's,
# booked in docs/development/roadmap.md: there FDEF and IDEF are refused in a glyph program
# (DEF_In_Glyf_Bytecode, ref2143/ttinterp.c:3275-3279, 3564-3568) where this range accepts them —
# programs/hint_test.cyr's own programs define functions — and a glyph program's WS / WCVTP /
# DELTAC write a PER-GLYPH COPY of the storage area and the control values that the next glyph
# never sees (ref2143/ttinterp.c:1320-1337, 2777-2795), WCVTF alone writing wherever the pointer
# stands (:2832-2846); here every write persists into the next run.
# ⚠ THE BYTES ARE BORROWED. They must outlive the call, and a function defined by a program is
# recorded as a RANGE INTO THEM together with the buffer itself — so a program that defines one
# must live as long as the context, and a CALL runs the body against the buffer that DEFINED it
# rather than against the one that is executing.
# ⚠ Each call resets the instruction budget and the call depth; it does NOT reset the stack, the
# storage area, the control values, the zones or the graphics state, because a program run here
# is entitled to see what the one before it left (which is the second difference above).
fn rekha_hint_run(ctx, buf, off, len): i64 {
    if (ctx == 0) { return 0; }
    return rekha_hint_run_range(ctx, buf, off, len, 3);
}

# The executor's entry for all three code ranges: 1 `fpgm`, 2 `prep`, 3 a program. HC_RANGE holds
# the range for the run and is 0 again afterwards.
fn rekha_hint_run_range(ctx, buf, off, len, range): i64 {
    rekha_hint_error_clear(ctx);
    if (buf == 0) { return rekha_hint_fail(ctx, REKHA_ERR_OTHER, "program"); }
    if (len < 0) { return rekha_hint_fail(ctx, REKHA_ERR_OTHER, "program"); }
    if (len == 0) { return 1; }
    store64(ctx + HC_BUDGET, REKHA_HINT_BUDGET);
    store64(ctx + HC_DEPTH, 0);
    store64(ctx + HC_RANGE, range);
    var ok = rekha_hint_exec(ctx, buf, off, off + len);
    store64(ctx + HC_RANGE, 0);
    return ok;
}

# How many twilight points a run may address. ⚠ FreeType caps the zone per run at
# max(30, 2 * (glyph points + control values)) as a guard against malformed bytecode
# (ref2143/ttinterp.c:7449-7462), and never at fewer than the font declared plus four; rekha caps
# at the font's own maxTwilightPoints, without the four, so the bound is the smaller of the two.
# rekha_hint_zone_clear still clears them all. `rekha_hint_zone_points(ctx, 0)` answers the bound.
fn rekha_hint_twilight_bound(ctx): i64 {
    var tz = load64(load64(ctx + HC_FONT) + 800);
    var n = 2 * (load64(ctx + HC_ZONE1 + ZN_N) + load64(ctx + HC_CVTCAP));
    if (n < 30) { n = 30; }
    if (n > tz) { n = tz; }
    store64(ctx + HC_ZONE0 + ZN_N, n);
    return n;
}

# @public — run the font program. Called for you by `rekha_hint_ctx` on the first build and never
# again: `fpgm` defines functions, and a function is a range into font bytes that does not move
# with size. ⚠ It resets the graphics state first and marks the face done EVEN IF IT REFUSES, so a
# broken `fpgm` is reported once rather than re-run at every size — and its refusal is kept as
# the face's standing refusal, which every `rekha_hint_ctx` and `rekha_hint_run_prep` re-raises
# without running anything, the way FreeType fails every later load with `bytecode_ready`.
fn rekha_hint_run_fpgm(ctx): i64 {
    if (ctx == 0) { return 0; }
    var font = load64(ctx + HC_FONT);
    rekha_hint_reset(ctx);
    rekha_hint_twilight_bound(ctx);
    store64(ctx + HC_FPGMOK, 1);
    store64(ctx + HC_FPGMERR, REKHA_OK);
    store64(ctx + HC_FPGMDET, 0);
    var n = load64(font + 712);
    if (n <= 0) {
        rekha_hint_error_clear(ctx);
        return 1;
    }
    var ok = rekha_hint_run_range(ctx, load64(ctx + HC_BUF), load64(font + 704), n, 1);
    if (ok == 0) {
        store64(ctx + HC_FPGMERR, load64(ctx + HC_ERR));
        store64(ctx + HC_FPGMDET, load64(ctx + HC_DETAIL));
    }
    return ok;
}

# @public — the whole per-size entry: rebuild the size's state and run the control-value program
# on it. 1 when `prep` ran (an absent or empty `prep` counts as ran), 0 when it refused or when the
# font program's standing refusal is re-raised instead, without running. Called for you by
# `rekha_hint_ctx` on every size change; calling it again is idempotent — same control values,
# same storage, same twilight zone, same graphics state — because it rebuilds first. It is
# FreeType's `cvt_ready < 0` path (ref2143/ttobjs.c:940-1003), in the same order:
#   the control values re-scaled FROM THE FONT at this ppem; the graphics state to its defaults
#   and the stack emptied; the twilight zone back to the origin, untouched; the storage area
#   CLEARED; the glyph zone invalidated, since its points were scaled at the old size; then
#   `prep`, with the glyph zone empty.
# The function table and the instruction table are the one thing a re-run keeps.
# ⛔ AFTERWARDS THE GRAPHICS STATE IS THE DEFAULTS PLUS THE TEN FIELDS `prep` MAY LEAVE — minimum
# distance, the two cut-ins, the single width, delta base and shift, auto-flip, INSTCTRL,
# SCANCTRL, SCANTYPE (ref2143/ttinterp.c:323-341): the vectors, the reference points, the zone
# pointers, the loop counter and the rounding state a `prep` set are discarded, and whatever it
# left on the stack with them. So `rekha_hint_gs` after `rekha_hint_ctx` shows what a glyph program
# starts from. A REFUSED `prep` leaves pure defaults (ref2143/ttobjs.c:997-1000).
# ⚠ Three things FreeType does that rekha does not, all stated in the CHANGELOG: it zeroes the
# twilight zone's positions only, never its tags — rekha zeroes both, visible only through
# `rekha_hint_point`; a face whose `prep` is ABSENT OR EMPTY inherits a stale graphics state there
# (ref2143/ttobjs.c:994-1000 saves ten fields no run refreshed) — rekha gives the defaults; and
# INSTCTRL's bits 1 and 2, which disable the glyph programs or start each from ALL defaults, are
# applied by 0.8.2's glyph call, not here.
fn rekha_hint_run_prep(ctx): i64 {
    if (ctx == 0) { return 0; }
    var font = load64(ctx + HC_FONT);
    store64(ctx + HC_PREPERR, REKHA_OK);
    store64(ctx + HC_PREPDET, 0);
    if (load64(ctx + HC_FPGMERR) != REKHA_OK) {
        return rekha_hint_fail(ctx, load64(ctx + HC_FPGMERR), load64(ctx + HC_FPGMDET));
    }
    rekha_hint_scale_cvt(ctx);
    rekha_hint_reset(ctx);
    rekha_hint_zone_clear(ctx + HC_ZONE0, load64(font + 800));
    var sto = load64(ctx + HC_STORECAP);
    var i = 0;
    while (i < sto) { store64(load64(ctx + HC_STORE) + i * 8, 0); i = i + 1; }
    store64(ctx + HC_ZONE1 + ZN_N, 0);
    store64(ctx + HC_ZONE1 + ZN_NC, 0);
    store64(ctx + HC_GZGID, 0 - 1);
    rekha_hint_twilight_bound(ctx);
    var n = load64(font + 728);
    var ok = 1;
    if (n > 0) { ok = rekha_hint_run_range(ctx, load64(ctx + HC_BUF), load64(font + 720), n, 2); }
    if (n <= 0) { rekha_hint_error_clear(ctx); }
    if (ok == 0) {
        store64(ctx + HC_PREPERR, load64(ctx + HC_ERR));
        store64(ctx + HC_PREPDET, load64(ctx + HC_DETAIL));
        rekha_hint_reset(ctx);
        return 0;
    }
    # keep the ten, reset the rest — HC_MINDIST through HC_SCANTYPE are contiguous
    var keep: i64[10];
    var k = 0;
    while (k < 10) { store64(&keep + k * 8, load64(ctx + HC_MINDIST + k * 8)); k = k + 1; }
    rekha_hint_reset(ctx);
    k = 0;
    while (k < 10) { store64(ctx + HC_MINDIST + k * 8, load64(&keep + k * 8)); k = k + 1; }
    return 1;
}

# ================================================================
# Reading the graphics state.
# ⭐ ONE ACCESSOR, NOT TWENTY-SEVEN. The fields are laid out in this exact order from HC_PVX, so an
# index IS the offset, and a surface about to be frozen at 0.9.0 gains one name instead of a
# getter per field. ⚠ The bytecode can read four of these itself (GPV, GFV, and MPPEM / MPS for
# the size); the other twenty-three are write-only from inside a program, which is why a consumer
# — or a test — that wants to see what `prep` decided needs this.
# ================================================================
var REKHA_GS_PVX        = 0;    # projection vector, F2Dot14
var REKHA_GS_PVY        = 1;
var REKHA_GS_FVX        = 2;    # freedom vector
var REKHA_GS_FVY        = 3;
var REKHA_GS_DVX        = 4;    # dual projection vector
var REKHA_GS_DVY        = 5;
var REKHA_GS_RP0        = 6;    # the three reference points
var REKHA_GS_RP1        = 7;
var REKHA_GS_RP2        = 8;
var REKHA_GS_ZP0        = 9;    # the three zone pointers: 0 twilight, 1 glyph
var REKHA_GS_ZP1        = 10;
var REKHA_GS_ZP2        = 11;
var REKHA_GS_LOOP       = 12;
var REKHA_GS_ROUND      = 13;   # one of the REKHA_RND_* states
var REKHA_GS_PERIOD     = 14;   # SROUND's decomposition, all three F26Dot6
var REKHA_GS_PHASE      = 15;
var REKHA_GS_THRESHOLD  = 16;
var REKHA_GS_MINDIST    = 17;   # F26Dot6
var REKHA_GS_CVTCUTIN   = 18;   # F26Dot6
var REKHA_GS_SWCUTIN    = 19;   # F26Dot6
var REKHA_GS_SWVALUE    = 20;   # F26Dot6, scaled from font units by SSW
var REKHA_GS_AUTOFLIP   = 21;
var REKHA_GS_DELTABASE  = 22;   # unsigned 16-bit, as SDB stores it (FreeType's FT_UShort delta_base)
var REKHA_GS_DELTASHIFT = 23;
var REKHA_GS_INSTCTRL   = 24;
var REKHA_GS_SCANCTRL   = 25;
var REKHA_GS_SCANTYPE   = 26;
var REKHA_GS_COUNT      = 27;

# @public — one graphics-state field by its REKHA_GS_* index. 0 for a null context or an index
# outside the set, which is also a legal value for most of them.
fn rekha_hint_gs(ctx, field): i64 {
    if (ctx == 0) { return 0; }
    if (field < 0) { return 0; }
    if (field >= REKHA_GS_COUNT) { return 0; }
    return load64(ctx + HC_PVX + field * 8);
}

# ================================================================
# Reading the zones.
# ⭐ ONE ACCESSOR AGAIN, in the rekha_hint_gs shape: a zone (0 twilight, 1 glyph), a point, and a
# REKHA_PT_* field. Nothing inside a program can read a twilight point's tags or a point's
# font-unit position back, and a consumer — or programs/hint_test.cyr — that wants to see what
# `prep` planted in the twilight zone, or where a program left a point, needs this.
# ================================================================

# @public — one field of point `i` of zone `zone`. 0 for a null context, a zone other than 0 or
# 1, a point the zone does not have, or a field outside REKHA_PT_*; 0 is also a legal value for
# every field. The glyph zone holds no points until 0.8.2 loads a glyph into it.
fn rekha_hint_point(ctx, zone, i, field): i64 {
    if (ctx == 0) { return 0; }
    if (zone < 0) { return 0; }
    if (zone > 1) { return 0; }
    if (field < 0) { return 0; }
    if (field >= REKHA_PT_COUNT) { return 0; }
    var zn = rekha_hint_zone(ctx, zone);
    if (i < 0) { return 0; }
    if (i >= load64(zn + ZN_N)) { return 0; }
    if (field == REKHA_PT_TAGS) { return load8(load64(zn + ZN_TAGS) + i); }
    return load64(load64(zn + ZN_ORUSX + field * 8) + i * 8);
}

# @public — how many points a zone holds, and how many contours. For the twilight zone the point
# count is the per-run bound (see rekha_hint_twilight_bound) and the contour count 0; for the
# glyph zone both are 0 until a glyph is loaded, phantom points included when one is.
fn rekha_hint_zone_points(ctx, zone): i64 {
    if (ctx == 0) { return 0; }
    if (zone < 0) { return 0; }
    if (zone > 1) { return 0; }
    return load64(rekha_hint_zone(ctx, zone) + ZN_N);
}

fn rekha_hint_zone_contours(ctx, zone): i64 {
    if (ctx == 0) { return 0; }
    if (zone < 0) { return 0; }
    if (zone > 1) { return 0; }
    return load64(rekha_hint_zone(ctx, zone) + ZN_NC);
}
