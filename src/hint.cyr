# @internal — TrueType hinting, part one: the machine, and the font program (0.8.0).
#
# hint.cyr — the bytecode interpreter a TrueType face carries its own hints in. `fpgm` holds the
# font's function library, `prep` the program run once per size, `cvt ` the control values both
# read, and every glyph may carry a program of its own. Together they are the last thing between
# rekha's outlines and a legible 9-pixel glyph, and the standing roadmap item since 0.4.x.
#
# ⛔ 0.8.0 IS THE MACHINE AND NOT THE HINTING — the zones are 0.8.1 and the glyph programs 0.8.2,
# both booked in docs/development/roadmap.md. It executes every instruction that does not
# touch a POINT — the stack, the storage area, the control-value table, arithmetic, the rounding
# engine, flow control, function definition and call, and the graphics-state setters — and it runs
# the FONT PROGRAM to completion. It does not move an outline: `prep` and the glyph programs need
# zones, and a point op is REFUSED with `REKHA_ERR_UNSUPPORTED` naming itself rather than skipped.
# Skipping one would leave the stack at a depth the next instruction is not written for, which is
# how a half-interpreter produces a plausible wrong glyph instead of a refusal.
# ⭐ AND THE FONT PROGRAM IS REACHABLE ANYWAY, because an `FDEF` body is SCANNED, not executed.
# Liberation Sans's real 1,972-byte `fpgm` reaches its top level with exactly THREE opcodes —
# NPUSHB, FDEF and the ENDF that closes each body — and rekha runs it and defines all 71 of its
# functions. What the bodies contain matters at `CALL`, which is 0.8.1's problem.
#
# The three tables, and the one that says whether to bother:
#   cvt  — an array of i16 in FONT UNITS. Scaled to F26Dot6 at a ppem and then owned by the
#          interpreter: `prep` rewrites entries through WCVTP / WCVTF / DELTAC, so the scaled copy
#          is per-size state and never a view onto the font bytes.
#   fpgm — one program, run ONCE per face. Almost entirely FDEFs.
#   prep — the control-value program, run once per SIZE, after fpgm and before any glyph.
#   gasp — not code: a ppem-ordered table saying at which sizes to grid-fit and at which to smooth.
#          The first question a consumer of hinting asks, and rekha answers it at 0.8.0.
#
# ⚠ ppem IS THE ONLY SIZE rekha HAS. The interpreter's x and y scales are equal, MPPEM answers the
# same number on both axes, and MPS answers ppem in F26Dot6 because rekha carries no dpi and so
# defines the point size at 72 dpi. A consumer with non-square pixels cannot express that here.
#
# ⛔ WHY THE ROUNDING DIVERGES FROM THE REST OF rekha, DELIBERATELY. Everywhere else rekha rounds
# HALF UP (`sd_asr(v + 32768, 16)`), which is fontTools' `otRound` and what every differential
# since 0.5.0 was measured against. This file rounds HALF AWAY FROM ZERO, because its reference is
# not fontTools but the interpreter a hinted glyph was drawn against — FreeType's `FT_MulFix` and
# `FT_DivFix` both take the absolute value, add a half, and re-sign. The two differ only when a
# NEGATIVE value lands exactly on .5, and a `cvt ` full of descender depths is exactly where that
# happens. One 1/64 pixel there moves a point, so the reference wins over the house convention.
#
# ⭐ THREE OPERAND ORDERS WERE SETTLED AGAINST REAL FONTS, because the published specs contradict
# each other on whether a "Pops:" list is written top-first or push-first:
#   LOOPCALL — the FUNCTION is on top, the count below. A `prep` in the host corpus pushes
#     `0 0 65 49 33 5 0` then LOOPCALL: as (f=0, count=5) that consumes the five values below and
#     leaves nothing, and as (count=0, f=5) it calls nothing and the seven pushes are dead.
#   DELTAC — after the pair count, each pair is (exception spec, then INDEX on top). A host `prep`
#     pushes `64 21` against a 37-entry `cvt `, and `63 18` against a 34-entry one; the other
#     reading indexes entry 64 of 37.
#   WCVTP / WS — the VALUE is on top and the location below, from `DUP RCVT RTG ROUND WCVTP` in
#     Liberation Sans's own fpgm, which can only mean "write the rounded value to the index under
#     it".
# ⚠ INSTCTRL's order (selector on top) is NOT observed: the one real site pushes `1 1`. It follows
# FreeType and is marked here rather than presented as measured.

# ================================================================
# Tables, caps and the rounding modes
# ================================================================
var REKHA_TAG_CVT  = 0x63767420;   # 'cvt '
var REKHA_TAG_FPGM = 0x6670676D;   # 'fpgm'
var REKHA_TAG_PREP = 0x70726570;   # 'prep'
var REKHA_TAG_GASP = 0x67617370;   # 'gasp'

# ⛔ EVERY CAP BELOW IS A REFUSAL, NOT A CLAMP. A font declaring more than one of these gets no
# interpreter at all and `rekha_hint_error` names which cap it tripped, because an interpreter
# running with a stack shorter than the font asked for silently computes a different glyph.
# The numbers are an order of magnitude above the host corpus: Liberation Sans declares a 676-slot
# stack, 47 storage locations, 92 functions, 0 instruction definitions and 324 control values.
var REKHA_HINT_MAXSTACK = 8192;
var REKHA_HINT_MAXSTORE = 8192;
var REKHA_HINT_MAXFDEF  = 4096;
var REKHA_HINT_MAXIDEF  = 256;
var REKHA_HINT_MAXCVT   = 16384;
# A CALL nest deeper than this, or a program longer than this many instructions, is refused. Both
# are halting guards: JMPR can jump backwards and LOOPCALL can be handed any count.
var REKHA_HINT_MAXDEPTH = 64;
var REKHA_HINT_BUDGET   = 1000000;
# ⚠ TrueType is specified on 32-bit signed integers. rekha computes in i64 and CLAMPS every
# arithmetic result to that range instead of wrapping: a wrap is never what a font meant, and the
# clamp is what keeps the products in rekha_hint_muldiv inside i64.
var REKHA_HINT_CLAMP = 2147483647;

var REKHA_RND_GRID    = 0;   # RTG  — to the nearest pixel
var REKHA_RND_HALF    = 1;   # RTHG — to the nearest half pixel
var REKHA_RND_DOUBLE  = 2;   # RTDG — to the nearest half pixel, on a half-pixel grid
var REKHA_RND_DOWN    = 3;   # RDTG
var REKHA_RND_UP      = 4;   # RUTG
var REKHA_RND_OFF     = 5;   # ROFF — no rounding at all
var REKHA_RND_SUPER   = 6;   # SROUND
var REKHA_RND_SUPER45 = 7;   # S45ROUND

# The two grid periods SROUND and S45ROUND decompose, in 1/16384 pixel so the 45-degree one keeps
# its precision: 0x4000 is 1.0 pixel and 0x2D41 / 16384 = 0.70709, which is sqrt(2)/2. Both are
# brought down to F26Dot6 (0x4000 -> 64, 0x2D41 -> 45) once period, phase and threshold are fixed.
var REKHA_HINT_GRID   = 0x4000;
var REKHA_HINT_GRID45 = 0x2D41;

# ================================================================
# RekhaHintCtx — the execution context. ONE sd_alloc, header then arrays inline, so its cost is a
# number a test can assert: REKHA_HINT_HDR + (stack + storage + cvt) * 8 + fdefs * 24 + idefs * 32.
# ⚠ It is built LAZILY and cached on the font at +808, the same shape GPOS's lookup list uses, so
# `rekha_font_open` still costs exactly REKHA_FONT_SIZE and a consumer that never hints never pays.
# ⛔ ONE CONTEXT PER FONT HANDLE, and changing ppem REBUILDS the per-size state in place rather
# than allocating again — `sd_alloc` has no free, and a text run that walks sizes would otherwise
# leak one context per size. The same "one handle, one thread" obligation 0.7.0 wrote down applies.
# ================================================================
var HC_FONT     = 0;     # the RekhaFont this belongs to
var HC_BUF      = 8;     # its byte buffer, cached
var HC_PPEM     = 16;    # the size this context is scaled for; 0 = not scaled yet
var HC_SCALE    = 24;    # 16.16 multiplier taking FONT UNITS to F26Dot6
var HC_ERR      = 32;    # REKHA_OK, or why the last run refused
var HC_DETAIL   = 40;    # a static cstring naming where; never allocated, never owned
var HC_SP       = 48;    # stack depth
var HC_STACK    = 56;
var HC_STKCAP   = 64;
var HC_STORE    = 72;
var HC_STORECAP = 80;
var HC_FDEF     = 88;    # 3 i64 per function: body start, body end, AND THE BUFFER THEY ARE IN
# — a function is a range into the bytes of the program that defined it,
# and `fpgm` is not the only program there is. start 0 = never defined
var HC_FDEFCAP  = 96;
var HC_IDEF     = 104;   # 4 i64 per definition: opcode, body start, body end, buffer
var HC_IDEFCAP  = 112;
var HC_IDEFN    = 120;
var HC_CVT      = 128;   # the SCALED control values, in F26Dot6. Owned, rewritable, per size
var HC_CVTCAP   = 136;
var HC_BUDGET   = 144;   # instructions left in the current run
var HC_DEPTH    = 152;   # current CALL nesting
var HC_FPGMOK   = 160;   # 1 once the font program has run for this face
var HC_BYTES    = 168;   # the allocation's own size, so programs/hint_test.cyr can pin it
# ---- the graphics state ----
# ⚠ The vectors are F2Dot14 (16384 = 1.0), the distances F26Dot6 (64 = one pixel), and the zone,
# reference-point and loop fields plain integers. 0.8.0 SETS all of them and READS the ones its own
# instructions need; the point-moving half is 0.8.1's, which is why zp0..zp2 are validated here and
# used there.
var HC_PVX = 176;  var HC_PVY = 184;     # projection vector
var HC_FVX = 192;  var HC_FVY = 200;     # freedom vector
var HC_DVX = 208;  var HC_DVY = 216;     # dual projection vector
var HC_RP0 = 224;  var HC_RP1 = 232;  var HC_RP2 = 240;
var HC_ZP0 = 248;  var HC_ZP1 = 256;  var HC_ZP2 = 264;
var HC_LOOP     = 272;
var HC_RSTATE   = 280;
var HC_PERIOD   = 288;  var HC_PHASE = 296;  var HC_THRESH = 304;
var HC_MINDIST  = 312;
var HC_CVTCUT   = 320;
var HC_SWCUT    = 328;  var HC_SWVAL = 336;
var HC_AUTOFLIP = 344;
var HC_DBASE    = 352;  var HC_DSHIFT = 360;
var HC_INSTCTL  = 368;
var HC_SCANCTL  = 376;  var HC_SCANTYPE = 384;
var REKHA_HINT_HDR = 392;

# ================================================================
# Table resolution — called once by rekha_font_open, like every other module's _resolve.
# ⚠ A MISSING TABLE IS NOT A FAILED OPEN, as everywhere else in rekha: it is cached as absent and
# rekha_hint_present says so.
# ================================================================
fn rekha_hint_resolve(f): i64 {
    store64(f + 688, 0);   store64(f + 696, 0);
    store64(f + 704, 0);   store64(f + 712, 0);
    store64(f + 720, 0);   store64(f + 728, 0);
    store64(f + 736, 0);   store64(f + 744, 0);
    store64(f + 752, 0);
    store64(f + 760, 0);   store64(f + 768, 0);   store64(f + 776, 0);
    store64(f + 784, 0);   store64(f + 792, 0);   store64(f + 800, 0);
    store64(f + 808, 0);
    var buf = load64(f);
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_CVT, &c);
    if (t != 0) { store64(f + 688, t); store64(f + 696, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_FPGM, &c);
    if (t != 0) { store64(f + 704, t); store64(f + 712, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_PREP, &c);
    if (t != 0) { store64(f + 720, t); store64(f + 728, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_GASP, &c);
    if (t != 0) {
        if (load64(&c) >= 4) { store64(f + 736, t); store64(f + 744, t + load64(&c)); }
    }
    # ⛔ maxp VERSION 1.0 IS WHAT MAKES THE INTERPRETER SIZEABLE. Version 0.5 is the CFF form and
    # carries numGlyphs alone: no stack depth, no function count, no storage. A TrueType face with
    # bytecode and a 0.5 maxp is malformed, and rekha answers "no hinting" rather than guessing
    # limits, because every guess is either a refusal the font did not earn or a buffer too small.
    var mx = rekha_find_table_len(f, REKHA_TAG_MAXP, &c);
    if (mx == 0) { return 0; }
    if (load64(&c) < 32) { return 0; }
    if (rekha_rd_u32(buf, mx) != 0x00010000) { return 0; }
    store64(f + 752, 1);
    store64(f + 760, rekha_rd_u16(buf, mx + 18));   # maxStorage
    store64(f + 768, rekha_rd_u16(buf, mx + 20));   # maxFunctionDefs
    store64(f + 776, rekha_rd_u16(buf, mx + 22));   # maxInstructionDefs
    store64(f + 784, rekha_rd_u16(buf, mx + 24));   # maxStackElements
    store64(f + 792, rekha_rd_u16(buf, mx + 26));   # maxSizeOfInstructions
    store64(f + 800, rekha_rd_u16(buf, mx + 16));   # maxTwilightPoints
    return 0;
}

# @public — 1 when this face carries TrueType bytecode rekha could run: a version 1.0 `maxp`, and
# at least one of `fpgm` / `prep` / a glyph program. ⚠ It does NOT mean a glyph will be hinted;
# 0.8.0 runs the font program only. `rekha_hint_error` on the context says how far a size got.
fn rekha_hint_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 752) == 0) { return 0; }
    if (load64(font + 712) > 0) { return 1; }
    if (load64(font + 728) > 0) { return 1; }
    if (load64(font + 696) > 0) { return 1; }
    return 0;
}

# @public — the six `maxp` version 1.0 limits the interpreter is sized by. 0 when the table is
# version 0.5, absent or short, which is also a legal answer for a font that declares 0.
fn rekha_max_storage(font): i64          { if (font == 0) { return 0; } return load64(font + 760); }
fn rekha_max_function_defs(font): i64    { if (font == 0) { return 0; } return load64(font + 768); }
fn rekha_max_instruction_defs(font): i64 { if (font == 0) { return 0; } return load64(font + 776); }
fn rekha_max_stack_elements(font): i64   { if (font == 0) { return 0; } return load64(font + 784); }
fn rekha_max_instruction_size(font): i64 { if (font == 0) { return 0; } return load64(font + 792); }
fn rekha_max_twilight_points(font): i64  { if (font == 0) { return 0; } return load64(font + 800); }

# @public — the byte length of the font program and the control-value program. 0 = absent.
fn rekha_fpgm_length(font): i64 { if (font == 0) { return 0; } return load64(font + 712); }
fn rekha_prep_length(font): i64 { if (font == 0) { return 0; } return load64(font + 728); }

# @public — how many entries the `cvt ` table holds, and entry `i` in FONT UNITS, unscaled and
# unhinted. ⚠ This reads the FONT; `rekha_hint_cvt_px` reads the interpreter's own copy, which
# `prep` is entitled to have rewritten. They answer different questions at the same index.
fn rekha_cvt_count(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 696) / 2;
}

fn rekha_cvt_value(font, i): i64 {
    if (font == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= rekha_cvt_count(font)) { return 0; }
    return rekha_rd_i16(load64(font), load64(font + 688) + i * 2);
}

# ================================================================
# gasp — not bytecode: the table that says at which sizes to grid-fit at all.
#   +0 version u16 (0 or 1) · +2 numRanges u16 · then numRanges x (rangeMaxPPEM u16, behavior u16),
#   SORTED by rangeMaxPPEM, the last one 0xFFFF.
# Version 0 defines the low two behavior bits; version 1 adds the symmetric pair, which describe
# ClearType and are reported unchanged rather than folded into the other two.
# ================================================================
var REKHA_GASP_GRIDFIT           = 1;
var REKHA_GASP_DOGRAY            = 2;
var REKHA_GASP_SYMMETRIC_GRIDFIT = 4;
var REKHA_GASP_SYMMETRIC_SMOOTH  = 8;

# @public — 1 when the face carries a `gasp` rekha can read.
fn rekha_gasp_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 736) == 0) { return 0; }
    return 1;
}

# @public — the behavior flags for `ppem`: the first range whose rangeMaxPPEM is at least ppem.
# -1 when there is no `gasp`, which is NOT 0: 0 is a real answer meaning "neither grid-fit nor
# smooth at this size", and a font without the table has said nothing at all.
# ⚠ A font with no `gasp` is conventionally grid-fit at every size; rekha reports the absence and
# leaves that convention to `rekha_should_gridfit`, so the two questions stay separable.
fn rekha_gasp_behavior(font, ppem): i64 {
    if (rekha_gasp_present(font) == 0) { return 0 - 1; }
    var buf = load64(font);
    var t = load64(font + 736);
    var end = load64(font + 744);
    var n = rekha_rd_u16(buf, t + 2);
    if (t + 4 + n * 4 > end) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        var r = t + 4 + i * 4;
        if (rekha_rd_u16(buf, r) >= ppem) { return rekha_rd_u16(buf, r + 2); }
        i = i + 1;
    }
    return 0;
}

# @public — 1 when this size should be grid-fit, 0 when it should not. ⚠ A face with no `gasp`
# answers 1: that is the long-standing convention and it is stated here rather than left implicit.
fn rekha_should_gridfit(font, ppem): i64 {
    var b = rekha_gasp_behavior(font, ppem);
    if (b < 0) { return 1; }
    if ((b & REKHA_GASP_GRIDFIT) != 0) { return 1; }
    return 0;
}

# ================================================================
# Fixed point — F26Dot6 for distances, 16.16 for the scale, F2Dot14 for the vectors.
# ⛔ ROUNDED HALF AWAY FROM ZERO, not half up. See the header: the reference here is FreeType's
# interpreter, not fontTools, and a `cvt ` of descender depths is where the two disagree.
# ================================================================

# 16.16 x value -> value, i.e. FT_MulFix.
fn rekha_hint_mulfix(a, b): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    var c = sd_asr(a * b + 32768, 16);
    if (s < 0) { return 0 - c; }
    return c;
}

# a / b as 16.16, i.e. FT_DivFix. b == 0 answers 0 rather than trapping; the caller has already
# refused a font with unitsPerEm 0 long before this.
fn rekha_hint_divfix(a, b): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    if (b == 0) { return 0; }
    var c = (a * 65536 + b / 2) / b;
    if (s < 0) { return 0 - c; }
    return c;
}

# round(a * b / c), half away from zero — FT_MulDiv, which MUL and DIV are defined in terms of.
fn rekha_hint_muldiv(a, b, c): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    if (c < 0) { c = 0 - c; s = 0 - s; }
    if (c == 0) { return 0; }
    var v = (a * b + c / 2) / c;
    if (s < 0) { return 0 - v; }
    return v;
}

# The largest multiple of `p` at or below `v`. ⛔ NOT `v / p * p`: Cyrius divides toward zero, so
# that rounds a negative value UP and turns a round-down into a round-up on exactly the half of
# the number line a descender lives on. This is the `& -p` of a power-of-two grid, generalised to
# the 45-degree period, which is 45 and not a power of two.
fn rekha_hint_floor_mul(v, p): i64 {
    if (p <= 0) { return v; }
    var q = v / p;
    if (v < 0) {
        if (q * p != v) { q = q - 1; }
    }
    return q * p;
}

# Keep a value inside the 32-bit signed range TrueType is specified on.
fn rekha_hint_clamp(v): i64 {
    if (v > REKHA_HINT_CLAMP) { return REKHA_HINT_CLAMP; }
    if (v < (0 - REKHA_HINT_CLAMP) - 1) { return (0 - REKHA_HINT_CLAMP) - 1; }
    return v;
}

# ================================================================
# Refusal reporting — the 0.7.0 shape, on the context rather than the font handle, because a
# context outlives one call and a program's refusal is the answer to "why is this size unhinted".
# ================================================================

# @public — why the last run on this context refused, as a RekhaErrCode. REKHA_OK when it did not.
# ⛔ IT IS NOT A SUCCESS TEST: `rekha_hint_run` already returns 1 or 0. This says WHICH refusal.
fn rekha_hint_error(ctx): i64 {
    if (ctx == 0) { return REKHA_OK; }
    return load64(ctx + HC_ERR);
}

# @public — a short STATIC cstring naming the instruction or invariant, never allocated and never
# owned by the caller. 0 when there is nothing to name.
fn rekha_hint_error_detail(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + HC_DETAIL);
}

# @public — clear it. Every run clears first, so a code describes the LAST run.
fn rekha_hint_error_clear(ctx): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + HC_ERR, REKHA_OK);
    store64(ctx + HC_DETAIL, 0);
    return 0;
}

# Record a refusal and answer 0, so a caller can `return rekha_hint_fail(...)`.
fn rekha_hint_fail(ctx, code, detail): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + HC_ERR, code);
    store64(ctx + HC_DETAIL, detail);
    return 0;
}

# ================================================================
# The stack. ⚠ Bounded by the font's OWN maxStackElements, not by a rekha constant: a font that
# declares 676 gets 676, and overflowing it is the font contradicting itself.
# ================================================================

# @public — how deep the stack is, and the value `i` from the BOTTOM. Both for a consumer reading
# out what a program computed, and for programs/hint_test.cyr.
fn rekha_hint_depth(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + HC_SP);
}

fn rekha_hint_at(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_SP)) { return 0; }
    return load64(load64(ctx + HC_STACK) + i * 8);
}

# @public — push a value. 1 on success, 0 when the stack is full (and the refusal is recorded).
fn rekha_hint_push(ctx, v): i64 {
    if (ctx == 0) { return 0; }
    var sp = load64(ctx + HC_SP);
    if (sp >= load64(ctx + HC_STKCAP)) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "stack overflow");
    }
    store64(load64(ctx + HC_STACK) + sp * 8, rekha_hint_clamp(v));
    store64(ctx + HC_SP, sp + 1);
    return 1;
}

# 1 when at least `n` values are on the stack; otherwise records the underflow and answers 0.
fn rekha_hint_need(ctx, n): i64 {
    if (load64(ctx + HC_SP) >= n) { return 1; }
    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "stack underflow");
}

# @public — pop. ⚠ Answers 0 on an EMPTY stack, which is also a legal value; call rekha_hint_need
# first, as every instruction here does.
fn rekha_hint_pop(ctx): i64 {
    if (ctx == 0) { return 0; }
    var sp = load64(ctx + HC_SP);
    if (sp <= 0) { return 0; }
    store64(ctx + HC_SP, sp - 1);
    return load64(load64(ctx + HC_STACK) + (sp - 1) * 8);
}

# ================================================================
# The rounding engine. Six fixed modes plus the two the font composes itself.
# ⚠ THE FOUR ENGINE COMPENSATIONS ARE ZERO, as FreeType's are. They modelled the pixel spread of a
# CRT and the distance-type bits in ROUND[ab] / NROUND[ab] select between them; with all four zero
# the bits are read, validated and then make no difference, and NROUND becomes the identity. That
# is stated rather than left as an accident of the table being empty.
# ================================================================

# Decompose an SROUND / S45ROUND selector byte into period, phase and threshold. `grid` is in
# 1/16384 pixel (see REKHA_HINT_GRID); all three come out in F26Dot6.
fn rekha_hint_set_super(ctx, grid, sel): i64 {
    var period = grid;
    var b = sel & 0xC0;
    if (b == 0x00)    { period = grid / 2; }
    if (b == 0x80)    { period = grid * 2; }
    var phase = 0;
    var ph = sel & 0x30;
    if (ph == 0x10) { phase = period / 4; }
    if (ph == 0x20) { phase = period / 2; }
    if (ph == 0x30) { phase = period * 3 / 4; }
    var th = sel & 0x0F;
    var thresh = period - 256;
    if (th != 0) { thresh = (th - 4) * period / 8; }
    store64(ctx + HC_PERIOD, sd_asr(period, 8));
    store64(ctx + HC_PHASE,  sd_asr(phase, 8));
    store64(ctx + HC_THRESH, sd_asr(thresh, 8));
    return 0;
}

# @public — put `d` (an F26Dot6 distance) through the current rounding state. Exposed because it
# is the one piece of the graphics state whose effect a consumer can see without a glyph, and
# because every mode below has a spec-stated answer a test can pin.
fn rekha_hint_round(ctx, d): i64 {
    if (ctx == 0) { return d; }
    var st = load64(ctx + HC_RSTATE);
    if (st == REKHA_RND_OFF) { return d; }
    if (st == REKHA_RND_SUPER)   { return rekha_hint_round_super(ctx, d); }
    if (st == REKHA_RND_SUPER45) { return rekha_hint_round_super(ctx, d); }
    # The five fixed grids, each written as "fold to a non-negative distance, round, put the sign
    # back, and never let a rounding carry a distance across zero".
    var neg = 0;
    var v = d;
    if (v < 0) { neg = 1; v = 0 - v; }
    if (st == REKHA_RND_GRID)   { v = rekha_hint_floor_mul(v + 32, 64); }
    if (st == REKHA_RND_HALF)   { v = rekha_hint_floor_mul(v, 64) + 32; }
    if (st == REKHA_RND_DOUBLE) { v = rekha_hint_floor_mul(v + 16, 32); }
    if (st == REKHA_RND_DOWN)   { v = rekha_hint_floor_mul(v, 64); }
    if (st == REKHA_RND_UP)     { v = rekha_hint_floor_mul(v + 63, 64); }
    if (v < 0) { v = 0; }
    if (neg == 1) { return 0 - v; }
    return v;
}

# SROUND / S45ROUND: a period, a phase and a threshold the font chose.
fn rekha_hint_round_super(ctx, d): i64 {
    var period = load64(ctx + HC_PERIOD);
    var phase = load64(ctx + HC_PHASE);
    var thresh = load64(ctx + HC_THRESH);
    if (period <= 0) { return d; }
    if (d >= 0) {
        var v = rekha_hint_floor_mul(d - phase + thresh, period) + phase;
        if (v < 0) { v = phase; }
        return v;
    }
    var w = 0 - rekha_hint_floor_mul(thresh - phase - d, period);
    w = w - phase;
    if (w > 0) { w = 0 - phase; }
    return w;
}

# ================================================================
# The context: build it once, re-scale it per size.
# ================================================================

# Put the graphics state back to the values the spec calls default. Called before the font program
# and before each size's control-value program, never between two instructions.
fn rekha_hint_reset(ctx): i64 {
    store64(ctx + HC_SP, 0);
    store64(ctx + HC_PVX, 16384);   store64(ctx + HC_PVY, 0);
    store64(ctx + HC_FVX, 16384);   store64(ctx + HC_FVY, 0);
    store64(ctx + HC_DVX, 16384);   store64(ctx + HC_DVY, 0);
    store64(ctx + HC_RP0, 0);   store64(ctx + HC_RP1, 0);   store64(ctx + HC_RP2, 0);
    store64(ctx + HC_ZP0, 1);   store64(ctx + HC_ZP1, 1);   store64(ctx + HC_ZP2, 1);
    store64(ctx + HC_LOOP, 1);
    store64(ctx + HC_RSTATE, REKHA_RND_GRID);
    store64(ctx + HC_PERIOD, 64);   store64(ctx + HC_PHASE, 0);   store64(ctx + HC_THRESH, 32);
    store64(ctx + HC_MINDIST, 64);          # one pixel
    store64(ctx + HC_CVTCUT, 68);           # 17/16 of a pixel, the spec's own default
    store64(ctx + HC_SWCUT, 0);   store64(ctx + HC_SWVAL, 0);
    store64(ctx + HC_AUTOFLIP, 1);
    store64(ctx + HC_DBASE, 9);   store64(ctx + HC_DSHIFT, 3);
    store64(ctx + HC_INSTCTL, 0);
    store64(ctx + HC_SCANCTL, 0);   store64(ctx + HC_SCANTYPE, 0);
    return 0;
}

# Re-scale the control values from the font bytes at the context's ppem. ⛔ FROM THE FONT, not from
# the previous size's copy: `prep` rewrites entries, and re-scaling a rewritten value would
# compound one size's exceptions into the next.
fn rekha_hint_scale_cvt(ctx): i64 {
    var font = load64(ctx + HC_FONT);
    var buf = load64(ctx + HC_BUF);
    var at = load64(font + 688);
    var n = load64(ctx + HC_CVTCAP);
    var dst = load64(ctx + HC_CVT);
    var sc = load64(ctx + HC_SCALE);
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, rekha_hint_mulfix(rekha_rd_i16(buf, at + i * 2), sc));
        i = i + 1;
    }
    return 0;
}

# @public — the scaled control value at `i`, in F26Dot6, as the interpreter currently holds it.
# ⚠ Not `rekha_cvt_value`, which reads the font: after a `prep` these differ, on purpose.
fn rekha_hint_cvt_px(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_CVTCAP)) { return 0; }
    return load64(load64(ctx + HC_CVT) + i * 8);
}

# @public — the storage area at `i`. 0 outside it, which is also a legal stored value.
fn rekha_hint_storage(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_STORECAP)) { return 0; }
    return load64(load64(ctx + HC_STORE) + i * 8);
}

# @public — the size this context is scaled for, the 16.16 font-unit-to-F26Dot6 multiplier, and
# the exact byte count of its single allocation.
fn rekha_hint_ppem(ctx): i64  { if (ctx == 0) { return 0; } return load64(ctx + HC_PPEM); }
fn rekha_hint_scale(ctx): i64 { if (ctx == 0) { return 0; } return load64(ctx + HC_SCALE); }
fn rekha_hint_bytes(ctx): i64 { if (ctx == 0) { return 0; } return load64(ctx + HC_BYTES); }

# @public — how many functions the font program defined, and whether `n` is one of them.
fn rekha_hint_func_defined(ctx, n): i64 {
    if (ctx == 0) { return 0; }
    if (n < 0) { return 0; }
    if (n >= load64(ctx + HC_FDEFCAP)) { return 0; }
    if (load64(load64(ctx + HC_FDEF) + n * 24) == 0) { return 0; }
    return 1;
}

fn rekha_hint_func_count(ctx): i64 {
    if (ctx == 0) { return 0; }
    var n = 0;
    var i = 0;
    var cap = load64(ctx + HC_FDEFCAP);
    while (i < cap) {
        if (load64(load64(ctx + HC_FDEF) + i * 24) != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# @public — the interpreter for `font` at `ppem`, built on first use and re-scaled in place on a
# size change. 0 when the face carries no bytecode, when ppem is not positive, when a declared
# `maxp` limit is over one of rekha's caps, or when the allocation failed — and in every one of
# those cases `rekha_font_error(font)` says which, because there is no context to ask.
# ⛔ THE CONTEXT IS CACHED ON THE FONT AND RE-SCALED, NEVER REALLOCATED. `sd_alloc` has no free, so
# a text run walking sizes would otherwise leak one interpreter per size.
# ⚠ Re-scaling resets the graphics state and re-reads the control values from the font, but KEEPS
# the storage area and the function table, which is what FreeType does: functions are ranges into
# font bytes and do not move with size, and a storage slot one size wrote and the next never
# touches keeps the older value. A font program that relies on that is relying on its own history.
fn rekha_hint_ctx(font, ppem): i64 {
    if (font == 0) { return 0; }
    rekha_font_error_clear(font);
    if (rekha_hint_present(font) == 0) {
        return rekha_fail(font, REKHA_ERR_NO_TABLE, "hint tables");
    }
    if (ppem <= 0) { return rekha_fail(font, REKHA_ERR_OTHER, "ppem"); }
    var upem = load64(font + 40);
    if (upem <= 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "head"); }
    var ctx = load64(font + 808);
    if (ctx == 0) {
        ctx = rekha_hint_ctx_new(font);
        if (ctx == 0) { return 0; }
        store64(font + 808, ctx);
    }
    if (load64(ctx + HC_PPEM) != ppem) {
        store64(ctx + HC_PPEM, ppem);
        store64(ctx + HC_SCALE, rekha_hint_divfix(ppem * 64, upem));
        rekha_hint_scale_cvt(ctx);
        rekha_hint_reset(ctx);
    }
    if (load64(ctx + HC_FPGMOK) == 0) {
        if (rekha_hint_run_fpgm(ctx) == 0) { return ctx; }
    }
    return ctx;
}

# One sd_alloc: the header, then the stack, the storage area, the function table, the instruction
# table and the scaled control values, all inline.
# ⚠ THE STACK GETS 32 SLOTS MORE THAN THE FONT DECLARED, which is FreeType's margin and is here
# for the same reason: a maxStackElements one short of what the font's own program pushes is a
# common enough authoring slip that refusing it would refuse working fonts.
fn rekha_hint_ctx_new(font): i64 {
    var stk = load64(font + 784) + 32;
    var sto = load64(font + 760);
    var fdn = load64(font + 768);
    var idn = load64(font + 776);
    var cvn = load64(font + 696) / 2;
    if (stk > REKHA_HINT_MAXSTACK) { return rekha_fail(font, REKHA_ERR_OOM, "stack cap"); }
    if (sto > REKHA_HINT_MAXSTORE) { return rekha_fail(font, REKHA_ERR_OOM, "storage cap"); }
    if (fdn > REKHA_HINT_MAXFDEF)  { return rekha_fail(font, REKHA_ERR_OOM, "function cap"); }
    if (idn > REKHA_HINT_MAXIDEF)  { return rekha_fail(font, REKHA_ERR_OOM, "instruction cap"); }
    if (cvn > REKHA_HINT_MAXCVT)   { return rekha_fail(font, REKHA_ERR_OOM, "cvt cap"); }
    var bytes = REKHA_HINT_HDR + stk * 8 + sto * 8 + fdn * 24 + idn * 32 + cvn * 8;
    var ctx = sd_alloc(bytes);
    if (ctx == 0) { return rekha_fail(font, REKHA_ERR_OOM, "hint context"); }
    var at = ctx + REKHA_HINT_HDR;
    store64(ctx + HC_FONT, font);
    store64(ctx + HC_BUF, load64(font));
    store64(ctx + HC_PPEM, 0);
    store64(ctx + HC_SCALE, 0);
    store64(ctx + HC_ERR, REKHA_OK);
    store64(ctx + HC_DETAIL, 0);
    store64(ctx + HC_SP, 0);
    store64(ctx + HC_STACK, at);      store64(ctx + HC_STKCAP, stk);     at = at + stk * 8;
    store64(ctx + HC_STORE, at);      store64(ctx + HC_STORECAP, sto);   at = at + sto * 8;
    store64(ctx + HC_FDEF, at);       store64(ctx + HC_FDEFCAP, fdn);    at = at + fdn * 24;
    store64(ctx + HC_IDEF, at);       store64(ctx + HC_IDEFCAP, idn);    at = at + idn * 32;
    store64(ctx + HC_IDEFN, 0);
    store64(ctx + HC_CVT, at);        store64(ctx + HC_CVTCAP, cvn);
    store64(ctx + HC_BUDGET, 0);
    store64(ctx + HC_DEPTH, 0);
    store64(ctx + HC_FPGMOK, 0);
    store64(ctx + HC_BYTES, bytes);
    # ⚠ sd_alloc does not promise zeroed memory, and an undefined function is "body start 0".
    var i = 0;
    while (i < fdn) { store64(load64(ctx + HC_FDEF) + i * 24, 0); i = i + 1; }
    i = 0;
    while (i < sto) { store64(load64(ctx + HC_STORE) + i * 8, 0); i = i + 1; }
    i = 0;
    while (i < cvn) { store64(load64(ctx + HC_CVT) + i * 8, 0); i = i + 1; }
    rekha_hint_reset(ctx);
    return ctx;
}

# ================================================================
# Walking bytecode. ⛔ AN INSTRUCTION IS NOT ONE BYTE. The eighteen push opcodes carry their
# operands INLINE, so every walk — skipping a false IF, scanning an FDEF body, stepping the
# interpreter — has to ask how long the instruction is or it will resume inside a literal and
# execute data. This is the single function all three use.
# ================================================================

# Total byte length of the instruction at `ip`, operands included. -1 when its operands run past
# `end`, which is a truncated program and not a decodable one.
fn rekha_hint_ilen(buf, ip, end): i64 {
    var op = load8(buf + ip);
    if (op == 0x40) {                                    # NPUSHB
        if (ip + 2 > end) { return 0 - 1; }
        return 2 + load8(buf + ip + 1);
    }
    if (op == 0x41) {                                    # NPUSHW
        if (ip + 2 > end) { return 0 - 1; }
        return 2 + load8(buf + ip + 1) * 2;
    }
    if (op >= 0xB0) {
        if (op <= 0xB7) { return 2 + (op - 0xB0); }       # PUSHB[0..7]
        if (op <= 0xBF) { return 1 + (op - 0xB8 + 1) * 2; }   # PUSHW[0..7]
    }
    return 1;
}

# From the byte after an IF whose condition was false, find where execution resumes: the byte after
# the matching ELSE when `want_else` is 1, otherwise the byte after the matching EIF. -1 when the
# IF is never closed. ⚠ Nested IFs are counted; an FDEF inside one is not, because the spec forbids
# defining a function inside a conditional and rekha_hint_scan_endf refuses the nesting anyway.
fn rekha_hint_skip_if(buf, ip, end, want_else): i64 {
    var nest = 0;
    while (ip < end) {
        var op = load8(buf + ip);
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return 0 - 1; }
        if (ip + ln > end) { return 0 - 1; }
        if (op == 0x58) { nest = nest + 1; }             # IF
        if (op == 0x59) {                                # EIF
            if (nest == 0) { return ip + ln; }
            nest = nest - 1;
        }
        if (op == 0x1B) {                                # ELSE
            if (nest == 0) {
                if (want_else == 1) { return ip + ln; }
            }
        }
        ip = ip + ln;
    }
    return 0 - 1;
}

# From the byte after an FDEF or IDEF, find the offset of its ENDF. -1 when there is none, or when
# another definition opens before it: the spec forbids nesting and a font that does it is telling
# rekha two different things about where the body ends.
fn rekha_hint_scan_endf(buf, ip, end): i64 {
    while (ip < end) {
        var op = load8(buf + ip);
        if (op == 0x2D) { return ip; }                   # ENDF
        if (op == 0x2C) { return 0 - 1; }                # FDEF inside a definition
        if (op == 0x89) { return 0 - 1; }                # IDEF inside a definition
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return 0 - 1; }
        if (ip + ln > end) { return 0 - 1; }
        ip = ip + ln;
    }
    return 0 - 1;
}

# Sign-extend the low 16 bits, which is how a vector component reaches the graphics state: the
# stack is 32-bit and an F2Dot14 is not.
fn rekha_hint_s16(v): i64 {
    var x = v & 0xFFFF;
    if (x >= 32768) { return x - 65536; }
    return x;
}

# floor(sqrt(v)) by Newton, for the one place a vector has to be made a unit vector.
fn rekha_hint_isqrt(v): i64 {
    if (v <= 0) { return 0; }
    var x = v;
    var y = (x + 1) / 2;
    while (y < x) {
        x = y;
        y = (x + v / x) / 2;
    }
    return x;
}

# Make (x, y) a unit vector in F2Dot14 and write it to the two-slot `out`. A zero vector answers
# the x axis, which is what the graphics state starts at and the only defined thing to do with one.
fn rekha_hint_norm(x, y, out): i64 {
    x = rekha_hint_s16(x);
    y = rekha_hint_s16(y);
    var len = rekha_hint_isqrt(x * x + y * y);
    if (len == 0) {
        store64(out, 16384);
        store64(out + 8, 0);
        return 0;
    }
    store64(out, rekha_hint_muldiv(x, 16384, len));
    store64(out + 8, rekha_hint_muldiv(y, 16384, len));
    return 0;
}

# ================================================================
# The instruction set, part one: the stack, arithmetic, comparison and rounding.
# Every handler answers 1 (done), 0 (not mine — try the next group) or -1 (refused, and the reason
# is on the context). ⚠ The refusal is checked BEFORE the pops in every case, through
# rekha_hint_need: popping first and testing afterwards is how an underflow becomes a 0 operand.
# ================================================================
fn rekha_hint_op_alu(ctx, op): i64 {
    # ── comparison: LT LTEQ GT GTEQ EQ NEQ ──
    if (op >= 0x50) {
        if (op <= 0x55) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
            var b = rekha_hint_pop(ctx);
            var a = rekha_hint_pop(ctx);
            var r = 0;
            if (op == 0x50) { if (a < b)  { r = 1; } }
            if (op == 0x51) { if (a <= b) { r = 1; } }
            if (op == 0x52) { if (a > b)  { r = 1; } }
            if (op == 0x53) { if (a >= b) { r = 1; } }
            if (op == 0x54) { if (a == b) { r = 1; } }
            if (op == 0x55) { if (a != b) { r = 1; } }
            if (rekha_hint_push(ctx, r) == 0) { return 0 - 1; }
            return 1;
        }
    }
    # ── ODD / EVEN: the spec ROUNDS first, so they answer about the fitted distance ──
    if (op == 0x56) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var v1 = rekha_hint_round(ctx, rekha_hint_pop(ctx)) & 127;
        var o1 = 0;
        if (v1 == 64) { o1 = 1; }
        if (rekha_hint_push(ctx, o1) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x57) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var v2 = rekha_hint_round(ctx, rekha_hint_pop(ctx)) & 127;
        var o2 = 0;
        if (v2 == 0) { o2 = 1; }
        if (rekha_hint_push(ctx, o2) == 0) { return 0 - 1; }
        return 1;
    }
    # ── AND / OR / NOT, on truth rather than on bits ──
    if (op == 0x5A) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b3 = rekha_hint_pop(ctx);
        var a3 = rekha_hint_pop(ctx);
        var r3 = 0;
        if (a3 != 0) { if (b3 != 0) { r3 = 1; } }
        if (rekha_hint_push(ctx, r3) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x5B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b4 = rekha_hint_pop(ctx);
        var a4 = rekha_hint_pop(ctx);
        var r4 = 1;
        if (a4 == 0) { if (b4 == 0) { r4 = 0; } }
        if (rekha_hint_push(ctx, r4) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x5C) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var r5 = 0;
        if (rekha_hint_pop(ctx) == 0) { r5 = 1; }
        if (rekha_hint_push(ctx, r5) == 0) { return 0 - 1; }
        return 1;
    }
    # ── ADD SUB DIV MUL, all F26Dot6 ──
    if (op >= 0x60) {
        if (op <= 0x63) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
            var b6 = rekha_hint_pop(ctx);
            var a6 = rekha_hint_pop(ctx);
            var r6 = 0;
            if (op == 0x60) { r6 = a6 + b6; }
            if (op == 0x61) { r6 = a6 - b6; }
            if (op == 0x62) {
                # ⛔ A DIVIDE BY ZERO IS A REFUSAL, not a saturated maximum. The instruction has no
                # defined answer and a font that reaches it has computed something rekha cannot
                # reproduce; continuing would put an invented number into a glyph's metrics.
                if (b6 == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DIV by zero") - 1; }
                r6 = rekha_hint_muldiv(a6, 64, b6);
            }
            if (op == 0x63) { r6 = rekha_hint_muldiv(a6, b6, 64); }
            if (rekha_hint_push(ctx, r6) == 0) { return 0 - 1; }
            return 1;
        }
        # ── ABS NEG FLOOR CEILING ──
        if (op <= 0x67) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            var v7 = rekha_hint_pop(ctx);
            if (op == 0x64) { if (v7 < 0) { v7 = 0 - v7; } }
            if (op == 0x65) { v7 = 0 - v7; }
            if (op == 0x66) { v7 = rekha_hint_floor_mul(v7, 64); }
            if (op == 0x67) { v7 = rekha_hint_floor_mul(v7 + 63, 64); }
            if (rekha_hint_push(ctx, v7) == 0) { return 0 - 1; }
            return 1;
        }
        # ── ROUND[ab] and NROUND[ab]. The two low bits pick an engine compensation; all four are
        #    zero here, so NROUND is the identity and ROUND ignores the distance type. ──
        if (op <= 0x6B) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            if (rekha_hint_push(ctx, rekha_hint_round(ctx, rekha_hint_pop(ctx))) == 0) {
                return 0 - 1;
            }
            return 1;
        }
        if (op <= 0x6F) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            if (rekha_hint_push(ctx, rekha_hint_pop(ctx)) == 0) { return 0 - 1; }
            return 1;
        }
    }
    # ── MAX / MIN ──
    if (op == 0x8B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b8 = rekha_hint_pop(ctx);
        var a8 = rekha_hint_pop(ctx);
        if (b8 > a8) { a8 = b8; }
        if (rekha_hint_push(ctx, a8) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x8C) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b9 = rekha_hint_pop(ctx);
        var a9 = rekha_hint_pop(ctx);
        if (b9 < a9) { a9 = b9; }
        if (rekha_hint_push(ctx, a9) == 0) { return 0 - 1; }
        return 1;
    }
    return rekha_hint_op_stack(ctx, op);
}

# DUP POP CLEAR SWAP DEPTH CINDEX MINDEX ROLL — the stack as a data structure.
fn rekha_hint_op_stack(ctx, op): i64 {
    if (op == 0x20) {                                     # DUP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var sp = load64(ctx + HC_SP);
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STACK) + (sp - 1) * 8)) == 0) {
            return 0 - 1;
        }
        return 1;
    }
    if (op == 0x21) {                                     # POP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    if (op == 0x22) {                                     # CLEAR
        store64(ctx + HC_SP, 0);
        return 1;
    }
    if (op == 0x23) {                                     # SWAP
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var s2 = load64(ctx + HC_SP);
        var at = load64(ctx + HC_STACK);
        var t = load64(at + (s2 - 1) * 8);
        store64(at + (s2 - 1) * 8, load64(at + (s2 - 2) * 8));
        store64(at + (s2 - 2) * 8, t);
        return 1;
    }
    if (op == 0x24) {                                     # DEPTH
        if (rekha_hint_push(ctx, load64(ctx + HC_SP)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x25) {                                     # CINDEX — copy the k-th from the top
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var k = rekha_hint_pop(ctx);
        if (k < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "CINDEX") - 1; }
        if (rekha_hint_need(ctx, k) == 0) { return 0 - 1; }
        var s3 = load64(ctx + HC_SP);
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STACK) + (s3 - k) * 8)) == 0) {
            return 0 - 1;
        }
        return 1;
    }
    if (op == 0x26) {                                     # MINDEX — move it, closing the gap
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var m = rekha_hint_pop(ctx);
        if (m < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MINDEX") - 1; }
        if (rekha_hint_need(ctx, m) == 0) { return 0 - 1; }
        var s4 = load64(ctx + HC_SP);
        var a4 = load64(ctx + HC_STACK);
        var v = load64(a4 + (s4 - m) * 8);
        var i = s4 - m;
        while (i < s4 - 1) {
            store64(a4 + i * 8, load64(a4 + (i + 1) * 8));
            i = i + 1;
        }
        store64(a4 + (s4 - 1) * 8, v);
        return 1;
    }
    if (op == 0x8A) {                                     # ROLL — (a b c) becomes (b c a)
        if (rekha_hint_need(ctx, 3) == 0) { return 0 - 1; }
        var s5 = load64(ctx + HC_SP);
        var a5 = load64(ctx + HC_STACK);
        var x = load64(a5 + (s5 - 3) * 8);
        store64(a5 + (s5 - 3) * 8, load64(a5 + (s5 - 2) * 8));
        store64(a5 + (s5 - 2) * 8, load64(a5 + (s5 - 1) * 8));
        store64(a5 + (s5 - 1) * 8, x);
        return 1;
    }
    return 0;
}

# ================================================================
# The instruction set, part two: the graphics state, the storage area and the control values.
# ================================================================
fn rekha_hint_op_gs(ctx, op): i64 {
    # ── SVTCA / SPVTCA / SFVTCA. The low bit picks the axis: 1 is x, 0 is y. ──
    if (op <= 0x05) {
        var ax = op & 1;
        var vx = 0;
        var vy = 16384;
        if (ax == 1) { vx = 16384; vy = 0; }
        if (op <= 0x03) {
            store64(ctx + HC_PVX, vx);   store64(ctx + HC_PVY, vy);
            store64(ctx + HC_DVX, vx);   store64(ctx + HC_DVY, vy);
        }
        if (op <= 0x01) { store64(ctx + HC_FVX, vx);   store64(ctx + HC_FVY, vy); }
        if (op >= 0x04) { store64(ctx + HC_FVX, vx);   store64(ctx + HC_FVY, vy); }
        return 1;
    }
    # ── SPVFS / SFVFS: a vector straight from the stack, y on top. ⚠ NORMALISED here rather than
    #    stored raw, so GPV and GFV answer what the machine would actually project along. ──
    if (op == 0x0A) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var y1 = rekha_hint_pop(ctx);
        var x1 = rekha_hint_pop(ctx);
        var u1: i64[2];
        rekha_hint_norm(x1, y1, &u1);
        store64(ctx + HC_PVX, load64(&u1));       store64(ctx + HC_PVY, load64(&u1 + 8));
        store64(ctx + HC_DVX, load64(&u1));       store64(ctx + HC_DVY, load64(&u1 + 8));
        return 1;
    }
    if (op == 0x0B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var y2 = rekha_hint_pop(ctx);
        var x2 = rekha_hint_pop(ctx);
        var u2: i64[2];
        rekha_hint_norm(x2, y2, &u2);
        store64(ctx + HC_FVX, load64(&u2));       store64(ctx + HC_FVY, load64(&u2 + 8));
        return 1;
    }
    if (op == 0x0C) {                                     # GPV — x first, y on top
        if (rekha_hint_push(ctx, load64(ctx + HC_PVX)) == 0) { return 0 - 1; }
        if (rekha_hint_push(ctx, load64(ctx + HC_PVY)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x0D) {                                     # GFV
        if (rekha_hint_push(ctx, load64(ctx + HC_FVX)) == 0) { return 0 - 1; }
        if (rekha_hint_push(ctx, load64(ctx + HC_FVY)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x0E) {                                     # SFVTPV
        store64(ctx + HC_FVX, load64(ctx + HC_PVX));
        store64(ctx + HC_FVY, load64(ctx + HC_PVY));
        return 1;
    }
    # ── SRP0 / SRP1 / SRP2 and SZP0 / SZP1 / SZP2 / SZPS ──
    if (op >= 0x10) {
        if (op <= 0x12) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            store64(ctx + HC_RP0 + (op - 0x10) * 8, rekha_hint_pop(ctx));
            return 1;
        }
        if (op <= 0x16) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            var z = rekha_hint_pop(ctx);
            # ⛔ THERE ARE EXACTLY TWO ZONES. 0 is the twilight zone and 1 the glyph; anything else
            # is refused here rather than at the first point access, so the reason names SZP.
            if (z < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SZP zone") - 1; }
            if (z > 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SZP zone") - 1; }
            if (op == 0x16) {
                store64(ctx + HC_ZP0, z);
                store64(ctx + HC_ZP1, z);
                store64(ctx + HC_ZP2, z);
                return 1;
            }
            store64(ctx + HC_ZP0 + (op - 0x13) * 8, z);
            return 1;
        }
    }
    if (op == 0x17) {                                     # SLOOP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var lp = rekha_hint_pop(ctx);
        if (lp < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SLOOP") - 1; }
        store64(ctx + HC_LOOP, lp);
        return 1;
    }
    # ── the six fixed rounding states ──
    if (op == 0x18) { store64(ctx + HC_RSTATE, REKHA_RND_GRID);   return 1; }
    if (op == 0x19) { store64(ctx + HC_RSTATE, REKHA_RND_HALF);   return 1; }
    if (op == 0x3D) { store64(ctx + HC_RSTATE, REKHA_RND_DOUBLE); return 1; }
    if (op == 0x7A) { store64(ctx + HC_RSTATE, REKHA_RND_OFF);    return 1; }
    if (op == 0x7C) { store64(ctx + HC_RSTATE, REKHA_RND_UP);     return 1; }
    if (op == 0x7D) { store64(ctx + HC_RSTATE, REKHA_RND_DOWN);   return 1; }
    # ── and the two the font composes. SROUND's grid is one pixel, S45ROUND's is sqrt(2)/2. ──
    if (op == 0x76) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_set_super(ctx, REKHA_HINT_GRID, rekha_hint_pop(ctx) & 0xFF);
        store64(ctx + HC_RSTATE, REKHA_RND_SUPER);
        return 1;
    }
    if (op == 0x77) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_set_super(ctx, REKHA_HINT_GRID45, rekha_hint_pop(ctx) & 0xFF);
        store64(ctx + HC_RSTATE, REKHA_RND_SUPER45);
        return 1;
    }
    # ── the single-value graphics-state setters ──
    if (op == 0x1A) {                                     # SMD — minimum distance, F26Dot6
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_MINDIST, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1D) {                                     # SCVTCI — control-value cut-in
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_CVTCUT, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1E) {                                     # SSWCI — single-width cut-in
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_SWCUT, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1F) {
        # ⚠ SSW's operand is in FONT UNITS while every other distance here is F26Dot6, so it is the
        # one setter that scales. Storing it raw would make a single width tens of pixels wide.
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_SWVAL, rekha_hint_mulfix(rekha_hint_pop(ctx), load64(ctx + HC_SCALE)));
        return 1;
    }
    if (op == 0x4D) { store64(ctx + HC_AUTOFLIP, 1); return 1; }
    if (op == 0x4E) { store64(ctx + HC_AUTOFLIP, 0); return 1; }
    if (op == 0x5E) {                                     # SDB
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_DBASE, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x5F) {                                     # SDS
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var ds = rekha_hint_pop(ctx);
        if (ds < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SDS") - 1; }
        if (ds > 6) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SDS") - 1; }
        store64(ctx + HC_DSHIFT, ds);
        return 1;
    }
    if (op == 0x85) {                                     # SCANCTRL
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_SCANCTL, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x8D) {                                     # SCANTYPE
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_SCANTYPE, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x8E) {
        # ⚠ INSTCTRL takes the SELECTOR on top and the value below. This is the one operand order
        # here that real bytecode did not settle: the only site in the host corpus pushes `1 1`.
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var sel = rekha_hint_pop(ctx);
        var val = rekha_hint_pop(ctx);
        if (sel < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        if (sel > 3) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        # The value is the selector itself or 0 — it names the bit, it is not a boolean.
        if (val != 0) {
            if (val != sel) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        }
        var cur = load64(ctx + HC_INSTCTL) & (0xFF - sel);
        if (val != 0) { cur = cur | sel; }
        store64(ctx + HC_INSTCTL, cur);
        return 1;
    }
    if (op == 0x4F) {                                     # DEBUG — pops and does nothing
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    if (op == 0x7E) {                                     # SANGW — obsolete, pops one
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    if (op == 0x7F) {                                     # AA — obsolete, pops one
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    return rekha_hint_op_mem(ctx, op);
}

# ================================================================
# The instruction set, part three: the storage area, the control values, and what the machine can
# be asked about itself.
# ⛔ AN INDEX OUTSIDE THE FONT'S OWN DECLARED LIMIT IS A REFUSAL. FreeType, outside its pedantic
# mode, ignores the write and reads back 0; rekha refuses the run and names the instruction,
# because a `prep` writing past maxStorage has contradicted its own `maxp` and the glyph that
# comes out either way is not the one the font describes. ⚠ It is a real divergence, and the one
# to revisit first if a face in the wild trips it.
# ================================================================
fn rekha_hint_op_mem(ctx, op): i64 {
    if (op == 0x43) {                                     # RS — read storage
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var l1 = rekha_hint_pop(ctx);
        if (l1 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RS index") - 1; }
        if (l1 >= load64(ctx + HC_STORECAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RS index") - 1;
        }
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STORE) + l1 * 8)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x42) {                                     # WS — value on top, location below
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v2 = rekha_hint_pop(ctx);
        var l2 = rekha_hint_pop(ctx);
        if (l2 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WS index") - 1; }
        if (l2 >= load64(ctx + HC_STORECAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WS index") - 1;
        }
        store64(load64(ctx + HC_STORE) + l2 * 8, v2);
        return 1;
    }
    if (op == 0x45) {                                     # RCVT
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var l3 = rekha_hint_pop(ctx);
        if (l3 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RCVT index") - 1; }
        if (l3 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RCVT index") - 1;
        }
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_CVT) + l3 * 8)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x44) {                                     # WCVTP — already in pixels
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v4 = rekha_hint_pop(ctx);
        var l4 = rekha_hint_pop(ctx);
        if (l4 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTP index") - 1; }
        if (l4 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTP index") - 1;
        }
        store64(load64(ctx + HC_CVT) + l4 * 8, v4);
        return 1;
    }
    if (op == 0x70) {                                     # WCVTF — in font units, so it scales
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v5 = rekha_hint_pop(ctx);
        var l5 = rekha_hint_pop(ctx);
        if (l5 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTF index") - 1; }
        if (l5 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTF index") - 1;
        }
        store64(load64(ctx + HC_CVT) + l5 * 8, rekha_hint_mulfix(v5, load64(ctx + HC_SCALE)));
        return 1;
    }
    if (op == 0x4B) {                                     # MPPEM
        if (rekha_hint_push(ctx, load64(ctx + HC_PPEM)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x4C) {
        # ⚠ MPS answers ppem in F26Dot6. rekha carries no dpi, so it defines the point size at 72
        # dots per inch, where a point IS a pixel. A font branching on MPS rather than MPPEM gets
        # a consistent answer, not a correct one for some other device.
        if (rekha_hint_push(ctx, load64(ctx + HC_PPEM) * 64) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x88) { return rekha_hint_op_getinfo(ctx); }
    # ── DELTAC1 / DELTAC2 / DELTAC3: per-size exceptions to the control values ──
    if (op >= 0x73) {
        if (op <= 0x75) { return rekha_hint_op_deltac(ctx, op); }
    }
    return 0;
}

# GETINFO — what the font is allowed to ask about the machine it is running on.
# ⛔ EVERY ANSWER BELOW IS A DECISION, and a font program branches on them:
#   version 35. rekha implements the CLASSIC interpreter. Claiming 38 or 40 would promise subpixel
#     positioning and y-only hinting that this file does not do, and modern font programs take a
#     very different path when they see it.
#   rotated 0, stretched 0. rekha applies no transform; a consumer that does applies it after.
#   variations, when the face has live axes — the one bit rekha can answer from its own state.
#   grayscale smoothing ON. rekha's output is filled to COVERAGE by sadish, which is grayscale
#     anti-aliasing; saying otherwise would make a font hint for a bi-level device rekha has none.
#   every ClearType bit 0, because there is no subpixel geometry anywhere in this stack.
fn rekha_hint_op_getinfo(ctx): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var sel = rekha_hint_pop(ctx);
    var r = 0;
    if ((sel & 0x0001) != 0) { r = r | 35; }
    if ((sel & 0x0008) != 0) {
        if (rekha_var_live(load64(ctx + HC_FONT)) != 0) { r = r | 0x0400; }
    }
    if ((sel & 0x0020) != 0) { r = r | 0x1000; }
    if (rekha_hint_push(ctx, r) == 0) { return 0 - 1; }
    return 1;
}

# DELTAC — n, then n pairs of (exception spec, control-value index), index on top.
# The spec byte splits into a ppem selector in its high nibble and a magnitude in its low one:
# the selector plus the delta base (plus 16 for C2 and 32 for C3) is the ppem this applies at, and
# the magnitude runs -8..-1, 1..8 in units of 1/(2^delta_shift) pixels.
fn rekha_hint_op_deltac(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var n = rekha_hint_pop(ctx);
    if (n < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC count") - 1; }
    var base = load64(ctx + HC_DBASE);
    if (op == 0x74) { base = base + 16; }
    if (op == 0x75) { base = base + 32; }
    var ppem = load64(ctx + HC_PPEM);
    var shift = load64(ctx + HC_DSHIFT);
    var k = 0;
    while (k < n) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var idx = rekha_hint_pop(ctx);
        var spec = rekha_hint_pop(ctx) & 0xFFFF;
        if (idx < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC index") - 1; }
        if (idx >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC index") - 1;
        }
        if (((spec >> 4) & 15) + base == ppem) {
            var mag = (spec & 15) - 8;
            if (mag >= 0) { mag = mag + 1; }
            var at = load64(ctx + HC_CVT) + idx * 8;
            store64(at, load64(at) + sd_asr(mag * 64, shift));
        }
        k = k + 1;
    }
    return 1;
}

# @public — GETVARIATION: the current normalized axis coordinates, one F2Dot14 per axis, first
# axis deepest. ⚠ rekha's own coordinates are 16.16 (src/var.cyr), so each one is brought down two
# bits here; a font asking this is asking what `rekha_var_set_axis` was last told.
fn rekha_hint_op_getvariation(ctx): i64 {
    var font = load64(ctx + HC_FONT);
    var n = rekha_var_axis_count(font);
    var i = 0;
    while (i < n) {
        if (rekha_hint_push(ctx, sd_asr(rekha_var_coord(font, i) + 2, 2)) == 0) { return 0 - 1; }
        i = i + 1;
    }
    return 1;
}

# The name of an instruction 0.8.0 knows and has not implemented, or 0 when the opcode is not one.
# ⛔ EVERY ONE OF THESE READS OR WRITES A POINT, which is what 0.8.0 does not have. They are named
# rather than skipped: skipping leaves the stack at a depth the next instruction is not written
# for, and the program after that is computing with someone else's operands.
fn rekha_hint_point_op(op): i64 {
    if (op == 0x06) { return "SPVTL"; }
    if (op == 0x07) { return "SPVTL"; }
    if (op == 0x08) { return "SFVTL"; }
    if (op == 0x09) { return "SFVTL"; }
    if (op == 0x0F) { return "ISECT"; }
    if (op == 0x27) { return "ALIGNPTS"; }
    if (op == 0x29) { return "UTP"; }
    if (op == 0x2E) { return "MDAP"; }
    if (op == 0x2F) { return "MDAP"; }
    if (op == 0x30) { return "IUP"; }
    if (op == 0x31) { return "IUP"; }
    if (op == 0x32) { return "SHP"; }
    if (op == 0x33) { return "SHP"; }
    if (op == 0x34) { return "SHC"; }
    if (op == 0x35) { return "SHC"; }
    if (op == 0x36) { return "SHZ"; }
    if (op == 0x37) { return "SHZ"; }
    if (op == 0x38) { return "SHPIX"; }
    if (op == 0x39) { return "IP"; }
    if (op == 0x3A) { return "MSIRP"; }
    if (op == 0x3B) { return "MSIRP"; }
    if (op == 0x3C) { return "ALIGNRP"; }
    if (op == 0x3E) { return "MIAP"; }
    if (op == 0x3F) { return "MIAP"; }
    if (op == 0x46) { return "GC"; }
    if (op == 0x47) { return "GC"; }
    if (op == 0x48) { return "SCFS"; }
    if (op == 0x49) { return "MD"; }
    if (op == 0x4A) { return "MD"; }
    if (op == 0x5D) { return "DELTAP1"; }
    if (op == 0x71) { return "DELTAP2"; }
    if (op == 0x72) { return "DELTAP3"; }
    if (op == 0x80) { return "FLIPPT"; }
    if (op == 0x81) { return "FLIPRGON"; }
    if (op == 0x82) { return "FLIPRGOFF"; }
    if (op == 0x86) { return "SDPVTL"; }
    if (op == 0x87) { return "SDPVTL"; }
    if (op >= 0xC0) {
        if (op <= 0xDF) { return "MDRP"; }
        return "MIRP";
    }
    return 0;
}

# An instruction the font defined for itself, as [start, end, buffer], or 0.
fn rekha_hint_find_idef(ctx, op): i64 {
    var n = load64(ctx + HC_IDEFN);
    var at = load64(ctx + HC_IDEF);
    var i = 0;
    while (i < n) {
        if (load64(at + i * 32) == op) { return at + i * 32 + 8; }
        i = i + 1;
    }
    return 0;
}

# Push `n` operands of `w` bytes each, starting at `at`. The two-byte form is SIGNED.
fn rekha_hint_do_push(ctx, buf, at, n, w): i64 {
    var i = 0;
    while (i < n) {
        var v = load8(buf + at + i);
        if (w == 2) { v = rekha_rd_i16(buf, at + i * 2); }
        if (rekha_hint_push(ctx, v) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# The executor. One program, from `ip` to `end`, both absolute offsets into `buf`.
# Answers 1 when the program ran to its end or hit an ENDF, 0 when it refused — and every 0 has a
# code and a detail on the context.
# ⚠ A CALL RECURSES HERE rather than pushing a return frame, which is how src/cff.cyr runs a subr
# and for the same reason: the nesting is the language's, the cap is rekha's.
# ================================================================
fn rekha_hint_exec(ctx, buf, ip, end): i64 {
    if (load64(ctx + HC_DEPTH) > REKHA_HINT_MAXDEPTH) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "call depth");
    }
    var base = ip;
    while (ip < end) {
        var bud = load64(ctx + HC_BUDGET);
        if (bud <= 0) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "instruction budget");
        }
        store64(ctx + HC_BUDGET, bud - 1);
        var op = load8(buf + ip);
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return rekha_hint_fail(ctx, REKHA_ERR_TRUNCATED, "push operands"); }
        if (ip + ln > end) { return rekha_hint_fail(ctx, REKHA_ERR_TRUNCATED, "instruction"); }
        var nip = ip + ln;
        var r = 0;
        # ── the eighteen push opcodes ──
        if (op == 0x40) {
            if (rekha_hint_do_push(ctx, buf, ip + 2, load8(buf + ip + 1), 1) == 0) { return 0; }
            r = 1;
        }
        if (op == 0x41) {
            if (rekha_hint_do_push(ctx, buf, ip + 2, load8(buf + ip + 1), 2) == 0) { return 0; }
            r = 1;
        }
        if (r == 0) {
            if (op >= 0xB0) {
                if (op <= 0xB7) {
                    if (rekha_hint_do_push(ctx, buf, ip + 1, op - 0xB0 + 1, 1) == 0) { return 0; }
                    r = 1;
                }
            }
        }
        if (r == 0) {
            if (op >= 0xB8) {
                if (op <= 0xBF) {
                    if (rekha_hint_do_push(ctx, buf, ip + 1, op - 0xB8 + 1, 2) == 0) { return 0; }
                    r = 1;
                }
            }
        }
        # ── IF / ELSE / EIF ──
        if (op == 0x58) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            if (rekha_hint_pop(ctx) == 0) {
                nip = rekha_hint_skip_if(buf, nip, end, 1);
                if (nip < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IF without EIF"); }
            }
            r = 1;
        }
        # An ELSE reached by execution means the THEN branch was taken and is over.
        if (op == 0x1B) {
            nip = rekha_hint_skip_if(buf, nip, end, 0);
            if (nip < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "ELSE without EIF"); }
            r = 1;
        }
        if (op == 0x59) { r = 1; }
        # ── the three jumps. ⛔ THE OFFSET IS RELATIVE TO THE JUMP INSTRUCTION ITSELF, not to the
        #    byte after it, so `JMPR 0` is an infinite loop and the instruction budget is what
        #    stops it. Both conditional forms take the CONDITION on top and the offset below. ──
        if (op == 0x1C) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            nip = ip + rekha_hint_pop(ctx);
            r = 1;
        }
        if (op == 0x78) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var c1 = rekha_hint_pop(ctx);
            var o1 = rekha_hint_pop(ctx);
            if (c1 != 0) { nip = ip + o1; }
            r = 1;
        }
        if (op == 0x79) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var c2 = rekha_hint_pop(ctx);
            var o2 = rekha_hint_pop(ctx);
            if (c2 == 0) { nip = ip + o2; }
            r = 1;
        }
        if (r == 1) {
            if (nip < base) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "jump out of range"); }
            if (nip > end)  { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "jump out of range"); }
        }
        # ── FDEF / IDEF: the body is SCANNED, never executed, which is why a font program made
        #    entirely of function definitions runs on an interpreter with no points. ──
        if (op == 0x2C) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            var fn1 = rekha_hint_pop(ctx);
            if (fn1 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF number"); }
            if (fn1 >= load64(ctx + HC_FDEFCAP)) {
                return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF over maxFunctionDefs");
            }
            var e1 = rekha_hint_scan_endf(buf, nip, end);
            if (e1 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF without ENDF"); }
            store64(load64(ctx + HC_FDEF) + fn1 * 24, nip);
            store64(load64(ctx + HC_FDEF) + fn1 * 24 + 8, e1);
            store64(load64(ctx + HC_FDEF) + fn1 * 24 + 16, buf);
            nip = e1 + 1;
            r = 1;
        }
        if (op == 0x89) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            var oc = rekha_hint_pop(ctx) & 0xFF;
            var ni = load64(ctx + HC_IDEFN);
            if (ni >= load64(ctx + HC_IDEFCAP)) {
                return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF over maxInstructionDefs");
            }
            var e2 = rekha_hint_scan_endf(buf, nip, end);
            if (e2 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF without ENDF"); }
            var slot = load64(ctx + HC_IDEF) + ni * 32;
            store64(slot, oc);
            store64(slot + 8, nip);
            store64(slot + 16, e2);
            store64(slot + 24, buf);
            store64(ctx + HC_IDEFN, ni + 1);
            nip = e2 + 1;
            r = 1;
        }
        # ── ENDF ends this call. At the top level of a program there is nothing to end. ──
        if (op == 0x2D) {
            if (load64(ctx + HC_DEPTH) == 0) {
                return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "ENDF outside a function");
            }
            return 1;
        }
        # ── CALL and LOOPCALL. ⭐ The FUNCTION is on top in both; LOOPCALL's count is below it,
        #    which real bytecode settled (see the header). ──
        if (op == 0x2B) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            if (rekha_hint_call(ctx, rekha_hint_pop(ctx), 1) == 0) { return 0; }
            r = 1;
        }
        if (op == 0x2A) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var lf = rekha_hint_pop(ctx);
            var lc = rekha_hint_pop(ctx);
            if (rekha_hint_call(ctx, lf, lc) == 0) { return 0; }
            r = 1;
        }
        if (op == 0x91) {
            var gv = rekha_hint_op_getvariation(ctx);
            if (gv < 0) { return 0; }
            r = 1;
        }
        # ── everything else, in three groups ──
        if (r == 0) {
            var h = rekha_hint_op_alu(ctx, op);
            if (h < 0) { return 0; }
            if (h > 0) { r = 1; }
        }
        if (r == 0) {
            var h2 = rekha_hint_op_gs(ctx, op);
            if (h2 < 0) { return 0; }
            if (h2 > 0) { r = 1; }
        }
        if (r == 0) {
            var nm = rekha_hint_point_op(op);
            if (nm != 0) { return rekha_hint_fail(ctx, REKHA_ERR_UNSUPPORTED, nm); }
            # An opcode the font defined for itself is the last thing it can be.
            var d = rekha_hint_find_idef(ctx, op);
            if (d == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "undefined opcode"); }
            store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) + 1);
            var ok = rekha_hint_exec(ctx, load64(d + 16), load64(d), load64(d + 8));
            store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) - 1);
            if (ok == 0) { return 0; }
        }
        ip = nip;
    }
    return 1;
}

# Run function `f` `count` times. ⚠ Each repetition costs a unit of the instruction budget on top
# of the body's own, so a LOOPCALL handed a hostile count is stopped by the same guard a JMPR loop
# is, and not by a separate cap that would have to be kept in step with it.
fn rekha_hint_call(ctx, f, count): i64 {
    if (f < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "function number"); }
    if (f >= load64(ctx + HC_FDEFCAP)) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "function number");
    }
    var at = load64(ctx + HC_FDEF) + f * 24;
    var start = load64(at);
    if (start == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "undefined function"); }
    var stop = load64(at + 8);
    # ⛔ THE BODY'S OWN BUFFER, NOT THE CALLER'S. A function defined by `fpgm` is a range into the
    # font bytes; one defined by any other program is a range into that program. Running a body
    # against whichever buffer happens to be executing reads whatever lies at those offsets and
    # calls it bytecode — found by programs/hint_test.cyr's CALL check, which got the untouched
    # operand back instead of the sum.
    var bbuf = load64(at + 16);
    var i = 0;
    while (i < count) {
        var bud = load64(ctx + HC_BUDGET);
        if (bud <= 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "instruction budget"); }
        store64(ctx + HC_BUDGET, bud - 1);
        store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) + 1);
        var ok = rekha_hint_exec(ctx, bbuf, start, stop);
        store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) - 1);
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# @public — run `len` bytes of bytecode at `off` in `buf`. 1 when it ran, 0 when it refused, with
# `rekha_hint_error` saying why. This is how the font program runs, how 0.8.1 will run `prep`, and
# how a test drives one instruction at a time.
# ⚠ THE BYTES ARE BORROWED. They must outlive the call, and a function defined by a program is
# recorded as a RANGE INTO THEM together with the buffer itself — so a program that defines one
# must live as long as the context, and a CALL runs the body against the buffer that DEFINED it
# rather than against the one that is executing.
# ⚠ Each call resets the instruction budget and the call depth; it does NOT reset the stack, the
# storage area, the control values or the graphics state, because a program is entitled to see
# what the one before it left.
fn rekha_hint_run(ctx, buf, off, len): i64 {
    if (ctx == 0) { return 0; }
    rekha_hint_error_clear(ctx);
    if (buf == 0) { return rekha_hint_fail(ctx, REKHA_ERR_OTHER, "program"); }
    if (len < 0) { return rekha_hint_fail(ctx, REKHA_ERR_OTHER, "program"); }
    if (len == 0) { return 1; }
    store64(ctx + HC_BUDGET, REKHA_HINT_BUDGET);
    store64(ctx + HC_DEPTH, 0);
    return rekha_hint_exec(ctx, buf, off, off + len);
}

# @public — run the font program. Called for you by `rekha_hint_ctx` on the first build and never
# again: `fpgm` defines functions, and a function is a range into font bytes that does not move
# with size. ⚠ It resets the graphics state first and marks the face done EVEN IF IT REFUSES, so a
# broken `fpgm` is reported once rather than re-run at every size.
fn rekha_hint_run_fpgm(ctx): i64 {
    if (ctx == 0) { return 0; }
    var font = load64(ctx + HC_FONT);
    rekha_hint_reset(ctx);
    store64(ctx + HC_FPGMOK, 1);
    var n = load64(font + 712);
    if (n <= 0) {
        rekha_hint_error_clear(ctx);
        return 1;
    }
    return rekha_hint_run(ctx, load64(ctx + HC_BUF), load64(font + 704), n);
}

# ================================================================
# Reading the graphics state.
# ⭐ ONE ACCESSOR, NOT TWENTY-SEVEN. The fields are laid out in this exact order from HC_PVX, so an
# index IS the offset, and a surface about to be frozen at 0.9.0 gains one name instead of a
# getter per field. ⚠ The bytecode can read four of these itself (GPV, GFV, and MPPEM / MPS for
# the size); the other twenty-three are write-only from inside a program, which is why a consumer
# — or a test — that wants to see what `prep` decided needs this.
# ================================================================
var REKHA_GS_PVX        = 0;    # projection vector, F2Dot14
var REKHA_GS_PVY        = 1;
var REKHA_GS_FVX        = 2;    # freedom vector
var REKHA_GS_FVY        = 3;
var REKHA_GS_DVX        = 4;    # dual projection vector
var REKHA_GS_DVY        = 5;
var REKHA_GS_RP0        = 6;    # the three reference points
var REKHA_GS_RP1        = 7;
var REKHA_GS_RP2        = 8;
var REKHA_GS_ZP0        = 9;    # the three zone pointers: 0 twilight, 1 glyph
var REKHA_GS_ZP1        = 10;
var REKHA_GS_ZP2        = 11;
var REKHA_GS_LOOP       = 12;
var REKHA_GS_ROUND      = 13;   # one of the REKHA_RND_* states
var REKHA_GS_PERIOD     = 14;   # SROUND's decomposition, all three F26Dot6
var REKHA_GS_PHASE      = 15;
var REKHA_GS_THRESHOLD  = 16;
var REKHA_GS_MINDIST    = 17;   # F26Dot6
var REKHA_GS_CVTCUTIN   = 18;   # F26Dot6
var REKHA_GS_SWCUTIN    = 19;   # F26Dot6
var REKHA_GS_SWVALUE    = 20;   # F26Dot6, scaled from font units by SSW
var REKHA_GS_AUTOFLIP   = 21;
var REKHA_GS_DELTABASE  = 22;
var REKHA_GS_DELTASHIFT = 23;
var REKHA_GS_INSTCTRL   = 24;
var REKHA_GS_SCANCTRL   = 25;
var REKHA_GS_SCANTYPE   = 26;
var REKHA_GS_COUNT      = 27;

# @public — one graphics-state field by its REKHA_GS_* index. 0 for a null context or an index
# outside the set, which is also a legal value for most of them.
fn rekha_hint_gs(ctx, field): i64 {
    if (ctx == 0) { return 0; }
    if (field < 0) { return 0; }
    if (field >= REKHA_GS_COUNT) { return 0; }
    return load64(ctx + HC_PVX + field * 8);
}
