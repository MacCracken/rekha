# @public — rekha library include chain.
# rekha (रेखा — line / outline / contour / stroke) — pure-Cyrius
# vector/outline font subsystem.
#
# Provides: TrueType/OpenType (SFNT) table parse + glyph-outline load,
# emitting resolution-independent PATHS for the `sadish` 2D vector core
# to rasterize (rekha does NOT bundle its own Bézier rasterizer). The
# scalable-typography sibling to `kashi`'s bitmap glyphs (PSF1/PSF2,
# VGA-ROM, hand-drawn).
#
# Stdlib includes live ONLY in this file — domain modules are flat,
# which is what makes `cyrius distlib` (strip-include concatenation)
# produce a compile-clean `dist/rekha.cyr`. Don't add stdlib includes
# in individual src/*.cyr files.

# ================================================================
# Standard library
# ================================================================
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"
include "lib/bench.cyr"

# sadish — the 2D vector rasterizer rekha emits glyph paths into (dep).
# rekha is sadish's first consumer. src/ calls sd_path_* and sd_asr (glyf.cyr)
# and the sd_alloc seam (error.cyr, sfnt.cyr, glyf.cyr); sd_canvas_* is
# test-only (programs/path_test.cyr) — rekha emits paths, not canvas ops.
include "lib/sadish.cyr"

# ================================================================
# rekha domain modules — flat, dependency order.
# error.cyr depends on nothing in rekha, and nothing in rekha calls it.
# sfnt.cyr (big-endian byte readers + the RekhaFont SFNT handle + the
# table cache) depends on neither; glyf.cyr (glyph-outline load + the
# rekha->sadish path-verb seam) sits atop sfnt.cyr; cmap.cyr uses both.
# ⚠ error.cyr stays FIRST: its rekha_err_new holds the first sd_alloc call
# in code order, and that site is what decides how a build against a sadish
# below the 0.5.5 floor degrades (see the [deps.sadish] note in cyrius.cyml).
# ================================================================
include "src/error.cyr"
include "src/sfnt.cyr"
include "src/glyf.cyr"
include "src/cmap.cyr"
include "src/cff.cyr"
