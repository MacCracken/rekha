# rekha.cyr -- bundled distribution
# Version: 0.3.11
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- error.cyr ---

# @public — stable API surface for rekha error handling.
# error.cyr — rekha vector/outline font error codes + Result helpers.
#
# RekhaErr is a 16-byte record (code + optional detail pointer). Error
# codes are integer constants; for errors that carry context (a message
# pointer), use rekha_err_new(code, msg).
#
# RekhaErr struct layout (16 bytes):
#   +0: code    — error code constant (one of the REKHA_* below)
#   +8: detail  — pointer to detail string (or 0)

# ================================================================
# Error code constants
# ================================================================

enum RekhaErrCode {
    REKHA_OK              = 0;   # no error
    REKHA_ERR_OOM         = 1;   # allocation failed / cap hit
    REKHA_ERR_BAD_SFNT    = 2;   # missing/corrupt SFNT header or table directory
    REKHA_ERR_TRUNCATED   = 3;   # input ends before a table/field completes
    REKHA_ERR_NO_TABLE    = 4;   # a required SFNT table (head/cmap/glyf/loca) is absent
    REKHA_ERR_BAD_GLYF    = 5;   # malformed glyf entry (bad contour/point counts)
    REKHA_ERR_UNSUPPORTED = 6;   # valid font but a feature rekha can't yet load
    REKHA_ERR_OTHER       = 99;  # catch-all
}

# ================================================================
# RekhaErr struct
# ================================================================

# Create a RekhaErr with code and an optional detail string (0 = none).
fn rekha_err_new(code, detail): i64 {
    var e = sd_alloc(16);
    store64(e, code);
    store64(e + 8, detail);
    return e;
}

# Create a RekhaErr with code only (no detail).
fn rekha_err(code): i64 {
    return rekha_err_new(code, 0);
}

# Get the error code.
fn rekha_err_code(e): i64 {
    return load64(e);
}

# Get the detail string pointer (or 0).
fn rekha_err_detail(e): i64 {
    return load64(e + 8);
}

# ================================================================
# Error name lookup — returns a cstring (never null).
# ================================================================

fn rekha_err_name(code): i64 {
    if (code == REKHA_OK)              { return "ok"; }
    if (code == REKHA_ERR_OOM)         { return "out of memory"; }
    if (code == REKHA_ERR_BAD_SFNT)    { return "bad SFNT header"; }
    if (code == REKHA_ERR_TRUNCATED)   { return "truncated input"; }
    if (code == REKHA_ERR_NO_TABLE)    { return "required table absent"; }
    if (code == REKHA_ERR_BAD_GLYF)    { return "malformed glyf entry"; }
    if (code == REKHA_ERR_UNSUPPORTED) { return "unsupported feature"; }
    if (code == REKHA_ERR_OTHER)       { return "other error"; }
    return "unknown error";
}

# Print an error name to stderr (fd 2).
fn rekha_err_print_name(code): i64 {
    var name = rekha_err_name(code);
    syscall(1, 2, name, strlen(name));
    return 0;
}

# --- sfnt.cyr ---

# @internal — SFNT container parse (TrueType / OpenType table directory).
# sfnt.cyr — turn untrusted font bytes into a RekhaFont: validate the
# SFNT header (sfnt version + numTables), resolve the tables rekha reads
# (head / maxp / loca / glyf / hhea / hmtx / cmap) ONCE at open, and expose
# the table directory.
#
# SFNT layout (Apple TT / OpenType spec, big-endian throughout):
#   Offset table (12 bytes):
#     +0  sfntVersion   u32  — 0x00010000 (TT) or 'OTTO' (CFF) or 'true'
#     +4  numTables     u16
#     +6  searchRange   u16
#     +8  entrySelector u16
#     +10 rangeShift    u16
#   Table directory (numTables × 16 bytes), each:
#     +0  tag           u32  — 4 ASCII bytes ('glyf','loca','head',…)
#     +4  checkSum      u32
#     +8  offset        u32  — byte offset of the table within the file
#     +12 length        u32
#
# ⛔ THE BOUNDS INVARIANT, AS ENFORCED (sfnt.cyr + cmap.cyr). Font files are untrusted input; each
# rule below is a check in code, not an aspiration:
#   1. The table directory lies inside [0, len) — rekha_font_open.
#   2. A table is usable only if it lies inside [dir_end, len), dir_end = 12 + numTables * 16 —
#      rekha_find_table_len. A table overlapping the header or directory is invalid, so offset 0
#      always means "absent or invalid".
#   3. A fixed field is read only when the table's DECLARED length covers it: head >= 54 B,
#      maxp >= 6 B, hhea >= 36 B. A shorter table is cached as absent — rekha_font_open.
#   4. Variable arrays are bounded by their OWN table's declared extent, never merely by `len`:
#      hmtx metrics by hmtx_len, loca entries by loca_len, glyph spans by glyf_len, cmap records /
#      the format-4 segment arrays / the glyphIdArray index by the cmap extent.
# ⚠ The glyph bytes inside a span are glyf.cyr's to bound; this file hands out only spans that
# lie inside glyf.

# ================================================================
# SFNT constants
# ================================================================
var REKHA_SFNT_OFFTAB_LEN = 12;   # offset table (header) byte length
var REKHA_SFNT_DIRENT_LEN = 16;   # one table-directory entry byte length

var REKHA_SFNT_VER_TT   = 65536;      # 0x00010000 — TrueType outlines
var REKHA_SFNT_VER_TRUE = 0x74727565; # 'true' — Apple TrueType
# 'OTTO' = 0x4F54544F — OpenType/CFF outlines: rejected (rekha reads glyf); CFF is on README's
# "v0.4.0 / staged" roadmap.

# Table tags — 4 ASCII bytes packed big-endian into an i64.
var REKHA_TAG_HEAD = 0x68656164;   # 'head'
var REKHA_TAG_MAXP = 0x6D617870;   # 'maxp'
var REKHA_TAG_LOCA = 0x6C6F6361;   # 'loca'
var REKHA_TAG_GLYF = 0x676C7966;   # 'glyf'
var REKHA_TAG_CMAP = 0x636D6170;   # 'cmap'
var REKHA_TAG_HHEA = 0x68686561;   # 'hhea'
var REKHA_TAG_HMTX = 0x686D7478;   # 'hmtx'

# ================================================================
# Big-endian byte readers — SFNT is big-endian on every field.
# `buf` is a raw byte pointer; `off` is a byte offset into it.
# ⚠ THESE READERS CHECK NOTHING. The caller proves `off + width` lies inside the table it is
# parsing BEFORE calling — via the invariant above (rekha_font_open's table cache and minimum
# lengths, rekha_find_table_len's extent rule, and each reader's own table-length test).
# ================================================================

# Read a big-endian unsigned 16-bit value.
fn rekha_rd_u16(buf, off): i64 {
    var b0 = load8(buf + off);
    var b1 = load8(buf + off + 1);
    return (b0 * 256) + b1;
}

# Read a big-endian unsigned 32-bit value.
fn rekha_rd_u32(buf, off): i64 {
    var hi = rekha_rd_u16(buf, off);
    var lo = rekha_rd_u16(buf, off + 2);
    return (hi * 65536) + lo;
}

# Read a big-endian signed 16-bit value (glyf coords are i16).
fn rekha_rd_i16(buf, off): i64 {
    var v = rekha_rd_u16(buf, off);
    if (v >= 32768) {
        return v - 65536;
    }
    return v;
}

# Read a signed 8-bit value (composite-glyph byte args).
fn rekha_rd_i8(buf, off): i64 {
    var v = load8(buf + off);
    if (v >= 128) {
        return v - 256;
    }
    return v;
}

# ================================================================
# RekhaFont — parsed SFNT handle (160 bytes).
#   +0   data        (ptr — the raw font byte buffer, borrowed not owned)
#   +8   len         (i64 — byte length of `data`)
#   +16  sfnt_ver    (i64 — sfntVersion u32; 0x00010000 = TrueType)
#   +24  num_tables  (i64 — numTables from the offset table)
#   +32  dir_off     (i64 — byte offset of the table directory = 12)
#   ---- table cache: resolved ONCE by rekha_font_open, every entry validated per the invariant ----
#   +40  upem        (i64 — head.unitsPerEm; 0 = head absent or shorter than 54 B)
#   +48  loca_fmt    (i64 — head.indexToLocFormat; 0 when head is absent or short)
#   +56  num_glyphs  (i64 — maxp.numGlyphs; 0 = maxp absent or shorter than 6 B)
#   +64  loca_off    (i64 — 0 = absent)      +72  loca_len  (i64 — declared length)
#   +80  glyf_off    (i64 — 0 = absent)      +88  glyf_len
#   +96  hhea_off    (i64 — 0 = hhea absent or shorter than 36 B)
#   +104 nhm         (i64 — hhea.numberOfHMetrics; 0 when hhea_off is 0)
#   +112 hmtx_off    (i64 — 0 = absent)      +120 hmtx_len
#   +128 cmap_off    (i64 — 0 = absent)      +136 cmap_len
#   +144 cmap_sub    (i64 — absolute offset of the chosen format-4 subtable, its segment arrays
#                     validated inside the cmap extent; 0 = none usable)
#   +152 cmap_segc2  (i64 — that subtable's segCountX2 (>= 2); 0 when cmap_sub is 0)
#
# ⭐ WHY A CACHE. Every reader used to re-walk the table directory per call — rekha_char_advance_px
# walked it for head, cmap, hhea and hmtx on every character, rekha_char_to_sdpath for cmap, maxp,
# loca, glyf and head. The walk is linear in numTables, which the font chooses. Resolving once at
# open makes every reader below a handful of loads with zero directory walks. MEASURED 0.3.11,
# LiberationSans (19 tables), median of 3: rekha_char_advance_px 787 -> 47 ns, rekha_glyf_span
# 785 -> 33 ns, rekha_char_to_sdpath 2,473 -> 1,516 ns; rekha_font_open pays 36 -> ~1,500 ns ONCE.
# ⚠ THE BUFFER IS BORROWED AND THE CACHE IS A SNAPSHOT. Mutating the font bytes after
# rekha_font_open is unsupported: the cached offsets keep reads inside `len`, but upem / numGlyphs
# / numberOfHMetrics / the cmap subtable choice would describe the bytes as they were at open.
# ⚠ The accessors below dereference the handle unchecked; the PUBLIC readers (units_per_em,
# glyph_count, hhea/hmtx, char_to_glyph, ...) each return 0 for a 0 handle.
# ================================================================
var REKHA_FONT_SIZE = 160;

fn rekha_font_data(f): i64       { return load64(f); }
fn rekha_font_len(f): i64        { return load64(f + 8); }
fn rekha_font_sfnt_ver(f): i64   { return load64(f + 16); }
fn rekha_font_num_tables(f): i64 { return load64(f + 24); }
fn rekha_font_dir_off(f): i64    { return load64(f + 32); }

# Open a font from an in-memory (buf, len). Parses the SFNT offset table
# (sfntVersion + numTables), records the table-directory offset and resolves the
# table cache (RekhaFont layout above).
# Returns a RekhaFont pointer, or 0 when `buf` is 0, len < 12, sfntVersion is not
# 0x00010000 / 'true' (OTTO/CFF: README "v0.4.0 / staged"), the table directory
# overruns `len`, or the allocation fails. The caller treats 0 as "not a usable
# TrueType font"; no distinct RekhaErr code is surfaced.
#
# ⚠ A MISSING OR MALFORMED TABLE NEVER FAILS THE OPEN. It is cached as absent and the reader that
# needs it returns 0 ("unknown") — the same fonts open as before the cache existed.
# Allocation: exactly one sd_alloc(REKHA_FONT_SIZE).
fn rekha_font_open(buf, len): i64 {
    if (buf == 0) { return 0; }
    if (len < REKHA_SFNT_OFFTAB_LEN) { return 0; }
    var ver = rekha_rd_u32(buf, 0);
    if (ver != REKHA_SFNT_VER_TT) {
        if (ver != REKHA_SFNT_VER_TRUE) { return 0; }
    }
    var n = rekha_rd_u16(buf, 4);
    # the directory (numTables entries) must lie within the file
    if (REKHA_SFNT_OFFTAB_LEN + n * REKHA_SFNT_DIRENT_LEN > len) { return 0; }

    var f = sd_alloc(REKHA_FONT_SIZE);
    if (f == 0) { return 0; }
    store64(f, buf);
    store64(f + 8, len);
    store64(f + 16, ver);
    store64(f + 24, n);
    store64(f + 32, REKHA_SFNT_OFFTAB_LEN);
    rekha_font_resolve(f);
    return f;
}

# Fill the table cache (+40..+159) of a RekhaFont whose +0..+32 header fields are set.
# Every table goes through rekha_find_table_len (extent rule) and, where a fixed field is read,
# a minimum declared length. Stack cell only — 0 B of heap.
fn rekha_font_resolve(f): i64 {
    var buf = load64(f);
    var c: i64[1];

    var upem = 0;
    var lfmt = 0;
    var head = rekha_find_table_len(f, REKHA_TAG_HEAD, &c);
    if (head != 0) {
        if (load64(&c) >= 54) {
            upem = rekha_rd_u16(buf, head + 18);
            lfmt = rekha_rd_u16(buf, head + 50);
        }
    }
    store64(f + 40, upem);
    store64(f + 48, lfmt);

    var ng = 0;
    var maxp = rekha_find_table_len(f, REKHA_TAG_MAXP, &c);
    if (maxp != 0) {
        if (load64(&c) >= 6) { ng = rekha_rd_u16(buf, maxp + 4); }
    }
    store64(f + 56, ng);

    store64(f + 64, rekha_find_table_len(f, REKHA_TAG_LOCA, &c));
    store64(f + 72, load64(&c));
    store64(f + 80, rekha_find_table_len(f, REKHA_TAG_GLYF, &c));
    store64(f + 88, load64(&c));

    var hhea = rekha_find_table_len(f, REKHA_TAG_HHEA, &c);
    var nhm = 0;
    if (hhea != 0) {
        if (load64(&c) >= 36) {
            nhm = rekha_rd_u16(buf, hhea + 34);
        } else {
            hhea = 0;
        }
    }
    store64(f + 96, hhea);
    store64(f + 104, nhm);

    store64(f + 112, rekha_find_table_len(f, REKHA_TAG_HMTX, &c));
    store64(f + 120, load64(&c));
    store64(f + 128, rekha_find_table_len(f, REKHA_TAG_CMAP, &c));
    store64(f + 136, load64(&c));

    # cmap.cyr's resolver reads cmap_off / cmap_len from the cache just stored
    var sub = rekha_cmap_subtable(f);
    var segc2 = 0;
    if (sub != 0) { segc2 = rekha_rd_u16(buf, sub + 6); }
    store64(f + 144, sub);
    store64(f + 152, segc2);
    return 0;
}

# Locate a table by its 4-byte tag (packed big-endian into an i64, e.g.
# 'glyf' = 0x676C7966). Returns the table's byte offset within the font data
# and stores its declared LENGTH in `len_out` (an 8-byte cell).
#
# Returns 0 with *len_out = 0 when the handle is 0, the tag is absent, or the
# FIRST directory entry carrying the tag breaks the extent rule: the table must
# start at or after the end of the directory (offset >= dir_end) and end within
# the font (offset + length <= len). A lying directory entry never hands out a
# span outside the file or over the header.
# ⚠ The declared length may be anything the extent allows, 0 included — a caller that
# reads a fixed field checks the length covers it (rekha_font_resolve does, once).
fn rekha_find_table_len(f, tag, len_out): i64 {
    store64(len_out, 0);
    if (f == 0) { return 0; }
    var buf = rekha_font_data(f);
    var len = rekha_font_len(f);
    var n = rekha_font_num_tables(f);
    var dir = rekha_font_dir_off(f);
    var dir_end = dir + n * REKHA_SFNT_DIRENT_LEN;
    var i = 0;
    while (i < n) {
        var ent = dir + i * REKHA_SFNT_DIRENT_LEN;
        if (rekha_rd_u32(buf, ent) == tag) {
            var off = rekha_rd_u32(buf, ent + 8);
            var tlen = rekha_rd_u32(buf, ent + 12);
            if (off < dir_end) { return 0; }
            if (off + tlen > len) { return 0; }
            store64(len_out, tlen);
            return off;
        }
        i = i + 1;
    }
    return 0;
}

# Like rekha_find_table_len, offset only: the table's byte offset, or 0 if the
# tag is absent or its entry breaks the extent rule. One directory walk; the
# discarded length lives in a stack cell (0 B of heap).
fn rekha_find_table(f, tag): i64 {
    var c: i64[1];
    return rekha_find_table_len(f, tag, &c);
}

# ================================================================
# Font metadata — head + maxp (cached at open).
# ================================================================

# head.unitsPerEm (u16 at head+18) — the em-square size; glyph coords are in
# these design units and the consumer scales by pixel_size / unitsPerEm.
# Returns 0 if the handle is 0 or head is absent / shorter than 54 B.
fn rekha_units_per_em(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 40);
}

# head.indexToLocFormat (at head+50): 0 = short loca (u16 offsets, doubled),
# 1 = long loca (u32 offsets). Returns 0 (short) if the handle is 0 or head is
# absent / shorter than 54 B. Any other value is returned as read, and
# rekha_glyf_span refuses it (no outline).
fn rekha_loca_format(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 48);
}

# Number of glyphs in the font (maxp.numGlyphs — u16 at maxp+4).
# Returns 0 if the handle is 0 or maxp is absent / shorter than 6 B.
fn rekha_glyph_count(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 56);
}

# ================================================================
# hhea + hmtx — horizontal metrics.
#
# ⛔⛔ THESE TWO TAGS WERE DECLARED AND NEVER READ, AND THAT ABSENCE WAS LOAD-BEARING DOWNSTREAM.
# `REKHA_TAG_HHEA` / `REKHA_TAG_HMTX` sat in the constant block above with no reader, so every
# consumer laying out a line of scalable text had to invent an advance. dhancha hard-coded
# `advf = (h * 6) / 10` — "fixed advance ~0.6 em" — which makes a proportional face render at
# monospace pitch: correct-looking glyphs at wrong positions, which reads as a rendering bug rather
# than a missing metric. ⇒ A declared tag with no reader is a promise, not a feature.
#
# hhea (36 bytes, big-endian):
#   +0  version Fixed · +4 ascender i16 · +6 descender i16 · +8 lineGap i16
#   +10 advanceWidthMax u16 · +12..+22 bearings/caret i16 · +24..+31 reserved
#   +32 metricDataFormat i16 · +34 numberOfHMetrics u16
#
# hmtx (variable, big-endian) — TWO arrays, and the second one is the whole subtlety:
#   longHorMetric[numberOfHMetrics]          — 4 bytes each: advanceWidth u16, lsb i16
#   leftSideBearing[numGlyphs - numberOfHMetrics] — 2 bytes each, NO advance of their own
# ⛔ THE TAIL IS NOT A BUG IN THE FONT, IT IS THE FORMAT'S COMPRESSION. A run of glyphs sharing the
# LAST advance (the common case: a monospaced tail, or a CJK block) stores that advance once. A
# reader that indexes `hmtx + gid * 4` past `numberOfHMetrics` walks into the lsb array and returns
# a bearing as if it were a width.
# ================================================================

# @public — hhea.numberOfHMetrics: how many glyphs carry their own advance.
# Returns 0 if the handle is 0 or hhea is absent / shorter than its 36-byte fixed part, which
# callers must treat as "no metrics".
fn rekha_num_h_metrics(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 104);
}

# @public — hhea.ascender / .descender / .lineGap, in design units.
# ⚠ `descender` is NEGATIVE in every well-formed font (it measures downward from the baseline);
# returning it signed rather than as a magnitude is deliberate, so `asc - desc + gap` is the line
# height without the caller having to know which way it points.
# Each returns 0 for a 0 handle or an absent / short hhea; hhea_off is non-zero only when the
# table declares >= 36 B, so +4..+9 are inside it.
fn rekha_ascender(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 4);
}

fn rekha_descender(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 6);
}

fn rekha_line_gap(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 8);
}

# @public — the advance width of glyph `gid`, in font DESIGN UNITS (unitsPerEm space).
# Returns 0 if the glyph has no readable metric — a 0 handle, hhea/hmtx absent, numberOfHMetrics 0,
# a negative gid, or a long metric that lies past hmtx's DECLARED length (a truncated hmtx, or an
# hhea claiming more metrics than hmtx holds, reads as unknown — never as the next table's bytes).
#
# ⛔ 0 IS "UNKNOWN", NOT "ZERO-WIDTH", and the caller must not paint with it. A zero advance stacks
# every glyph on the same x. Consumers should fall back to their own estimate when this returns 0 —
# which is exactly what a font with no hmtx forces anyway.
# ⛔ THE CLAMP AT `numberOfHMetrics - 1` IS THE FORMAT, NOT A GUESS. Glyphs past that index share the
# last long metric's advance; only their left side bearings are stored individually. Reading
# `hmtx + gid * 4` for them would return an lsb pair as a width. (A gid past numGlyphs clamps the
# same way; rekha_char_to_glyph never produces one.)
# ⚠ Design units, not pixels. Scale with `rekha_units_per_em`: `px = adv * size / upem`, or use
# rekha_glyph_advance_px / rekha_glyph_advance_fx below.
fn rekha_advance_width(font, gid): i64 {
    if (font == 0) { return 0; }
    if (gid < 0) { return 0; }
    var nhm = load64(font + 104);
    if (nhm <= 0) { return 0; }
    var hmtx = load64(font + 112);
    if (hmtx == 0) { return 0; }
    var idx = gid;
    if (idx >= nhm) { idx = nhm - 1; }
    if ((idx + 1) * 4 > load64(font + 120)) { return 0; }
    return rekha_rd_u16(load64(font), hmtx + idx * 4);
}

# @public — the advance of glyph `gid` in PIXELS at pixel size `px_size`, rounded half-up:
# `(adv * px_size + upem / 2) / upem`. 0 = unknown (upem <= 0 or advance <= 0). Allocates 0 B.
# ⭐ The gid-level form exists so a consumer maps a codepoint ONCE and reuses the gid for
# rekha_glyph_to_sdpath and every advance pass; rekha_char_advance_px is this plus a cmap lookup.
fn rekha_glyph_advance_px(font, gid, px_size): i64 {
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var adv = rekha_advance_width(font, gid);
    if (adv <= 0) { return 0; }
    return (adv * px_size + upem / 2) / upem;
}

# @public — the advance of glyph `gid` at pixel size `px_size` as 16.16 FIXED-POINT pixels
# (sadish's convention): `(adv * px_size * 65536 + upem / 2) / upem`. 0 = unknown, as above.
# ⭐ THIS IS THE ONE TO ACCUMULATE. Summing per-glyph-rounded pixel advances still drifts — each
# rounding is off by up to half a pixel and the errors add. Sum the 16.16 advances into the pen and
# round the pen once when placing a glyph; the run width is then exact to 1/65536 px per glyph.
# adv <= 65535, so the product fits i64 for any px_size below 2^31.
fn rekha_glyph_advance_fx(font, gid, px_size): i64 {
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var adv = rekha_advance_width(font, gid);
    if (adv <= 0) { return 0; }
    return (adv * px_size * 65536 + upem / 2) / upem;
}

# ================================================================
# loca -> glyf span: resolve glyph `gid` to its byte range in the glyf table.
# `out` is a 16-byte cell: out+0 = absolute file offset of the glyph's glyf
# entry, out+8 = its length. Returns 1 if the glyph has an outline, 0 if:
#   - the handle is 0, or gid < 0 or gid >= maxp.numGlyphs;
#   - loca or glyf is absent, or indexToLocFormat is neither 0 nor 1;
#   - loca[gid + 1] lies past loca's DECLARED length;
#   - the glyph is empty (e.g. space: loca[gid] == loca[gid+1]) or its offsets run backwards;
#   - the span ends past glyf's DECLARED length.
# ⚠ A last glyph whose end overshoots glyf is refused, not clamped to glyf's end (FreeType clamps):
# a lying loca yields no outline, never bytes from the table after glyf.
# ================================================================
fn rekha_glyf_span(font, gid, out): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    if (font == 0) { return 0; }
    if (gid < 0) { return 0; }
    if (gid >= load64(font + 56)) { return 0; }
    var loca = load64(font + 64);
    if (loca == 0) { return 0; }
    var glyf = load64(font + 80);
    if (glyf == 0) { return 0; }
    var buf = load64(font);
    var loca_len = load64(font + 72);
    var fmt = load64(font + 48);

    var o0 = 0;
    var o1 = 0;
    if (fmt == 0) {
        # short: two u16 offsets (bytes = value*2); loca[gid+1] inside loca
        if ((gid + 2) * 2 > loca_len) { return 0; }
        o0 = rekha_rd_u16(buf, loca + gid * 2) * 2;
        o1 = rekha_rd_u16(buf, loca + (gid + 1) * 2) * 2;
    } else {
        if (fmt != 1) { return 0; }    # the spec allows only 0 and 1
        if ((gid + 2) * 4 > loca_len) { return 0; }
        o0 = rekha_rd_u32(buf, loca + gid * 4);
        o1 = rekha_rd_u32(buf, loca + (gid + 1) * 4);
    }
    if (o1 <= o0) { return 0; }        # empty glyph
    if (o1 > load64(font + 88)) { return 0; }
    store64(out, glyf + o0);
    store64(out + 8, o1 - o0);
    return 1;
}

# --- glyf.cyr ---

# @internal — glyf-table outline loader + the sadish path seam.
# glyf.cyr — read a TrueType glyph's outline (contours of on-curve /
# off-curve points) out of the 'glyf' table and emit it as sadish path verbs
# (moveto / lineto / quadto / close) appended to an SdPath.
#
# rekha does NOT rasterize. It emits RESOLUTION-INDEPENDENT PATHS; the
# `sadish` 2D vector core consumes those verbs and fills them to pixels.
# This module is the seam between the two: rekha_outline_to_sdpath walks a
# RekhaOutline and appends each verb to a sadish SdPath. sadish is a wired,
# hard dependency (src/lib.cyr includes it).
#
# TrueType glyf entry (per glyph, big-endian):
#   +0  numberOfContours  i16  (>= 0 simple; < 0 composite)
#   +2  xMin/yMin/xMax/yMax i16 x4 (bounding box)
#   ... endPtsOfContours[numberOfContours] u16
#   ... instructionLength u16 + instructions[]
#   ... flags[] (run-length) then x-coords then y-coords (delta-encoded)
# Glyph N's byte span within 'glyf' is loca[N]..loca[N+1] (the loca table).

# ================================================================
# RekhaOutline — a decoded glyph outline (48 bytes).
# Point coords are in font design units (unitsPerEm space); the consumer
# scales. Contour structure is captured as parallel arrays so
# rekha_outline_to_sdpath can reconstruct on-curve/off-curve runs into
# quadratic segments.
#
#   +0   n_contours   (i64 — number of closed contours; 0 = empty glyph)
#   +8   n_points     (i64 — total point count across all contours)
#   +16  end_pts      (ptr — i64[n_contours] last-point index per contour, or 0)
#   +24  xs           (ptr — i64[n_points] x coords in design units, or 0)
#   +32  ys           (ptr — i64[n_points] y coords in design units, or 0)
#   +40  on_curve     (ptr — u8[n_points] 1 = on-curve, 0 = off-curve, or 0)
#
# ⭐ WHAT THE LOADERS GUARANTEE: end_pts STRICTLY increase and every one is < n_points, and the four
# arrays are carved from the SAME allocation as the record (record first, then end_pts, xs, ys,
# on_curve) — one sd_alloc per decoded glyph.
#
# ⭐ EVERY BYTE THIS MODULE ALLOCATES COMES FROM sadish's SEAM (`sd_alloc`, sadish >= 0.5.5), NOT
# THE STDLIB `alloc`. rekha already hard-depends on sadish (rekha_outline_to_sdpath builds SdPaths),
# so the draw stack has ONE allocation knob, owned by the leaf — the way it has one fixed-point
# convention (16.16, sadish's). A consumer that scopes `sd_alloc_set` around a text draw gets the
# outlines, the paths and the coverage from the same place, and a per-frame arena reclaims all
# three at once. Before 0.3.10 the outline scratch (span, end_pts, flags, on_curve, xs, ys, the
# record) came from the global bump allocator, which has no free(): MEASURED 136 B per
# rekha_char_to_sdpath of a 3-point glyph, PER GLYPH PER LABEL PER FRAME, leaking under a
# consumer's hook even after sadish 0.5.5 had moved the 4,192 B path onto it (dhancha's filing,
# 2026-09-13-scalable-text-allocates-per-call-outside-the-frame-arena.md).
# 0.3.11 carves each glyph into one block (the span lives on the stack, the flag bytes ride in
# on_curve): MEASURED 112 B for that 3-point glyph, and a composite costs its children + an
# n-slot pointer array + one exact-size merged block — MEASURED 232 B for alloc_test's
# one-component composite, which 0.3.10 paid 70,856 B for (fixed 4096-point merge buffers).
# ⚠ `rekha_font_open`'s 160-byte RekhaFont lands in the hook too when one is set. A font outlives
# every frame, so a consumer opens fonts OUTSIDE a scoped hook. Reading one costs nothing:
# rekha_char_to_glyph / rekha_advance_width / rekha_units_per_em allocate 0 B (MEASURED).
# ⛔ A pointer that outlives the hook's backing store is dangling. An outline or a path made under
# an arena hook must not be kept across that arena's reset; that is the consumer's lifetime call,
# exactly as it is for sadish's own paths.
# ⛔ A HOOK THAT CAN REFUSE MUST STILL FALL BACK TO THE GLOBAL ALLOCATOR, NOT RETURN 0. rekha's own
# sites all check now: the loaders return 0 ("0 only on OOM") instead of storing through a refused
# block, and rekha_outline_to_sdpath maps a 0 outline to an empty path. sadish does not: sd_path_new
# checks only its 48 B record, and the verb / point pushes and every SdPoint store through their
# blocks unchecked. MEASURED with a hook that grants its first K blocks and then returns 0: when
# the refusal lands on a rekha site, rekha_char_to_sdpath returns 0 (rc 0 — 0.3.10 faulted, rc 139);
# when it lands on sadish's verb buffer, the draw still faults (rc 139). So a hook backed by an
# arena that can refuse must do what dhancha's `dh_falloc` does ("exhaustion degrades to a leak,
# never to a null deref").
# ================================================================
var REKHA_OUTLINE_SIZE = 48;

fn rekha_outline_n_contours(o): i64 { return load64(o); }
fn rekha_outline_n_points(o): i64   { return load64(o + 8); }
fn rekha_outline_end_pts(o): i64    { return load64(o + 16); }
fn rekha_outline_xs(o): i64         { return load64(o + 24); }
fn rekha_outline_ys(o): i64         { return load64(o + 32); }
fn rekha_outline_on_curve(o): i64   { return load64(o + 40); }

# Zero an outline record in place, making it a valid empty outline. Returns `o`. A loader that
# finds malformed data AFTER carving its block returns the block this way rather than allocating
# a second, empty record.
fn rekha_outline_clear(o): i64 {
    store64(o, 0);
    store64(o + 8, 0);
    store64(o + 16, 0);
    store64(o + 24, 0);
    store64(o + 32, 0);
    store64(o + 40, 0);
    return o;
}

# Allocate an empty outline (all fields zeroed). Returns 0 on OOM.
fn rekha_outline_empty(): i64 {
    var o = sd_alloc(REKHA_OUTLINE_SIZE);
    if (o == 0) {
        return 0;
    }
    return rekha_outline_clear(o);
}

# ================================================================
# Load caps. They bound what ONE rekha_load_glyph may decode and allocate, whatever the font says —
# an attacker writes maxp too, so none of them is read from the font.
#
#   REKHA_COMPOSITE_MAXP        points in ONE outline: a simple glyph declaring more, or a
#                               composite whose children sum to more, is REJECTED (empty) — never
#                               clamped, since a clamped point array under unclamped end_pts is an
#                               out-of-bounds read at emit.
#   REKHA_COMPOSITE_MAXC        contours in one composite outline (rejected past it, as above).
#   REKHA_COMPOSITE_MAXDEPTH    component nesting; depth 0 is the glyph asked for.
#   REKHA_GLYPH_MAXLOADS        glyph loads per rekha_load_glyph, the root included.
#   REKHA_GLYPH_MAXPOINTS_TOTAL points decoded across the whole load: every simple glyph's np plus
#                               every composite's merged total.
# ⛔ The last two are the load-bearing DoS bound. Depth alone let a composite whose N components
# reference one glyph (itself, or an acyclic chain of them) decode sum N^L bodies; cycle detection
# alone does not catch the acyclic case. Tripping either one ABORTS the whole load — sticky, the
# top-level result is an EMPTY outline, never a partial one — and so does a depth overrun or a gid
# that already sits on its own component stack.
# ================================================================
var REKHA_COMPOSITE_MAXP        = 4096;
var REKHA_COMPOSITE_MAXC        = 128;
var REKHA_COMPOSITE_MAXDEPTH    = 5;
var REKHA_GLYPH_MAXLOADS        = 64;
var REKHA_GLYPH_MAXPOINTS_TOTAL = 16384;

# The load context lives on rekha_load_glyph's STACK (0 B of heap), as i64 slots:
#   +0  loads remaining      +8  points remaining      +16  abort (0 / 1)
#   +24 gid stack: the gid being loaded at depth d sits at +24 + d*8, d = 0..MAXDEPTH
# ⛔ 3 + (REKHA_COMPOSITE_MAXDEPTH + 1) slots — rekha_load_glyph declares 9. Raise both together.
fn rekha_load_abort(ctx): i64 {
    store64(ctx + 16, 1);
    return rekha_outline_empty();
}

# ================================================================
# glyf access — load + path emit. (rekha_glyph_count, a maxp reader, lives in sfnt.cyr.)
# Every byte a loader reads lies inside the glyph's span [start, end), which rekha_glyf_span has
# already bounded by glyf's declared length; a read that would leave the span returns an empty
# outline.
# ================================================================

# Parse a SIMPLE glyph (numberOfContours nc > 0) spanning [start, end). Arrays
# are i64 (xs/ys/end_pts) + u8 (on_curve); coords are absolute (delta-decoded)
# design units. Empty for a truncated glyph, for endPtsOfContours that do not
# strictly increase, for np > REKHA_COMPOSITE_MAXP, and for more points than the
# remaining bytes could carry as flags. 0 only on OOM.
fn rekha_load_simple(font, start, end, nc, ctx): i64 {
    var buf = rekha_font_data(font);
    var p = start + 10;                    # skip numberOfContours(2) + bbox(8)
    if (p + nc * 2 > end) { return rekha_outline_empty(); }
    # O(1) gates FIRST: the LAST endPt sizes the arrays; strict increase is walked below, once the
    # glyph has been charged. ⛔ Walking all nc endPts before any cap let a composite of 63 rejected
    # 32,767-contour glyphs spend ~2 M iterations in one load — MEASURED 9.6 ms, outside every budget.
    var np = rekha_rd_u16(buf, p + (nc - 1) * 2) + 1;
    if (nc > np) { return rekha_outline_empty(); }
    if (np > REKHA_COMPOSITE_MAXP) { return rekha_outline_empty(); }
    var eps_at = p;
    p = p + nc * 2;

    if (p + 2 > end) { return rekha_outline_empty(); }
    var instr_len = rekha_rd_u16(buf, p);
    p = p + 2 + instr_len;
    if (p > end) { return rekha_outline_empty(); }
    # Two flag bytes (flag + REPEAT count) declare at most 256 points, so a glyph whose np exceeds
    # what its remaining bytes could encode is refused BEFORE it costs an allocation.
    if (np > (end - p) * 128 + 1) { return rekha_outline_empty(); }
    # Charged BEFORE the O(nc) walk (nc <= np), so the walk itself is inside the points budget.
    var pts_left = load64(ctx + 8) - np;
    if (pts_left < 0) { return rekha_load_abort(ctx); }
    store64(ctx + 8, pts_left);
    # ⛔ STRICTLY INCREASING, so the last endPt bounds every contour: an earlier endPt past np would
    # walk emit off the point arrays.
    var last = 0 - 1;
    var i = 0;
    while (i < nc) {
        var ep = rekha_rd_u16(buf, eps_at + i * 2);
        if (ep <= last) { return rekha_outline_empty(); }
        last = ep;
        i = i + 1;
    }

    var o = sd_alloc(REKHA_OUTLINE_SIZE + nc * 8 + np * 17);
    if (o == 0) { return 0; }
    var end_pts = o + REKHA_OUTLINE_SIZE;
    var xs = end_pts + nc * 8;
    var ys = xs + np * 8;
    var on_curve = ys + np * 8;
    # ⚠ The bytes are fetched AGAIN here, across an sd_alloc a hook could use to rewrite a shared
    # buffer, so the check is repeated on what is STORED — the guarantee emit and the composite
    # merge rely on is about end_pts, not about the font bytes.
    last = 0 - 1;
    i = 0;
    while (i < nc) {
        var ep2 = rekha_rd_u16(buf, eps_at + i * 2);
        if (ep2 <= last) { return rekha_outline_clear(o); }
        store64(end_pts + i * 8, ep2);
        last = ep2;
        i = i + 1;
    }
    if (last != np - 1) { return rekha_outline_clear(o); }

    # The raw flag bytes decode INTO on_curve; the y pass (their last reader) masks each to 0/1.
    var fi = 0;
    while (fi < np) {
        if (p >= end) { return rekha_outline_clear(o); }
        var fl = load8(buf + p);
        p = p + 1;
        store8(on_curve + fi, fl);
        fi = fi + 1;
        if ((fl & 8) != 0) {
            if (p >= end) { return rekha_outline_clear(o); }
            var rep = load8(buf + p);
            p = p + 1;
            if (rep > np - fi) { rep = np - fi; }
            var r = 0;
            while (r < rep) {
                store8(on_curve + fi, fl);
                fi = fi + 1;
                r = r + 1;
            }
        }
    }

    var x = 0;
    var xi = 0;
    while (xi < np) {
        var fx = load8(on_curve + xi);
        var dx = 0;
        if ((fx & 2) != 0) {
            if (p >= end) { return rekha_outline_clear(o); }
            dx = load8(buf + p);
            p = p + 1;
            if ((fx & 16) == 0) { dx = 0 - dx; }
        } else {
            if ((fx & 16) == 0) {
                if (p + 2 > end) { return rekha_outline_clear(o); }
                dx = rekha_rd_i16(buf, p);
                p = p + 2;
            }
        }
        x = x + dx;
        store64(xs + xi * 8, x);
        xi = xi + 1;
    }

    var y = 0;
    var yi = 0;
    while (yi < np) {
        var fy = load8(on_curve + yi);
        store8(on_curve + yi, fy & 1);
        var dy = 0;
        if ((fy & 4) != 0) {
            if (p >= end) { return rekha_outline_clear(o); }
            dy = load8(buf + p);
            p = p + 1;
            if ((fy & 32) == 0) { dy = 0 - dy; }
        } else {
            if ((fy & 32) == 0) {
                if (p + 2 > end) { return rekha_outline_clear(o); }
                dy = rekha_rd_i16(buf, p);
                p = p + 2;
            }
        }
        y = y + dy;
        store64(ys + yi * 8, y);
        yi = yi + 1;
    }

    store64(o, nc);
    store64(o + 8, np);
    store64(o + 16, end_pts);
    store64(o + 24, xs);
    store64(o + 32, ys);
    store64(o + 40, on_curve);
    return o;
}

# Parse the component record at p into `rec` (i64[8]: flags, glyphIndex, arg1, arg2, xx, xy, yx,
# yy — the 2x2 in F2Dot14, identity when absent). arg1/arg2 are SIGNED offsets when
# ARGS_ARE_XY_VALUES is set and UNSIGNED point numbers when it is clear. Returns the offset past
# the record, or 0 if the record does not fit in [p, end).
fn rekha_comp_record(buf, p, end, rec): i64 {
    if (p + 4 > end) { return 0; }
    var flags = rekha_rd_u16(buf, p);
    store64(rec, flags);
    store64(rec + 8, rekha_rd_u16(buf, p + 2));
    p = p + 4;
    if ((flags & 1) != 0) {                    # ARG_1_AND_2_ARE_WORDS
        if (p + 4 > end) { return 0; }
        if ((flags & 2) != 0) {
            store64(rec + 16, rekha_rd_i16(buf, p));
            store64(rec + 24, rekha_rd_i16(buf, p + 2));
        } else {
            store64(rec + 16, rekha_rd_u16(buf, p));
            store64(rec + 24, rekha_rd_u16(buf, p + 2));
        }
        p = p + 4;
    } else {
        if (p + 2 > end) { return 0; }
        if ((flags & 2) != 0) {
            store64(rec + 16, rekha_rd_i8(buf, p));
            store64(rec + 24, rekha_rd_i8(buf, p + 1));
        } else {
            store64(rec + 16, load8(buf + p));
            store64(rec + 24, load8(buf + p + 1));
        }
        p = p + 2;
    }
    var xx = 16384;                            # 1.0 in F2Dot14 (identity)
    var xy = 0;
    var yx = 0;
    var yy = 16384;
    if ((flags & 8) != 0) {                    # WE_HAVE_A_SCALE
        if (p + 2 > end) { return 0; }
        xx = rekha_rd_i16(buf, p);
        yy = xx;
        p = p + 2;
    } else {
        if ((flags & 64) != 0) {               # WE_HAVE_AN_X_AND_Y_SCALE
            if (p + 4 > end) { return 0; }
            xx = rekha_rd_i16(buf, p);
            yy = rekha_rd_i16(buf, p + 2);
            p = p + 4;
        } else {
            if ((flags & 128) != 0) {          # WE_HAVE_A_TWO_BY_TWO
                if (p + 8 > end) { return 0; }
                xx = rekha_rd_i16(buf, p);
                xy = rekha_rd_i16(buf, p + 2);
                yx = rekha_rd_i16(buf, p + 4);
                yy = rekha_rd_i16(buf, p + 6);
                p = p + 8;
            }
        }
    }
    store64(rec + 32, xx);
    store64(rec + 40, xy);
    store64(rec + 48, yx);
    store64(rec + 56, yy);
    return p;
}

# Parse a COMPOSITE glyph (numberOfContours < 0): a sequence of component
# records, each a glyph reference + a 2x2 F2Dot14 transform + an offset or a
# point-matching pair. Three passes over the records:
#   1. count them, refusing a truncated record (empty);
#   2. load every child through rekha_load_glyph_d (the shared load context);
#   3. merge into ONE exact-size carved block — the children's points
#      transformed x' = (xx*x + yx*y + 8192) >> 14 (arithmetic: ROUNDED, exact
#      for identity / ±1 / 0), then offset.
# The offset is (arg1, arg2) — scaled by the 2x2 when SCALED_COMPONENT_OFFSET
# (0x800) is set and UNSCALED_COMPONENT_OFFSET (0x1000) is clear — or, when
# ARGS_ARE_XY_VALUES is clear, whatever moves child point arg2 (transformed) onto
# merged point arg1. Empty when the merge exceeds REKHA_COMPOSITE_MAXP /
# REKHA_COMPOSITE_MAXC or a point number is out of range; 0 only on OOM.
fn rekha_load_composite(font, start, end, depth, ctx): i64 {
    var buf = rekha_font_data(font);
    var rec: i64[8];

    var n = 0;
    var p = start + 10;
    var more = 1;
    while (more != 0) {
        p = rekha_comp_record(buf, p, end, &rec);
        if (p == 0) { return rekha_outline_empty(); }
        n = n + 1;
        # More components than loads left can only end in an abort; take it before allocating.
        if (n > load64(ctx)) { return rekha_load_abort(ctx); }
        if ((load64(&rec) & 32) == 0) { more = 0; }   # no MORE_COMPONENTS
    }

    var comps = sd_alloc(n * 8);
    if (comps == 0) { return 0; }
    var tot_pts = 0;
    var tot_ctr = 0;
    p = start + 10;
    var k = 0;
    while (k < n) {
        p = rekha_comp_record(buf, p, end, &rec);
        var co = rekha_load_glyph_d(font, load64(&rec + 8), depth + 1, ctx);
        if (co == 0) { return 0; }
        if (load64(ctx + 16) != 0) { return rekha_outline_empty(); }   # sticky abort
        store64(comps + k * 8, co);
        tot_pts = tot_pts + rekha_outline_n_points(co);
        tot_ctr = tot_ctr + rekha_outline_n_contours(co);
        k = k + 1;
    }
    if (tot_ctr == 0) { return rekha_outline_empty(); }
    if (tot_pts > REKHA_COMPOSITE_MAXP) { return rekha_outline_empty(); }
    if (tot_ctr > REKHA_COMPOSITE_MAXC) { return rekha_outline_empty(); }
    var pts_left = load64(ctx + 8) - tot_pts;
    if (pts_left < 0) { return rekha_load_abort(ctx); }
    store64(ctx + 8, pts_left);

    var o = sd_alloc(REKHA_OUTLINE_SIZE + tot_ctr * 8 + tot_pts * 17);
    if (o == 0) { return 0; }
    var eps = o + REKHA_OUTLINE_SIZE;
    var xs = eps + tot_ctr * 8;
    var ys = xs + tot_pts * 8;
    var oc = ys + tot_pts * 8;
    var base = 0;
    var cbase = 0;
    p = start + 10;
    k = 0;
    while (k < n) {
        p = rekha_comp_record(buf, p, end, &rec);
        var c = load64(comps + k * 8);
        var cnp = rekha_outline_n_points(c);
        var cnc = rekha_outline_n_contours(c);
        var cxs = rekha_outline_xs(c);
        var cys = rekha_outline_ys(c);
        var coc = rekha_outline_on_curve(c);
        var ceps = rekha_outline_end_pts(c);
        var flags = load64(&rec);
        var xx = load64(&rec + 32);
        var xy = load64(&rec + 40);
        var yx = load64(&rec + 48);
        var yy = load64(&rec + 56);
        var dx = 0;
        var dy = 0;
        if ((flags & 2) != 0) {                # ARGS_ARE_XY_VALUES
            dx = load64(&rec + 16);
            dy = load64(&rec + 24);
            if ((flags & 0x1800) == 0x800) {   # SCALED_COMPONENT_OFFSET, not UNSCALED
                var sdx = sd_asr(xx * dx + yx * dy + 8192, 14);
                dy = sd_asr(xy * dx + yy * dy + 8192, 14);
                dx = sdx;
            }
        } else {                               # point matching: merged[arg1] <- child[arg2]
            var pa = load64(&rec + 16);
            var pb = load64(&rec + 24);
            if (pa >= base) { return rekha_outline_clear(o); }
            if (pb >= cnp) { return rekha_outline_clear(o); }
            var bx = load64(cxs + pb * 8);
            var by = load64(cys + pb * 8);
            dx = load64(xs + pa * 8) - sd_asr(xx * bx + yx * by + 8192, 14);
            dy = load64(ys + pa * 8) - sd_asr(xy * bx + yy * by + 8192, 14);
        }
        var j = 0;
        if (xx == 16384 && yy == 16384 && xy == 0 && yx == 0) {
            while (j < cnp) {
                store64(xs + (base + j) * 8, load64(cxs + j * 8) + dx);
                store64(ys + (base + j) * 8, load64(cys + j * 8) + dy);
                store8(oc + base + j, load8(coc + j));
                j = j + 1;
            }
        } else {
            while (j < cnp) {
                var cpx = load64(cxs + j * 8);
                var cpy = load64(cys + j * 8);
                store64(xs + (base + j) * 8, sd_asr(xx * cpx + yx * cpy + 8192, 14) + dx);
                store64(ys + (base + j) * 8, sd_asr(xy * cpx + yy * cpy + 8192, 14) + dy);
                store8(oc + base + j, load8(coc + j));
                j = j + 1;
            }
        }
        var m = 0;
        while (m < cnc) {
            store64(eps + (cbase + m) * 8, load64(ceps + m * 8) + base);
            m = m + 1;
        }
        base = base + cnp;
        cbase = cbase + cnc;
        k = k + 1;
    }
    store64(o, tot_ctr);
    store64(o + 8, tot_pts);
    store64(o + 16, eps);
    store64(o + 24, xs);
    store64(o + 32, ys);
    store64(o + 40, oc);
    return o;
}

# Budgeted glyph load: charge the context, then dispatch simple (nc>0) vs composite (nc<0).
fn rekha_load_glyph_d(font, gid, depth, ctx): i64 {
    if (load64(ctx + 16) != 0) { return rekha_outline_empty(); }
    if (depth > REKHA_COMPOSITE_MAXDEPTH) { return rekha_load_abort(ctx); }
    var loads = load64(ctx);
    if (loads <= 0) { return rekha_load_abort(ctx); }
    # A cycle is a gid already on THIS component path; a sibling reusing a component is not one.
    var d = 0;
    while (d < depth) {
        if (load64(ctx + 24 + d * 8) == gid) { return rekha_load_abort(ctx); }
        d = d + 1;
    }
    store64(ctx, loads - 1);
    store64(ctx + 24 + depth * 8, gid);

    var span: i64[2];
    if (rekha_glyf_span(font, gid, &span) == 0) {
        return rekha_outline_empty();
    }
    var start = load64(&span);
    var end = start + load64(&span + 8);
    var buf = rekha_font_data(font);
    if (start + 10 > end) { return rekha_outline_empty(); }
    var nc = rekha_rd_i16(buf, start);
    if (nc == 0) { return rekha_outline_empty(); }
    if (nc > 0) { return rekha_load_simple(font, start, end, nc, ctx); }
    return rekha_load_composite(font, start, end, depth, ctx);
}

# @public — load glyph `gid`'s outline (simple OR composite) into a
# RekhaOutline. Empty for space / malformed / out-of-range / over a load cap; 0 only on OOM.
fn rekha_load_glyph(font, gid): i64 {
    var ctx: i64[9];
    store64(&ctx, REKHA_GLYPH_MAXLOADS);
    store64(&ctx + 8, REKHA_GLYPH_MAXPOINTS_TOTAL);
    store64(&ctx + 16, 0);
    var o = rekha_load_glyph_d(font, gid, 0, &ctx);
    if (o == 0) { return 0; }
    if (load64(&ctx + 16) != 0) { return rekha_outline_clear(o); }
    return o;
}

# ================================================================
# The rekha -> sadish seam. rekha does NOT rasterize; it maps a glyph's
# design-unit outline into a sadish SdPath (16.16 pixel coords), which sadish
# fills. The affine map is:
#   sd_x = ox + design_x * scale        (scale = 16.16 pixels per design unit)
#   sd_y = oy - design_y * scale        (y-flip: fonts are y-up, sadish y-down)
# ================================================================

# Emit one closed contour (absolute point range [cstart, cend]) into `path`,
# converting TrueType quadratic runs to sadish verbs. On-curve points end a
# segment (line, or quad if a control is pending); off-curve points are
# quadratic controls, with an implied on-curve MIDPOINT synthesized between
# two consecutive off-curve points. The start point is the first on-curve
# point, or — if the contour opens off-curve — the last on-curve point, or a
# synthesized midpoint if BOTH ends are off-curve (all TrueType-legal).
fn rekha_emit_contour(path, xs, ys, oc, cstart, cend, scale, ox, oy): i64 {
    var n = cend - cstart + 1;
    var sx = 0;
    var sy = 0;
    var startidx = 0;
    var count = 0;
    if (load8(oc + cstart) != 0) {
        sx = ox + load64(xs + cstart * 8) * scale;
        sy = oy - load64(ys + cstart * 8) * scale;
        startidx = cstart + 1;
        count = n - 1;
    } else {
        if (load8(oc + cend) != 0) {
            sx = ox + load64(xs + cend * 8) * scale;
            sy = oy - load64(ys + cend * 8) * scale;
            startidx = cstart;
            count = n - 1;
        } else {
            var ax = ox + load64(xs + cstart * 8) * scale;
            var ay = oy - load64(ys + cstart * 8) * scale;
            var bx = ox + load64(xs + cend * 8) * scale;
            var by = oy - load64(ys + cend * 8) * scale;
            sx = sd_asr(ax + bx, 1);
            sy = sd_asr(ay + by, 1);
            startidx = cstart;
            count = n;
        }
    }
    sd_path_moveto(path, sx, sy);

    var have_ctrl = 0;
    var cx = 0;
    var cy = 0;
    var k = 0;
    while (k < count) {
        var idx = startidx + k;
        var px = ox + load64(xs + idx * 8) * scale;
        var py = oy - load64(ys + idx * 8) * scale;
        if (load8(oc + idx) != 0) {
            if (have_ctrl != 0) {
                sd_path_quadto(path, cx, cy, px, py);
                have_ctrl = 0;
            } else {
                sd_path_lineto(path, px, py);
            }
        } else {
            if (have_ctrl != 0) {
                var mx = sd_asr(cx + px, 1);
                var my = sd_asr(cy + py, 1);
                sd_path_quadto(path, cx, cy, mx, my);
                cx = px;
                cy = py;
            } else {
                cx = px;
                cy = py;
                have_ctrl = 1;
            }
        }
        k = k + 1;
    }
    if (have_ctrl != 0) {
        sd_path_quadto(path, cx, cy, sx, sy);   # close the last curve to start
    }
    sd_path_close(path);
    return 0;
}

# @public — convert a decoded glyph `outline` into a sadish SdPath, positioned
# by `scale` (16.16 px/design-unit) at pixel offset (ox, oy) (both 16.16).
# Returns a fresh SdPath (empty for a 0-contour or 0 outline), or 0 if sd_path_new fails.
# Contours stop at the first end_pts entry that is negative or >= n_points, so a
# self-inconsistent outline cannot walk emit off its arrays. ⚠ A HAND-BUILT outline must
# still really hold n_points entries in xs / ys / on_curve and n_contours in end_pts —
# this seam cannot see an allocation's size.
fn rekha_outline_to_sdpath(outline, scale, ox, oy): i64 {
    if (outline == 0) { return sd_path_new(); }
    var path = sd_path_new();
    if (path == 0) { return 0; }
    var nc = rekha_outline_n_contours(outline);
    if (nc <= 0) { return path; }
    var npts = rekha_outline_n_points(outline);
    var eps = rekha_outline_end_pts(outline);
    var xs = rekha_outline_xs(outline);
    var ys = rekha_outline_ys(outline);
    var oc = rekha_outline_on_curve(outline);

    var cstart = 0;
    var ci = 0;
    while (ci < nc) {
        var cend = load64(eps + ci * 8);
        if (cend < 0) { break; }
        if (cend >= npts) { break; }
        if (cend >= cstart) {
            rekha_emit_contour(path, xs, ys, oc, cstart, cend, scale, ox, oy);
        }
        cstart = cend + 1;
        ci = ci + 1;
    }
    return path;
}

# @public — load glyph `gid` and convert it to a positioned sadish SdPath
# (an empty path when the glyph loads empty or its load hits OOM).
fn rekha_glyph_to_sdpath(font, gid, scale, ox, oy): i64 {
    return rekha_outline_to_sdpath(rekha_load_glyph(font, gid), scale, ox, oy);
}

# --- cmap.cyr ---

# @internal — cmap: Unicode codepoint -> glyph id.
#
# cmap.cyr — finds a Unicode BMP subtable (platform 3 / encoding 1, or the
# generic platform 0) and parses format 4 (segment mapping to delta values),
# the near-universal BMP encoding. Returns .notdef (0) for anything unmapped.
# Bounds: the encoding-record walk, the subtable header and all four segment
# arrays are validated ONCE, at rekha_font_open, against the cmap table's
# DECLARED extent (not the file length); a lookup re-checks only the
# glyphIdArray index, against the same extent.
#
# cmap table:  +0 version u16, +2 numTables u16, then numTables encoding
#   records (8 bytes: platformID u16, encodingID u16, offset u32 from cmap).
# format 4 subtable: format(2) length(2) language(2) segCountX2(2)
#   searchRange(2) entrySelector(2) rangeShift(2) endCode[segCount] u16
#   reservedPad(2) startCode[segCount] idDelta[segCount] idRangeOffset[segCount]
#   glyphIdArray[].

# Resolve the Unicode format-4 subtable for the table cache; returns its absolute offset, or 0.
# Called by rekha_font_resolve after cmap_off / cmap_len are cached. Selection: the LAST
# (3,1) or (0,*) encoding record whose subtable is format 4 wins (directory records are sorted,
# so (3,1) beats (0,*)). The winner must then hold its 14-byte header and all four segment
# arrays inside the cmap extent, with segCountX2 >= 2 — else 0 (no usable subtable).
#
# ⚠ COVERAGE GAP, STATED: format 4 under (3,1) / (0,*) is the only mapping read. A symbol font
# whose only subtable is (3,0) (glyphs at U+F0xx) and a font whose Unicode map is format 12 only
# ((3,10) / (0,4)) map every codepoint to .notdef. cmap formats 12 / 6 / 0 are on README's
# "v0.4.0 / staged" roadmap; a (3,0) symbol remap is not scheduled there.
fn rekha_cmap_subtable(font): i64 {
    if (font == 0) { return 0; }
    var cmap = load64(font + 128);
    if (cmap == 0) { return 0; }
    var cend = cmap + load64(font + 136);
    var buf = rekha_font_data(font);
    if (cmap + 4 > cend) { return 0; }
    var ntab = rekha_rd_u16(buf, cmap + 2);
    var best = 0;
    var i = 0;
    while (i < ntab) {
        var rec = cmap + 4 + i * 8;
        if (rec + 8 > cend) {
            i = ntab;                     # records past the cmap extent do not exist
        } else {
            var plat = rekha_rd_u16(buf, rec + 0);
            var enc = rekha_rd_u16(buf, rec + 2);
            var sub = cmap + rekha_rd_u32(buf, rec + 4);
            var want = 0;
            if (plat == 3) {
                if (enc == 1) { want = 1; }   # Windows Unicode BMP
            }
            if (plat == 0) { want = 1; }      # Unicode (any)
            if (want != 0) {
                if (sub + 2 <= cend) {
                    if (rekha_rd_u16(buf, sub) == 4) { best = sub; }
                }
            }
            i = i + 1;
        }
    }
    if (best == 0) { return 0; }
    if (best + 14 > cend) { return 0; }
    var segc2 = rekha_rd_u16(buf, best + 6);
    if (segc2 < 2) { return 0; }
    # endCode[] @ +14, reservedPad, startCode[], idDelta[], idRangeOffset[] — the last must end in cmap
    var range_arr = best + 14 + segc2 + 2 + segc2 + segc2;
    if (range_arr + segc2 > cend) { return 0; }
    return best;
}

# @public — map a Unicode codepoint `cp` to a glyph id via the cmap format-4
# subtable. Returns 0 (.notdef) if the handle is 0, cp is unmapped or beyond the
# BMP, there is no usable subtable, or the mapped id is >= maxp.numGlyphs (when
# maxp is present) — an id with no glyph behind it IS .notdef. Allocates 0 B.
#
# Segment search is HYBRID: segment 0 directly when endCode[0] >= cp (the ASCII case on common
# faces), else a binary search for the first endCode >= cp over [1, segCount). For the
# ascending endCode[] the spec requires, that is exactly the first segment a linear scan finds.
# MEASURED 0.3.11 (cache + hybrid vs the per-call resolve + linear scan it replaced), median of 3:
# LiberationSans ASCII 224 -> 28 ns; D2Coding Nerd (1,642 segments) U+AC00.. 7,686 -> 85 ns.
# Full-BMP gid digests are identical on LiberationSans, D2Coding and 70 sampled system TTFs.
fn rekha_char_to_glyph(font, cp): i64 {
    if (font == 0) { return 0; }
    if (cp < 0) { return 0; }
    if (cp > 65535) { return 0; }          # format 4 is BMP-only
    var sub = load64(font + 144);
    if (sub == 0) { return 0; }
    var buf = load64(font);
    var segc2 = load64(font + 152);         # validated >= 2 with the arrays at open
    var segc = segc2 / 2;
    var end_arr = sub + 14;

    # first segment whose endCode >= cp
    var seg = 0;
    if (rekha_rd_u16(buf, end_arr) < cp) {
        var lo = 1;
        var hi = segc;
        while (lo < hi) {
            var mid = (lo + hi) / 2;
            if (rekha_rd_u16(buf, end_arr + mid * 2) >= cp) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        if (lo >= segc) { return 0; }
        seg = lo;
    }

    var start_arr = end_arr + segc2 + 2;    # +reservedPad
    var delta_arr = start_arr + segc2;
    var range_arr = delta_arr + segc2;
    var startc = rekha_rd_u16(buf, start_arr + seg * 2);
    if (startc > cp) { return 0; }          # cp falls in a gap -> .notdef
    var delta = rekha_rd_i16(buf, delta_arr + seg * 2);
    var ro = rekha_rd_u16(buf, range_arr + seg * 2);
    var g = 0;
    if (ro == 0) {
        g = (cp + delta) & 65535;
    } else {
        # idRangeOffset is self-relative from its own slot in idRangeOffset[]
        var gidx = range_arr + seg * 2 + ro + (cp - startc) * 2;
        if (gidx + 2 > load64(font + 128) + load64(font + 136)) { return 0; }
        var gid = rekha_rd_u16(buf, gidx);
        if (gid == 0) { return 0; }
        g = (gid + delta) & 65535;
    }
    var ng = load64(font + 56);
    if (ng > 0) {
        if (g >= ng) { return 0; }
    }
    return g;
}

# @public — codepoint -> a positioned sadish SdPath (cmap + glyf + convert).
fn rekha_char_to_sdpath(font, cp, scale, ox, oy): i64 {
    return rekha_glyph_to_sdpath(font, rekha_char_to_glyph(font, cp), scale, ox, oy);
}

# @public — the advance width of codepoint `cp`, in font DESIGN UNITS. 0 = unknown.
#
# ⭐ THE COMPANION `rekha_char_to_sdpath` NEEDED AND DID NOT HAVE. Drawing a run of text is two
# questions per character — *what shape* and *how far to move* — and rekha answered only the first,
# so every consumer invented the second. That is why dhancha shipped a fixed 0.6 em advance.
# ⚠ An unmapped codepoint resolves to .notdef (gid 0), whose advance is a real metric in most fonts
# — so a missing glyph advances by the .notdef box rather than collapsing to zero, which is what
# makes a run of unmapped text still legible as "something is here".
fn rekha_char_advance(font, cp): i64 {
    return rekha_advance_width(font, rekha_char_to_glyph(font, cp));
}

# @public — advance `cp` in PIXELS at pixel size `px_size`, rounded to nearest. 0 = unknown.
# = rekha_glyph_advance_px(font, rekha_char_to_glyph(font, cp), px_size).
#
# ⭐ THE SCALING LIVES HERE BECAUSE EVERY CONSUMER WOULD OTHERWISE WRITE IT, AND ONE OF THEM WOULD
# WRITE IT WRONG. `adv * px_size / upem` truncates toward zero, which loses up to a pixel per glyph,
# always in the same direction — a 40-character run drifts visibly left of where it should end.
# Rounding half-up costs one add and bounds EACH glyph's error at half a pixel.
# ⛔ PER-GLYPH ROUNDING HALVES THE BIAS; IT DOES NOT STOP THE DRIFT. A run built by summing these
# integers still accumulates up to half a pixel per glyph. Exact run widths come from summing
# 16.16 advances (rekha_char_advance_fx / rekha_glyph_advance_fx) and rounding the pen ONCE.
# ⚠ Returns 0 when the metric is unknown OR `upem` is 0, so the caller's fallback path is a single
# `== 0` test rather than two.
fn rekha_char_advance_px(font, cp, px_size): i64 {
    return rekha_glyph_advance_px(font, rekha_char_to_glyph(font, cp), px_size);
}

# @public — advance `cp` at pixel size `px_size` as 16.16 fixed-point pixels. 0 = unknown.
# = rekha_glyph_advance_fx(font, rekha_char_to_glyph(font, cp), px_size). Allocates 0 B.
fn rekha_char_advance_fx(font, cp, px_size): i64 {
    return rekha_glyph_advance_fx(font, rekha_char_to_glyph(font, cp), px_size);
}
