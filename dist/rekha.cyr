# rekha.cyr -- bundled distribution
# Version: 0.9.0
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- freeze.cyr ---

# freeze.cyr — the first module of every dist bundle, and nothing else (0.9.0).
#
# `cyrius distlib` concatenates the [lib] / [lib.woff] module lists into ONE file, and a Cyrius
# file that says `private` is private-by-default: every `fn` and `var` in it is reachable only
# from inside that file, and a consumer's call to one is a compile error — `'x' is private to
# its file`. So this line, first in the bundle, is the API freeze: a consumer of dist/rekha.cyr or
# dist/rekha-woff.cyr reaches exactly the items src/ marks `public fn` / `public var`, and the
# compiler says no to everything else. Enum constants (RekhaErrCode) are always reachable.
# ⛔ NOT included by src/lib.cyr, on purpose: `private` applies to the file it appears in, not to
# the files that include it or that it sits beside, so the src chain the tests build stays open
# to every internal (the test seams: rekha_hint_run, rekha_hint_load_simple, rekha_rd_u16, …).
# ⚠ Consumers therefore need cyrius >= 6.6.6 — reserved words since 6.5.0, whole-file semantics
# since 6.6.5 — which the one-leaf sidecar (src/lib.cyr) already required. docs/api/README.md
# states the promise; scripts/api_surface.py pins the conventions around it, and CI compiles a
# probe against each bundle that MUST fail on an internal name.
private

# --- error.cyr ---

# error.cyr — the vocabulary rekha refuses in (0.7.0; a ninth code at 0.8.0).
#
# error.cyr — nine codes and their names. WHERE a code comes from is `rekha_font_error` in
# src/sfnt.cyr, which reports why a font handle's last call refused, and the `_why` twins of the
# open family, which report why there is no handle at all.
#
# ⭐ THIS FILE WAS A PROMISE FOR SIX RELEASES. Through 0.6.7 it declared "@public — stable API
# surface for rekha error handling" and nothing in rekha produced one: every failure collapsed to a
# sentinel, and `rekha_advance_width` returned 0 for "no hhea", "truncated hmtx" and "this glyph is
# genuinely zero-width" alike. rekha's own rule, at src/sfnt.cyr's two-tags note, is that a
# declared name with no reader is a promise and not a feature. 0.7.0 is the reader.
#
# ⛔ THE 16-BYTE RekhaErr RECORD IS GONE, and so are `rekha_err_new`, `rekha_err`,
# `rekha_err_code` and `rekha_err_detail`. Two reasons, and the first is the serious one:
#   - `rekha_err_new` called `sd_alloc(16)`, so CONSTRUCTING AN OUT-OF-MEMORY ERROR ALLOCATED. An
#     error path that can fail the same way as the thing it is reporting is not an error path.
#   - Nothing produced one, and rekha now reports a code and a detail POINTER directly out of the
#     font handle, with no record to build and no byte allocated. Keeping a type rekha does not
#     produce would be the same promise one layer down.
# A consumer that wants to carry an error around builds its own pair; the codes below are the part
# that was ever load-bearing. Removing published names is why this happens BEFORE the 0.9.0 freeze.
#
# ⚠ REKHA_ERR_BAD_HINT (0.8.0) IS NOT REKHA_ERR_UNSUPPORTED, and src/hint.cyr keeps them apart on
# purpose: BAD_HINT means the bytecode contradicts itself — a stack that underflows, a function
# that was never defined, an IF with no EIF — and UNSUPPORTED means the bytecode is correct and
# rekha is not there yet. A consumer asking "will this font ever hint here" tests for the second.
# ⭐ SINCE v0.8.2 THE INTERPRETER PRODUCES NO UNSUPPORTED AT ALL: IUP was the last instruction it
# named that way, and every opcode of the machine now runs. The code stays in the vocabulary —
# the open family still answers it for a container rekha does not read, and the 0.9.0 freeze
# keeps the promise that a correct-but-unimplemented feature will be told apart from a malformed
# one — but a hinting refusal is one of the OTHER codes, never this: BAD_HINT for the bytecode
# (a program that contradicts itself, or a cap it runs into); TRUNCATED, BAD_GLYF, BAD_SFNT,
# NO_TABLE or OTHER for the glyph, its tables and the gid (a short glyph record, a lying loca,
# an indexToLocFormat that is neither 0 nor 1, a face without loca / glyf / the hinting tables /
# head, a gid the font does not have or a context with no glyph loaded); OOM for a cap of the
# machine or the zone (a maxp limit over rekha's, a glyph past its maxp maxima, a refused path
# allocation).

# ================================================================
# Error code constants
# ================================================================

enum RekhaErrCode {
    REKHA_OK              = 0;   # no error
    REKHA_ERR_OOM         = 1;   # allocation failed / cap hit
    REKHA_ERR_BAD_SFNT    = 2;   # missing/corrupt SFNT header or table directory
    REKHA_ERR_TRUNCATED   = 3;   # input ends before a table/field completes
    REKHA_ERR_NO_TABLE    = 4;   # a required SFNT table (head/cmap/glyf/loca) is absent
    REKHA_ERR_BAD_GLYF    = 5;   # malformed glyf entry (bad contour/point counts)
    REKHA_ERR_UNSUPPORTED = 6;   # valid font but a feature rekha can't yet load
    REKHA_ERR_BAD_HINT    = 7;   # malformed TrueType bytecode, or a machine invariant broken
    REKHA_ERR_OTHER       = 99;  # catch-all
}

# ================================================================
# Error name lookup — returns a cstring (never null).
# ================================================================

# @public — a short, fixed cstring for a code. Never null, and never allocated: every string here
# is a literal in the bundle. An unknown code answers "unknown error" rather than refusing, because
# a diagnostic that refuses is no diagnostic.
public fn rekha_err_name(code): i64 {
    if (code == REKHA_OK)              { return "ok"; }
    if (code == REKHA_ERR_OOM)         { return "out of memory"; }
    if (code == REKHA_ERR_BAD_SFNT)    { return "bad SFNT header"; }
    if (code == REKHA_ERR_TRUNCATED)   { return "truncated input"; }
    if (code == REKHA_ERR_NO_TABLE)    { return "required table absent"; }
    if (code == REKHA_ERR_BAD_GLYF)    { return "malformed glyf entry"; }
    if (code == REKHA_ERR_UNSUPPORTED) { return "unsupported feature"; }
    if (code == REKHA_ERR_BAD_HINT)    { return "malformed hint program"; }
    if (code == REKHA_ERR_OTHER)       { return "other error"; }
    return "unknown error";
}

# ⛔ rekha_err_print_name WAS HERE AND IS GONE (0.5.0). It wrote the name to fd 2 through a raw
# `syscall(1, 2, ...)` — correct on x86_64 Linux and on AGNOS, and WRONG on aarch64, where write is
# 64 and 1 is `io_destroy`. It shipped in both bundles and was the only syscall in library code.
# ⭐ Removed rather than fixed: taking the stdlib's dispatched SYS_WRITE would add the `syscalls`
# leaf to dist/rekha.deps — a tax on every consumer for a debug helper nothing calls — and 0.4.4 /
# 0.4.5 spent two releases cutting that list to ONE. A pure parser that makes no syscall at all is
# the better invariant, and CI now gates exactly that. `rekha_err_name` returns the cstring; a
# caller that wants it on a fd writes it with its own I/O.

# --- sfnt.cyr ---

# SFNT container parse (TrueType / OpenType table directory).
# sfnt.cyr — turn untrusted font bytes into a RekhaFont: validate the
# SFNT header (sfnt version + numTables), resolve the tables rekha reads
# (head / maxp / loca / glyf / hhea / hmtx / cmap) ONCE at open, and expose
# the table directory. A 'ttcf' COLLECTION carries several faces in one file, each with its own
# offset table and all of them sharing table data; rekha_ttc_count says how many and
# rekha_font_open_index opens one (0.4.8).
#
# TTCHeader (the file's first 12 bytes, big-endian):
#   +0 ttcTag u32 'ttcf' · +4 majorVersion u16 · +6 minorVersion u16 · +8 numFonts u32
#   +12 offsetTable[numFonts] u32 — each the FILE offset of that face's SFNT offset table
# ⚠ Version 2.0 appends a digital-signature triple after the offset array. rekha neither reads nor
# needs it: every face is addressed through the offset array alone.
#
# SFNT layout (Apple TT / OpenType spec, big-endian throughout):
#   Offset table (12 bytes):
#     +0  sfntVersion   u32  — 0x00010000 (TT) or 'OTTO' (CFF) or 'true'
#     +4  numTables     u16
#     +6  searchRange   u16
#     +8  entrySelector u16
#     +10 rangeShift    u16
#   Table directory (numTables × 16 bytes), each:
#     +0  tag           u32  — 4 ASCII bytes ('glyf','loca','head',…)
#     +4  checkSum      u32
#     +8  offset        u32  — byte offset of the table within the file
#     +12 length        u32
#
# ⛔ THE BOUNDS INVARIANT, AS ENFORCED (sfnt.cyr + cmap.cyr). Font files are untrusted input; each
# rule below is a check in code, not an aspiration:
#   1. The table directory lies inside [0, len) — rekha_font_open.
#   2. A table is usable only if it lies inside [min_table, len) AND does not overlap this face's
#      own offset table + directory — rekha_find_table_len. For a plain SFNT min_table is
#      12 + numTables * 16, which is the rule rekha has always enforced and makes the overlap test
#      unreachable; for a face inside a 'ttcf' COLLECTION (0.4.8) it is the end of the TTC header
#      and its offset array, because a table shared with an earlier face legitimately lies below
#      this face's directory. Either way offset 0 always means "absent or invalid".
#   3. A fixed field is read only when the table's DECLARED length covers it: head >= 54 B,
#      maxp >= 6 B, hhea >= 36 B. A shorter table is cached as absent — rekha_font_open.
#   4. Variable arrays are bounded by their OWN table's declared extent, never merely by `len`:
#      hmtx metrics by hmtx_len, loca entries by loca_len, glyph spans by glyf_len, cmap records /
#      the chosen subtable's header and arrays (formats 0 / 4 / 6 / 12 / 13) and the format-4
#      glyphIdArray index by the cmap extent.
# ⚠ The glyph bytes inside a span are glyf.cyr's to bound; this file hands out only spans that
# lie inside glyf.

# ================================================================
# SFNT constants
# ================================================================
var REKHA_SFNT_OFFTAB_LEN = 12;   # offset table (header) byte length
var REKHA_SFNT_DIRENT_LEN = 16;   # one table-directory entry byte length

var REKHA_SFNT_VER_TT   = 65536;      # 0x00010000 — TrueType outlines
var REKHA_SFNT_VER_TRUE = 0x74727565; # 'true' — Apple TrueType
var REKHA_SFNT_VER_OTTO = 0x4F54544F; # 'OTTO' — OpenType with CFF outlines (cff.cyr)
var REKHA_TAG_TTCF      = 0x74746366; # 'ttcf' — a COLLECTION: several faces in one file (0.4.8)
# Faces in one collection. The format allows a u32 count; nothing real is near this, and the cap
# keeps every offset-array read trivially inside i64.
var REKHA_TTC_MAXFONTS  = 1024;

# Table tags — 4 ASCII bytes packed big-endian into an i64.
var REKHA_TAG_HEAD = 0x68656164;   # 'head'
var REKHA_TAG_MAXP = 0x6D617870;   # 'maxp'
var REKHA_TAG_LOCA = 0x6C6F6361;   # 'loca'
var REKHA_TAG_GLYF = 0x676C7966;   # 'glyf'
var REKHA_TAG_CMAP = 0x636D6170;   # 'cmap'
var REKHA_TAG_HHEA = 0x68686561;   # 'hhea'
var REKHA_TAG_HMTX = 0x686D7478;   # 'hmtx'
var REKHA_TAG_CFF  = 0x43464620;   # 'CFF '

# ================================================================
# Big-endian byte readers — SFNT is big-endian on every field.
# `buf` is a raw byte pointer; `off` is a byte offset into it.
# ⚠ THESE READERS CHECK NOTHING. The caller proves `off + width` lies inside the table it is
# parsing BEFORE calling — via the invariant above (rekha_font_open's table cache and minimum
# lengths, rekha_find_table_len's extent rule, and each reader's own table-length test).
# ================================================================

# Read a big-endian unsigned 16-bit value.
fn rekha_rd_u16(buf, off): i64 {
    var b0 = load8(buf + off);
    var b1 = load8(buf + off + 1);
    return (b0 * 256) + b1;
}

# Read a big-endian unsigned 32-bit value.
fn rekha_rd_u32(buf, off): i64 {
    var hi = rekha_rd_u16(buf, off);
    var lo = rekha_rd_u16(buf, off + 2);
    return (hi * 65536) + lo;
}

# Read a big-endian signed 16-bit value (glyf coords are i16).
fn rekha_rd_i16(buf, off): i64 {
    var v = rekha_rd_u16(buf, off);
    if (v >= 32768) {
        return v - 65536;
    }
    return v;
}

# Read a signed 8-bit value (composite-glyph byte args).
fn rekha_rd_i8(buf, off): i64 {
    var v = load8(buf + off);
    if (v >= 128) {
        return v - 256;
    }
    return v;
}

# ================================================================
# RekhaFont — parsed SFNT handle (REKHA_FONT_SIZE = 832 bytes).
#   +0   data        (ptr — the raw font byte buffer, borrowed not owned)
#   +8   len         (i64 — byte length of `data`)
#   +16  sfnt_ver    (i64 — sfntVersion u32; 0x00010000 = TrueType)
#   +24  num_tables  (i64 — numTables from the offset table)
#   +32  dir_off     (i64 — byte offset of the table directory = 12)
#   ---- table cache: resolved ONCE by rekha_font_open, every entry validated per the invariant ----
#   +40  upem        (i64 — head.unitsPerEm; 0 = head absent or shorter than 54 B)
#   +48  loca_fmt    (i64 — head.indexToLocFormat; 0 when head is absent or short)
#   +56  num_glyphs  (i64 — maxp.numGlyphs; 0 = maxp absent or shorter than 6 B)
#   +64  loca_off    (i64 — 0 = absent)      +72  loca_len  (i64 — declared length)
#   +80  glyf_off    (i64 — 0 = absent)      +88  glyf_len
#   +96  hhea_off    (i64 — 0 = hhea absent or shorter than 36 B)
#   +104 nhm         (i64 — hhea.numberOfHMetrics; 0 when hhea_off is 0)
#   +112 hmtx_off    (i64 — 0 = absent)      +120 hmtx_len
#   +128 cmap_off    (i64 — 0 = absent)      +136 cmap_len
#   +144 cmap_sub    (i64 — absolute offset of the chosen subtable, its header and arrays validated
#                     inside the cmap extent; 0 = none usable)
#   +152 cmap_n      (i64 — its entry count: format 4 segCountX2 (>= 2), format 6 entryCount,
#                     format 12/13 numGroups, format 0 256; 0 when cmap_sub is 0)
#   +160 cmap_first  (i64 — format 6 firstCode; 0 otherwise)
#   +168 cmap_kind   (i64 — the subtable format (0 / 4 / 6 / 12 / 13), + 0x10000 when it came from a
#                     (3,0) SYMBOL record, whose lookups also try U+F000 + cp; 0 when cmap_sub is 0)
#   ---- CFF (cff.cyr) — all 0 unless sfntVersion is 'OTTO' and the 'CFF ' table resolves ----
#   +176 cff_cs      (i64 — absolute offset of the CharStrings INDEX; 0 = no usable CFF outlines)
#   +184 cff_gsubrs  (i64 — the Global Subr INDEX)
#   +192 cff_subrs   (i64 — the Top DICT Private's Subrs INDEX; 0 = none, or a CID-keyed font)
#   +200 cff_fdarray (i64 — the FDArray INDEX of a CID-keyed font; 0 otherwise)
#   +208 cff_fdsel   (i64 — its FDSelect; 0 otherwise)
#   +216 cff_off     (i64 — the CFF table's start)    +224 cff_end (its declared end)
#   +232 cff_count   (i64 — the CharStrings count: the glyph ids with an outline)
#   +256 cff2       (i64 — 1 when the outlines came from a 'CFF2' table rather than 'CFF ', which
#                      is what puts cff.cyr's Type 2 interpreter into its CFF2 dialect. 0.4.9.)
#   +264 cff2_vstore (i64 — that table's ItemVariationStore, 0 = none)
#   +272 fvar_axes  (i64 — the axis record array of `fvar`, 0 = the font has no usable axes)
#   +280 axis_count  +288 axis_size (fvar's own axisSize, so a longer record still indexes right)
#   +296 avar        (i64 — the avar table, 0 = none)   +304 file_len (bounds every variation read)
#   +312 var_coords  (i64 — normalized coordinates, one 16.16 per axis; 0 until an axis is set)
#   +320 var_scalars (i64 — one 16.16 scalar per region of the CFF2 variation store; 0 until set)
#   +336 gvar        (i64 — the 'gvar' table, 0 = the font has none)
#   +344 gvar_scratch (i64 — the per-glyph delta / touched scratch, allocated on first use)
#   +352 file_len     (again, so gvar's reads are bounded without another indirection). 0.4.12.
#   +360 cff_mtx_on  (i64 — 1 when the CFF / CFF2 FontMatrix is NOT the identity once folded with
#                      unitsPerEm, so the charstring point store has to transform. 0 = nothing to
#                      do, which is every font whose FontMatrix is 1 / upem. 0.5.1.)
#   +688 cvt  +696 cvt_len · +704 fpgm  +712 fpgm_len · +720 prep  +728 prep_len ·
#                      +736 gasp  +744 gasp_end · +752 maxp_v1 · +760 max_storage  +768 max_fdefs
#                      +776 max_idefs  +784 max_stack  +792 max_instr  +800 max_twilight ·
#                      +808 hint_ctx (i64 — the TrueType hinting tables, the six `maxp` version 1.0
#                      limits the interpreter is sized by, and the interpreter itself, built
#                      LAZILY on the first rekha_hint_ctx and re-scaled in place on a size change
#                      so an open still costs exactly REKHA_FONT_SIZE. 0 = absent. 0.8.0.)
#   +816 max_zone_pts  +824 max_zone_ctrs (i64 — the LARGER of maxp's simple and composite point
#                      and contour maxima, which is what the interpreter's glyph zone is sized by:
#                      that many points plus the four phantom points, and that many contour ends.
#                      0 when maxp is not version 1.0. 0.8.1.)
#   +672 err_code  +680 err_detail (i64 — why THIS font's last public call refused, and a static
#                      cstring naming where. Cleared at the top of every public call that can set
#                      it, so it describes the LAST call and not the last failure ever. 0.7.0.)
#   +608 vhea  +616 num_v_metrics · +624 vmtx  +632 vmtx_len · +640 vorg  +648 vorg_end ·
#                      +656 vvar  +664 vvar_end (i64 — the vertical metrics. 0 = absent. 0.6.7.)
#   +576 gpos  +584 gpos_end · +592 gpos_lookups · +600 gpos_nlookups (i64 — the GPOS table, and
#                      the `kern` feature's lookups resolved LAZILY on the first query into one
#                      sd_alloc, so an open still costs exactly REKHA_FONT_SIZE. -1 in the count
#                      means "not resolved yet". 0.6.6.)
#   +552 kern  +560 kern_end (i64 — the legacy `kern` table, 0 = absent or a version that is
#                      neither Microsoft's 0 nor Apple's 1.0. 0.6.5.)
#   +536 post  +544 post_end (i64 — the `post` table, 0 = absent or under its 32-byte header.
#                      Underline, italic angle and fixed pitch; its glyph names are not read.
#                      0.6.4.)
#   +496 fvar_inst +504 inst_count +512 inst_size (i64 — `fvar`'s named-instance array, which has
#                      no offset field of its own: it follows the axes. 0 = none, or a stride the
#                      spec does not allow. 0.6.3.)
#   +520 stat  +528 stat_end (i64 — the STAT table, 0 = absent or refused at open. 0.6.3.)
#   +464 name  +472 name_end · +480 name_count · +488 name_strings (i64 — the `name` table, its
#                      record count, and the ABSOLUTE offset of its string storage. 0 = absent or
#                      a header that does not fit. 0.6.2.)
#   +448 os2  +456 os2_end   (i64 — the OS/2 table, 0 = absent or under its 78-byte minimum. What
#                      the designer INTENDED: the sTypo and usWin vertical pairs, USE_TYPO_METRICS,
#                      x-height, cap-height, weight and width class, the strikeout rule. Every
#                      field re-checks the extent it needs, so a short table loses its tail rather
#                      than the whole reader. 0.6.1.)
#   +416 hvar  +424 hvar_end · +432 mvar  +440 mvar_end (i64 — the metrics-variation tables, 0 =
#                      absent or refused at open. HVAR varies a glyph's ADVANCE, MVAR the font-wide
#                      line box; both are read on demand, since one query touches one delta row.
#                      0.6.0.)
#   +368 .. +408     (i64 x 6 — that matrix as [a b c d e f] x unitsPerEm, in 16.16. It maps
#                      charstring units straight to DESIGN units, so the sadish seam's divide by
#                      upem remains the only other scaling step. See src/cff.cyr on why the product
#                      rather than the matrix: 0.001 in 16.16 is 65.536 and rounds to a 0.7% error,
#                      while 0.001 x 1000 is exactly 1.0.)
#   +328 var_nregion (i64 — how many of them are live; 0 IS the default instance). 0.4.11.
#   +248 min_table  (i64 — the lowest byte offset a table of THIS face may start at. For a plain
#                      SFNT that is the end of its own directory, which is the rule rekha has always
#                      enforced; for a face inside a COLLECTION it is the end of the TTC header and
#                      its offset array, because a table shared with an earlier face legitimately
#                      lies BELOW this face's directory. 0.4.8.)
#   +240 cff_charset  (i64 — what `seac` resolves a glyph NAME through: 0 = the ISOAdobe predefined
#                      charset (and the CFF default, where SID i IS glyph i), 1 = Expert,
#                      2 = ExpertSubset, -1 = present but unusable, anything else the ABSOLUTE
#                      offset of a format 0 / 1 / 2 charset. 0.4.7.)
#
# ⭐ WHY A CACHE. Every reader used to re-walk the table directory per call — rekha_char_advance_px
# walked it for head, cmap, hhea and hmtx on every character, rekha_char_to_sdpath for cmap, maxp,
# loca, glyf and head. The walk is linear in numTables, which the font chooses. Resolving once at
# open makes every reader below a handful of loads with zero directory walks. MEASURED 0.3.11,
# LiberationSans (19 tables), median of 3: rekha_char_advance_px 787 -> 47 ns, rekha_glyf_span
# 785 -> 33 ns, rekha_char_to_sdpath 2,473 -> 1,516 ns; rekha_font_open pays 36 -> ~1,500 ns ONCE.
# ⚠ THE BUFFER IS BORROWED AND THE CACHE IS A SNAPSHOT. Mutating the font bytes after
# rekha_font_open is unsupported: the cached offsets keep reads inside `len`, but upem / numGlyphs
# / numberOfHMetrics / the cmap subtable choice would describe the bytes as they were at open.
# ⚠ The accessors below dereference the handle unchecked; the PUBLIC readers (units_per_em,
# glyph_count, hhea/hmtx, char_to_glyph, ...) each return 0 for a 0 handle.
# ================================================================

# @public — the bytes one handle costs: the one sd_alloc of rekha_font_open. ⚠ Frozen by NAME, not
# by value: it grew 816 → 832 at 0.8.1 and may grow again in a minor release; size by the name.
public var REKHA_FONT_SIZE = 832;

fn rekha_font_data(f): i64       { return load64(f); }
fn rekha_font_len(f): i64        { return load64(f + 8); }
fn rekha_font_sfnt_ver(f): i64   { return load64(f + 16); }
fn rekha_font_num_tables(f): i64 { return load64(f + 24); }
fn rekha_font_dir_off(f): i64    { return load64(f + 32); }

# @public — open a font from an in-memory (buf, len): face 0 of a 'ttcf' collection, the one face
# of anything else. Parses the SFNT offset table (sfntVersion + numTables), records the
# table-directory offset and resolves the table cache (RekhaFont layout above).
# Returns a RekhaFont pointer, or 0 when `buf` is 0, len < 12, sfntVersion is not 0x00010000 /
# 'true' / 'OTTO' / 'ttcf', the table directory overruns `len`, or the allocation fails. The
# caller treats 0 as "not a usable font"; rekha_font_open_why says which of those it was.
#
# ⚠ A MISSING OR MALFORMED TABLE NEVER FAILS THE OPEN. It is cached as absent and the reader that
# needs it returns 0 ("unknown") — the same fonts open as before the cache existed.
# Allocation: exactly one sd_alloc(REKHA_FONT_SIZE).
public fn rekha_font_open(buf, len): i64 {
    return rekha_font_open_index(buf, len, 0);
}

# @public — the number of faces in the TrueType Collection at (buf, len), or 0 when it is not one
# ('ttcf'), the count is 0 or past REKHA_TTC_MAXFONTS, or the offset array does not fit. Reads 12
# bytes plus nothing; allocates 0 B.
# ⚠ 0 does NOT mean "no font" — a plain .ttf is not a collection and answers 0 here while opening
# perfectly. It means "not a collection", and rekha_font_open_index(buf, len, 0) is the right call
# either way.
public fn rekha_ttc_count(buf, len): i64 {
    if (buf == 0) { return 0; }
    if (len < 12) { return 0; }
    if (rekha_rd_u32(buf, 0) != REKHA_TAG_TTCF) { return 0; }
    var nf = rekha_rd_u32(buf, 8);
    if (nf < 1) { return 0; }
    if (nf > REKHA_TTC_MAXFONTS) { return 0; }
    if (12 + nf * 4 > len) { return 0; }
    return nf;
}

# @public — open face `index` of (buf, len). A 'ttcf' COLLECTION carries several faces that SHARE
# their table data, each with its own offset table somewhere in the file; anything else is one face
# and only index 0 opens it. Returns 0 for the reasons rekha_font_open lists, plus: an index past
# the collection, a collection whose header or offset array does not fit, and a face offset inside
# the TTC header itself.
# ⛔ A member face's tables are addressed from the START OF THE FILE, not from its offset table, and
# two faces routinely name the SAME table. So the "a table lies past its own directory" rule cannot
# hold for a member — a table shared with face 0 sits well below face 2's directory — and each face
# instead carries the floor that DOES hold (+248): the end of the TTC header and its offset array.
# rekha_find_table_len keeps the old rule for a plain SFNT and adds an overlap test that catches
# what the floor no longer does.
public fn rekha_font_open_index(buf, len, index): i64 {
    return rekha_font_open_index_why(buf, len, index, 0);
}

# Set `*out` when the caller gave one. The open family's answer to "there is no handle to record
# into" — a caller's own slot instead of rekha's, which keeps the whole thing reentrant.
fn rekha_err_out(out, code): i64 {
    if (out != 0) { store64(out, code); }
    return 0;
}

# @public — open face `index` and say WHY when it will not. `err_out` is a caller-supplied i64 slot
# (or 0 to ignore); on failure it gets a RekhaErrCode, on success REKHA_OK.
# ⛔ THE OPEN FAMILY CANNOT USE `rekha_font_error`: there is no handle yet, which is the whole
# failure. So these take a slot rather than rekha owning one — six functions rather than a global,
# and rekha stays reentrant.
public fn rekha_font_open_index_why(buf, len, index, err_out): i64 {
    rekha_err_out(err_out, REKHA_OK);
    if (buf == 0) { return rekha_err_out(err_out, REKHA_ERR_OTHER); }
    if (index < 0) { return rekha_err_out(err_out, REKHA_ERR_OTHER); }
    if (len < REKHA_SFNT_OFFTAB_LEN) { return rekha_err_out(err_out, REKHA_ERR_TRUNCATED); }
    var base = 0;
    var minoff = 0;
    if (rekha_rd_u32(buf, 0) == REKHA_TAG_TTCF) {
        var nf = rekha_ttc_count(buf, len);
        if (nf == 0) { return rekha_err_out(err_out, REKHA_ERR_BAD_SFNT); }
        if (index >= nf) { return rekha_err_out(err_out, REKHA_ERR_OTHER); }
        minoff = 12 + nf * 4;
        base = rekha_rd_u32(buf, 12 + index * 4);
        if (base < minoff) { return rekha_err_out(err_out, REKHA_ERR_BAD_SFNT); }
        if (base + REKHA_SFNT_OFFTAB_LEN > len) { return rekha_err_out(err_out, REKHA_ERR_TRUNCATED); }
    } else {
        if (index != 0) { return rekha_err_out(err_out, REKHA_ERR_OTHER); }
    }
    var ver = rekha_rd_u32(buf, base);
    if (ver != REKHA_SFNT_VER_TT) {
        if (ver != REKHA_SFNT_VER_TRUE) {
            # ⚠ UNSUPPORTED, not BAD_SFNT: a `wOFF`, a `ttcf` asked for at a bad index, or a
            # PostScript Type 1 is a real font rekha does not open, and a caller that hears
            # "unsupported" can try another entry point. "Corrupt" would send it away.
            if (ver != REKHA_SFNT_VER_OTTO) { return rekha_err_out(err_out, REKHA_ERR_UNSUPPORTED); }
        }
    }
    var n = rekha_rd_u16(buf, base + 4);
    # the directory (numTables entries) must lie within the file
    if (base + REKHA_SFNT_OFFTAB_LEN + n * REKHA_SFNT_DIRENT_LEN > len) {
        return rekha_err_out(err_out, REKHA_ERR_TRUNCATED);
    }
    if (minoff == 0) { minoff = REKHA_SFNT_OFFTAB_LEN + n * REKHA_SFNT_DIRENT_LEN; }

    var f = sd_alloc(REKHA_FONT_SIZE);
    if (f == 0) { return rekha_err_out(err_out, REKHA_ERR_OOM); }
    store64(f, buf);
    store64(f + 8, len);
    store64(f + 16, ver);
    store64(f + 24, n);
    store64(f + 32, base + REKHA_SFNT_OFFTAB_LEN);
    store64(f + 248, minoff);
    store64(f + 672, REKHA_OK);
    store64(f + 680, 0);
    rekha_font_resolve(f);
    return f;
}

# @public — open face 0 and say why when it will not. The twin of rekha_font_open.
public fn rekha_font_open_why(buf, len, err_out): i64 {
    return rekha_font_open_index_why(buf, len, 0, err_out);
}

# Fill the table cache (+40..+359) of a RekhaFont whose +0..+32 header fields are set.
# Every table goes through rekha_find_table_len (extent rule) and, where a fixed field is read,
# a minimum declared length. Stack cell only — 0 B of heap.
fn rekha_font_resolve(f): i64 {
    var buf = load64(f);
    var c: i64[1];

    var upem = 0;
    var lfmt = 0;
    var head = rekha_find_table_len(f, REKHA_TAG_HEAD, &c);
    if (head != 0) {
        if (load64(&c) >= 54) {
            upem = rekha_rd_u16(buf, head + 18);
            lfmt = rekha_rd_u16(buf, head + 50);
        }
    }
    store64(f + 40, upem);
    store64(f + 48, lfmt);

    var ng = 0;
    var maxp = rekha_find_table_len(f, REKHA_TAG_MAXP, &c);
    if (maxp != 0) {
        if (load64(&c) >= 6) { ng = rekha_rd_u16(buf, maxp + 4); }
    }
    store64(f + 56, ng);

    store64(f + 64, rekha_find_table_len(f, REKHA_TAG_LOCA, &c));
    store64(f + 72, load64(&c));
    store64(f + 80, rekha_find_table_len(f, REKHA_TAG_GLYF, &c));
    store64(f + 88, load64(&c));

    var hhea = rekha_find_table_len(f, REKHA_TAG_HHEA, &c);
    var nhm = 0;
    if (hhea != 0) {
        if (load64(&c) >= 36) {
            nhm = rekha_rd_u16(buf, hhea + 34);
        } else {
            hhea = 0;
        }
    }
    store64(f + 96, hhea);
    store64(f + 104, nhm);

    store64(f + 112, rekha_find_table_len(f, REKHA_TAG_HMTX, &c));
    store64(f + 120, load64(&c));
    store64(f + 128, rekha_find_table_len(f, REKHA_TAG_CMAP, &c));
    store64(f + 136, load64(&c));

    # cmap.cyr's resolver reads cmap_off / cmap_len from the cache just stored and fills +144..+175
    rekha_cmap_resolve(f);
    rekha_cff_resolve(f);                   # +176..+239
    return 0;
}

# Locate a table by its 4-byte tag (packed big-endian into an i64, e.g.
# 'glyf' = 0x676C7966). Returns the table's byte offset within the font data
# and stores its declared LENGTH in `len_out` (an 8-byte cell).
#
# Returns 0 with *len_out = 0 when the handle is 0, the tag is absent, or the
# FIRST directory entry carrying the tag breaks the extent rule: the table must
# start at or after the end of the directory (offset >= dir_end) and end within
# the font (offset + length <= len). A lying directory entry never hands out a
# span outside the file or over the header.
# ⚠ The declared length may be anything the extent allows, 0 included — a caller that
# reads a fixed field checks the length covers it (rekha_font_resolve does, once).
# @public — the byte offset of table `tag` (a big-endian u32 of its four characters) in the font's
# bytes, its declared length stored at `len_out`; 0 (and a 0 length) when absent or lying. The
# question to ask before reading a table rekha does not parse.
public fn rekha_find_table_len(f, tag, len_out): i64 {
    store64(len_out, 0);
    if (f == 0) { return 0; }
    var buf = rekha_font_data(f);
    var len = rekha_font_len(f);
    var n = rekha_font_num_tables(f);
    var dir = rekha_font_dir_off(f);
    var dir_end = dir + n * REKHA_SFNT_DIRENT_LEN;
    var minoff = load64(f + 248);
    var i = 0;
    while (i < n) {
        var ent = dir + i * REKHA_SFNT_DIRENT_LEN;
        if (rekha_rd_u32(buf, ent) == tag) {
            var off = rekha_rd_u32(buf, ent + 8);
            var tlen = rekha_rd_u32(buf, ent + 12);
            # ⛔ For a plain SFNT `minoff` IS dir_end, so this is the rule rekha has always enforced
            # and the overlap test below can never fire. For a face inside a collection the floor is
            # lower — a shared table may precede this face's directory — and the overlap test is
            # what still refuses a table running through the face's own header and directory.
            if (off < minoff) { return 0; }
            if (off + tlen > len) { return 0; }
            if (off < dir_end && off + tlen > dir - REKHA_SFNT_OFFTAB_LEN) { return 0; }
            store64(len_out, tlen);
            return off;
        }
        i = i + 1;
    }
    return 0;
}

# @public — like rekha_find_table_len, offset only: the table's byte offset, or 0 if the
# tag is absent or its entry breaks the extent rule. One directory walk; the
# discarded length lives in a stack cell (0 B of heap).
public fn rekha_find_table(f, tag): i64 {
    var c: i64[1];
    return rekha_find_table_len(f, tag, &c);
}

# ================================================================
# Font metadata — head + maxp (cached at open).
# ================================================================

# ================================================================
# Why the last call refused — the producer for src/error.cyr's codes (0.7.0)
# ================================================================
# ⭐ WHY IT LIVES ON THE HANDLE. Every failure rekha has that a caller cannot otherwise tell from a
# legitimate answer happens to a font that is already open: an empty outline that might be a blank
# glyph or a refused one, a 0 advance that might be a zero-width glyph or an absent hmtx, a glyph
# id 0 that might be .notdef or an unreadable cmap. The handle is where that belongs.
# ⛔ NOT A GLOBAL. rekha has no mutable module-level state anywhere in src/ — every `var` in the
# library is a constant — and a global last-error would make rekha non-reentrant for the first
# time, invisibly, for the sake of a diagnostic. Two threads drawing two fonts keep their own
# answers this way, and the only cost is one slot in a record that already caches twenty tables.
# ⚠ THE OPEN FAMILY CANNOT USE IT: `rekha_font_open` fails before there is a handle to write to.
# Those have `_why` twins that take a caller's i64 slot instead — six functions, not ninety-four.
#
# ⛔ CLEARED AT THE TOP OF EVERY PUBLIC CALL THAT CAN SET IT, so it describes the call that just
# returned and not a stale failure from three calls ago. The cost is one store; the readers it sits
# in front of were MEASURED at 47 ns and 1.5 us and neither moves.
# ⚠ AND THE CONTRACT IS EXACTLY THAT: ask immediately after a call returned its sentinel. A reader
# that CANNOT refuse — `rekha_units_per_em`, `rekha_glyph_count` — does not clear, so an advance
# failure followed by one of those and then a question still reports the advance. That is a
# contract, not a guarantee, which is why it is written here rather than left to be discovered.
# ⚠ REKHA_OK is 0, so a font that has refused nothing answers 0 — which is what a caller who never
# asks gets, and costs nothing.
#
# ⚠ ONE HANDLE, ONE THREAD. Two threads sharing a handle now race on these two slots. That is a new
# obligation and it is stated rather than glossed: SHARE THE BORROWED FONT BYTES and open a handle
# per thread, which costs REKHA_FONT_SIZE and not the file. ⛔ A global would have been worse and
# not merely by taste: Cyrius 6.6.6 has no thread-local storage and `lib/thread.cyr` exposes no
# thread id, so a per-thread slot cannot even be KEYED — a global last-error would be unfixable,
# and calling it thread-safe would be the promise-that-is-not-a-feature this release exists to
# delete. ⚠ The handle was already written by readers before this (GPOS resolves its lookups
# lazily into `font + 592`, `rekha_var_set_axis` writes the coordinates); 0.7.0 adds to that, it
# does not introduce it.

# @public — the code for why `font`'s last public call refused, or REKHA_OK when it did not.
# ⛔ THIS IS NOT A SUCCESS TEST, AND USING IT AS ONE IS THE MISTAKE TO GUARD AGAINST. The RETURN
# VALUE says whether a call refused; this says WHY. Test the sentinel first and ask second — that
# order is what makes the answer describe the call you are holding, and reading a code with no
# sentinel beside it is a stale answer to a question nobody asked. It is the single commonest
# misuse of C's errno, and documentation is the only thing standing in front of it.
public fn rekha_font_error(font): i64 {
    if (font == 0) { return REKHA_OK; }
    return load64(font + 672);
}

# @public — a short static cstring naming WHERE the last refusal was — a table tag, a field — or 0
# when there is none. ⛔ Never allocated and never owned by the caller: it is a literal in the
# bundle and stays valid for the life of the program.
public fn rekha_font_error_detail(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 680);
}

# @public — forget it. Returns 0. Rarely needed, since every public call clears on entry.
public fn rekha_font_error_clear(font): i64 {
    if (font == 0) { return 0; }
    store64(font + 672, REKHA_OK);
    store64(font + 680, 0);
    return 0;
}

# Record a refusal and return 0, so a refusal site reads `return rekha_fail(font, CODE, "where");`.
fn rekha_fail(font, code, detail): i64 {
    if (font == 0) { return 0; }
    store64(font + 672, code);
    store64(font + 680, detail);
    return 0;
}

# The same, for the sites that must hand back an empty outline rather than a 0.
fn rekha_fail_outline(font, code, detail): i64 {
    rekha_fail(font, code, detail);
    return rekha_outline_empty();
}

# @public — head.unitsPerEm (u16 at head+18) — the em-square size; glyph coords are in these
# design units and the consumer scales by pixel_size / unitsPerEm.
# Returns 0 if the handle is 0 or head is absent / shorter than 54 B.
public fn rekha_units_per_em(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 40);
}

# head.indexToLocFormat (at head+50): 0 = short loca (u16 offsets, doubled),
# 1 = long loca (u32 offsets). Returns 0 (short) if the handle is 0 or head is
# absent / shorter than 54 B. Any other value is returned as read, and
# rekha_glyf_span refuses it (no outline).
fn rekha_loca_format(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 48);
}

# @public — number of glyphs in the font (maxp.numGlyphs — u16 at maxp+4): the gid range.
# Returns 0 if the handle is 0 or maxp is absent / shorter than 6 B.
public fn rekha_glyph_count(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 56);
}

# ================================================================
# hhea + hmtx — horizontal metrics.
#
# ⛔⛔ THESE TWO TAGS WERE DECLARED AND NEVER READ, AND THAT ABSENCE WAS LOAD-BEARING DOWNSTREAM.
# `REKHA_TAG_HHEA` / `REKHA_TAG_HMTX` sat in the constant block above with no reader, so every
# consumer laying out a line of scalable text had to invent an advance. dhancha hard-coded
# `advf = (h * 6) / 10` — "fixed advance ~0.6 em" — which makes a proportional face render at
# monospace pitch: correct-looking glyphs at wrong positions, which reads as a rendering bug rather
# than a missing metric. ⇒ A declared tag with no reader is a promise, not a feature.
#
# hhea (36 bytes, big-endian):
#   +0  version Fixed · +4 ascender i16 · +6 descender i16 · +8 lineGap i16
#   +10 advanceWidthMax u16 · +12..+22 bearings/caret i16 · +24..+31 reserved
#   +32 metricDataFormat i16 · +34 numberOfHMetrics u16
#
# hmtx (variable, big-endian) — TWO arrays, and the second one is the whole subtlety:
#   longHorMetric[numberOfHMetrics]          — 4 bytes each: advanceWidth u16, lsb i16
#   leftSideBearing[numGlyphs - numberOfHMetrics] — 2 bytes each, NO advance of their own
# ⛔ THE TAIL IS NOT A BUG IN THE FONT, IT IS THE FORMAT'S COMPRESSION. A run of glyphs sharing the
# LAST advance (the common case: a monospaced tail, or a CJK block) stores that advance once. A
# reader that indexes `hmtx + gid * 4` past `numberOfHMetrics` walks into the lsb array and returns
# a bearing as if it were a width.
# ================================================================

# @public — hhea.numberOfHMetrics: how many glyphs carry their own advance.
# Returns 0 if the handle is 0 or hhea is absent / shorter than its 36-byte fixed part, which
# callers must treat as "no metrics".
public fn rekha_num_h_metrics(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 104);
}

# @public — hhea.ascender, in design units (rekha_descender and rekha_line_gap below are its
# siblings; all three read the same way).
# ⚠ `descender` is NEGATIVE in every well-formed font (it measures downward from the baseline);
# returning it signed rather than as a magnitude is deliberate, so `asc - desc + gap` is the line
# height without the caller having to know which way it points.
# Each returns 0 for a 0 handle or an absent / short hhea; hhea_off is non-zero only when the
# table declares >= 36 B, so +4..+9 are inside it.
public fn rekha_ascender(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 4);
}

# @public — hhea.descender, in design units; NEGATIVE in a well-formed font (see rekha_ascender).
public fn rekha_descender(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 6);
}

# @public — the caret slope's rise (rekha_caret_slope_run is the run, rekha_caret_offset the
# offset from the caret's intersection with the baseline). All three in hhea, all three varying
# through MVAR — which is the ONLY thing in hhea that MVAR has a tag for. ⛔ A rise of 1 and a run
# of 0 is upright: the pair is a vector, not an angle, and `run` is the one that carries the lean.
# ⚠ They are hhea's, not OS/2's. `rekha_italic_angle` in post.cyr says the same thing in degrees
# and does not vary; the two need not agree, and a font that leans says so in both.
public fn rekha_caret_slope_rise(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 18) + rekha_mvar_delta(font, REKHA_MVAR_HCRS);
}

# @public — the caret slope's run, hhea + MVAR (see rekha_caret_slope_rise).
public fn rekha_caret_slope_run(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 20) + rekha_mvar_delta(font, REKHA_MVAR_HCRN);
}

# @public — the caret offset, hhea + MVAR (see rekha_caret_slope_rise).
public fn rekha_caret_offset(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 22) + rekha_mvar_delta(font, REKHA_MVAR_HCOF);
}

# @public — hhea.lineGap, in design units (see rekha_ascender).
public fn rekha_line_gap(font): i64 {
    if (font == 0) { return 0; }
    var hhea = load64(font + 96);
    if (hhea == 0) { return 0; }
    return rekha_rd_i16(load64(font), hhea + 8);
}

# @public — the advance width of glyph `gid`, in font DESIGN UNITS (unitsPerEm space).
# Returns 0 if the glyph has no readable metric — a 0 handle, hhea/hmtx absent, numberOfHMetrics 0,
# a negative gid, or a long metric that lies past hmtx's DECLARED length (a truncated hmtx, or an
# hhea claiming more metrics than hmtx holds, reads as unknown — never as the next table's bytes).
#
# ⛔ 0 IS "UNKNOWN", NOT "ZERO-WIDTH", and the caller must not paint with it. A zero advance stacks
# every glyph on the same x. Consumers should fall back to their own estimate when this returns 0 —
# which is exactly what a font with no hmtx forces anyway.
# ⛔ THE CLAMP AT `numberOfHMetrics - 1` IS THE FORMAT, NOT A GUESS. Glyphs past that index share the
# last long metric's advance; only their left side bearings are stored individually. Reading
# `hmtx + gid * 4` for them would return an lsb pair as a width. (A gid past numGlyphs clamps the
# same way; rekha_char_to_glyph never produces one.)
# ⚠ Design units, not pixels. Scale with `rekha_units_per_em`: `px = adv * size / upem`, or use
# rekha_glyph_advance_px / rekha_glyph_advance_fx below.
public fn rekha_advance_width(font, gid): i64 {
    if (font == 0) { return 0; }
    # ⭐ 0 MEANT THREE THINGS. This reader's own note has always said its 0 is UNKNOWN and NOT
    # ZERO-WIDTH — and a zero advance is a legal metric for a combining mark, so a consumer could
    # not tell the legal one from "no hhea" or "hmtx truncated". Now REKHA_OK distinguishes them.
    rekha_font_error_clear(font);
    if (gid < 0) { return rekha_fail(font, REKHA_ERR_OTHER, "glyph id"); }
    var nhm = load64(font + 104);
    if (nhm <= 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "hhea"); }
    var hmtx = load64(font + 112);
    if (hmtx == 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "hmtx"); }
    var idx = gid;
    if (idx >= nhm) { idx = nhm - 1; }
    if ((idx + 1) * 4 > load64(font + 120)) {
        return rekha_fail(font, REKHA_ERR_TRUNCATED, "hmtx");
    }
    var w = rekha_rd_u16(load64(font), hmtx + idx * 4);
    # ⭐ AND IT VARIES (0.6.0). `idx` is clamped into the long-metric array; the HVAR lookup takes
    # the REAL gid, because the delta is per glyph however hmtx compressed its tail. Costs one load
    # and a compare when no axis is set. ⛔ Clamped at 0: an advance is a width, and a store that
    # would take it negative is refused by arithmetic rather than believed.
    w = w + rekha_hvar_advance_delta(font, gid);
    if (w < 0) { return 0; }
    return w;
}

# @public — the left side bearing of glyph `gid`, in font DESIGN UNITS: the horizontal twin of
# rekha_top_side_bearing, with rekha_advance_width's refusals — a 0 handle, a negative gid,
# hhea / hmtx absent, numberOfHMetrics 0 (NO_TABLE "hhea"), or a bearing that lies past hmtx's
# DECLARED length (TRUNCATED "hmtx") answer 0 with the code, and a legal 0 answers REKHA_OK.
# ⛔ THE TAIL RULE IS THE FORMAT'S: a gid at or past numberOfHMetrics has its bearing in the bare
# i16 array that FOLLOWS the long metrics, at `hmtx + numberOfHMetrics * 4 + (gid - numberOfHMetrics)
# * 2` — not in a long record of its own (there is none) and not in the last record's (that is the
# shared advance). programs/extent_test.cyr's font carries such a tail.
# ⭐ AND IT VARIES (v0.8.2): the HVAR lsb map's delta is added, the way rekha_advance_width adds the
# advance map's, so the two frozen readers agree on what a variation instance means. ⚠ FreeType's
# TrueType driver does not adjust the lsb (ref2143/ttdriver.c:559), and the HINTED loader follows
# FreeType, not this reader: its left phantom is xMin minus the UNVARIED bearing (src/hint.cyr
# rekha_hint_hmetrics), so on a variation instance of a face with an lsb map this metric and the
# hinted outline's origin disagree by the delta. docs/development/roadmap.md pins the difference.
public fn rekha_left_side_bearing(font, gid): i64 {
    if (font == 0) { return 0; }
    rekha_font_error_clear(font);
    if (gid < 0) { return rekha_fail(font, REKHA_ERR_OTHER, "glyph id"); }
    var nhm = load64(font + 104);
    if (nhm <= 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "hhea"); }
    var hmtx = load64(font + 112);
    if (hmtx == 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "hmtx"); }
    var at = gid * 4 + 2;
    if (gid >= nhm) { at = nhm * 4 + (gid - nhm) * 2; }
    if (at + 2 > load64(font + 120)) { return rekha_fail(font, REKHA_ERR_TRUNCATED, "hmtx"); }
    return rekha_rd_i16(load64(font), hmtx + at) + rekha_hvar_lsb_delta(font, gid);
}

# @public — the advance of glyph `gid` in PIXELS at pixel size `px_size`, rounded half-up:
# `(adv * px_size + upem / 2) / upem`. 0 = unknown (upem <= 0 or advance <= 0). Allocates 0 B.
# ⭐ The gid-level form exists so a consumer maps a codepoint ONCE and reuses the gid for
# rekha_glyph_to_sdpath and every advance pass; rekha_char_advance_px is this plus a cmap lookup.
public fn rekha_glyph_advance_px(font, gid, px_size): i64 {
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var adv = rekha_advance_width(font, gid);
    if (adv <= 0) { return 0; }
    return (adv * px_size + upem / 2) / upem;
}

# @public — the advance of glyph `gid` at pixel size `px_size` as 16.16 FIXED-POINT pixels
# (sadish's convention): `(adv * px_size * 65536 + upem / 2) / upem`. 0 = unknown, as above.
# ⭐ THIS IS THE ONE TO ACCUMULATE. Summing per-glyph-rounded pixel advances still drifts — each
# rounding is off by up to half a pixel and the errors add. Sum the 16.16 advances into the pen and
# round the pen once when placing a glyph; the run width is then exact to 1/65536 px per glyph.
# adv <= 65535, so the product fits i64 for any px_size below 2^31.
public fn rekha_glyph_advance_fx(font, gid, px_size): i64 {
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var adv = rekha_advance_width(font, gid);
    if (adv <= 0) { return 0; }
    return (adv * px_size * 65536 + upem / 2) / upem;
}

# ================================================================
# loca -> glyf span: resolve glyph `gid` to its byte range in the glyf table.
# `out` is a 16-byte cell: out+0 = absolute file offset of the glyph's glyf
# entry, out+8 = its length. Returns 1 if the glyph has an outline, 0 if:
#   - the handle is 0, or gid < 0 or gid >= maxp.numGlyphs;
#   - loca or glyf is absent, or indexToLocFormat is neither 0 nor 1;
#   - loca[gid + 1] lies past loca's DECLARED length;
#   - the glyph is empty (e.g. space: loca[gid] == loca[gid+1]) or its offsets run backwards;
#   - the span ends past glyf's DECLARED length.
# ⛔ THREE REFUSALS HERE ARE STATED DIVERGENCES FROM FreeType's tt_face_get_location
# (ref2143/ttpload.c:183-288), which loads where rekha refuses; docs/development/roadmap.md's
# pinned table carries all three, and they are the whole of the corpus sweep's 'refused' class
# on a face FreeType's pedantic mode loads:
#   - offsets that run BACKWARDS (loca[gid + 1] < loca[gid]): FreeType takes the span to run from
#     loca[gid] to the END of glyf (:282-286); rekha refuses BAD_GLYF "loca order";
#   - the LAST glyph's end past glyf's length: FreeType clips it to glyf's end (:246-254); rekha
#     refuses BAD_GLYF "loca past glyf";
#   - any OTHER glyph's end past glyf's length: FreeType answers a size of 0, an EMPTY glyph with
#     real phantoms and advance (:255-265), as it does for a START past glyf's length in either
#     position (:225-235); rekha refuses the same "loca past glyf".
# A lying loca yields no outline, never bytes from the table after glyf and never a blank where
# the font promised a shape; the hinted loader (src/hint.cyr) answers 0 with an empty zone.
# ================================================================
# ⭐ THIS 0 WAS THE AMBIGUITY ONE LEVEL DOWN, and 0.7.0 found it here rather than at
# rekha_load_glyph where it was being looked for. "The glyph is empty (e.g. space)" and "loca is
# lying" were the same answer, so wiring the LOADER alone reported a blank glyph as a malformed
# one. The empty case stays silent; every other 0 now says why.
fn rekha_glyf_span(font, gid, out): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    if (font == 0) { return 0; }
    rekha_font_error_clear(font);
    if (gid < 0) { return rekha_fail(font, REKHA_ERR_OTHER, "glyph id"); }
    if (gid >= load64(font + 56)) { return rekha_fail(font, REKHA_ERR_OTHER, "glyph id"); }
    var loca = load64(font + 64);
    if (loca == 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "loca"); }
    var glyf = load64(font + 80);
    if (glyf == 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "glyf"); }
    var buf = load64(font);
    var loca_len = load64(font + 72);
    var fmt = load64(font + 48);

    var o0 = 0;
    var o1 = 0;
    if (fmt == 0) {
        # short: two u16 offsets (bytes = value*2); loca[gid+1] inside loca
        if ((gid + 2) * 2 > loca_len) { return rekha_fail(font, REKHA_ERR_TRUNCATED, "loca"); }
        o0 = rekha_rd_u16(buf, loca + gid * 2) * 2;
        o1 = rekha_rd_u16(buf, loca + (gid + 1) * 2) * 2;
    } else {
        if (fmt != 1) { return rekha_fail(font, REKHA_ERR_BAD_SFNT, "indexToLocFormat"); }
        if ((gid + 2) * 4 > loca_len) { return rekha_fail(font, REKHA_ERR_TRUNCATED, "loca"); }
        o0 = rekha_rd_u32(buf, loca + gid * 4);
        o1 = rekha_rd_u32(buf, loca + (gid + 1) * 4);
    }
    # ⚠ NOT AN ERROR, and this is the line the whole release turns on: loca[gid] == loca[gid + 1]
    # is how a font spells a space. Offsets that run BACKWARDS are a different thing and are.
    if (o1 == o0) { return 0; }
    if (o1 < o0) { return rekha_fail(font, REKHA_ERR_BAD_GLYF, "loca order"); }
    if (o1 > load64(font + 88)) { return rekha_fail(font, REKHA_ERR_BAD_GLYF, "loca past glyf"); }
    store64(out, glyf + o0);
    store64(out + 8, o1 - o0);
    return 1;
}

# --- glyf.cyr ---

# glyf-table outline loader + the sadish path seam.
# glyf.cyr — read a TrueType glyph's outline (contours of on-curve /
# off-curve points) out of the 'glyf' table and emit it as sadish path verbs
# (moveto / lineto / quadto / close) appended to an SdPath.
#
# rekha does NOT rasterize. It emits RESOLUTION-INDEPENDENT PATHS; the
# `sadish` 2D vector core consumes those verbs and fills them to pixels.
# This module is the seam between the two: rekha_outline_to_sdpath walks a
# RekhaOutline and appends each verb to a sadish SdPath. sadish is a wired,
# hard dependency (src/lib.cyr includes it).
#
# TrueType glyf entry (per glyph, big-endian):
#   +0  numberOfContours  i16  (>= 0 simple; < 0 composite)
#   +2  xMin/yMin/xMax/yMax i16 x4 (bounding box)
#   ... endPtsOfContours[numberOfContours] u16
#   ... instructionLength u16 + instructions[]
#   ... flags[] (run-length) then x-coords then y-coords (delta-encoded)
# Glyph N's byte span within 'glyf' is loca[N]..loca[N+1] (the loca table).

# ================================================================
# RekhaOutline — a decoded glyph outline (48 bytes).
# Point coords are in font design units (unitsPerEm space); the consumer
# scales. Contour structure is captured as parallel arrays so
# rekha_outline_to_sdpath can reconstruct on-curve/off-curve runs into
# quadratic segments.
#
#   +0   n_contours   (i64 — number of closed contours; 0 = empty glyph)
#   +8   n_points     (i64 — total point count across all contours)
#   +16  end_pts      (ptr — i64[n_contours] last-point index per contour, or 0)
#   +24  xs           (ptr — i64[n_points] x coords in design units, or 0)
#   +32  ys           (ptr — i64[n_points] y coords in design units, or 0)
#   +40  on_curve     (ptr — u8[n_points] 1 = on-curve, 0 = quadratic control (glyf),
#                     2 = cubic control (CFF, cff.cyr), or 0)
#
# ⭐ WHAT THE LOADERS GUARANTEE: end_pts STRICTLY increase and every one is < n_points, and the four
# arrays are carved from the SAME allocation as the record (record first, then end_pts, xs, ys,
# on_curve) — one sd_alloc per decoded glyph.
#
# ⭐ EVERY BYTE THIS MODULE ALLOCATES COMES FROM sadish's SEAM (`sd_alloc`, sadish >= 0.5.5), NOT
# THE STDLIB `alloc`. rekha already hard-depends on sadish (rekha_outline_to_sdpath builds SdPaths),
# so the draw stack has ONE allocation knob, owned by the leaf — the way it has one fixed-point
# convention (16.16, sadish's). A consumer that scopes `sd_alloc_set` around a text draw gets the
# outlines, the paths and the coverage from the same place, and a per-frame arena reclaims all
# three at once. Before 0.3.10 the outline scratch (span, end_pts, flags, on_curve, xs, ys, the
# record) came from the global bump allocator, which has no free(): MEASURED 136 B per
# rekha_char_to_sdpath of a 3-point glyph, PER GLYPH PER LABEL PER FRAME, leaking under a
# consumer's hook even after sadish 0.5.5 had moved the path onto it (dhancha's filing,
# 2026-09-13-scalable-text-allocates-per-call-outside-the-frame-arena.md).
# 0.3.11 carves each glyph into one block (the span lives on the stack, the flag bytes ride in
# on_curve): MEASURED 112 B for that 3-point glyph, and a composite costs its children + an
# n-slot pointer array + one exact-size merged block — MEASURED 232 B for alloc_test's
# one-component composite, which 0.3.10 paid 70,856 B for (fixed 4096-point merge buffers).
# ⚠ `rekha_font_open`'s REKHA_FONT_SIZE-byte RekhaFont lands in the hook too when one is set. A font outlives
# every frame, so a consumer opens fonts OUTSIDE a scoped hook. Reading one costs nothing:
# rekha_char_to_glyph / rekha_advance_width / rekha_units_per_em allocate 0 B (MEASURED).
# ⛔ A pointer that outlives the hook's backing store is dangling. An outline or a path made under
# an arena hook must not be kept across that arena's reset; that is the consumer's lifetime call,
# exactly as it is for sadish's own paths.
# ⭐ A HOOK MAY REFUSE: THE DRAW RETURNS 0, IT DOES NOT FAULT AND IT IS NEVER PARTIAL (0.4.3).
# rekha's own sites check every sd_alloc ("0 only on OOM"), sadish >= 0.7.2 returns SADISH_ERR_OOM
# from a refused path allocation instead of storing through it (rekha filed that; archived in sadish
# as issues/archived/2026-09-15-path-construction-stores-through-a-refused-allocation.md), and
# rekha_emit_contour checks every sd_path_* status so a refusal cannot leave a glyph missing verbs.
# MEASURED on sadish 0.9.0, a hook granting its first K blocks then refusing, K = 0..63 over
# LiberationSans 'A': every call returns either 0 or the whole 17-verb path — no fault, no truncation
# (programs/hostile_test.cyr, the refusing-hook sweep).
# ================================================================
# @public — the RekhaOutline record: 48 bytes, six i64 slots in this order — the contour count, the
# point count, then three pointers (end_pts, xs, ys) and the on_curve byte array. Read it through
# the six accessors; build one by hand (REKHA_OUTLINE_SIZE) only to feed rekha_outline_to_sdpath.
public var REKHA_OUTLINE_SIZE = 48;

# @public — the six readers of a RekhaOutline. `end_pts` is i64[n_contours], each the LAST point
# index of its contour, strictly increasing and below n_points (rekha_load_glyph refuses otherwise);
# `xs` / `ys` are i64[n_points] in design units — F26Dot6 for a hinted view; `on_curve` is one byte
# a point: bit 0 on-curve, bit 1 a CUBIC control (CFF), and for a hinted view REKHA_TAG_*.
public fn rekha_outline_n_contours(o): i64 { return load64(o); }
public fn rekha_outline_n_points(o): i64   { return load64(o + 8); }
public fn rekha_outline_end_pts(o): i64    { return load64(o + 16); }
public fn rekha_outline_xs(o): i64         { return load64(o + 24); }
public fn rekha_outline_ys(o): i64         { return load64(o + 32); }
public fn rekha_outline_on_curve(o): i64   { return load64(o + 40); }

# Zero an outline record in place, making it a valid empty outline. Returns `o`. A loader that
# finds malformed data AFTER carving its block returns the block this way rather than allocating
# a second, empty record.
fn rekha_outline_clear(o): i64 {
    store64(o, 0);
    store64(o + 8, 0);
    store64(o + 16, 0);
    store64(o + 24, 0);
    store64(o + 32, 0);
    store64(o + 40, 0);
    return o;
}

# Allocate an empty outline (all fields zeroed). Returns 0 on OOM.
fn rekha_outline_empty(): i64 {
    var o = sd_alloc(REKHA_OUTLINE_SIZE);
    if (o == 0) {
        return 0;
    }
    return rekha_outline_clear(o);
}

# ================================================================
# Load caps. They bound what ONE rekha_load_glyph may decode and allocate, whatever the font says —
# an attacker writes maxp too, so none of them is read from the font.
#
#   REKHA_COMPOSITE_MAXP        points in ONE outline: a simple glyph declaring more, or a
#                               composite whose children sum to more, is REJECTED (empty) — never
#                               clamped, since a clamped point array under unclamped end_pts is an
#                               out-of-bounds read at emit.
#   REKHA_COMPOSITE_MAXC        contours in one composite outline (rejected past it, as above).
#   REKHA_COMPOSITE_MAXDEPTH    component nesting; depth 0 is the glyph asked for.
#   REKHA_GLYPH_MAXLOADS        glyph loads per rekha_load_glyph, the root included.
#   REKHA_GLYPH_MAXPOINTS_TOTAL points decoded across the whole load: every simple glyph's np plus
#                               every composite's merged total.
# ⛔ The last two are the load-bearing DoS bound. Depth alone let a composite whose N components
# reference one glyph (itself, or an acyclic chain of them) decode sum N^L bodies; cycle detection
# alone does not catch the acyclic case. Tripping either one ABORTS the whole load — sticky, the
# top-level result is an EMPTY outline, never a partial one — and so does a depth overrun or a gid
# that already sits on its own component stack.
# ================================================================
var REKHA_COMPOSITE_MAXP        = 4096;
var REKHA_COMPOSITE_MAXC        = 128;
var REKHA_COMPOSITE_MAXDEPTH    = 5;
var REKHA_GLYPH_MAXLOADS        = 64;
var REKHA_GLYPH_MAXPOINTS_TOTAL = 16384;

# The load context lives on rekha_load_glyph's STACK (0 B of heap), as i64 slots:
#   +0  loads remaining      +8  points remaining      +16  abort (0 / 1)
#   +24 gid stack: the gid being loaded at depth d sits at +24 + d*8, d = 0..MAXDEPTH
# ⛔ 3 + (REKHA_COMPOSITE_MAXDEPTH + 1) slots — rekha_load_glyph declares 9. Raise both together.
fn rekha_load_abort(ctx): i64 {
    store64(ctx + 16, 1);
    return rekha_outline_empty();
}

# ================================================================
# glyf access — load + path emit. (rekha_glyph_count, a maxp reader, lives in sfnt.cyr.)
# Every byte a loader reads lies inside the glyph's span [start, end), which rekha_glyf_span has
# already bounded by glyf's declared length; a read that would leave the span returns an empty
# outline.
# ================================================================

# ================================================================
# The simple-glyph decoder, in two halves shared by rekha_load_simple (which carves one block per
# glyph) and by the hinted loader in src/hint.cyr (which decodes straight into the glyph zone's
# arrays at a point offset): the header gates below size the arrays and locate the instructions,
# and rekha_glyf_decode_simple writes the points into whatever arrays the caller hands it. One
# decoder, one copy of the flag / delta logic, two owners of the memory it fills.
# ================================================================

# The simple-glyph header past numberOfContours and the bbox (ref2143/ttgload.c:341-431 reads the
# same three things): the endPts array, the instruction length and bytes, then the first flag
# byte. Writes six slots into `h`: +0 np (points), +8 the endPts offset, +16 the instruction
# offset, +24 the instruction length, +32 the flags offset, +40 `end`. 1, or 0 with a code on the
# font: endPts past the span (TRUNCATED "endPts"), a last endPt below the contour count (BAD_GLYF
# "endPts"), np over the outline cap (OOM "point cap"), the instruction length or bytes past the
# span (TRUNCATED "instructions"), more points than the remaining bytes could carry as flags
# (BAD_GLYF "flags"). Two flag bytes (flag + REPEAT count) declare at most 256 points, so the
# last gate refuses BEFORE a caller costs an allocation or a zone fill.
fn rekha_glyf_simple_hdr(font, start, end, nc, h): i64 {
    var buf = rekha_font_data(font);
    var p = start + 10;                    # skip numberOfContours(2) + bbox(8)
    if (p + nc * 2 > end) { return rekha_fail(font, REKHA_ERR_TRUNCATED, "endPts"); }
    # O(1) gates FIRST: the LAST endPt sizes the arrays; strict increase is walked by the decoder,
    # once the glyph has been charged. ⛔ Walking all nc endPts before any cap let a composite of 63
    # rejected 32,767-contour glyphs spend ~2 M iterations in one load — MEASURED 9.6 ms, outside
    # every budget.
    var np = rekha_rd_u16(buf, p + (nc - 1) * 2) + 1;
    if (nc > np) { return rekha_fail(font, REKHA_ERR_BAD_GLYF, "endPts"); }
    if (np > REKHA_COMPOSITE_MAXP) { return rekha_fail(font, REKHA_ERR_OOM, "point cap"); }
    store64(h, np);
    store64(h + 8, p);
    p = p + nc * 2;
    if (p + 2 > end) { return rekha_fail(font, REKHA_ERR_TRUNCATED, "instructions"); }
    var instr_len = rekha_rd_u16(buf, p);
    store64(h + 16, p + 2);
    store64(h + 24, instr_len);
    p = p + 2 + instr_len;
    if (p > end) { return rekha_fail(font, REKHA_ERR_TRUNCATED, "instructions"); }
    if (np > (end - p) * 128 + 1) { return rekha_fail(font, REKHA_ERR_BAD_GLYF, "flags"); }
    store64(h + 32, p);
    store64(h + 40, end);
    return 1;
}

# 1 when the nc endPts at `eps_at` strictly increase — the pre-allocation gate of
# rekha_load_simple, walked once the glyph has been charged (nc <= np, so it is inside the budget).
fn rekha_glyf_endpts_ok(buf, eps_at, nc): i64 {
    var last = 0 - 1;
    var i = 0;
    while (i < nc) {
        var ep = rekha_rd_u16(buf, eps_at + i * 2);
        if (ep <= last) { return 0; }
        last = ep;
        i = i + 1;
    }
    return 1;
}

# Decode the endPts, flags, x and y of the simple glyph `h` describes (rekha_glyf_simple_hdr's six
# slots) into the caller's arrays: eps i64[nc], xs / ys i64[np] in absolute design units, oc u8[np].
# ⚠ oc holds each RAW flag byte until the y pass — the last reader — masks it to its on-curve bit,
# so a caller may hand it the very byte array the flags will live in. ⛔ THE endPts ARE CHECKED ON
# WHAT IS STORED, strictly increasing and ending at np - 1: the bytes are read here again, across
# whatever the caller did between the header gates and this call (an sd_alloc a hook could use to
# rewrite a shared buffer), and the guarantee every consumer of end_pts relies on is about the
# stored array, not the font bytes. 1 when every array is complete; 0 when the bytes run out
# (TRUNCATED, the caller's to name); -1 when an endPt breaks the order (BAD_GLYF "endPts order").
# A 0 or -1 leaves the arrays partly written — the caller clears or refuses what it owns.
fn rekha_glyf_decode_simple(buf, h, nc, eps, xs, ys, oc): i64 {
    var np = load64(h);
    var eps_at = load64(h + 8);
    var p = load64(h + 32);
    var end = load64(h + 40);
    var last = 0 - 1;
    var i = 0;
    while (i < nc) {
        var ep = rekha_rd_u16(buf, eps_at + i * 2);
        if (ep <= last) { return 0 - 1; }
        store64(eps + i * 8, ep);
        last = ep;
        i = i + 1;
    }
    if (last != np - 1) { return 0 - 1; }

    # The raw flag bytes decode INTO oc; the y pass (their last reader) masks each to 0/1.
    var fi = 0;
    while (fi < np) {
        if (p >= end) { return 0; }
        var fl = load8(buf + p);
        p = p + 1;
        store8(oc + fi, fl);
        fi = fi + 1;
        if ((fl & 8) != 0) {
            if (p >= end) { return 0; }
            var rep = load8(buf + p);
            p = p + 1;
            # ⚠ A REPEAT count past the last point is CLAMPED — a stated LENIENCY, the other way
            # round from rekha's usual refusals: FreeType REFUSES the whole glyph as Invalid_Outline
            # when the repeated flags would run past the point count (ref2143/ttgload.c:451-452),
            # so such a glyph draws (and hints) here and does not load there. Both loaders share
            # this decoder, so the unhinted and the hinted outline agree with each other; the
            # pinned table in docs/development/roadmap.md carries the divergence.
            if (rep > np - fi) { rep = np - fi; }
            var r = 0;
            while (r < rep) {
                store8(oc + fi, fl);
                fi = fi + 1;
                r = r + 1;
            }
        }
    }

    var x = 0;
    var xi = 0;
    while (xi < np) {
        var fx = load8(oc + xi);
        var dx = 0;
        if ((fx & 2) != 0) {
            if (p >= end) { return 0; }
            dx = load8(buf + p);
            p = p + 1;
            if ((fx & 16) == 0) { dx = 0 - dx; }
        } else {
            if ((fx & 16) == 0) {
                if (p + 2 > end) { return 0; }
                dx = rekha_rd_i16(buf, p);
                p = p + 2;
            }
        }
        x = x + dx;
        store64(xs + xi * 8, x);
        xi = xi + 1;
    }

    var y = 0;
    var yi = 0;
    while (yi < np) {
        var fy = load8(oc + yi);
        store8(oc + yi, fy & 1);
        var dy = 0;
        if ((fy & 4) != 0) {
            if (p >= end) { return 0; }
            dy = load8(buf + p);
            p = p + 1;
            if ((fy & 32) == 0) { dy = 0 - dy; }
        } else {
            if ((fy & 32) == 0) {
                if (p + 2 > end) { return 0; }
                dy = rekha_rd_i16(buf, p);
                p = p + 2;
            }
        }
        y = y + dy;
        store64(ys + yi * 8, y);
        yi = yi + 1;
    }
    return 1;
}

# Parse a SIMPLE glyph (numberOfContours nc > 0) spanning [start, end) into a fresh RekhaOutline.
# Arrays are i64 (xs/ys/end_pts) + u8 (on_curve); coords are absolute (delta-decoded) design
# units. Empty for a truncated glyph, for endPtsOfContours that do not strictly increase, for
# np > REKHA_COMPOSITE_MAXP, and for more points than the remaining bytes could carry as flags
# (each named through rekha_font_error by the header gates). 0 only on OOM.
fn rekha_load_simple(font, gid, start, end, nc, ctx): i64 {
    var buf = rekha_font_data(font);
    var h: i64[6];
    if (rekha_glyf_simple_hdr(font, start, end, nc, &h) == 0) { return rekha_outline_empty(); }
    var np = load64(&h);
    # Charged BEFORE the O(nc) walk (nc <= np), so the walk itself is inside the points budget.
    var pts_left = load64(ctx + 8) - np;
    if (pts_left < 0) { return rekha_load_abort(ctx); }
    store64(ctx + 8, pts_left);
    # ⛔ STRICTLY INCREASING, so the last endPt bounds every contour: an earlier endPt past np would
    # walk emit off the point arrays. Checked here before the allocation, and again by the decoder
    # on what it stores.
    if (rekha_glyf_endpts_ok(buf, load64(&h + 8), nc) == 0) {
        return rekha_fail_outline(font, REKHA_ERR_BAD_GLYF, "endPts order");
    }

    var o = sd_alloc(REKHA_OUTLINE_SIZE + nc * 8 + np * 17);
    if (o == 0) { return 0; }
    var end_pts = o + REKHA_OUTLINE_SIZE;
    var xs = end_pts + nc * 8;
    var ys = xs + np * 8;
    var on_curve = ys + np * 8;
    # A truncation or a re-read endPt out of order after the carve returns the block cleared, as
    # every post-carve refusal here always has.
    if (rekha_glyf_decode_simple(buf, &h, nc, end_pts, xs, ys, on_curve) != 1) {
        return rekha_outline_clear(o);
    }

    # ⭐ VARIATIONS, and the one place they touch a TrueType outline: the points are decoded, the
    # contours are known, and nothing has been scaled or emitted yet — which is exactly what gvar's
    # deltas and its per-contour interpolation need. At the default location, or in a font with no
    # gvar, this is one load and a return (0.4.12).
    rekha_gvar_apply(font, gid, xs, ys, np, nc, end_pts);

    store64(o, nc);
    store64(o + 8, np);
    store64(o + 16, end_pts);
    store64(o + 24, xs);
    store64(o + 32, ys);
    store64(o + 40, on_curve);
    return o;
}

# Parse the component record at p into `rec` (i64[8]: flags, glyphIndex, arg1, arg2, xx, xy, yx,
# yy — the 2x2 in F2Dot14, identity when absent). arg1/arg2 are SIGNED offsets when
# ARGS_ARE_XY_VALUES is set and UNSIGNED point numbers when it is clear. Returns the offset past
# the record, or 0 if the record does not fit in [p, end).
fn rekha_comp_record(buf, p, end, rec): i64 {
    if (p + 4 > end) { return 0; }
    var flags = rekha_rd_u16(buf, p);
    store64(rec, flags);
    store64(rec + 8, rekha_rd_u16(buf, p + 2));
    p = p + 4;
    if ((flags & 1) != 0) {                    # ARG_1_AND_2_ARE_WORDS
        if (p + 4 > end) { return 0; }
        if ((flags & 2) != 0) {
            store64(rec + 16, rekha_rd_i16(buf, p));
            store64(rec + 24, rekha_rd_i16(buf, p + 2));
        } else {
            store64(rec + 16, rekha_rd_u16(buf, p));
            store64(rec + 24, rekha_rd_u16(buf, p + 2));
        }
        p = p + 4;
    } else {
        if (p + 2 > end) { return 0; }
        if ((flags & 2) != 0) {
            store64(rec + 16, rekha_rd_i8(buf, p));
            store64(rec + 24, rekha_rd_i8(buf, p + 1));
        } else {
            store64(rec + 16, load8(buf + p));
            store64(rec + 24, load8(buf + p + 1));
        }
        p = p + 2;
    }
    var xx = 16384;                            # 1.0 in F2Dot14 (identity)
    var xy = 0;
    var yx = 0;
    var yy = 16384;
    if ((flags & 8) != 0) {                    # WE_HAVE_A_SCALE
        if (p + 2 > end) { return 0; }
        xx = rekha_rd_i16(buf, p);
        yy = xx;
        p = p + 2;
    } else {
        if ((flags & 64) != 0) {               # WE_HAVE_AN_X_AND_Y_SCALE
            if (p + 4 > end) { return 0; }
            xx = rekha_rd_i16(buf, p);
            yy = rekha_rd_i16(buf, p + 2);
            p = p + 4;
        } else {
            if ((flags & 128) != 0) {          # WE_HAVE_A_TWO_BY_TWO
                if (p + 8 > end) { return 0; }
                xx = rekha_rd_i16(buf, p);
                xy = rekha_rd_i16(buf, p + 2);
                yx = rekha_rd_i16(buf, p + 4);
                yy = rekha_rd_i16(buf, p + 6);
                p = p + 8;
            }
        }
    }
    store64(rec + 32, xx);
    store64(rec + 40, xy);
    store64(rec + 48, yx);
    store64(rec + 56, yy);
    return p;
}

# Parse a COMPOSITE glyph (numberOfContours < 0): a sequence of component
# records, each a glyph reference + a 2x2 F2Dot14 transform + an offset or a
# point-matching pair. Three passes over the records:
#   1. count them, refusing a truncated record (empty);
#   2. load every child through rekha_load_glyph_d (the shared load context);
#   3. merge into ONE exact-size carved block — the children's points
#      transformed x' = (xx*x + yx*y + 8192) >> 14 (arithmetic: ROUNDED, exact
#      for identity / ±1 / 0), then offset.
# The offset is (arg1, arg2) — scaled by the 2x2 when SCALED_COMPONENT_OFFSET
# (0x800) is set and UNSCALED_COMPONENT_OFFSET (0x1000) is clear — or, when
# ARGS_ARE_XY_VALUES is clear, whatever moves child point arg2 (transformed) onto
# merged point arg1. Empty when the merge exceeds REKHA_COMPOSITE_MAXP /
# REKHA_COMPOSITE_MAXC or a point number is out of range; 0 only on OOM.
fn rekha_load_composite(font, gid, start, end, depth, ctx): i64 {
    var buf = rekha_font_data(font);
    var rec: i64[8];

    var n = 0;
    var p = start + 10;
    var more = 1;
    while (more != 0) {
        p = rekha_comp_record(buf, p, end, &rec);
        if (p == 0) { return rekha_fail_outline(font, REKHA_ERR_TRUNCATED, "component"); }
        n = n + 1;
        # More components than loads left can only end in an abort; take it before allocating.
        if (n > load64(ctx)) { return rekha_load_abort(ctx); }
        if ((load64(&rec) & 32) == 0) { more = 0; }   # no MORE_COMPONENTS
    }

    var comps = sd_alloc(n * 8);
    if (comps == 0) { return 0; }
    var tot_pts = 0;
    var tot_ctr = 0;
    p = start + 10;
    var k = 0;
    while (k < n) {
        p = rekha_comp_record(buf, p, end, &rec);
        var co = rekha_load_glyph_d(font, load64(&rec + 8), depth + 1, ctx);
        if (co == 0) { return 0; }
        if (load64(ctx + 16) != 0) { return rekha_outline_empty(); }   # sticky abort
        store64(comps + k * 8, co);
        tot_pts = tot_pts + rekha_outline_n_points(co);
        tot_ctr = tot_ctr + rekha_outline_n_contours(co);
        k = k + 1;
    }
    if (tot_ctr == 0) { return rekha_outline_empty(); }   # ⚠ every component was blank: not an error
    if (tot_pts > REKHA_COMPOSITE_MAXP) { return rekha_fail_outline(font, REKHA_ERR_OOM, "point cap"); }
    if (tot_ctr > REKHA_COMPOSITE_MAXC) { return rekha_fail_outline(font, REKHA_ERR_OOM, "contour cap"); }
    var pts_left = load64(ctx + 8) - tot_pts;
    if (pts_left < 0) { return rekha_load_abort(ctx); }
    store64(ctx + 8, pts_left);

    # ⭐ gvar VARIES A COMPOSITE THROUGH ITS COMPONENT OFFSETS: each component counts as ONE point,
    # the four phantom points follow, and there is no interpolation to do — a component no tuple
    # names keeps a zero delta, which is what per-point contours would have produced anyway. Only
    # allocated when something can actually vary (0.4.12).
    var cdx = 0;
    var cdy = 0;
    if (rekha_var_live(font) != 0) {
        if (load64(font + 336) != 0) {
            cdx = sd_alloc(n * 16);
            if (cdx == 0) { return 0; }
            cdy = cdx + n * 8;
            var zc = 0;
            while (zc < n * 2) {
                store64(cdx + zc * 8, 0);
                zc = zc + 1;
            }
            rekha_gvar_apply(font, gid, cdx, cdy, n, 0, 0);
        }
    }

    var o = sd_alloc(REKHA_OUTLINE_SIZE + tot_ctr * 8 + tot_pts * 17);
    if (o == 0) { return 0; }
    var eps = o + REKHA_OUTLINE_SIZE;
    var xs = eps + tot_ctr * 8;
    var ys = xs + tot_pts * 8;
    var oc = ys + tot_pts * 8;
    var base = 0;
    var cbase = 0;
    p = start + 10;
    k = 0;
    while (k < n) {
        p = rekha_comp_record(buf, p, end, &rec);
        var c = load64(comps + k * 8);
        var cnp = rekha_outline_n_points(c);
        var cnc = rekha_outline_n_contours(c);
        var cxs = rekha_outline_xs(c);
        var cys = rekha_outline_ys(c);
        var coc = rekha_outline_on_curve(c);
        var ceps = rekha_outline_end_pts(c);
        var flags = load64(&rec);
        var xx = load64(&rec + 32);
        var xy = load64(&rec + 40);
        var yx = load64(&rec + 48);
        var yy = load64(&rec + 56);
        var dx = 0;
        var dy = 0;
        if ((flags & 2) != 0) {                # ARGS_ARE_XY_VALUES
            dx = load64(&rec + 16);
            dy = load64(&rec + 24);
            # ⚠ The delta adjusts the STORED offset, so it goes on before SCALED_COMPONENT_OFFSET
            # scales it — the other order would scale the variation as well as the placement.
            if (cdx != 0) {
                dx = dx + load64(cdx + k * 8);
                dy = dy + load64(cdy + k * 8);
            }
            if ((flags & 0x1800) == 0x800) {   # SCALED_COMPONENT_OFFSET, not UNSCALED
                var sdx = sd_asr(xx * dx + yx * dy + 8192, 14);
                dy = sd_asr(xy * dx + yy * dy + 8192, 14);
                dx = sdx;
            }
        } else {                               # point matching: merged[arg1] <- child[arg2]
            var pa = load64(&rec + 16);
            var pb = load64(&rec + 24);
            if (pa >= base) { return rekha_outline_clear(o); }
            if (pb >= cnp) { return rekha_outline_clear(o); }
            var bx = load64(cxs + pb * 8);
            var by = load64(cys + pb * 8);
            dx = load64(xs + pa * 8) - sd_asr(xx * bx + yx * by + 8192, 14);
            dy = load64(ys + pa * 8) - sd_asr(xy * bx + yy * by + 8192, 14);
        }
        var j = 0;
        if (xx == 16384 && yy == 16384 && xy == 0 && yx == 0) {
            while (j < cnp) {
                store64(xs + (base + j) * 8, load64(cxs + j * 8) + dx);
                store64(ys + (base + j) * 8, load64(cys + j * 8) + dy);
                store8(oc + base + j, load8(coc + j));
                j = j + 1;
            }
        } else {
            while (j < cnp) {
                var cpx = load64(cxs + j * 8);
                var cpy = load64(cys + j * 8);
                store64(xs + (base + j) * 8, sd_asr(xx * cpx + yx * cpy + 8192, 14) + dx);
                store64(ys + (base + j) * 8, sd_asr(xy * cpx + yy * cpy + 8192, 14) + dy);
                store8(oc + base + j, load8(coc + j));
                j = j + 1;
            }
        }
        var m = 0;
        while (m < cnc) {
            store64(eps + (cbase + m) * 8, load64(ceps + m * 8) + base);
            m = m + 1;
        }
        base = base + cnp;
        cbase = cbase + cnc;
        k = k + 1;
    }
    store64(o, tot_ctr);
    store64(o + 8, tot_pts);
    store64(o + 16, eps);
    store64(o + 24, xs);
    store64(o + 32, ys);
    store64(o + 40, oc);
    return o;
}

# Budgeted glyph load: charge the context, then dispatch simple (nc>0) vs composite (nc<0).
fn rekha_load_glyph_d(font, gid, depth, ctx): i64 {
    if (load64(ctx + 16) != 0) { return rekha_outline_empty(); }
    if (depth > REKHA_COMPOSITE_MAXDEPTH) { return rekha_load_abort(ctx); }
    var loads = load64(ctx);
    if (loads <= 0) { return rekha_load_abort(ctx); }
    # A cycle is a gid already on THIS component path; a sibling reusing a component is not one.
    var d = 0;
    while (d < depth) {
        if (load64(ctx + 24 + d * 8) == gid) { return rekha_load_abort(ctx); }
        d = d + 1;
    }
    store64(ctx, loads - 1);
    store64(ctx + 24 + depth * 8, gid);

    # ⚠ NO CODE OF ITS OWN. rekha_glyf_span already said whether this was a blank glyph or a
    # refusal, and saying "malformed" over the top of its silence is what made a space look broken.
    var span: i64[2];
    if (rekha_glyf_span(font, gid, &span) == 0) { return rekha_outline_empty(); }
    var start = load64(&span);
    var end = start + load64(&span + 8);
    var buf = rekha_font_data(font);
    if (start + 10 > end) { return rekha_fail_outline(font, REKHA_ERR_TRUNCATED, "glyf header"); }
    var nc = rekha_rd_i16(buf, start);
    # ⚠ NOT AN ERROR. numberOfContours 0 is how a font spells a space, and 0.7.0's whole point is
    # that this empty outline and a refused one are now distinguishable — so this one stays silent.
    if (nc == 0) { return rekha_outline_empty(); }
    if (nc > 0) { return rekha_load_simple(font, gid, start, end, nc, ctx); }
    return rekha_load_composite(font, gid, start, end, depth, ctx);
}

# @public — load glyph `gid`'s outline (simple OR composite) into a
# RekhaOutline. Empty for space / malformed / out-of-range / over a load cap; 0 only on OOM.
public fn rekha_load_glyph(font, gid): i64 {
    # ⭐ THE WORST AMBIGUITY IN THE LIBRARY, and 0.7.0's reason for existing. An EMPTY outline is
    # the correct answer for a space and the answer for every refusal there is, so a consumer had
    # no way to tell "this glyph is blank" from "rekha would not decode it". It still returns an
    # empty outline either way — changing that would break every caller — but now
    # `rekha_font_error` says which, and REKHA_OK means the blank was real.
    rekha_font_error_clear(font);
    var ctx: i64[9];
    store64(&ctx, REKHA_GLYPH_MAXLOADS);
    store64(&ctx + 8, REKHA_GLYPH_MAXPOINTS_TOTAL);
    store64(&ctx + 16, 0);
    var o = 0;
    if (font != 0 && load64(font + 176) != 0) {
        o = rekha_cff_load(font, gid);              # an 'OTTO' font whose CFF resolved
    } else {
        o = rekha_load_glyph_d(font, gid, 0, &ctx);
    }
    if (o == 0) { return rekha_fail(font, REKHA_ERR_OOM, "outline"); }
    # ⛔ The abort flag is a CAP, not a malformed font: a composite that fanned out past
    # REKHA_GLYPH_MAXLOADS or REKHA_GLYPH_MAXPOINTS_TOTAL, or nested past the depth, or looped.
    if (load64(&ctx + 16) != 0) {
        rekha_fail(font, REKHA_ERR_OOM, "glyph load cap");
        return rekha_outline_clear(o);
    }
    return o;
}

# ================================================================
# The rekha -> sadish seam. rekha does NOT rasterize; it maps a glyph's
# design-unit outline into a sadish SdPath (16.16 pixel coords), which sadish
# fills. The affine map is:
#   sd_x = ox + design_x * scale        (scale = 16.16 pixels per design unit)
#   sd_y = oy - design_y * scale        (y-flip: fonts are y-up, sadish y-down)
# ================================================================

# Emit one closed contour (absolute point range [cstart, cend]) into `path`. Point flags: 1 on-curve,
# 0 quadratic control (glyf), 2 cubic control (CFF).
# Quadratic: on-curve points end a segment (line, or quad if a control is pending); consecutive
# quadratic controls get an implied on-curve MIDPOINT between them. The start point is the first
# on-curve point, or — if the contour opens off-curve — the last on-curve point, or a synthesized
# midpoint if BOTH ends are quadratic controls (all TrueType-legal).
# Cubic: control, control, on-curve -> one sd_path_cubicto; a pair of controls at the END of the
# contour curves back to the start. CFF contours always open on-curve (their moveto).
# ⚠ A HAND-BUILT outline that breaks the pattern (a lone cubic control, or cubic controls mixed with a
# pending quadratic one) is still emitted safely — the stray control becomes a line to it — and no
# loader produces one.
fn rekha_emit_contour(path, xs, ys, oc, cstart, cend, scale, ox, oy): i64 {
    # ⛔ EVERY sd_path_* STATUS IS CHECKED. They return SADISH_ERR_OOM when the consumer's sd_alloc
    # hook refuses a growth (sadish >= 0.7.2 returns rather than faults), and an ignored one leaves a
    # SILENTLY TRUNCATED glyph — the failure mode rekha filed against sadish's flatten. The first
    # failure aborts the contour and rekha_outline_to_sdpath turns it into 0 = OOM.
    var n = cend - cstart + 1;
    var sx = 0;
    var sy = 0;
    var startidx = 0;
    var count = 0;
    if (load8(oc + cstart) != 0) {
        sx = ox + load64(xs + cstart * 8) * scale;
        sy = oy - load64(ys + cstart * 8) * scale;
        startidx = cstart + 1;
        count = n - 1;
    } else {
        if (load8(oc + cend) != 0) {
            sx = ox + load64(xs + cend * 8) * scale;
            sy = oy - load64(ys + cend * 8) * scale;
            startidx = cstart;
            count = n - 1;
        } else {
            var ax = ox + load64(xs + cstart * 8) * scale;
            var ay = oy - load64(ys + cstart * 8) * scale;
            var bx = ox + load64(xs + cend * 8) * scale;
            var by = oy - load64(ys + cend * 8) * scale;
            sx = sd_asr(ax + bx, 1);
            sy = sd_asr(ay + by, 1);
            startidx = cstart;
            count = n;
        }
    }
    if (sd_path_moveto(path, sx, sy) != SADISH_OK) { return 1; }

    var have_ctrl = 0;
    var cx = 0;
    var cy = 0;
    var k = 0;
    while (k < count) {
        var idx = startidx + k;
        var px = ox + load64(xs + idx * 8) * scale;
        var py = oy - load64(ys + idx * 8) * scale;
        var fl = load8(oc + idx);
        if (fl == 2 && have_ctrl == 0 && k + 1 < count && load8(oc + idx + 1) == 2) {
            # cubic: this control, the next, and the on-curve point after them (or the start)
            var qx = ox + load64(xs + (idx + 1) * 8) * scale;
            var qy = oy - load64(ys + (idx + 1) * 8) * scale;
            if (k + 2 < count) {
                if (sd_path_cubicto(path, px, py, qx, qy, ox + load64(xs + (idx + 2) * 8) * scale,
                    oy - load64(ys + (idx + 2) * 8) * scale) != SADISH_OK) { return 1; }
                k = k + 3;
            } else {
                if (sd_path_cubicto(path, px, py, qx, qy, sx, sy) != SADISH_OK) { return 1; }
                k = k + 2;
            }
        } else {
            if (fl != 0) {
                if (have_ctrl != 0) {
                    if (sd_path_quadto(path, cx, cy, px, py) != SADISH_OK) { return 1; }
                    have_ctrl = 0;
                } else {
                    if (sd_path_lineto(path, px, py) != SADISH_OK) { return 1; }
                }
            } else {
                if (have_ctrl != 0) {
                    var mx = sd_asr(cx + px, 1);
                    var my = sd_asr(cy + py, 1);
                    if (sd_path_quadto(path, cx, cy, mx, my) != SADISH_OK) { return 1; }
                    cx = px;
                    cy = py;
                } else {
                    cx = px;
                    cy = py;
                    have_ctrl = 1;
                }
            }
            k = k + 1;
        }
    }
    if (have_ctrl != 0) {
        if (sd_path_quadto(path, cx, cy, sx, sy) != SADISH_OK) { return 1; }   # close the curve to start
    }
    if (sd_path_close(path) != SADISH_OK) { return 1; }
    return 0;
}

# Exactly the verbs and points rekha_emit_contour will push for [cstart, cend], added to the cells
# `vp` (verbs) and `pp` (points). ⛔ THIS MIRRORS rekha_emit_contour BRANCH FOR BRANCH — the two walk
# the same flags in the same order, and programs/path_cap_test-style checks assert the totals equal
# what the emitted path reports. An estimate that ever came out LOW would still be correct (sadish
# doubles the array that overflows), just not free.
fn rekha_contour_size(oc, cstart, cend, vp, pp): i64 {
    var n = cend - cstart + 1;
    var startidx = cstart;
    var count = n;
    if (load8(oc + cstart) != 0) {
        startidx = cstart + 1;
        count = n - 1;
    } else {
        if (load8(oc + cend) != 0) { count = n - 1; }
    }
    var verbs = 2;                              # the moveto and the close
    var points = 1;                             # the moveto's
    var have_ctrl = 0;
    var k = 0;
    while (k < count) {
        var idx = startidx + k;
        var fl = load8(oc + idx);
        if (fl == 2 && have_ctrl == 0 && k + 1 < count && load8(oc + idx + 1) == 2) {
            verbs = verbs + 1;                  # one cubic: two controls and an end point
            points = points + 3;
            if (k + 2 < count) { k = k + 3; } else { k = k + 2; }
        } else {
            if (fl != 0) {
                verbs = verbs + 1;
                if (have_ctrl != 0) {
                    points = points + 2;
                    have_ctrl = 0;
                } else {
                    points = points + 1;
                }
            } else {
                if (have_ctrl != 0) {
                    verbs = verbs + 1;
                    points = points + 2;
                } else {
                    have_ctrl = 1;
                }
            }
            k = k + 1;
        }
    }
    if (have_ctrl != 0) {
        verbs = verbs + 1;
        points = points + 2;
    }
    store64(vp, load64(vp) + verbs);
    store64(pp, load64(pp) + points);
    return 0;
}

# @public — convert a decoded glyph `outline` into a sadish SdPath, positioned
# by `scale` (16.16 px/design-unit) at pixel offset (ox, oy) (both 16.16).
# Returns a fresh SdPath (empty for a 0-contour or 0 outline), or 0 when an allocation is refused —
# either the path itself or a growth mid-build, which would otherwise leave a silently truncated glyph.
# Contours stop at the first end_pts entry that is negative or >= n_points, so a
# self-inconsistent outline cannot walk emit off its arrays. ⚠ A HAND-BUILT outline must
# still really hold n_points entries in xs / ys / on_curve and n_contours in end_pts —
# this seam cannot see an allocation's size.
public fn rekha_outline_to_sdpath(outline, scale, ox, oy): i64 {
    if (outline == 0) { return sd_path_new_cap(0, 0); }
    var nc = rekha_outline_n_contours(outline);
    var npts = rekha_outline_n_points(outline);
    var eps = rekha_outline_end_pts(outline);
    var xs = rekha_outline_xs(outline);
    var ys = rekha_outline_ys(outline);
    var oc = rekha_outline_on_curve(outline);

    # Size the path before building it: an outline already says how many verbs and points its contours
    # come to, and sadish opens each array at exactly that (sadish >= 0.7.2, sd_path_new_cap).
    var v: i64[1];
    var p: i64[1];
    store64(&v, 0);
    store64(&p, 0);
    var cstart = 0;
    var ci = 0;
    while (ci < nc) {
        var cend = load64(eps + ci * 8);
        if (cend < 0) { ci = nc; } else {
            if (cend >= npts) { ci = nc; } else {
                if (cend >= cstart) { rekha_contour_size(oc, cstart, cend, &v, &p); }
                cstart = cend + 1;
                ci = ci + 1;
            }
        }
    }
    var path = sd_path_new_cap(load64(&v), load64(&p));
    if (path == 0) { return 0; }
    if (nc <= 0) { return path; }

    cstart = 0;
    ci = 0;
    while (ci < nc) {
        var cend2 = load64(eps + ci * 8);
        if (cend2 < 0) { break; }
        if (cend2 >= npts) { break; }
        if (cend2 >= cstart) {
            if (rekha_emit_contour(path, xs, ys, oc, cstart, cend2, scale, ox, oy) != 0) { return 0; }
        }
        cstart = cend2 + 1;
        ci = ci + 1;
    }
    return path;
}

# @public — load glyph `gid` and convert it to a positioned sadish SdPath
# (an empty path when the glyph loads empty or its load hits OOM).
# ⛔ THIS USED TO SWALLOW THE ONE UNAMBIGUOUS SIGNAL IN THE GLYPH PATH. rekha_load_glyph returns 0
# — never an outline — when the allocator refuses, and handing that 0 to rekha_outline_to_sdpath
# turned it into the same empty path a blank glyph gives. It does not any more: the 0 is checked,
# the reason its callee recorded stands, and only a path allocation that fails after a good outline
# sets one of its own.
public fn rekha_glyph_to_sdpath(font, gid, scale, ox, oy): i64 {
    var o = rekha_load_glyph(font, gid);
    var p = rekha_outline_to_sdpath(o, scale, ox, oy);
    # ⚠ Only when the callee did not already say something better: a refused GLYPH is a more useful
    # answer than "the path allocation that followed it also gave nothing".
    if (p == 0) {
        if (rekha_font_error(font) == REKHA_OK) { rekha_fail(font, REKHA_ERR_OOM, "sdpath"); }
    }
    return p;
}

# --- cmap.cyr ---

# cmap: Unicode codepoint -> glyph id.
#
# cmap.cyr — picks ONE Unicode subtable at rekha_font_open and maps codepoints through it. Formats
# read: 4 (BMP segment map), 12 (segmented coverage — the full Unicode range), 13 (many-to-one
# ranges), 6 (trimmed table) and 0 (byte table). Returns .notdef (0) for anything unmapped.
# Bounds: the encoding-record walk, every candidate's header and arrays, and the winner's are
# validated ONCE, at rekha_font_open, against the cmap table's DECLARED extent (not the file length);
# a lookup re-checks only the format-4 glyphIdArray index, against the same extent.
#
# cmap table:  +0 version u16, +2 numTables u16, then numTables encoding
#   records (8 bytes: platformID u16, encodingID u16, offset u32 from cmap).
# format 0:  format(2) length(2) language(2) glyphIdArray[256] u8
# format 4:  format(2) length(2) language(2) segCountX2(2) searchRange(2) entrySelector(2)
#   rangeShift(2) endCode[segCount] u16, reservedPad(2), startCode[segCount] idDelta[segCount]
#   idRangeOffset[segCount], glyphIdArray[].
# format 6:  format(2) length(2) language(2) firstCode(2) entryCount(2) glyphIdArray[entryCount] u16
# format 12 / 13: format(2) reserved(2) length(4) language(4) numGroups(4), then numGroups groups of
#   startCharCode(4) endCharCode(4) startGlyphID(4) — format 13 maps the whole range to that ONE id.

# ================================================================
# Subtable selection. Every encoding record inside the cmap extent is a CANDIDATE when its format
# is one of the above AND its header and arrays fit the extent; the best-ranked candidate wins, a
# later record winning a tie:
#
#   rank 6  (3,10)                   Windows, Unicode full repertoire
#   rank 5  (0,4) (0,6)              Unicode 2.0+ full repertoire / full-repertoire format 13
#   rank 4  a format 12 / 13 table under any other Unicode record ((3,1), (0,x))
#   rank 3  (3,1)                    Windows, Unicode BMP
#   rank 2  (0,3)                    Unicode 2.0+ BMP
#   rank 1  (0,0) (0,1) (0,2) and other (0,x) except (0,5)
#   rank 0  (3,0)                    Windows SYMBOL — lookups also try U+F000 + cp for cp <= U+00FF
#
# ⭐ WHY RANK, NOT "LAST RECORD WINS". Up to 0.3.11 rekha read format 4 only, took the LAST (3,1) /
# (0,*) record and then validated it — so a font whose Unicode map is format 12 under (3,10) (2,137
# of the system faces surveyed on the dev host, beside a format-4 BMP subset), or a font whose last
# record was broken, lost characters a valid subtable maps. Ranking puts the full-repertoire table
# first and validating every candidate means a broken record is skipped, not fatal — FreeType's and
# HarfBuzz's behaviour.
# ⚠ (0,5) is format 14, Unicode Variation Sequences — a supplement to a real map, never one itself.
# ⚠ Macintosh (1,0) tables encode Mac OS Roman, not Unicode, and are not candidates.
# ================================================================

# Validate a candidate subtable at absolute offset `sub` against `cend` (the cmap extent's end).
# Returns its entry count (format 0 -> 256) and stores format 6's firstCode in `first_out`, or 0 when
# the format is not read or the header / arrays do not fit. ⚠ A table with NO entries (entryCount 0,
# numGroups 0) also returns 0, and rekha_cmap_resolve takes only a count > 0 — an empty table never
# outranks a real one.
fn rekha_cmap_fit(buf, sub, cend, first_out): i64 {
    store64(first_out, 0);
    if (sub + 2 > cend) { return 0; }
    var fmt = rekha_rd_u16(buf, sub);
    if (fmt == 4) {
        if (sub + 14 > cend) { return 0; }
        var segc2 = rekha_rd_u16(buf, sub + 6);
        if (segc2 < 2) { return 0; }
        # endCode[] @ +14, reservedPad, startCode[], idDelta[], idRangeOffset[] — the last must end in cmap
        if (sub + 16 + segc2 * 4 > cend) { return 0; }
        return segc2;
    }
    if (fmt == 12 || fmt == 13) {
        if (sub + 16 > cend) { return 0; }
        var ng = rekha_rd_u32(buf, sub + 12);
        if (sub + 16 + ng * 12 > cend) { return 0; }
        return ng;
    }
    if (fmt == 6) {
        if (sub + 10 > cend) { return 0; }
        var cnt = rekha_rd_u16(buf, sub + 8);
        if (sub + 10 + cnt * 2 > cend) { return 0; }
        store64(first_out, rekha_rd_u16(buf, sub + 6));
        return cnt;
    }
    if (fmt == 0) {
        if (sub + 262 > cend) { return 0; }
        return 256;
    }
    return 0;
}

# Rank of an encoding record holding a table of format `fmt` (see the table above); -1 = not a
# Unicode map rekha reads.
fn rekha_cmap_rank(plat, enc, fmt): i64 {
    var wide = 0;
    if (fmt == 12 || fmt == 13) { wide = 1; }
    if (plat == 3) {
        if (enc == 10) { return 6; }
        if (enc == 1) {
            if (wide != 0) { return 4; }
            return 3;
        }
        if (enc == 0) { return 0; }
        return 0 - 1;
    }
    if (plat == 0) {
        if (enc == 5) { return 0 - 1; }
        if (enc == 4 || enc == 6) { return 5; }
        if (wide != 0) { return 4; }
        if (enc == 3) { return 2; }
        return 1;
    }
    return 0 - 1;
}

# Resolve the cmap cache (+144 sub, +152 n, +160 first, +168 kind) of a RekhaFont whose cmap_off /
# cmap_len are already cached. Called once, by rekha_font_resolve. Allocates 0 B.
fn rekha_cmap_resolve(f): i64 {
    store64(f + 144, 0);
    store64(f + 152, 0);
    store64(f + 160, 0);
    store64(f + 168, 0);
    var cmap = load64(f + 128);
    if (cmap == 0) { return 0; }
    var cend = cmap + load64(f + 136);
    var buf = load64(f);
    if (cmap + 4 > cend) { return 0; }
    var ntab = rekha_rd_u16(buf, cmap + 2);
    var c: i64[1];
    var best_rank = 0 - 1;
    var i = 0;
    while (i < ntab) {
        var rec = cmap + 4 + i * 8;
        if (rec + 8 > cend) {
            i = ntab;                     # records past the cmap extent do not exist
        } else {
            var sub = cmap + rekha_rd_u32(buf, rec + 4);
            var n = rekha_cmap_fit(buf, sub, cend, &c);
            if (n > 0) {
                var fmt = rekha_rd_u16(buf, sub);
                var plat = rekha_rd_u16(buf, rec);
                var enc = rekha_rd_u16(buf, rec + 2);
                var rank = rekha_cmap_rank(plat, enc, fmt);
                if (rank >= 0) {
                    if (rank >= best_rank) {
                        best_rank = rank;
                        store64(f + 144, sub);
                        store64(f + 152, n);
                        store64(f + 160, load64(&c));
                        if (rank == 0) {
                            store64(f + 168, fmt + 0x10000);
                        } else {
                            store64(f + 168, fmt);
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
    return 0;
}

# The absolute offset of the subtable rekha_font_open chose, or 0 (no usable Unicode map, or a 0
# handle).
fn rekha_cmap_subtable(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 144);
}

# Format 4 lookup: `cp` (<= U+FFFF) -> glyph id, or 0. The arrays were validated at open.
#
# Segment search is HYBRID: segment 0 directly when endCode[0] >= cp (the ASCII case on common
# faces), else a binary search for the first endCode >= cp over [1, segCount). For the
# ascending endCode[] the spec requires, that is exactly the first segment a linear scan finds.
# MEASURED 0.3.11 (cache + hybrid vs the per-call resolve + linear scan it replaced), median of 3:
# LiberationSans ASCII 224 -> 28 ns; D2Coding Nerd (1,642 segments) U+AC00.. 7,686 -> 85 ns.
# ⚠ 0.4.0's multi-format dispatch costs MEASURED ~5 ns more per ASCII lookup (29 -> 34 ns, interleaved
# against 0.3.11); inlining this function back into rekha_char_to_glyph did not recover it.
fn rekha_cmap_f4(font, sub, segc2, cp): i64 {
    if (cp > 65535) { return 0; }
    var buf = load64(font);
    var segc = segc2 / 2;
    var end_arr = sub + 14;
    var seg = 0;
    if (rekha_rd_u16(buf, end_arr) < cp) {
        var lo = 1;
        var hi = segc;
        while (lo < hi) {
            var mid = (lo + hi) / 2;
            if (rekha_rd_u16(buf, end_arr + mid * 2) >= cp) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        if (lo >= segc) { return 0; }
        seg = lo;
    }
    var start_arr = end_arr + segc2 + 2;    # +reservedPad
    var delta_arr = start_arr + segc2;
    var range_arr = delta_arr + segc2;
    var startc = rekha_rd_u16(buf, start_arr + seg * 2);
    if (startc > cp) { return 0; }          # cp falls in a gap -> .notdef
    var delta = rekha_rd_i16(buf, delta_arr + seg * 2);
    var ro = rekha_rd_u16(buf, range_arr + seg * 2);
    if (ro == 0) {
        return (cp + delta) & 65535;
    }
    # idRangeOffset is self-relative from its own slot in idRangeOffset[]
    var gidx = range_arr + seg * 2 + ro + (cp - startc) * 2;
    if (gidx + 2 > load64(font + 128) + load64(font + 136)) { return 0; }
    var gid = rekha_rd_u16(buf, gidx);
    if (gid == 0) { return 0; }
    return (gid + delta) & 65535;
}

# Format 12 / 13 lookup: binary search for the first group whose endCharCode >= cp (groups are
# sorted and non-overlapping, as the spec requires), then startCharCode <= cp. Format 12 maps
# startGlyphID + (cp - startCharCode); format 13 maps the whole group to startGlyphID. An id past
# 0xFFFF has no glyph (glyph ids are u16) -> 0.
fn rekha_cmap_f12(font, sub, ngroups, fmt, cp): i64 {
    var buf = load64(font);
    var groups = sub + 16;
    var lo = 0;
    var hi = ngroups;
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        if (rekha_rd_u32(buf, groups + mid * 12 + 4) >= cp) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    if (lo >= ngroups) { return 0; }
    var g = groups + lo * 12;
    var startc = rekha_rd_u32(buf, g);
    if (startc > cp) { return 0; }
    var gid = rekha_rd_u32(buf, g + 8);
    if (fmt == 12) { gid = gid + (cp - startc); }
    if (gid > 65535) { return 0; }
    return gid;
}

# One lookup through the cached subtable, no symbol remap, no numGlyphs clamp.
fn rekha_cmap_lookup(font, cp): i64 {
    var sub = load64(font + 144);
    var n = load64(font + 152);
    var fmt = load64(font + 168) & 0xFFFF;
    if (fmt == 4) { return rekha_cmap_f4(font, sub, n, cp); }
    if (fmt == 12 || fmt == 13) { return rekha_cmap_f12(font, sub, n, fmt, cp); }
    if (fmt == 6) {
        var first = load64(font + 160);
        if (cp < first) { return 0; }
        if (cp >= first + n) { return 0; }
        return rekha_rd_u16(load64(font), sub + 10 + (cp - first) * 2);
    }
    if (cp > 255) { return 0; }             # format 0
    return load8(load64(font) + sub + 6 + cp);
}

# @public — map a Unicode codepoint `cp` to a glyph id through the subtable rekha_font_open chose.
# Returns 0 (.notdef) if the handle is 0, cp is outside 0..U+10FFFF or unmapped, there is no usable
# subtable, or the mapped id is >= maxp.numGlyphs (when maxp is present) — an id with no glyph
# behind it IS .notdef. Allocates 0 B.
# ⚠ Coverage follows the chosen table: a format-4 / 6 / 0 map cannot reach past U+FFFF / its range
# / U+00FF. A (3,0) SYMBOL table is looked up at cp and, when that misses and cp <= U+00FF, at
# U+F000 + cp — symbol fonts put their glyphs in the private-use F0xx block.
public fn rekha_char_to_glyph(font, cp): i64 {
    if (font == 0) { return 0; }
    # ⭐ gid 0 IS A REAL, DRAWABLE GLYPH — the .notdef box — so 0 has always meant three different
    # things here: "this font does not map that character", "this font has no usable cmap at all",
    # and "you asked for something that is not a codepoint". 0.7.0 tells them apart.
    rekha_font_error_clear(font);
    if (cp < 0) { return rekha_fail(font, REKHA_ERR_OTHER, "codepoint"); }
    if (cp > 0x10FFFF) { return rekha_fail(font, REKHA_ERR_OTHER, "codepoint"); }
    var sub = load64(font + 144);
    if (sub == 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "cmap"); }
    var kind = load64(font + 168);
    var g = 0;
    if (kind == 4) {
        g = rekha_cmap_f4(font, sub, load64(font + 152), cp);   # the common case: a plain format-4 map
    } else {
        g = rekha_cmap_lookup(font, cp);
        if (g == 0) {
            if ((kind & 0x10000) != 0) {
                if (cp <= 255) { g = rekha_cmap_lookup(font, 0xF000 + cp); }
            }
        }
    }
    var ng = load64(font + 56);
    if (ng > 0) {
        # ⛔ A map naming a glyph the font does not have is the font's error, not the caller's.
        if (g >= ng) { return rekha_fail(font, REKHA_ERR_BAD_SFNT, "cmap glyph id"); }
    }
    # ⚠ An UNMAPPED character is not an error: .notdef is the right answer and REKHA_OK stays.
    return g;
}

# @public — codepoint -> a positioned sadish SdPath (cmap + glyf + convert).
# ⚠ THE WRAPPER DOES NOT CLEAR, and it does not change what it RETURNS either: an empty path for a
# character this font cannot draw is the contract every caller since 0.3.0 was written against.
# What it adds is that the reason survives the second call.
public fn rekha_char_to_sdpath(font, cp, scale, ox, oy): i64 {
    var g = rekha_char_to_glyph(font, cp);
    var e = rekha_font_error(font);
    var d = rekha_font_error_detail(font);
    var p = rekha_glyph_to_sdpath(font, g, scale, ox, oy);
    # ⛔ THE FIRST REFUSAL OUTRANKS THE SECOND SILENCE. rekha_glyph_to_sdpath clears on entry
    # through its own callee, so without this a cmap that could not be read would be reported as
    # "nothing went wrong" once the empty glyph came back.
    if (e != REKHA_OK) {
        if (rekha_font_error(font) == REKHA_OK) { rekha_fail(font, e, d); }
    }
    return p;
}

# @public — the advance width of codepoint `cp`, in font DESIGN UNITS. 0 = unknown.
#
# ⭐ THE COMPANION `rekha_char_to_sdpath` NEEDED AND DID NOT HAVE. Drawing a run of text is two
# questions per character — *what shape* and *how far to move* — and rekha answered only the first,
# so every consumer invented the second. That is why dhancha shipped a fixed 0.6 em advance.
# ⚠ An unmapped codepoint resolves to .notdef (gid 0), whose advance is a real metric in most fonts
# — so a missing glyph advances by the .notdef box rather than collapsing to zero, which is what
# makes a run of unmapped text still legible as "something is here".
public fn rekha_char_advance(font, cp): i64 {
    return rekha_advance_width(font, rekha_char_to_glyph(font, cp));
}

# @public — advance `cp` in PIXELS at pixel size `px_size`, rounded to nearest. 0 = unknown.
# = rekha_glyph_advance_px(font, rekha_char_to_glyph(font, cp), px_size).
#
# ⭐ THE SCALING LIVES HERE BECAUSE EVERY CONSUMER WOULD OTHERWISE WRITE IT, AND ONE OF THEM WOULD
# WRITE IT WRONG. `adv * px_size / upem` truncates toward zero, which loses up to a pixel per glyph,
# always in the same direction — a 40-character run drifts visibly left of where it should end.
# Rounding half-up costs one add and bounds EACH glyph's error at half a pixel.
# ⛔ PER-GLYPH ROUNDING HALVES THE BIAS; IT DOES NOT STOP THE DRIFT. A run built by summing these
# integers still accumulates up to half a pixel per glyph. Exact run widths come from summing
# 16.16 advances (rekha_char_advance_fx / rekha_glyph_advance_fx) and rounding the pen ONCE.
# ⚠ Returns 0 when the metric is unknown OR `upem` is 0, so the caller's fallback path is a single
# `== 0` test rather than two.
public fn rekha_char_advance_px(font, cp, px_size): i64 {
    return rekha_glyph_advance_px(font, rekha_char_to_glyph(font, cp), px_size);
}

# @public — advance `cp` at pixel size `px_size` as 16.16 fixed-point pixels. 0 = unknown.
# = rekha_glyph_advance_fx(font, rekha_char_to_glyph(font, cp), px_size). Allocates 0 B.
public fn rekha_char_advance_fx(font, cp, px_size): i64 {
    return rekha_glyph_advance_fx(font, rekha_char_to_glyph(font, cp), px_size);
}

# --- cff.cyr ---

# CFF: OpenType 'OTTO' outlines (the 'CFF ' table, Type 2 charstrings).
#
# cff.cyr — resolve a CFF table once at rekha_font_open and decode a glyph's Type 2 charstring into
# the SAME RekhaOutline glyf.cyr produces, so rekha_load_glyph / rekha_glyph_to_sdpath /
# rekha_char_to_sdpath draw OTTO faces with no consumer change. A cubic control point carries
# on_curve flag 2 (glyf's 0 = quadratic control, 1 = on-curve); rekha_emit_contour turns
# control, control, on-curve into sd_path_cubicto.
#
# CFF (Adobe TN 5176) layout, big-endian: Header (major u8, minor u8, hdrSize u8, offSize u8), then
# four INDEXes — Name, Top DICT, String, Global Subr. An INDEX is count u16; (count > 0) offSize u8,
# offset[count + 1] (offSize bytes each, 1-based from the byte before the data), data.
# Top DICT operators read: CharStrings (17), Private (18: size offset), CharstringType (12 6, must be
# 2), ROS (12 30: CID-keyed), FDArray (12 36), FDSelect (12 37). Private DICT: Subrs (19, relative to
# the Private DICT). A CID-keyed font's glyph takes its local Subrs from FDArray[FDSelect(gid)].
#
# ⛔ BOUNDS. Every read is inside the CFF table's DECLARED extent (rekha_find_table_len's rule): each
# INDEX header and offset array is checked where it is read, each object's [start, end) is checked on
# every access, every DICT operand walk stops at its DICT's end, and a charstring is interpreted only
# inside its own object's bytes (a subroutine inside its own). Offsets a DICT carries are refused when
# negative or past the extent.
# ⛔ WORK. One glyph decode is bounded whatever the font says: 65,536 interpreted operators and
# numbers per pass, subroutine nesting 10, an argument stack of 48 in CFF and 513 in CFF2 (each
# format's own ceiling — see REKHA_CFF2_MAXSTACK), REKHA_COMPOSITE_MAXP points (the glyf ceiling) —
# past any of them the glyph is EMPTY — and the load budget rekha_load_glyph carries.
#
# DECODE CONTRACT (what programs/cff_test.cyr and the reference differential pin):
#   - coordinates accumulate in 16.16 in CHARSTRING units, go through the FontMatrix folded with
#     unitsPerEm (0.5.1, below) and are rounded floor(v + 1/2) ONCE into design units. Every CFF
#     face surveyed carries FontMatrix = 1 / unitsPerEm, which makes that fold the identity and
#     the rounding the only step — but it is now read rather than assumed;
#   - rmoveto / hmoveto / vmoveto start a contour; a contour holding only its moveto point is dropped;
#   - lineto -> 1 on-curve point; curveto -> control (2), control (2), on-curve (1);
#   - hint operators are read for their stem count (hintmask / cntrmask byte length) and otherwise
#     ignored; the optional leading width argument is consumed and ignored (advances come from hmtx);
#   - flex, hflex, hflex1, flex1 draw their two curves;
#   - a four-argument endchar is `seac`: the glyph is glyph `bchar` at the origin followed by glyph
#     `achar` displaced by (adx, ady), both named by STANDARD ENCODING CODE and resolved through the
#     font's charset (0.4.7). EMPTY when either code is unassigned, either SID is not in the charset,
#     the charset is one rekha does not carry, the font is CID-keyed, a component is this same glyph,
#     or a component is itself a seac;
#   - EMPTY (not partial) for: the deprecated arithmetic / storage operators, an operator with too few
#     arguments, a lineto or curveto before any moveto, a charstring that ends without endchar, and
#     any bound above.
# ⚠ A number cut by the end of its charstring (28 needs 2 bytes, 255 needs 4, 247..254 need 1) is
# refused by a byte check that keeps the read inside the object and changes no RESULT — a number with
# nothing after it can never be consumed. A hint mask running past its charstring IS a broken rule
# (a subroutine's caller would otherwise go on drawing).

var REKHA_CFF_MAXOPS    = 65536;
var REKHA_CFF_MAXDEPTH  = 10;
var REKHA_CFF_MAXSTACK  = 48;
# ⛔ CFF2 IS 513, NOT 48, AND THE DIFFERENCE IS NOT COSMETIC. A `blend` of `nb` values over `k`
# regions needs nb + nb x k operands resident when the operator runs, so a 48-entry ceiling caps a
# font at floor(48 / (k + 1)) blended values — 3 at 15 regions, 2 at 23. The CFF2 chapter raises
# the interpreter stack to 513 for exactly that reason, and overflowing it here is not graceful:
# the push guard sets RC_BAD, so a conformant font comes back EMPTY rather than at its default.
# ⚠ CFF STAYS AT 48. It is that format's own limit, and a CFF pushing a 49th operand is malformed.
var REKHA_CFF2_MAXSTACK = 513;

# ================================================================
# INDEX + DICT readers
# ================================================================

fn rekha_cff_offn(buf, p, osz): i64 {
    var v = 0;
    var k = 0;
    while (k < osz) {
        v = v * 256 + load8(buf + p + k);
        k = k + 1;
    }
    return v;
}

# An INDEX's count field is u16 in CFF and u32 in CFF2 (0.4.9); everything after it is identical, so
# the three readers below take the width and the bounds logic is written ONCE. `csz` is 2 or 4.
fn rekha_cff_idx_count_at(buf, at, csz): i64 {
    if (csz == 2) { return rekha_rd_u16(buf, at); }
    return rekha_rd_u32(buf, at);
}

# Validate the INDEX at `at` (inside `end`): returns the position just past it, or 0 when its count,
# offSize, offset array or last offset does not fit. A count-0 INDEX is just its count field.
# ⚠ A u32 count can reach 2^32-1, so `(count + 1) * osz` reaches ~1.7e10 — inside i64 with room,
# and the very next line refuses it against `end`.
fn rekha_cff_idx_next(buf, at, end, csz): i64 {
    if (at + csz > end) { return 0; }
    var count = rekha_cff_idx_count_at(buf, at, csz);
    if (count < 0) { return 0; }
    if (count == 0) { return at + csz; }
    if (at + csz + 1 > end) { return 0; }
    var osz = load8(buf + at + csz);
    if (osz < 1 || osz > 4) { return 0; }
    var offs = at + csz + 1;
    if (offs + (count + 1) * osz > end) { return 0; }
    var data = offs + (count + 1) * osz - 1;
    var last = rekha_cff_offn(buf, offs + count * osz, osz);
    if (last < 1) { return 0; }
    if (data + last > end) { return 0; }
    return data + last;
}

fn rekha_cff_idx_obj(buf, at, end, i, out, csz): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    if (rekha_cff_idx_next(buf, at, end, csz) == 0) { return 0; }
    var count = rekha_cff_idx_count_at(buf, at, csz);
    if (i < 0 || i >= count) { return 0; }
    var osz = load8(buf + at + csz);
    var offs = at + csz + 1;
    var data = offs + (count + 1) * osz - 1;
    var a = rekha_cff_offn(buf, offs + i * osz, osz);
    var b = rekha_cff_offn(buf, offs + (i + 1) * osz, osz);
    if (a < 1) { return 0; }
    if (b < a) { return 0; }
    if (data + b > end) { return 0; }
    store64(out, data + a);
    store64(out + 8, b - a);
    return 1;
}

fn rekha_cff_index_next(buf, at, end): i64 {
    return rekha_cff_idx_next(buf, at, end, 2);
}

# The count of the INDEX at `at`, or -1 when its header does not validate.
fn rekha_cff_index_count(buf, at, end): i64 {
    if (rekha_cff_index_next(buf, at, end) == 0) { return 0 - 1; }
    return rekha_rd_u16(buf, at);
}

# Object `i` of the INDEX at `at`: out+0 = absolute start, out+8 = byte length. 1, or 0 when the
# INDEX is invalid, `i` is out of range, or the object's offsets are not 1 <= start <= stop inside end.
fn rekha_cff_obj(buf, at, end, i, out): i64 {
    return rekha_cff_idx_obj(buf, at, end, i, out, 2);
}

# Find operator `op` (a byte 0..21, or 1200 + the second byte of a 12-escape) in the DICT [a, b).
# On a hit: out+0 = operands before it, out+8 = the last operand, out+16 = the one before (reals
# count as operands of value 0). Returns 1 / 0 (absent, or a malformed operand stops the walk).
# `maxop` is the highest byte that counts as an OPERATOR. ⛔ It is 21 in CFF, where 22..27 are
# reserved and a DICT holding one is malformed — the scan stops. CFF2 puts real operators up there:
# `vstore` is 24 in the Top DICT, and `vsindex` (22) and `blend` (23) live in a Private DICT. Reading
# a CFF2 DICT with the CFF ceiling stops the scan AT the operator being looked for, which is how the
# variation store went missing the first time this was wired up: CharStrings and FDArray were found
# because they happened to come first, and `vstore` never was. Bytes 28..30 stay operand prefixes at
# either ceiling.
fn rekha_cff_dict_op_max(buf, a, b, op, out, maxop): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    var n = 0;
    var last = 0;
    var prev = 0;
    var p = a;
    while (p < b) {
        var b0 = load8(buf + p);
        if (b0 <= maxop) {
            var o = b0;
            p = p + 1;
            if (b0 == 12) {
                if (p >= b) { return 0; }
                o = 1200 + load8(buf + p);
                p = p + 1;
            }
            if (o == op) {
                store64(out, n);
                store64(out + 8, last);
                store64(out + 16, prev);
                return 1;
            }
            n = 0;
            last = 0;
            prev = 0;
        } else {
            var v = 0;
            if (b0 == 28) {
                if (p + 3 > b) { return 0; }
                v = rekha_rd_i16(buf, p + 1);
                p = p + 3;
            } else {
                if (b0 == 29) {
                    if (p + 5 > b) { return 0; }
                    v = rekha_rd_u32(buf, p + 1);
                    if (v >= 0x80000000) { v = v - 0x100000000; }
                    p = p + 5;
                } else {
                    if (b0 == 30) {
                        p = p + 1;
                        var more = 1;
                        while (more != 0) {
                            if (p >= b) { return 0; }
                            var nb = load8(buf + p);
                            p = p + 1;
                            if ((nb >> 4) == 15 || (nb & 15) == 15) { more = 0; }
                        }
                    } else {
                        if (b0 >= 32 && b0 <= 246) {
                            v = b0 - 139;
                            p = p + 1;
                        } else {
                            if (b0 >= 247 && b0 <= 254) {
                                if (p + 2 > b) { return 0; }
                                if (b0 <= 250) {
                                    v = (b0 - 247) * 256 + load8(buf + p + 1) + 108;
                                } else {
                                    v = 0 - (b0 - 251) * 256 - load8(buf + p + 1) - 108;
                                }
                                p = p + 2;
                            } else {
                                return 0;           # above maxop, 31, 255: reserved in a DICT
                            }
                        }
                    }
                }
            }
            prev = last;
            last = v;
            n = n + 1;
        }
    }
    return 0;
}

fn rekha_cff_dict_op(buf, a, b, op, out): i64 {
    return rekha_cff_dict_op_max(buf, a, b, op, out, 21);
}

# ================================================================
# FontMatrix (Top DICT 12 7) — charstring space to em space
# ================================================================
# ⭐ WHAT IS STORED IS NOT THE MATRIX. rekha keeps `M x unitsPerEm`, in 16.16: the transform from
# charstring units straight to the DESIGN units every other outline in rekha is already in, so the
# sadish seam's single divide by upem stays the only scaling step. For the font that agrees with
# its own `head` — which is every one of the 405 CFF faces surveyed, all carrying
# FontMatrix = 1 / unitsPerEm — that product is exactly 1.0 and the transform is the identity,
# which `rekha_cff_resolve` then records as "off" so the point store pays nothing.
# ⚠ Precision is why it is stored this way. 0.001 in 16.16 is 65.536, which rounds to 66 — a 0.7%
# error before a single point is placed. 0.001 x 1000 is 1.0, exact.
# ⛔ REFUSED rather than approximated: a scale past +-64, a translation past +-16384 em, a real
# rekha cannot represent, a FontMatrix with an arity other than six, and (below) a CID font whose
# FDArray carries one of its own. Every refusal loses the CFF table, so the glyphs come back EMPTY
# — which is the point: through 0.5.0 a FontMatrix rekha did not read rendered at the WRONG SCALE
# with no diagnostic at all.
var REKHA_CFF_MTX_MAXSCALE = 4194304;      # 64.0 in 16.16
var REKHA_CFF_MTX_MAXMOVE  = 1073741824;   # 16384.0 in 16.16
var REKHA_CFF_MTX_DEFAULT  = 1000;         # the CFF default FontMatrix is 0.001 = 1 / 1000

# round(sign x m x 10^dexp x upem x 65536) into `out`. Returns 1, or 0 when it does not fit — which
# is not an error here: most DICT operands are offsets, and only the six that end up in a
# FontMatrix have to be representable at this scale.
fn rekha_cff_mtx_scale(m, dexp, neg, upem, out): i64 {
    store64(out, 0);
    if (m == 0) { return 1; }
    if (m > 1000000000) { return 0; }                    # nine significant digits is plenty here
    var num = m * upem * 65536;                          # <= 1e9 x 16384 x 65536 = 1.07e18
    if (dexp >= 0) {
        var i = 0;
        while (i < dexp) {
            if (num > 900000000000000000) { return 0; }
            num = num * 10;
            i = i + 1;
        }
    } else {
        var d = 0 - dexp;
        if (d > 18) { return 1; }                        # underflows to zero, exactly
        var div = 1;
        var j = 0;
        while (j < d) {
            div = div * 10;
            j = j + 1;
        }
        num = (num + div / 2) / div;                     # half up, as rekha_fx_mul does
    }
    if (neg != 0) { num = 0 - num; }
    store64(out, num);
    return 1;
}

# One DICT operand at `p`, scaled by upem x 65536. Returns the position after it, or 0 when the
# ENCODING is malformed. `out` holds the value and `out + 8` a 1 when it was representable.
fn rekha_cff_mtx_operand(buf, p, b, upem, out): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    var b0 = load8(buf + p);
    if (b0 == 30) {
        # ⛔ THE REAL-NUMBER FORMAT, which rekha skipped over until 0.5.1. Two nibbles a byte:
        # 0-9 a digit, a '.', b 'E', c 'E-', d reserved, e '-', f the terminator (and the low
        # nibble after an f is padding).
        p = p + 1;
        var neg = 0;
        var m = 0;
        var k = 0;
        var dot = 0;
        var over = 0;
        var in_e = 0;
        var eneg = 0;
        var ev = 0;
        var done = 0;
        while (done == 0) {
            if (p >= b) { return 0; }
            var by = load8(buf + p);
            p = p + 1;
            var pass = 0;
            while (pass < 2) {
                var nib = (by >> 4) & 15;
                if (pass == 1) { nib = by & 15; }
                if (done == 0) {
                    if (nib <= 9) {
                        if (in_e != 0) {
                            ev = ev * 10 + nib;
                            if (ev > 999) { return 0; }
                        } else {
                            if (m <= 100000000) {
                                m = m * 10 + nib;
                                if (dot != 0) { k = k + 1; }
                            } else {
                                # past nine significant digits: keep the magnitude, drop the digit
                                if (dot == 0) { over = over + 1; }
                            }
                        }
                    } else {
                        if (nib == 10) {
                            dot = 1;
                        } else {
                            if (nib == 11) {
                                in_e = 1;
                            } else {
                                if (nib == 12) {
                                    in_e = 1;
                                    eneg = 1;
                                } else {
                                    if (nib == 14) {
                                        neg = 1;
                                    } else {
                                        if (nib == 15) {
                                            done = 1;
                                        } else {
                                            return 0;     # 13 is reserved
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                pass = pass + 1;
            }
        }
        var e = ev;
        if (eneg != 0) { e = 0 - ev; }
        var v: i64[1];
        store64(&v, 0);
        store64(out + 8, rekha_cff_mtx_scale(m, e - k + over, neg, upem, &v));
        store64(out, load64(&v));
        return p;
    }
    # the integer forms. A FontMatrix written with integers is legal — [1 0 0 1 0 0] is what a font
    # whose charstring units ARE em units carries.
    var iv = 0;
    if (b0 == 28) {
        if (p + 3 > b) { return 0; }
        iv = rekha_rd_i16(buf, p + 1);
        p = p + 3;
    } else {
        if (b0 == 29) {
            if (p + 5 > b) { return 0; }
            iv = rekha_rd_u32(buf, p + 1);
            if (iv >= 0x80000000) { iv = iv - 0x100000000; }
            p = p + 5;
        } else {
            if (b0 >= 32 && b0 <= 246) {
                iv = b0 - 139;
                p = p + 1;
            } else {
                if (b0 >= 247 && b0 <= 254) {
                    if (p + 2 > b) { return 0; }
                    if (b0 <= 250) {
                        iv = (b0 - 247) * 256 + load8(buf + p + 1) + 108;
                    } else {
                        iv = 0 - (b0 - 251) * 256 - load8(buf + p + 1) - 108;
                    }
                    p = p + 2;
                } else {
                    return 0;
                }
            }
        }
    }
    var neg2 = 0;
    var mag = iv;
    if (mag < 0) {
        neg2 = 1;
        mag = 0 - mag;
    }
    var v2: i64[1];
    store64(&v2, 0);
    store64(out + 8, rekha_cff_mtx_scale(mag, 0, neg2, upem, &v2));
    store64(out, load64(&v2));
    return p;
}

# The six entries of `a..b`'s FontMatrix, each x upem x 65536, into out[0..5].
# Returns 1 when it is there and usable, 0 when ABSENT (the caller applies the 0.001 default), and
# -1 when it is there and rekha will not use it.
fn rekha_cff_matrix(buf, a, b, upem, maxop, out): i64 {
    var q: i64[12];
    var i = 0;
    while (i < 12) {
        store64(&q + i * 8, 0);
        i = i + 1;
    }
    var n = 0;
    var p = a;
    while (p < b) {
        var b0 = load8(buf + p);
        if (b0 <= maxop) {
            var o = b0;
            p = p + 1;
            if (b0 == 12) {
                if (p >= b) { return 0; }
                o = 1200 + load8(buf + p);
                p = p + 1;
            }
            if (o == 1207) {
                if (n != 6) { return 0 - 1; }
                var j = 0;
                while (j < 6) {
                    if (load64(&q + j * 16 + 8) == 0) { return 0 - 1; }
                    var vj = load64(&q + j * 16);
                    var lim = REKHA_CFF_MTX_MAXSCALE;
                    if (j >= 4) { lim = REKHA_CFF_MTX_MAXMOVE; }
                    if (vj > lim || vj < 0 - lim) { return 0 - 1; }
                    store64(out + j * 8, vj);
                    j = j + 1;
                }
                return 1;
            }
            n = 0;
        } else {
            var one: i64[2];
            var np = rekha_cff_mtx_operand(buf, p, b, upem, &one);
            if (np == 0) { return 0 - 1; }
            p = np;
            var k = 0;
            while (k < 5) {
                store64(&q + k * 16, load64(&q + k * 16 + 16));
                store64(&q + k * 16 + 8, load64(&q + k * 16 + 24));
                k = k + 1;
            }
            store64(&q + 80, load64(&one));
            store64(&q + 88, load64(&one + 8));
            # ⛔ COUNTED WITHOUT A CEILING, and the ring is what is capped. Capping the COUNT at
            # six made a seven-operand FontMatrix read as a six-operand one, silently using the
            # last six — measured, it decoded a glyph instead of refusing.
            n = n + 1;
        }
    }
    return 0;
}

# Fill the font's +360.. matrix block from a Top DICT. Returns 1, or 0 when the font must be
# refused. ⚠ upem 0 leaves the transform OFF: there is nothing to scale into, and the readers that
# divide by upem already refuse such a face.
fn rekha_cff_matrix_store(f, buf, ta, tb, maxop): i64 {
    var upem = load64(f + 40);
    store64(f + 360, 0);
    if (upem <= 0) { return 1; }
    var m: i64[6];
    var r = rekha_cff_matrix(buf, ta, tb, upem, maxop, &m);
    if (r < 0) { return 0; }
    if (r == 0) {
        # ⛔ ABSENT MEANS 0.001, NOT "the same units as head". That is the CFF default and what
        # FreeType derives its upem from. The two agree exactly when unitsPerEm is 1000, which is
        # what an OpenType CFF face carries; they disagree only on a face that is already
        # self-contradictory, and rekha follows the spec there rather than the file's own head.
        var d = (upem * 65536 + REKHA_CFF_MTX_DEFAULT / 2) / REKHA_CFF_MTX_DEFAULT;
        store64(&m, d);
        store64(&m + 8, 0);
        store64(&m + 16, 0);
        store64(&m + 24, d);
        store64(&m + 32, 0);
        store64(&m + 40, 0);
    }
    var on = 0;
    if (load64(&m) != 65536) { on = 1; }
    if (load64(&m + 24) != 65536) { on = 1; }
    if (load64(&m + 8) != 0) { on = 1; }
    if (load64(&m + 16) != 0) { on = 1; }
    if (load64(&m + 32) != 0) { on = 1; }
    if (load64(&m + 40) != 0) { on = 1; }
    store64(f + 360, on);
    var i = 0;
    while (i < 6) {
        store64(f + 368 + i * 8, load64(&m + i * 8));
        i = i + 1;
    }
    return 1;
}

# The absolute offset of the Subrs INDEX named by the Private DICT that `dict` [a, b) points at, or 0
# (no Private, no Subrs, or anything out of range). `cff` is the CFF table's start.
fn rekha_cff_priv_subrs_csz(buf, cff, end, a, b, csz): i64 {
    # ⚠ The INDEX width and the DICT dialect always travel together: a u32 INDEX means CFF2, and a
    # CFF2 Private DICT may hold `vsindex` (22) or `blend` (23) AHEAD of its Subrs (19).
    var mx = 21;
    if (csz == 4) { mx = 27; }
    var d: i64[3];
    if (rekha_cff_dict_op_max(buf, a, b, 18, &d, mx) == 0) { return 0; }
    if (load64(&d) < 2) { return 0; }
    var size = load64(&d + 16);
    var poff = load64(&d + 8);
    if (size < 0 || poff < 0) { return 0; }
    var pa = cff + poff;
    var pb = pa + size;
    if (pb > end) { return 0; }
    if (rekha_cff_dict_op_max(buf, pa, pb, 19, &d, mx) == 0) { return 0; }
    var rel = load64(&d + 8);
    if (rel < 0) { return 0; }
    var at = pa + rel;
    # ⚠ A CFF2 local Subrs INDEX counts in u32, so validating it as a CFF INDEX would read the
    # wrong header and either refuse a good font or accept a short one.
    if (rekha_cff_idx_next(buf, at, end, csz) == 0) { return 0; }
    return at;
}

fn rekha_cff_private_subrs(buf, cff, end, a, b): i64 {
    return rekha_cff_priv_subrs_csz(buf, cff, end, a, b, 2);
}

# ================================================================
# Resolve at open — the RekhaFont CFF cache (+176..+239, see sfnt.cyr)
# ================================================================
fn rekha_cff_resolve(f): i64 {
    var k = 176;
    while (k < REKHA_FONT_SIZE) {
        store64(f + k, 0);
        k = k + 8;
    }
    # ⚠ Variation axes are not a CFF thing — a TrueType variable font has fvar too — but the whole
    # +176.. block is cleared here, so the resolve that fills part of it belongs here as well.
    rekha_var_resolve(f);
    rekha_gvar_resolve(f);
    rekha_hvar_resolve(f);
    rekha_os2_resolve(f);
    rekha_name_resolve(f);
    rekha_stat_resolve(f);
    rekha_post_resolve(f);
    rekha_kern_resolve(f);
    rekha_gpos_resolve(f);
    rekha_vert_resolve(f);
    rekha_hint_resolve(f);
    if (load64(f + 16) != REKHA_SFNT_VER_OTTO) { return 0; }
    var c: i64[1];
    var cff = rekha_find_table_len(f, REKHA_TAG_CFF, &c);
    # ⚠ No 'CFF ' is not the end of it: an OpenType face may carry 'CFF2' instead (0.4.9). A font
    # with BOTH keeps the 'CFF ' it had before, so nothing that opened one way starts opening the
    # other.
    if (cff == 0) { return rekha_cff2_resolve(f); }
    var end = cff + load64(&c);
    var buf = load64(f);
    if (cff + 4 > end) { return 0; }
    if (load8(buf + cff) != 1) { return 0; }               # major version 1 (CFF2 is not this table)
    var hs = load8(buf + cff + 2);
    if (hs < 4) { return 0; }
    var p = rekha_cff_index_next(buf, cff + hs, end);      # Name INDEX
    if (p == 0) { return 0; }
    var top_at = p;
    p = rekha_cff_index_next(buf, top_at, end);            # Top DICT INDEX
    if (p == 0) { return 0; }
    var o: i64[2];
    if (rekha_cff_obj(buf, top_at, end, 0, &o) == 0) { return 0; }
    var ta = load64(&o);
    var tb = ta + load64(&o + 8);
    p = rekha_cff_index_next(buf, p, end);                 # String INDEX
    if (p == 0) { return 0; }
    var gs = p;
    if (rekha_cff_index_next(buf, gs, end) == 0) { return 0; }   # Global Subr INDEX

    var d: i64[3];
    if (rekha_cff_dict_op(buf, ta, tb, 1206, &d) != 0) {
        if (load64(&d + 8) != 2) { return 0; }
    }
    if (rekha_cff_dict_op(buf, ta, tb, 17, &d) == 0) { return 0; }
    if (load64(&d + 8) < 0) { return 0; }
    var cs = cff + load64(&d + 8);
    var n = rekha_cff_index_count(buf, cs, end);
    if (n <= 0) { return 0; }

    var subrs = 0;
    var fdarray = 0;
    var fdselect = 0;
    if (rekha_cff_dict_op(buf, ta, tb, 1230, &d) != 0) {
        if (rekha_cff_dict_op(buf, ta, tb, 1236, &d) == 0) { return 0; }
        if (load64(&d + 8) < 0) { return 0; }
        fdarray = cff + load64(&d + 8);
        if (rekha_cff_index_count(buf, fdarray, end) <= 0) { return 0; }
        # ⛔ A PER-FONT-DICT FontMatrix IS REFUSED, not ignored. Adobe TN 5176 has a CIDFont's
        # Top DICT matrix and a Font DICT's MULTIPLY, so honouring only the Top one would render
        # such a subfont at the wrong scale — the exact failure 0.5.1 exists to end. No surveyed
        # face carries one; the day one does, rekha says so by drawing nothing.
        var nfd = rekha_cff_index_count(buf, fdarray, end);
        var fi = 0;
        while (fi < nfd) {
            var fo: i64[2];
            if (rekha_cff_obj(buf, fdarray, end, fi, &fo) == 0) { return 0; }
            var fa = load64(&fo);
            if (rekha_cff_dict_op(buf, fa, fa + load64(&fo + 8), 1207, &d) != 0) { return 0; }
            fi = fi + 1;
        }
        if (rekha_cff_dict_op(buf, ta, tb, 1237, &d) == 0) { return 0; }
        if (load64(&d + 8) < 0) { return 0; }
        fdselect = cff + load64(&d + 8);
        if (fdselect + 1 > end) { return 0; }
        var fmt = load8(buf + fdselect);
        if (fmt == 0) {
            if (fdselect + 1 + n > end) { return 0; }
        } else {
            if (fmt != 3) { return 0; }
            if (fdselect + 3 > end) { return 0; }
            var nr = rekha_rd_u16(buf, fdselect + 1);
            if (nr < 1) { return 0; }
            if (fdselect + 3 + nr * 3 + 2 > end) { return 0; }
        }
    } else {
        subrs = rekha_cff_private_subrs(buf, cff, end, ta, tb);
    }
    # charset (Top DICT 15) — GID -> SID, which is the only way a `seac` can turn a Standard
    # Encoding code into a glyph. ⛔ Absent means 0, the ISOAdobe PREDEFINED charset, in which SID i
    # is glyph i; 1 and 2 are the Expert charsets, which rekha does not carry (seac refuses on them
    # rather than guess). A custom charset is kept as an absolute offset and bounds-checked here so
    # the lookup below can walk it.
    # ⚠ This never fails the open. A charset rekha cannot use is recorded as -1 and costs only the
    # seac path; every other reader is untouched.
    var charset = 0;
    if (rekha_cff_dict_op(buf, ta, tb, 15, &d) != 0) {
        var cv = load64(&d + 8);
        if (cv < 0) {
            charset = 0 - 1;
        } else {
            if (cv <= 2) {
                charset = cv;
            } else {
                charset = cff + cv;
                if (charset + 1 > end) { charset = 0 - 1; }
            }
        }
    }
    if (rekha_cff_matrix_store(f, buf, ta, tb, 21) == 0) { return 0; }
    store64(f + 240, charset);
    store64(f + 176, cs);
    store64(f + 184, gs);
    store64(f + 192, subrs);
    store64(f + 200, fdarray);
    store64(f + 208, fdselect);
    store64(f + 216, cff);
    store64(f + 224, end);
    store64(f + 232, n);
    return 0;
}

# The FD index FDSelect assigns glyph `gid` (validated at open), or -1.
fn rekha_cff_fd(font, gid): i64 {
    var buf = load64(font);
    var sel = load64(font + 208);
    # ⚠ CFF2 requires an FDArray but not an FDSelect: with one Font DICT every glyph takes it, and
    # the table is omitted. A CFF with ROS always has one (rekha_cff_resolve refuses it otherwise).
    if (sel == 0) { return 0; }
    if (load8(buf + sel) == 0) { return load8(buf + sel + 1 + gid); }
    var nr = rekha_rd_u16(buf, sel + 1);
    var lo = 0;
    var hi = nr;
    while (lo < hi) {                       # the last range whose first <= gid
        var mid = (lo + hi) / 2;
        if (rekha_rd_u16(buf, sel + 3 + mid * 3) <= gid) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if (lo == 0) { return 0 - 1; }
    var r = sel + 3 + (lo - 1) * 3;
    if (gid >= rekha_rd_u16(buf, r + 3)) { return 0 - 1; }   # the next first / the sentinel
    return load8(buf + r + 2);
}

# ================================================================
# The Type 2 interpreter. State `s` (i64 slots):
# ================================================================
var RC_BUF   = 0;     # font data
var RC_END   = 8;     # CFF extent end
var RC_GS    = 16;    # Global Subr INDEX
var RC_LS    = 24;    # local Subrs INDEX (0 = none)
var RC_SP    = 32;    # argument stack depth
var RC_X     = 40;    # current point, 16.16
var RC_Y     = 48;
var RC_STEMS = 56;    # stem hints seen (hintmask length)
var RC_WDONE = 64;    # the first stack-clearing operator has been seen
var RC_OPEN  = 72;    # a contour is open
var RC_NP    = 80;    # points emitted
var RC_NC    = 88;    # contours closed
var RC_CST   = 96;    # index of the open contour's first point
var RC_OPS   = 104;   # operators + numbers interpreted
var RC_FILL  = 112;   # 0 = count pass, 1 = fill pass
var RC_XS    = 120;
var RC_YS    = 128;
var RC_OC    = 136;
var RC_EPS   = 144;
var RC_BAD   = 152;   # a rule was broken: the glyph is empty
var RC_NPMAX = 160;   # the most points ever held at once (a dropped moveto point counts)
var RC_STK   = 168;   # pointer to the argument stack (i64[REKHA_CFF2_MAXSTACK]; RC_SMAX bounds it)
# The four-argument endchar (`seac`) parks its request here rather than recursing from inside the
# interpreter: rekha_cff_run picks it up once the charstring has ended. 0.4.7.
var RC_SEAC  = 176;   # 1 = the charstring ended with seac arguments
var RC_ADX   = 184;   # 16.16, as the accent is displaced
var RC_ADY   = 192;
var RC_BCH   = 200;   # base and accent STANDARD ENCODING CODES, not glyph ids
var RC_ACH   = 208;
# CFF2 (0.4.9). A CFF2 charstring is Type 2 with three differences the interpreter has to know
# about: no leading width, no `endchar` at all (the bytes simply run out), and two operators of its
# own. Everything else — the drawing operators, the subroutine machinery, the hint operators, flex —
# is shared, which is why this is a mode rather than a second interpreter.
var RC_V2    = 216;   # 1 = CFF2 charstring
var RC_NREG  = 224;   # regions in the CURRENT variation-store index: what one `blend` drops per value
var RC_VST   = 232;   # absolute offset of the ItemVariationStore, 0 = none
var RC_VSOK  = 240;   # 1 while a `vsindex` is still permitted (before any blend, and only once)
# Instancing (0.4.11). At the default location there is nothing to apply and RC_NSCAL is 0, which is
# exactly the 0.4.9 behaviour; with axes set, `blend` weights each delta by its region's scalar.
var RC_IVD   = 248;   # the ItemVariationData the current vsindex names, for its region INDEXES
var RC_SCAL  = 256;   # the font's region-scalar array, or 0
var RC_NSCAL = 264;   # how many scalars are live; 0 = the default instance
# The argument-stack ceiling for THIS run: REKHA_CFF_MAXSTACK or REKHA_CFF2_MAXSTACK. It is state
# rather than a constant because one interpreter serves both dialects and they do not agree.
var RC_SMAX  = 272;
# The font's FontMatrix block (`f + 368`) when it is not the identity, else 0. Held here so the
# point store needs no font handle. 0.5.1.
var RC_MTX   = 280;
var RC_SLOTS = 36;

fn rekha_cff_arg(s, i): i64 { return load64(load64(s + RC_STK) + i * 8); }

# Consume the optional leading width: if the first stack-clearing operator finds `extra` more args
# than it takes, drop the first one.
fn rekha_cff_width(s, extra): i64 {
    # ⛔ A CFF2 charstring has NO leading width — advances come from hmtx and nowhere else. Dropping
    # a "width" there eats a real argument: MEASURED, a blended rmoveto whose two values survived the
    # blend was handed the wrong pair the moment this fired.
    if (load64(s + RC_V2) != 0) { return 0; }
    if (load64(s + RC_WDONE) != 0) { return 0; }
    store64(s + RC_WDONE, 1);
    if (extra == 0) { return 0; }
    var stk = load64(s + RC_STK);
    var sp = load64(s + RC_SP);
    var i = 1;
    while (i < sp) {
        store64(stk + (i - 1) * 8, load64(stk + i * 8));
        i = i + 1;
    }
    store64(s + RC_SP, sp - 1);
    return 0;
}

fn rekha_cff_point(s, flag): i64 {
    var np = load64(s + RC_NP);
    if (np >= REKHA_COMPOSITE_MAXP + 1) {
        store64(s + RC_BAD, 1);
        return 0;
    }
    if (load64(s + RC_FILL) != 0) {
        var x = load64(s + RC_X);
        var y = load64(s + RC_Y);
        var ox = sd_asr(x + 32768, 16);
        var oy = sd_asr(y + 32768, 16);
        var m = load64(s + RC_MTX);
        if (m != 0) {
            # ⭐ THE FontMatrix, ALREADY x unitsPerEm (0.5.1). Charstring units in, DESIGN units
            # out, so everything downstream — the seam's divide by upem, gvar, the bbox readers —
            # is untouched. ⚠ The products are 16.16 x 16.16 = 32.32 and the translation is widened
            # to meet them, so the whole coordinate rounds ONCE, half up, exactly as the untouched
            # path above does. 0x80000000 is the half at 32.32.
            var e = load64(m + 32) << 16;
            var g = load64(m + 40) << 16;
            ox = sd_asr(load64(m) * x + load64(m + 16) * y + e + 2147483648, 32);
            oy = sd_asr(load64(m + 8) * x + load64(m + 24) * y + g + 2147483648, 32);
        }
        store64(load64(s + RC_XS) + np * 8, ox);
        store64(load64(s + RC_YS) + np * 8, oy);
        store8(load64(s + RC_OC) + np, flag);
    }
    np = np + 1;
    store64(s + RC_NP, np);
    if (np > load64(s + RC_NPMAX)) { store64(s + RC_NPMAX, np); }
    return 0;
}

fn rekha_cff_close(s): i64 {
    if (load64(s + RC_OPEN) == 0) { return 0; }
    store64(s + RC_OPEN, 0);
    var np = load64(s + RC_NP);
    var cst = load64(s + RC_CST);
    if (np - cst <= 1) {
        store64(s + RC_NP, cst);            # a moveto with nothing drawn from it is no contour
        return 0;
    }
    var nc = load64(s + RC_NC);
    if (load64(s + RC_FILL) != 0) { store64(load64(s + RC_EPS) + nc * 8, np - 1); }
    store64(s + RC_NC, nc + 1);
    return 0;
}

fn rekha_cff_moveto(s, dx, dy): i64 {
    rekha_cff_close(s);
    store64(s + RC_X, load64(s + RC_X) + dx);
    store64(s + RC_Y, load64(s + RC_Y) + dy);
    store64(s + RC_CST, load64(s + RC_NP));
    store64(s + RC_OPEN, 1);
    return rekha_cff_point(s, 1);
}

fn rekha_cff_line(s, dx, dy): i64 {
    store64(s + RC_X, load64(s + RC_X) + dx);
    store64(s + RC_Y, load64(s + RC_Y) + dy);
    return rekha_cff_point(s, 1);
}

fn rekha_cff_curve(s, a, b, c, d, e, f): i64 {
    var x = load64(s + RC_X) + a;
    var y = load64(s + RC_Y) + b;
    store64(s + RC_X, x);
    store64(s + RC_Y, y);
    rekha_cff_point(s, 2);
    store64(s + RC_X, x + c);
    store64(s + RC_Y, y + d);
    rekha_cff_point(s, 2);
    store64(s + RC_X, x + c + e);
    store64(s + RC_Y, y + d + f);
    return rekha_cff_point(s, 1);
}

# The bias Type 2 adds to a subroutine number, by the INDEX's count.
fn rekha_cff_bias(n): i64 {
    if (n < 1240) { return 107; }
    if (n < 33900) { return 1131; }
    return 32768;
}

# Interpret the charstring bytes [a, b). Returns 1 at endchar, 0 at return / the end of the bytes,
# -1 when a rule is broken (RC_BAD is set too).
fn rekha_cff_exec(s, a, b, depth): i64 {
    if (depth > REKHA_CFF_MAXDEPTH) {
        store64(s + RC_BAD, 1);
        return 0 - 1;
    }
    var buf = load64(s + RC_BUF);
    var stk = load64(s + RC_STK);
    var p = a;
    while (p < b) {
        if (load64(s + RC_BAD) != 0) { return 0 - 1; }
        var ops = load64(s + RC_OPS) + 1;
        store64(s + RC_OPS, ops);
        if (ops > REKHA_CFF_MAXOPS) {
            store64(s + RC_BAD, 1);
            return 0 - 1;
        }
        var v = load8(buf + p);
        var sp = load64(s + RC_SP);
        if (v >= 32 || v == 28) {
            var num = 0;
            if (v == 28) {
                if (p + 3 > b) { store64(s + RC_BAD, 1); return 0 - 1; }
                num = rekha_rd_i16(buf, p + 1) * 65536;
                p = p + 3;
            } else {
                if (v == 255) {
                    if (p + 5 > b) { store64(s + RC_BAD, 1); return 0 - 1; }
                    num = rekha_rd_u32(buf, p + 1);
                    if (num >= 0x80000000) { num = num - 0x100000000; }
                    p = p + 5;
                } else {
                    if (v <= 246) {
                        num = (v - 139) * 65536;
                        p = p + 1;
                    } else {
                        if (p + 2 > b) { store64(s + RC_BAD, 1); return 0 - 1; }
                        if (v <= 250) {
                            num = ((v - 247) * 256 + load8(buf + p + 1) + 108) * 65536;
                        } else {
                            num = (0 - (v - 251) * 256 - load8(buf + p + 1) - 108) * 65536;
                        }
                        p = p + 2;
                    }
                }
            }
            if (sp >= load64(s + RC_SMAX)) { store64(s + RC_BAD, 1); return 0 - 1; }
            store64(stk + sp * 8, num);
            store64(s + RC_SP, sp + 1);
        } else {
            p = p + 1;
            var op = v;
            if (v == 12) {
                if (p >= b) { store64(s + RC_BAD, 1); return 0 - 1; }
                op = 1200 + load8(buf + p);
                p = p + 1;
            }
            var r = rekha_cff_op(s, op, depth);
            if (r == 2) {                           # hintmask / cntrmask: skip the mask bytes
                p = p + (load64(s + RC_STEMS) + 7) / 8;
                if (p > b) { store64(s + RC_BAD, 1); return 0 - 1; }
            } else {
                if (r != 0) { return r; }
            }
        }
    }
    return 0;
}

# Execute one operator. 0 = continue, 1 = endchar, -1 = broken, 0 - 2 = return (subroutine end),
# 2 = a mask operator whose bytes the caller skips.
fn rekha_cff_op(s, op, depth): i64 {
    var sp = load64(s + RC_SP);
    var i = 0;
    if (op == 1 || op == 3 || op == 18 || op == 23 || op == 19 || op == 20) {
        # A width here would make the count odd; dropping it changes no stem count (floor(n / 2) =
        # (n - 1) / 2 for odd n), so the width is only marked consumed.
        rekha_cff_width(s, 0);
        store64(s + RC_STEMS, load64(s + RC_STEMS) + sp / 2);
        store64(s + RC_SP, 0);
        if (op == 19 || op == 20) { return 2; }
        return 0;
    }
    if (op == 21 || op == 22 || op == 4) {
        var need = 1;
        if (op == 21) { need = 2; }
        if (sp > need) { rekha_cff_width(s, 1); } else { rekha_cff_width(s, 0); }
        sp = load64(s + RC_SP);
        if (sp < need) { store64(s + RC_BAD, 1); return 0 - 1; }
        if (op == 21) { rekha_cff_moveto(s, rekha_cff_arg(s, 0), rekha_cff_arg(s, 1)); }
        if (op == 22) { rekha_cff_moveto(s, rekha_cff_arg(s, 0), 0); }
        if (op == 4) { rekha_cff_moveto(s, 0, rekha_cff_arg(s, 0)); }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 14) {                                 # endchar
        # endchar takes nothing, or the four `seac` arguments — and either form may carry a leading
        # width when endchar is the FIRST stack-clearing operator. Five arguments is therefore
        # width + seac, and the width is dropped so the four below are the seac's own.
        # ⚠ rekha_cff_width returns early once a width has already been consumed, so a 5-argument
        # endchar AFTER another stack-clearing operator keeps five and is not read as a seac.
        # ⛔ CFF2 has no `endchar`: a charstring ends when its bytes do. The operator is not merely
        # unused there, it is not in the dialect, so meeting one is a broken charstring.
        if (load64(s + RC_V2) != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        if (sp == 5) { rekha_cff_width(s, 1); } else { rekha_cff_width(s, 0); }
        if (load64(s + RC_SP) == 4) {
            # ⭐ adx ady bchar achar — an accented glyph built from two OTHER glyphs of this font,
            # named by Standard Encoding code. Parked, not recursed: the interpreter has no business
            # resolving a charset mid-charstring, and rekha_cff_run composes the two once this one
            # has properly ended. The stack is cleared so nothing downstream reads it as coordinates.
            store64(s + RC_ADX, rekha_cff_arg(s, 0));
            store64(s + RC_ADY, rekha_cff_arg(s, 1));
            store64(s + RC_BCH, sd_asr(rekha_cff_arg(s, 2), 16));
            store64(s + RC_ACH, sd_asr(rekha_cff_arg(s, 3), 16));
            store64(s + RC_SEAC, 1);
            store64(s + RC_SP, 0);
        }
        rekha_cff_close(s);
        return 1;
    }
    if (op == 10 || op == 29) {                     # callsubr / callgsubr
        if (sp < 1) { store64(s + RC_BAD, 1); return 0 - 1; }
        var at = load64(s + RC_GS);
        if (op == 10) { at = load64(s + RC_LS); }
        if (at == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        var buf = load64(s + RC_BUF);
        var end = load64(s + RC_END);
        var csz = 2;
        if (load64(s + RC_V2) != 0) { csz = 4; }
        if (rekha_cff_idx_next(buf, at, end, csz) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        var count = rekha_cff_idx_count_at(buf, at, csz);
        var idx = sd_asr(rekha_cff_arg(s, sp - 1), 16) + rekha_cff_bias(count);
        store64(s + RC_SP, sp - 1);
        var o: i64[2];
        if (rekha_cff_idx_obj(buf, at, end, idx, &o, csz) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        var r = rekha_cff_exec(s, load64(&o), load64(&o) + load64(&o + 8), depth + 1);
        if (r == 1) { return 1; }
        if (r < 0) {
            if (load64(s + RC_BAD) != 0) { return 0 - 1; }
        }
        return 0;
    }
    if (op == 11) { return 0 - 2; }                 # return

    # ── the two CFF2 operators. Both sit ABOVE the "drawing before a moveto" test below, because a
    # blend builds the arguments an rmoveto is about to take and so legitimately runs before one.
    if (op == 15) {                                 # vsindex
        if (load64(s + RC_V2) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        # ⛔ The spec makes this a MUST twice over: vsindex "must precede all blend operators" and
        # may appear "only once". One flag covers both — a blend clears it too.
        if (load64(s + RC_VSOK) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        if (sp < 1) { store64(s + RC_BAD, 1); return 0 - 1; }
        var vi = sd_asr(rekha_cff_arg(s, sp - 1), 16);
        store64(s + RC_SP, 0);                      # vsindex clears the stack
        store64(s + RC_VSOK, 0);
        var ivd = rekha_cff2_ivd(load64(s + RC_BUF), load64(s + RC_VST), load64(s + RC_END), vi);
        if (ivd == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        store64(s + RC_IVD, ivd);
        store64(s + RC_NREG, rekha_rd_u16(load64(s + RC_BUF), ivd + 4));
        return 0;
    }
    if (op == 16) {                                 # blend
        if (load64(s + RC_V2) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        if (sp < 1) { store64(s + RC_BAD, 1); return 0 - 1; }
        var nb = sd_asr(rekha_cff_arg(s, sp - 1), 16);
        sp = sp - 1;
        store64(s + RC_SP, sp);
        store64(s + RC_VSOK, 0);
        if (nb < 0 || nb > load64(s + RC_SMAX)) { store64(s + RC_BAD, 1); return 0 - 1; }
        # ⭐ THE DEFAULT INSTANCE, AND WHY IT IS THIS CHEAP. The stack holds n default values, then
        # n x k deltas, then n. At the default location every region's scalar is zero, so each
        # blended value IS its default — which is already sitting in place, below the deltas. So the
        # whole operator is: drop the count, drop the deltas, leave the defaults.
        var k = load64(s + RC_NREG);
        if (nb + nb * k > sp) { store64(s + RC_BAD, 1); return 0 - 1; }
        var base = sp - nb - nb * k;
        # ⭐ INSTANCING, and it is the same three lines plus a weighted sum. With no axes set
        # RC_NSCAL is 0 and the deltas are simply dropped — byte-identical to 0.4.9 — because every
        # region's scalar at the default location IS zero and adding them would change nothing.
        if (load64(s + RC_NSCAL) > 0) {
            var stk2 = load64(s + RC_STK);
            var ivd = load64(s + RC_IVD);
            var scal = load64(s + RC_SCAL);
            var nsc = load64(s + RC_NSCAL);
            var buf2 = load64(s + RC_BUF);
            var vi2 = 0;
            while (vi2 < nb) {
                # The products are accumulated at 32.32 and shifted ONCE, so a value blended over
                # several regions rounds like one sum and not like a chain of them.
                var acc = 0;
                var j = 0;
                while (j < k) {
                    var ri = rekha_rd_u16(buf2, ivd + 6 + j * 2);
                    if (ri < nsc) {
                        var sc = load64(scal + ri * 8);
                        if (sc != 0) {
                            acc = acc + load64(stk2 + (base + nb + vi2 * k + j) * 8) * sc;
                        }
                    }
                    j = j + 1;
                }
                if (acc != 0) {
                    var at2 = stk2 + (base + vi2) * 8;
                    store64(at2, load64(at2) + sd_asr(acc + 32768, 16));
                }
                vi2 = vi2 + 1;
            }
        }
        store64(s + RC_SP, base + nb);
        return 0;
    }
    if (load64(s + RC_OPEN) == 0) { store64(s + RC_BAD, 1); return 0 - 1; }   # drawing before moveto
    if (op == 5) {                                  # rlineto
        if (sp < 2 || sp % 2 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp) {
            rekha_cff_line(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1));
            i = i + 2;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 6 || op == 7) {                       # hlineto / vlineto
        if (sp < 1) { store64(s + RC_BAD, 1); return 0 - 1; }
        var hor = 0;
        if (op == 6) { hor = 1; }
        while (i < sp) {
            if (hor != 0) {
                rekha_cff_line(s, rekha_cff_arg(s, i), 0);
            } else {
                rekha_cff_line(s, 0, rekha_cff_arg(s, i));
            }
            hor = 1 - hor;
            i = i + 1;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 8) {                                  # rrcurveto
        if (sp < 6 || sp % 6 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp) {
            rekha_cff_curve(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1), rekha_cff_arg(s, i + 2),
              rekha_cff_arg(s, i + 3), rekha_cff_arg(s, i + 4), rekha_cff_arg(s, i + 5));
            i = i + 6;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 24) {                                 # rcurveline
        if (sp < 8 || (sp - 2) % 6 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp - 2) {
            rekha_cff_curve(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1), rekha_cff_arg(s, i + 2),
              rekha_cff_arg(s, i + 3), rekha_cff_arg(s, i + 4), rekha_cff_arg(s, i + 5));
            i = i + 6;
        }
        rekha_cff_line(s, rekha_cff_arg(s, sp - 2), rekha_cff_arg(s, sp - 1));
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 25) {                                 # rlinecurve
        if (sp < 8 || (sp - 6) % 2 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp - 6) {
            rekha_cff_line(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1));
            i = i + 2;
        }
        rekha_cff_curve(s, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1), rekha_cff_arg(s, i + 2),
          rekha_cff_arg(s, i + 3), rekha_cff_arg(s, i + 4), rekha_cff_arg(s, i + 5));
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 26 || op == 27) {                     # vvcurveto / hhcurveto
        var first = 0;
        if (sp % 4 == 1) {
            first = rekha_cff_arg(s, 0);
            i = 1;
        }
        if (sp - i < 4 || (sp - i) % 4 != 0) { store64(s + RC_BAD, 1); return 0 - 1; }
        while (i < sp) {
            if (op == 26) {
                rekha_cff_curve(s, first, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1),
                  rekha_cff_arg(s, i + 2), 0, rekha_cff_arg(s, i + 3));
            } else {
                rekha_cff_curve(s, rekha_cff_arg(s, i), first, rekha_cff_arg(s, i + 1),
                  rekha_cff_arg(s, i + 2), rekha_cff_arg(s, i + 3), 0);
            }
            first = 0;
            i = i + 4;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 30 || op == 31) {                     # vhcurveto / hvcurveto
        if (sp < 4 || (sp % 4 != 0 && sp % 4 != 1)) { store64(s + RC_BAD, 1); return 0 - 1; }
        var hstart = 0;
        if (op == 31) { hstart = 1; }
        var full = sp - sp % 4;
        while (i < full) {
            var extra = 0;
            if (i + 4 == full && sp % 4 == 1) { extra = rekha_cff_arg(s, sp - 1); }
            if (hstart != 0) {
                rekha_cff_curve(s, rekha_cff_arg(s, i), 0, rekha_cff_arg(s, i + 1),
                  rekha_cff_arg(s, i + 2), extra, rekha_cff_arg(s, i + 3));
            } else {
                rekha_cff_curve(s, 0, rekha_cff_arg(s, i), rekha_cff_arg(s, i + 1),
                  rekha_cff_arg(s, i + 2), rekha_cff_arg(s, i + 3), extra);
            }
            hstart = 1 - hstart;
            i = i + 4;
        }
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 1235) {                               # flex: 12 curve args + flex depth
        if (sp != 13) { store64(s + RC_BAD, 1); return 0 - 1; }
        rekha_cff_curve(s, rekha_cff_arg(s, 0), rekha_cff_arg(s, 1), rekha_cff_arg(s, 2),
          rekha_cff_arg(s, 3), rekha_cff_arg(s, 4), rekha_cff_arg(s, 5));
        rekha_cff_curve(s, rekha_cff_arg(s, 6), rekha_cff_arg(s, 7), rekha_cff_arg(s, 8),
          rekha_cff_arg(s, 9), rekha_cff_arg(s, 10), rekha_cff_arg(s, 11));
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 1234) {                               # hflex: dx1 dx2 dy2 dx3 dx4 dx5 dx6
        if (sp != 7) { store64(s + RC_BAD, 1); return 0 - 1; }
        var dy2 = rekha_cff_arg(s, 2);
        rekha_cff_curve(s, rekha_cff_arg(s, 0), 0, rekha_cff_arg(s, 1), dy2, rekha_cff_arg(s, 3), 0);
        rekha_cff_curve(s, rekha_cff_arg(s, 4), 0, rekha_cff_arg(s, 5), 0 - dy2, rekha_cff_arg(s, 6), 0);
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 1236) {                               # hflex1: dx1 dy1 dx2 dy2 dx3 dx4 dx5 dy5 dx6
        if (sp != 9) { store64(s + RC_BAD, 1); return 0 - 1; }
        var dy1 = rekha_cff_arg(s, 1);
        var dy2b = rekha_cff_arg(s, 3);
        var dy5 = rekha_cff_arg(s, 7);
        rekha_cff_curve(s, rekha_cff_arg(s, 0), dy1, rekha_cff_arg(s, 2), dy2b, rekha_cff_arg(s, 4), 0);
        rekha_cff_curve(s, rekha_cff_arg(s, 5), 0, rekha_cff_arg(s, 6), dy5, rekha_cff_arg(s, 8),
          0 - (dy1 + dy2b + dy5));
        store64(s + RC_SP, 0);
        return 0;
    }
    if (op == 1237) {                               # flex1: dx1 dy1 .. dx5 dy5 d6
        if (sp != 11) { store64(s + RC_BAD, 1); return 0 - 1; }
        var sdx = rekha_cff_arg(s, 0) + rekha_cff_arg(s, 2) + rekha_cff_arg(s, 4) + rekha_cff_arg(s, 6)
        + rekha_cff_arg(s, 8);
        var sdy = rekha_cff_arg(s, 1) + rekha_cff_arg(s, 3) + rekha_cff_arg(s, 5) + rekha_cff_arg(s, 7)
        + rekha_cff_arg(s, 9);
        var lx = 0 - sdx;
        var ly = rekha_cff_arg(s, 10);
        if (sd_abs(sdx) > sd_abs(sdy)) {
            lx = rekha_cff_arg(s, 10);
            ly = 0 - sdy;
        }
        rekha_cff_curve(s, rekha_cff_arg(s, 0), rekha_cff_arg(s, 1), rekha_cff_arg(s, 2),
          rekha_cff_arg(s, 3), rekha_cff_arg(s, 4), rekha_cff_arg(s, 5));
        rekha_cff_curve(s, rekha_cff_arg(s, 6), rekha_cff_arg(s, 7), rekha_cff_arg(s, 8),
          rekha_cff_arg(s, 9), lx, ly);
        store64(s + RC_SP, 0);
        return 0;
    }
    store64(s + RC_BAD, 1);                         # reserved, arithmetic / storage: not read
    return 0 - 1;
}

# Run glyph `gid`'s charstring once (count pass when `fill` is 0). Returns 1 when it decoded under
# every rule, else 0.
# ================================================================
# `seac` — the accented glyph an old CFF face builds from two others (0.4.7).
#
# A four-argument `endchar` says: draw glyph `bchar` at the origin, then glyph `achar` displaced by
# (adx, ady). Both are named by STANDARD ENCODING CODE, so resolving one takes two tables — the
# Standard Encoding (code -> SID) and the font's own charset (SID -> glyph id).
# ⚠ The Type 1 `seac` had a fifth argument, `asb`. Type 2's endchar form drops it and the accent is
# placed at (adx, ady) directly, which is what every decoder this was checked against does.
# ================================================================

# The Standard Encoding SID for `code`, or 0 (which is .notdef, and also what an unassigned code
# means). ⭐ Fourteen contiguous ranges, not a 256-entry table — the encoding happens to be almost
# entirely runs. ⛔ A wrong range picks the wrong accent SILENTLY, so this is gated against all 256
# codes by programs/cff_stdenc_vectors.cyr, generated from the table by scripts/cff_stdenc.py and
# cross-checked there against fontTools.
fn rekha_cff_stdenc(code): i64 {
    if (code >= 32 && code <= 126) { return code - 31; }        # space .. asciitilde -> 1 .. 95
    if (code >= 161 && code <= 175) { return code - 65; }       # exclamdown .. fl    -> 96 .. 110
    if (code >= 177 && code <= 180) { return code - 66; }       # endash .. periodcentered
    if (code >= 182 && code <= 189) { return code - 67; }       # paragraph .. perthousand
    if (code == 191) { return 123; }                            # questiondown
    if (code >= 193 && code <= 200) { return code - 69; }       # grave .. dieresis
    if (code >= 202 && code <= 203) { return code - 70; }       # ring, cedilla
    if (code >= 205 && code <= 208) { return code - 71; }       # hungarumlaut .. emdash
    if (code == 225) { return 138; }                            # AE
    if (code == 227) { return 139; }                            # ordfeminine
    if (code >= 232 && code <= 235) { return code - 92; }       # Lslash .. ordmasculine
    if (code == 241) { return 144; }                            # ae
    if (code == 245) { return 145; }                            # dotlessi
    if (code >= 248 && code <= 251) { return code - 102; }      # lslash .. germandbls
    return 0;
}

# The glyph id whose charset entry is `sid`, or -1. Glyph 0 is .notdef (SID 0) and is never stored in
# a charset, so a hit is always >= 1.
# ⛔ Every read is bounded by the CFF extent, and the walk stops at the CharStrings count: a charset
# is allowed to describe more glyphs than the font has, and following it past `n` would hand back a
# glyph id the CharStrings INDEX cannot resolve.
# ⚠ The Expert and ExpertSubset predefined charsets (1 and 2) are NOT carried. They return -1, so a
# seac in such a font yields an empty glyph rather than a wrong one. No surveyed face uses either.
fn rekha_cff_sid_to_gid(font, sid): i64 {
    if (sid <= 0) { return 0 - 1; }
    var cset = load64(font + 240);
    var n = load64(font + 232);
    if (cset == 0) {                                    # ISOAdobe: SID i IS glyph i, up to 228
        if (sid > 228) { return 0 - 1; }
        if (sid >= n) { return 0 - 1; }
        return sid;
    }
    if (cset < 12) { return 0 - 1; }                    # 1 / 2 Expert, or -1 unusable
    var buf = load64(font);
    var end = load64(font + 224);
    var fmt = load8(buf + cset);
    var p = cset + 1;
    if (fmt == 0) {
        var g = 1;
        while (g < n) {
            if (p + 2 > end) { return 0 - 1; }
            if (rekha_rd_u16(buf, p) == sid) { return g; }
            p = p + 2;
            g = g + 1;
        }
        return 0 - 1;
    }
    if (fmt != 1 && fmt != 2) { return 0 - 1; }
    var w = 3;                                          # first u16 + nLeft u8
    if (fmt == 2) { w = 4; }                            # first u16 + nLeft u16
    var gid = 1;
    while (gid < n) {
        if (p + w > end) { return 0 - 1; }
        var first = rekha_rd_u16(buf, p);
        var nleft = load8(buf + p + 2);
        if (fmt == 2) { nleft = rekha_rd_u16(buf, p + 2); }
        if (sid >= first && sid <= first + nleft) {
            var hit = gid + sid - first;
            if (hit >= n) { return 0 - 1; }
            return hit;
        }
        gid = gid + nleft + 1;
        p = p + w;
    }
    return 0 - 1;
}

# Draw glyph `g` into the running state, starting from (x0, y0) in 16.16. Everything a charstring
# owns is reset first — the stack, the current point, the stem count, the width flag and the open
# contour — while the POINT counters, the operator budget and the output pointers carry over, which
# is what makes this a composition rather than a second glyph.
fn rekha_cff_seac_part(font, s, g, x0, y0): i64 {
    store64(s + RC_SP, 0);
    store64(s + RC_X, x0);
    store64(s + RC_Y, y0);
    store64(s + RC_STEMS, 0);
    store64(s + RC_WDONE, 0);
    store64(s + RC_OPEN, 0);
    store64(s + RC_SEAC, 0);
    var buf = load64(s + RC_BUF);
    var end = load64(s + RC_END);
    var o: i64[2];
    if (rekha_cff_obj(buf, load64(font + 176), end, g, &o) == 0) { return 0; }
    var r = rekha_cff_exec(s, load64(&o), load64(&o) + load64(&o + 8), 0);
    if (load64(s + RC_BAD) != 0) { return 0; }
    if (r != 1) { return 0; }
    # ⛔ A component that is ITSELF a seac is refused rather than followed. One level is what the
    # operator means, and nesting it is how a font turns two glyph loads into a tree.
    if (load64(s + RC_SEAC) != 0) { return 0; }
    return 1;
}

# Compose the seac the charstring for `gid` parked. 1 on success, 0 to leave the glyph EMPTY.
fn rekha_cff_seac(font, s, gid): i64 {
    # ⛔ A CID-keyed font has no Standard Encoding and no seac: its charset maps glyph ids to CIDs,
    # not to the SIDs this resolves through, so the lookup would be nonsense rather than a miss.
    if (load64(font + 200) != 0) { return 0; }
    var bgid = rekha_cff_sid_to_gid(font, rekha_cff_stdenc(load64(s + RC_BCH)));
    var agid = rekha_cff_sid_to_gid(font, rekha_cff_stdenc(load64(s + RC_ACH)));
    if (bgid <= 0 || agid <= 0) { return 0; }
    # ⛔ Not even one level of self-reference: a base that is this glyph would re-enter the same
    # charstring and park the same request again.
    if (bgid == gid || agid == gid) { return 0; }
    if (rekha_cff_seac_part(font, s, bgid, 0, 0) == 0) { return 0; }
    return rekha_cff_seac_part(font, s, agid, load64(s + RC_ADX), load64(s + RC_ADY));
}

fn rekha_cff_run(font, gid, s, stk, fill): i64 {
    var buf = load64(font);
    var end = load64(font + 224);
    var k = 0;
    while (k < RC_SLOTS) {
        if (k * 8 < RC_XS || k * 8 > RC_EPS || fill == 0) { store64(s + k * 8, 0); }
        k = k + 1;
    }
    store64(s + RC_BUF, buf);
    store64(s + RC_END, end);
    store64(s + RC_GS, load64(font + 184));
    store64(s + RC_LS, load64(font + 192));
    store64(s + RC_FILL, fill);
    store64(s + RC_STK, stk);
    var v2 = load64(font + 256);
    store64(s + RC_V2, v2);
    store64(s + RC_SMAX, REKHA_CFF_MAXSTACK);
    if (v2 != 0) { store64(s + RC_SMAX, REKHA_CFF2_MAXSTACK); }
    store64(s + RC_MTX, 0);
    if (load64(font + 360) != 0) { store64(s + RC_MTX, font + 368); }
    store64(s + RC_VST, load64(font + 264));
    store64(s + RC_VSOK, v2);
    if (load64(font + 200) != 0) {                  # CID-keyed, or ANY CFF2: FDArray[FDSelect(gid)]
        var fd = rekha_cff_fd(font, gid);           # -1 (no range) fails the object lookup below
        var fo: i64[2];
        var csz = 2;
        if (v2 != 0) { csz = 4; }
        if (rekha_cff_idx_obj(buf, load64(font + 200), end, fd, &fo, csz) == 0) { return 0; }
        var fa = load64(&fo);
        var fb = fa + load64(&fo + 8);
        store64(s + RC_LS, rekha_cff_priv_subrs_csz(buf, load64(font + 216), end, fa, fb, csz));
        # A CFF2 Private DICT may name the variation-store index every blend in its glyphs starts
        # from; without one that is 0. A charstring's own `vsindex` overrides it.
        if (v2 != 0) {
            var ivd0 = rekha_cff2_priv_ivd(buf, load64(font + 216), end, fa, fb, load64(font + 264));
            if (ivd0 < 0) { return 0; }
            store64(s + RC_IVD, ivd0);
            if (ivd0 != 0) { store64(s + RC_NREG, rekha_rd_u16(buf, ivd0 + 4)); }
            store64(s + RC_SCAL, load64(font + 320));
            store64(s + RC_NSCAL, load64(font + 328));
        }
    }
    var o: i64[2];
    var ccsz = 2;
    if (v2 != 0) { ccsz = 4; }
    if (rekha_cff_idx_obj(buf, load64(font + 176), end, gid, &o, ccsz) == 0) { return 0; }
    var r = rekha_cff_exec(s, load64(&o), load64(&o) + load64(&o + 8), 0);
    if (load64(s + RC_BAD) != 0) { return 0; }
    if (load64(s + RC_V2) != 0) {
        # ⛔ A CFF2 charstring ENDS WHEN ITS BYTES DO — there is no terminator to look for, so the
        # success condition is the exact opposite of CFF's. `rekha_cff_exec` answers 0 both at the
        # end of the bytes and at a top-level `return`; either way the open contour is ours to close,
        # which `endchar` would have done in a CFF.
        if (r != 0) { return 0; }
        rekha_cff_close(s);
    } else {
        if (r != 1) { return 0; }                   # no endchar
        # A parked seac is composed HERE, outside the interpreter, and its two component charstrings
        # spend the same operator budget and the same point ceiling as everything above.
        if (load64(s + RC_SEAC) != 0) {
            if (rekha_cff_seac(font, s, gid) == 0) { return 0; }
        }
    }
    if (load64(s + RC_NP) > REKHA_COMPOSITE_MAXP) { return 0; }
    return 1;
}

# Decode glyph `gid` of a CFF font into a RekhaOutline. Empty for an out-of-range gid (the CharStrings
# lookup refuses it), a broken rule or a bound (see the head of this file); 0 only on OOM.
# ⚠ No load context: a CFF glyph has no components, so one decode is one load, and its points are
# already capped at REKHA_COMPOSITE_MAXP — below any budget a context would carry.
fn rekha_cff_load(font, gid): i64 {
    var s: i64[36];
    # ⚠ ONE array, sized for the larger dialect (4,104 B of frame), and RC_SMAX is what actually
    # bounds a run — a CFF still refuses its 49th operand. Sizing it per dialect would need two
    # frames or an allocation, and rekha_cff_load is called once per glyph, not per point.
    var stk: i64[513];
    if (rekha_cff_run(font, gid, &s, &stk, 0) == 0) { return rekha_outline_empty(); }
    var np = load64(&s + RC_NP);
    var nc = load64(&s + RC_NC);
    var cap = load64(&s + RC_NPMAX);
    if (nc == 0) { return rekha_outline_empty(); }
    var o = sd_alloc(REKHA_OUTLINE_SIZE + nc * 8 + cap * 17);
    if (o == 0) { return 0; }
    var eps = o + REKHA_OUTLINE_SIZE;
    var xs = eps + nc * 8;
    var ys = xs + cap * 8;
    var oc = ys + cap * 8;
    store64(&s + RC_XS, xs);
    store64(&s + RC_YS, ys);
    store64(&s + RC_OC, oc);
    store64(&s + RC_EPS, eps);
    if (rekha_cff_run(font, gid, &s, &stk, 1) == 0) { return rekha_outline_clear(o); }
    if (load64(&s + RC_NP) != np || load64(&s + RC_NC) != nc) { return rekha_outline_clear(o); }
    store64(o, nc);
    store64(o + 8, np);
    store64(o + 16, eps);
    store64(o + 24, xs);
    store64(o + 32, ys);
    store64(o + 40, oc);
    return o;
}

# --- cff2.cyr ---

# CFF2: the variable-font charstring table (0.4.9).
#
# cff2.cyr — resolve a 'CFF2' table at rekha_font_open and let cff.cyr's Type 2 interpreter decode
# its charstrings, so a CFF2 face draws through rekha_load_glyph / rekha_glyph_to_sdpath /
# rekha_char_to_sdpath with no consumer change, exactly as an 'OTTO' CFF face does.
#
# ⭐ THE DEFAULT INSTANCE, AND SINCE 0.4.11 EVERY OTHER ONE. A CFF2 font is a variable font: its
# charstrings carry `blend` operators whose deltas move every point as the design axes move. Left
# alone, rekha decodes the font at its DEFAULT location, where every region's scalar is zero and a
# blended value is simply its default — the instance a consumer that sets no axis wants, and the
# one `fvar`'s defaults name. `rekha_var_set_axis` (src/var.cyr, 0.4.11) reads `fvar` / `avar` and
# builds the region scalars `blend` then weights its deltas by.
#
# WHAT IS DIFFERENT FROM CFF (Adobe TN 5176 vs the OpenType CFF2 chapter), and it is most of the
# container:
#   - Header is 5 bytes: major u8 (= 2) · minor u8 · headerSize u8 (>= 5) · topDictLength u16.
#   - The Top DICT is NOT an INDEX. It is topDictLength raw bytes at cff + headerSize.
#   - There is no Name INDEX, no String INDEX, no charset and no encoding.
#   - Every INDEX counts in u32, not u16 — including a count-0 one, which is 4 bytes, not 2.
#     cff.cyr's readers take the width (`rekha_cff_idx_next` / `_obj`), so the bounds logic is not
#     duplicated here.
#   - An FDArray is REQUIRED even for a single Font DICT; an FDSelect is omitted when there is one.
#   - Top DICT `vstore` (24) points at the ItemVariationStore, and a Private DICT `vsindex` (22)
#     names the subtable its glyphs blend against.
#   - The charstring dialect drops the leading width and `endchar` entirely and adds `vsindex` (15)
#     and `blend` (16). cff.cyr's interpreter carries that as a mode (RC_V2), not a second copy.
#
# ⛔ WHAT IS REFUSED (the table resolves to nothing, and the face opens with no outlines):
#   - a major version other than 2, or a headerSize under 5;
#   - a Top DICT that does not lie inside the table, or that names no CharStrings or no FDArray;
#   - any INDEX whose u32 count, offSize, offset array or last offset does not fit;
#   - an FDSelect in a format other than 0 or 3 — CFF2's format 4 exists and rekha does not read it;
#   - an ItemVariationStore whose declared length, format, subtable count or subtable offset does
#     not fit, once something actually asks it for a region count;
#   - a `vsindex` naming a subtable the store does not have, or appearing after a `blend` or twice
#     (both are spec MUSTs, enforced in cff.cyr).
# ⚠ A `blend` in a font with NO variation store is a no-op that keeps its default values rather than
# a refusal: there are no deltas to drop, and the rendered result is the one the default instance
# asks for. An explicit `vsindex` into a store that is not there IS refused — it names something.

var REKHA_TAG_CFF2 = 0x43464632;   # 'CFF2'

# The number of regions ItemVariationData[idx] blends over — which is how many delta values one
# `blend` drops per blended number. -1 when the store, the index or any bound does not hold.
#
# VariationStore: u16 length, then the ItemVariationStore it sizes.
# ItemVariationStore: format u16 (= 1) · variationRegionListOffset u32 · itemVariationDataCount u16
#   · itemVariationDataOffsets[count] u32, all offsets from the store's own start.
# ItemVariationData: itemCount u16 · wordDeltaCount u16 · regionIndexCount u16 · the region indexes.
# ⚠ Only regionIndexCount is read. The region list and the delta sets are what a NON-default
# instance would need, and rekha never reaches for them.
fn rekha_cff2_ivd(buf, vstore, end, idx): i64 {
    if (vstore == 0) { return 0; }
    if (idx < 0) { return 0; }
    if (vstore + 2 > end) { return 0; }
    var ivs = vstore + 2;
    var ivend = ivs + rekha_rd_u16(buf, vstore);
    if (ivend > end) { return 0; }
    if (ivs + 8 > ivend) { return 0; }
    if (rekha_rd_u16(buf, ivs) != 1) { return 0; }
    var cnt = rekha_rd_u16(buf, ivs + 6);
    if (idx >= cnt) { return 0; }
    if (ivs + 8 + cnt * 4 > ivend) { return 0; }
    var ivd = ivs + rekha_rd_u32(buf, ivs + 8 + idx * 4);
    if (ivd < ivs) { return 0; }
    if (ivd + 6 > ivend) { return 0; }
    # ⚠ The region INDEXES are bounds-checked too, not just their count: instancing reads WHICH
    # regions a subtable blends over, so the whole array has to lie inside the store.
    if (ivd + 6 + rekha_rd_u16(buf, ivd + 4) * 2 > ivend) { return 0; }
    return ivd;
}

# The number of regions ItemVariationData[idx] blends over, or -1.
fn rekha_cff2_regions(buf, vstore, end, idx): i64 {
    var ivd = rekha_cff2_ivd(buf, vstore, end, idx);
    if (ivd == 0) { return 0 - 1; }
    return rekha_rd_u16(buf, ivd + 4);
}

# The ItemVariationData a Font DICT's glyphs start from: its Private DICT's `vsindex` (22) resolved
# through the store, or 0. -1 only when an explicit vsindex names something the store does not have.
# ⚠ Lenient in two places, on purpose. No Private DICT, no vsindex operator, or no variation store
# all give 0 — a `blend` then drops nothing and keeps its defaults, which is the right rendering for
# the default instance. An index that IS written down and does not resolve is a refusal.
fn rekha_cff2_priv_ivd(buf, cff, end, a, b, vstore): i64 {
    if (vstore == 0) { return 0; }
    var d: i64[3];
    if (rekha_cff_dict_op_max(buf, a, b, 18, &d, 27) == 0) { return 0; }
    if (load64(&d) < 2) { return 0; }
    var size = load64(&d + 16);
    var poff = load64(&d + 8);
    if (size < 0 || poff < 0) { return 0; }
    var pa = cff + poff;
    var pb = pa + size;
    if (pb > end) { return 0; }
    if (rekha_cff_dict_op_max(buf, pa, pb, 22, &d, 27) == 0) {
        # No vsindex written down: subtable 0 by default, and a store with nothing in it is not an
        # error — it simply means no deltas.
        return rekha_cff2_ivd(buf, vstore, end, 0);
    }
    var ivd = rekha_cff2_ivd(buf, vstore, end, load64(&d + 8));
    if (ivd == 0) { return 0 - 1; }
    return ivd;
}

# Validate an FDSelect at `sel` covering `n` glyphs. 1 when rekha can read it, 0 otherwise.
# ⛔ Formats 0 and 3 only. CFF2 also defines format 4 (u32 ranges, for fonts past 65,535 glyphs);
# rekha refuses it rather than mis-reading its wider fields as format 3's.
fn rekha_cff2_fdselect_ok(buf, sel, end, n): i64 {
    if (sel + 1 > end) { return 0; }
    var fmt = load8(buf + sel);
    if (fmt == 0) {
        if (sel + 1 + n > end) { return 0; }
        return 1;
    }
    if (fmt != 3) { return 0; }
    if (sel + 3 > end) { return 0; }
    var nr = rekha_rd_u16(buf, sel + 1);
    if (nr < 1) { return 0; }
    if (sel + 3 + nr * 3 + 2 > end) { return 0; }
    return 1;
}

# Resolve the 'CFF2' table of `f` into the RekhaFont cache, the way rekha_cff_resolve does for
# 'CFF '. 1 when the face has usable CFF2 outlines, 0 otherwise. Called only when 'CFF ' is absent,
# so a font carrying both keeps the behaviour it had before 0.4.9.
fn rekha_cff2_resolve(f): i64 {
    var c: i64[1];
    var cff = rekha_find_table_len(f, REKHA_TAG_CFF2, &c);
    if (cff == 0) { return 0; }
    var end = cff + load64(&c);
    var buf = load64(f);
    if (cff + 5 > end) { return 0; }
    if (load8(buf + cff) != 2) { return 0; }             # major version 2 (CFF 1 is the other table)
    var hs = load8(buf + cff + 2);
    if (hs < 5) { return 0; }
    var ta = cff + hs;
    var tb = ta + rekha_rd_u16(buf, cff + 3);            # the Top DICT is raw bytes, not an INDEX
    if (tb > end) { return 0; }
    if (ta > tb) { return 0; }
    var gs = tb;                                          # the Global Subr INDEX follows it
    if (rekha_cff_idx_next(buf, gs, end, 4) == 0) { return 0; }

    var d: i64[3];
    if (rekha_cff_dict_op_max(buf, ta, tb, 17, &d, 27) == 0) { return 0; }        # CharStrings
    if (load64(&d + 8) < 0) { return 0; }
    var cs = cff + load64(&d + 8);
    if (rekha_cff_idx_next(buf, cs, end, 4) == 0) { return 0; }
    var n = rekha_cff_idx_count_at(buf, cs, 4);
    if (n < 1) { return 0; }

    # ⛔ REQUIRED, unlike CFF: a CFF2 font's Private DICTs live in Font DICTs and nowhere else, so
    # without an FDArray there is no Private DICT, no local Subrs and no vsindex to find.
    if (rekha_cff_dict_op_max(buf, ta, tb, 1236, &d, 27) == 0) { return 0; }      # FDArray
    if (load64(&d + 8) < 0) { return 0; }
    var fdarray = cff + load64(&d + 8);
    if (rekha_cff_idx_next(buf, fdarray, end, 4) == 0) { return 0; }
    if (rekha_cff_idx_count_at(buf, fdarray, 4) < 1) { return 0; }

    var fdselect = 0;
    if (rekha_cff_dict_op_max(buf, ta, tb, 1237, &d, 27) != 0) {                  # FDSelect, optional
        if (load64(&d + 8) < 0) { return 0; }
        fdselect = cff + load64(&d + 8);
        if (rekha_cff2_fdselect_ok(buf, fdselect, end, n) == 0) { return 0; }
    }

    var vstore = 0;
    if (rekha_cff_dict_op_max(buf, ta, tb, 24, &d, 27) != 0) {                    # vstore, optional
        if (load64(&d + 8) < 0) { return 0; }
        vstore = cff + load64(&d + 8);
        if (vstore + 2 > end) { return 0; }
        if (vstore + 2 + rekha_rd_u16(buf, vstore) > end) { return 0; }
    }

    if (rekha_cff_matrix_store(f, buf, ta, tb, 27) == 0) { return 0; }
    store64(f + 176, cs);
    store64(f + 184, gs);
    store64(f + 192, 0);                                  # no Top DICT Private: it is per Font DICT
    store64(f + 200, fdarray);
    store64(f + 208, fdselect);
    store64(f + 216, cff);
    store64(f + 224, end);
    store64(f + 232, n);
    store64(f + 240, 0);                                  # no charset, so no seac
    store64(f + 256, 1);
    store64(f + 264, vstore);
    return 1;
}

# --- var.cyr ---

# OpenType font variations: axes, normalization, and the region scalars (0.4.11).
#
# var.cyr — read `fvar` and `avar`, turn a user axis setting into a NORMALIZED coordinate, and turn
# those coordinates into one scalar per region of a variation store. That scalar is the whole of
# instancing: a blended value is its default plus the sum of its deltas, each weighted by the scalar
# of the region it belongs to. At the default location every scalar is zero, which is why 0.4.9
# could decode a CFF2 without any of this.
#
# ⛔ WHAT THIS DOES NOT DO. The region-scalar ARRAY built here is the CFF2 variation store's, and
# the CFF2 charstring `blend` is its only consumer. `gvar` (0.4.12) shares the tent maths instead —
# `rekha_var_axis_factor`, `rekha_var_live` — and derives its own scalar per tuple. `HVAR` and
# `MVAR` are METRICS deltas over the same machinery and are not read: docs/development/roadmap.md.
#
# fvar (OpenType): majorVersion u16 · minorVersion u16 · axesArrayOffset u16 · reserved u16 ·
#   axisCount u16 · axisSize u16 · instanceCount u16 · instanceSize u16; then axisCount
#   VariationAxisRecords of `axisSize` bytes: tag u32 · minValue Fixed · defaultValue Fixed ·
#   maxValue Fixed · flags u16 · axisNameID u16.
# avar: majorVersion u16 · minorVersion u16 · reserved u16 · axisSegmentMapCount u16; then one
#   SegmentMap per axis: positionMapCount u16 · that many (fromCoordinate, toCoordinate) F2Dot14
#   pairs, both in normalized space.
# ⭐ avar 2.0 IS ACCEPTED FOR ITS SEGMENT MAPS (0.5.0). 2.0 keeps 1.0's axisSegmentMaps unchanged
# and in the same place — its additions (axisIndexMapOffset, varStoreOffset) sit AFTER them — so a
# 2.0 table parses here exactly as a 1.0 one does. Through 0.4.12 the version gate took 1 only and
# dropped such a table WHOLE, discarding mapping rekha already knew how to apply.
# ⛔ Its variation store is still NOT applied: that needs a DeltaSetIndexMap reader rekha does not
# have (docs/development/roadmap.md). So a 2.0 axis is mapped by its segments and not refined by
# its store — which is what 2.0's own design makes the safe subset, since a 2.0 font that does all
# its work in the store carries identity segment maps and is unaffected either way.
#
# ⚠ FIXED POINT. Axis values and normalized coordinates are 16.16 here, because that is what fvar's
# own Fixed fields are and what the charstring interpreter already works in. A region's coordinates
# are F2Dot14 in the font (1.0 = 16384) and are widened by 2 on the way in.

var REKHA_TAG_FVAR = 0x66766172;   # 'fvar'
var REKHA_TAG_AVAR = 0x61766172;   # 'avar'
# Axes in one font, and regions in one variation store. Real variable fonts carry a handful of axes;
# the cap keeps the per-font arrays small and every index multiplication trivially in range.
var REKHA_VAR_MAXAXES   = 64;
var REKHA_VAR_MAXREGION = 4096;
# Named instances in one font. Real families carry a few dozen; the cap keeps the index
# multiplication below trivially in range.
var REKHA_VAR_MAXINST   = 4096;
var REKHA_VAR_ONE       = 65536;   # 1.0 in 16.16

# 16.16 x 16.16 -> 16.16, rounded half up. ⚠ `>>` is logical in Cyrius, so the shift is sd_asr.
fn rekha_fx_mul(a, b): i64 {
    return sd_asr(a * b + 32768, 16);
}

# 16.16 / 16.16 -> 16.16, ROUNDED HALF UP. Both arguments are positive at every call site (each is
# a difference between a coordinate and the edge of the interval it lies inside), so no sign
# handling is needed and `+ b / 2` before the divide is the whole of the rounding.
# ⭐ IT TRUNCATED UNTIL 0.5.0, and `rekha_fx_mul` beside it has always rounded half up — the pair
# disagreed. Every caller here divides one interval by another to get a ratio in [0, 1]: axis
# NORMALIZATION, the avar segment walk, and a region's tent scalar. Truncating biased all three low
# by up to one ulp, and one ulp of scalar is enough to move a point: MEASURED against fontTools on
# a 31-region CFF2 at wght 550, where the exact coordinate is 51.5 — rekha normalized 150 / 500 to
# 19660 (0.2999878) instead of 19661 (0.3000031) and rounded the point DOWN to 51 where fontTools
# gave 52. 19661 is also simply the closer of the two to 0.3.
fn rekha_fx_div(a, b): i64 {
    if (b == 0) { return 0; }
    return ((a << 16) + b / 2) / b;
}

# ================================================================
# fvar — the axes
# ================================================================

# @public — how many variation axes the font declares, or 0 when it has no usable `fvar`.
public fn rekha_var_axis_count(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 280);
}

# The byte offset of axis record `i`, or 0.
fn rekha_var_axis_rec(font, i): i64 {
    if (font == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(font + 280)) { return 0; }
    return load64(font + 272) + i * load64(font + 288);
}

# @public — axis `i`'s four-byte tag ('wght', 'wdth', …), or 0.
public fn rekha_var_axis_tag(font, i): i64 {
    var r = rekha_var_axis_rec(font, i);
    if (r == 0) { return 0; }
    return rekha_rd_u32(load64(font), r);
}

# Axis `i`'s record field at `off` (4 / 8 / 12 = min / default / max), in 16.16 user units. 0 for
# a bad index. ⚠ fvar stores these as signed Fixed, so they are sign-extended from the u32 the
# reader returns.
fn rekha_var_axis_at(font, i, off): i64 {
    var r = rekha_var_axis_rec(font, i);
    if (r == 0) { return 0; }
    var v = rekha_rd_u32(load64(font), r + off);
    if (v >= 0x80000000) { v = v - 0x100000000; }
    return v;
}

# @public — the `name` id of axis `i`'s label, or 0 when the font has no such axis. Feed it to
# `rekha_name_utf8` for the text: an axis has been enumerable since 0.4.11 and unlabelable until
# 0.6.2, because the record's axisNameID was parsed past and never resolved.
public fn rekha_var_axis_name_id(font, i): i64 {
    var r = rekha_var_axis_rec(font, i);
    if (r == 0) { return 0; }
    return rekha_rd_u16(load64(font), r + 18);
}

# @public — axis `i`'s minimum / default / maximum, in 16.16 user units. 0 for a bad index.
public fn rekha_var_axis_min(font, i): i64     { return rekha_var_axis_at(font, i, 4); }
public fn rekha_var_axis_default(font, i): i64 { return rekha_var_axis_at(font, i, 8); }
public fn rekha_var_axis_max(font, i): i64     { return rekha_var_axis_at(font, i, 12); }

# Normalize a user value onto [-1, 1] (OpenType's rule): clamp to the axis range, then scale the
# distance from the default by the half-range it falls in.
fn rekha_var_normalize(lo, def, hi, v): i64 {
    if (v < lo) { v = lo; }
    if (v > hi) { v = hi; }
    if (v == def) { return 0; }
    if (v < def) {
        if (def == lo) { return 0; }
        return 0 - rekha_fx_div(def - v, def - lo);
    }
    if (hi == def) { return 0; }
    return rekha_fx_div(v - def, hi - def);
}

# Apply axis `i`'s avar SegmentMap to an already-normalized coordinate. Returns it unchanged when
# there is no avar, no map for this axis, or fewer than two positions — a map needs a segment.
# ⚠ The map is piecewise linear between consecutive (from, to) pairs, and the spec requires `from`
# to increase; a pair that does not is where the walk stops, leaving the coordinate as it was.
fn rekha_var_avar(font, i, coord): i64 {
    var avar = load64(font + 296);
    if (avar == 0) { return coord; }
    var buf = load64(font);
    var end = load64(font + 304);
    if (avar + 8 > end) { return coord; }
    var nmaps = rekha_rd_u16(buf, avar + 6);
    if (i >= nmaps) { return coord; }
    var p = avar + 8;
    var a = 0;
    while (a < i) {
        if (p + 2 > end) { return coord; }
        p = p + 2 + rekha_rd_u16(buf, p) * 4;
        a = a + 1;
    }
    if (p + 2 > end) { return coord; }
    var cnt = rekha_rd_u16(buf, p);
    if (cnt < 2) { return coord; }
    if (p + 2 + cnt * 4 > end) { return coord; }
    var prevf = 0 - REKHA_VAR_ONE * 2;
    var prevt = prevf;
    var k = 0;
    while (k < cnt) {
        var fc = rekha_rd_i16(buf, p + 2 + k * 4) * 4;        # F2Dot14 -> 16.16
        var tc = rekha_rd_i16(buf, p + 2 + k * 4 + 2) * 4;
        if (fc <= prevf) { return coord; }                    # not increasing: leave it alone
        if (coord == fc) { return tc; }
        if (coord < fc) {
            if (k == 0) { return coord; }
            return prevt + rekha_fx_mul(tc - prevt, rekha_fx_div(coord - prevf, fc - prevf));
        }
        prevf = fc;
        prevt = tc;
        k = k + 1;
    }
    return coord;
}

# ================================================================
# Region scalars
# ================================================================

# The scalar for region `r` of the VariationRegionList at `rl`, under the font's current normalized
# coordinates. 16.16; 0 means the region contributes nothing.
#
# ⭐ This is OpenType's own rule, axis by axis, and three of its five branches are "this axis does
# not constrain the region" rather than "the region is off":
#   - a peak of 0 means the region does not use the axis at all;
#   - start > peak or peak > end is a malformed triple, ignored rather than treated as zero;
#   - a region spanning the default (start < 0 < end) is ignored on that axis, by the same rule;
#   - at the peak exactly, the factor is 1;
#   - at or beyond either edge, the WHOLE region is zero and the product stops.
# Anywhere else the factor is how far the coordinate has travelled from the edge toward the peak.
# ONE axis's contribution to a region or tuple scalar, in 16.16. 0 - 1 means "this whole region is
# off"; REKHA_VAR_ONE means "this axis does not constrain it", which is NOT the same thing and is
# the distinction three of the five branches below exist to make.
# ⭐ Shared by CFF2's variation regions and gvar's tuples (0.4.12) — the tent is the same shape in
# both, and the only difference is where the three coordinates are read from.
fn rekha_var_axis_factor(v, lo, pk, hi): i64 {
    if (pk == 0) { return REKHA_VAR_ONE; }              # the region does not use this axis
    if (lo > pk || pk > hi) { return REKHA_VAR_ONE; }   # a malformed triple: ignored, not zeroed
    if (lo < 0 && hi > 0) { return REKHA_VAR_ONE; }     # a region spanning the default: likewise
    if (v == pk) { return REKHA_VAR_ONE; }
    if (v <= lo || v >= hi) { return 0 - 1; }           # at or past an edge: the WHOLE region is off
    if (v < pk) { return rekha_fx_div(v - lo, pk - lo); }
    return rekha_fx_div(hi - v, hi - pk);
}

fn rekha_var_region_scalar(font, rl, naxes, r): i64 {
    var buf = load64(font);
    var coords = load64(font + 312);
    var scalar = REKHA_VAR_ONE;
    var base = rl + 4 + r * naxes * 6;
    var a = 0;
    while (a < naxes) {
        var v = 0;
        if (a < load64(font + 280)) { v = load64(coords + a * 8); }
        var fct = rekha_var_axis_factor(v, rekha_rd_i16(buf, base + a * 6) * 4,
          rekha_rd_i16(buf, base + a * 6 + 2) * 4,
          rekha_rd_i16(buf, base + a * 6 + 4) * 4);
        if (fct < 0) { return 0; }
        if (fct != REKHA_VAR_ONE) { scalar = rekha_fx_mul(scalar, fct); }
        a = a + 1;
    }
    return scalar;
}

# Recompute one scalar per region of the variation store at `vstore`, into the font's scalar array.
# 1 on success, 0 when the store's region list does not validate — in which case the array is left
# empty and every blend falls back to its defaults.
# VariationRegionList: axisCount u16 · regionCount u16 · then regionCount x axisCount triples of
# (startCoord, peakCoord, endCoord), each F2Dot14.
fn rekha_var_build_scalars(font, vstore): i64 {
    store64(font + 328, 0);
    if (vstore == 0) { return 0; }
    var buf = load64(font);
    var end = load64(font + 304);
    if (vstore + 2 > end) { return 0; }
    var ivs = vstore + 2;
    var ivend = ivs + rekha_rd_u16(buf, vstore);
    if (ivend > end) { return 0; }
    if (ivs + 8 > ivend) { return 0; }
    if (rekha_rd_u16(buf, ivs) != 1) { return 0; }
    var rl = ivs + rekha_rd_u32(buf, ivs + 2);
    if (rl < ivs) { return 0; }
    if (rl + 4 > ivend) { return 0; }
    var naxes = rekha_rd_u16(buf, rl);
    var nreg = rekha_rd_u16(buf, rl + 2);
    if (nreg > REKHA_VAR_MAXREGION) { return 0; }
    if (naxes > REKHA_VAR_MAXAXES) { return 0; }
    if (rl + 4 + nreg * naxes * 6 > ivend) { return 0; }
    var arr = load64(font + 320);
    if (arr == 0) {
        arr = sd_alloc(REKHA_VAR_MAXREGION * 8);
        if (arr == 0) { return 0; }
        store64(font + 320, arr);
    }
    var r = 0;
    while (r < nreg) {
        store64(arr + r * 8, rekha_var_region_scalar(font, rl, naxes, r));
        r = r + 1;
    }
    store64(font + 328, nreg);
    return 1;
}

# ================================================================
# The public axis API
# ================================================================

# ================================================================
# Named instances — the styles a variable font ships with
# ================================================================
# ⭐ WHAT THESE ARE FOR. An axis is a continuum; a NAMED INSTANCE is a point on it the designer
# blessed and gave a name to — "Regular", "Bold", "Condensed Light". A font menu lists these, not
# axis values, and `rekha_var_set_instance` is the one call that turns a menu choice into a drawn
# font. Every coordinate is a USER value, the same units `rekha_var_set_axis` takes.
# ⚠ An instance record names its style through the `name` table (0.6.2): `rekha_name_utf8` on
# `rekha_var_instance_name_id` is the text.

# @public — how many named instances the font ships. 0 when there are none or the array is one
# rekha will not walk.
public fn rekha_var_instance_count(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 504);
}

# The absolute offset of instance `i`'s record, or 0.
fn rekha_var_inst_rec(font, i): i64 {
    if (font == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(font + 504)) { return 0; }
    return load64(font + 496) + i * load64(font + 512);
}

# @public — instance `i`'s subfamily name id, for `rekha_name_utf8`. 0 when there is no such
# instance.
public fn rekha_var_instance_name_id(font, i): i64 {
    var r = rekha_var_inst_rec(font, i);
    if (r == 0) { return 0; }
    return rekha_rd_u16(load64(font), r);
}

# @public — instance `i`'s PostScript name id, or 0 when the record does not carry one. ⚠ The
# field is OPTIONAL and its presence is told by instanceSize alone, which is why the resolver
# refuses any size but the two the spec allows.
public fn rekha_var_instance_ps_name_id(font, i): i64 {
    var r = rekha_var_inst_rec(font, i);
    if (r == 0) { return 0; }
    var n = load64(font + 280);
    if (load64(font + 512) != n * 4 + 6) { return 0; }
    return rekha_rd_u16(load64(font), r + 4 + n * 4);
}

# @public — instance `i`'s flags word (every bit reserved as of OpenType 1.9), or 0.
public fn rekha_var_instance_flags(font, i): i64 {
    var r = rekha_var_inst_rec(font, i);
    if (r == 0) { return 0; }
    return rekha_rd_u16(load64(font), r + 2);
}

# @public — instance `i`'s coordinate on axis `a`, in 16.16 USER units. 0 when either index is out
# of range. ⚠ 0 is a real coordinate on most axes, so check the counts first.
public fn rekha_var_instance_coord(font, i, a): i64 {
    var r = rekha_var_inst_rec(font, i);
    if (r == 0) { return 0; }
    if (a < 0 || a >= load64(font + 280)) { return 0; }
    var v = rekha_rd_u32(load64(font), r + 4 + a * 4);
    if (v >= 0x80000000) { v = v - 0x100000000; }
    return v;
}

# @public — put every axis at instance `i`'s coordinates, so the next rekha_load_glyph draws that
# style. Returns 1, or 0 when there is no such instance. ⛔ It sets EVERY axis, including the ones
# the instance leaves at their defaults: a named instance is a whole location, and applying half of
# one over a previous setting would draw a style the font does not ship.
public fn rekha_var_set_instance(font, i): i64 {
    var r = rekha_var_inst_rec(font, i);
    if (r == 0) { return 0; }
    var n = load64(font + 280);
    var a = 0;
    while (a < n) {
        if (rekha_var_set_axis(font, a, rekha_var_instance_coord(font, i, a)) == 0) { return 0; }
        a = a + 1;
    }
    return 1;
}

# @public — the normalized coordinate axis `i` currently sits at, in 16.16 (-1.0 .. 1.0). 0 (the
# default location) until rekha_var_set_axis or rekha_var_set_instance moves it.
public fn rekha_var_coord(font, i): i64 {
    if (font == 0) { return 0; }
    if (i < 0 || i >= load64(font + 280)) { return 0; }
    var c = load64(font + 312);
    if (c == 0) { return 0; }
    return load64(c + i * 8);
}

# @public — put axis `i` at `value` (16.16 USER units, the same scale fvar's min / default / max are
# in), normalize it, run it through avar, and rebuild the region scalars. 1 on success, 0 for a font
# with no axes, a bad index, or an allocation failure.
# ⚠ This changes what EVERY later rekha_load_glyph returns for this font. It is not cheap enough for
# a per-glyph call and not meant to be: set the axes once, then draw.
# ⚠ ALLOCATION: the coordinate and scalar arrays are allocated on the first call and reused after.
# rekha's seam has no free, so a font whose axes are set keeps them.
# ⭐ AND IT TELLS THE HINTING CONTEXT (v0.8.2): a cached rekha_hint_ctx is marked stale through
# rekha_hint_axes_changed, so the next rekha_hint_ctx — at the same ppem or another — re-runs
# `prep` for the new instance. A FORWARD call into src/hint.cyr, included after this module:
# its arity (one argument) is checked by hand, since the compiler cannot.
public fn rekha_var_set_axis(font, i, value): i64 {
    if (font == 0) { return 0; }
    var n = load64(font + 280);
    if (n < 1) { return 0; }
    if (i < 0 || i >= n) { return 0; }
    var c = load64(font + 312);
    if (c == 0) {
        c = sd_alloc(REKHA_VAR_MAXAXES * 8);
        if (c == 0) { return 0; }
        var z = 0;
        while (z < REKHA_VAR_MAXAXES) {
            store64(c + z * 8, 0);
            z = z + 1;
        }
        store64(font + 312, c);
    }
    var nc = rekha_var_normalize(rekha_var_axis_min(font, i), rekha_var_axis_default(font, i),
      rekha_var_axis_max(font, i), value);
    store64(c + i * 8, rekha_var_avar(font, i, nc));
    rekha_var_build_scalars(font, load64(font + 264));
    rekha_hint_axes_changed(font);
    return 1;
}

# 1 when any axis is off its default — i.e. when something might actually vary. Every apply path
# checks this first, so a font nobody has instanced pays one load.
fn rekha_var_live(font): i64 {
    if (font == 0) { return 0; }
    var n = load64(font + 280);
    if (n < 1) { return 0; }
    var c = load64(font + 312);
    if (c == 0) { return 0; }
    var i = 0;
    while (i < n) {
        if (load64(c + i * 8) != 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# @public — put every axis back at its default, which is the instance rekha decodes without this
# API at all. 1 when the font has axes. The hinting context is told, as rekha_var_set_axis tells it.
public fn rekha_var_reset(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 280) < 1) { return 0; }
    var c = load64(font + 312);
    if (c != 0) {
        var z = 0;
        while (z < REKHA_VAR_MAXAXES) {
            store64(c + z * 8, 0);
            z = z + 1;
        }
    }
    store64(font + 328, 0);
    rekha_hint_axes_changed(font);
    return 1;
}

# Resolve `fvar` and `avar` into the RekhaFont cache. Never fails an open: a font with no axes, or
# with an fvar rekha cannot read, is simply a font at one instance.
fn rekha_var_resolve(f): i64 {
    store64(f + 272, 0);
    store64(f + 280, 0);
    store64(f + 288, 0);
    store64(f + 296, 0);
    store64(f + 304, 0);
    store64(f + 312, 0);
    store64(f + 320, 0);
    store64(f + 328, 0);
    store64(f + 496, 0);
    store64(f + 504, 0);
    store64(f + 512, 0);
    store64(f + 304, load64(f + 8));                  # the whole file bounds every read below
    var buf = load64(f);
    var c: i64[1];
    var fvar = rekha_find_table_len(f, REKHA_TAG_FVAR, &c);
    if (fvar == 0) { return 0; }
    var fend = fvar + load64(&c);
    if (fvar + 16 > fend) { return 0; }
    if (rekha_rd_u16(buf, fvar) != 1) { return 0; }   # majorVersion 1
    var aoff = rekha_rd_u16(buf, fvar + 4);
    var n = rekha_rd_u16(buf, fvar + 8);
    var asz = rekha_rd_u16(buf, fvar + 10);
    if (n < 1) { return 0; }
    if (n > REKHA_VAR_MAXAXES) { return 0; }
    if (asz < 20) { return 0; }                       # a record rekha can read every field of
    if (fvar + aoff + n * asz > fend) { return 0; }
    store64(f + 272, fvar + aoff);
    store64(f + 280, n);
    store64(f + 288, asz);
    # ⭐ THE INSTANCE ARRAY FOLLOWS THE AXES, and nothing else says where it starts: its offset is
    # `axesArrayOffset + axisCount x axisSize` and there is no field for it. 0.6.3.
    # ⛔ instanceSize is what says whether a record carries a postScriptNameID. The spec allows
    # exactly two sizes — axisCount x 4 + 4 without it, + 6 with — and anything else is a record
    # rekha will not walk, because guessing the stride is guessing every coordinate after the
    # first. A bad instance array loses only the instances; the axes stay.
    var icnt = rekha_rd_u16(buf, fvar + 12);
    var isz = rekha_rd_u16(buf, fvar + 14);
    var iat = fvar + aoff + n * asz;
    if (icnt > 0 && icnt <= REKHA_VAR_MAXINST) {
        if (isz == n * 4 + 4 || isz == n * 4 + 6) {
            if (iat + icnt * isz <= fend) {
                store64(f + 496, iat);
                store64(f + 504, icnt);
                store64(f + 512, isz);
            }
        }
    }
    var avar = rekha_find_table_len(f, REKHA_TAG_AVAR, &c);
    if (avar != 0) {
        if (avar + 8 <= avar + load64(&c)) {
            var av = rekha_rd_u16(buf, avar);
            if (av == 1 || av == 2) { store64(f + 296, avar); }
        }
    }
    return 1;
}

# --- gvar.cyr ---

# gvar: TrueType outline variations (0.4.12).
#
# gvar.cyr — apply a variable font's glyph deltas to an outline glyf.cyr has just decoded, at the
# axis settings src/var.cyr holds. 0.4.11 gave CFF2 outlines this; `gvar` is the same idea over a
# completely different delta format, which is why it is its own module and its own release.
#
# ⛔ WHAT MAKES gvar DIFFERENT FROM CFF2's `blend`. A CFF2 charstring carries its deltas inline, one
# group per blended number, and every value it blends is named. A gvar tuple carries them OUT of
# line, PACKED, and may name only SOME of a glyph's points — the rest are inferred by interpolating
# between their touched neighbours around the contour (IUP). So the work here is three decoders and
# an interpolation, where CFF2's was a weighted sum.
#
# gvar header: majorVersion u16 (1) · minorVersion u16 · axisCount u16 · sharedTupleCount u16 ·
#   sharedTuplesOffset u32 · glyphCount u16 · flags u16 (bit 0: 32-bit offsets) ·
#   glyphVariationDataArrayOffset u32 · glyphVariationDataOffsets[glyphCount + 1].
#   ⚠ A 16-bit offset is stored HALVED, so it is doubled on the way in.
# GlyphVariationData: tupleVariationCount u16 (bits 0-11 the count, 0x8000 SHARED_POINT_NUMBERS) ·
#   dataOffset u16 · that many TupleVariationHeaders · then the serialized data.
# TupleVariationHeader: variationDataSize u16 · tupleIndex u16 (bits 0-11 a shtup-tuple index,
#   0x8000 EMBEDDED_PEAK_TUPLE, 0x4000 INTERMEDIATE_REGION, 0x2000 PRIVATE_POINT_NUMBERS) · then the
#   embedded peak and intermediate tuples the flags call for, each axisCount F2Dot14.
#
# ⚠ EVERY GLYPH HAS FOUR PHANTOM POINTS past its real ones — the two side bearings and the two
# vertical ones — and a tuple's deltas cover them too. rekha decodes them (a tuple that names them
# must still be read to the end); `rekha_gvar_apply` applies only the real points, because phantom
# deltas are METRICS variations and the unhinted advance readers carry `HVAR` / `MVAR` instead.
# `rekha_gvar_apply_n` lets a caller whose arrays hold the four phantoms too — the hinted loader in
# src/hint.cyr, which fills the glyph zone with n + 4 points — take the last four deltas as well,
# the way FreeType's TT_Vary_Apply_Glyph_Deltas varies all n + 4 (ref2143/ttgxvar.c:4255); that
# caller decides per FreeType's own rule which of them stand (none of pp1 / pp2 on a face with
# HVAR, none of pp3 / pp4 with VVAR, ref2143/ttgxvar.c:4671-4684).
#
# ⛔ WHAT IS REFUSED — and a refusal here leaves the outline at its DEFAULT, never half-varied:
#   - a major version other than 1, or a header, offset array or data slice outside the table;
#   - a glyph whose variation data claims more points than the glyph has (+ 4 phantom);
#   - a packed point-number or delta run that would read past its tuple's declared size;
#   - a shtup-tuple index past sharedTupleCount.

var REKHA_TAG_GVAR = 0x67766172;   # 'gvar'
# Tuples applied to one glyph. The format allows 4,095; no real font is near it, and the cap bounds
# the work one rekha_load_glyph can be made to do.
var REKHA_GVAR_MAXTUPLE = 512;

# ================================================================
# The two packed formats
# ================================================================

# Packed point numbers (OpenType "Packed Point Numbers"). Writes the indices to `out` and their
# count to `cnt_out`; a count of 0 in the font means ALL points, which is passed on as -1 because it
# is a different thing from naming none. Returns the offset past the data, or 0 - 1.
fn rekha_gvar_points(buf, p, end, out, maxpts, cnt_out): i64 {
    store64(cnt_out, 0);
    if (p >= end) { return 0 - 1; }
    var n = load8(buf + p);
    p = p + 1;
    if ((n & 128) != 0) {
        if (p >= end) { return 0 - 1; }
        n = ((n & 127) << 8) | load8(buf + p);
        p = p + 1;
    }
    if (n == 0) {
        store64(cnt_out, 0 - 1);
        return p;
    }
    if (n > maxpts) { return 0 - 1; }
    var got = 0;
    var acc = 0;
    while (got < n) {
        if (p >= end) { return 0 - 1; }
        var ctl = load8(buf + p);
        p = p + 1;
        var run = (ctl & 127) + 1;
        if (got + run > n) { run = n - got; }
        var words = ctl & 128;
        var k = 0;
        while (k < run) {
            if (words != 0) {
                if (p + 2 > end) { return 0 - 1; }
                acc = acc + rekha_rd_u16(buf, p);
                p = p + 2;
            } else {
                if (p >= end) { return 0 - 1; }
                acc = acc + load8(buf + p);
                p = p + 1;
            }
            if (acc >= maxpts) { return 0 - 1; }
            store64(out + got * 8, acc);
            got = got + 1;
            k = k + 1;
        }
    }
    store64(cnt_out, n);
    return p;
}

# Packed deltas: `n` signed values into `out`. A run's control byte has 0x80 DELTAS_ARE_ZERO (no
# data bytes at all) and 0x40 DELTAS_ARE_WORDS; the low six bits plus one are the run length.
# Returns the offset past the data, or 0 - 1.
fn rekha_gvar_deltas(buf, p, end, out, n): i64 {
    var got = 0;
    while (got < n) {
        if (p >= end) { return 0 - 1; }
        var ctl = load8(buf + p);
        p = p + 1;
        var run = (ctl & 63) + 1;
        if (got + run > n) { run = n - got; }
        var k = 0;
        if ((ctl & 128) != 0) {
            while (k < run) {
                store64(out + got * 8, 0);
                got = got + 1;
                k = k + 1;
            }
        } else {
            while (k < run) {
                if ((ctl & 64) != 0) {
                    if (p + 2 > end) { return 0 - 1; }
                    store64(out + got * 8, rekha_rd_i16(buf, p));
                    p = p + 2;
                } else {
                    if (p >= end) { return 0 - 1; }
                    store64(out + got * 8, rekha_rd_i8(buf, p));
                    p = p + 1;
                }
                got = got + 1;
                k = k + 1;
            }
        }
    }
    return p;
}

# ================================================================
# IUP — inferring the points a tuple did not name
# ================================================================

# One coordinate of one untouched point, given its nearest touched neighbours `a` (before) and `b`
# (after) in contour order. `c*` are the DEFAULT coordinates, `d*` the deltas already decided.
# ⛔ The equal-coordinate case is not a degenerate rounding worry, it is a rule: when the two
# neighbours sit at the same coordinate the point cannot be placed between them, so it takes their
# shtup delta if they agree and NOTHING if they disagree.
fn rekha_gvar_iup1(cp, ca, cb, da, db): i64 {
    if (ca == cb) {
        if (da == db) { return da; }
        return 0;
    }
    var lo = ca;
    var hi = cb;
    var dlo = da;
    var dhi = db;
    if (ca > cb) {
        lo = cb;
        hi = ca;
        dlo = db;
        dhi = da;
    }
    if (cp <= lo) { return dlo; }
    if (cp >= hi) { return dhi; }
    return dlo + rekha_fx_mul(dhi - dlo, rekha_fx_div((cp - lo) << 16, (hi - lo) << 16));
}

# Fill in the untouched points of one contour [first, last]. `tch` is one byte per point.
fn rekha_gvar_iup_contour(xs, ys, dx, dy, tch, first, last): i64 {
    var n = last - first + 1;
    if (n < 1) { return 0; }
    # the first touched point of the contour, if any
    var t0 = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(tch + first + i) != 0) {
            t0 = i;
            i = n;
        }
        i = i + 1;
    }
    # ⚠ A contour no tuple touched keeps its zero deltas — NOT the deltas of some other contour.
    if (t0 < 0) { return 0; }
    var a = t0;
    var seen = 0;
    while (seen < n) {
        var b = a + 1;
        if (b >= n) { b = 0; }
        var span = 0;
        while (load8(tch + first + b) == 0) {
            b = b + 1;
            if (b >= n) { b = 0; }
            span = span + 1;
            if (span > n) { return 0; }
        }
        # everything strictly between a and b, going forward and wrapping
        var k = a + 1;
        if (k >= n) { k = 0; }
        while (k != b) {
            var pi = first + k;
            var ai = first + a;
            var bi = first + b;
            store64(dx + pi * 8, rekha_gvar_iup1(load64(xs + pi * 8), load64(xs + ai * 8),
                load64(xs + bi * 8), load64(dx + ai * 8),
                load64(dx + bi * 8)));
            store64(dy + pi * 8, rekha_gvar_iup1(load64(ys + pi * 8), load64(ys + ai * 8),
                load64(ys + bi * 8), load64(dy + ai * 8),
                load64(dy + bi * 8)));
            k = k + 1;
            if (k >= n) { k = 0; }
            seen = seen + 1;
        }
        seen = seen + 1;
        a = b;
        if (a == t0) { seen = n; }
    }
    return 0;
}

# ================================================================
# The tuple walk
# ================================================================

# The scalar of one tuple, given its peak and (when INTERMEDIATE_REGION says so) its start and end,
# each an array of axisCount F2Dot14 at the offsets given. 16.16; 0 means the tuple contributes
# nothing and its data can be skipped unread.
# ⚠ Without an intermediate region the tent is (min(peak, 0), peak, max(peak, 0)) — the shape every
# other implementation derives, and the reason a tuple peaking at +1 ramps linearly from 0.
fn rekha_gvar_scalar(font, naxes, pk, st, en): i64 {
    var buf = load64(font);
    var coords = load64(font + 312);
    var scalar = REKHA_VAR_ONE;
    var a = 0;
    while (a < naxes) {
        var peak = rekha_rd_i16(buf, pk + a * 2) * 4;
        var lo = peak;
        var hi = peak;
        if (lo > 0) { lo = 0; }
        if (hi < 0) { hi = 0; }
        if (st != 0) {
            lo = rekha_rd_i16(buf, st + a * 2) * 4;
            hi = rekha_rd_i16(buf, en + a * 2) * 4;
        }
        var v = 0;
        if (a < load64(font + 280)) { v = load64(coords + a * 8); }
        var fct = rekha_var_axis_factor(v, lo, peak, hi);
        if (fct < 0) { return 0; }
        if (fct != REKHA_VAR_ONE) { scalar = rekha_fx_mul(scalar, fct); }
        a = a + 1;
    }
    return scalar;
}

# The scratch one glyph's variation needs, allocated once per font and reused. Laid out in units of
# REKHA_GVAR_SCRATCH: dx at 0, dy at 8, the shared point list at 16, one TOUCHED BYTE per point at
# 24, a private point list at 25, and the raw x / y delta runs at 33 and 41 — 49 units in all.
var REKHA_GVAR_SCRATCH = 4100;      # REKHA_COMPOSITE_MAXP + 4 phantom points

fn rekha_gvar_scratch(font): i64 {
    var sc = load64(font + 344);
    if (sc != 0) { return sc; }
    sc = sd_alloc(REKHA_GVAR_SCRATCH * 49);
    if (sc == 0) { return 0; }
    store64(font + 344, sc);
    return sc;
}

# Apply `gvar` to a glyph whose points glyf.cyr has already decoded into xs / ys, with `nc` contours
# ending at `eps`. Returns 1 when the outline was varied, 0 when it was left exactly as it was —
# which covers "no gvar", "no axes set", "this glyph has no variation data" and every refusal.
# ⛔ A refusal never half-varies: the deltas of a tuple are accumulated and only added to xs / ys
# once that tuple has been read in full.
fn rekha_gvar_apply(font, gid, xs, ys, np, nc, eps): i64 {
    return rekha_gvar_apply_n(font, gid, xs, ys, np, nc, eps, np);
}

# The same, adding the deltas to the first `napply` of the np + 4 points a tuple covers: np for
# the outline alone (rekha_gvar_apply), np + 4 when xs / ys carry the four phantom points after the
# outline and the caller wants their deltas too. Interpolation stays on the np real points of the
# nc contours; a phantom point is in no contour and only an explicitly named delta reaches it.
fn rekha_gvar_apply_n(font, gid, xs, ys, np, nc, eps, napply): i64 {
    if (rekha_var_live(font) == 0) { return 0; }
    var gvar = load64(font + 336);
    if (gvar == 0) { return 0; }
    var buf = load64(font);
    var end = load64(font + 352);
    if (gvar + 20 > end) { return 0; }
    if (rekha_rd_u16(buf, gvar) != 1) { return 0; }
    var naxes = rekha_rd_u16(buf, gvar + 4);
    if (naxes < 1 || naxes > REKHA_VAR_MAXAXES) { return 0; }
    var nshared = rekha_rd_u16(buf, gvar + 6);
    var shtup = gvar + rekha_rd_u32(buf, gvar + 8);
    var ngl = rekha_rd_u16(buf, gvar + 12);
    var longoff = rekha_rd_u16(buf, gvar + 14) & 1;
    var darray = gvar + rekha_rd_u32(buf, gvar + 16);
    if (gid < 0 || gid >= ngl) { return 0; }
    var o0 = 0;
    var o1 = 0;
    if (longoff != 0) {
        if (gvar + 20 + (ngl + 1) * 4 > end) { return 0; }
        o0 = rekha_rd_u32(buf, gvar + 20 + gid * 4);
        o1 = rekha_rd_u32(buf, gvar + 20 + gid * 4 + 4);
    } else {
        if (gvar + 20 + (ngl + 1) * 2 > end) { return 0; }
        o0 = rekha_rd_u16(buf, gvar + 20 + gid * 2) * 2;
        o1 = rekha_rd_u16(buf, gvar + 20 + gid * 2 + 2) * 2;
    }
    if (o1 <= o0) { return 0; }                          # this glyph simply does not vary
    var gs = darray + o0;
    var ge = darray + o1;
    if (ge > end || gs < darray) { return 0; }
    if (gs + 4 > ge) { return 0; }
    if (nshared > 0) {
        if (shtup + nshared * naxes * 2 > end) { return 0; }
    }

    var tvc = rekha_rd_u16(buf, gs);
    var ntup = tvc & 4095;
    if (ntup < 1 || ntup > REKHA_GVAR_MAXTUPLE) { return 0; }
    var dstart = gs + rekha_rd_u16(buf, gs + 2);
    if (dstart > ge || dstart < gs) { return 0; }

    var total = np + 4;                                  # the four phantom points ride along
    if (total > REKHA_GVAR_SCRATCH) { return 0; }
    if (napply > total) { napply = total; }
    var sc = rekha_gvar_scratch(font);
    if (sc == 0) { return 0; }
    var dx = sc;
    var dy = sc + REKHA_GVAR_SCRATCH * 8;
    var pts = sc + REKHA_GVAR_SCRATCH * 16;
    var tch = sc + REKHA_GVAR_SCRATCH * 24;

    # shtup point numbers, when the glyph declares them, come first in the serialized data
    var sp = dstart;
    var scnt: i64[1];
    # ⛔ -1 IS "ALL POINTS", and it is the right DEFAULT, not just what an explicit count of 0
    # decodes to. A tuple with no private point numbers falls back to the glyph's shared ones; when
    # the glyph declares none either, the spec says the tuple provides deltas for every point.
    # Starting this at 0 instead means "names nothing", and every such tuple silently does nothing.
    store64(&scnt, 0 - 1);
    var shpts = sc + REKHA_GVAR_SCRATCH * 25;            # only read when a tuple is private
    if ((tvc & 32768) != 0) {
        sp = rekha_gvar_points(buf, sp, ge, pts, total, &scnt);
        if (sp < 0) { return 0; }
    }
    var shared_cnt = load64(&scnt);
    var shared_at = sp;                                  # where the per-tuple data begins

    var hdr = gs + 4;
    var data = sp;
    var varied = 0;
    var t = 0;
    while (t < ntup) {
        if (hdr + 4 > ge) { return 0; }
        var dsize = rekha_rd_u16(buf, hdr);
        var tidx = rekha_rd_u16(buf, hdr + 2);
        hdr = hdr + 4;
        var pk = 0;
        if ((tidx & 32768) != 0) {                       # EMBEDDED_PEAK_TUPLE
            pk = hdr;
            hdr = hdr + naxes * 2;
        } else {
            var si = tidx & 4095;
            if (si >= nshared) { return 0; }
            pk = shtup + si * naxes * 2;
        }
        var st = 0;
        var en = 0;
        if ((tidx & 16384) != 0) {                       # INTERMEDIATE_REGION
            st = hdr;
            en = hdr + naxes * 2;
            hdr = hdr + naxes * 4;
        }
        if (hdr > ge) { return 0; }
        var dend = data + dsize;
        if (dend > ge) { return 0; }

        var scalar = rekha_gvar_scalar(font, naxes, pk, st, en);
        if (scalar != 0) {
            var q = data;
            var cnt = shared_cnt;
            var plist = pts;
            if ((tidx & 8192) != 0) {                    # PRIVATE_POINT_NUMBERS
                q = rekha_gvar_points(buf, q, dend, shpts, total, &scnt);
                if (q < 0) { return 0; }
                cnt = load64(&scnt);
                plist = shpts;
            }
            var npd = cnt;
            if (cnt < 0) { npd = total; }                # a count of 0 meant ALL points
            if (npd > total) { return 0; }
            var i = 0;
            while (i < total) {
                store64(dx + i * 8, 0);
                store64(dy + i * 8, 0);
                store8(tch + i, 0);
                i = i + 1;
            }
            # the x deltas, then the y deltas, both `npd` long
            var xd = sc + REKHA_GVAR_SCRATCH * 33;
            var yd = sc + REKHA_GVAR_SCRATCH * 41;
            q = rekha_gvar_deltas(buf, q, dend, xd, npd);
            if (q < 0) { return 0; }
            q = rekha_gvar_deltas(buf, q, dend, yd, npd);
            if (q < 0) { return 0; }
            i = 0;
            while (i < npd) {
                var pi = i;
                if (cnt >= 0) { pi = load64(plist + i * 8); }
                if (pi < total) {
                    store64(dx + pi * 8, load64(xd + i * 8));
                    store64(dy + pi * 8, load64(yd + i * 8));
                    store8(tch + pi, 1);
                }
                i = i + 1;
            }
            # ⭐ IUP, per contour and per tuple: a tuple that named only some points has the rest
            # inferred BEFORE its deltas are scaled in, not after the tuples are summed.
            if (cnt >= 0) {
                var first = 0;
                var ci = 0;
                while (ci < nc) {
                    var last = load64(eps + ci * 8);
                    if (last >= np) { last = np - 1; }
                    rekha_gvar_iup_contour(xs, ys, dx, dy, tch, first, last);
                    first = last + 1;
                    ci = ci + 1;
                }
            }
            i = 0;
            while (i < napply) {
                var ddx = load64(dx + i * 8);
                var ddy = load64(dy + i * 8);
                if (ddx != 0) {
                    store64(xs + i * 8, load64(xs + i * 8) + sd_asr(ddx * scalar + 32768, 16));
                }
                if (ddy != 0) {
                    store64(ys + i * 8, load64(ys + i * 8) + sd_asr(ddy * scalar + 32768, 16));
                }
                i = i + 1;
            }
            varied = 1;
        }
        data = dend;
        t = t + 1;
    }
    return varied;
}

# Resolve `gvar` into the RekhaFont cache. Never fails an open.
fn rekha_gvar_resolve(f): i64 {
    store64(f + 336, 0);
    store64(f + 344, 0);
    store64(f + 352, load64(f + 8));
    var c: i64[1];
    var g = rekha_find_table_len(f, REKHA_TAG_GVAR, &c);
    if (g == 0) { return 0; }
    if (load64(&c) < 20) { return 0; }
    store64(f + 336, g);
    store64(f + 352, load64(f + 8));
    return 1;
}

# --- hvar.cyr ---

# HVAR and MVAR: metrics variations (0.6.0).
#
# hvar.cyr — the other half of a variable font. 0.4.11 and 0.4.12 made a glyph's OUTLINE follow the
# axes, for CFF2 and for TrueType; its ADVANCE did not move, because `rekha_advance_width` reads
# `hmtx` in design units and consulted no variation store. This is that store:
#
#   HVAR — per-glyph advance widths (and side bearings). An ItemVariationStore plus up to three
#          DeltaSetIndexMaps, one per metric. rekha reads the ADVANCE map.
#   MVAR — font-wide metrics, one ValueRecord per four-byte tag. rekha reads the three the line box
#          is made of: `hasc`, `hdsc`, `hlgp` — hhea's ascender, descender and lineGap.
#
# ⭐ THE REGION MACHINERY IS var.cyr's, UNCHANGED. `rekha_var_region_scalar` already turns a region
# of a variation store into one 16.16 scalar at the current axis setting; everything here is the
# OTHER half — finding the right delta row and summing it. That is why this module is small.
# ⚠ The scalars are computed ON DEMAND rather than cached the way CFF2's are (`font + 320`). A
# CFF2 blend touches its store once per blended value in every charstring; an advance query touches
# one row, so caching a whole array per store would cost more than it saves and would need a second
# allocation at open. MEASURED cost when no axis is set: one load and a compare — `rekha_var_live`
# is checked first, and an unvaried font never reaches the store at all.
#
# ItemVariationStore (shared by HVAR, MVAR, CFF2 and gvar's cousin):
#   format u16 (= 1) · variationRegionListOffset u32 · itemVariationDataCount u16 ·
#   itemVariationDataOffsets u32[count]     — every offset from the STORE's start
# ItemVariationData: itemCount u16 · wordDeltaCount u16 · regionIndexCount u16 ·
#   regionIndexes u16[regionIndexCount] · then itemCount delta rows.
#   ⛔ wordDeltaCount's bit 15 is LONG_WORDS: the first `count & 0x7FFF` deltas are 4 bytes and the
#   rest 2, instead of 2 and 1. Reading a long row as a short one silently yields other numbers.
# DeltaSetIndexMap: format u8 (0 = u16 mapCount, 1 = u32) · entryFormat u8 · mapCount · entries.
#   entryFormat bits 0-3 are (inner bit count - 1), bits 4-5 are (entry size - 1), 6-7 reserved.
#
# ⛔ WHAT IS REFUSED, and a refusal here leaves the metric at its DEFAULT — never half-varied:
#   - a major version other than 1, or a header, store, map or delta row outside the table;
#   - a region index past the region list, an outer index past itemVariationDataCount, an inner
#     index past itemCount, or wordDeltaCount > regionIndexCount;
#   - a DeltaSetIndexMap with a reserved entryFormat bit set, or mapCount 0;
#   - an MVAR valueRecordSize below 8, or a record array past the table.
# ⚠ HVAR's rsb map is validated for position and NOT read: rekha publishes no right-side-bearing
# accessor for it to vary. The lsb map IS read since v0.8.2, by `rekha_hvar_lsb_delta` for
# `rekha_left_side_bearing` (src/sfnt.cyr) only: the hinted loader's left phantom point keeps the
# UNVARIED lsb, as FreeType's TrueType driver does (ref2143/ttdriver.c leaves lsb_adjust unset).

var REKHA_TAG_HVAR = 0x48564152;   # 'HVAR'
var REKHA_TAG_MVAR = 0x4D564152;   # 'MVAR'
# ⛔ THE TAGS TARGET OS/2, NOT hhea, AND 0.6.0 HAD THIS WRONG. `hasc` / `hdsc` / `hlgp` are
# OS/2.sTypoAscender / sTypoDescender / sTypoLineGap; MVAR has NO tag for hhea's ascender,
# descender or lineGap — only for its three CARET fields. 0.6.0 added the deltas to hhea, and the
# differential did not catch it because the fixture set OS/2's sTypo values EQUAL to hhea's, which
# is also the case fontTools' own `verticalMetricsKeptInSync` heuristic papers over. 0.6.1 reads
# OS/2 (src/os2.cyr) and puts every delta on the field the spec names.
# ⚠ rekha does NOT copy fontTools' sync heuristic. fontTools propagates an OS/2 sTypo change back
# to hhea when the two started equal, "because it is common in fonts to have the hhea metrics be
# equal for compat reasons". That is a guess about intent, and rekha reports what the tables say:
# hhea has no MVAR tag, so `rekha_ascender` does not move. A consumer that wants the varying line
# box reads the typo metrics, which is what `rekha_use_typo_metrics` exists to tell it.
# Every tag rekha has no reader for is SKIPPED, not refused: MVAR is a bag of metrics and most of
# them belong to tables rekha still does not read.
var REKHA_MVAR_HASC = 0x68617363;  # 'hasc' — OS/2.sTypoAscender
var REKHA_MVAR_HDSC = 0x68647363;  # 'hdsc' — OS/2.sTypoDescender
var REKHA_MVAR_HLGP = 0x686C6770;  # 'hlgp' — OS/2.sTypoLineGap
var REKHA_MVAR_HCLA = 0x68636C61;  # 'hcla' — OS/2.usWinAscent
var REKHA_MVAR_HCLD = 0x68636C64;  # 'hcld' — OS/2.usWinDescent
var REKHA_MVAR_XHGT = 0x78686774;  # 'xhgt' — OS/2.sxHeight
var REKHA_MVAR_CPHT = 0x63706874;  # 'cpht' — OS/2.sCapHeight
var REKHA_MVAR_STRS = 0x73747273;  # 'strs' — OS/2.yStrikeoutSize
var REKHA_MVAR_STRO = 0x7374726F;  # 'stro' — OS/2.yStrikeoutPosition
var REKHA_MVAR_SBXS = 0x73627873;  # 'sbxs' — OS/2.ySubscriptXSize
var REKHA_MVAR_SBYS = 0x73627973;  # 'sbys' — OS/2.ySubscriptYSize
var REKHA_MVAR_SBXO = 0x7362786F;  # 'sbxo' — OS/2.ySubscriptXOffset
var REKHA_MVAR_SBYO = 0x7362796F;  # 'sbyo' — OS/2.ySubscriptYOffset
var REKHA_MVAR_SPXS = 0x73707873;  # 'spxs' — OS/2.ySuperscriptXSize
var REKHA_MVAR_SPYS = 0x73707973;  # 'spys' — OS/2.ySuperscriptYSize
var REKHA_MVAR_SPXO = 0x7370786F;  # 'spxo' — OS/2.ySuperscriptXOffset
var REKHA_MVAR_SPYO = 0x7370796F;  # 'spyo' — OS/2.ySuperscriptYOffset
var REKHA_MVAR_HCRS = 0x68637273;  # 'hcrs' — hhea.caretSlopeRise
var REKHA_MVAR_HCRN = 0x6863726E;  # 'hcrn' — hhea.caretSlopeRun
var REKHA_MVAR_HCOF = 0x68636F66;  # 'hcof' — hhea.caretOffset
# ⛔ HOW FAR A METRIC MAY MOVE, in design units. Nothing in the format bounds a delta: LONG_WORDS
# makes each one a signed 32-bit value, and regionIndexCount is a u16, so a crafted store can ask
# for a delta of 2^31 x 65535 — which both overflows the 16.16 accumulator and, short of that,
# hands a consumer an advance of 10^12 to lay text out with. A real delta is a fraction of an em.
# ⭐ FOUND BY programs/hvar_test.cyr's bit-flip sweep, which flipped LONG_WORDS on and got an
# advance of 8.8e12 back. Exceeding this refuses, so the metric stays at its default.
var REKHA_VAR_MAXDELTA = 1048576;             # 1 << 20 design units
var REKHA_VAR_MAXACC   = 68719476736;         # the same, in 16.16 — the accumulator's ceiling

# One delta from the ItemVariationStore at `ivs` (bounded by `ivend`), for item (outer, inner),
# summed over every region at the current axis setting and rounded HALF UP once — as fontTools'
# otRound does, and as every other rounding in rekha does. Returns 1 with the delta in `out`
# (design units, not 16.16), or 0 when anything about the store refuses.
fn rekha_ivs_delta(font, ivs, ivend, outer, inner, out): i64 {
    store64(out, 0);
    var buf = load64(font);
    if (ivs + 8 > ivend) { return 0; }
    if (rekha_rd_u16(buf, ivs) != 1) { return 0; }
    var rl = ivs + rekha_rd_u32(buf, ivs + 2);
    if (rl < ivs) { return 0; }
    if (rl + 4 > ivend) { return 0; }
    var naxes = rekha_rd_u16(buf, rl);
    var nreg = rekha_rd_u16(buf, rl + 2);
    if (naxes > REKHA_VAR_MAXAXES) { return 0; }
    if (nreg > REKHA_VAR_MAXREGION) { return 0; }
    if (rl + 4 + nreg * naxes * 6 > ivend) { return 0; }

    var ndata = rekha_rd_u16(buf, ivs + 6);
    if (outer < 0 || outer >= ndata) { return 0; }
    if (ivs + 8 + ndata * 4 > ivend) { return 0; }
    var ivd = ivs + rekha_rd_u32(buf, ivs + 8 + outer * 4);
    if (ivd < ivs) { return 0; }
    if (ivd + 6 > ivend) { return 0; }
    var icount = rekha_rd_u16(buf, ivd);
    var wdc = rekha_rd_u16(buf, ivd + 2);
    var ric = rekha_rd_u16(buf, ivd + 4);
    if (ivd + 6 + ric * 2 > ivend) { return 0; }
    if (inner < 0 || inner >= icount) { return 0; }

    var word = wdc & 32767;
    if (word > ric) { return 0; }
    var wsz = 2;
    var ssz = 1;
    if ((wdc & 32768) != 0) {
        wsz = 4;
        ssz = 2;
    }
    var rowlen = word * wsz + (ric - word) * ssz;
    var rows = ivd + 6 + ric * 2;
    if (rows + icount * rowlen > ivend) { return 0; }
    var row = rows + inner * rowlen;

    var acc = 0;
    var i = 0;
    while (i < ric) {
        var ri = rekha_rd_u16(buf, ivd + 6 + i * 2);
        if (ri >= nreg) { return 0; }
        var sc = rekha_var_region_scalar(font, rl, naxes, ri);
        if (sc != 0) {
            var d = 0;
            if (i < word) {
                if (wsz == 2) {
                    d = rekha_rd_i16(buf, row + i * 2);
                } else {
                    d = rekha_rd_u32(buf, row + i * 4);
                    if (d >= 0x80000000) { d = d - 0x100000000; }
                }
            } else {
                var at = row + word * wsz + (i - word) * ssz;
                if (ssz == 1) {
                    d = load8(buf + at);
                    if (d > 127) { d = d - 256; }
                } else {
                    d = rekha_rd_i16(buf, at);
                }
            }
            acc = acc + d * sc;
            # ⛔ CHECKED EVERY ITERATION, not once at the end: the point is to refuse BEFORE the
            # accumulator can wrap, and one region's contribution can be 2^31 x 65536 on its own.
            if (acc > REKHA_VAR_MAXACC || acc < 0 - REKHA_VAR_MAXACC) { return 0; }
        }
        i = i + 1;
    }
    var v = sd_asr(acc + 32768, 16);
    if (v > REKHA_VAR_MAXDELTA || v < 0 - REKHA_VAR_MAXDELTA) { return 0; }
    store64(out, v);
    return 1;
}

# A DeltaSetIndexMap lookup: `idx` -> out[0] = outer, out[1] = inner. Returns 1, or 0 on refusal.
# ⛔ An index past mapCount takes the LAST entry, which is the spec's rule and not a clamp of
# convenience: a font maps its first N glyphs explicitly and lets every later one share the tail.
fn rekha_dsim(font, map, end, idx, out): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    var buf = load64(font);
    if (map + 4 > end) { return 0; }
    var fmt = load8(buf + map);
    var ef = load8(buf + map + 1);
    if ((ef & 192) != 0) { return 0; }                   # reserved bits 6-7
    var hdr = 4;
    var n = 0;
    if (fmt == 0) {
        n = rekha_rd_u16(buf, map + 2);
    } else {
        if (fmt != 1) { return 0; }
        hdr = 6;
        if (map + 6 > end) { return 0; }
        n = rekha_rd_u32(buf, map + 2);
    }
    if (n < 1) { return 0; }
    var esz = ((ef >> 4) & 3) + 1;
    var ibits = (ef & 15) + 1;
    if (map + hdr + n * esz > end) { return 0; }
    var k = idx;
    if (k < 0) { return 0; }
    if (k >= n) { k = n - 1; }
    var at = map + hdr + k * esz;
    var v = 0;
    var i = 0;
    while (i < esz) {
        v = v * 256 + load8(buf + at + i);
        i = i + 1;
    }
    store64(out, v >> ibits);
    store64(out + 8, v & ((1 << ibits) - 1));
    return 1;
}

# Cache HVAR and MVAR at open. Both are validated for version and header extent only; everything
# below them is bounds-checked at the point of use, because a metric query reads one row and not
# the table.
fn rekha_hvar_resolve(f): i64 {
    store64(f + 416, 0);
    store64(f + 424, 0);
    store64(f + 432, 0);
    store64(f + 440, 0);
    var buf = load64(f);
    var c: i64[1];
    var hv = rekha_find_table_len(f, REKHA_TAG_HVAR, &c);
    if (hv != 0) {
        if (load64(&c) >= 20) {
            if (rekha_rd_u16(buf, hv) == 1) {
                store64(f + 416, hv);
                store64(f + 424, hv + load64(&c));
            }
        }
    }
    var mv = rekha_find_table_len(f, REKHA_TAG_MVAR, &c);
    if (mv != 0) {
        if (load64(&c) >= 12) {
            if (rekha_rd_u16(buf, mv) == 1) {
                store64(f + 432, mv);
                store64(f + 440, mv + load64(&c));
            }
        }
    }
    return 0;
}

# @public — how much `gid`'s advance width moves at the current axis setting, in design units.
# 0 when the font has no HVAR, when no axis is set, or when the table refuses — in which case the
# advance is its default, which is the right answer and not a guess.
public fn rekha_hvar_advance_delta(font, gid): i64 {
    if (font == 0) { return 0; }
    if (gid < 0) { return 0; }
    var hv = load64(font + 416);
    if (hv == 0) { return 0; }
    if (rekha_var_live(font) == 0) { return 0; }
    var buf = load64(font);
    var hvend = load64(font + 424);
    var ivs = hv + rekha_rd_u32(buf, hv + 4);
    if (ivs < hv) { return 0; }
    var pair: i64[2];
    store64(&pair, 0);
    store64(&pair + 8, gid);
    var mo = rekha_rd_u32(buf, hv + 8);
    if (mo != 0) {
        if (rekha_dsim(font, hv + mo, hvend, gid, &pair) == 0) { return 0; }
    }
    var d: i64[1];
    if (rekha_ivs_delta(font, ivs, hvend, load64(&pair), load64(&pair + 8), &d) == 0) { return 0; }
    return load64(&d);
}

# @public — how much `gid`'s left side bearing moves at the current axis setting, in design units:
# the twin of rekha_hvar_advance_delta over the lsb map at +12. ⛔ THE TWO MAPS DEFAULT DIFFERENTLY,
# and the spec says so: an absent advance map means "the glyph id is the inner index", an absent lsb
# map means "no lsb variation data at all" — so a NULL lsb map answers 0, never an implicit row.
# 0 likewise when the font has no HVAR, no axis is set, or the table refuses.
# ⚠ FreeType 2.14.3's TrueType driver leaves its lsb_adjust hook NULL (ref2143/ttdriver.c:559) and
# takes the lsb of a variation instance from `hmtx` unadjusted; rekha_left_side_bearing applies
# this delta, which is the reading `rekha_advance_width` froze for the advance map, while the
# HINTED loader's left phantom follows FreeType and leaves it out (src/hint.cyr
# rekha_hint_hmetrics). Pinned in docs/development/roadmap.md.
public fn rekha_hvar_lsb_delta(font, gid): i64 {
    if (font == 0) { return 0; }
    if (gid < 0) { return 0; }
    var hv = load64(font + 416);
    if (hv == 0) { return 0; }
    if (rekha_var_live(font) == 0) { return 0; }
    var buf = load64(font);
    var hvend = load64(font + 424);
    var ivs = hv + rekha_rd_u32(buf, hv + 4);
    if (ivs < hv) { return 0; }
    var mo = rekha_rd_u32(buf, hv + 12);
    if (mo == 0) { return 0; }
    var pair: i64[2];
    if (rekha_dsim(font, hv + mo, hvend, gid, &pair) == 0) { return 0; }
    var d: i64[1];
    if (rekha_ivs_delta(font, ivs, hvend, load64(&pair), load64(&pair + 8), &d) == 0) { return 0; }
    return load64(&d);
}

# @public — how much the font-wide metric `tag` moves at the current axis setting, in design units.
# 0 when there is no MVAR, no axis is set, the tag is absent, or the table refuses.
public fn rekha_mvar_delta(font, tag): i64 {
    if (font == 0) { return 0; }
    var mv = load64(font + 432);
    if (mv == 0) { return 0; }
    if (rekha_var_live(font) == 0) { return 0; }
    var buf = load64(font);
    var mvend = load64(font + 440);
    var rsz = rekha_rd_u16(buf, mv + 6);
    var rcnt = rekha_rd_u16(buf, mv + 8);
    if (rsz < 8) { return 0; }
    if (mv + 12 + rcnt * rsz > mvend) { return 0; }
    var ivso = rekha_rd_u16(buf, mv + 10);
    if (ivso < 12) { return 0; }
    var ivs = mv + ivso;
    var i = 0;
    while (i < rcnt) {
        var at = mv + 12 + i * rsz;
        if (rekha_rd_u32(buf, at) == tag) {
            var d: i64[1];
            var o = rekha_rd_u16(buf, at + 4);
            var n = rekha_rd_u16(buf, at + 6);
            if (rekha_ivs_delta(font, ivs, mvend, o, n, &d) == 0) { return 0; }
            return load64(&d);
        }
        i = i + 1;
    }
    return 0;
}

# --- os2.cyr ---

# OS/2: the metrics a font INTENDS (0.6.1).
#
# os2.cyr — `hhea` says how tall the font's glyphs are. `OS/2` says how the designer meant them to
# be SET: which vertical pair to build a line box from, where the x-height and cap-height sit, how
# bold and how wide the face is, and where a strikeout goes. A consumer cannot compute any of it
# from outlines, and until 0.6.1 nothing in the AGNOS stack could read it — which is the same hole
# `hmtx` left before 0.3.6, with the same consequence: `dhancha` hard-coded `advf = (h * 6) / 10`
# for advances until rekha read hmtx, and a toolkit with no `sxHeight` will invent one too.
#
# ⛔ WHICH VERTICAL PAIR, AND WHY IT IS THE CONSUMER'S CALL. A face carries three: hhea's
# ascender/descender/lineGap, OS/2's sTypo trio, and OS/2's usWin pair. `fsSelection` bit 7,
# USE_TYPO_METRICS, is the font saying "use the sTypo trio". rekha reports the bit and all three
# pairs and picks none of them: choosing is layout policy, and rekha is a parser.
#
# ⭐ AND THEY VARY. Every OS/2 field below that MVAR has a tag for takes its delta here, so a
# variable font's x-height moves with its weight. ⛔ hhea's own trio does NOT vary — MVAR has no
# tag for it, only for hhea's three caret fields. 0.6.0 put `hasc` / `hdsc` / `hlgp` on hhea, which
# was wrong; see src/hvar.cyr on why the differential did not catch it.
#
# Table layout, and the version each field first appears in (all big-endian):
#   +0 version u16 · +2 xAvgCharWidth i16 · +4 usWeightClass u16 · +6 usWidthClass u16 ·
#   +8 fsType u16 · +10..+29 sub/superscript and strikeout, ten i16 · +30 sFamilyClass i16 ·
#   +32 panose[10] · +42..+57 ulUnicodeRange1-4 u32 · +58 achVendID[4] · +62 fsSelection u16 ·
#   +64 usFirstCharIndex u16 · +66 usLastCharIndex u16 · +68 sTypoAscender i16 ·
#   +70 sTypoDescender i16 · +72 sTypoLineGap i16 · +74 usWinAscent u16 · +76 usWinDescent u16
#     — version 0 ends at 78 —
#   +78 ulCodePageRange1 u32 · +82 ulCodePageRange2 u32
#     — version 1 ends at 86 —
#   +86 sxHeight i16 · +88 sCapHeight i16 · +90 usDefaultChar u16 · +92 usBreakChar u16 ·
#   +94 usMaxContext u16
#     — versions 2, 3 and 4 end at 96; version 5 adds two u16 and ends at 100 —
#
# ⚠ EVERY READER IS GATED ON THE DECLARED LENGTH, not on the version number, because the two can
# disagree and the length is what bounds the bytes. A v4 table truncated to 80 bytes answers for
# usWinDescent and returns 0 for sxHeight, rather than reading someone else's table.
# ⚠ 0 IS "THE FONT DID NOT SAY", not a measured zero, for every accessor here. `rekha_os2_version`
# returns -1 when the table is absent and is the probe to use before trusting a 0.

var REKHA_TAG_OS2 = 0x4F532F32;    # 'OS/2'
# @public — fsSelection bit 7, for a consumer masking rekha_fs_selection itself (rekha_use_typo_metrics
# answers the question directly). ⛔ The one bit in this table a renderer must not ignore: it is
# the font saying its sTypo trio is the intended line box, and a face that sets it and is laid
# out on usWin metrics sets lines noticeably too far apart.
public var REKHA_OS2_USE_TYPO = 128;

# Cache the table at open. Validated for a minimum length only — every field below re-checks the
# extent it needs, so a short table loses its tail rather than the whole reader.
fn rekha_os2_resolve(f): i64 {
    store64(f + 448, 0);
    store64(f + 456, 0);
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_OS2, &c);
    if (t == 0) { return 0; }
    if (load64(&c) < 78) { return 0; }
    store64(f + 448, t);
    store64(f + 456, t + load64(&c));
    return 1;
}

# A signed 16-bit field at `off`, plus its MVAR delta when `tag` is non-zero. `dflt` when the
# table is absent or too short to hold it.
fn rekha_os2_i16(font, off, tag, dflt): i64 {
    if (font == 0) { return dflt; }
    var t = load64(font + 448);
    if (t == 0) { return dflt; }
    if (t + off + 2 > load64(font + 456)) { return dflt; }
    var v = rekha_rd_i16(load64(font), t + off);
    if (tag != 0) { v = v + rekha_mvar_delta(font, tag); }
    return v;
}

# The unsigned twin, for the two usWin fields and the class / flag words.
fn rekha_os2_u16(font, off, tag, dflt): i64 {
    if (font == 0) { return dflt; }
    var t = load64(font + 448);
    if (t == 0) { return dflt; }
    if (t + off + 2 > load64(font + 456)) { return dflt; }
    var v = rekha_rd_u16(load64(font), t + off);
    if (tag != 0) { v = v + rekha_mvar_delta(font, tag); }
    return v;
}

# @public — the OS/2 table's version, or -1 when the font has none. The probe to use before
# trusting a 0 from anything below.
public fn rekha_os2_version(font): i64 {
    if (font == 0) { return 0 - 1; }
    if (load64(font + 448) == 0) { return 0 - 1; }
    return rekha_rd_u16(load64(font), load64(font + 448));
}

# @public — usWeightClass, 1..1000 (400 = regular, 700 = bold). 0 when the font does not say.
# ⚠ This is the STATIC class. A variable font's `wght` axis is the live one — `rekha_var_axis_tag`
# / `rekha_var_coord` — and the two need not agree once an axis is set.
public fn rekha_weight_class(font): i64 { return rekha_os2_u16(font, 4, 0, 0); }

# @public — usWidthClass, 1..9 (5 = normal). 0 when the font does not say.
public fn rekha_width_class(font): i64 { return rekha_os2_u16(font, 6, 0, 0); }

# @public — fsType, the embedding-permission bitfield, or -1 when the font does not say. rekha
# neither enforces nor interprets it; a consumer that embeds fonts must.
public fn rekha_fs_type(font): i64 { return rekha_os2_u16(font, 8, 0, 0 - 1); }

# @public — fsSelection: bit 0 ITALIC, 5 BOLD, 6 REGULAR, 7 USE_TYPO_METRICS, 8 WWS, 9 OBLIQUE.
# -1 when the font does not say.
public fn rekha_fs_selection(font): i64 { return rekha_os2_u16(font, 62, 0, 0 - 1); }

# @public — 1 when the font asks for its sTypo trio to be the line box, else 0 (including when
# there is no OS/2 to ask).
public fn rekha_use_typo_metrics(font): i64 {
    var v = rekha_fs_selection(font);
    if (v < 0) { return 0; }
    if ((v & REKHA_OS2_USE_TYPO) != 0) { return 1; }
    return 0;
}

# @public — the sTypo trio, in design units, each varying through MVAR.
public fn rekha_typo_ascender(font): i64  { return rekha_os2_i16(font, 68, REKHA_MVAR_HASC, 0); }
public fn rekha_typo_descender(font): i64 { return rekha_os2_i16(font, 70, REKHA_MVAR_HDSC, 0); }
public fn rekha_typo_line_gap(font): i64  { return rekha_os2_i16(font, 72, REKHA_MVAR_HLGP, 0); }

# @public — the usWin clipping pair, in design units, each varying through MVAR. ⚠ Both are
# UNSIGNED and usWinDescent is a POSITIVE distance below the baseline, where sTypoDescender is
# negative. They are not interchangeable and a consumer that mixes them gets a line box that is
# off by twice the descent.
public fn rekha_win_ascent(font): i64  { return rekha_os2_u16(font, 74, REKHA_MVAR_HCLA, 0); }
public fn rekha_win_descent(font): i64 { return rekha_os2_u16(font, 76, REKHA_MVAR_HCLD, 0); }

# @public — sxHeight and sCapHeight, version 2 and up, in design units, varying through MVAR.
# 0 when the table is older or shorter than the field.
public fn rekha_x_height(font): i64   { return rekha_os2_i16(font, 86, REKHA_MVAR_XHGT, 0); }
public fn rekha_cap_height(font): i64 { return rekha_os2_i16(font, 88, REKHA_MVAR_CPHT, 0); }

# @public — the synthetic sub- and superscript boxes, in design units, all eight varying through
# MVAR. A renderer with no real superscript glyphs scales and shifts by these rather than guessing
# a fraction of the em. ⚠ The offsets are from the BASELINE, so a subscript's y offset is a
# positive distance DOWN — the sign convention is the field's, not a mistake.
public fn rekha_subscript_x_size(font): i64   { return rekha_os2_i16(font, 10, REKHA_MVAR_SBXS, 0); }
public fn rekha_subscript_y_size(font): i64   { return rekha_os2_i16(font, 12, REKHA_MVAR_SBYS, 0); }
public fn rekha_subscript_x_offset(font): i64 { return rekha_os2_i16(font, 14, REKHA_MVAR_SBXO, 0); }
public fn rekha_subscript_y_offset(font): i64 { return rekha_os2_i16(font, 16, REKHA_MVAR_SBYO, 0); }
public fn rekha_superscript_x_size(font): i64   { return rekha_os2_i16(font, 18, REKHA_MVAR_SPXS, 0); }
public fn rekha_superscript_y_size(font): i64   { return rekha_os2_i16(font, 20, REKHA_MVAR_SPYS, 0); }
public fn rekha_superscript_x_offset(font): i64 { return rekha_os2_i16(font, 22, REKHA_MVAR_SPXO, 0); }
public fn rekha_superscript_y_offset(font): i64 { return rekha_os2_i16(font, 24, REKHA_MVAR_SPYO, 0); }

# @public — the strikeout rule: its thickness, and its position above the baseline. Both vary.
# ⚠ The UNDERLINE pair lives in `post`, which rekha does not read yet.
public fn rekha_strikeout_size(font): i64     { return rekha_os2_i16(font, 26, REKHA_MVAR_STRS, 0); }
public fn rekha_strikeout_position(font): i64 { return rekha_os2_i16(font, 28, REKHA_MVAR_STRO, 0); }

# --- name.cyr ---

# the `name` table: what a font is called (0.6.2).
#
# name.cyr — family, subfamily, PostScript name, version, licence, and the strings `fvar` points at
# for its axes. rekha is the only SFNT parser in the AGNOS stack, so until 0.6.2 nothing here could
# ask a face its name: a font picker had a list of files, and `rekha_var_axis_count` could say a
# font has two axes without being able to say either is called "Weight".
#
# ⭐ WHAT COMES BACK IS UTF-8, IN THE CALLER'S BUFFER. A name is stored as UTF-16BE or as Macintosh
# Roman, and neither is something a consumer should have to know. rekha decodes and writes into a
# buffer the caller owns — the same shape as `rekha_woff_decode` — so a name query allocates
# NOTHING. `dst == 0` sizes it; a `cap` below the size writes nothing at all rather than half a
# character, and still returns the size, so the two-call idiom is safe.
#
# Table layout (all big-endian):
#   +0 format u16 (0 or 1) · +2 count u16 · +4 stringOffset u16 — from the TABLE's start
#   +6 nameRecord[count], 12 bytes each: platformID u16 · encodingID u16 · languageID u16 ·
#      nameID u16 · length u16 (BYTES, not characters) · offset u16 — from stringOffset
#   format 1 then adds langTagCount u16 and that many (length, offset) pairs, which rekha reads
#   past: they name languages, and rekha's picker works on the numeric language id.
#
# ⛔ WHICH RECORD WINS, AND WHY IT IS RANKED. A font carries the same nameID several times over,
# once per platform and language — Windows English, Unicode, Macintosh Roman — and the LAST one is
# no more the intended one than the first. `rekha_name_rank` prefers Windows/BMP/English, then the
# other Windows encodings in English, then any Windows record, then the Unicode platform, then
# Macintosh Roman in English, then any Macintosh Roman. A record whose platform or encoding rekha
# cannot decode is not a candidate at all, rather than a candidate that later fails. Same shape as
# cmap's subtable ranking (0.4.0), and for the same reason.
# ⚠ A consumer that wants another language walks the records itself: `rekha_name_count`,
# `rekha_name_id_at` / `_platform_at` / `_encoding_at` / `_language_at`, and `rekha_name_at_utf8`.
#
# ⛔ WHAT IS REFUSED (0 bytes, and the name is simply absent):
#   - a header or record array outside the table, or a string outside it;
#   - a UTF-16BE string with an odd byte length, an unpaired surrogate, or a low surrogate first —
#     decoding those would put a lone replacement character where a name should be;
#   - any platform / encoding pair that is not one of the above.
# ⚠ Nothing here caps what a font may declare, because nothing is allocated: a 65,535-byte name
# costs the caller exactly the buffer it chooses to pass.

var REKHA_TAG_NAME = 0x6E616D65;   # 'name'

# @public — the name ids worth naming, for rekha_name_utf8. Every other id is still readable by
# number.
public var REKHA_NAME_COPYRIGHT     = 0;
public var REKHA_NAME_FAMILY        = 1;
public var REKHA_NAME_SUBFAMILY     = 2;
public var REKHA_NAME_UNIQUE        = 3;
public var REKHA_NAME_FULL          = 4;
public var REKHA_NAME_VERSION       = 5;
public var REKHA_NAME_POSTSCRIPT    = 6;
public var REKHA_NAME_TRADEMARK     = 7;
public var REKHA_NAME_MANUFACTURER  = 8;
public var REKHA_NAME_DESIGNER      = 9;
public var REKHA_NAME_DESCRIPTION   = 10;
public var REKHA_NAME_VENDOR_URL    = 11;
public var REKHA_NAME_LICENSE       = 13;
public var REKHA_NAME_TYPO_FAMILY   = 16;
public var REKHA_NAME_TYPO_SUBFAM   = 17;
public var REKHA_NAME_SAMPLE        = 19;

# GENERATED by scripts/mac_roman.py table — do not edit by hand.
# Mac OS Roman 0x80..0xFF as code points, 16 to a chunk, four hex digits each.
fn rekha_mr_chunk(k): i64 {
    if (k == 0) { return "00C400C500C700C900D100D600DC00E100E000E200E400E300E500E700E900E8"; }
    if (k == 1) { return "00EA00EB00ED00EC00EE00EF00F100F300F200F400F600F500FA00F900FB00FC"; }
    if (k == 2) { return "202000B000A200A300A7202200B600DF00AE00A9212200B400A8226000C600D8"; }
    if (k == 3) { return "221E00B12264226500A500B522022211220F03C0222B00AA00BA03A900E600F8"; }
    if (k == 4) { return "00BF00A100AC221A01922248220600AB00BB202600A000C000C300D501520153"; }
    if (k == 5) { return "20132014201C201D2018201900F725CA00FF0178204420AC2039203AFB01FB02"; }
    if (k == 6) { return "202100B7201A201E203000C200CA00C100CB00C800CD00CE00CF00CC00D300D4"; }
    if (k == 7) { return "F8FF00D200DA00DB00D9013102C602DC00AF02D802D902DA00B802DD02DB02C7"; }
    return "";
}

# The code point Macintosh Roman byte `b` stands for. ASCII below 0x80; the table above
# at and past it. -1 for a byte outside 0..255.
fn rekha_mac_roman_cp(b): i64 {
    if (b < 0) { return 0 - 1; }
    if (b > 255) { return 0 - 1; }
    if (b < 128) { return b; }
    var i = b - 128;
    var s = rekha_mr_chunk(i >> 4);
    var p = (i & 15) * 4;
    var v = 0;
    var k = 0;
    while (k < 4) {
        var c = load8(s + p + k);
        var d = c - 48;
        if (c >= 65) { d = c - 55; }
        v = v * 16 + d;
        k = k + 1;
    }
    return v;
}

# How many UTF-8 bytes a code point needs.
fn rekha_utf8_len(cp): i64 {
    if (cp < 128) { return 1; }
    if (cp < 2048) { return 2; }
    if (cp < 65536) { return 3; }
    return 4;
}

# Write one code point at `dst + at`. The caller has already checked the room.
fn rekha_utf8_put(dst, at, cp): i64 {
    if (cp < 128) {
        store8(dst + at, cp);
        return 1;
    }
    if (cp < 2048) {
        store8(dst + at, 192 | (cp >> 6));
        store8(dst + at + 1, 128 | (cp & 63));
        return 2;
    }
    if (cp < 65536) {
        store8(dst + at, 224 | (cp >> 12));
        store8(dst + at + 1, 128 | ((cp >> 6) & 63));
        store8(dst + at + 2, 128 | (cp & 63));
        return 3;
    }
    store8(dst + at, 240 | (cp >> 18));
    store8(dst + at + 1, 128 | ((cp >> 12) & 63));
    store8(dst + at + 2, 128 | ((cp >> 6) & 63));
    store8(dst + at + 3, 128 | (cp & 63));
    return 4;
}

# Cache the table at open: its start, its end, its record count, and the absolute offset of the
# string storage. A format or a header that does not fit leaves it absent.
fn rekha_name_resolve(f): i64 {
    store64(f + 464, 0);
    store64(f + 472, 0);
    store64(f + 480, 0);
    store64(f + 488, 0);
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_NAME, &c);
    if (t == 0) { return 0; }
    var end = t + load64(&c);
    if (t + 6 > end) { return 0; }
    var buf = load64(f);
    var fmt = rekha_rd_u16(buf, t);
    if (fmt > 1) { return 0; }
    var n = rekha_rd_u16(buf, t + 2);
    if (t + 6 + n * 12 > end) { return 0; }
    var so = t + rekha_rd_u16(buf, t + 4);
    if (so > end) { return 0; }
    if (so < t + 6 + n * 12) { return 0; }
    store64(f + 464, t);
    store64(f + 472, end);
    store64(f + 480, n);
    store64(f + 488, so);
    return 1;
}

# @public — how many name records the font carries. 0 when there is no usable table.
public fn rekha_name_count(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 480);
}

# The absolute offset of record `i`, or 0.
fn rekha_name_rec(font, i): i64 {
    if (font == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(font + 480)) { return 0; }
    return load64(font + 464) + 6 + i * 12;
}

fn rekha_name_field(font, i, off): i64 {
    var r = rekha_name_rec(font, i);
    if (r == 0) { return 0 - 1; }
    return rekha_rd_u16(load64(font), r + off);
}

# @public — record `i`'s platform, encoding, language and name id, or -1 when there is no such
# record. Language 0 on Macintosh is English; 1033 on Windows is English (United States).
public fn rekha_name_platform_at(font, i): i64 { return rekha_name_field(font, i, 0); }
public fn rekha_name_encoding_at(font, i): i64 { return rekha_name_field(font, i, 2); }
public fn rekha_name_language_at(font, i): i64 { return rekha_name_field(font, i, 4); }
public fn rekha_name_id_at(font, i): i64       { return rekha_name_field(font, i, 6); }

# How much rekha wants a record, or -1 when it cannot decode one at all.
fn rekha_name_rank(plat, enc, lang): i64 {
    if (plat == 3) {
        if (enc != 0 && enc != 1 && enc != 10) { return 0 - 1; }
        if (lang == 1033) {
            if (enc == 1) { return 6; }
            if (enc == 10) { return 5; }
            return 4;
        }
        return 3;
    }
    if (plat == 0) { return 2; }
    if (plat == 1) {
        if (enc != 0) { return 0 - 1; }
        if (lang == 0) { return 1; }
        return 0;
    }
    return 0 - 1;
}

# Decode record `r` into UTF-8. Returns the byte count, or 0 on any refusal. Writes only when
# `write` is set, and then only inside `cap` — the caller has already sized it.
fn rekha_name_conv(font, r, dst, cap, write): i64 {
    var buf = load64(font);
    var plat = rekha_rd_u16(buf, r);
    var enc = rekha_rd_u16(buf, r + 2);
    var lang = rekha_rd_u16(buf, r + 4);
    if (rekha_name_rank(plat, enc, lang) < 0) { return 0; }
    var len = rekha_rd_u16(buf, r + 8);
    var at = load64(font + 488) + rekha_rd_u16(buf, r + 10);
    if (at + len > load64(font + 472)) { return 0; }
    if (len == 0) { return 0; }

    var need = 0;
    if (plat == 1) {
        var i = 0;
        while (i < len) {
            var cp = rekha_mac_roman_cp(load8(buf + at + i));
            var n = rekha_utf8_len(cp);
            if (write != 0) {
                if (need + n > cap) { return 0; }
                rekha_utf8_put(dst, need, cp);
            }
            need = need + n;
            i = i + 1;
        }
        return need;
    }
    # ⛔ UTF-16BE, and an odd length is not a string with a spare byte — it is a record rekha will
    # not guess at.
    if ((len & 1) != 0) { return 0; }
    var j = 0;
    while (j < len) {
        var u = rekha_rd_u16(buf, at + j);
        j = j + 2;
        if (u >= 0xDC00 && u <= 0xDFFF) { return 0; }        # a low surrogate with no high
        if (u >= 0xD800 && u <= 0xDBFF) {
            if (j + 2 > len) { return 0; }                   # a high surrogate at the end
            var lo = rekha_rd_u16(buf, at + j);
            if (lo < 0xDC00 || lo > 0xDFFF) { return 0; }
            j = j + 2;
            u = 65536 + ((u - 0xD800) << 10) + (lo - 0xDC00);
        }
        var m = rekha_utf8_len(u);
        if (write != 0) {
            if (need + m > cap) { return 0; }
            rekha_utf8_put(dst, need, u);
        }
        need = need + m;
    }
    return need;
}

# @public — record `i` as UTF-8. Returns the byte count the name needs, or 0 when the record is
# absent or cannot be decoded. Writes into `dst` only when the whole string fits in `cap`; pass
# `dst` 0 to size it. ⚠ NOT NUL-terminated: the return value is the length.
public fn rekha_name_at_utf8(font, i, dst, cap): i64 {
    var r = rekha_name_rec(font, i);
    if (r == 0) { return 0; }
    var need = rekha_name_conv(font, r, 0, 0, 0);
    if (need == 0) { return 0; }
    if (dst == 0) { return need; }
    if (cap < need) { return need; }
    return rekha_name_conv(font, r, dst, cap, 1);
}

# @public — the best record for `name_id`, as UTF-8, under the ranking above. Same buffer contract
# as rekha_name_at_utf8. 0 when the font carries no readable record for that id.
public fn rekha_name_utf8(font, name_id, dst, cap): i64 {
    if (font == 0) { return 0; }
    var n = load64(font + 480);
    var buf = load64(font);
    var best = 0 - 1;
    var bestrank = 0 - 1;
    var i = 0;
    while (i < n) {
        var r = load64(font + 464) + 6 + i * 12;
        if (rekha_rd_u16(buf, r + 6) == name_id) {
            var k = rekha_name_rank(rekha_rd_u16(buf, r), rekha_rd_u16(buf, r + 2),
              rekha_rd_u16(buf, r + 4));
            if (k > bestrank) {
                bestrank = k;
                best = i;
            }
        }
        i = i + 1;
    }
    if (best < 0) { return 0; }
    return rekha_name_at_utf8(font, best, dst, cap);
}

# --- stat.cyr ---

# STAT: the style attributes a family is ordered and named by (0.6.3).
#
# stat.cyr — `fvar` says a font has a `wght` axis running 100 to 900 and ships an instance at 700.
# STAT says that 700 is called "Bold", that `wght` sorts before `wdth`, and that "Regular" is a
# name to be ELIDED rather than printed. It is how "Bold Condensed" gets built out of two numbers,
# and OpenType makes it REQUIRED for a variable font.
#
# ⛔ rekha READS IT AND DOES NOT SYNTHESIZE A STYLE NAME. Picking which axis values apply, ordering
# them by `axisOrdering`, dropping the elidable ones and joining what is left is a family-naming
# POLICY with real disagreement in it — the same reason `rekha_use_typo_metrics` reports a bit
# instead of choosing a line box. Every field the policy needs is here; the policy is the
# consumer's.
#
# Table layout (all big-endian):
#   +0 majorVersion u16 (= 1) · +2 minorVersion u16 · +4 designAxisSize u16 ·
#   +6 designAxisCount u16 · +8 designAxesOffset u32 — from the TABLE's start ·
#   +12 axisValueCount u16 · +14 offsetToAxisValueOffsets u32 ·
#   +18 elidedFallbackNameID u16, minorVersion 1 and up
# AxisRecord, designAxisSize bytes: axisTag u32 · axisNameID u16 · axisOrdering u16
# The axis value OFFSETS are u16[axisValueCount] at offsetToAxisValueOffsets, each from THAT point.
# AxisValue formats, all starting format u16 · then:
#   1: axisIndex u16 · flags u16 · valueNameID u16 · value Fixed
#   2: axisIndex u16 · flags u16 · valueNameID u16 · nominalValue · rangeMinValue · rangeMaxValue
#   3: axisIndex u16 · flags u16 · valueNameID u16 · value Fixed · linkedValue Fixed
#   4: axisCount u16 · flags u16 · valueNameID u16 · then axisCount of (axisIndex u16, value Fixed)
#
# ⭐ THE FOUR FORMATS ARE READ THROUGH ONE PAIR API. `rekha_stat_value_pairs` is 1 for formats 1-3
# and axisCount for format 4, and `rekha_stat_value_axis` / `_value` take the pair index — so a
# consumer walks every format the same way and never branches on the format to get at the numbers.
# The format is still reported, because formats 2 and 3 carry fields the others do not.
#
# ⛔ WHAT IS REFUSED (the table is simply absent, or the one entry is):
#   - a majorVersion other than 1, a header that does not fit, or a designAxisSize below 8;
#   - an axis array, an offset array or an axis value table outside the table;
#   - an axis value format past 4, or a format 4 whose record array does not fit;
#   - an offset of 0, which the spec uses for "no entry here".
# ⚠ An axisIndex is NOT checked against `designAxisCount` here: it is reported as it is written, so
# a consumer that cross-references STAT's axes can see an out-of-range one rather than have it
# quietly clamped. Every BYTE read is inside the table; only the meaning is left alone.

var REKHA_TAG_STAT = 0x53544154;   # 'STAT'
# @public — the bits of rekha_stat_value_flags. Bit 0: this value applies to the older sibling of a
# family split for compatibility. Bit 1: the name is to be dropped when building a style string —
# "Regular" in "Bold".
public var REKHA_STAT_OLDER_SIBLING = 1;
public var REKHA_STAT_ELIDABLE = 2;

fn rekha_stat_resolve(f): i64 {
    store64(f + 520, 0);
    store64(f + 528, 0);
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_STAT, &c);
    if (t == 0) { return 0; }
    var end = t + load64(&c);
    if (t + 18 > end) { return 0; }
    var buf = load64(f);
    if (rekha_rd_u16(buf, t) != 1) { return 0; }
    if (rekha_rd_u16(buf, t + 4) < 8) { return 0; }                # designAxisSize
    var na = rekha_rd_u16(buf, t + 6);
    var ao = t + rekha_rd_u32(buf, t + 8);
    if (ao < t) { return 0; }
    if (ao + na * rekha_rd_u16(buf, t + 4) > end) { return 0; }
    var nv = rekha_rd_u16(buf, t + 12);
    var vo = t + rekha_rd_u32(buf, t + 14);
    if (vo < t) { return 0; }
    if (vo + nv * 2 > end) { return 0; }
    store64(f + 520, t);
    store64(f + 528, end);
    return 1;
}

# @public — 1 when the font carries a STAT table rekha can read, else 0.
public fn rekha_stat_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 520) == 0) { return 0; }
    return 1;
}

# @public — the name id to use when every axis value in a style string was elided, or 0. It is the
# minorVersion 1 field, and a 1.0 table has none.
public fn rekha_stat_fallback_name_id(font): i64 {
    if (rekha_stat_present(font) == 0) { return 0; }
    var t = load64(font + 520);
    if (rekha_rd_u16(load64(font), t + 2) < 1) { return 0; }
    return rekha_rd_u16(load64(font), t + 18);
}

# @public — how many design axes STAT declares. ⚠ This is STAT's own list, which a static member of
# a variable family also carries; it need not match `rekha_var_axis_count`.
public fn rekha_stat_axis_count(font): i64 {
    if (rekha_stat_present(font) == 0) { return 0; }
    return rekha_rd_u16(load64(font), load64(font + 520) + 6);
}

fn rekha_stat_axis_rec(font, i): i64 {
    if (rekha_stat_present(font) == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= rekha_stat_axis_count(font)) { return 0; }
    var t = load64(font + 520);
    var buf = load64(font);
    return t + rekha_rd_u32(buf, t + 8) + i * rekha_rd_u16(buf, t + 4);
}

# @public — design axis `i`'s tag (0 past the count).
public fn rekha_stat_axis_tag(font, i): i64 {
    var r = rekha_stat_axis_rec(font, i);
    if (r == 0) { return 0; }
    return rekha_rd_u32(load64(font), r);
}

# @public — design axis `i`'s name id (0 past the count).
public fn rekha_stat_axis_name_id(font, i): i64 {
    var r = rekha_stat_axis_rec(font, i);
    if (r == 0) { return 0; }
    return rekha_rd_u16(load64(font), r + 4);
}

# @public — design axis `i`'s sort position within a style string (0 past the count).
public fn rekha_stat_axis_ordering(font, i): i64 {
    var r = rekha_stat_axis_rec(font, i);
    if (r == 0) { return 0; }
    return rekha_rd_u16(load64(font), r + 6);
}

# @public — how many axis value tables the font carries.
public fn rekha_stat_value_count(font): i64 {
    if (rekha_stat_present(font) == 0) { return 0; }
    return rekha_rd_u16(load64(font), load64(font + 520) + 12);
}

# The absolute offset of axis value `i`, bounds-checked for its whole body, or 0.
fn rekha_stat_value_at(font, i): i64 {
    if (rekha_stat_present(font) == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= rekha_stat_value_count(font)) { return 0; }
    var t = load64(font + 520);
    var end = load64(font + 528);
    var buf = load64(font);
    var base = t + rekha_rd_u32(buf, t + 14);
    var off = rekha_rd_u16(buf, base + i * 2);
    if (off == 0) { return 0; }                                    # the spec's "no entry"
    var v = base + off;
    if (v + 8 > end) { return 0; }
    var fmt = rekha_rd_u16(buf, v);
    if (fmt == 1) {
        if (v + 12 > end) { return 0; }
        return v;
    }
    if (fmt == 2) {
        if (v + 20 > end) { return 0; }
        return v;
    }
    if (fmt == 3) {
        if (v + 16 > end) { return 0; }
        return v;
    }
    if (fmt == 4) {
        var n = rekha_rd_u16(buf, v + 2);
        if (v + 8 + n * 6 > end) { return 0; }
        return v;
    }
    return 0;
}

# @public — axis value `i`'s format (1..4), or 0 when there is no readable entry there.
public fn rekha_stat_value_format(font, i): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0; }
    return rekha_rd_u16(load64(font), v);
}

# @public — axis value `i`'s flags, or 0. REKHA_STAT_ELIDABLE is the bit that matters.
public fn rekha_stat_value_flags(font, i): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0; }
    return rekha_rd_u16(load64(font), v + 4);
}

# @public — axis value `i`'s name id, for `rekha_name_utf8`. 0 when there is no entry.
public fn rekha_stat_value_name_id(font, i): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0; }
    return rekha_rd_u16(load64(font), v + 6);
}

# @public — how many (axis, value) pairs entry `i` carries: 1 for formats 1, 2 and 3, and format
# 4's own axisCount. 0 when there is no entry.
public fn rekha_stat_value_pairs(font, i): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0; }
    if (rekha_rd_u16(load64(font), v) == 4) { return rekha_rd_u16(load64(font), v + 2); }
    return 1;
}

fn rekha_stat_fixed(font, at): i64 {
    var x = rekha_rd_u32(load64(font), at);
    if (x >= 0x80000000) { x = x - 0x100000000; }
    return x;
}

# @public — pair `k` of axis value `i`: which design axis it is about. -1 when out of range.
public fn rekha_stat_value_axis(font, i, k): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0 - 1; }
    if (k < 0 || k >= rekha_stat_value_pairs(font, i)) { return 0 - 1; }
    var buf = load64(font);
    if (rekha_rd_u16(buf, v) == 4) { return rekha_rd_u16(buf, v + 8 + k * 6); }
    return rekha_rd_u16(buf, v + 2);
}

# @public — pair `k` of axis value `i`: the value on that axis, in 16.16 user units. For format 2
# this is the NOMINAL value; its range is rekha_stat_value_min / _max.
public fn rekha_stat_value_value(font, i, k): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0; }
    if (k < 0 || k >= rekha_stat_value_pairs(font, i)) { return 0; }
    if (rekha_rd_u16(load64(font), v) == 4) { return rekha_stat_fixed(font, v + 10 + k * 6); }
    return rekha_stat_fixed(font, v + 8);
}

# @public — format 2's range, in 16.16 user units. Both 0 for any other format: a format 1 or 3
# entry names a point, not a span.
public fn rekha_stat_value_min(font, i): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0; }
    if (rekha_rd_u16(load64(font), v) != 2) { return 0; }
    return rekha_stat_fixed(font, v + 12);
}

# @public — the top of a format 2 range, 16.16 user units; 0 for any other format.
public fn rekha_stat_value_max(font, i): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0; }
    if (rekha_rd_u16(load64(font), v) != 2) { return 0; }
    return rekha_stat_fixed(font, v + 16);
}

# @public — format 3's linked value: the place on the same axis this style's bold-or-equivalent
# counterpart sits, in 16.16 user units. 0 for any other format.
public fn rekha_stat_value_linked(font, i): i64 {
    var v = rekha_stat_value_at(font, i);
    if (v == 0) { return 0; }
    if (rekha_rd_u16(load64(font), v) != 3) { return 0; }
    return rekha_stat_fixed(font, v + 12);
}

# --- post.cyr ---

# `post`: where the underline goes, and how far the face leans (0.6.4).
#
# post.cyr — a small table with one job a renderer cannot do without: `underlinePosition` and
# `underlineThickness` are the only place a font says where to draw a rule under its text. OS/2
# gives the STRIKEOUT pair (0.6.1) and this gives the underline; a consumer that has one and
# invents the other draws two rules of different weights.
#
# ⭐ AND THEY ARE THE LAST TWO MVAR TAGS WITH NOWHERE TO LAND. `unds` and `undo` target exactly
# these two fields, so with 0.6.4 every tag in MVAR that names a table rekha reads now lands on it.
# What is left of MVAR after this is the `vhea` tags, which are the vertical-metrics item.
#
# Table layout. ⚠ THE HEADER IS 32 BYTES IN EVERY VERSION and carries everything below; the
# versions differ only in what follows it.
#   +0 version Fixed · +4 italicAngle Fixed · +8 underlinePosition i16 ·
#   +10 underlineThickness i16 · +12 isFixedPitch u32 · +16..+31 the Type 42 / Type 1 memory hints
# 1.0 ends there and means "the 258 standard Macintosh glyph names, in order". 2.0 adds a per-glyph
# name index and a pool of Pascal strings; 2.5 (deprecated) adds a per-glyph offset into that
# standard order; 3.0 says there are no names; 4.0 (deprecated) is Apple's.
#
# ⛔ GLYPH NAMES ARE NOT READ, and that is a scoping decision rather than an omission. They serve
# tooling — PDF export, a debugger printing which glyph failed — and nothing rekha draws depends on
# one. Carrying them means carrying the 258-name Macintosh standard order as data, which is a table
# the size of everything else in this file put together. docs/development/roadmap.md pins it.
# ⚠ So `rekha_post_version` reports what the font says and rekha reads the same six fields from any
# of them: the version tells a consumer whether names would be there, not whether rekha read any.

var REKHA_TAG_POST = 0x706F7374;   # 'post'
var REKHA_MVAR_UNDS = 0x756E6473;  # 'unds' — post.underlineThickness
var REKHA_MVAR_UNDO = 0x756E646F;  # 'undo' — post.underlinePosition

fn rekha_post_resolve(f): i64 {
    store64(f + 536, 0);
    store64(f + 544, 0);
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_POST, &c);
    if (t == 0) { return 0; }
    if (load64(&c) < 32) { return 0; }
    store64(f + 536, t);
    store64(f + 544, t + load64(&c));
    return 1;
}

# @public — the `post` version as its raw 16.16 Fixed (0x00010000 for 1.0, 0x00020000 for 2.0,
# 0x00030000 for 3.0), or -1 when the font has no usable table. The probe to use before trusting a
# 0 from anything below.
public fn rekha_post_version(font): i64 {
    if (font == 0) { return 0 - 1; }
    var t = load64(font + 536);
    if (t == 0) { return 0 - 1; }
    return rekha_rd_u32(load64(font), t);
}

# @public — italicAngle, in 16.16 DEGREES counter-clockwise from vertical, so an oblique face is
# NEGATIVE. 0 when the font does not say, which is also what an upright face says.
# ⚠ No MVAR tag exists for it: an italic angle does not vary.
public fn rekha_italic_angle(font): i64 {
    if (font == 0) { return 0; }
    var t = load64(font + 536);
    if (t == 0) { return 0; }
    var v = rekha_rd_u32(load64(font), t + 4);
    if (v >= 0x80000000) { v = v - 0x100000000; }
    return v;
}

# @public — where the underline sits, in design units: the TOP of the rule, relative to the
# baseline and so normally NEGATIVE. Varies through MVAR's `undo`.
public fn rekha_underline_position(font): i64 {
    if (font == 0) { return 0; }
    var t = load64(font + 536);
    if (t == 0) { return 0; }
    return rekha_rd_i16(load64(font), t + 8) + rekha_mvar_delta(font, REKHA_MVAR_UNDO);
}

# @public — how thick that rule is, in design units. Varies through MVAR's `unds`.
public fn rekha_underline_thickness(font): i64 {
    if (font == 0) { return 0; }
    var t = load64(font + 536);
    if (t == 0) { return 0; }
    return rekha_rd_i16(load64(font), t + 10) + rekha_mvar_delta(font, REKHA_MVAR_UNDS);
}

# @public — 1 when every glyph has the same advance, 0 when not, -1 when the font does not say.
# ⚠ The field is a u32 and the spec only requires it to be non-zero for monospaced, so any
# non-zero value is 1 here rather than passed through.
public fn rekha_is_fixed_pitch(font): i64 {
    if (font == 0) { return 0 - 1; }
    var t = load64(font + 536);
    if (t == 0) { return 0 - 1; }
    if (rekha_rd_u32(load64(font), t + 12) != 0) { return 1; }
    return 0;
}

# --- vert.cyr ---

# vertical metrics: `vhea`, `vmtx`, `VORG` and `VVAR` (0.6.7).
#
# vert.cyr — everything rekha knows about laying a line of text DOWN the page instead of across
# it. A CJK face set vertically needs a per-glyph advance HEIGHT, a vertical line box, a top side
# bearing, and — because a glyph's vertical origin is not where its outline starts — the y the pen
# sits at before it draws. None of it is derivable from the horizontal metrics.
#
# ⭐ AND IT CLOSES MVAR. `vasc`, `vdsc`, `vlgp`, `vcrs`, `vcrn` and `vcof` were the last six tags
# with nowhere to land, so with 0.6.7 **every one of MVAR's 28 tags lands on the field the spec
# names**. ⚠ 0.6.4's note said four; it is six, and this is the correction.
#
# ⚠ HORIZONTAL IS STILL THE DEFAULT AND THE TESTED PATH. rekha names horizontal metrics as its
# shipped scope (0.3.6) and no AGNOS consumer lays out vertical text today. This is here because it
# is metrics, because it is what the last MVAR tags need, and because a CJK consumer that arrives
# should not find the table unread. It is not a vertical LAYOUT engine: rekha reports the numbers.
#
#   vhea (36 bytes, the same shape as hhea): version Fixed · vertTypoAscender i16 ·
#     vertTypoDescender i16 · vertTypoLineGap i16 · advanceHeightMax u16 · minTopSideBearing i16 ·
#     minBottomSideBearing i16 · yMaxExtent i16 · caretSlopeRise i16 · caretSlopeRun i16 ·
#     caretOffset i16 · 4 reserved i16 · metricDataFormat i16 · numOfLongVerMetrics u16
#   vmtx: numOfLongVerMetrics of (advanceHeight u16, topSideBearing i16), then a tail of bare
#     topSideBearing i16 for every glyph past that — hmtx's shape exactly.
#   VORG: major u16 (1) · minor u16 · defaultVertOriginY i16 · numVertOriginYMetrics u16 · then
#     that many (glyphIndex u16, vertOriginY i16), SORTED by glyph index.
#   VVAR: HVAR with one more map — major · minor · itemVariationStore u32 · advanceHeightMapping
#     u32 · tsbMapping u32 · bsbMapping u32 · vOrgMapping u32.
#
# ⛔ A GLYPH'S VERTICAL ORIGIN IS NOT ITS TOP SIDE BEARING. VORG gives the origin outright and is
# what a CFF face carries; a TrueType face usually has none, and the convention is to derive one
# from the bounding box and the top side bearing. rekha does NOT derive it: `rekha_vorg_present`
# says whether the font stated one, and `rekha_vert_origin_y` answers only when it did. Guessing
# here would put every glyph of a vertical run at a plausible wrong height.

var REKHA_TAG_VHEA = 0x76686561;   # 'vhea'
var REKHA_TAG_VMTX = 0x766D7478;   # 'vmtx'
var REKHA_TAG_VORG = 0x564F5247;   # 'VORG'
var REKHA_TAG_VVAR = 0x56564152;   # 'VVAR'
# The six MVAR tags that had nowhere to land until now.
var REKHA_MVAR_VASC = 0x76617363;  # 'vasc' — vhea.vertTypoAscender
var REKHA_MVAR_VDSC = 0x76647363;  # 'vdsc' — vhea.vertTypoDescender
var REKHA_MVAR_VLGP = 0x766C6770;  # 'vlgp' — vhea.vertTypoLineGap
var REKHA_MVAR_VCRS = 0x76637273;  # 'vcrs' — vhea.caretSlopeRise
var REKHA_MVAR_VCRN = 0x7663726E;  # 'vcrn' — vhea.caretSlopeRun
var REKHA_MVAR_VCOF = 0x76636F66;  # 'vcof' — vhea.caretOffset

fn rekha_vert_resolve(f): i64 {
    store64(f + 608, 0);
    store64(f + 616, 0);
    store64(f + 624, 0);
    store64(f + 632, 0);
    store64(f + 640, 0);
    store64(f + 648, 0);
    store64(f + 656, 0);
    store64(f + 664, 0);
    var buf = load64(f);
    var c: i64[1];
    var vh = rekha_find_table_len(f, REKHA_TAG_VHEA, &c);
    if (vh != 0) {
        if (load64(&c) >= 36) {
            store64(f + 608, vh);
            store64(f + 616, rekha_rd_u16(buf, vh + 34));
        }
    }
    # ⛔ A ZERO-LENGTH vmtx IS ABSENT, as it is to FreeType, whose table lookup skips a directory
    # entry with length 0 (tt_face_lookup_table, ref2143/ttload.c:80-88) so that its vmtx never
    # loads and vertical_info stays 0: the readers below answer as with no table, and the hinted
    # loader's vertical phantoms (src/hint.cyr rekha_hint_vmetrics) fall to OS/2 or hhea.
    var vm = rekha_find_table_len(f, REKHA_TAG_VMTX, &c);
    if (load64(&c) > 0) {
        store64(f + 624, vm);
        store64(f + 632, load64(&c));
    }
    var vo = rekha_find_table_len(f, REKHA_TAG_VORG, &c);
    if (vo != 0) {
        if (load64(&c) >= 8) {
            if (rekha_rd_u16(buf, vo) == 1) {
                store64(f + 640, vo);
                store64(f + 648, vo + load64(&c));
            }
        }
    }
    var vv = rekha_find_table_len(f, REKHA_TAG_VVAR, &c);
    if (vv != 0) {
        if (load64(&c) >= 24) {
            if (rekha_rd_u16(buf, vv) == 1) {
                store64(f + 656, vv);
                store64(f + 664, vv + load64(&c));
            }
        }
    }
    return 0;
}

# A signed vhea field at `off`, plus its MVAR delta. 0 when there is no vhea.
fn rekha_vhea_i16(font, off, tag): i64 {
    if (font == 0) { return 0; }
    var vh = load64(font + 608);
    if (vh == 0) { return 0; }
    return rekha_rd_i16(load64(font), vh + off) + rekha_mvar_delta(font, tag);
}

# @public — 1 when the font carries a `vhea` rekha can read, else 0. The probe to use before
# trusting a 0 from the accessors below, every one of which is a real value for some font.
public fn rekha_vhea_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 608) == 0) { return 0; }
    return 1;
}

# @public — the vertical line box, in design units, all three varying through MVAR.
public fn rekha_vert_ascender(font): i64  { return rekha_vhea_i16(font, 4, REKHA_MVAR_VASC); }
public fn rekha_vert_descender(font): i64 { return rekha_vhea_i16(font, 6, REKHA_MVAR_VDSC); }
public fn rekha_vert_line_gap(font): i64  { return rekha_vhea_i16(font, 8, REKHA_MVAR_VLGP); }

# @public — the vertical caret, the twin of hhea's. All three vary.
public fn rekha_vert_caret_slope_rise(font): i64 { return rekha_vhea_i16(font, 18, REKHA_MVAR_VCRS); }
public fn rekha_vert_caret_slope_run(font): i64  { return rekha_vhea_i16(font, 20, REKHA_MVAR_VCRN); }
public fn rekha_vert_caret_offset(font): i64     { return rekha_vhea_i16(font, 22, REKHA_MVAR_VCOF); }

# @public — vhea.numOfLongVerMetrics: how many glyphs carry their own advance height. 0 with no
# vhea, which is also what makes every reader below answer 0.
public fn rekha_num_v_metrics(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 616);
}

# One VVAR delta for `gid` through the map at header offset `moff`. 0 when there is no VVAR, no
# axis is set, or anything about the store refuses.
fn rekha_vvar_delta(font, gid, moff): i64 {
    if (font == 0) { return 0; }
    if (gid < 0) { return 0; }
    var vv = load64(font + 656);
    if (vv == 0) { return 0; }
    if (rekha_var_live(font) == 0) { return 0; }
    var buf = load64(font);
    var end = load64(font + 664);
    var ivs = vv + rekha_rd_u32(buf, vv + 4);
    if (ivs < vv) { return 0; }
    var pair: i64[2];
    store64(&pair, 0);
    store64(&pair + 8, gid);
    var mo = rekha_rd_u32(buf, vv + moff);
    if (mo != 0) {
        if (rekha_dsim(font, vv + mo, end, gid, &pair) == 0) { return 0; }
    }
    var d: i64[1];
    if (rekha_ivs_delta(font, ivs, end, load64(&pair), load64(&pair + 8), &d) == 0) { return 0; }
    return load64(&d);
}

# @public — `gid`'s advance height, in design units, varying through VVAR. 0 when the font has no
# vertical metrics. ⚠ Like hmtx, a gid past numOfLongVerMetrics SHARES the last advance; that is
# the format's own rule, and VVAR's delta still applies to the real gid.
public fn rekha_advance_height(font, gid): i64 {
    if (font == 0) { return 0; }
    if (gid < 0) { return 0; }
    var nvm = load64(font + 616);
    if (nvm <= 0) { return 0; }
    var vmtx = load64(font + 624);
    if (vmtx == 0) { return 0; }
    var idx = gid;
    if (idx >= nvm) { idx = nvm - 1; }
    if ((idx + 1) * 4 > load64(font + 632)) { return 0; }
    var h = rekha_rd_u16(load64(font), vmtx + idx * 4) + rekha_vvar_delta(font, gid, 8);
    if (h < 0) { return 0; }
    return h;
}

# @public — `gid`'s top side bearing, in design units, varying through VVAR. ⛔ The tail past
# numOfLongVerMetrics is a BARE i16 array, not a continuation of the 4-byte records: reading it
# with the wrong stride returns another glyph's advance as a bearing.
public fn rekha_top_side_bearing(font, gid): i64 {
    if (font == 0) { return 0; }
    if (gid < 0) { return 0; }
    var nvm = load64(font + 616);
    if (nvm <= 0) { return 0; }
    var vmtx = load64(font + 624);
    if (vmtx == 0) { return 0; }
    var len = load64(font + 632);
    var at = 0;
    if (gid < nvm) {
        at = gid * 4 + 2;
    } else {
        at = nvm * 4 + (gid - nvm) * 2;
    }
    if (at + 2 > len) { return 0; }
    return rekha_rd_i16(load64(font), vmtx + at) + rekha_vvar_delta(font, gid, 12);
}

# @public — 1 when the font states its vertical origins in a VORG table, else 0.
public fn rekha_vorg_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 640) == 0) { return 0; }
    return 1;
}

# @public — the y the pen sits at before drawing `gid` in a vertical run, in design units, varying
# through VVAR. ⛔ 0 when the font carries no VORG — rekha does NOT derive one from the bounding
# box and the top side bearing, because a derived origin is a plausible wrong height for every
# glyph in the run. `rekha_vorg_present` is the question to ask first.
public fn rekha_vert_origin_y(font, gid): i64 {
    if (rekha_vorg_present(font) == 0) { return 0; }
    if (gid < 0) { return 0; }
    var buf = load64(font);
    var t = load64(font + 640);
    var end = load64(font + 648);
    var y = rekha_rd_i16(buf, t + 4);                    # defaultVertOriginY
    var n = rekha_rd_u16(buf, t + 6);
    if (t + 8 + n * 4 <= end) {
        # sorted by glyph index, so this is a binary search
        var lo = 0;
        var hi = n - 1;
        while (lo <= hi) {
            var mid = lo + (hi - lo) / 2;
            var r = t + 8 + mid * 4;
            var g = rekha_rd_u16(buf, r);
            if (g == gid) {
                y = rekha_rd_i16(buf, r + 2);
                lo = hi + 1;
            } else {
                if (g < gid) {
                    lo = mid + 1;
                } else {
                    hi = mid - 1;
                }
            }
        }
    }
    return y + rekha_vvar_delta(font, gid, 20);
}

# @public — the advance height in whole pixels at `px_size`, rounded half up: the vertical twin of
# rekha_glyph_advance_px.
public fn rekha_glyph_advance_height_px(font, gid, px_size): i64 {
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var h = rekha_advance_height(font, gid);
    if (h <= 0) { return 0; }
    return (h * px_size + upem / 2) / upem;
}

# @public — the advance height at `px_size` in 16.16: the vertical twin of rekha_glyph_advance_fx.
public fn rekha_glyph_advance_height_fx(font, gid, px_size): i64 {
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var h = rekha_advance_height(font, gid);
    if (h <= 0) { return 0; }
    return (h * px_size * 65536 + upem / 2) / upem;
}

# --- gpos.cyr ---

# GPOS pair positioning: where a modern font keeps its kerning (0.6.6).
#
# gpos.cyr — 0.6.5 read the legacy `kern` table, and said plainly that a face with GPOS alone is
# normal and answered 0 for one. This is that: the `kern` FEATURE's lookups, the two `PairPos`
# formats, Coverage and ClassDef in both of their formats, and the extension wrapper large fonts
# use to reach past a 16-bit offset.
#
# ⛔ PAIR POSITIONING AND NOTHING ELSE. GPOS also carries mark attachment, cursive joining and
# contextual chains; those are a positioning ENGINE working over a glyph run, and they belong to a
# shaping library — a committed non-goal, docs/development/roadmap.md. Lookup types other than 2
# (and 9 wrapping a 2) are skipped, not refused: a font is normal for having them.
#
# What it takes to reach a pair, and every step is a bounds check:
#   GPOS: major u16 (= 1) · minor u16 · scriptList Offset16 · featureList Offset16 ·
#     lookupList Offset16 · (minor 1) featureVariations Offset32
#   FeatureList: featureCount u16 · FeatureRecord[]: featureTag u32 · feature Offset16
#     Feature: featureParams Offset16 · lookupIndexCount u16 · lookupListIndices u16[]
#   LookupList: lookupCount u16 · lookup Offset16[]
#     Lookup: lookupType u16 · lookupFlag u16 · subTableCount u16 · subtable Offset16[]
#   ExtensionPos (type 9): posFormat u16 (= 1) · extensionLookupType u16 · extension Offset32
#   PairPos 1: posFormat · coverage Offset16 · valueFormat1 u16 · valueFormat2 u16 ·
#     pairSetCount u16 · pairSet Offset16[]  ·  PairSet: pairValueCount u16 · then records of
#     secondGlyph u16 + the two value records, SORTED by secondGlyph
#   PairPos 2: posFormat · coverage · valueFormat1 · valueFormat2 · classDef1 Offset16 ·
#     classDef2 Offset16 · class1Count u16 · class2Count u16 · then a class1Count x class2Count
#     grid of value-record pairs
#   ⛔ A VALUE RECORD HAS NO FIXED SIZE. valueFormat is a bitfield and the record holds one i16 per
#   set bit, in bit order, so XAdvance sits at 2 x popcount(valueFormat & 0x0003) and is absent
#   when bit 2 is clear. Reading it at a fixed offset is how a font with Y placement gets its
#   kerning read out of the wrong field.
#
# ⚠ WHAT rekha DOES NOT DO HERE, and each is a deliberate line:
#   - ⛔ THE SCRIPT AND LANGUAGE WALK. rekha scans the FeatureList for every `kern` feature and
#     takes the UNION of their lookups, deduplicated. A font that kerns differently per script gets
#     all of it. Doing it properly needs a script and language on the API, and rekha's kerning
#     question is `(left, right)` with no run and no language around it.
#   - lookupFlag's ignore bits (marks, base glyphs, ligatures). They say which glyphs a SHAPER
#     skips while walking a run; a pairwise query has no run to skip in.
#   - Device tables and VariationIndex values, so a GPOS kern does not follow the axes. The
#     ItemVariationStore reader for it already exists (src/hvar.cyr); what is missing is GDEF.
#     docs/development/roadmap.md pins it.
#
# ⚠ ALLOCATION. The `kern` feature's lookups are resolved ONCE, on the first query, into one
# sd_alloc of REKHA_GPOS_MAXLOOKUP x 8 bytes — the same lazy shape `rekha_var_set_axis` and gvar's
# scratch use, so `rekha_font_open` still costs exactly REKHA_FONT_SIZE and a font nobody asks
# about kerning never pays.

var REKHA_TAG_GPOS = 0x47504F53;   # 'GPOS'
var REKHA_TAG_KERN_FEAT = 0x6B65726E;   # 'kern', as a feature tag
# Deduplicated lookups behind every `kern` feature in one font. Real fonts use one or two.
var REKHA_GPOS_MAXLOOKUP = 64;

fn rekha_gpos_resolve(f): i64 {
    store64(f + 576, 0);
    store64(f + 584, 0);
    store64(f + 592, 0);
    store64(f + 600, 0 - 1);                             # -1 = the lookups are not resolved yet
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_GPOS, &c);
    if (t == 0) { return 0; }
    var end = t + load64(&c);
    if (t + 10 > end) { return 0; }
    var buf = load64(f);
    if (rekha_rd_u16(buf, t) != 1) { return 0; }
    store64(f + 576, t);
    store64(f + 584, end);
    return 1;
}

# 2 x the number of set bits in the low byte of a valueFormat: the record's size in bytes.
fn rekha_gpos_vlen(vf): i64 {
    var n = 0;
    var i = 0;
    while (i < 8) {
        if ((vf >> i & 1) != 0) { n = n + 1; }
        i = i + 1;
    }
    return n * 2;
}

# The XAdvance of a value record at `at`, or 0 when the format does not carry one.
fn rekha_gpos_xadv(font, at, vf, end): i64 {
    if ((vf & 4) == 0) { return 0; }
    var off = 0;
    if ((vf & 1) != 0) { off = off + 2; }
    if ((vf & 2) != 0) { off = off + 2; }
    if (at + off + 2 > end) { return 0; }
    return rekha_rd_i16(load64(font), at + off);
}

# The coverage index of `g` in the Coverage table at `cov`, or -1.
fn rekha_gpos_coverage(font, cov, g, end): i64 {
    var buf = load64(font);
    if (cov + 4 > end) { return 0 - 1; }
    var fmt = rekha_rd_u16(buf, cov);
    var n = rekha_rd_u16(buf, cov + 2);
    if (fmt == 1) {
        if (cov + 4 + n * 2 > end) { return 0 - 1; }
        var lo = 0;
        var hi = n - 1;
        while (lo <= hi) {
            var mid = lo + (hi - lo) / 2;
            var v = rekha_rd_u16(buf, cov + 4 + mid * 2);
            if (v == g) { return mid; }
            if (v < g) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return 0 - 1;
    }
    if (fmt != 2) { return 0 - 1; }
    if (cov + 4 + n * 6 > end) { return 0 - 1; }
    var lo2 = 0;
    var hi2 = n - 1;
    while (lo2 <= hi2) {
        var mid2 = lo2 + (hi2 - lo2) / 2;
        var r = cov + 4 + mid2 * 6;
        var s = rekha_rd_u16(buf, r);
        var e = rekha_rd_u16(buf, r + 2);
        if (g < s) {
            hi2 = mid2 - 1;
        } else {
            if (g > e) {
                lo2 = mid2 + 1;
            } else {
                return rekha_rd_u16(buf, r + 4) + g - s;
            }
        }
    }
    return 0 - 1;
}

# The class of `g` in the ClassDef at `cd`. ⛔ 0 is a REAL class — "everything not listed" — and
# PairPos format 2 has a row and a column for it, so an unlisted glyph is class 0 and not a miss.
fn rekha_gpos_class(font, cd, g, end): i64 {
    var buf = load64(font);
    if (cd + 4 > end) { return 0; }
    var fmt = rekha_rd_u16(buf, cd);
    if (fmt == 1) {
        if (cd + 6 > end) { return 0; }
        var start = rekha_rd_u16(buf, cd + 2);
        var n = rekha_rd_u16(buf, cd + 4);
        if (cd + 6 + n * 2 > end) { return 0; }
        if (g < start) { return 0; }
        if (g >= start + n) { return 0; }
        return rekha_rd_u16(buf, cd + 6 + (g - start) * 2);
    }
    if (fmt != 2) { return 0; }
    var nr = rekha_rd_u16(buf, cd + 2);
    if (cd + 4 + nr * 6 > end) { return 0; }
    var lo = 0;
    var hi = nr - 1;
    while (lo <= hi) {
        var mid = lo + (hi - lo) / 2;
        var r = cd + 4 + mid * 6;
        var s = rekha_rd_u16(buf, r);
        var e = rekha_rd_u16(buf, r + 2);
        if (g < s) {
            hi = mid - 1;
        } else {
            if (g > e) {
                lo = mid + 1;
            } else {
                return rekha_rd_u16(buf, r + 4);
            }
        }
    }
    return 0;
}

# One PairPos subtable at `sub`. Returns 1 and stores the first glyph's XAdvance in `out` when the
# pair matches here, else 0.
fn rekha_gpos_pairpos(font, sub, l, r, end, out): i64 {
    store64(out, 0);
    var buf = load64(font);
    if (sub + 10 > end) { return 0; }
    var fmt = rekha_rd_u16(buf, sub);
    var cov = sub + rekha_rd_u16(buf, sub + 2);
    if (cov < sub) { return 0; }
    var vf1 = rekha_rd_u16(buf, sub + 4);
    var vf2 = rekha_rd_u16(buf, sub + 6);
    var v1 = rekha_gpos_vlen(vf1);
    var v2 = rekha_gpos_vlen(vf2);
    var ci = rekha_gpos_coverage(font, cov, l, end);
    if (ci < 0) { return 0; }

    if (fmt == 1) {
        var nps = rekha_rd_u16(buf, sub + 8);
        if (ci >= nps) { return 0; }
        if (sub + 10 + nps * 2 > end) { return 0; }
        var ps = sub + rekha_rd_u16(buf, sub + 10 + ci * 2);
        if (ps < sub) { return 0; }
        if (ps + 2 > end) { return 0; }
        var n = rekha_rd_u16(buf, ps);
        var rec = 2 + v1 + v2;
        if (ps + 2 + n * rec > end) { return 0; }
        # ⭐ SORTED BY secondGlyph, so this is a binary search and not a scan — a class-less font
        # puts thousands of records in one PairSet.
        var lo = 0;
        var hi = n - 1;
        while (lo <= hi) {
            var mid = lo + (hi - lo) / 2;
            var at = ps + 2 + mid * rec;
            var g = rekha_rd_u16(buf, at);
            if (g == r) {
                store64(out, rekha_gpos_xadv(font, at + 2, vf1, end));
                return 1;
            }
            if (g < r) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return 0;
    }

    if (fmt != 2) { return 0; }
    if (sub + 16 > end) { return 0; }
    var cd1 = sub + rekha_rd_u16(buf, sub + 8);
    var cd2 = sub + rekha_rd_u16(buf, sub + 10);
    if (cd1 < sub || cd2 < sub) { return 0; }
    var n1 = rekha_rd_u16(buf, sub + 12);
    var n2 = rekha_rd_u16(buf, sub + 14);
    var c1 = rekha_gpos_class(font, cd1, l, end);
    var c2 = rekha_gpos_class(font, cd2, r, end);
    if (c1 >= n1 || c2 >= n2) { return 0; }
    var rsz = v1 + v2;
    if (rsz == 0) { return 0; }
    if (n1 * n2 > 0) {
        if (rsz > (end - sub - 16) / (n1 * n2)) { return 0; }
    }
    var at2 = sub + 16 + (c1 * n2 + c2) * rsz;
    if (at2 + rsz > end) { return 0; }
    store64(out, rekha_gpos_xadv(font, at2, vf1, end));
    return 1;
}

# Resolve every `kern` feature's lookups, once, into the font's cache. Returns the count.
fn rekha_gpos_lookups(font): i64 {
    var n = load64(font + 600);
    if (n >= 0) { return n; }
    store64(font + 600, 0);
    var t = load64(font + 576);
    if (t == 0) { return 0; }
    var end = load64(font + 584);
    var buf = load64(font);
    var fl = t + rekha_rd_u16(buf, t + 6);
    var ll = t + rekha_rd_u16(buf, t + 8);
    if (fl < t || ll < t) { return 0; }
    if (fl + 2 > end || ll + 2 > end) { return 0; }
    var nf = rekha_rd_u16(buf, fl);
    if (fl + 2 + nf * 6 > end) { return 0; }
    var nl = rekha_rd_u16(buf, ll);
    if (ll + 2 + nl * 2 > end) { return 0; }
    var arr = sd_alloc(REKHA_GPOS_MAXLOOKUP * 8);
    if (arr == 0) { return 0; }
    store64(font + 592, arr);

    var cnt = 0;
    var i = 0;
    while (i < nf) {
        var fr = fl + 2 + i * 6;
        if (rekha_rd_u32(buf, fr) == REKHA_TAG_KERN_FEAT) {
            var fe = fl + rekha_rd_u16(buf, fr + 4);
            if (fe >= fl && fe + 4 <= end) {
                var nli = rekha_rd_u16(buf, fe + 2);
                if (fe + 4 + nli * 2 <= end) {
                    var j = 0;
                    while (j < nli) {
                        var li = rekha_rd_u16(buf, fe + 4 + j * 2);
                        if (li < nl) {
                            var lo = ll + rekha_rd_u16(buf, ll + 2 + li * 2);
                            # ⛔ DEDUPLICATED: two scripts normally carry two `kern` FeatureRecords
                            # pointing at the SAME lookups, and applying one twice doubles a kern.
                            var seen = 0;
                            var k = 0;
                            while (k < cnt) {
                                if (load64(arr + k * 8) == lo) { seen = 1; }
                                k = k + 1;
                            }
                            if (seen == 0 && cnt < REKHA_GPOS_MAXLOOKUP) {
                                if (lo >= ll && lo + 6 <= end) {
                                    store64(arr + cnt * 8, lo);
                                    cnt = cnt + 1;
                                }
                            }
                        }
                        j = j + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    store64(font + 600, cnt);
    return cnt;
}

# @public — 1 when the font has a GPOS `kern` feature rekha can walk, else 0.
public fn rekha_gpos_kern_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 576) == 0) { return 0; }
    if (rekha_gpos_lookups(font) < 1) { return 0; }
    return 1;
}

# @public — the horizontal kerning adjustment for (l, r) from GPOS alone, in design units.
# ⛔ Lookups ACCUMULATE — each is a separate pass in a real shaper — while within one lookup the
# FIRST subtable that matches wins and the rest are not consulted. Getting that backwards either
# drops a font's kerning or applies it twice.
public fn rekha_gpos_kern_pair(font, l, r): i64 {
    if (font == 0) { return 0; }
    if (l < 0 || r < 0) { return 0; }
    if (l > 65535 || r > 65535) { return 0; }
    var t = load64(font + 576);
    if (t == 0) { return 0; }
    var n = rekha_gpos_lookups(font);
    if (n < 1) { return 0; }
    var end = load64(font + 584);
    var buf = load64(font);
    var arr = load64(font + 592);
    var total = 0;
    var i = 0;
    while (i < n) {
        var lk = load64(arr + i * 8);
        var ty = rekha_rd_u16(buf, lk);
        var ns = rekha_rd_u16(buf, lk + 4);
        if (lk + 6 + ns * 2 <= end) {
            var s = 0;
            var done = 0;
            while (s < ns) {
                if (done == 0) {
                    var sub = lk + rekha_rd_u16(buf, lk + 6 + s * 2);
                    var ty2 = ty;
                    if (ty == 9) {
                        # the extension wrapper: a real type and a 32-bit offset from HERE
                        if (sub + 8 <= end) {
                            if (rekha_rd_u16(buf, sub) == 1) {
                                ty2 = rekha_rd_u16(buf, sub + 2);
                                var d = rekha_rd_u32(buf, sub + 4);
                                sub = sub + d;
                            } else {
                                ty2 = 0;
                            }
                        } else {
                            ty2 = 0;
                        }
                    }
                    if (ty2 == 2 && sub >= t && sub < end) {
                        var v: i64[1];
                        if (rekha_gpos_pairpos(font, sub, l, r, end, &v) != 0) {
                            total = total + load64(&v);
                            done = 1;
                        }
                    }
                }
                s = s + 1;
            }
        }
        i = i + 1;
    }
    return total;
}

# --- kern.cyr ---

# `kern`: the legacy pair-kerning table (0.6.5).
#
# kern.cyr — rekha owns advance widths, so rekha is what decides inter-glyph spacing, and through
# 0.6.4 every pair was placed at its raw advance. This is the first half of fixing that: the legacy
# `kern` table, which is a sorted array of (left glyph, right glyph, adjustment) and nothing more.
# ⭐ THE OTHER HALF IS GPOS, and 0.6.6 shipped it: src/gpos.cyr. `rekha_kern_pair` now prefers it,
# because a face carrying both usually says the same thing twice — for shapers that read only one
# — and adding them would double every pair. `rekha_kern_source` says which answered, and
# `rekha_kern_table_pair` below is this table alone for a consumer that wants to see both.
#
# ⛔ TWO INCOMPATIBLE TABLES SHARE THE TAG, and telling them apart is the first thing this does.
# Microsoft's is version **0** — a u16 version, a u16 subtable count, and subtables with a u16
# length and a u16 coverage. Apple's is version **0x00010000** — a Fixed version, a u32 count, and
# subtables with a u32 length, a coverage BYTE and a separate format byte. Reading one as the other
# does not fail; it walks into the middle of a pair array.
#
#   Microsoft subtable: version u16 · length u16 · coverage u16
#     coverage bit 0 HORIZONTAL · bit 1 MINIMUM · bit 2 CROSS_STREAM · bit 3 OVERRIDE ·
#     the format is the high byte.
#   Apple subtable: length u32 · coverage u8 · format u8 · tupleIndex u16
#     coverage bit 7 VERTICAL · bit 6 CROSS_STREAM · bit 5 VARIATION.
#   Format 0 body, in both: nPairs u16 · searchRange u16 · entrySelector u16 · rangeShift u16 ·
#     then nPairs of (left u16, right u16, value i16), SORTED by (left, right).
#
# ⭐ THE SORT IS THE LOOKUP. The array is ordered by the pair packed as (left << 16) | right, so a
# binary search finds a pair in log2(nPairs) reads — a dozen for a 4,000-pair table — and the
# search range fields the font supplies are ignored, because they are a font's arithmetic about
# rekha's array and rekha can do its own.
#
# ⛔ WHAT IS SKIPPED, subtable by subtable, rather than refusing the table:
#   - a format other than 0. Format 2's two-dimensional class array is rare and is not read; a font
#     carrying both still kerns from its format 0 subtables.
#   - anything not HORIZONTAL, and anything CROSS_STREAM, which moves text off the baseline.
#   - ⛔ MINIMUM subtables. That coverage bit means the value is a FLOOR on the pair's spacing, not
#     an adjustment to it, and adding it as though it were an adjustment is how a minimum becomes a
#     visible gap. rekha applies none and says so here.
# OVERRIDE is honoured: such a subtable REPLACES what earlier ones accumulated, and only when the
# pair is actually in it — an absent pair overrides nothing.
#
# ⛔ WHAT IS REFUSED (the table is absent, and every pair is 0): a version that is neither form, a
# header or subtable outside the table, a subtable shorter than its own header, or a pair array
# that does not fit. ⚠ The walk is capped at REKHA_KERN_MAXSUB subtables however many the font
# declares, because a font chooses that number.

var REKHA_TAG_KERN = 0x6B65726E;   # 'kern'
var REKHA_KERN_MAXSUB = 256;

fn rekha_kern_resolve(f): i64 {
    store64(f + 552, 0);
    store64(f + 560, 0);
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_KERN, &c);
    if (t == 0) { return 0; }
    var end = t + load64(&c);
    if (t + 4 > end) { return 0; }
    var buf = load64(f);
    var v = rekha_rd_u16(buf, t);
    if (v == 0) {
        store64(f + 552, t);
        store64(f + 560, end);
        return 1;
    }
    # Apple's, whose version is a Fixed 1.0 and whose count is a u32
    if (rekha_rd_u32(buf, t) == 0x00010000) {
        if (t + 8 > end) { return 0; }
        store64(f + 552, t);
        store64(f + 560, end);
        return 1;
    }
    return 0;
}

# @public — 1 when the font carries a `kern` table rekha can walk, else 0. ⚠ 0 does NOT mean the
# font has no kerning: a modern face keeps it in GPOS. `rekha_kern_source` is the question to ask.
public fn rekha_kern_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 552) == 0) { return 0; }
    return 1;
}

# The adjustment for (l, r) in one format 0 body at `at`, bounded by `sube`. Returns 1 and stores
# the value in `out` when the pair is there, else 0.
fn rekha_kern_f0(font, at, sube, l, r, out): i64 {
    store64(out, 0);
    var buf = load64(font);
    if (at + 8 > sube) { return 0; }
    var n = rekha_rd_u16(buf, at);
    if (n < 1) { return 0; }
    var pairs = at + 8;
    if (pairs + n * 6 > sube) { return 0; }
    var key = (l << 16) | r;
    var lo = 0;
    var hi = n - 1;
    while (lo <= hi) {
        var mid = lo + (hi - lo) / 2;
        var p = pairs + mid * 6;
        var k = (rekha_rd_u16(buf, p) << 16) | rekha_rd_u16(buf, p + 2);
        if (k == key) {
            store64(out, rekha_rd_i16(buf, p + 4));
            return 1;
        }
        if (k < key) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return 0;
}

# @public — the adjustment for (l, r) from the legacy `kern` TABLE alone, in design units. Usually
# negative: kerning almost always pulls a pair together. 0 when the font has no `kern`, when the
# pair is not in it, or when every subtable that could have carried it is one rekha skips.
# ⚠ `rekha_kern_pair` is the one to call: since 0.6.6 it prefers GPOS, which is where a modern
# font keeps its kerning. This is the table alone, for a consumer that wants to see both.
public fn rekha_kern_table_pair(font, l, r): i64 {
    if (rekha_kern_present(font) == 0) { return 0; }
    if (l < 0 || r < 0) { return 0; }
    if (l > 65535 || r > 65535) { return 0; }
    var buf = load64(font);
    var t = load64(font + 552);
    var end = load64(font + 560);
    var apple = 0;
    var n = rekha_rd_u16(buf, t + 2);
    var at = t + 4;
    if (rekha_rd_u32(buf, t) == 0x00010000) {
        apple = 1;
        n = rekha_rd_u32(buf, t + 4);
        at = t + 8;
    }
    if (n > REKHA_KERN_MAXSUB) { n = REKHA_KERN_MAXSUB; }
    var total = 0;
    var i = 0;
    while (i < n) {
        var hdr = 6;
        if (apple != 0) { hdr = 8; }
        if (at + hdr > end) { return total; }
        var slen = 0;
        var fmt = 0;
        var horiz = 0;
        var cross = 0;
        var minimum = 0;
        var over = 0;
        if (apple != 0) {
            slen = rekha_rd_u32(buf, at);
            var cov = load8(buf + at + 4);
            fmt = load8(buf + at + 5);
            if ((cov & 128) == 0) { horiz = 1; }
            if ((cov & 64) != 0) { cross = 1; }
        } else {
            slen = rekha_rd_u16(buf, at + 2);
            var cw = rekha_rd_u16(buf, at + 4);
            fmt = (cw >> 8) & 255;
            if ((cw & 1) != 0) { horiz = 1; }
            if ((cw & 2) != 0) { minimum = 1; }
            if ((cw & 4) != 0) { cross = 1; }
            if ((cw & 8) != 0) { over = 1; }
        }
        # ⛔ A subtable that does not declare at least its own header cannot be stepped over, and a
        # zero-length one would walk this loop forever.
        if (slen < hdr) { return total; }
        if (at + slen > end) { return total; }
        if (fmt == 0 && horiz != 0 && cross == 0 && minimum == 0) {
            var v: i64[1];
            if (rekha_kern_f0(font, at + hdr, at + slen, l, r, &v) != 0) {
                if (over != 0) {
                    total = load64(&v);
                } else {
                    total = total + load64(&v);
                }
            }
        }
        at = at + slen;
        i = i + 1;
    }
    return total;
}

# floor(num / den) for den > 0, computed without ever dividing a negative — so it does not depend
# on which way the language truncates.
fn rekha_kern_floordiv(num, den): i64 {
    if (num >= 0) { return num / den; }
    var m = 0 - num;
    var q = m / den;
    if (q * den != m) { q = q + 1; }
    return 0 - q;
}

# @public — where the font keeps its kerning: 0 neither, 1 the legacy `kern` table, 2 GPOS.
# ⛔ NOT BOTH. A face carrying a GPOS `kern` feature AND a legacy table usually says the same thing
# twice, for shapers that read only one; adding them would double every pair. GPOS wins, which is
# what HarfBuzz does and what a font that ships both expects.
public fn rekha_kern_source(font): i64 {
    if (font == 0) { return 0; }
    if (rekha_gpos_kern_present(font) != 0) { return 2; }
    if (rekha_kern_present(font) != 0) { return 1; }
    return 0;
}

# @public — THE kerning adjustment for (l, r), in design units, from wherever this font keeps it.
# ⭐ Since 0.6.6 that is GPOS when the font has a `kern` feature there, and the legacy table
# otherwise. `rekha_kern_source` says which answered.
public fn rekha_kern_pair(font, l, r): i64 {
    if (rekha_gpos_kern_present(font) != 0) { return rekha_gpos_kern_pair(font, l, r); }
    return rekha_kern_table_pair(font, l, r);
}

# @public — the same adjustment in whole pixels at `px_size`, rounded HALF UP as every other
# rounding in rekha is. ⚠ Half up, not half away from zero: -1.5 px comes back -1.
public fn rekha_kern_pair_px(font, l, r, px_size): i64 {
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var v = rekha_kern_pair(font, l, r);
    if (v == 0) { return 0; }
    return rekha_kern_floordiv(v * px_size + upem / 2, upem);
}

# @public — the adjustment between two CHARACTERS, mapped through cmap. The convenience twin of
# rekha_char_advance, and 0 when either codepoint is unmapped.
public fn rekha_char_kern(font, cp1, cp2): i64 {
    var a = rekha_char_to_glyph(font, cp1);
    if (a == 0) { return 0; }
    var b = rekha_char_to_glyph(font, cp2);
    if (b == 0) { return 0; }
    return rekha_kern_pair(font, a, b);
}

# --- hint.cyr ---

# TrueType hinting, part three: the glyph zone, and a hinted outline (0.8.0 – v0.8.2).
#
# hint.cyr — the bytecode interpreter a TrueType face carries its own hints in. `fpgm` holds the
# font's function library, `prep` the program run once per size, `cvt ` the control values both
# read, and every glyph may carry a program of its own. Together they are the last thing between
# rekha's outlines and a legible 9-pixel glyph, and the standing roadmap item since 0.4.x.
#
# ⭐ v0.8.2 IS THE HINTED GLYPH. 0.8.0 built the interpreter and ran the font program; 0.8.1 added
# the two zones, every point instruction but IUP, and `prep` once per size inside `rekha_hint_ctx`.
# This release loads a glyph into zone 1 — simple or composite, in place, allocating nothing — with
# its four phantom points, runs its program under FreeType's glyph-range rules, interpolates the
# untouched points (IUP), assembles composites the way FreeType assembles them (every component
# hinted on its own, transformed and offset in pixels, the composite's program run at scale 1.0),
# and answers the outline and its advance through `rekha_hint_glyph`, `rekha_hint_outline`,
# `rekha_hint_to_sdpath` and `rekha_hint_advance_px`. Every instruction of the machine is
# implemented; nothing in it answers REKHA_ERR_UNSUPPORTED any more.
# ⭐ THE REFERENCE IS FreeType 2.14.3's CLASSIC INTERPRETER (GETINFO version 35), non-pedantic,
# grayscale, square pixels — the library on the development host, and the one every oracle script
# under scripts/ links through ctypes. Every point instruction here agrees with it point for point
# on programs/hint_unit_vectors.cyr, and every hinted glyph on programs/hint_glyph_vectors.cyr —
# FreeType's own hinted outlines of the embedded face — and on the whole face through
# scripts/hint_glyph_diff.py. THE DEPARTURES, each stated at its site and pinned in
# docs/development/roadmap.md:
#   · rekha REFUSES what FreeType silently tolerates — an index outside a zone, a control value
#     outside the table, a short stack — and every such site names its instruction; and a refusal
#     inside ANY program of a glyph load unhints the WHOLE glyph (rekha_hint_glyph), where FreeType
#     outside its pedantic mode keeps the partially hinted points and carries on;
#   · a point index at or above 65536 is refused where FreeType's 16-bit casts wrap it onto a real
#     point (rekha_hint_pt_ok), and a backward jump to before a function's own start is refused
#     where FreeType runs whatever bytes precede the body (rekha_hint_exec);
#   · before every `prep` the twilight zone's tags and font-unit positions are zeroed with its
#     positions, and its per-run bound has no +4 band above maxTwilightPoints
#     (rekha_hint_run_prep, rekha_hint_twilight_bound);
#   · a face whose `prep` is absent or empty starts each size from the defaults, where FreeType
#     hands it a stale graphics state (rekha_hint_run_prep);
#   · FreeType's LOOPCALL and backward-jump budgets, its call depth of 32 and its composite
#     recursion cap of 100 are not modelled: rekha has one instruction budget, a call depth of 64
#     and the outline loader's own caps (rekha_hint_exec, rekha_hint_call, rekha_hint_load);
#   · the scan-type bits FreeType ORs into a hinted outline's first tag byte are not reproduced,
#     `hdmx` is not read (rekha_hint_advance_px), a variable instance is hinted off-reference and
#     an axis change re-runs `prep` whether or not the face has a `cvar` (rekha_hint_glyph,
#     rekha_hint_ctx), and the SHZ of a nested composite's program is clamped where FreeType
#     writes past its zone (rekha_hint_op_shz).
# ⭐ AND THE FONT PROGRAM IS REACHABLE WITHOUT A GLYPH, because an `FDEF` body is SCANNED, not
# executed. Liberation Sans's real 1,972-byte `fpgm` reaches its top level with exactly THREE
# opcodes — NPUSHB, FDEF and the ENDF that closes each body — and rekha runs it and defines all 71
# of its functions. Its 835-byte `prep` then CALLs five of them 65 times at every size and
# reaches no point instruction at all; the point group is measured on the unit programs and on
# every glyph program of the face.
#
# The three tables, and the one that says whether to bother:
#   cvt  — an array of i16 in FONT UNITS. Scaled to F26Dot6 at a ppem and then owned by the
#          interpreter: `prep` rewrites entries through WCVTP / WCVTF / DELTAC, so the scaled copy
#          is per-size state and never a view onto the font bytes.
#   fpgm — one program, run ONCE per face. Almost entirely FDEFs.
#   prep — the control-value program, run once per SIZE by rekha_hint_run_prep, after fpgm and
#          before any glyph, on a size whose control values, storage, twilight zone and graphics
#          state were just rebuilt for it.
#   gasp — not code: a ppem-ordered table saying at which sizes to grid-fit and at which to smooth.
#          The first question a consumer of hinting asks, and rekha answers it at 0.8.0.
#
# ⚠ ppem IS THE ONLY SIZE rekha HAS. The interpreter's x and y scales are equal, MPPEM answers the
# same number on both axes, and MPS answers the ppem too, as the classic interpreter does; rekha
# carries no dpi. A consumer with non-square pixels cannot express that here.
# ⛔ WHY THE ROUNDING DIVERGES FROM THE REST OF rekha, DELIBERATELY. Everywhere else rekha rounds
# HALF UP (`sd_asr(v + 32768, 16)`), which is fontTools' `otRound` and what every differential
# since 0.5.0 was measured against. This file rounds HALF AWAY FROM ZERO, because its reference is
# not fontTools but the interpreter a hinted glyph was drawn against — FreeType's `FT_MulFix` and
# `FT_DivFix` both take the absolute value, add a half, and re-sign. The two differ only when a
# NEGATIVE value lands exactly on .5, and a `cvt ` full of descender depths is exactly where that
# happens. One 1/64 pixel there moves a point, so the reference wins over the house convention.
# ⚠ AND ONE ROUNDING IN THIS FILE IS NEITHER: the phantom points, a composite's offsets and the
# advance a consumer reads are rounded with FreeType's FT_PIX_ROUND, `(v + 32) & -64`, which is
# FLOOR-based — -160 becomes -128, not -192. See rekha_hint_pix_round.
#
# ⭐ THREE OPERAND ORDERS WERE SETTLED AGAINST REAL FONTS, because the published specs contradict
# each other on whether a "Pops:" list is written top-first or push-first:
#   LOOPCALL — the FUNCTION is on top, the count below. A `prep` in the host corpus pushes
#     `0 0 65 49 33 5 0` then LOOPCALL: as (f=0, count=5) that consumes the five values below and
#     leaves nothing, and as (count=0, f=5) it calls nothing and the seven pushes are dead.
#   DELTAC — after the pair count, each pair is (exception spec, then INDEX on top). A host `prep`
#     pushes `64 21` against a 37-entry `cvt `, and `63 18` against a 34-entry one; the other
#     reading indexes entry 64 of 37.
#   WCVTP / WS — the VALUE is on top and the location below, from `DUP RCVT RTG ROUND WCVTP` in
#     Liberation Sans's own fpgm, which can only mean "write the rounded value to the index under
#     it".
# ⚠ INSTCTRL's order (selector on top) is NOT observed: the one real site pushes `1 1`. It follows
# FreeType and is marked here rather than presented as measured.

# ================================================================
# Tables, caps and the rounding modes
# ================================================================
var REKHA_TAG_CVT  = 0x63767420;   # 'cvt '
var REKHA_TAG_FPGM = 0x6670676D;   # 'fpgm'
var REKHA_TAG_PREP = 0x70726570;   # 'prep'
var REKHA_TAG_GASP = 0x67617370;   # 'gasp'

# ⛔ EVERY CAP BELOW IS A REFUSAL, NOT A CLAMP. A font declaring more than one of these gets no
# interpreter at all and `rekha_hint_error` names which cap it tripped, because an interpreter
# running with a stack shorter than the font asked for silently computes a different glyph.
# The numbers are an order of magnitude above the host corpus: Liberation Sans declares a 676-slot
# stack, 47 storage locations, 92 functions, 0 instruction definitions and 324 control values.
var REKHA_HINT_MAXSTACK = 8192;
var REKHA_HINT_MAXSTORE = 8192;
var REKHA_HINT_MAXFDEF  = 4096;
var REKHA_HINT_MAXIDEF  = 256;
var REKHA_HINT_MAXCVT   = 16384;
# A CALL nest deeper than this, or a program longer than this many instructions, is refused. Both
# are halting guards: JMPR can jump backwards and LOOPCALL can be handed any count.
var REKHA_HINT_MAXDEPTH = 64;
var REKHA_HINT_BUDGET   = 1000000;
# ⚠ TrueType is specified on 32-bit signed integers. rekha computes in i64 and CLAMPS every
# arithmetic result to that range instead of wrapping: a wrap is never what a font meant, and the
# clamp is what keeps the products in rekha_hint_muldiv inside i64.
var REKHA_HINT_CLAMP = 2147483647;

# @public — the eight rounding states, the value `rekha_hint_gs(ctx, REKHA_GS_ROUND)` answers.
public var REKHA_RND_GRID    = 0;   # RTG  — to the nearest pixel
public var REKHA_RND_HALF    = 1;   # RTHG — to the nearest half pixel
public var REKHA_RND_DOUBLE  = 2;   # RTDG — to the nearest half pixel, on a half-pixel grid
public var REKHA_RND_DOWN    = 3;   # RDTG
public var REKHA_RND_UP      = 4;   # RUTG
public var REKHA_RND_OFF     = 5;   # ROFF — no rounding at all
public var REKHA_RND_SUPER   = 6;   # SROUND
public var REKHA_RND_SUPER45 = 7;   # S45ROUND

# The two grid periods SROUND and S45ROUND decompose, in 1/16384 pixel so the 45-degree one keeps
# its precision: 0x4000 is 1.0 pixel and 0x2D41 / 16384 = 0.70709, which is sqrt(2)/2. Both are
# brought down to F26Dot6 (0x4000 -> 64, 0x2D41 -> 45) once period, phase and threshold are fixed.
var REKHA_HINT_GRID   = 0x4000;
var REKHA_HINT_GRID45 = 0x2D41;

# ================================================================
# RekhaHintCtx — the execution context. ONE sd_alloc, header then arrays inline, so its cost is a
# number a test can assert: REKHA_HINT_HDR + stack * 8 + storage * 8 + fdefs * 32 + idefs * 32 +
# cvt * 8 + twilight * 48 + glyph points * 48 + contours * 8 + cvt * 8 + storage * 8 (the glyph
# load's private copies) + (twilight + 2 * glyph points + 7) & -8 (the two zones' tag bytes and the
# glyph zone's on-curve bytes, rounded up to 8), with stack = maxStackElements + max(maxStackElements
# / 2, 128), fdefs = max(64, maxFunctionDefs) and glyph points = the larger maxp point count + 4
# (36,384 for Liberation Sans, 7,624 for hint_test's synthetic face).
# ⚠ It is built LAZILY and cached on the font at +808, the same shape GPOS's lookup list uses, so
# `rekha_font_open` still costs exactly REKHA_FONT_SIZE and a consumer that never hints never pays.
# ⛔ ONE CONTEXT PER FONT HANDLE, and changing ppem REBUILDS the per-size state in place rather
# than allocating again — `sd_alloc` has no free, and a text run that walks sizes would otherwise
# leak one context per size. The same "one handle, one thread" obligation 0.7.0 wrote down applies.
# ================================================================
var HC_FONT     = 0;     # the RekhaFont this belongs to
var HC_BUF      = 8;     # its byte buffer, cached
var HC_PPEM     = 16;    # the size this context is scaled for; 0 = not scaled yet
var HC_SCALE    = 24;    # 16.16 multiplier taking FONT UNITS to F26Dot6
var HC_ERR      = 32;    # REKHA_OK, or why the last run refused
var HC_DETAIL   = 40;    # a static cstring naming where; never allocated, never owned
var HC_SP       = 48;    # stack depth
var HC_STACK    = 56;
var HC_STKCAP   = 64;
var HC_STORE    = 72;
var HC_STORECAP = 80;
var HC_FDEF     = 88;    # 4 i64 per function: ITS NUMBER, body start, body end, AND THE BUFFER
# THEY ARE IN — a function is a range into the bytes of the program that defined it, and `fpgm`
# is not the only program there is. ⭐ THE TABLE IS A LIST OF RECORDS, NOT AN ARRAY INDEXED BY
# NUMBER: FreeType keeps (opc, start, end, range) records, caps how many DISTINCT functions a font
# may define at maxFunctionDefs, and lets the numbers themselves run to 0xFFFF
# (ref2143/ttinterp.c:3266-3323 Ins_FDEF; :3395-3465 Ins_CALL looks a number up). A font whose
# maxp says 3 and whose fpgm defines 0, 1 and 100 is within its declaration. HC_FDEFN counts them.
var HC_FDEFCAP  = 96;
var HC_IDEF     = 104;   # 4 i64 per definition: opcode, body start, body end, buffer
var HC_IDEFCAP  = 112;
var HC_IDEFN    = 120;
var HC_CVT      = 128;   # the SCALED control values, in F26Dot6. Owned, rewritable, per size
var HC_CVTCAP   = 136;
var HC_BUDGET   = 144;   # instructions left in the current run
var HC_DEPTH    = 152;   # current CALL nesting
var HC_FPGMOK   = 160;   # 1 once the font program has run for this face
var HC_BYTES    = 168;   # the allocation's own size, so programs/hint_test.cyr can pin it
# ---- the graphics state ----
# ⚠ The vectors are F2Dot14 (16384 = 1.0), the distances F26Dot6 (64 = one pixel), and the zone,
# reference-point and loop fields plain integers. The setters live in rekha_hint_op_gs and the
# readers in the point group below it: zp0..zp2 are validated where they are set and trusted
# where they are used.
var HC_PVX = 176;  var HC_PVY = 184;     # projection vector
var HC_FVX = 192;  var HC_FVY = 200;     # freedom vector
var HC_DVX = 208;  var HC_DVY = 216;     # dual projection vector
var HC_RP0 = 224;  var HC_RP1 = 232;  var HC_RP2 = 240;
var HC_ZP0 = 248;  var HC_ZP1 = 256;  var HC_ZP2 = 264;
var HC_LOOP     = 272;
var HC_RSTATE   = 280;
var HC_PERIOD   = 288;  var HC_PHASE = 296;  var HC_THRESH = 304;
var HC_MINDIST  = 312;
var HC_CVTCUT   = 320;
var HC_SWCUT    = 328;  var HC_SWVAL = 336;
var HC_AUTOFLIP = 344;
var HC_DBASE    = 352;  var HC_DSHIFT = 360;
var HC_INSTCTL  = 368;
var HC_SCANCTL  = 376;  var HC_SCANTYPE = 384;
# ---- the two zones (0.8.1) ----
# ⛔ THERE ARE EXACTLY TWO AND THE SPEC NAMES THEM: zone 0 is the TWILIGHT zone, `maxTwilightPoints`
# scratch points that belong to no contour and start at the origin, and zone 1 is the GLYPH zone,
# the outline being hinted plus its four phantom points. `zp0` / `zp1` / `zp2` choose which one
# each operand of a point instruction is read through, which is why the two are laid out
# identically and reached by index rather than by name.
var HC_ZONE0 = 392;     # the twilight zone descriptor, ZN_SIZE bytes
var HC_ZONE1 = 472;     # the glyph zone descriptor
var HC_GZCAP  = 552;    # points the glyph zone can hold, phantom points included
var HC_GZCCAP = 560;    # contours it can hold
var HC_GZGID  = 568;    # the gid currently loaded into it, or -1
# ---- the standing refusals, the code range, and the move vector ----
# ⛔ A REFUSED FONT PROGRAM OR CONTROL-VALUE PROGRAM IS A PROPERTY OF THE FACE OR THE SIZE, not of
# the last run: FreeType keeps `bytecode_ready` / `cvt_ready` per size and fails every later load
# with the same error (ref2143/ttgload.c:2211-2212, 2257-2258). These four slots are what lets
# `rekha_hint_ctx` re-raise the same code and detail on every call for that size.
var HC_FPGMERR = 576;   # why `fpgm` refused, or REKHA_OK
var HC_FPGMDET = 584;
var HC_PREPERR = 592;   # why `prep` refused at this size, or REKHA_OK
var HC_PREPDET = 600;
# Which program is running: 0 none, 1 `fpgm`, 2 `prep`, 3 a program handed to rekha_hint_run, 4 a
# glyph's own program under rekha_hint_glyph. INSTCTRL binds only inside `prep`, GETINFO's
# grayscale bit is off inside `fpgm` (ref2143/ttinterp.c:4714-4718, ttgload.c:2248-2255), and the
# glyph range refuses FDEF / IDEF and writes private copies of the storage area and the control
# values (rekha_hint_op_mem), so several instructions have to know.
var HC_RANGE   = 608;
# ⭐ THE MOVE VECTOR, 16.16, recomputed whenever the projection or freedom vector changes. It is
# freedom / (freedom . projection) with three regimes (ref2143/ttinterp.c:2238-2262) and a
# selection saying whether the move is a plain add along x or y (HC_MVSEL 1 / 2) or the general
# per-axis multiply (0). See rekha_hint_movevec.
var HC_MVX     = 616;   var HC_MVY = 624;
var HC_MVSEL   = 632;
# How many function records HC_FDEF holds (0.8.1: the table stopped being indexed by number).
var HC_FDEFN   = 640;
# ---- the glyph load (v0.8.2) ----
# ⛔ THE POST-`prep` SNAPSHOT: the ten graphics-state fields `prep` may leave for a glyph program
# (HC_MINDIST .. HC_SCANTYPE, in that order), written by rekha_hint_run_prep's epilogue and copied
# over the defaults before EVERY program run of a glyph load — FreeType's `size->GS`, restored by
# TT_Run_Context (ref2143/ttinterp.c:7518) so that one component's SMD never reaches the next.
# INSTCTRL bit 2 in `prep` overwrites it with the defaults at the first glyph load and keeps it so
# until the next `prep` (ref2143/ttgload.c:2273-2274).
var HC_GSSAVE  = 648;   # 10 slots, to 728
# The scale MDRP and MD[0] multiply an original (font-unit) distance by: HC_SCALE for a simple
# glyph's program, 1.0 (0x10000) for a COMPOSITE's, whose "original" outline is the assembled,
# already-hinted one (ref2143/ttgload.c:796-803). HC_SCALE itself stays the size's scale for the
# control values, WCVTF, SSW and MPPEM.
var HC_MSCALE  = 728;
# ⛔ TWO COPIES OF THE CONTROL VALUES AND OF THE STORAGE AREA: the SIZE's, which `prep` wrote, and
# the GLYPH's, a copy made on the first WS / WCVTP / DELTAC of a glyph load and discarded at the
# next (ref2143/ttinterp.c:1320-1337, 2777-2795; TT_Load_Context :288-289 undoes it). HC_CVT and
# HC_STORE are the CURRENT pointers the instructions and the two readers go through; these four
# are the arrays themselves.
var HC_CVTS    = 736;   var HC_CVTG = 744;
var HC_STOS    = 752;   var HC_STOG = 760;
# The twilight bound of the load so far: FreeType lowers its per-run copy and never raises it
# within one load (ref2143/ttinterp.c:7450-7462), so a glyph load keeps the running minimum.
var HC_TWCAP   = 768;
# The RekhaOutline VIEW `rekha_hint_outline` answers: 48 bytes in place, its arrays zone 1's own
# (contour ends, cur x, cur y) and the on-curve bytes carved beside the tags. Its counts are
# rewritten by every load; its pointers never change.
var HC_VIEW    = 776;
# ⛔ FreeType's `first_point` OF THE RUNNING PROGRAM, CARRIED, NOT DERIVED: 0 for every run but a
# nested composite's own program, whose zone FreeType prepares at the composite's start point
# (ref2143/ttgload.c:1240 hands `start_point` to tt_prepare_zone; a simple component's program is
# prepared on the loader's current glyph with 0 at :914, whatever its base in the parent). Set by
# rekha_hint_run_glyph for the run and put back to 0 after; read by SHZ alone, which is the one
# instruction whose FreeType form (Ins_SHZ) depends on it. A slot, because the sub-zone's offset
# from zone 1's base cannot tell a simple component's run from a composite's — both run off-base.
var HC_FIRSTPT = 824;
var REKHA_HINT_HDR = 832;

# A zone descriptor. ⭐ THREE POSITIONS PER POINT, NOT ONE, and the distinction is load-bearing:
#   orus — the ORIGINAL position in FONT UNITS. `IP` and the dual projection measure here, because
#          measuring a proportion in already-rounded pixels compounds the rounding into the answer.
#   org  — the original position SCALED to F26Dot6, before any move. `MD[1]`, `GC[1]` and every
#          "distance in the original outline" read this.
#   cur  — where the point is now. This is what comes out.
# Plus one byte of tags per point: on-curve, and touched in x / in y, which is what IUP interpolates
# between and what `UTP` clears.
var ZN_N     = 0;       # points in this zone
var ZN_NC    = 8;       # contours (the twilight zone has none)
var ZN_ORUSX = 16;  var ZN_ORUSY = 24;
var ZN_ORGX  = 32;  var ZN_ORGY  = 40;
var ZN_CURX  = 48;  var ZN_CURY  = 56;
var ZN_TAGS  = 64;
var ZN_CTRS  = 72;
var ZN_SIZE  = 80;

# @public — the tag bits of a hinted point (`rekha_hint_point(.., REKHA_PT_TAGS)`, and
# `rekha_outline_on_curve` of the hinted view): on-curve, and touched in x / in y.
public var REKHA_TAG_ONCURVE = 1;
public var REKHA_TAG_TOUCHX  = 2;
public var REKHA_TAG_TOUCHY  = 4;

# @public — the fields of one point, for rekha_hint_point. ⚠ The first six ARE the zone
# descriptor's array order from ZN_ORUSX, so an index is an offset there too; the tag byte is the
# seventh.
public var REKHA_PT_ORUSX = 0;   # original position, FONT UNITS (twilight: 0)
public var REKHA_PT_ORUSY = 1;
public var REKHA_PT_ORGX = 2;    # original position scaled to F26Dot6
public var REKHA_PT_ORGY = 3;
public var REKHA_PT_CURX = 4;    # where the point is now, F26Dot6
public var REKHA_PT_CURY = 5;
public var REKHA_PT_TAGS = 6;    # REKHA_TAG_ONCURVE | TOUCHX | TOUCHY
public var REKHA_PT_COUNT = 7;

# ⛔ THE GLYPH ZONE IS SIZED BY THE FONT'S OWN `maxp`, NOT BY rekha's outline cap. Sizing it at
# REKHA_COMPOSITE_MAXP would cost 197 KB per context for a font whose largest glyph has 338 points.
# A glyph that turns out not to fit is REFUSED and says so, because a font whose maxp understates
# its own glyphs has contradicted itself.
var REKHA_HINT_MAXZONE = 4096;

# ================================================================
# Table resolution — called once by rekha_font_open, like every other module's _resolve.
# ⚠ A MISSING TABLE IS NOT A FAILED OPEN, as everywhere else in rekha: it is cached as absent and
# rekha_hint_present says so.
# ================================================================
fn rekha_hint_resolve(f): i64 {
    store64(f + 688, 0);   store64(f + 696, 0);
    store64(f + 704, 0);   store64(f + 712, 0);
    store64(f + 720, 0);   store64(f + 728, 0);
    store64(f + 736, 0);   store64(f + 744, 0);
    store64(f + 752, 0);
    store64(f + 760, 0);   store64(f + 768, 0);   store64(f + 776, 0);
    store64(f + 784, 0);   store64(f + 792, 0);   store64(f + 800, 0);
    store64(f + 808, 0);
    store64(f + 816, 0);   store64(f + 824, 0);
    var buf = load64(f);
    var c: i64[1];
    var t = rekha_find_table_len(f, REKHA_TAG_CVT, &c);
    if (t != 0) { store64(f + 688, t); store64(f + 696, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_FPGM, &c);
    if (t != 0) { store64(f + 704, t); store64(f + 712, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_PREP, &c);
    if (t != 0) { store64(f + 720, t); store64(f + 728, load64(&c)); }
    t = rekha_find_table_len(f, REKHA_TAG_GASP, &c);
    if (t != 0) {
        if (load64(&c) >= 4) { store64(f + 736, t); store64(f + 744, t + load64(&c)); }
    }
    # ⛔ maxp VERSION 1.0 IS WHAT MAKES THE INTERPRETER SIZEABLE. Version 0.5 is the CFF form and
    # carries numGlyphs alone: no stack depth, no function count, no storage. A TrueType face with
    # bytecode and a 0.5 maxp is malformed, and rekha answers "no hinting" rather than guessing
    # limits, because every guess is either a refusal the font did not earn or a buffer too small.
    var mx = rekha_find_table_len(f, REKHA_TAG_MAXP, &c);
    if (mx == 0) { return 0; }
    if (load64(&c) < 32) { return 0; }
    if (rekha_rd_u32(buf, mx) != 0x00010000) { return 0; }
    store64(f + 752, 1);
    store64(f + 760, rekha_rd_u16(buf, mx + 18));   # maxStorage
    store64(f + 768, rekha_rd_u16(buf, mx + 20));   # maxFunctionDefs
    store64(f + 776, rekha_rd_u16(buf, mx + 22));   # maxInstructionDefs
    store64(f + 784, rekha_rd_u16(buf, mx + 24));   # maxStackElements
    store64(f + 792, rekha_rd_u16(buf, mx + 26));   # maxSizeOfInstructions
    store64(f + 800, rekha_rd_u16(buf, mx + 16));   # maxTwilightPoints
    # ⚠ The glyph zone has to hold whichever is bigger. A font whose composites are larger than any
    # of its simple glyphs — which is most fonts with accents — declares that in the second pair.
    var mp = rekha_rd_u16(buf, mx + 6);             # maxPoints
    var mcp = rekha_rd_u16(buf, mx + 10);           # maxCompositePoints
    if (mcp > mp) { mp = mcp; }
    var mc = rekha_rd_u16(buf, mx + 8);             # maxContours
    var mcc = rekha_rd_u16(buf, mx + 12);           # maxCompositeContours
    if (mcc > mc) { mc = mcc; }
    store64(f + 816, mp);
    store64(f + 824, mc);
    return 0;
}

# @public — the point and contour capacity the interpreter's glyph zone is built at, taken from
# `maxp` and NOT from rekha's own outline cap. 0 when the table is not version 1.0.
public fn rekha_max_zone_points(font): i64   { if (font == 0) { return 0; } return load64(font + 816); }
public fn rekha_max_zone_contours(font): i64 { if (font == 0) { return 0; } return load64(font + 824); }

# @public — 1 when this face carries TrueType bytecode rekha will run: a version 1.0 `maxp`, and
# at least one of `fpgm` / `prep` / `cvt ` with a non-zero length. ⛔ GLYPH-ONLY BYTECODE IS NOT
# RUN: a face whose only programs are in its glyphs answers 0 here and NO_TABLE "hint tables"
# from rekha_hint_ctx, and its glyphs are drawn through the unhinted seam. That matches FreeType's
# DEFAULT load, not its NO_AUTOHINT one: FT_Load_Glyph hands a TrueType face with no `fpgm` and a
# `prep` of at most 7 bytes to the autohinter instead of its glyph programs
# (ref2143/ftobjs.c:1006-1016), and a glyph-only face is one of those; only a load flagged
# NO_AUTOHINT — the oracle's, for the unit fonts — runs them, and rekha has no autohinter to
# fall back to. (rekha's gate is the three tables' lengths, so a face with only a `cvt `, or a
# `prep` of 1..7 bytes, is hinted here and autohinted there.) ⚠ It does NOT mean every glyph
# will be hinted: the font program or a size's control-value program may still refuse, which
# `rekha_hint_error` on the context reports, and `rekha_hint_glyph` answers 0 for a glyph whose
# own program does.
public fn rekha_hint_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 752) == 0) { return 0; }
    if (load64(font + 712) > 0) { return 1; }
    if (load64(font + 728) > 0) { return 1; }
    if (load64(font + 696) > 0) { return 1; }
    return 0;
}

# @public — the six `maxp` version 1.0 limits the interpreter is sized by. 0 when the table is
# version 0.5, absent or short, which is also a legal answer for a font that declares 0.
public fn rekha_max_storage(font): i64          { if (font == 0) { return 0; } return load64(font + 760); }
public fn rekha_max_function_defs(font): i64    { if (font == 0) { return 0; } return load64(font + 768); }
public fn rekha_max_instruction_defs(font): i64 { if (font == 0) { return 0; } return load64(font + 776); }
public fn rekha_max_stack_elements(font): i64   { if (font == 0) { return 0; } return load64(font + 784); }
public fn rekha_max_instruction_size(font): i64 { if (font == 0) { return 0; } return load64(font + 792); }
public fn rekha_max_twilight_points(font): i64  { if (font == 0) { return 0; } return load64(font + 800); }

# @public — the byte length of the font program and the control-value program. 0 = absent.
public fn rekha_fpgm_length(font): i64 { if (font == 0) { return 0; } return load64(font + 712); }
public fn rekha_prep_length(font): i64 { if (font == 0) { return 0; } return load64(font + 728); }

# @public — how many entries the `cvt ` table holds, and entry `i` in FONT UNITS, unscaled and
# unhinted. ⚠ This reads the FONT; `rekha_hint_cvt_px` reads the interpreter's own copy, which
# `prep` is entitled to have rewritten. They answer different questions at the same index.
public fn rekha_cvt_count(font): i64 {
    if (font == 0) { return 0; }
    return load64(font + 696) / 2;
}

# @public — entry `i` of `cvt `, in FONT UNITS as written; 0 when there is none, or `i` is out of
# range. The scaled, `prep`-rewritten value of the same index is rekha_hint_cvt_px.
public fn rekha_cvt_value(font, i): i64 {
    if (font == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= rekha_cvt_count(font)) { return 0; }
    return rekha_rd_i16(load64(font), load64(font + 688) + i * 2);
}

# ================================================================
# gasp — not bytecode: the table that says at which sizes to grid-fit at all.
#   +0 version u16 (0 or 1) · +2 numRanges u16 · then numRanges x (rangeMaxPPEM u16, behavior u16),
#   SORTED by rangeMaxPPEM, the last one 0xFFFF.
# Version 0 defines the low two behavior bits; version 1 adds the symmetric pair, which describe
# ClearType and are reported unchanged rather than folded into the other two.
# ================================================================

# @public — the behavior bits rekha_gasp_behavior answers.
public var REKHA_GASP_GRIDFIT           = 1;
public var REKHA_GASP_DOGRAY            = 2;
public var REKHA_GASP_SYMMETRIC_GRIDFIT = 4;
public var REKHA_GASP_SYMMETRIC_SMOOTH  = 8;

# @public — 1 when the face carries a `gasp` rekha can read.
public fn rekha_gasp_present(font): i64 {
    if (font == 0) { return 0; }
    if (load64(font + 736) == 0) { return 0; }
    return 1;
}

# @public — the behavior flags for `ppem`: the first range whose rangeMaxPPEM is at least ppem.
# -1 when there is no `gasp`, which is NOT 0: 0 is a real answer meaning "neither grid-fit nor
# smooth at this size", and a font without the table has said nothing at all.
# ⚠ A font with no `gasp` is conventionally grid-fit at every size; rekha reports the absence and
# leaves that convention to `rekha_should_gridfit`, so the two questions stay separable.
public fn rekha_gasp_behavior(font, ppem): i64 {
    if (rekha_gasp_present(font) == 0) { return 0 - 1; }
    var buf = load64(font);
    var t = load64(font + 736);
    var end = load64(font + 744);
    var n = rekha_rd_u16(buf, t + 2);
    if (t + 4 + n * 4 > end) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        var r = t + 4 + i * 4;
        if (rekha_rd_u16(buf, r) >= ppem) { return rekha_rd_u16(buf, r + 2); }
        i = i + 1;
    }
    return 0;
}

# @public — 1 when this size should be grid-fit, 0 when it should not. ⚠ A face with no `gasp`
# answers 1: that is the long-standing convention and it is stated here rather than left implicit.
public fn rekha_should_gridfit(font, ppem): i64 {
    var b = rekha_gasp_behavior(font, ppem);
    if (b < 0) { return 1; }
    if ((b & REKHA_GASP_GRIDFIT) != 0) { return 1; }
    return 0;
}

# ================================================================
# Fixed point — F26Dot6 for distances, 16.16 for the scale, F2Dot14 for the vectors.
# ⛔ ROUNDED HALF AWAY FROM ZERO, not half up. See the header: the reference here is FreeType's
# interpreter, not fontTools, and a `cvt ` of descender depths is where the two disagree.
# ================================================================

# 16.16 x value -> value, i.e. FT_MulFix.
fn rekha_hint_mulfix(a, b): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    var c = sd_asr(a * b + 32768, 16);
    if (s < 0) { return 0 - c; }
    return c;
}

# a / b as 16.16, i.e. FT_DivFix. b == 0 answers 0 rather than trapping; the caller has already
# refused a font with unitsPerEm 0 long before this.
fn rekha_hint_divfix(a, b): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    if (b == 0) { return 0; }
    var c = (a * 65536 + b / 2) / b;
    if (s < 0) { return 0 - c; }
    return c;
}

# round(a * b / c), half away from zero — FT_MulDiv, which MUL (and ISECT, IP) is defined in
# terms of. DIV is not: see rekha_hint_div_trunc.
fn rekha_hint_muldiv(a, b, c): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    if (c < 0) { c = 0 - c; s = 0 - s; }
    if (c == 0) { return 0; }
    var v = (a * b + c / 2) / c;
    if (s < 0) { return 0 - v; }
    return v;
}

# (a * 64) / b TRUNCATED toward zero on the magnitudes and re-signed — FT_MulDiv_No_Round with
# 64, which is what Ins_DIV computes (ref2143/ftcalc.c:187-206). The caller has refused b == 0.
fn rekha_hint_div_trunc(a, b): i64 {
    var s = 1;
    if (a < 0) { a = 0 - a; s = 0 - s; }
    if (b < 0) { b = 0 - b; s = 0 - s; }
    if (b == 0) { return 0; }
    var v = (a * 64) / b;
    if (s < 0) { return 0 - v; }
    return v;
}

# The largest multiple of `p` at or below `v`. ⛔ NOT `v / p * p`: Cyrius divides toward zero, so
# that rounds a negative value UP and turns a round-down into a round-up on exactly the half of
# the number line a descender lives on. This is the `& -p` of a power-of-two grid, generalised to
# the 45-degree period, which is 45 and not a power of two.
fn rekha_hint_floor_mul(v, p): i64 {
    if (p <= 0) { return v; }
    var q = v / p;
    if (v < 0) {
        if (q * p != v) { q = q - 1; }
    }
    return q * p;
}

# Keep a value inside the 32-bit signed range TrueType is specified on.
fn rekha_hint_clamp(v): i64 {
    if (v > REKHA_HINT_CLAMP) { return REKHA_HINT_CLAMP; }
    if (v < (0 - REKHA_HINT_CLAMP) - 1) { return (0 - REKHA_HINT_CLAMP) - 1; }
    return v;
}

# ================================================================
# Refusal reporting — the 0.7.0 shape, on the context rather than the font handle, because a
# context outlives one call and a program's refusal is the answer to "why is this size unhinted".
# ================================================================

# @public — why the last run on this context refused, as a RekhaErrCode. REKHA_OK when it did not.
# ⛔ IT IS NOT A SUCCESS TEST: `rekha_hint_run` already returns 1 or 0. This says WHICH refusal.
public fn rekha_hint_error(ctx): i64 {
    if (ctx == 0) { return REKHA_OK; }
    return load64(ctx + HC_ERR);
}

# @public — a short STATIC cstring naming the instruction or invariant, never allocated and never
# owned by the caller. 0 when there is nothing to name.
public fn rekha_hint_error_detail(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + HC_DETAIL);
}

# @public — clear it. Every run clears first, so a code describes the LAST run.
public fn rekha_hint_error_clear(ctx): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + HC_ERR, REKHA_OK);
    store64(ctx + HC_DETAIL, 0);
    return 0;
}

# Record a refusal and answer 0, so a caller can `return rekha_hint_fail(...)`.
fn rekha_hint_fail(ctx, code, detail): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + HC_ERR, code);
    store64(ctx + HC_DETAIL, detail);
    return 0;
}

# ================================================================
# The stack. ⚠ Bounded by the font's OWN maxStackElements, not by a rekha constant: a font that
# declares 676 gets 676, and overflowing it is the font contradicting itself.
# ================================================================

# How deep the stack is, and the value `i` from the BOTTOM — for programs/hint_test.cyr, which
# drives one instruction at a time through rekha_hint_run. Internal since 0.9.0: after
# rekha_hint_glyph the stack holds only what a program left behind.
fn rekha_hint_depth(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + HC_SP);
}

fn rekha_hint_at(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_SP)) { return 0; }
    return load64(load64(ctx + HC_STACK) + i * 8);
}

# Push a value. 1 on success, 0 when the stack is full (and the refusal is recorded).
fn rekha_hint_push(ctx, v): i64 {
    if (ctx == 0) { return 0; }
    var sp = load64(ctx + HC_SP);
    if (sp >= load64(ctx + HC_STKCAP)) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "stack overflow");
    }
    store64(load64(ctx + HC_STACK) + sp * 8, rekha_hint_clamp(v));
    store64(ctx + HC_SP, sp + 1);
    return 1;
}

# 1 when at least `n` values are on the stack; otherwise records the underflow and answers 0.
fn rekha_hint_need(ctx, n): i64 {
    if (load64(ctx + HC_SP) >= n) { return 1; }
    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "stack underflow");
}

# Pop. ⚠ Answers 0 on an EMPTY stack, which is also a legal value; call rekha_hint_need
# first, as every instruction here does.
fn rekha_hint_pop(ctx): i64 {
    if (ctx == 0) { return 0; }
    var sp = load64(ctx + HC_SP);
    if (sp <= 0) { return 0; }
    store64(ctx + HC_SP, sp - 1);
    return load64(load64(ctx + HC_STACK) + (sp - 1) * 8);
}

# ================================================================
# The rounding engine. Six fixed modes plus the two the font composes itself.
# ⚠ THE FOUR ENGINE COMPENSATIONS ARE ZERO, as FreeType's are. They modelled the pixel spread of a
# CRT and the distance-type bits in ROUND[ab] / NROUND[ab] select between them; with all four zero
# the bits are read, validated and then make no difference, and NROUND becomes the identity. That
# is stated rather than left as an accident of the table being empty.
# ================================================================

# Decompose an SROUND / S45ROUND selector byte into period, phase and threshold. `grid` is in
# 1/16384 pixel (see REKHA_HINT_GRID); all three come out in F26Dot6.
fn rekha_hint_set_super(ctx, grid, sel): i64 {
    var period = grid;
    var b = sel & 0xC0;
    if (b == 0x00)    { period = grid / 2; }
    if (b == 0x80)    { period = grid * 2; }
    var phase = 0;
    var ph = sel & 0x30;
    if (ph == 0x10) { phase = period / 4; }
    if (ph == 0x20) { phase = period / 2; }
    if (ph == 0x30) { phase = period * 3 / 4; }
    # ⚠ The default threshold is `period - 1` IN 1/16384 PIXEL, before the shift down to F26Dot6
    # (ref2143/ttinterp.c:2093-2098). It makes no difference on the pixel grids, where the period
    # is a multiple of 256, and one 1/64 on the 45-degree grid: 0x2D41 - 1 >> 8 is 45, and
    # 0x2D41 - 256 >> 8 was 44 — 0.8.0's slip, found by reading FreeType.
    var th = sel & 0x0F;
    var thresh = period - 1;
    if (th != 0) { thresh = (th - 4) * period / 8; }
    store64(ctx + HC_PERIOD, sd_asr(period, 8));
    store64(ctx + HC_PHASE,  sd_asr(phase, 8));
    store64(ctx + HC_THRESH, sd_asr(thresh, 8));
    return 0;
}

# @public — put `d` (an F26Dot6 distance) through the current rounding state. Exposed because it
# is the one piece of the graphics state whose effect a consumer can see without a glyph, and
# because every mode below has a spec-stated answer a test can pin.
public fn rekha_hint_round(ctx, d): i64 {
    if (ctx == 0) { return d; }
    var st = load64(ctx + HC_RSTATE);
    if (st == REKHA_RND_OFF) { return d; }
    if (st == REKHA_RND_SUPER)   { return rekha_hint_round_super(ctx, d); }
    if (st == REKHA_RND_SUPER45) { return rekha_hint_round_super(ctx, d); }
    # The five fixed grids, each written as "fold to a non-negative distance, round, put the sign
    # back, and never let a rounding carry a distance across zero".
    var neg = 0;
    var v = d;
    if (v < 0) { neg = 1; v = 0 - v; }
    if (st == REKHA_RND_GRID)   { v = rekha_hint_floor_mul(v + 32, 64); }
    if (st == REKHA_RND_HALF)   { v = rekha_hint_floor_mul(v, 64) + 32; }
    if (st == REKHA_RND_DOUBLE) { v = rekha_hint_floor_mul(v + 16, 32); }
    if (st == REKHA_RND_DOWN)   { v = rekha_hint_floor_mul(v, 64); }
    if (st == REKHA_RND_UP)     { v = rekha_hint_floor_mul(v + 63, 64); }
    if (v < 0) { v = 0; }
    if (neg == 1) { return 0 - v; }
    return v;
}

# SROUND / S45ROUND: a period, a phase and a threshold the font chose.
fn rekha_hint_round_super(ctx, d): i64 {
    var period = load64(ctx + HC_PERIOD);
    var phase = load64(ctx + HC_PHASE);
    var thresh = load64(ctx + HC_THRESH);
    if (period <= 0) { return d; }
    if (d >= 0) {
        var v = rekha_hint_floor_mul(d - phase + thresh, period) + phase;
        if (v < 0) { v = phase; }
        return v;
    }
    var w = 0 - rekha_hint_floor_mul(thresh - phase - d, period);
    w = w - phase;
    if (w > 0) { w = 0 - phase; }
    return w;
}

# ================================================================
# The context: build it once, re-scale it per size.
# ================================================================

# Put the graphics state back to the values the spec calls default, and empty the stack. Called
# before the font program, before and after each size's control-value program (see
# rekha_hint_run_prep), never between two instructions.
fn rekha_hint_reset(ctx): i64 {
    store64(ctx + HC_SP, 0);
    store64(ctx + HC_PVX, 16384);   store64(ctx + HC_PVY, 0);
    store64(ctx + HC_FVX, 16384);   store64(ctx + HC_FVY, 0);
    store64(ctx + HC_DVX, 16384);   store64(ctx + HC_DVY, 0);
    store64(ctx + HC_RP0, 0);   store64(ctx + HC_RP1, 0);   store64(ctx + HC_RP2, 0);
    store64(ctx + HC_ZP0, 1);   store64(ctx + HC_ZP1, 1);   store64(ctx + HC_ZP2, 1);
    store64(ctx + HC_LOOP, 1);
    store64(ctx + HC_RSTATE, REKHA_RND_GRID);
    store64(ctx + HC_PERIOD, 64);   store64(ctx + HC_PHASE, 0);   store64(ctx + HC_THRESH, 32);
    store64(ctx + HC_MINDIST, 64);          # one pixel
    store64(ctx + HC_CVTCUT, 68);           # 17/16 of a pixel, the spec's own default
    store64(ctx + HC_SWCUT, 0);   store64(ctx + HC_SWVAL, 0);
    store64(ctx + HC_AUTOFLIP, 1);
    store64(ctx + HC_DBASE, 9);   store64(ctx + HC_DSHIFT, 3);
    store64(ctx + HC_INSTCTL, 0);
    store64(ctx + HC_SCANCTL, 0);   store64(ctx + HC_SCANTYPE, 0);
    rekha_hint_movevec(ctx);
    return 0;
}

# Re-scale the control values from the font bytes at the context's ppem, into the SIZE's array.
# ⛔ FROM THE FONT, not from the previous size's copy: `prep` rewrites entries, and re-scaling a
# rewritten value would compound one size's exceptions into the next.
fn rekha_hint_scale_cvt(ctx): i64 {
    var font = load64(ctx + HC_FONT);
    var buf = load64(ctx + HC_BUF);
    var at = load64(font + 688);
    var n = load64(ctx + HC_CVTCAP);
    var dst = load64(ctx + HC_CVTS);
    var sc = load64(ctx + HC_SCALE);
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, rekha_hint_mulfix(rekha_rd_i16(buf, at + i * 2), sc));
        i = i + 1;
    }
    return 0;
}

# @public — the scaled control value at `i`, in F26Dot6, as the interpreter currently holds it —
# which, once `rekha_hint_ctx` has answered, is AFTER this size's `prep` rewrote it: Liberation
# Sans's rewrites 22 to 59 of its 324 entries depending on the size. ⚠ Not `rekha_cvt_value`,
# which reads the font; the fresh scale is `rekha_hint_mulfix(rekha_cvt_value(font, i), scale)`.
# ⚠ IT READS THE CURRENT POINTER, THE EXECUTOR'S OWN VIEW: after a `rekha_hint_glyph` whose
# programs wrote a control value through WCVTP or DELTAC that is the GLYPH's private copy, which
# the next glyph load discards — so a value read here right after a glyph is that glyph's, and
# the size's again after the next load (see HC_CVTS). WCVTF writes wherever the pointer stands.
public fn rekha_hint_cvt_px(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_CVTCAP)) { return 0; }
    return load64(load64(ctx + HC_CVT) + i * 8);
}

# @public — the storage area at `i`. 0 outside it, which is also a legal stored value. Cleared
# before every `prep` run, so it holds what this size's `prep` wrote and nothing older — through
# the CURRENT pointer, as rekha_hint_cvt_px: a glyph program's WS writes a private copy that this
# answers until the next glyph load repoints it at the size's.
public fn rekha_hint_storage(ctx, i): i64 {
    if (ctx == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(ctx + HC_STORECAP)) { return 0; }
    return load64(load64(ctx + HC_STORE) + i * 8);
}

# @public — the size this context is scaled for (0 after an axis change, until the next
# rekha_hint_ctx rebuilds it), the 16.16 font-unit-to-F26Dot6 multiplier, and the exact byte
# count of its single allocation.
public fn rekha_hint_ppem(ctx): i64  { if (ctx == 0) { return 0; } return load64(ctx + HC_PPEM); }
public fn rekha_hint_scale(ctx): i64 { if (ctx == 0) { return 0; } return load64(ctx + HC_SCALE); }
public fn rekha_hint_bytes(ctx): i64 { if (ctx == 0) { return 0; } return load64(ctx + HC_BYTES); }

# The record of function `n` — [number, start, end, buffer] — or 0 when no program defined it.
# FreeType's lookup (ref2143/ttinterp.c:3404-3435): when every function so far is numbered by its
# position the record IS the n-th, else the table is searched.
fn rekha_hint_find_fdef(ctx, n): i64 {
    var cnt = load64(ctx + HC_FDEFN);
    var at = load64(ctx + HC_FDEF);
    if (n >= 0) {
        if (n < cnt) {
            if (load64(at + n * 32) == n) { return at + n * 32; }
        }
    }
    var i = 0;
    while (i < cnt) {
        if (load64(at + i * 32) == n) { return at + i * 32; }
        i = i + 1;
    }
    return 0;
}

# @public — how many functions the font program defined, and whether `n` is one of them. ⚠ The
# count is of DISTINCT numbers: a function redefined takes no second record, and the numbers need
# not be 0..count-1 — Liberation Sans's 71 functions run up to 91 with gaps.
public fn rekha_hint_func_defined(ctx, n): i64 {
    if (ctx == 0) { return 0; }
    if (rekha_hint_find_fdef(ctx, n) == 0) { return 0; }
    return 1;
}

# @public — how many DISTINCT function numbers the font program defined.
public fn rekha_hint_func_count(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + HC_FDEFN);
}

# @public — the interpreter for `font` at `ppem`: built on first use, then the font program is run
# once, and on EVERY size change (the first included) the control-value program is run for that
# size through `rekha_hint_run_prep`. 0 when the face carries no bytecode, when ppem is not
# positive, when a declared `maxp` limit is over one of rekha's caps, or when the allocation
# failed — and in every one of those cases `rekha_font_error(font)` says which, because there is
# no context to ask.
# ⛔ THIS IS THE ONE PUBLIC CALL WHOSE NON-ZERO ANSWER DOES NOT MEAN SUCCESS. A refused `fpgm` or a
# refused `prep` is a property of the face or of the size, and the consumer needs the context to
# read it: the handle is still answered, `rekha_hint_error(ctx)` carries the standing refusal —
# the font program's first, else this size's control-value program's — on every call for that
# size, and `rekha_font_error(font)` mirrors it so the two agree. `rekha_hint_glyph` is the call
# that answers 0, and it answers 0 for that standing refusal too.
# ⛔ CALL THIS ONCE, OUTSIDE ANY SCOPED PER-FRAME ALLOCATION HOOK, right after rekha_font_open —
# the way the font itself is opened. The context is a lazy allocation cached on the font handle
# (like the gvar scratch and GPOS's lookup list), and a consumer whose first hint happens inside a
# per-frame `sd_alloc` arena loses it at the arena's reset and reads freed memory at the next
# frame. On a variable face, load one glyph outside the hook too: the gvar scratch is allocated
# by the first varied glyph load.
# ⛔ THE CONTEXT IS CACHED ON THE FONT AND RE-SCALED, NEVER REALLOCATED. `sd_alloc` has no free, so
# a text run walking sizes would otherwise leak one interpreter per size. The function table and
# the instruction table are the one thing a size change keeps: a function is a range into font
# bytes and does not move with size. Everything else the size owns — the scaled control values,
# the storage area, the twilight zone, the graphics state, the glyph zone — is rebuilt by
# `rekha_hint_run_prep`, as FreeType rebuilds it before every `prep` (ref2143/ttobjs.c:951-975).
# ⭐ AND AFTER AN AXIS CHANGE IT RE-RUNS `prep` FOR YOU, AT THE SAME PPEM: rekha_var_set_axis,
# rekha_var_set_instance and rekha_var_reset mark the cached context stale (rekha_hint_axes_changed
# puts HC_PPEM back to 0), so the next call here rebuilds the size and a `prep` that branches on
# GETINFO's variation bit is run for the new instance, not the old. Until that call the size
# readers (`rekha_hint_ppem` and the rest) describe no size at all. ⚠ Stated divergence, measured
# on the host: FreeType 2.14.3 re-runs `prep` on a blend change only when the face has a `cvar`
# (tt_face_vary_cvt sets every size's cvt_ready to -1, ref2143/ttgxvar.c:3993-3997); without one
# the size keeps the previous instance's prep state until the size is requested again
# (tt_size_reset, ttobjs.c:1292). rekha re-runs it for every axis change — the one rule a consumer
# can rely on — and a hinted variable instance is off-reference regardless (rekha_hint_glyph).
public fn rekha_hint_ctx(font, ppem): i64 {
    if (font == 0) { return 0; }
    rekha_font_error_clear(font);
    if (rekha_hint_present(font) == 0) {
        return rekha_fail(font, REKHA_ERR_NO_TABLE, "hint tables");
    }
    if (ppem <= 0) { return rekha_fail(font, REKHA_ERR_OTHER, "ppem"); }
    var upem = load64(font + 40);
    if (upem <= 0) { return rekha_fail(font, REKHA_ERR_NO_TABLE, "head"); }
    var ctx = load64(font + 808);
    if (ctx == 0) {
        ctx = rekha_hint_ctx_new(font);
        if (ctx == 0) { return 0; }
        store64(font + 808, ctx);
    }
    var changed = 0;
    if (load64(ctx + HC_PPEM) != ppem) {
        store64(ctx + HC_PPEM, ppem);
        store64(ctx + HC_SCALE, rekha_hint_divfix(ppem * 64, upem));
        changed = 1;
    }
    # ⚠ The font program runs AFTER the scale is set, at the first size asked for, so an MPPEM
    # inside it answers that size and not 0 — which is 2.14.3 (ref2143/ttobjs.c:891-909), and
    # harmless either way because `prep` then starts from a clean slate.
    if (load64(ctx + HC_FPGMOK) == 0) {
        rekha_hint_run_fpgm(ctx);
        changed = 1;
    }
    if (changed == 1) { rekha_hint_run_prep(ctx); }
    rekha_hint_error_clear(ctx);
    var code = load64(ctx + HC_FPGMERR);
    var det = load64(ctx + HC_FPGMDET);
    if (code == REKHA_OK) {
        code = load64(ctx + HC_PREPERR);
        det = load64(ctx + HC_PREPDET);
    }
    if (code != REKHA_OK) {
        rekha_hint_fail(ctx, code, det);
        rekha_fail(font, code, det);
    }
    return ctx;
}

# The axis state of `font` changed (src/var.cyr's setters call this — a FORWARD call from a module
# included earlier, so its one argument is checked by hand there): mark the cached context, if
# there is one, as scaled for no size, so the next rekha_hint_ctx rebuilds the size and re-runs
# `prep` at whatever ppem it asks for. The glyph zone and the view are invalidated with it, since
# their points were varied at the old instance. Nothing happens for a face never hinted.
fn rekha_hint_axes_changed(font): i64 {
    if (font == 0) { return 0; }
    var ctx = load64(font + 808);
    if (ctx == 0) { return 0; }
    store64(ctx + HC_PPEM, 0);
    rekha_hint_view_clear(ctx);
    return 0;
}

# One sd_alloc: the header, then the stack, the storage area, the function table, the instruction
# table, the scaled control values, the two zones' coordinate arrays, the glyph load's private
# copies of the control values and the storage area, and last the byte arrays — the two zones'
# tags and the glyph zone's on-curve bytes — all inline.
# ⚠ THE STACK GETS max(maxStackElements / 2, 128) SLOTS MORE THAN THE FONT DECLARED, which is
# FreeType's margin (ref2143/ttobjs.c:1078-1079) and is here for the same reason: a
# maxStackElements short of what the font's own program pushes is a common enough authoring slip
# that refusing it would refuse fonts FreeType hints.
fn rekha_hint_ctx_new(font): i64 {
    var ms = load64(font + 784);
    var margin = ms / 2;
    if (margin < 128) { margin = 128; }
    var stk = ms + margin;
    var sto = load64(font + 760);
    var fdn = load64(font + 768);
    var idn = load64(font + 776);
    var cvn = load64(font + 696) / 2;
    if (stk > REKHA_HINT_MAXSTACK) { return rekha_fail(font, REKHA_ERR_OOM, "stack cap"); }
    if (sto > REKHA_HINT_MAXSTORE) { return rekha_fail(font, REKHA_ERR_OOM, "storage cap"); }
    if (fdn > REKHA_HINT_MAXFDEF)  { return rekha_fail(font, REKHA_ERR_OOM, "function cap"); }
    if (idn > REKHA_HINT_MAXIDEF)  { return rekha_fail(font, REKHA_ERR_OOM, "instruction cap"); }
    if (cvn > REKHA_HINT_MAXCVT)   { return rekha_fail(font, REKHA_ERR_OOM, "cvt cap"); }
    # ⚠ THE FUNCTION TABLE HOLDS AT LEAST 64 RECORDS whatever maxFunctionDefs says: FreeType's
    # `maxp` reader floors the declared count at 64 for old fonts that under-declare it (its sfnt
    # loader, tt_face_load_maxp, not in the interpreter sources; the interpreter takes the floored
    # value at ref2143/ttobjs.c:1050), and the host's libfreetype 2.14.3 was measured: under a
    # declared 1, 64 distinct definitions load and a 65th fails, numbered densely or sparsely.
    # The cap above is on the DECLARED count, so the floor never exceeds it.
    if (fdn < 64) { fdn = 64; }
    var tz = load64(font + 800);                    # twilight points
    var gz = load64(font + 816) + 4;                # glyph points, plus the four phantom
    var gc = load64(font + 824);
    if (tz > REKHA_HINT_MAXZONE) { return rekha_fail(font, REKHA_ERR_OOM, "twilight cap"); }
    if (gz > REKHA_HINT_MAXZONE) { return rekha_fail(font, REKHA_ERR_OOM, "glyph zone cap"); }
    if (gc > REKHA_HINT_MAXZONE) { return rekha_fail(font, REKHA_ERR_OOM, "contour cap"); }
    # ⚠ The three byte arrays — two zones' tags, the glyph zone's on-curve bytes — go last, so no
    # i64 array starts on an odd address; the total is rounded up to 8 for the same reason.
    var tagb = (tz + 2 * gz + 7) & (0 - 8);
    var bytes = REKHA_HINT_HDR + stk * 8 + sto * 8 + fdn * 32 + idn * 32 + cvn * 8
    + tz * 48 + gz * 48 + gc * 8 + cvn * 8 + sto * 8 + tagb;
    var ctx = sd_alloc(bytes);
    if (ctx == 0) { return rekha_fail(font, REKHA_ERR_OOM, "hint context"); }
    var at = ctx + REKHA_HINT_HDR;
    store64(ctx + HC_FONT, font);
    store64(ctx + HC_BUF, load64(font));
    store64(ctx + HC_PPEM, 0);
    store64(ctx + HC_SCALE, 0);
    store64(ctx + HC_ERR, REKHA_OK);
    store64(ctx + HC_DETAIL, 0);
    store64(ctx + HC_SP, 0);
    store64(ctx + HC_STACK, at);      store64(ctx + HC_STKCAP, stk);     at = at + stk * 8;
    store64(ctx + HC_STORE, at);      store64(ctx + HC_STORECAP, sto);   at = at + sto * 8;
    store64(ctx + HC_FDEF, at);       store64(ctx + HC_FDEFCAP, fdn);    at = at + fdn * 32;
    store64(ctx + HC_FDEFN, 0);
    store64(ctx + HC_IDEF, at);       store64(ctx + HC_IDEFCAP, idn);    at = at + idn * 32;
    store64(ctx + HC_IDEFN, 0);
    store64(ctx + HC_CVT, at);        store64(ctx + HC_CVTCAP, cvn);    at = at + cvn * 8;
    at = rekha_hint_zone_carve(ctx + HC_ZONE0, at, tz, 0);
    at = rekha_hint_zone_carve(ctx + HC_ZONE1, at, gz, gc);
    store64(ctx + HC_GZCAP, gz);
    store64(ctx + HC_GZCCAP, gc);
    store64(ctx + HC_GZGID, 0 - 1);
    # the size's arrays are the ones carved above; the glyph load's copies follow the zones
    store64(ctx + HC_CVTS, load64(ctx + HC_CVT));
    store64(ctx + HC_STOS, load64(ctx + HC_STORE));
    store64(ctx + HC_CVTG, at);       at = at + cvn * 8;
    store64(ctx + HC_STOG, at);       at = at + sto * 8;
    # the byte arrays, after every i64 array: the two tag arrays, then the on-curve bytes
    store64(ctx + HC_ZONE0 + ZN_TAGS, at);   at = at + tz;
    store64(ctx + HC_ZONE1 + ZN_TAGS, at);   at = at + gz;
    # the view: empty, its arrays zone 1's for the life of the context (see rekha_hint_outline)
    store64(ctx + HC_VIEW, 0);
    store64(ctx + HC_VIEW + 8, 0);
    store64(ctx + HC_VIEW + 16, load64(ctx + HC_ZONE1 + ZN_CTRS));
    store64(ctx + HC_VIEW + 24, load64(ctx + HC_ZONE1 + ZN_CURX));
    store64(ctx + HC_VIEW + 32, load64(ctx + HC_ZONE1 + ZN_CURY));
    store64(ctx + HC_VIEW + 40, at);
    store64(ctx + HC_MSCALE, 0);
    store64(ctx + HC_TWCAP, tz);
    store64(ctx + HC_FIRSTPT, 0);
    store64(ctx + HC_BUDGET, 0);
    store64(ctx + HC_DEPTH, 0);
    store64(ctx + HC_FPGMOK, 0);
    store64(ctx + HC_BYTES, bytes);
    store64(ctx + HC_FPGMERR, REKHA_OK);   store64(ctx + HC_FPGMDET, 0);
    store64(ctx + HC_PREPERR, REKHA_OK);   store64(ctx + HC_PREPDET, 0);
    store64(ctx + HC_RANGE, 0);
    # ⚠ sd_alloc does not promise zeroed memory. The two definition tables need no zeroing: each
    # is read only up to its count, and both counts start at 0.
    var i = 0;
    while (i < sto) { store64(load64(ctx + HC_STORE) + i * 8, 0); i = i + 1; }
    i = 0;
    while (i < cvn) { store64(load64(ctx + HC_CVT) + i * 8, 0); i = i + 1; }
    # ⚠ The twilight zone is the font's own scratch space and the spec starts it at the origin, so
    # it is zeroed here and RE-ZEROED before every `prep` run, never per glyph: a glyph program
    # is entitled to the twilight points `prep` set up for its size, which is the whole point of
    # MIAP in the twilight zone (ref2143/ttobjs.c:954-955).
    rekha_hint_zone_clear(ctx + HC_ZONE0, tz);
    store64(ctx + HC_ZONE0 + ZN_N, tz);
    store64(ctx + HC_ZONE1 + ZN_N, 0);
    store64(ctx + HC_ZONE1 + ZN_NC, 0);
    rekha_hint_reset(ctx);
    rekha_hint_gs_save(ctx);
    return ctx;
}

# Snapshot the ten fields a `prep` may leave for the glyph programs — HC_MINDIST through
# HC_SCANTYPE, contiguous — into HC_GSSAVE (FreeType's TT_Save_Context, ref2143/ttinterp.c:323-341),
# and put them back over a freshly reset graphics state.
fn rekha_hint_gs_save(ctx): i64 {
    var k = 0;
    while (k < 10) { store64(ctx + HC_GSSAVE + k * 8, load64(ctx + HC_MINDIST + k * 8)); k = k + 1; }
    return 0;
}

fn rekha_hint_gs_restore(ctx): i64 {
    var k = 0;
    while (k < 10) { store64(ctx + HC_MINDIST + k * 8, load64(ctx + HC_GSSAVE + k * 8)); k = k + 1; }
    return 0;
}

# Hand a zone descriptor its six i64 arrays out of the block at `at`, and answer the new `at`.
# The tag array is a byte array and is carved separately, after every i64 array in the context.
fn rekha_hint_zone_carve(zn, at, n, nc): i64 {
    store64(zn + ZN_N, 0);
    store64(zn + ZN_NC, 0);
    store64(zn + ZN_ORUSX, at);   at = at + n * 8;
    store64(zn + ZN_ORUSY, at);   at = at + n * 8;
    store64(zn + ZN_ORGX, at);    at = at + n * 8;
    store64(zn + ZN_ORGY, at);    at = at + n * 8;
    store64(zn + ZN_CURX, at);    at = at + n * 8;
    store64(zn + ZN_CURY, at);    at = at + n * 8;
    store64(zn + ZN_CTRS, at);    at = at + nc * 8;
    return at;
}

# Put `n` points of a zone back to the origin, untouched and off-curve.
fn rekha_hint_zone_clear(zn, n): i64 {
    var i = 0;
    while (i < n) {
        store64(load64(zn + ZN_ORUSX) + i * 8, 0);
        store64(load64(zn + ZN_ORUSY) + i * 8, 0);
        store64(load64(zn + ZN_ORGX) + i * 8, 0);
        store64(load64(zn + ZN_ORGY) + i * 8, 0);
        store64(load64(zn + ZN_CURX) + i * 8, 0);
        store64(load64(zn + ZN_CURY) + i * 8, 0);
        store8(load64(zn + ZN_TAGS) + i, 0);
        i = i + 1;
    }
    return 0;
}

# The zone `z` selects: 0 twilight, 1 glyph. ⚠ SZP already refused anything else, so this is the
# only place that has to trust the number and it still clamps rather than indexing off the end.
fn rekha_hint_zone(ctx, z): i64 {
    if (z == 0) { return ctx + HC_ZONE0; }
    return ctx + HC_ZONE1;
}

# FreeType's `first_point` for the program now running (HC_FIRSTPT): 0 for `fpgm`, `prep`, a test
# program, a top-level glyph's program and a SIMPLE component's program, which FreeType prepares
# on its current glyph with first_point 0 wherever the component sits in the parent
# (ref2143/ttgload.c:914); the composite's start point only for a NESTED composite's own program
# (:1240). ⚠ It is NOT the sub-zone's offset from zone 1's base — a simple component's program
# runs off-base too, and FreeType's SHZ leaves that component's phantoms alone. Only SHZ asks.
fn rekha_hint_first_point(ctx): i64 {
    return load64(ctx + HC_FIRSTPT);
}

# Empty the glyph zone and the outline view: no points, no contours, no glyph.
fn rekha_hint_view_clear(ctx): i64 {
    store64(ctx + HC_ZONE1 + ZN_N, 0);
    store64(ctx + HC_ZONE1 + ZN_NC, 0);
    store64(ctx + HC_GZGID, 0 - 1);
    store64(ctx + HC_VIEW, 0);
    store64(ctx + HC_VIEW + 8, 0);
    return 0;
}

# ================================================================
# Points: projecting, and moving.
# ⛔ A POINT INSTRUCTION NEVER READS OR WRITES x AND y DIRECTLY. It measures along the PROJECTION
# vector and moves along the FREEDOM vector, and the two are independent — that is the whole reason
# a hinting program can round a stem's width while letting the stem slide along an italic angle.
# ⛔ THE PROJECTION'S FAST PATHS ARE NOT AN OPTIMISATION EITHER. FreeType picks Project_x — answer
# dx, IGNORE dy — whenever the vector's x component is exactly +0x4000, and Project_y whenever its
# y component is, WHATEVER THE OTHER COMPONENT HOLDS (ref2143/ttinterp.c:2281-2291, per vector for
# the projection and the dual). A unit vector can be (0x4000, 69): that is what SPVFS 236 1
# normalises to, and what SPVTL gives on any line within a quarter of a degree of an axis. There
# the general dot product adds round(dy * 69 / 16384) that FreeType never sees, and the two
# disagree by a 1/64 on every measurement — a difference the K group found on five programs.
# Only +0x4000 selects; -0x4000 stays general, as in FreeType. The MOVE has its own selection —
# see rekha_hint_movevec.
# ================================================================

# (x, y) . (ax, ay) with the vector in F2Dot14 — FreeType's TT_DotFix14, rounded half AWAY from
# zero at 1/16384. ⚠ Cyrius divides toward zero, which is what makes the two-sided bias correct.
# `rekha_hint_dot14(d, 0, v, 0)` is TT_MulFix14(d, v), the same rounding on one product.
fn rekha_hint_dot14(x, y, ax, ay): i64 {
    var t = x * ax + y * ay;
    if (t >= 0) { t = t + 8192; }
    if (t < 0)  { t = t - 8192; }
    return t / 16384;
}

# The projection of (dx, dy) — how far it counts as, in the direction the program is measuring.
# x is tested before y, as Compute_Funcs tests it (ref2143/ttinterp.c:2281-2286): a component of
# exactly +0x4000 answers that axis alone and the other component is not read.
fn rekha_hint_project(ctx, dx, dy): i64 {
    var px = load64(ctx + HC_PVX);
    if (px == 0x4000) { return dx; }
    var py = load64(ctx + HC_PVY);
    if (py == 0x4000) { return dy; }
    return rekha_hint_dot14(dx, dy, px, py);
}

# The same along the DUAL vector, which is the projection vector as it was BEFORE the outline
# moved. `IP`, `MD[1]`, `GC[1]` and the original distance of `MDRP` / `MIRP` measure here so that
# a proportion taken from the original outline is not computed out of already-fitted coordinates.
# The same selection, on the dual's own components (ref2143/ttinterp.c:2288-2293).
fn rekha_hint_dualproj(ctx, dx, dy): i64 {
    var vx = load64(ctx + HC_DVX);
    if (vx == 0x4000) { return dx; }
    var vy = load64(ctx + HC_DVY);
    if (vy == 0x4000) { return dy; }
    return rekha_hint_dot14(dx, dy, vx, vy);
}

# Recompute the move vector from the projection and freedom vectors. Every setter of either calls
# this, and so does rekha_hint_reset. ⭐ THREE REGIMES, AND THE THRESHOLDS ARE FreeType 2.14.3's
# (ref2143/ttinterp.c:2238-2279), because a font observes all three:
#   freedom . projection is rounded to F2Dot14. At 0x3FFE and above the two are treated as
#   collinear and the move vector is the freedom vector itself (times 4: F2Dot14 to 16.16); when
#   an axis of the freedom vector is exactly 1.0 the move is a plain add on that axis and the
#   other axis is not written at all (HC_MVSEL 1 for x, 2 for y).
#   Below 0x400 in magnitude the two are "prohibitively orthogonal": the move vector is ZERO, so a
#   point asked to move perpendicular to what was just measured neither moves nor is touched.
#   Between the two, freedom * 65536 / (freedom . projection), the quotient truncated toward zero
#   and the product with the distance rounded once by rekha_hint_mulfix.
# 2.13.2 divided exactly per move and floored the spike at 0x400 back to 1.0; the two disagree by
# 1/64 on a few percent of oblique moves, and the host's 2.14.3 is the reference.
fn rekha_hint_movevec(ctx): i64 {
    var px = load64(ctx + HC_PVX);
    var py = load64(ctx + HC_PVY);
    var fx = load64(ctx + HC_FVX);
    var fy = load64(ctx + HC_FVY);
    var fdp = sd_asr((px * fx) + (py * fy) + 0x2000, 14);
    var mx = 0;
    var my = 0;
    var sel = 0;
    var general = 1;
    if (fdp >= 0x3FFE) {
        mx = fx * 4;
        my = fy * 4;
        general = 0;
        if (fx == 0x4000) { sel = 1; }
        if (sel == 0) { if (fy == 0x4000) { sel = 2; } }
    }
    if (fdp > (0 - 0x400)) { if (fdp < 0x400) { general = 0; } }
    if (general == 1) {
        mx = (fx * 0x10000) / fdp;
        my = (fy * 0x10000) / fdp;
    }
    store64(ctx + HC_MVX, mx);
    store64(ctx + HC_MVY, my);
    store64(ctx + HC_MVSEL, sel);
    return 0;
}

fn rekha_hint_zpt_x(zn, i): i64 { return load64(load64(zn + ZN_CURX) + i * 8); }
fn rekha_hint_zpt_y(zn, i): i64 { return load64(load64(zn + ZN_CURY) + i * 8); }
fn rekha_hint_zorg_x(zn, i): i64 { return load64(load64(zn + ZN_ORGX) + i * 8); }
fn rekha_hint_zorg_y(zn, i): i64 { return load64(load64(zn + ZN_ORGY) + i * 8); }
fn rekha_hint_zorus_x(zn, i): i64 { return load64(load64(zn + ZN_ORUSX) + i * 8); }
fn rekha_hint_zorus_y(zn, i): i64 { return load64(load64(zn + ZN_ORUSY) + i * 8); }

# The zone descriptor behind zone pointer `k` (0..2), and the zone number it holds.
fn rekha_hint_zp(ctx, k): i64 { return rekha_hint_zone(ctx, load64(ctx + HC_ZP0 + k * 8)); }
fn rekha_hint_gep(ctx, k): i64 { return load64(ctx + HC_ZP0 + k * 8); }

# 1 when `i` is a point of `zn`; otherwise records the refusal — `detail` names the instruction,
# "<MNEMONIC> point" — and answers 0. ⛔ EVERY POINT INDEX IN EVERY INSTRUCTION GOES THROUGH HERE,
# BEFORE ANYTHING IS WRITTEN. A font chooses these numbers and a glyph program that names a point
# its glyph does not have is the single most likely way an outline reads out of bounds — 0.3.11
# closed four of those in the plain loader. FreeType outside its pedantic mode skips the point
# (or answers 0) and carries on; rekha refuses the run, which is the policy stated at the head of
# rekha_hint_op_mem, and the two exceptions to it are IP's reference point 2 and DELTAP's pairs
# outside the ppem band, which FreeType tolerates in BOTH modes and rekha therefore does too.
# ⚠ ONE MORE STATED DIVERGENCE, HOSTILE-ONLY: FreeType reads a point operand through an FT_UShort
# cast before its bounds check (ref2143/ttinterp.c:5235, 5284, 5325, 5406, 5535 and the reference
# points at :4031-4035), so a stack value of 65536 + k names point k there, in both modes, with no
# error. rekha refuses it. No push can produce such an index — it takes arithmetic on the stack —
# and no font means one, so the refusal is kept and pinned rather than the wrap copied.
fn rekha_hint_pt_ok(ctx, zn, i, detail): i64 {
    if (i < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, detail); }
    if (i >= load64(zn + ZN_N)) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, detail); }
    return 1;
}

# 1 when the top `n` stack values are all points of `zn` — the pre-check a looped instruction
# makes before it moves the first of them, so a refusal leaves the zone untouched.
fn rekha_hint_pts_ok(ctx, zn, n, detail): i64 {
    var sp = load64(ctx + HC_SP);
    var st = load64(ctx + HC_STACK);
    var k = 1;
    while (k <= n) {
        if (rekha_hint_pt_ok(ctx, zn, load64(st + (sp - k) * 8), detail) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# Move point `i` of `zn` by `dist` along the freedom vector — FreeType's `func_move` — and mark it
# touched on each axis the move vector has a component on. ⚠ The touch flags are not
# bookkeeping: IUP interpolates the untouched points between the touched ones, so a move that
# forgets to set one drags a neighbour with it later. ⛔ A ZERO MOVE VECTOR MOVES AND TOUCHES
# NOTHING (the orthogonal regime), and a plain-add selection writes ONE axis and touches one, even
# though the freedom vector's other component may be a few units off zero — both are what
# Direct_Move / Direct_Move_X / Direct_Move_Y do (ref2143/ttinterp.c:1504-1540, 1597-1627).
fn rekha_hint_move(ctx, zn, i, dist): i64 {
    var sel = load64(ctx + HC_MVSEL);
    var tg = load64(zn + ZN_TAGS) + i;
    var ax = load64(zn + ZN_CURX) + i * 8;
    var ay = load64(zn + ZN_CURY) + i * 8;
    if (sel == 1) {
        store64(ax, load64(ax) + dist);
        store8(tg, load8(tg) | REKHA_TAG_TOUCHX);
        return 1;
    }
    if (sel == 2) {
        store64(ay, load64(ay) + dist);
        store8(tg, load8(tg) | REKHA_TAG_TOUCHY);
        return 1;
    }
    var mx = load64(ctx + HC_MVX);
    if (mx != 0) {
        store64(ax, load64(ax) + rekha_hint_mulfix(dist, mx));
        store8(tg, load8(tg) | REKHA_TAG_TOUCHX);
    }
    var my = load64(ctx + HC_MVY);
    if (my != 0) {
        store64(ay, load64(ay) + rekha_hint_mulfix(dist, my));
        store8(tg, load8(tg) | REKHA_TAG_TOUCHY);
    }
    return 1;
}

# The same move applied to the ORIGINAL position, and no touch — FreeType's `func_move_orig`,
# which only MSIRP into the twilight zone uses (ref2143/ttinterp.c:1563-1583, 5236-5241).
fn rekha_hint_move_orig(ctx, zn, i, dist): i64 {
    var sel = load64(ctx + HC_MVSEL);
    var ax = load64(zn + ZN_ORGX) + i * 8;
    var ay = load64(zn + ZN_ORGY) + i * 8;
    if (sel == 1) { store64(ax, load64(ax) + dist); return 0; }
    if (sel == 2) { store64(ay, load64(ay) + dist); return 0; }
    var mx = load64(ctx + HC_MVX);
    if (mx != 0) { store64(ax, load64(ax) + rekha_hint_mulfix(dist, mx)); }
    var my = load64(ctx + HC_MVY);
    if (my != 0) { store64(ay, load64(ay) + rekha_hint_mulfix(dist, my)); }
    return 0;
}

# Shift point `i` of `zn` by a displacement already split into axes — what SHP, SHC, SHZ and
# SHPIX do when they carry a point along with one that was moved deliberately. ⚠ Both the add and
# the touch are keyed on the FREEDOM vector's components, not on the move vector's: a shift under
# a near-orthogonal pair adds 0 and still touches, where rekha_hint_move would do neither. That
# asymmetry is FreeType's own (Move_Zp2_Point, ref2143/ttinterp.c:4965-4996) and is kept. SHZ
# passes `touch` 0; the other three pass 1.
fn rekha_hint_move_zp2(ctx, zn, i, dx, dy, touch): i64 {
    var tg = load64(zn + ZN_TAGS) + i;
    if (load64(ctx + HC_FVX) != 0) {
        var ax = load64(zn + ZN_CURX) + i * 8;
        store64(ax, load64(ax) + dx);
        if (touch == 1) { store8(tg, load8(tg) | REKHA_TAG_TOUCHX); }
    }
    if (load64(ctx + HC_FVY) != 0) {
        var ay = load64(zn + ZN_CURY) + i * 8;
        store64(ay, load64(ay) + dy);
        if (touch == 1) { store8(tg, load8(tg) | REKHA_TAG_TOUCHY); }
    }
    return 0;
}

# How far the reference point of SHP / SHC / SHZ has moved from its original position, projected
# and then split along the move vector into a displacement the other points are shifted by.
# Opcode bit 0 picks rp1 in zp0, else rp2 in zp1. Writes dx, dy, the reference's zone descriptor
# and its index into the four-slot `out`; 0 and the refusal when the reference point is not in its
# zone (ref2143/ttinterp.c:4922-4962).
fn rekha_hint_displacement(ctx, op, out, detail): i64 {
    var zn = rekha_hint_zp(ctx, 1);
    var p = load64(ctx + HC_RP2);
    if ((op & 1) != 0) {
        zn = rekha_hint_zp(ctx, 0);
        p = load64(ctx + HC_RP1);
    }
    if (rekha_hint_pt_ok(ctx, zn, p, detail) == 0) { return 0; }
    var d = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p) - rekha_hint_zorg_x(zn, p),
      rekha_hint_zpt_y(zn, p) - rekha_hint_zorg_y(zn, p));
    store64(out, rekha_hint_mulfix(d, load64(ctx + HC_MVX)));
    store64(out + 8, rekha_hint_mulfix(d, load64(ctx + HC_MVY)));
    store64(out + 16, zn);
    store64(out + 24, p);
    return 1;
}

# ---- making a vector a unit vector ----
# ⛔ PORTED FROM FT_Vector_NormLen (ref2143/ftcalc.c:786-874) STEP FOR STEP, because the answer is
# compared bit for bit with FreeType's and a Newton iteration that converges to the same unit
# vector from a different starting estimate lands one 1/16384 away often enough to move points.
# Its inputs are 32-bit and its squared length wraps at 32 bits ON PURPOSE — the code recovers the
# difference from 2^32 through the conversion to signed — so both are reproduced with masks
# rather than left to i64.

# Truncate to a signed 32-bit value, the way a C cast to FT_Int32 does.
fn rekha_hint_i32(v): i64 {
    var x = v & 0xFFFFFFFF;
    if (x >= 0x80000000) { return x - 0x100000000; }
    return x;
}

# The index of the highest set bit of a positive value — FT_MSB.
fn rekha_hint_msb(v): i64 {
    var n = 0;
    while (v > 1) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# (vx, vy), not both zero, as a 16.16 unit vector into the two-slot `out`.
fn rekha_hint_normlen(vx, vy, out): i64 {
    var x = rekha_hint_i32(vx);
    var y = rekha_hint_i32(vy);
    var sx = 1;
    var sy = 1;
    if (x < 0) { x = 0 - x; sx = 0 - 1; }
    if (y < 0) { y = 0 - y; sy = 0 - 1; }
    # the axis-aligned cases are exact and skip the iteration
    if (x == 0) {
        store64(out, 0);
        store64(out + 8, sy * 0x10000);
        return 0;
    }
    if (y == 0) {
        store64(out, sx * 0x10000);
        store64(out + 8, 0);
        return 0;
    }
    # estimate the length as max + min / 2 and shift so that it lands between 2/3 and 4/3 of 1.0
    var l = y + (x >> 1);
    if (x > y) { l = x + (y >> 1); }
    var shift = 31 - rekha_hint_msb(l);
    var bump = 15;
    if (l >= (0xAAAAAAAA >> shift)) { bump = 16; }
    shift = shift - bump;
    if (shift > 0) {
        x = x << shift;
        y = y << shift;
        l = y + (x >> 1);
        if (x > y) { l = x + (y >> 1); }
    }
    if (shift <= 0) {
        x = x >> (0 - shift);
        y = y >> (0 - shift);
        l = l >> (0 - shift);
    }
    # b approximates 1 / length - 1; Newton's iterations refine it until the correction is not
    # positive. ⚠ The products below are SIGNED shifts: b goes negative whenever the estimated
    # length is over 1.0, and a logical shift of that product is a different number.
    var b = 0x10000 - l;
    var u = 0;
    var v = 0;
    var z = 1;
    while (z > 0) {
        u = x + sd_asr(x * b, 16);
        v = y + sd_asr(y * b, 16);
        var s = rekha_hint_i32(u * u + v * v);
        z = (0 - s) / 0x200;
        z = (z * ((0x10000 + b) >> 8)) / 0x10000;
        b = b + z;
    }
    if (sx < 0) { u = 0 - u; }
    if (sy < 0) { v = 0 - v; }
    store64(out, u);
    store64(out + 8, v);
    return 0;
}

# (x, y) as an F2Dot14 unit vector into the two-slot `out` — FreeType's Normalize
# (ref2143/ttinterp.c:2326-2349): the 16.16 result divided by 4 toward zero. ⚠ Answers 0 for the
# ZERO VECTOR AND WRITES NOTHING, and the caller leaves the graphics state as it was: that is what
# SPVFS / SFVFS do with (0, 0), and SPVTL / SFVTL / SDPVTL never pass one because two coincident
# points are turned into the x axis first. 1 when it wrote.
fn rekha_hint_normalize(x, y, out): i64 {
    if (x == 0) { if (y == 0) { return 0; } }
    var u: i64[2];
    rekha_hint_normlen(x, y, &u);
    store64(out, load64(&u) / 4);
    store64(out + 8, load64(&u + 8) / 4);
    return 1;
}

# The line from the point on top of the stack (in zp2) to the one below it (in zp1), rotated a
# quarter turn counter-clockwise when the opcode's low bit is set, as a unit vector into `out` —
# the shared body of SPVTL and SFVTL (ref2143/ttinterp.c:3796-3846). Two coincident points give
# the x axis and skip the rotation. 0 and the refusal when a point is not in its zone.
fn rekha_hint_sxvtl(ctx, op, p1, p2, out, detail): i64 {
    var zn2 = rekha_hint_zp(ctx, 2);
    var zn1 = rekha_hint_zp(ctx, 1);
    if (rekha_hint_pt_ok(ctx, zn2, p1, detail) == 0) { return 0; }
    if (rekha_hint_pt_ok(ctx, zn1, p2, detail) == 0) { return 0; }
    var a = rekha_hint_zpt_x(zn1, p2) - rekha_hint_zpt_x(zn2, p1);
    var b = rekha_hint_zpt_y(zn1, p2) - rekha_hint_zpt_y(zn2, p1);
    var rot = op & 1;
    if (a == 0) { if (b == 0) { a = 0x4000; rot = 0; } }
    if (rot != 0) {
        var c = b;
        b = a;
        a = 0 - c;
    }
    rekha_hint_normalize(a, b, out);
    return 1;
}

# ================================================================
# Walking bytecode. ⛔ AN INSTRUCTION IS NOT ONE BYTE. The eighteen push opcodes carry their
# operands INLINE, so every walk — skipping a false IF, scanning an FDEF body, stepping the
# interpreter — has to ask how long the instruction is or it will resume inside a literal and
# execute data. This is the single function all three use.
# ================================================================

# Total byte length of the instruction at `ip`, operands included. -1 when its operands run past
# `end`, which is a truncated program and not a decodable one.
fn rekha_hint_ilen(buf, ip, end): i64 {
    var op = load8(buf + ip);
    if (op == 0x40) {                                    # NPUSHB
        if (ip + 2 > end) { return 0 - 1; }
        return 2 + load8(buf + ip + 1);
    }
    if (op == 0x41) {                                    # NPUSHW
        if (ip + 2 > end) { return 0 - 1; }
        return 2 + load8(buf + ip + 1) * 2;
    }
    if (op >= 0xB0) {
        if (op <= 0xB7) { return 2 + (op - 0xB0); }       # PUSHB[0..7]
        if (op <= 0xBF) { return 1 + (op - 0xB8 + 1) * 2; }   # PUSHW[0..7]
    }
    return 1;
}

# From the byte after an IF whose condition was false, find where execution resumes: the byte after
# the matching ELSE when `want_else` is 1, otherwise the byte after the matching EIF. -1 when the
# IF is never closed. ⚠ Nested IFs are counted; an FDEF inside one is not, because the spec forbids
# defining a function inside a conditional and rekha_hint_scan_endf refuses the nesting anyway.
fn rekha_hint_skip_if(buf, ip, end, want_else): i64 {
    var nest = 0;
    while (ip < end) {
        var op = load8(buf + ip);
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return 0 - 1; }
        if (ip + ln > end) { return 0 - 1; }
        if (op == 0x58) { nest = nest + 1; }             # IF
        if (op == 0x59) {                                # EIF
            if (nest == 0) { return ip + ln; }
            nest = nest - 1;
        }
        if (op == 0x1B) {                                # ELSE
            if (nest == 0) {
                if (want_else == 1) { return ip + ln; }
            }
        }
        ip = ip + ln;
    }
    return 0 - 1;
}

# From the byte after an FDEF or IDEF, find the offset of its ENDF. -1 when there is none, or when
# another definition opens before it: the spec forbids nesting and a font that does it is telling
# rekha two different things about where the body ends.
fn rekha_hint_scan_endf(buf, ip, end): i64 {
    while (ip < end) {
        var op = load8(buf + ip);
        if (op == 0x2D) { return ip; }                   # ENDF
        if (op == 0x2C) { return 0 - 1; }                # FDEF inside a definition
        if (op == 0x89) { return 0 - 1; }                # IDEF inside a definition
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return 0 - 1; }
        if (ip + ln > end) { return 0 - 1; }
        ip = ip + ln;
    }
    return 0 - 1;
}

# Sign-extend the low 16 bits, which is how a vector component reaches the graphics state from
# the stack: SPVFS and SFVFS read their operands as 16-bit values (ref2143/ttinterp.c:3959-3960).
fn rekha_hint_s16(v): i64 {
    var x = v & 0xFFFF;
    if (x >= 32768) { return x - 65536; }
    return x;
}

# ================================================================
# The instruction set, part one: the stack, arithmetic, comparison and rounding.
# Every handler answers 1 (done), 0 (not mine — try the next group) or -1 (refused, and the reason
# is on the context). ⚠ The refusal is checked BEFORE the pops in every case, through
# rekha_hint_need: popping first and testing afterwards is how an underflow becomes a 0 operand.
# ================================================================
fn rekha_hint_op_alu(ctx, op): i64 {
    # ── comparison: LT LTEQ GT GTEQ EQ NEQ ──
    if (op >= 0x50) {
        if (op <= 0x55) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
            var b = rekha_hint_pop(ctx);
            var a = rekha_hint_pop(ctx);
            var r = 0;
            if (op == 0x50) { if (a < b)  { r = 1; } }
            if (op == 0x51) { if (a <= b) { r = 1; } }
            if (op == 0x52) { if (a > b)  { r = 1; } }
            if (op == 0x53) { if (a >= b) { r = 1; } }
            if (op == 0x54) { if (a == b) { r = 1; } }
            if (op == 0x55) { if (a != b) { r = 1; } }
            if (rekha_hint_push(ctx, r) == 0) { return 0 - 1; }
            return 1;
        }
    }
    # ── ODD / EVEN: the spec ROUNDS first, so they answer about the fitted distance. ⚠ Then
    #    they test BIT 6 ALONE — the parity of the whole pixel — not the low seven bits
    #    (ref2143/ttinterp.c:2567, 2581): under a rounding state that answers half pixels, 2.13.2
    #    called 96 neither odd nor even and 2.14.3 calls it odd. 0.8.0 had 2.13.2's test. ──
    if (op == 0x56) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var v1 = rekha_hint_round(ctx, rekha_hint_pop(ctx)) & 64;
        var o1 = 0;
        if (v1 == 64) { o1 = 1; }
        if (rekha_hint_push(ctx, o1) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x57) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var v2 = rekha_hint_round(ctx, rekha_hint_pop(ctx)) & 64;
        var o2 = 0;
        if (v2 == 0) { o2 = 1; }
        if (rekha_hint_push(ctx, o2) == 0) { return 0 - 1; }
        return 1;
    }
    # ── AND / OR / NOT, on truth rather than on bits ──
    if (op == 0x5A) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b3 = rekha_hint_pop(ctx);
        var a3 = rekha_hint_pop(ctx);
        var r3 = 0;
        if (a3 != 0) { if (b3 != 0) { r3 = 1; } }
        if (rekha_hint_push(ctx, r3) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x5B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b4 = rekha_hint_pop(ctx);
        var a4 = rekha_hint_pop(ctx);
        var r4 = 1;
        if (a4 == 0) { if (b4 == 0) { r4 = 0; } }
        if (rekha_hint_push(ctx, r4) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x5C) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var r5 = 0;
        if (rekha_hint_pop(ctx) == 0) { r5 = 1; }
        if (rekha_hint_push(ctx, r5) == 0) { return 0 - 1; }
        return 1;
    }
    # ── ADD SUB DIV MUL, all F26Dot6 ──
    if (op >= 0x60) {
        if (op <= 0x63) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
            var b6 = rekha_hint_pop(ctx);
            var a6 = rekha_hint_pop(ctx);
            var r6 = 0;
            if (op == 0x60) { r6 = a6 + b6; }
            if (op == 0x61) { r6 = a6 - b6; }
            if (op == 0x62) {
                # ⛔ A DIVIDE BY ZERO IS A REFUSAL, not a saturated maximum. The instruction has no
                # defined answer and a font that reaches it has computed something rekha cannot
                # reproduce; continuing would put an invented number into a glyph's metrics.
                if (b6 == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DIV by zero") - 1; }
                # ⛔ DIV TRUNCATES, MUL ROUNDS. Ins_DIV is FT_MulDiv_No_Round — |a| * 64 / |b| cut
                # toward zero, then re-signed (ref2143/ttinterp.c:2657-2664, ftcalc.c:187-206) — where
                # Ins_MUL is the rounding FT_MulDiv. 0.8.0 rounded both; Liberation Sans's accent
                # placer (fpgm function 37, `PUSHW -128 DIV`) divides 93 by -128 and lands one
                # pixel away when the half is rounded instead of cut. Found by v0.8.2's differential.
                r6 = rekha_hint_div_trunc(a6, b6);
            }
            if (op == 0x63) { r6 = rekha_hint_muldiv(a6, b6, 64); }
            if (rekha_hint_push(ctx, r6) == 0) { return 0 - 1; }
            return 1;
        }
        # ── ABS NEG FLOOR CEILING ──
        if (op <= 0x67) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            var v7 = rekha_hint_pop(ctx);
            if (op == 0x64) { if (v7 < 0) { v7 = 0 - v7; } }
            if (op == 0x65) { v7 = 0 - v7; }
            if (op == 0x66) { v7 = rekha_hint_floor_mul(v7, 64); }
            if (op == 0x67) { v7 = rekha_hint_floor_mul(v7 + 63, 64); }
            if (rekha_hint_push(ctx, v7) == 0) { return 0 - 1; }
            return 1;
        }
        # ── ROUND[ab] and NROUND[ab]. The two low bits pick an engine compensation; all four are
        #    zero here, so NROUND is the identity and ROUND ignores the distance type. ──
        if (op <= 0x6B) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            if (rekha_hint_push(ctx, rekha_hint_round(ctx, rekha_hint_pop(ctx))) == 0) {
                return 0 - 1;
            }
            return 1;
        }
        if (op <= 0x6F) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            if (rekha_hint_push(ctx, rekha_hint_pop(ctx)) == 0) { return 0 - 1; }
            return 1;
        }
    }
    # ── MAX / MIN ──
    if (op == 0x8B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b8 = rekha_hint_pop(ctx);
        var a8 = rekha_hint_pop(ctx);
        if (b8 > a8) { a8 = b8; }
        if (rekha_hint_push(ctx, a8) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x8C) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var b9 = rekha_hint_pop(ctx);
        var a9 = rekha_hint_pop(ctx);
        if (b9 < a9) { a9 = b9; }
        if (rekha_hint_push(ctx, a9) == 0) { return 0 - 1; }
        return 1;
    }
    return rekha_hint_op_stack(ctx, op);
}

# DUP POP CLEAR SWAP DEPTH CINDEX MINDEX ROLL — the stack as a data structure.
fn rekha_hint_op_stack(ctx, op): i64 {
    if (op == 0x20) {                                     # DUP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var sp = load64(ctx + HC_SP);
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STACK) + (sp - 1) * 8)) == 0) {
            return 0 - 1;
        }
        return 1;
    }
    if (op == 0x21) {                                     # POP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    if (op == 0x22) {                                     # CLEAR
        store64(ctx + HC_SP, 0);
        return 1;
    }
    if (op == 0x23) {                                     # SWAP
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var s2 = load64(ctx + HC_SP);
        var at = load64(ctx + HC_STACK);
        var t = load64(at + (s2 - 1) * 8);
        store64(at + (s2 - 1) * 8, load64(at + (s2 - 2) * 8));
        store64(at + (s2 - 2) * 8, t);
        return 1;
    }
    if (op == 0x24) {                                     # DEPTH
        if (rekha_hint_push(ctx, load64(ctx + HC_SP)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x25) {                                     # CINDEX — copy the k-th from the top
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var k = rekha_hint_pop(ctx);
        if (k < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "CINDEX") - 1; }
        if (rekha_hint_need(ctx, k) == 0) { return 0 - 1; }
        var s3 = load64(ctx + HC_SP);
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STACK) + (s3 - k) * 8)) == 0) {
            return 0 - 1;
        }
        return 1;
    }
    if (op == 0x26) {                                     # MINDEX — move it, closing the gap
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var m = rekha_hint_pop(ctx);
        if (m < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MINDEX") - 1; }
        if (rekha_hint_need(ctx, m) == 0) { return 0 - 1; }
        var s4 = load64(ctx + HC_SP);
        var a4 = load64(ctx + HC_STACK);
        var v = load64(a4 + (s4 - m) * 8);
        var i = s4 - m;
        while (i < s4 - 1) {
            store64(a4 + i * 8, load64(a4 + (i + 1) * 8));
            i = i + 1;
        }
        store64(a4 + (s4 - 1) * 8, v);
        return 1;
    }
    if (op == 0x8A) {                                     # ROLL — (a b c) becomes (b c a)
        if (rekha_hint_need(ctx, 3) == 0) { return 0 - 1; }
        var s5 = load64(ctx + HC_SP);
        var a5 = load64(ctx + HC_STACK);
        var x = load64(a5 + (s5 - 3) * 8);
        store64(a5 + (s5 - 3) * 8, load64(a5 + (s5 - 2) * 8));
        store64(a5 + (s5 - 2) * 8, load64(a5 + (s5 - 1) * 8));
        store64(a5 + (s5 - 1) * 8, x);
        return 1;
    }
    return 0;
}

# ================================================================
# The instruction set, part two: the graphics state, the storage area and the control values.
# ================================================================
fn rekha_hint_op_gs(ctx, op): i64 {
    # ── SVTCA / SPVTCA / SFVTCA. The low bit picks the axis: 1 is x, 0 is y. ──
    if (op <= 0x05) {
        var ax = op & 1;
        var vx = 0;
        var vy = 16384;
        if (ax == 1) { vx = 16384; vy = 0; }
        if (op <= 0x03) {
            store64(ctx + HC_PVX, vx);   store64(ctx + HC_PVY, vy);
            store64(ctx + HC_DVX, vx);   store64(ctx + HC_DVY, vy);
        }
        if (op <= 0x01) { store64(ctx + HC_FVX, vx);   store64(ctx + HC_FVY, vy); }
        if (op >= 0x04) { store64(ctx + HC_FVX, vx);   store64(ctx + HC_FVY, vy); }
        rekha_hint_movevec(ctx);
        return 1;
    }
    # ── SPVFS / SFVFS: a vector straight from the stack, y on top, each operand's low 16 bits.
    #    ⚠ NORMALISED here rather than stored raw, so GPV and GFV answer what the machine would
    #    actually project along; a (0, 0) operand leaves the vector as it was, and SPVFS still
    #    copies the projection vector onto the dual (ref2143/ttinterp.c:3948-3969). ──
    if (op == 0x0A) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var y1 = rekha_hint_s16(rekha_hint_pop(ctx));
        var x1 = rekha_hint_s16(rekha_hint_pop(ctx));
        var u1: i64[2];
        if (rekha_hint_normalize(x1, y1, &u1) == 1) {
            store64(ctx + HC_PVX, load64(&u1));   store64(ctx + HC_PVY, load64(&u1 + 8));
        }
        store64(ctx + HC_DVX, load64(ctx + HC_PVX));
        store64(ctx + HC_DVY, load64(ctx + HC_PVY));
        rekha_hint_movevec(ctx);
        return 1;
    }
    if (op == 0x0B) {
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var y2 = rekha_hint_s16(rekha_hint_pop(ctx));
        var x2 = rekha_hint_s16(rekha_hint_pop(ctx));
        var u2: i64[2];
        if (rekha_hint_normalize(x2, y2, &u2) == 1) {
            store64(ctx + HC_FVX, load64(&u2));   store64(ctx + HC_FVY, load64(&u2 + 8));
        }
        rekha_hint_movevec(ctx);
        return 1;
    }
    if (op == 0x0C) {                                     # GPV — x first, y on top
        if (rekha_hint_push(ctx, load64(ctx + HC_PVX)) == 0) { return 0 - 1; }
        if (rekha_hint_push(ctx, load64(ctx + HC_PVY)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x0D) {                                     # GFV
        if (rekha_hint_push(ctx, load64(ctx + HC_FVX)) == 0) { return 0 - 1; }
        if (rekha_hint_push(ctx, load64(ctx + HC_FVY)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x0E) {                                     # SFVTPV
        store64(ctx + HC_FVX, load64(ctx + HC_PVX));
        store64(ctx + HC_FVY, load64(ctx + HC_PVY));
        rekha_hint_movevec(ctx);
        return 1;
    }
    # ── SRP0 / SRP1 / SRP2 and SZP0 / SZP1 / SZP2 / SZPS ──
    if (op >= 0x10) {
        if (op <= 0x12) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            store64(ctx + HC_RP0 + (op - 0x10) * 8, rekha_hint_pop(ctx));
            return 1;
        }
        if (op <= 0x16) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
            var z = rekha_hint_pop(ctx);
            # ⛔ THERE ARE EXACTLY TWO ZONES. 0 is the twilight zone and 1 the glyph; anything else
            # is refused here rather than at the first point access, so the reason names SZP.
            if (z < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SZP zone") - 1; }
            if (z > 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SZP zone") - 1; }
            if (op == 0x16) {
                store64(ctx + HC_ZP0, z);
                store64(ctx + HC_ZP1, z);
                store64(ctx + HC_ZP2, z);
                return 1;
            }
            store64(ctx + HC_ZP0 + (op - 0x13) * 8, z);
            return 1;
        }
    }
    if (op == 0x17) {                                     # SLOOP
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var lp = rekha_hint_pop(ctx);
        if (lp < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SLOOP") - 1; }
        store64(ctx + HC_LOOP, lp);
        return 1;
    }
    # ── the six fixed rounding states ──
    if (op == 0x18) { store64(ctx + HC_RSTATE, REKHA_RND_GRID);   return 1; }
    if (op == 0x19) { store64(ctx + HC_RSTATE, REKHA_RND_HALF);   return 1; }
    if (op == 0x3D) { store64(ctx + HC_RSTATE, REKHA_RND_DOUBLE); return 1; }
    if (op == 0x7A) { store64(ctx + HC_RSTATE, REKHA_RND_OFF);    return 1; }
    if (op == 0x7C) { store64(ctx + HC_RSTATE, REKHA_RND_UP);     return 1; }
    if (op == 0x7D) { store64(ctx + HC_RSTATE, REKHA_RND_DOWN);   return 1; }
    # ── and the two the font composes. SROUND's grid is one pixel, S45ROUND's is sqrt(2)/2. ──
    if (op == 0x76) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_set_super(ctx, REKHA_HINT_GRID, rekha_hint_pop(ctx) & 0xFF);
        store64(ctx + HC_RSTATE, REKHA_RND_SUPER);
        return 1;
    }
    if (op == 0x77) {
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_set_super(ctx, REKHA_HINT_GRID45, rekha_hint_pop(ctx) & 0xFF);
        store64(ctx + HC_RSTATE, REKHA_RND_SUPER45);
        return 1;
    }
    # ── the single-value graphics-state setters ──
    if (op == 0x1A) {                                     # SMD — minimum distance, F26Dot6
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_MINDIST, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1D) {                                     # SCVTCI — control-value cut-in
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_CVTCUT, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1E) {                                     # SSWCI — single-width cut-in
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_SWCUT, rekha_hint_pop(ctx));
        return 1;
    }
    if (op == 0x1F) {
        # ⚠ SSW's operand is in FONT UNITS while every other distance here is F26Dot6, so it is the
        # one setter that scales. Storing it raw would make a single width tens of pixels wide.
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_SWVAL, rekha_hint_mulfix(rekha_hint_pop(ctx), load64(ctx + HC_SCALE)));
        return 1;
    }
    if (op == 0x4D) { store64(ctx + HC_AUTOFLIP, 1); return 1; }
    if (op == 0x4E) { store64(ctx + HC_AUTOFLIP, 0); return 1; }
    if (op == 0x5E) {
        # ⚠ SDB KEEPS THE LOW 16 BITS, UNSIGNED, as FreeType's GS.delta_base is an FT_UShort
        # (ref2143/ttinterp.c:4169-4173): `SDB -1` is a base of 65535, which puts every DELTAP /
        # DELTAC band out of reach, and 65545 is a base of 9. Storing the raw value would fire
        # exceptions FreeType never applies.
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        store64(ctx + HC_DBASE, rekha_hint_pop(ctx) & 0xFFFF);
        return 1;
    }
    if (op == 0x5F) {                                     # SDS
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var ds = rekha_hint_pop(ctx);
        if (ds < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SDS") - 1; }
        if (ds > 6) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SDS") - 1; }
        store64(ctx + HC_DSHIFT, ds);
        return 1;
    }
    if (op == 0x85) {
        # ⭐ SCANCTRL STORES A DECISION, NOT ITS OPERAND. The low byte is a ppem threshold (0xFF:
        # always on, 0: always off) and bits 8 and 11 say "on at or below it" / "off above it";
        # the rotated and stretched bits never apply here. What a consumer reads back through
        # REKHA_GS_SCANCTRL is FreeType's resulting Bool (ref2143/ttinterp.c:4740-4775), which is
        # also the value `prep` hands the glyph programs — Liberation Sans pushes 0x190 and the
        # answer is 1 at every size.
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var sc = rekha_hint_pop(ctx);
        var th = sc & 0xFF;
        if (th == 0xFF) { store64(ctx + HC_SCANCTL, 1); return 1; }
        if (th == 0)    { store64(ctx + HC_SCANCTL, 0); return 1; }
        var ppem = load64(ctx + HC_PPEM);
        if ((sc & 0x100) != 0) { if (ppem <= th) { store64(ctx + HC_SCANCTL, 1); } }
        if ((sc & 0x800) != 0) { if (ppem > th)  { store64(ctx + HC_SCANCTL, 0); } }
        return 1;
    }
    if (op == 0x8D) {                                     # SCANTYPE — low 16 bits; negative ignored
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var sty = rekha_hint_pop(ctx);
        if (sty >= 0) { store64(ctx + HC_SCANTYPE, sty & 0xFFFF); }
        return 1;
    }
    if (op == 0x8E) {
        # ⚠ INSTCTRL takes the SELECTOR on top and the value below. This is the one operand order
        # here that real bytecode did not settle: the only site in the host corpus pushes `1 1`.
        # The selector is an index 1..3 naming a bit; the value is 0 or that bit's flag.
        # ⛔ IT BINDS ONLY INSIDE `prep` (ref2143/ttinterp.c:4714-4718): in the font program or a
        # program handed to rekha_hint_run it pops its operands and changes nothing.
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var sel = rekha_hint_pop(ctx);
        var val = rekha_hint_pop(ctx);
        if (sel < 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        if (sel > 3) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        var kf = 1 << (sel - 1);
        if (val != 0) {
            if (val != kf) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "INSTCTRL") - 1; }
        }
        if (load64(ctx + HC_RANGE) == 2) {
            store64(ctx + HC_INSTCTL, (load64(ctx + HC_INSTCTL) & (0xFF - kf)) | val);
        }
        return 1;
    }
    if (op == 0x4F) {
        # ⛔ DEBUG IS A REFUSAL. The spec calls it a no-op that pops one value, but FreeType's
        # Ins_DEBUG raises Debug_OpCode unconditionally, in every code range and both its modes
        # (ref2143/ttinterp.c:2895-2898): a font program or `prep` that reaches it is unhintable
        # there, and a glyph program stops at it. The operand is not popped, since nothing after
        # this instruction runs.
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DEBUG") - 1;
    }
    if (op == 0x7E) {                                     # SANGW — obsolete, pops one
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    if (op == 0x7F) {                                     # AA — obsolete, pops one
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        rekha_hint_pop(ctx);
        return 1;
    }
    return rekha_hint_op_mem(ctx, op);
}

# ================================================================
# The instruction set, part three: the storage area, the control values, and what the machine can
# be asked about itself.
# ⛔ AN INDEX OUTSIDE THE FONT'S OWN DECLARED LIMIT IS A REFUSAL. FreeType, outside its pedantic
# mode, ignores the write and reads back 0; rekha refuses the run and names the instruction,
# because a `prep` writing past maxStorage has contradicted its own `maxp` and the glyph that
# comes out either way is not the one the font describes. ⚠ It is a real divergence, and the one
# to revisit first if a face in the wild trips it.
# ⛔ A GLYPH PROGRAM WRITES A PRIVATE COPY. In the glyph range (HC_RANGE 4) the first WS copies the
# storage area and the first WCVTP or DELTAC copies the control values into the load's own arrays
# and repoints HC_STORE / HC_CVT at them, so the next glyph starts from what `prep` left
# (ref2143/ttinterp.c:1320-1337 Modify_CVT_Check, :2777-2795 Ins_WS). The copy is shared by every
# program of ONE load — each component's and the composite's — and discarded by the next
# rekha_hint_glyph. In the other ranges every write persists.
# ================================================================

# The copy-on-write of the control values and of the storage area: in the glyph range, on the
# first write of a load, the size's array is copied into the glyph's and the current pointer moved.
fn rekha_hint_cow_cvt(ctx): i64 {
    if (load64(ctx + HC_RANGE) != 4) { return 0; }
    var src = load64(ctx + HC_CVTS);
    if (load64(ctx + HC_CVT) != src) { return 0; }
    var dst = load64(ctx + HC_CVTG);
    var n = load64(ctx + HC_CVTCAP);
    var i = 0;
    while (i < n) { store64(dst + i * 8, load64(src + i * 8)); i = i + 1; }
    store64(ctx + HC_CVT, dst);
    return 1;
}

fn rekha_hint_cow_store(ctx): i64 {
    if (load64(ctx + HC_RANGE) != 4) { return 0; }
    var src = load64(ctx + HC_STOS);
    if (load64(ctx + HC_STORE) != src) { return 0; }
    var dst = load64(ctx + HC_STOG);
    var n = load64(ctx + HC_STORECAP);
    var i = 0;
    while (i < n) { store64(dst + i * 8, load64(src + i * 8)); i = i + 1; }
    store64(ctx + HC_STORE, dst);
    return 1;
}

fn rekha_hint_op_mem(ctx, op): i64 {
    if (op == 0x43) {                                     # RS — read storage
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var l1 = rekha_hint_pop(ctx);
        if (l1 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RS index") - 1; }
        if (l1 >= load64(ctx + HC_STORECAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RS index") - 1;
        }
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_STORE) + l1 * 8)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x42) {                                     # WS — value on top, location below
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v2 = rekha_hint_pop(ctx);
        var l2 = rekha_hint_pop(ctx);
        if (l2 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WS index") - 1; }
        if (l2 >= load64(ctx + HC_STORECAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WS index") - 1;
        }
        rekha_hint_cow_store(ctx);
        store64(load64(ctx + HC_STORE) + l2 * 8, v2);
        return 1;
    }
    if (op == 0x45) {                                     # RCVT
        if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
        var l3 = rekha_hint_pop(ctx);
        if (l3 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RCVT index") - 1; }
        if (l3 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "RCVT index") - 1;
        }
        if (rekha_hint_push(ctx, load64(load64(ctx + HC_CVT) + l3 * 8)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x44) {                                     # WCVTP — already in pixels
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v4 = rekha_hint_pop(ctx);
        var l4 = rekha_hint_pop(ctx);
        if (l4 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTP index") - 1; }
        if (l4 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTP index") - 1;
        }
        rekha_hint_cow_cvt(ctx);
        store64(load64(ctx + HC_CVT) + l4 * 8, v4);
        return 1;
    }
    if (op == 0x70) {
        # WCVTF — in font units, so it scales by the SIZE's scale. ⚠ AND IT WRITES WHEREVER HC_CVT
        # POINTS: FreeType's Ins_WCVTF stores straight into `exc->cvt` with no Modify_CVT_Check
        # (ref2143/ttinterp.c:2832-2846), so in a glyph program it lands in the glyph's private
        # copy if a WCVTP or DELTAC of this load already made one, and otherwise in the SIZE's
        # control values, where every later glyph at this size sees it. Copied, not corrected.
        if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
        var v5 = rekha_hint_pop(ctx);
        var l5 = rekha_hint_pop(ctx);
        if (l5 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTF index") - 1; }
        if (l5 >= load64(ctx + HC_CVTCAP)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "WCVTF index") - 1;
        }
        store64(load64(ctx + HC_CVT) + l5 * 8, rekha_hint_mulfix(v5, load64(ctx + HC_SCALE)));
        return 1;
    }
    if (op == 0x4B) {                                     # MPPEM
        if (rekha_hint_push(ctx, load64(ctx + HC_PPEM)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x4C) {
        # ⚠ MPS answers the PPEM, as an integer, exactly as MPPEM does. That is what the classic
        # interpreter answers (ref2143/ttinterp.c:2390-2395, the version-35 branch); the F26Dot6
        # point size is the version-40 engine's, which rekha is not. 0.8.0 answered ppem * 64.
        if (rekha_hint_push(ctx, load64(ctx + HC_PPEM)) == 0) { return 0 - 1; }
        return 1;
    }
    if (op == 0x88) { return rekha_hint_op_getinfo(ctx); }
    # ── DELTAC1 / DELTAC2 / DELTAC3: per-size exceptions to the control values ──
    if (op >= 0x73) {
        if (op <= 0x75) { return rekha_hint_op_deltac(ctx, op); }
    }
    return 0;
}

# GETINFO — what the font is allowed to ask about the machine it is running on.
# ⛔ EVERY ANSWER BELOW IS A DECISION, and a font program branches on them:
#   version 35. rekha implements the CLASSIC interpreter. Claiming 38 or 40 would promise subpixel
#     positioning and y-only hinting that this file does not do, and modern font programs take a
#     very different path when they see it.
#   rotated 0, stretched 0. rekha applies no transform; a consumer that does applies it after.
#   variations, when the face has live axes — the one bit rekha can answer from its own state.
#   grayscale smoothing ON. rekha's output is filled to COVERAGE by sadish, which is grayscale
#     anti-aliasing; saying otherwise would make a font hint for a bi-level device rekha has none.
#     ⚠ EXCEPT INSIDE `fpgm`, where it answers 0: FreeType runs the font program before the
#     render mode of the first load has been set (ref2143/ttgload.c:2213-2255), and a function
#     defined under one answer is a different function.
#   every ClearType bit 0, because there is no subpixel geometry anywhere in this stack.
fn rekha_hint_op_getinfo(ctx): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var sel = rekha_hint_pop(ctx);
    var r = 0;
    if ((sel & 0x0001) != 0) { r = r | 35; }
    if ((sel & 0x0008) != 0) {
        if (rekha_var_live(load64(ctx + HC_FONT)) != 0) { r = r | 0x0400; }
    }
    if ((sel & 0x0020) != 0) {
        if (load64(ctx + HC_RANGE) != 1) { r = r | 0x1000; }
    }
    if (rekha_hint_push(ctx, r) == 0) { return 0 - 1; }
    return 1;
}

# DELTAC — n, then n pairs of (exception spec, control-value index), index on top.
# The spec byte splits into a ppem selector in its high nibble and a magnitude in its low one:
# the selector plus the delta base (plus 16 for C2 and 32 for C3) is the ppem this applies at, and
# the magnitude runs -8..-1, 1..8 in units of 1/(2^delta_shift) pixels.
# ⚠ THE PAIRS ARE POPPED BEFORE THE PPEM IS LOOKED AT, AND WHEN THIS SIZE IS OUTSIDE THE
# INSTRUCTION'S SIXTEEN-PPEM BAND THE INDICES ARE NOT CHECKED AT ALL (ref2143/ttinterp.c:6389-6465):
# that is FreeType's behaviour in both its modes, so an index past the table in a band the size
# never reaches is not a refusal. Inside the band it is — and every pair's index is checked BEFORE
# the first entry is rewritten, as DELTAP checks its points, so a refused DELTAC leaves the
# control values as they were (FreeType's own loop, ref2143/ttinterp.c:6443-6465, refuses in the
# middle and keeps the entries it already moved). A short stack is a refusal too, before anything
# is popped; FreeType's clamp of the pair count is not copied (design D2).
fn rekha_hint_op_deltac(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var n = rekha_hint_pop(ctx);
    if (n < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC count") - 1; }
    if (rekha_hint_need(ctx, n * 2) == 0) { return 0 - 1; }
    var band = load64(ctx + HC_PPEM) - load64(ctx + HC_DBASE);
    if (op == 0x74) { band = band - 16; }
    if (op == 0x75) { band = band - 32; }
    if (band < 0)  { store64(ctx + HC_SP, load64(ctx + HC_SP) - n * 2); return 1; }
    if (band > 15) { store64(ctx + HC_SP, load64(ctx + HC_SP) - n * 2); return 1; }
    # every index of every pair is checked before the first entry moves
    var sp = load64(ctx + HC_SP);
    var st = load64(ctx + HC_STACK);
    var cap = load64(ctx + HC_CVTCAP);
    var k = 0;
    while (k < n) {
        var ci = load64(st + (sp - 1 - k * 2) * 8);
        if (ci < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC index") - 1; }
        if (ci >= cap) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAC index") - 1; }
        k = k + 1;
    }
    var shift = load64(ctx + HC_DSHIFT);
    k = 0;
    while (k < n) {
        var idx = rekha_hint_pop(ctx);
        var spec = rekha_hint_pop(ctx);
        if ((spec & 0xF0) == (band << 4)) {
            var mag = (spec & 15) - 8;
            if (mag >= 0) { mag = mag + 1; }
            rekha_hint_cow_cvt(ctx);
            var at = load64(ctx + HC_CVT) + idx * 8;
            store64(at, load64(at) + sd_asr(mag * 64, shift));
        }
        k = k + 1;
    }
    return 1;
}

# GETVARIATION 0x91 — the current normalized axis coordinates, one F2Dot14 per axis, first axis
# deepest (ref2143/ttinterp.c:6609-6638). ⚠ rekha's own coordinates are 16.16 (src/var.cyr) and
# FreeType's conversion is a plain arithmetic shift by two — TRUNCATED toward minus infinity, not
# rounded — so a font asking this is asked what `rekha_var_set_axis` was last told, shifted.
# ⛔ ONLY ON A FACE WHOSE AXES ARE LIVE. FreeType routes 0x91 and 0x92 to these bodies only when
# the face's blend is active and otherwise to Ins_UNKNOWN — a font-defined IDEF for the opcode,
# else the Invalid_Opcode error (ref2143/ttinterp.c:7306-7324; the comment there names a
# shipping font whose fpgm IDEFs both). rekha_hint_exec makes the same choice, on
# `rekha_var_live`. ⚠ FreeType's "active" is any variation API call on the face, even one that
# selects the default instance; rekha's is an axis actually off its default, which is what
# `rekha_var_live` answers — a font that IDEFs 0x91 and is then set to its defaults sees its own
# instruction here and GETVARIATION there.
fn rekha_hint_op_getvariation(ctx): i64 {
    var font = load64(ctx + HC_FONT);
    var n = rekha_var_axis_count(font);
    var i = 0;
    while (i < n) {
        if (rekha_hint_push(ctx, sd_asr(rekha_var_coord(font, i), 2)) == 0) { return 0 - 1; }
        i = i + 1;
    }
    return 1;
}

# GETDATA 0x92 — pushes 17, under the same gate as GETVARIATION (ref2143/ttinterp.c:6649-6653,
# 7316-7324). Nobody knows what it is for; FreeType's own comment says as much.
fn rekha_hint_op_getdata(ctx): i64 {
    if (rekha_hint_push(ctx, 17) == 0) { return 0 - 1; }
    return 1;
}

# ================================================================
# The instruction set, part four: the points. Every instruction that reads or moves a point of
# either zone, IUP included (v0.8.2, at the end of the group).
# Semantics are FreeType 2.14.3's classic interpreter, instruction by instruction, with the
# path:line of each body cited at its handler; the departures in this group are refusals — where
# FreeType outside its pedantic mode skips a point that is not in its zone, answers 0, or pops
# what it can, rekha refuses the run and names the instruction and the operand: "<MNEMONIC>
# point", "<MNEMONIC> cvt", "<MNEMONIC> contour", "<MNEMONIC> zone" — plus the one index class
# FreeType wraps rather than skips, stated at rekha_hint_pt_ok. Every operand is checked BEFORE
# anything is written, so a refused instruction leaves both zones and the reference points as
# they were.
# ⚠ Three different "original distance" recipes are in play and a font can see which is used:
# MDRP and MD[1] between two GLYPH points take the FONT-UNIT distance and scale it once (the two
# scaled positions can differ from that by 1/64); with a twilight point on either end they use the
# scaled originals; MIRP always uses the scaled originals; IP's proportion is taken in font units,
# unscaled, unless a twilight zone is involved. The twilight zone's font-unit positions are 0
# forever, which is why every one of them branches.
# ================================================================
fn rekha_hint_op_point(ctx, op): i64 {
    if (op >= 0x06) {
        if (op <= 0x09) { return rekha_hint_op_sxvtl(ctx, op); }
    }
    if (op == 0x0F) { return rekha_hint_op_isect(ctx); }
    if (op == 0x27) { return rekha_hint_op_alignpts(ctx); }
    if (op == 0x29) { return rekha_hint_op_utp(ctx); }
    if (op == 0x2E) { return rekha_hint_op_mdap(ctx, op); }
    if (op == 0x2F) { return rekha_hint_op_mdap(ctx, op); }
    if (op == 0x30) { return rekha_hint_op_iup(ctx, op); }
    if (op == 0x31) { return rekha_hint_op_iup(ctx, op); }
    if (op >= 0x32) {
        if (op <= 0x33) { return rekha_hint_op_shp(ctx, op); }
        if (op <= 0x35) { return rekha_hint_op_shc(ctx, op); }
        if (op <= 0x37) { return rekha_hint_op_shz(ctx, op); }
        if (op == 0x38) { return rekha_hint_op_shpix(ctx); }
        if (op == 0x39) { return rekha_hint_op_ip(ctx); }
        if (op <= 0x3B) { return rekha_hint_op_msirp(ctx, op); }
        if (op == 0x3C) { return rekha_hint_op_alignrp(ctx); }
        if (op == 0x3E) { return rekha_hint_op_miap(ctx, op); }
        if (op == 0x3F) { return rekha_hint_op_miap(ctx, op); }
    }
    if (op >= 0x46) {
        if (op <= 0x47) { return rekha_hint_op_gc(ctx, op); }
        if (op == 0x48) { return rekha_hint_op_scfs(ctx); }
        if (op <= 0x4A) { return rekha_hint_op_md(ctx, op); }
    }
    if (op == 0x5D) { return rekha_hint_op_deltap(ctx, op); }
    if (op == 0x71) { return rekha_hint_op_deltap(ctx, op); }
    if (op == 0x72) { return rekha_hint_op_deltap(ctx, op); }
    if (op == 0x80) { return rekha_hint_op_flippt(ctx); }
    if (op == 0x81) { return rekha_hint_op_fliprg(ctx, op); }
    if (op == 0x82) { return rekha_hint_op_fliprg(ctx, op); }
    if (op == 0x86) { return rekha_hint_op_sdpvtl(ctx, op); }
    if (op == 0x87) { return rekha_hint_op_sdpvtl(ctx, op); }
    if (op >= 0xC0) {
        if (op <= 0xDF) { return rekha_hint_op_mdrp(ctx, op); }
        return rekha_hint_op_mirp(ctx, op);
    }
    return 0;
}

# SPVTL[a] 0x06-0x07 / SFVTL[a] 0x08-0x09 — a vector along (or across) the line between two
# points, the top of the stack in zp2 and the one below it in zp1 (ref2143/ttinterp.c:3893-3928).
# SPVTL also sets the dual vector.
fn rekha_hint_op_sxvtl(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var p1 = rekha_hint_pop(ctx);
    var p2 = rekha_hint_pop(ctx);
    var u: i64[2];
    if (op <= 0x07) {
        if (rekha_hint_sxvtl(ctx, op, p1, p2, &u, "SPVTL point") == 0) { return 0 - 1; }
        store64(ctx + HC_PVX, load64(&u));   store64(ctx + HC_PVY, load64(&u + 8));
        store64(ctx + HC_DVX, load64(&u));   store64(ctx + HC_DVY, load64(&u + 8));
        rekha_hint_movevec(ctx);
        return 1;
    }
    if (rekha_hint_sxvtl(ctx, op, p1, p2, &u, "SFVTL point") == 0) { return 0 - 1; }
    store64(ctx + HC_FVX, load64(&u));   store64(ctx + HC_FVY, load64(&u + 8));
    rekha_hint_movevec(ctx);
    return 1;
}

# SDPVTL[a] 0x86-0x87 — the dual vector from the ORIGINAL positions of the two points and the
# projection vector from their CURRENT positions (ref2143/ttinterp.c:4463-4543). ⚠ The rotation
# flag is one local shared by both halves: when the original points coincide it is cleared, and
# the projection vector is then not rotated either, even if the current points differ.
fn rekha_hint_op_sdpvtl(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var p1 = rekha_hint_pop(ctx);
    var p2 = rekha_hint_pop(ctx);
    var zn2 = rekha_hint_zp(ctx, 2);
    var zn1 = rekha_hint_zp(ctx, 1);
    if (rekha_hint_pt_ok(ctx, zn1, p2, "SDPVTL point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn2, p1, "SDPVTL point") == 0) { return 0 - 1; }
    var rot = op & 1;
    var a = rekha_hint_zorg_x(zn1, p2) - rekha_hint_zorg_x(zn2, p1);
    var b = rekha_hint_zorg_y(zn1, p2) - rekha_hint_zorg_y(zn2, p1);
    if (a == 0) { if (b == 0) { a = 0x4000; rot = 0; } }
    if (rot != 0) {
        var c = b;
        b = a;
        a = 0 - c;
    }
    var u: i64[2];
    rekha_hint_normalize(a, b, &u);
    store64(ctx + HC_DVX, load64(&u));   store64(ctx + HC_DVY, load64(&u + 8));
    a = rekha_hint_zpt_x(zn1, p2) - rekha_hint_zpt_x(zn2, p1);
    b = rekha_hint_zpt_y(zn1, p2) - rekha_hint_zpt_y(zn2, p1);
    if (a == 0) { if (b == 0) { a = 0x4000; rot = 0; } }
    if (rot != 0) {
        var c2 = b;
        b = a;
        a = 0 - c2;
    }
    rekha_hint_normalize(a, b, &u);
    store64(ctx + HC_PVX, load64(&u));   store64(ctx + HC_PVY, load64(&u + 8));
    rekha_hint_movevec(ctx);
    return 1;
}

# ISECT 0x0F — move a point of zp2 to where line A (two points of zp1) crosses line B (two of
# zp0), by Cramer's rule in F26Dot6; two lines within about three degrees of parallel put the
# point at the mean of the four ends instead (ref2143/ttinterp.c:5723-5808). ⚠ Neither the
# projection nor the freedom vector is consulted: the point is written on both axes and touched
# on both.
fn rekha_hint_op_isect(ctx): i64 {
    if (rekha_hint_need(ctx, 5) == 0) { return 0 - 1; }
    var b1 = rekha_hint_pop(ctx);
    var b0 = rekha_hint_pop(ctx);
    var a1 = rekha_hint_pop(ctx);
    var a0 = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var zn2 = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pt_ok(ctx, zn0, b0, "ISECT point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn0, b1, "ISECT point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn1, a0, "ISECT point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn1, a1, "ISECT point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn2, p, "ISECT point") == 0) { return 0 - 1; }
    var dbx = rekha_hint_zpt_x(zn0, b1) - rekha_hint_zpt_x(zn0, b0);
    var dby = rekha_hint_zpt_y(zn0, b1) - rekha_hint_zpt_y(zn0, b0);
    var dax = rekha_hint_zpt_x(zn1, a1) - rekha_hint_zpt_x(zn1, a0);
    var day = rekha_hint_zpt_y(zn1, a1) - rekha_hint_zpt_y(zn1, a0);
    var dx = rekha_hint_zpt_x(zn0, b0) - rekha_hint_zpt_x(zn1, a0);
    var dy = rekha_hint_zpt_y(zn0, b0) - rekha_hint_zpt_y(zn1, a0);
    var disc = rekha_hint_muldiv(dax, 0 - dby, 0x40) + rekha_hint_muldiv(day, dbx, 0x40);
    var dot = rekha_hint_muldiv(dax, dbx, 0x40) + rekha_hint_muldiv(day, dby, 0x40);
    var adisc = disc;
    if (adisc < 0) { adisc = 0 - adisc; }
    var adot = dot;
    if (adot < 0) { adot = 0 - adot; }
    var cx = load64(zn2 + ZN_CURX) + p * 8;
    var cy = load64(zn2 + ZN_CURY) + p * 8;
    if (19 * adisc > adot) {
        var val = rekha_hint_muldiv(dx, 0 - dby, 0x40) + rekha_hint_muldiv(dy, dbx, 0x40);
        store64(cx, rekha_hint_zpt_x(zn1, a0) + rekha_hint_muldiv(val, dax, disc));
        store64(cy, rekha_hint_zpt_y(zn1, a0) + rekha_hint_muldiv(val, day, disc));
    }
    if (19 * adisc <= adot) {
        store64(cx, (rekha_hint_zpt_x(zn1, a0) + rekha_hint_zpt_x(zn1, a1)
            + rekha_hint_zpt_x(zn0, b0) + rekha_hint_zpt_x(zn0, b1)) / 4);
        store64(cy, (rekha_hint_zpt_y(zn1, a0) + rekha_hint_zpt_y(zn1, a1)
            + rekha_hint_zpt_y(zn0, b0) + rekha_hint_zpt_y(zn0, b1)) / 4);
    }
    var tg = load64(zn2 + ZN_TAGS) + p;
    store8(tg, load8(tg) | (REKHA_TAG_TOUCHX | REKHA_TAG_TOUCHY));
    return 1;
}

# ALIGNPTS 0x27 — move two points, the top of the stack in zp0 and the one below it in zp1, each
# halfway toward the other along the projection (ref2143/ttinterp.c:5817-5842). The half is
# truncated toward zero, so an odd distance leaves them one 1/64 apart.
fn rekha_hint_op_alignpts(ctx): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var p2 = rekha_hint_pop(ctx);
    var p1 = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    if (rekha_hint_pt_ok(ctx, zn1, p1, "ALIGNPTS point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn0, p2, "ALIGNPTS point") == 0) { return 0 - 1; }
    var d = rekha_hint_project(ctx, rekha_hint_zpt_x(zn0, p2) - rekha_hint_zpt_x(zn1, p1),
      rekha_hint_zpt_y(zn0, p2) - rekha_hint_zpt_y(zn1, p1)) / 2;
    rekha_hint_move(ctx, zn1, p1, d);
    rekha_hint_move(ctx, zn0, p2, 0 - d);
    return 1;
}

# UTP 0x29 — clear the touch bit of each axis the freedom vector has a component on, for a point
# of zp0 (ref2143/ttinterp.c:6018-6044).
fn rekha_hint_op_utp(ctx): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 0);
    if (rekha_hint_pt_ok(ctx, zn, p, "UTP point") == 0) { return 0 - 1; }
    var mask = 0xFF;
    if (load64(ctx + HC_FVX) != 0) { mask = mask - REKHA_TAG_TOUCHX; }
    if (load64(ctx + HC_FVY) != 0) { mask = mask - REKHA_TAG_TOUCHY; }
    var tg = load64(zn + ZN_TAGS) + p;
    store8(tg, load8(tg) & mask);
    return 1;
}

# MDAP[a] 0x2E-0x2F — a point of zp0 becomes rp0 and rp1; with the low bit set its projection is
# rounded and it moves by the difference, without it the move is 0 and the point is still
# touched (ref2143/ttinterp.c:5269-5305). No control value, no cut-in, no minimum distance.
fn rekha_hint_op_mdap(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 0);
    if (rekha_hint_pt_ok(ctx, zn, p, "MDAP point") == 0) { return 0 - 1; }
    var d = 0;
    if ((op & 1) != 0) {
        var cd = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p), rekha_hint_zpt_y(zn, p));
        d = rekha_hint_round(ctx, cd) - cd;
    }
    rekha_hint_move(ctx, zn, p, d);
    store64(ctx + HC_RP0, p);
    store64(ctx + HC_RP1, p);
    return 1;
}

# SHP[a] 0x32-0x33 — shift `loop` points of zp2, each popped from the stack, by how far the
# reference point (bit 0: rp1 in zp0, else rp2 in zp1) has moved from its original position
# (ref2143/ttinterp.c:4999-5047). A point listed twice moves twice; the reference itself is not
# excluded. ⛔ THE LOOP COUNTER IS CONSUMED AND RESET TO 1 ON EVERY EXIT, as by SHPIX, IP, ALIGNRP
# and FLIPPT — the five instructions that read it.
fn rekha_hint_op_shp(ctx, op): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop) == 0) { return 0 - 1; }
    var dp: i64[4];
    if (rekha_hint_displacement(ctx, op, &dp, "SHP point") == 0) { return 0 - 1; }
    var zn2 = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pts_ok(ctx, zn2, loop, "SHP point") == 0) { return 0 - 1; }
    while (loop > 0) {
        rekha_hint_move_zp2(ctx, zn2, rekha_hint_pop(ctx), load64(&dp), load64(&dp + 8), 1);
        loop = loop - 1;
    }
    return 1;
}

# SHC[a] 0x34-0x35 — shift every point of one contour of zp2 by the reference point's
# displacement, EXCEPT the reference point itself when it lies in that same zone
# (ref2143/ttinterp.c:5061-5101). ⚠ The twilight zone has one virtual contour, number 0, holding
# all its points; naming contour 1 there is a refusal.
# ⛔ THE CONTOUR-END TABLE IS NOT TRUSTED EITHER. FreeType walks from the previous contour's end
# to this one's and relies on its loader for both being inside the zone (:5087-5100); rekha
# refuses a contour whose ends put the walk before point 0, past ZN_N or backwards, so the
# descriptor defends itself even though the loader validates every end it copies in.
# ⚠ The ends of a zone are RELATIVE to its first point — inside a composite a component's program
# runs on a sub-zone whose descriptor starts at the component (rekha_hint_subzone) — so FreeType's
# `- first_point` (:5088, :5094) has nothing to subtract here.
fn rekha_hint_op_shc(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var c = rekha_hint_pop(ctx);
    var zn2 = rekha_hint_zp(ctx, 2);
    var twilight = 0;
    if (rekha_hint_gep(ctx, 2) == 0) { twilight = 1; }
    var bounds = load64(zn2 + ZN_NC);
    if (twilight == 1) { bounds = 1; }
    if (c < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1; }
    if (c >= bounds) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1; }
    var start = 0;
    var limit = load64(zn2 + ZN_N);
    if (twilight == 0) {
        var ctrs = load64(zn2 + ZN_CTRS);
        if (c > 0) { start = load64(ctrs + (c - 1) * 8) + 1; }
        limit = load64(ctrs + c * 8) + 1;
        if (start < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1; }
        if (limit > load64(zn2 + ZN_N)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1;
        }
        if (start > limit) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHC contour") - 1; }
    }
    var dp: i64[4];
    if (rekha_hint_displacement(ctx, op, &dp, "SHC point") == 0) { return 0 - 1; }
    var refzn = load64(&dp + 16);
    var refp = load64(&dp + 24);
    var i = start;
    while (i < limit) {
        var skip = 0;
        if (refzn == zn2) { if (refp == i) { skip = 1; } }
        if (skip == 0) { rekha_hint_move_zp2(ctx, zn2, i, load64(&dp), load64(&dp + 8), 1); }
        i = i + 1;
    }
    return 1;
}

# SHZ[a] 0x36-0x37 — shift every point of zp2 by the reference point's displacement, without
# touching any of them and skipping the reference point when it is in that zone
# (ref2143/ttinterp.c:5111-5149). ⚠ The operand is a zone number, checked to be 0 or 1 and then
# NOT USED: the zone shifted is zp2. In the glyph zone the four phantom points are left where they
# are — the walk stops at the last contour's end, which is refused when it lies outside the zone
# (the same self-defence as SHC's; FreeType trusts its loader at :5137-5142).
# ⛔ EXCEPT IN THE PROGRAM OF A NESTED COMPOSITE, WHERE FreeType HAS A DEFECT AND rekha COPIES ITS
# VISIBLE EFFECT. Unlike SHC and IUP, Ins_SHZ never subtracts the zone's `first_point` from the
# last contour's end (:5139), and that end is ABSOLUTE in the assembled glyph while the zone's
# arrays start at the composite's start point S (ref2143/ttgload.c:1240): the program of a
# composite that is itself a component at point S of its parent walks S slots past its own last
# point — through its four phantom points, which shift with the outline, and then past the end of
# the loader's points array. That last part is an OUT-OF-BOUNDS WRITE in FreeType (Move_Zp2_Point
# stores through zp2.cur), undefined behaviour that on the host corrupts the heap or the tag bytes
# next to the array, so nothing past the phantoms is a reference. rekha adds HC_FIRSTPT to the
# relative limit and CLAMPS the walk at the sub-zone's end: the phantoms move exactly as FreeType's
# do, nothing outside the zone is touched, and the two agree on every point, tag and advance
# wherever the reference survives. programs/hint_unit_vectors.cyr's `comp_nested_first_point` row
# pins the visible part (the sub-zone's pp1 moves and the whole glyph is reported shifted).
# ⚠ ONLY THERE. A SIMPLE component's program runs with first_point 0 whatever its base in the
# parent (:914), so its SHZ stops at its own last contour and its phantoms stay — HC_FIRSTPT is
# carried by rekha_hint_run_glyph for exactly this distinction. Pinned in docs/development/roadmap.md.
fn rekha_hint_op_shz(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var z = rekha_hint_pop(ctx);
    if (z < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHZ zone") - 1; }
    if (z > 1) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHZ zone") - 1; }
    var zn2 = rekha_hint_zp(ctx, 2);
    var limit = load64(zn2 + ZN_N);
    if (rekha_hint_gep(ctx, 2) != 0) {
        var nc = load64(zn2 + ZN_NC);
        limit = 0;
        if (nc > 0) { limit = load64(load64(zn2 + ZN_CTRS) + (nc - 1) * 8) + 1; }
        if (limit < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHZ zone") - 1; }
        if (limit > load64(zn2 + ZN_N)) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "SHZ zone") - 1;
        }
        limit = limit + rekha_hint_first_point(ctx);
        if (limit > load64(zn2 + ZN_N)) { limit = load64(zn2 + ZN_N); }
    }
    var dp: i64[4];
    if (rekha_hint_displacement(ctx, op, &dp, "SHZ point") == 0) { return 0 - 1; }
    var refzn = load64(&dp + 16);
    var refp = load64(&dp + 24);
    var i = 0;
    while (i < limit) {
        var skip = 0;
        if (refzn == zn2) { if (refp == i) { skip = 1; } }
        if (skip == 0) { rekha_hint_move_zp2(ctx, zn2, i, load64(&dp), load64(&dp + 8), 0); }
        i = i + 1;
    }
    return 1;
}

# SHPIX 0x38 — shift `loop` points of zp2 by an F26Dot6 amount (on top of the stack, above the
# points) along the freedom vector: the amount times each component, NOT through the move vector
# (ref2143/ttinterp.c:5152-5218). Consumes and resets the loop counter.
fn rekha_hint_op_shpix(ctx): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop + 1) == 0) { return 0 - 1; }
    var amount = rekha_hint_pop(ctx);
    var dx = rekha_hint_dot14(amount, 0, load64(ctx + HC_FVX), 0);
    var dy = rekha_hint_dot14(amount, 0, load64(ctx + HC_FVY), 0);
    var zn2 = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pts_ok(ctx, zn2, loop, "SHPIX point") == 0) { return 0 - 1; }
    while (loop > 0) {
        rekha_hint_move_zp2(ctx, zn2, rekha_hint_pop(ctx), dx, dy, 1);
        loop = loop - 1;
    }
    return 1;
}

# IP 0x39 — move `loop` points of zp2 so that each keeps, between rp1 (zp0) and rp2 (zp1), the
# proportion it had in the original outline (ref2143/ttinterp.c:5860-6010). The proportion is
# taken in FONT UNITS along the dual vector unless any of the three zone pointers is the twilight
# zone, in which case the scaled originals serve. ⚠ Two things FreeType does in BOTH modes and
# rekha therefore does too: rp2 outside zp1 makes both ranges 0 rather than a refusal, and a zero
# original range moves the point to its original distance from rp1.
fn rekha_hint_op_ip(ctx): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop) == 0) { return 0 - 1; }
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var zn2 = rekha_hint_zp(ctx, 2);
    var rp1 = load64(ctx + HC_RP1);
    var rp2 = load64(ctx + HC_RP2);
    if (rekha_hint_pt_ok(ctx, zn0, rp1, "IP point") == 0) { return 0 - 1; }
    if (rekha_hint_pts_ok(ctx, zn2, loop, "IP point") == 0) { return 0 - 1; }
    var twilight = 0;
    if (rekha_hint_gep(ctx, 0) == 0) { twilight = 1; }
    if (rekha_hint_gep(ctx, 1) == 0) { twilight = 1; }
    if (rekha_hint_gep(ctx, 2) == 0) { twilight = 1; }
    var obx = rekha_hint_zorus_x(zn0, rp1);
    var oby = rekha_hint_zorus_y(zn0, rp1);
    if (twilight == 1) {
        obx = rekha_hint_zorg_x(zn0, rp1);
        oby = rekha_hint_zorg_y(zn0, rp1);
    }
    var cbx = rekha_hint_zpt_x(zn0, rp1);
    var cby = rekha_hint_zpt_y(zn0, rp1);
    var old_range = 0;
    var cur_range = 0;
    var rp2ok = 0;
    if (rp2 >= 0) { if (rp2 < load64(zn1 + ZN_N)) { rp2ok = 1; } }
    if (rp2ok == 1) {
        if (twilight == 1) {
            old_range = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn1, rp2) - obx,
              rekha_hint_zorg_y(zn1, rp2) - oby);
        }
        if (twilight == 0) {
            old_range = rekha_hint_dualproj(ctx, rekha_hint_zorus_x(zn1, rp2) - obx,
              rekha_hint_zorus_y(zn1, rp2) - oby);
        }
        cur_range = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, rp2) - cbx,
          rekha_hint_zpt_y(zn1, rp2) - cby);
    }
    while (loop > 0) {
        var p = rekha_hint_pop(ctx);
        var org_dist = 0;
        if (twilight == 1) {
            org_dist = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn2, p) - obx,
              rekha_hint_zorg_y(zn2, p) - oby);
        }
        if (twilight == 0) {
            org_dist = rekha_hint_dualproj(ctx, rekha_hint_zorus_x(zn2, p) - obx,
              rekha_hint_zorus_y(zn2, p) - oby);
        }
        var cur_dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn2, p) - cbx,
          rekha_hint_zpt_y(zn2, p) - cby);
        var new_dist = 0;
        if (org_dist != 0) {
            new_dist = org_dist;
            if (old_range != 0) { new_dist = rekha_hint_muldiv(org_dist, cur_range, old_range); }
        }
        rekha_hint_move(ctx, zn2, p, new_dist - cur_dist);
        loop = loop - 1;
    }
    return 1;
}

# MSIRP[a] 0x3A-0x3B — set the distance of a point of zp1 from rp0 (zp0) to an F26Dot6 value from
# the stack, exactly: no rounding, no control value, no minimum distance
# (ref2143/ttinterp.c:5221-5266). ⚠ Into the twilight zone the point's ORIGINAL position is set
# first — rp0's original moved by the distance — and its current position made equal to it.
# rp1 becomes the old rp0, rp2 the point, and with the low bit set rp0 the point too.
fn rekha_hint_op_msirp(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var d = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var rp0 = load64(ctx + HC_RP0);
    if (rekha_hint_pt_ok(ctx, zn1, p, "MSIRP point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn0, rp0, "MSIRP point") == 0) { return 0 - 1; }
    if (rekha_hint_gep(ctx, 1) == 0) {
        store64(load64(zn1 + ZN_ORGX) + p * 8, rekha_hint_zorg_x(zn0, rp0));
        store64(load64(zn1 + ZN_ORGY) + p * 8, rekha_hint_zorg_y(zn0, rp0));
        rekha_hint_move_orig(ctx, zn1, p, d);
        store64(load64(zn1 + ZN_CURX) + p * 8, rekha_hint_zorg_x(zn1, p));
        store64(load64(zn1 + ZN_CURY) + p * 8, rekha_hint_zorg_y(zn1, p));
    }
    var dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, p) - rekha_hint_zpt_x(zn0, rp0),
      rekha_hint_zpt_y(zn1, p) - rekha_hint_zpt_y(zn0, rp0));
    rekha_hint_move(ctx, zn1, p, d - dist);
    store64(ctx + HC_RP1, rp0);
    store64(ctx + HC_RP2, p);
    if ((op & 1) != 0) { store64(ctx + HC_RP0, p); }
    return 1;
}

# ALIGNRP 0x3C — move `loop` points of zp1 onto rp0's (zp0) projection
# (ref2143/ttinterp.c:5666-5720). Consumes and resets the loop counter.
fn rekha_hint_op_alignrp(ctx): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop) == 0) { return 0 - 1; }
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var rp0 = load64(ctx + HC_RP0);
    if (rekha_hint_pt_ok(ctx, zn0, rp0, "ALIGNRP point") == 0) { return 0 - 1; }
    if (rekha_hint_pts_ok(ctx, zn1, loop, "ALIGNRP point") == 0) { return 0 - 1; }
    var rx = rekha_hint_zpt_x(zn0, rp0);
    var ry = rekha_hint_zpt_y(zn0, rp0);
    while (loop > 0) {
        var p = rekha_hint_pop(ctx);
        var d = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, p) - rx, rekha_hint_zpt_y(zn1, p) - ry);
        rekha_hint_move(ctx, zn1, p, 0 - d);
        loop = loop - 1;
    }
    return 1;
}

# MIAP[a] 0x3E-0x3F — move a point of zp0 to a control value's absolute distance along the
# projection; it becomes rp0 and rp1 (ref2143/ttinterp.c:5308-5389). With the low bit set the
# control value is dropped for the point's own projection when the two differ by MORE than the
# cut-in (strictly), and the result is rounded; without it the raw control value is used.
# ⚠ In the twilight zone the point's original AND current positions are first set to the control
# value along the freedom vector, absolutely — which is how a `prep` plants the heights its glyph
# programs will interpolate against.
fn rekha_hint_op_miap(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var ci = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 0);
    if (rekha_hint_pt_ok(ctx, zn, p, "MIAP point") == 0) { return 0 - 1; }
    if (ci < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MIAP cvt") - 1; }
    if (ci >= load64(ctx + HC_CVTCAP)) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MIAP cvt") - 1;
    }
    var dist = load64(load64(ctx + HC_CVT) + ci * 8);
    if (rekha_hint_gep(ctx, 0) == 0) {
        var ox = rekha_hint_dot14(dist, 0, load64(ctx + HC_FVX), 0);
        var oy = rekha_hint_dot14(dist, 0, load64(ctx + HC_FVY), 0);
        store64(load64(zn + ZN_ORGX) + p * 8, ox);
        store64(load64(zn + ZN_ORGY) + p * 8, oy);
        store64(load64(zn + ZN_CURX) + p * 8, ox);
        store64(load64(zn + ZN_CURY) + p * 8, oy);
    }
    var org_dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p), rekha_hint_zpt_y(zn, p));
    if ((op & 1) != 0) {
        var delta = dist - org_dist;
        if (delta < 0) { delta = 0 - delta; }
        if (delta > load64(ctx + HC_CVTCUT)) { dist = org_dist; }
        dist = rekha_hint_round(ctx, dist);
    }
    rekha_hint_move(ctx, zn, p, dist - org_dist);
    store64(ctx + HC_RP0, p);
    store64(ctx + HC_RP1, p);
    return 1;
}

# GC[a] 0x46-0x47 — push a point of zp2's coordinate: its current position along the projection
# vector, or with the low bit set its ORIGINAL position along the dual vector
# (ref2143/ttinterp.c:4318-4343).
fn rekha_hint_op_gc(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pt_ok(ctx, zn, p, "GC point") == 0) { return 0 - 1; }
    var r = 0;
    if ((op & 1) != 0) {
        r = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn, p), rekha_hint_zorg_y(zn, p));
    }
    if ((op & 1) == 0) {
        r = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p), rekha_hint_zpt_y(zn, p));
    }
    if (rekha_hint_push(ctx, r) == 0) { return 0 - 1; }
    return 1;
}

# SCFS 0x48 — move a point of zp2 so that its projection becomes the F26Dot6 value on top of the
# stack (ref2143/ttinterp.c:4356-4380). ⚠ In the twilight zone the original position follows the
# current one afterwards.
fn rekha_hint_op_scfs(ctx): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var v = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn = rekha_hint_zp(ctx, 2);
    if (rekha_hint_pt_ok(ctx, zn, p, "SCFS point") == 0) { return 0 - 1; }
    var k = rekha_hint_project(ctx, rekha_hint_zpt_x(zn, p), rekha_hint_zpt_y(zn, p));
    rekha_hint_move(ctx, zn, p, v - k);
    if (rekha_hint_gep(ctx, 2) == 0) {
        store64(load64(zn + ZN_ORGX) + p * 8, rekha_hint_zpt_x(zn, p));
        store64(load64(zn + ZN_ORGY) + p * 8, rekha_hint_zpt_y(zn, p));
    }
    return 1;
}

# MD[a] 0x49-0x4A — push the distance from a point of zp1 (top of the stack) to a point of zp0:
# with the low bit set between their current positions along the projection vector, without it
# between their originals along the dual vector — in font units scaled once when both are glyph
# points, else between the scaled originals (ref2143/ttinterp.c:4396-4460). ⚠ The flag reads
# inverted against the published spec; the code is what fonts were tested against.
fn rekha_hint_op_md(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var k = rekha_hint_pop(ctx);
    var l = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    if (rekha_hint_pt_ok(ctx, zn0, l, "MD point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn1, k, "MD point") == 0) { return 0 - 1; }
    var d = 0;
    if ((op & 1) != 0) {
        d = rekha_hint_project(ctx, rekha_hint_zpt_x(zn0, l) - rekha_hint_zpt_x(zn1, k),
          rekha_hint_zpt_y(zn0, l) - rekha_hint_zpt_y(zn1, k));
    }
    if ((op & 1) == 0) {
        var twilight = 0;
        if (rekha_hint_gep(ctx, 0) == 0) { twilight = 1; }
        if (rekha_hint_gep(ctx, 1) == 0) { twilight = 1; }
        if (twilight == 1) {
            d = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn0, l) - rekha_hint_zorg_x(zn1, k),
              rekha_hint_zorg_y(zn0, l) - rekha_hint_zorg_y(zn1, k));
        }
        if (twilight == 0) {
            d = rekha_hint_dualproj(ctx, rekha_hint_zorus_x(zn0, l) - rekha_hint_zorus_x(zn1, k),
              rekha_hint_zorus_y(zn0, l) - rekha_hint_zorus_y(zn1, k));
            d = rekha_hint_mulfix(d, load64(ctx + HC_MSCALE));
        }
    }
    if (rekha_hint_push(ctx, d) == 0) { return 0 - 1; }
    return 1;
}

# DELTAP1/2/3 0x5D/0x71/0x72 — n, then n pairs of (exception spec, point index) with the point on
# top of each pair: at exactly one ppem per pair, move the point of zp0 by the spec's magnitude
# in units of 1/(2^delta_shift) pixels along the freedom vector (ref2143/ttinterp.c:6293-6386).
# The spec byte's high nibble plus the delta base (plus 16 for P2, 32 for P3) is the ppem it
# applies at; its low nibble runs -8..-1, 1..8. ⚠ The pairs are popped before the ppem is looked
# at, and OUTSIDE THIS SIZE'S BAND NO POINT INDEX IS CHECKED — FreeType's behaviour in both its
# modes, so a stale exception for a point the glyph lacks is not a refusal at sizes it never
# applies to. Inside the band it is. Does not read or reset the loop counter.
fn rekha_hint_op_deltap(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var n = rekha_hint_pop(ctx);
    if (n < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "DELTAP count") - 1; }
    if (rekha_hint_need(ctx, n * 2) == 0) { return 0 - 1; }
    var band = load64(ctx + HC_PPEM) - load64(ctx + HC_DBASE);
    if (op == 0x71) { band = band - 16; }
    if (op == 0x72) { band = band - 32; }
    if (band < 0)  { store64(ctx + HC_SP, load64(ctx + HC_SP) - n * 2); return 1; }
    if (band > 15) { store64(ctx + HC_SP, load64(ctx + HC_SP) - n * 2); return 1; }
    var zn = rekha_hint_zp(ctx, 0);
    # every point of every pair is checked before the first moves
    var sp = load64(ctx + HC_SP);
    var st = load64(ctx + HC_STACK);
    var k = 0;
    while (k < n) {
        if (rekha_hint_pt_ok(ctx, zn, load64(st + (sp - 1 - k * 2) * 8), "DELTAP point") == 0) {
            return 0 - 1;
        }
        k = k + 1;
    }
    var shift = load64(ctx + HC_DSHIFT);
    k = 0;
    while (k < n) {
        var p = rekha_hint_pop(ctx);
        var spec = rekha_hint_pop(ctx);
        if ((spec & 0xF0) == (band << 4)) {
            var mag = (spec & 15) - 8;
            if (mag >= 0) { mag = mag + 1; }
            rekha_hint_move(ctx, zn, p, sd_asr(mag * 64, shift));
        }
        k = k + 1;
    }
    return 1;
}

# FLIPPT 0x80 — toggle the on-curve bit of `loop` points (ref2143/ttinterp.c:4802-4849).
# ⛔ ON THE GLYPH ZONE WHATEVER THE ZONE POINTERS SAY, like FLIPRGON and FLIPRGOFF: FreeType reads
# `pts`, never zp0..2. Consumes and resets the loop counter.
fn rekha_hint_op_flippt(ctx): i64 {
    var loop = load64(ctx + HC_LOOP);
    store64(ctx + HC_LOOP, 1);
    if (rekha_hint_need(ctx, loop) == 0) { return 0 - 1; }
    var zn = rekha_hint_zone(ctx, 1);
    if (rekha_hint_pts_ok(ctx, zn, loop, "FLIPPT point") == 0) { return 0 - 1; }
    while (loop > 0) {
        var tg = load64(zn + ZN_TAGS) + rekha_hint_pop(ctx);
        store8(tg, load8(tg) ^ REKHA_TAG_ONCURVE);
        loop = loop - 1;
    }
    return 1;
}

# FLIPRGON 0x81 / FLIPRGOFF 0x82 — set or clear the on-curve bit of every glyph-zone point from
# the lower index (below) to the higher (on top), inclusive; a reversed range is empty
# (ref2143/ttinterp.c:4852-4919).
fn rekha_hint_op_fliprg(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var hi = rekha_hint_pop(ctx);
    var lo = rekha_hint_pop(ctx);
    var zn = rekha_hint_zone(ctx, 1);
    var nm = "FLIPRGON point";
    if (op == 0x82) { nm = "FLIPRGOFF point"; }
    if (rekha_hint_pt_ok(ctx, zn, hi, nm) == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn, lo, nm) == 0) { return 0 - 1; }
    var tags = load64(zn + ZN_TAGS);
    var i = lo;
    while (i <= hi) {
        if (op == 0x81) { store8(tags + i, load8(tags + i) | REKHA_TAG_ONCURVE); }
        if (op == 0x82) { store8(tags + i, load8(tags + i) & (0xFF - REKHA_TAG_ONCURVE)); }
        i = i + 1;
    }
    return 1;
}

# The original distance of MDRP and MD[0]: font units scaled once when both points are glyph
# points, the scaled originals when either is a twilight point (ref2143/ttinterp.c:5419-5450).
# ⚠ Scaled by HC_MSCALE, not HC_SCALE: the two are the same number in a simple glyph's program
# and 1.0 in a composite's, whose font units ARE the assembled pixels (see HC_MSCALE).
fn rekha_hint_org_dist(ctx, zn1, p, zn0, rp0): i64 {
    var twilight = 0;
    if (rekha_hint_gep(ctx, 0) == 0) { twilight = 1; }
    if (rekha_hint_gep(ctx, 1) == 0) { twilight = 1; }
    if (twilight == 1) {
        return rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn1, p) - rekha_hint_zorg_x(zn0, rp0),
          rekha_hint_zorg_y(zn1, p) - rekha_hint_zorg_y(zn0, rp0));
    }
    var d = rekha_hint_dualproj(ctx, rekha_hint_zorus_x(zn1, p) - rekha_hint_zorus_x(zn0, rp0),
      rekha_hint_zorus_y(zn1, p) - rekha_hint_zorus_y(zn0, rp0));
    return rekha_hint_mulfix(d, load64(ctx + HC_MSCALE));
}

# The minimum-distance clamp of MDRP and MIRP: the distance may not fall short of the minimum in
# the direction the original distance points (a zero original counts as positive).
fn rekha_hint_min_dist(ctx, d, org_dist): i64 {
    var md = load64(ctx + HC_MINDIST);
    if (org_dist >= 0) {
        if (d < md) { return md; }
        return d;
    }
    if (d > (0 - md)) { return 0 - md; }
    return d;
}

# MDRP[abcde] 0xC0-0xDF — move a point of zp1 to its original distance from rp0 (zp0), through
# the single-width cut-in, the round bit (bit 2) and the minimum-distance bit (bit 3)
# (ref2143/ttinterp.c:5392-5510). Bits 0-1 name an engine compensation, all of which are 0. rp1
# becomes the old rp0, rp2 the point, and with bit 4 rp0 the point too. No control value, no
# control-value cut-in, no auto-flip, no twilight write.
fn rekha_hint_op_mdrp(ctx, op): i64 {
    if (rekha_hint_need(ctx, 1) == 0) { return 0 - 1; }
    var p = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var rp0 = load64(ctx + HC_RP0);
    if (rekha_hint_pt_ok(ctx, zn1, p, "MDRP point") == 0) { return 0 - 1; }
    if (rekha_hint_pt_ok(ctx, zn0, rp0, "MDRP point") == 0) { return 0 - 1; }
    var org_dist = rekha_hint_org_dist(ctx, zn1, p, zn0, rp0);
    # single width: |org_dist - value| < cut-in, both strict, and only with a cut-in above 0.
    # ⚠ The sign is decided ONCE, on the ORIGINAL distance (ref2143/ttinterp.c:5464-5467, an
    # if/else): SSW takes any operand, so the single width can be negative, and a second test on
    # the value just written would flip a negative width back to positive.
    var swc = load64(ctx + HC_SWCUT);
    var swv = load64(ctx + HC_SWVAL);
    if (swc > 0) {
        if (org_dist < swv + swc) {
            if (org_dist > swv - swc) {
                var neg = 0;
                if (org_dist < 0) { neg = 1; }
                org_dist = swv;
                if (neg == 1) { org_dist = 0 - swv; }
            }
        }
    }
    var d = org_dist;
    if ((op & 4) != 0) { d = rekha_hint_round(ctx, org_dist); }
    if ((op & 8) != 0) { d = rekha_hint_min_dist(ctx, d, org_dist); }
    var cur_dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, p) - rekha_hint_zpt_x(zn0, rp0),
      rekha_hint_zpt_y(zn1, p) - rekha_hint_zpt_y(zn0, rp0));
    rekha_hint_move(ctx, zn1, p, d - cur_dist);
    store64(ctx + HC_RP1, rp0);
    store64(ctx + HC_RP2, p);
    if ((op & 16) != 0) { store64(ctx + HC_RP0, p); }
    return 1;
}

# MIRP[abcde] 0xE0-0xFF — move a point of zp1 to a control value's distance from rp0 (zp0),
# through the single-width cut-in on the control value, auto-flip, the control-value cut-in
# (only under the round bit, and only when both points are in the same zone), the round bit and
# the minimum-distance bit (ref2143/ttinterp.c:5513-5663). ⚠ Control value index -1 is legal and
# reads a distance of 0. In the twilight zone the point's original AND current positions are first
# set to rp0's original plus the control value along the freedom vector. The original distance
# here is ALWAYS between the scaled originals — never font units, unlike MDRP's. rp updates as
# MDRP's.
fn rekha_hint_op_mirp(ctx, op): i64 {
    if (rekha_hint_need(ctx, 2) == 0) { return 0 - 1; }
    var ci = rekha_hint_pop(ctx);
    var p = rekha_hint_pop(ctx);
    var zn0 = rekha_hint_zp(ctx, 0);
    var zn1 = rekha_hint_zp(ctx, 1);
    var rp0 = load64(ctx + HC_RP0);
    if (rekha_hint_pt_ok(ctx, zn1, p, "MIRP point") == 0) { return 0 - 1; }
    if (ci < (0 - 1)) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MIRP cvt") - 1; }
    if (ci >= load64(ctx + HC_CVTCAP)) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "MIRP cvt") - 1;
    }
    if (rekha_hint_pt_ok(ctx, zn0, rp0, "MIRP point") == 0) { return 0 - 1; }
    var cvt_dist = 0;
    if (ci >= 0) { cvt_dist = load64(load64(ctx + HC_CVT) + ci * 8); }
    # single width: |cvt_dist - value| < cut-in, strict; a cut-in of 0 never fires. The sign is
    # decided once, on the control value as it was (ref2143/ttinterp.c:5562-5565, an if/else) —
    # see MDRP for why a second test on the written value is wrong when the width is negative.
    var swv = load64(ctx + HC_SWVAL);
    var delta = cvt_dist - swv;
    if (delta < 0) { delta = 0 - delta; }
    if (delta < load64(ctx + HC_SWCUT)) {
        var neg = 0;
        if (cvt_dist < 0) { neg = 1; }
        cvt_dist = swv;
        if (neg == 1) { cvt_dist = 0 - swv; }
    }
    if (rekha_hint_gep(ctx, 1) == 0) {
        var ox = rekha_hint_zorg_x(zn0, rp0) + rekha_hint_dot14(cvt_dist, 0, load64(ctx + HC_FVX), 0);
        var oy = rekha_hint_zorg_y(zn0, rp0) + rekha_hint_dot14(cvt_dist, 0, load64(ctx + HC_FVY), 0);
        store64(load64(zn1 + ZN_ORGX) + p * 8, ox);
        store64(load64(zn1 + ZN_ORGY) + p * 8, oy);
        store64(load64(zn1 + ZN_CURX) + p * 8, ox);
        store64(load64(zn1 + ZN_CURY) + p * 8, oy);
    }
    var org_dist = rekha_hint_dualproj(ctx, rekha_hint_zorg_x(zn1, p) - rekha_hint_zorg_x(zn0, rp0),
      rekha_hint_zorg_y(zn1, p) - rekha_hint_zorg_y(zn0, rp0));
    var cur_dist = rekha_hint_project(ctx, rekha_hint_zpt_x(zn1, p) - rekha_hint_zpt_x(zn0, rp0),
      rekha_hint_zpt_y(zn1, p) - rekha_hint_zpt_y(zn0, rp0));
    # auto-flip: a control value whose sign disagrees with the original distance is negated
    if (load64(ctx + HC_AUTOFLIP) != 0) {
        if ((org_dist ^ cvt_dist) < 0) { cvt_dist = 0 - cvt_dist; }
    }
    var d = cvt_dist;
    if ((op & 4) != 0) {
        if (rekha_hint_gep(ctx, 0) == rekha_hint_gep(ctx, 1)) {
            var cut = cvt_dist - org_dist;
            if (cut < 0) { cut = 0 - cut; }
            if (cut > load64(ctx + HC_CVTCUT)) { cvt_dist = org_dist; }
        }
        d = rekha_hint_round(ctx, cvt_dist);
    }
    if ((op & 8) != 0) { d = rekha_hint_min_dist(ctx, d, org_dist); }
    rekha_hint_move(ctx, zn1, p, d - cur_dist);
    store64(ctx + HC_RP1, rp0);
    store64(ctx + HC_RP2, p);
    if ((op & 16) != 0) { store64(ctx + HC_RP0, p); }
    return 1;
}

# IUP[a] 0x30-0x31 — interpolate the UNTOUCHED points of every contour of the glyph zone between
# their touched neighbours, on one axis: 0x31 x (points touched in x), 0x30 y
# (ref2143/ttinterp.c:6189-6290, the two workers at :6060-6179). ⛔ ON THE GLYPH ZONE WHATEVER THE
# ZONE POINTERS SAY, like FLIPPT; no operand, no stack effect, no refusal — FreeType has none
# either, and a contour end past the zone is clamped to its last point as FreeType clamps it
# (:6242-6243). Per contour: the first touched point is found; every run of untouched points
# between two touched ones is interpolated; the run from the last touched point round to the
# first is interpolated across the wrap; a contour with exactly ONE touched point is shifted
# rigidly by that point's move; a contour with none is left alone. The four phantom points are in
# no contour and are never read or moved. Every point written here stays UNTOUCHED, which is why a
# program runs IUP last. The ends are relative to the zone's first point (see SHC), which is
# FreeType's `- first_point` (:6239) already done.
fn rekha_hint_op_iup(ctx, op): i64 {
    var zn = ctx + HC_ZONE1;
    var nc = load64(zn + ZN_NC);
    var n = load64(zn + ZN_N);
    if (nc <= 0) { return 1; }
    if (n <= 0) { return 1; }
    var ax = ZN_ORUSY;
    var mask = REKHA_TAG_TOUCHY;
    if (op == 0x31) { ax = ZN_ORUSX; mask = REKHA_TAG_TOUCHX; }
    # the three positions on the chosen axis: orus, org, cur are 16 bytes apart in the descriptor
    var orus = load64(zn + ax);
    var org = load64(zn + ax + 16);
    var cur = load64(zn + ax + 32);
    var tags = load64(zn + ZN_TAGS);
    var ctrs = load64(zn + ZN_CTRS);
    var point = 0;
    var contour = 0;
    while (contour < nc) {
        var end = load64(ctrs + contour * 8);
        if (end < 0) { end = n - 1; }
        if (end >= n) { end = n - 1; }
        var first = point;
        while (point <= end) {
            if ((load8(tags + point) & mask) != 0) { break; }
            point = point + 1;
        }
        if (point <= end) {
            var first_touched = point;
            var cur_touched = point;
            point = point + 1;
            while (point <= end) {
                if ((load8(tags + point) & mask) != 0) {
                    rekha_hint_iup_interp(orus, org, cur, n, cur_touched + 1, point - 1, cur_touched, point);
                    cur_touched = point;
                }
                point = point + 1;
            }
            if (cur_touched == first_touched) {
                rekha_hint_iup_shift(org, cur, first, end, cur_touched);
            }
            if (cur_touched != first_touched) {
                rekha_hint_iup_interp(orus, org, cur, n, cur_touched + 1, end, cur_touched, first_touched);
                if (first_touched > 0) {
                    rekha_hint_iup_interp(orus, org, cur, n, first, first_touched - 1, cur_touched,
                      first_touched);
                }
            }
        }
        contour = contour + 1;
    }
    return 1;
}

# IUP's rigid shift: the one touched point `p` of a contour [p1, p2] has moved by cur - org, and
# every other point of the contour follows it (ref2143/ttinterp.c:6060-6078).
fn rekha_hint_iup_shift(org, cur, p1, p2, p): i64 {
    var dx = load64(cur + p * 8) - load64(org + p * 8);
    if (dx == 0) { return 0; }
    var i = p1;
    while (i < p) {
        store64(cur + i * 8, load64(cur + i * 8) + dx);
        i = i + 1;
    }
    i = p + 1;
    while (i <= p2) {
        store64(cur + i * 8, load64(cur + i * 8) + dx);
        i = i + 1;
    }
    return 0;
}

# IUP's interpolation of the untouched points [p1, p2] between the touched ref1 and ref2
# (ref2143/ttinterp.c:6082-6179). The two references are ordered by their ORIGINAL UNSCALED
# position (orus; for a composite's program that is the assembled pixel position); a point whose
# scaled original (org) lies at or before the lower reference's takes that reference's move, at or
# after the higher one's the other's, and one strictly between is placed by proportion — in font
# units through FT_DivFix / FT_MulFix, one rounding — unless the two references share a current
# position or an original one, when it snaps to the first. `n` bounds the references; an out-of-
# zone reference skips the run silently, as FreeType's BOUNDS test does.
fn rekha_hint_iup_interp(orus, org, cur, n, p1, p2, ref1, ref2): i64 {
    if (p1 > p2) { return 0; }
    if (ref1 < 0) { return 0; }
    if (ref1 >= n) { return 0; }
    if (ref2 < 0) { return 0; }
    if (ref2 >= n) { return 0; }
    var orus1 = load64(orus + ref1 * 8);
    var orus2 = load64(orus + ref2 * 8);
    if (orus1 > orus2) {
        var t = orus1;
        orus1 = orus2;
        orus2 = t;
        var r = ref1;
        ref1 = ref2;
        ref2 = r;
    }
    var org1 = load64(org + ref1 * 8);
    var org2 = load64(org + ref2 * 8);
    var cur1 = load64(cur + ref1 * 8);
    var cur2 = load64(cur + ref2 * 8);
    var delta1 = cur1 - org1;
    var delta2 = cur2 - org2;
    var snap = 0;
    if (cur1 == cur2) { snap = 1; }
    if (orus1 == orus2) { snap = 1; }
    var scale = 0;
    if (snap == 0) { scale = rekha_hint_divfix(cur2 - cur1, orus2 - orus1); }
    var i = p1;
    while (i <= p2) {
        var x = load64(org + i * 8);
        if (x <= org1) {
            x = x + delta1;
        } else {
            if (x >= org2) {
                x = x + delta2;
            } else {
                x = cur1;
                if (snap == 0) {
                    x = cur1 + rekha_hint_mulfix(load64(orus + i * 8) - orus1, scale);
                }
            }
        }
        store64(cur + i * 8, x);
        i = i + 1;
    }
    return 0;
}

# An instruction the font defined for itself, as [start, end, buffer], or 0.
fn rekha_hint_find_idef(ctx, op): i64 {
    var n = load64(ctx + HC_IDEFN);
    var at = load64(ctx + HC_IDEF);
    var i = 0;
    while (i < n) {
        if (load64(at + i * 32) == op) { return at + i * 32 + 8; }
        i = i + 1;
    }
    return 0;
}

# Push `n` operands of `w` bytes each, starting at `at`. The two-byte form is SIGNED.
fn rekha_hint_do_push(ctx, buf, at, n, w): i64 {
    var i = 0;
    while (i < n) {
        var v = load8(buf + at + i);
        if (w == 2) { v = rekha_rd_i16(buf, at + i * 2); }
        if (rekha_hint_push(ctx, v) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# The executor. One program, from `ip` to `end`, both absolute offsets into `buf`.
# Answers 1 when the program ran to its end or hit an ENDF, 0 when it refused — and every 0 has a
# code and a detail on the context.
# ⚠ A CALL RECURSES HERE rather than pushing a return frame, which is how src/cff.cyr runs a subr
# and for the same reason: the nesting is the language's, the cap is rekha's.
# ================================================================
fn rekha_hint_exec(ctx, buf, ip, end): i64 {
    if (load64(ctx + HC_DEPTH) > REKHA_HINT_MAXDEPTH) {
        return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "call depth");
    }
    var base = ip;
    while (ip < end) {
        var bud = load64(ctx + HC_BUDGET);
        if (bud <= 0) {
            return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "instruction budget");
        }
        store64(ctx + HC_BUDGET, bud - 1);
        var op = load8(buf + ip);
        var ln = rekha_hint_ilen(buf, ip, end);
        if (ln <= 0) { return rekha_hint_fail(ctx, REKHA_ERR_TRUNCATED, "push operands"); }
        if (ip + ln > end) { return rekha_hint_fail(ctx, REKHA_ERR_TRUNCATED, "instruction"); }
        var nip = ip + ln;
        var r = 0;
        # ── the eighteen push opcodes ──
        if (op == 0x40) {
            if (rekha_hint_do_push(ctx, buf, ip + 2, load8(buf + ip + 1), 1) == 0) { return 0; }
            r = 1;
        }
        if (op == 0x41) {
            if (rekha_hint_do_push(ctx, buf, ip + 2, load8(buf + ip + 1), 2) == 0) { return 0; }
            r = 1;
        }
        if (r == 0) {
            if (op >= 0xB0) {
                if (op <= 0xB7) {
                    if (rekha_hint_do_push(ctx, buf, ip + 1, op - 0xB0 + 1, 1) == 0) { return 0; }
                    r = 1;
                }
            }
        }
        if (r == 0) {
            if (op >= 0xB8) {
                if (op <= 0xBF) {
                    if (rekha_hint_do_push(ctx, buf, ip + 1, op - 0xB8 + 1, 2) == 0) { return 0; }
                    r = 1;
                }
            }
        }
        # ── IF / ELSE / EIF ──
        if (op == 0x58) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            if (rekha_hint_pop(ctx) == 0) {
                nip = rekha_hint_skip_if(buf, nip, end, 1);
                if (nip < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IF without EIF"); }
            }
            r = 1;
        }
        # An ELSE reached by execution means the THEN branch was taken and is over.
        if (op == 0x1B) {
            nip = rekha_hint_skip_if(buf, nip, end, 0);
            if (nip < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "ELSE without EIF"); }
            r = 1;
        }
        if (op == 0x59) { r = 1; }
        # ── the three jumps. ⛔ THE OFFSET IS RELATIVE TO THE JUMP INSTRUCTION ITSELF, not to the
        #    byte after it, so `JMPR 0` is an infinite loop and the instruction budget is what
        #    stops it. Both conditional forms take the CONDITION on top and the offset below. ──
        if (op == 0x1C) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            nip = ip + rekha_hint_pop(ctx);
            r = 1;
        }
        if (op == 0x78) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var c1 = rekha_hint_pop(ctx);
            var o1 = rekha_hint_pop(ctx);
            if (c1 != 0) { nip = ip + o1; }
            r = 1;
        }
        if (op == 0x79) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var c2 = rekha_hint_pop(ctx);
            var o2 = rekha_hint_pop(ctx);
            if (c2 == 0) { nip = ip + o2; }
            r = 1;
        }
        # ⚠ WHERE A JUMP MAY LAND. At the TOP LEVEL a target past the end of the program ENDS IT,
        # normally: FreeType's main loop treats an instruction pointer at or beyond the code size
        # with an empty call stack as the program being over (ref2143/ttinterp.c:7391-7401), and
        # Ins_JMPR itself refuses only a negative target there (:3204-3210). Inside a function the
        # target may not pass the function's end (the same lines refuse it), and rekha ALSO refuses
        # a target before the function's start — FreeType accepts one and runs whatever bytes
        # precede the body, which no font means; that refusal is a stated pin.
        if (r == 1) {
            if (nip < base) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "jump out of range"); }
            if (nip > end) {
                if (load64(ctx + HC_DEPTH) != 0) {
                    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "jump out of range");
                }
                nip = end;
            }
        }
        # ── FDEF / IDEF: the body is SCANNED, never executed, which is why a font program made
        #    entirely of function definitions runs on an interpreter with no points. ──
        if (op == 0x2C) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            var fn1 = rekha_hint_pop(ctx);
            # ⛔ THE NUMBER MAY BE ANYTHING IN 0..0xFFFF, AND THE TABLE IS A LIST (ref2143/ttinterp.c
            # :3284-3309): a number already defined is REDEFINED IN PLACE — some font programs do
            # that — and only a new one takes a record, so the refusal is on the COUNT of distinct
            # functions reaching maxFunctionDefs (floored at 64, see rekha_hint_ctx_new), never on
            # the number itself. FreeType casts the operand unsigned and refuses above 0xFFFF; a
            # negative one is the same refusal here.
            if (fn1 < 0)      { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF number"); }
            if (fn1 > 0xFFFF) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF number"); }
            # ⛔ NOT IN A GLYPH PROGRAM: FreeType's DEF_In_Glyf_Bytecode, in both its modes
            # (ref2143/ttinterp.c:3275-3279; IDEF likewise at :3564-3568). A program handed to
            # rekha_hint_run is range 3 and may define what it likes.
            if (load64(ctx + HC_RANGE) == 4) {
                return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF in glyph program");
            }
            var e1 = rekha_hint_scan_endf(buf, nip, end);
            if (e1 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF without ENDF"); }
            var fslot = rekha_hint_find_fdef(ctx, fn1);
            if (fslot == 0) {
                var nf = load64(ctx + HC_FDEFN);
                if (nf >= load64(ctx + HC_FDEFCAP)) {
                    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "FDEF over maxFunctionDefs");
                }
                fslot = load64(ctx + HC_FDEF) + nf * 32;
                store64(ctx + HC_FDEFN, nf + 1);
            }
            store64(fslot, fn1);
            store64(fslot + 8, nip);
            store64(fslot + 16, e1);
            store64(fslot + 24, buf);
            nip = e1 + 1;
            r = 1;
        }
        if (op == 0x89) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            var oc = rekha_hint_pop(ctx);
            # ⛔ THE OPCODE MUST BE A BYTE. An operand outside 0..255 is a refusal, not masked:
            # FreeType raises Too_Many_Instruction_Defs for it in both modes
            # (ref2143/ttinterp.c:3590-3595), so `PUSHW 0x100 IDEF` is unhintable there and must
            # not quietly define opcode 0 here.
            if (oc < 0)    { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF opcode"); }
            if (oc > 0xFF) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF opcode"); }
            if (load64(ctx + HC_RANGE) == 4) {
                return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF in glyph program");
            }
            # ⚠ An opcode already defined is REDEFINED IN PLACE, and only a new one takes a slot
            # (ref2143/ttinterp.c:3571-3588): a `prep` that defines an instruction runs once per
            # size, and appending each time would fill maxInstructionDefs on the second size.
            var e2 = rekha_hint_scan_endf(buf, nip, end);
            if (e2 < 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF without ENDF"); }
            var ni = load64(ctx + HC_IDEFN);
            var slot = rekha_hint_find_idef(ctx, oc);
            if (slot != 0) { slot = slot - 8; }
            if (slot == 0) {
                if (ni >= load64(ctx + HC_IDEFCAP)) {
                    return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "IDEF over maxInstructionDefs");
                }
                slot = load64(ctx + HC_IDEF) + ni * 32;
                store64(ctx + HC_IDEFN, ni + 1);
            }
            store64(slot, oc);
            store64(slot + 8, nip);
            store64(slot + 16, e2);
            store64(slot + 24, buf);
            nip = e2 + 1;
            r = 1;
        }
        # ── ENDF ends this call. At the top level of a program there is nothing to end. ──
        if (op == 0x2D) {
            if (load64(ctx + HC_DEPTH) == 0) {
                return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "ENDF outside a function");
            }
            return 1;
        }
        # ── CALL and LOOPCALL. ⭐ The FUNCTION is on top in both; LOOPCALL's count is below it,
        #    which real bytecode settled (see the header). ──
        if (op == 0x2B) {
            if (rekha_hint_need(ctx, 1) == 0) { return 0; }
            if (rekha_hint_call(ctx, rekha_hint_pop(ctx), 1) == 0) { return 0; }
            r = 1;
        }
        if (op == 0x2A) {
            if (rekha_hint_need(ctx, 2) == 0) { return 0; }
            var lf = rekha_hint_pop(ctx);
            var lc = rekha_hint_pop(ctx);
            if (rekha_hint_call(ctx, lf, lc) == 0) { return 0; }
            r = 1;
        }
        # ── GETVARIATION / GETDATA, only while the face's axes are live; on a static face the two
        #    opcodes fall through to the font's own IDEF or to the undefined-opcode refusal, which
        #    is FreeType's routing (ref2143/ttinterp.c:7306-7324). See rekha_hint_op_getvariation
        #    for what "live" means here against what it means there. ──
        if (op == 0x91) {
            if (rekha_var_live(load64(ctx + HC_FONT)) != 0) {
                if (rekha_hint_op_getvariation(ctx) < 0) { return 0; }
                r = 1;
            }
        }
        if (op == 0x92) {
            if (rekha_var_live(load64(ctx + HC_FONT)) != 0) {
                if (rekha_hint_op_getdata(ctx) < 0) { return 0; }
                r = 1;
            }
        }
        # ── everything else, in four groups ──
        if (r == 0) {
            var h = rekha_hint_op_alu(ctx, op);
            if (h < 0) { return 0; }
            if (h > 0) { r = 1; }
        }
        if (r == 0) {
            var h2 = rekha_hint_op_gs(ctx, op);
            if (h2 < 0) { return 0; }
            if (h2 > 0) { r = 1; }
        }
        if (r == 0) {
            var h3 = rekha_hint_op_point(ctx, op);
            if (h3 < 0) { return 0; }
            if (h3 > 0) { r = 1; }
        }
        if (r == 0) {
            # An opcode the font defined for itself is the last thing it can be.
            var d = rekha_hint_find_idef(ctx, op);
            if (d == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "undefined opcode"); }
            store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) + 1);
            var ok = rekha_hint_exec(ctx, load64(d + 16), load64(d), load64(d + 8));
            store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) - 1);
            if (ok == 0) { return 0; }
        }
        ip = nip;
    }
    return 1;
}

# Run function `f` `count` times. ⚠ Each repetition costs a unit of the instruction budget on top
# of the body's own, so a LOOPCALL handed a hostile count is stopped by the same guard a JMPR loop
# is, and not by a separate cap that would have to be kept in step with it.
fn rekha_hint_call(ctx, f, count): i64 {
    # The number is LOOKED UP, not used as an index (ref2143/ttinterp.c:3404-3435 and the same in
    # Ins_LOOPCALL): a number no program defined — negative, past 0xFFFF or simply never seen — is
    # one refusal, FreeType's Invalid_Reference.
    var at = rekha_hint_find_fdef(ctx, f);
    if (at == 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "undefined function"); }
    var start = load64(at + 8);
    var stop = load64(at + 16);
    # ⛔ THE BODY'S OWN BUFFER, NOT THE CALLER'S. A function defined by `fpgm` is a range into the
    # font bytes; one defined by any other program is a range into that program. Running a body
    # against whichever buffer happens to be executing reads whatever lies at those offsets and
    # calls it bytecode — found by programs/hint_test.cyr's CALL check, which got the untouched
    # operand back instead of the sum.
    var bbuf = load64(at + 24);
    var i = 0;
    while (i < count) {
        var bud = load64(ctx + HC_BUDGET);
        if (bud <= 0) { return rekha_hint_fail(ctx, REKHA_ERR_BAD_HINT, "instruction budget"); }
        store64(ctx + HC_BUDGET, bud - 1);
        store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) + 1);
        var ok = rekha_hint_exec(ctx, bbuf, start, stop);
        store64(ctx + HC_DEPTH, load64(ctx + HC_DEPTH) - 1);
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Run `len` bytes of bytecode at `off` in `buf`. 1 when it ran, 0 when it refused, with
# `rekha_hint_error` saying why. This is how a test drives one instruction at a time; the font
# program and `prep` go through the same executor with their own code range (rekha_hint_run_fpgm,
# rekha_hint_run_prep). A program run this way is RANGE 3, the test range: to two of the four
# instructions that ask it is a glyph program — INSTCTRL does nothing and GETINFO reports
# grayscale on — and in the other two ways it is NOT FreeType's glyph range, which is RANGE 4 and
# `rekha_hint_glyph`'s alone: there FDEF and IDEF are refused (DEF_In_Glyf_Bytecode,
# ref2143/ttinterp.c:3275-3279, 3564-3568) where this range accepts them — programs/hint_test.cyr's
# own programs define functions — and a glyph program's WS / WCVTP / DELTAC write the load's PRIVATE
# COPY of the storage area and the control values (ref2143/ttinterp.c:1320-1337, 2777-2795), where
# here every write persists into the next run. A test that wants the glyph range's fill without the
# glyph's own program loads through rekha_hint_load_simple and runs its bytes here.
# ⚠ THE BYTES ARE BORROWED. They must outlive the call, and a function defined by a program is
# recorded as a RANGE INTO THEM together with the buffer itself — so a program that defines one
# must live as long as the context, and a CALL runs the body against the buffer that DEFINED it
# rather than against the one that is executing.
# ⚠ Each call resets the instruction budget and the call depth; it does NOT reset the stack, the
# storage area, the control values, the zones or the graphics state, because a program run here
# is entitled to see what the one before it left (which is the second difference above).
fn rekha_hint_run(ctx, buf, off, len): i64 {
    if (ctx == 0) { return 0; }
    return rekha_hint_run_range(ctx, buf, off, len, 3);
}

# The executor's entry for all four code ranges: 1 `fpgm`, 2 `prep`, 3 a program handed to
# rekha_hint_run, 4 a glyph's own (rekha_hint_glyph). HC_RANGE holds the range for the run and is 0
# again afterwards.
fn rekha_hint_run_range(ctx, buf, off, len, range): i64 {
    rekha_hint_error_clear(ctx);
    if (buf == 0) { return rekha_hint_fail(ctx, REKHA_ERR_OTHER, "program"); }
    if (len < 0) { return rekha_hint_fail(ctx, REKHA_ERR_OTHER, "program"); }
    if (len == 0) { return 1; }
    store64(ctx + HC_BUDGET, REKHA_HINT_BUDGET);
    store64(ctx + HC_DEPTH, 0);
    store64(ctx + HC_RANGE, range);
    var ok = rekha_hint_exec(ctx, buf, off, off + len);
    store64(ctx + HC_RANGE, 0);
    return ok;
}

# How many twilight points a run may address. ⚠ FreeType caps the zone per run at
# max(30, 2 * (glyph points + control values)) as a guard against malformed bytecode
# (ref2143/ttinterp.c:7449-7462), and never at fewer than the font declared plus four; rekha caps
# at the font's own maxTwilightPoints, without the four, so the bound is the smaller of the two.
# rekha_hint_zone_clear still clears them all. `rekha_hint_zone_points(ctx, 0)` answers the bound.
fn rekha_hint_twilight_bound(ctx): i64 {
    var tz = load64(load64(ctx + HC_FONT) + 800);
    var n = 2 * (load64(ctx + HC_ZONE1 + ZN_N) + load64(ctx + HC_CVTCAP));
    if (n < 30) { n = 30; }
    if (n > tz) { n = tz; }
    store64(ctx + HC_ZONE0 + ZN_N, n);
    return n;
}

# Run the font program. Called for you by `rekha_hint_ctx` on the first build and never
# again: `fpgm` defines functions, and a function is a range into font bytes that does not move
# with size. ⚠ It resets the graphics state first and marks the face done EVEN IF IT REFUSES, so a
# broken `fpgm` is reported once rather than re-run at every size — and its refusal is kept as
# the face's standing refusal, which every `rekha_hint_ctx` and `rekha_hint_run_prep` re-raises
# without running anything, the way FreeType fails every later load with `bytecode_ready`.
fn rekha_hint_run_fpgm(ctx): i64 {
    if (ctx == 0) { return 0; }
    var font = load64(ctx + HC_FONT);
    rekha_hint_reset(ctx);
    rekha_hint_twilight_bound(ctx);
    store64(ctx + HC_FPGMOK, 1);
    store64(ctx + HC_FPGMERR, REKHA_OK);
    store64(ctx + HC_FPGMDET, 0);
    var n = load64(font + 712);
    if (n <= 0) {
        rekha_hint_error_clear(ctx);
        return 1;
    }
    var ok = rekha_hint_run_range(ctx, load64(ctx + HC_BUF), load64(font + 704), n, 1);
    if (ok == 0) {
        store64(ctx + HC_FPGMERR, load64(ctx + HC_ERR));
        store64(ctx + HC_FPGMDET, load64(ctx + HC_DETAIL));
    }
    return ok;
}

# @public — the whole per-size entry: rebuild the size's state and run the control-value program
# on it. 1 when `prep` ran (an absent or empty `prep` counts as ran), 0 when it refused or when the
# font program's standing refusal is re-raised instead, without running. Called for you by
# `rekha_hint_ctx` on every size change; calling it again is idempotent — same control values,
# same storage, same twilight zone, same graphics state — because it rebuilds first. It is
# FreeType's `cvt_ready < 0` path (ref2143/ttobjs.c:940-1003), in the same order:
#   the control values and the storage area repointed at the SIZE's arrays (a glyph load's
#   private copies are forgotten); the control values re-scaled FROM THE FONT at this ppem; the
#   graphics state to its defaults and the stack emptied; the twilight zone back to the origin,
#   untouched; the storage area CLEARED; the glyph zone and the outline view invalidated, since
#   their points were scaled at the old size; then `prep`, with the glyph zone empty; then the
#   snapshot and the scales below.
# The function table and the instruction table are the one thing a re-run keeps.
# ⛔ AFTERWARDS THE GRAPHICS STATE IS THE DEFAULTS PLUS THE TEN FIELDS `prep` MAY LEAVE — minimum
# distance, the two cut-ins, the single width, delta base and shift, auto-flip, INSTCTRL,
# SCANCTRL, SCANTYPE (ref2143/ttinterp.c:323-341): the vectors, the reference points, the zone
# pointers, the loop counter and the rounding state a `prep` set are discarded, and whatever it
# left on the stack with them. So `rekha_hint_gs` after `rekha_hint_ctx` shows what a glyph program
# starts from — and the same ten are SNAPSHOTTED into HC_GSSAVE, from which every program of every
# later glyph load starts (rekha_hint_run_begin). A REFUSED `prep` leaves pure defaults, in the
# live state and in the snapshot (ref2143/ttobjs.c:997-1000).
# ⚠ Two things FreeType does that rekha does not, both stated in the CHANGELOG: it zeroes the
# twilight zone's positions only, never its tags — rekha zeroes both, visible only through
# `rekha_hint_point`; and a face whose `prep` is ABSENT OR EMPTY inherits a stale graphics state
# there (ref2143/ttobjs.c:994-1000 saves ten fields no run refreshed) — rekha gives the defaults.
# INSTCTRL's bits 1 and 2, which disable the glyph programs or start each from ALL defaults, are
# applied by rekha_hint_glyph at the next load, in FreeType's order (ref2143/ttgload.c:2269-2274).
# ⚠ A glyph program's WCVTP at size A is that load's alone; the context re-scaled to size B and
# back to A answers the fresh scale at both, because this rebuilds first.
public fn rekha_hint_run_prep(ctx): i64 {
    if (ctx == 0) { return 0; }
    var font = load64(ctx + HC_FONT);
    store64(ctx + HC_CVT, load64(ctx + HC_CVTS));
    store64(ctx + HC_STORE, load64(ctx + HC_STOS));
    store64(ctx + HC_PREPERR, REKHA_OK);
    store64(ctx + HC_PREPDET, 0);
    store64(ctx + HC_MSCALE, load64(ctx + HC_SCALE));
    store64(ctx + HC_TWCAP, load64(font + 800));
    rekha_hint_view_clear(ctx);
    if (load64(ctx + HC_FPGMERR) != REKHA_OK) {
        return rekha_hint_fail(ctx, load64(ctx + HC_FPGMERR), load64(ctx + HC_FPGMDET));
    }
    rekha_hint_scale_cvt(ctx);
    rekha_hint_reset(ctx);
    rekha_hint_zone_clear(ctx + HC_ZONE0, load64(font + 800));
    var sto = load64(ctx + HC_STORECAP);
    var i = 0;
    while (i < sto) { store64(load64(ctx + HC_STOS) + i * 8, 0); i = i + 1; }
    rekha_hint_twilight_bound(ctx);
    var n = load64(font + 728);
    var ok = 1;
    if (n > 0) { ok = rekha_hint_run_range(ctx, load64(ctx + HC_BUF), load64(font + 720), n, 2); }
    if (n <= 0) { rekha_hint_error_clear(ctx); }
    if (ok == 0) {
        store64(ctx + HC_PREPERR, load64(ctx + HC_ERR));
        store64(ctx + HC_PREPDET, load64(ctx + HC_DETAIL));
        rekha_hint_reset(ctx);
        rekha_hint_gs_save(ctx);
        return 0;
    }
    # keep the ten, reset the rest — HC_MINDIST through HC_SCANTYPE are contiguous — and snapshot
    # them for the glyph loads
    rekha_hint_gs_save(ctx);
    rekha_hint_reset(ctx);
    rekha_hint_gs_restore(ctx);
    return 1;
}

# ================================================================
# The glyph zone: loading a glyph, and hinting it (v0.8.2).
# ⭐ THIS IS FreeType's load_truetype_glyph (ref2143/ttgload.c:1401-1927) FOR ZONE 1, IN PLACE. A
# simple glyph is decoded straight into the zone's font-unit arrays by glyf.cyr's shared decoder,
# its four phantom points are appended, everything is scaled, the phantoms are rounded and its
# program runs; a composite is assembled the way FreeType assembles one — each component loaded
# AND HINTED as a glyph of its own at the tail of what is already there (a sub-zone whose
# descriptor starts at the component: rekha_hint_subzone), then transformed and offset in PIXELS,
# then, if the composite carries a program, every point untouched, the originals set to the
# assembled pixels and the program run at scale 1.0 (HC_MSCALE). Nothing is allocated: the zone
# was carved at maxp's own maxima, the load context lives on the stack, and the component
# records are re-walked from the glyf bytes with rekha_comp_record rather than kept.
# ⛔ THE LOAD CAPS ARE THE OUTLINE LOADER'S (src/glyf.cyr: 64 loads, 16,384 points, depth 5, a
# cycle on the component path), plus the zone's own capacity — a glyph past HC_GZCAP / HC_GZCCAP
# has contradicted its maxp and is refused "glyph zone cap" / "contour cap". FreeType's recursion
# cap of 100 is not modelled (a pin).
# ⛔ THREE KINDS OF REFUSAL, AND rekha_hint_glyph SAYS WHICH (its @public comment has the
# consumer's view): a standing fpgm / prep refusal; a PROGRAM refusal — any program of the load,
# a component's or the composite's — after which the glyph is reloaded with no program run at
# all, the whole-load failure of FreeType's PEDANTIC mode where its default mode keeps the
# partially hinted points (a stated divergence); and a STRUCTURAL refusal — a cap, a malformed
# record or header, a bad or cyclic component, a point-matching index past the assembled points
# — after which the zone is empty.
# ================================================================

# The load context, on rekha_hint_glyph's stack: +0 loads left, +8 points left, +16 the refusal
# kind (0 none, 1 a program refused, 2 structural), +24 hinting (0 under INSTCTRL bit 1 and on
# the reload after a program refusal), +32 the contour count the last rekha_hint_load wrote, +40
# the gid at each depth 0..REKHA_COMPOSITE_MAXDEPTH (the cycle detector). 12 slots.
var LC_LOADS = 0;   var LC_PTS = 8;   var LC_KIND = 16;   var LC_HINT = 24;   var LC_NC = 32;
var LC_GIDS = 40;

# FT_PIX_ROUND (ref2143/ftobjs.h): to the nearest whole pixel, ties UP — `(v + 32) & -64` floors
# after adding a half, so -160 becomes -128 where rekha_hint_round's RTG, half away from zero,
# gives -192. The phantom points, a composite's rounded offsets and the advance are all rounded
# THIS way and never through the round state (ref2143/ttgload.c:813-820, 1147-1156; ftobjs.c:898).
fn rekha_hint_pix_round(v): i64 { return (v + 32) & (0 - 64); }

# A structural refusal of the load: the code on the context, the kind on the load context, -1.
fn rekha_hint_load_fail(ctx, lc, code, detail): i64 {
    rekha_hint_fail(ctx, code, detail);
    store64(lc + LC_KIND, 2);
    return 0 - 1;
}

# hmtx for the phantom points, read as tt_face_get_metrics reads it (ref2143/ttmtx.c:228-338) and
# NEVER REFUSING: numberOfHMetrics 0, a long record past the table, or a tail bearing past it
# answer 0 for what could not be read (:264-306), because FreeType's loader carries on with zeros
# where rekha_advance_width and rekha_left_side_bearing would say TRUNCATED. Writes the advance to
# out+0 and the bearing to out+8. ⛔ THE ADVANCE CARRIES ITS HVAR DELTA AND THE BEARING DOES NOT,
# because that is the hinted glyph FreeType draws: tt_face_get_metrics runs the advance through
# the driver's hadvance_adjust hook and the bearing through lsb_adjust (ref2143/ttmtx.c:325-328),
# and the TrueType driver leaves lsb_adjust NULL (ttdriver.c:558-559) — so pp1 = xMin - the
# UNVARIED lsb. Measured on the host: a face whose HVAR lsb map moves glyph 1's bearing by +40
# hints its point 0 at the same x as at the default instance (programs/hint_test.cyr, L).
# rekha_left_side_bearing, the public metric reader, keeps the delta (its frozen semantics match
# rekha_advance_width's); the roadmap pins that the two readers of the lsb disagree on a
# variation instance.
fn rekha_hint_hmetrics(font, gid, out): i64 {
    store64(out, 0);
    store64(out + 8, 0);
    var nhm = load64(font + 104);
    var hmtx = load64(font + 112);
    var len = load64(font + 120);
    if (nhm <= 0) { return 0; }
    if (hmtx == 0) { return 0; }
    var buf = load64(font);
    if (gid < nhm) {
        if (gid * 4 + 4 > len) { return 0; }
        store64(out, rekha_rd_u16(buf, hmtx + gid * 4) + rekha_hvar_advance_delta(font, gid));
        store64(out + 8, rekha_rd_i16(buf, hmtx + gid * 4 + 2));
        return 1;
    }
    if ((nhm - 1) * 4 + 2 > len) { return 0; }
    store64(out, rekha_rd_u16(buf, hmtx + (nhm - 1) * 4) + rekha_hvar_advance_delta(font, gid));
    var at = nhm * 4 + (gid - nhm) * 2;
    if (at + 2 > len) { return 1; }
    store64(out + 8, rekha_rd_i16(buf, hmtx + at));
    return 1;
}

# The vertical pair for the phantom points — top side bearing to out+0, advance height to out+8
# — by TT_Get_VMetrics's three-way rule (ref2143/ttgload.c:116-146): `vmtx` when the face has BOTH
# a vhea and a vmtx (FreeType's vertical_info), read like hmtx with vhea.numOfLongVerMetrics'
# tail rule and never refusing; else OS/2 present: tsb = sTypoAscender - yMax, ah = |sTypoAscender
# - sTypoDescender| (Liberation Sans: 1491 and 1922 for every glyph, NOT hhea's 1854 / 434); else
# hhea: Ascender - yMax, |Ascender - Descender|. The OS/2 pair carries MVAR, the vmtx pair VVAR,
# as rekha's own readers of them do.
# ⛔ A ZERO-LENGTH vmtx IS ABSENT: FreeType's table lookup skips a directory entry whose length
# is 0 (tt_face_lookup_table, ref2143/ttload.c:80-88), so its vmtx never loads and vertical_info
# stays 0 — the OS/2 or hhea pair it is. src/vert.cyr's resolve drops such an entry at open, and
# the length is checked here as well so the branch cannot be taken on a stale slot.
# ⚠ Stated divergence on a malformed OS/2: rekha's OS/2 reader gates on the 78-byte version-0
# layout and treats a shorter table as absent (font + 448 = 0, so hhea decides), where FreeType's
# tt_face_load_os2 reads its 78 field bytes from the stream whatever the directory says and
# takes the OS/2 branch with whatever bytes follow the table. rekha's gate is the saner rule and
# is kept; a face with a 68-byte OS/2 hints its vertical phantoms off-reference (roadmap pin).
fn rekha_hint_vmetrics(font, gid, ymax, out): i64 {
    var asc = 0;
    var desc = 0;
    var have_vmtx = 0;
    if (load64(font + 608) != 0) {
        if (load64(font + 624) != 0) {
            if (load64(font + 632) > 0) { have_vmtx = 1; }
        }
    }
    if (have_vmtx == 1) {
        store64(out, 0);
        store64(out + 8, 0);
        var nvm = load64(font + 616);
        var vmtx = load64(font + 624);
        var len = load64(font + 632);
        var buf = load64(font);
        if (nvm <= 0) { return 1; }
        if (gid < nvm) {
            if (gid * 4 + 4 > len) { return 1; }
            store64(out + 8, rekha_rd_u16(buf, vmtx + gid * 4) + rekha_vvar_delta(font, gid, 8));
            store64(out, rekha_rd_i16(buf, vmtx + gid * 4 + 2) + rekha_vvar_delta(font, gid, 12));
            return 1;
        }
        if ((nvm - 1) * 4 + 2 > len) { return 1; }
        store64(out + 8, rekha_rd_u16(buf, vmtx + (nvm - 1) * 4) + rekha_vvar_delta(font, gid, 8));
        var at = nvm * 4 + (gid - nvm) * 2;
        if (at + 2 > len) { return 1; }
        store64(out, rekha_rd_i16(buf, vmtx + at) + rekha_vvar_delta(font, gid, 12));
        return 1;
    }
    if (load64(font + 448) != 0) {
        asc = rekha_typo_ascender(font);
        desc = rekha_typo_descender(font);
    }
    if (load64(font + 448) == 0) {
        asc = rekha_ascender(font);
        desc = rekha_descender(font);
    }
    var ah = asc - desc;
    if (ah < 0) { ah = 0 - ah; }
    store64(out, asc - ymax);
    store64(out + 8, ah);
    return 1;
}

# The four phantom points of glyph `gid` in FONT UNITS, written to xs[0..3] / ys[0..3]
# (tt_loader_set_pp, ref2143/ttgload.c:1337-1347, the classic form): pp1 = (xMin - lsb, 0),
# pp2 = (pp1.x + advance, 0), pp3 = (0, yMax + tsb), pp4 = (0, pp3.y - ah). `xmin` / `ymax` are
# the glyph HEADER's, both 0 for an empty glyph (:1535-1541).
fn rekha_hint_phantoms(ctx, gid, xmin, ymax, xs, ys): i64 {
    var font = load64(ctx + HC_FONT);
    var hm: i64[2];
    var vm: i64[2];
    rekha_hint_hmetrics(font, gid, &hm);
    rekha_hint_vmetrics(font, gid, ymax, &vm);
    var p1 = xmin - load64(&hm + 8);
    store64(xs, p1);            store64(ys, 0);
    store64(xs + 8, p1 + load64(&hm));   store64(ys + 8, 0);
    var p3 = ymax + load64(&vm);
    store64(xs + 16, 0);        store64(ys + 16, p3);
    store64(xs + 24, 0);        store64(ys + 24, p3 - load64(&vm + 8));
    return 0;
}

# gvar over a zone fill: the np points and the four phantoms after them, in one call, then the
# phantom deltas UNDONE where FreeType zeroes them — pp1 / pp2 on a face with an HVAR table,
# pp3 / pp4 with a VVAR (ref2143/ttgxvar.c:4671-4684), whose metrics readers already carry those
# tables' deltas. On a static face, or at the default location, one load and a return.
fn rekha_hint_gvar(font, gid, xs, ys, np, nc, eps): i64 {
    if (rekha_var_live(font) == 0) { return 0; }
    var keep: i64[8];
    var k = 0;
    while (k < 4) {
        store64(&keep + k * 8, load64(xs + (np + k) * 8));
        store64(&keep + 32 + k * 8, load64(ys + (np + k) * 8));
        k = k + 1;
    }
    var varied = rekha_gvar_apply_n(font, gid, xs, ys, np, nc, eps, np + 4);
    if (varied == 0) { return 0; }
    if (load64(font + 416) != 0) {
        store64(xs + np * 8, load64(&keep));        store64(ys + np * 8, load64(&keep + 32));
        store64(xs + (np + 1) * 8, load64(&keep + 8));   store64(ys + (np + 1) * 8, load64(&keep + 40));
    }
    if (load64(font + 656) != 0) {
        store64(xs + (np + 2) * 8, load64(&keep + 16));   store64(ys + (np + 2) * 8, load64(&keep + 48));
        store64(xs + (np + 3) * 8, load64(&keep + 24));   store64(ys + (np + 3) * 8, load64(&keep + 56));
    }
    return 1;
}

# Point the glyph-zone descriptor at the sub-zone that starts at point `base` and contour `cbase`
# of zone 1 — `n` points (the four phantoms included), `nc` contours whose ends are relative to
# `base` — after copying the descriptor as it was into `save` (ZN_SIZE bytes, ten slots), for
# rekha_hint_subzone_restore. ⛔ ONLY EVER INSTALLED OVER THE TOP-LEVEL DESCRIPTOR: a run never
# nests inside another run, so the pointers offset here are always zone 1's base arrays. This is
# FreeType's tt_prepare_zone (ref2143/ttgload.c:750-764), except that the ends are stored relative
# and no reader subtracts anything — and the `first_point` it records is NOT `base` but the
# caller's business: rekha_hint_run_glyph puts it in HC_FIRSTPT (0 for a simple glyph's program,
# `base` for a composite's).
fn rekha_hint_subzone(ctx, base, cbase, n, nc, save): i64 {
    var zn = ctx + HC_ZONE1;
    var k = 0;
    while (k < 10) { store64(save + k * 8, load64(zn + k * 8)); k = k + 1; }
    store64(zn + ZN_N, n);
    store64(zn + ZN_NC, nc);
    k = ZN_ORUSX;
    while (k <= ZN_CURY) {
        store64(zn + k, load64(save + k) + base * 8);
        k = k + 8;
    }
    store64(zn + ZN_TAGS, load64(save + ZN_TAGS) + base);
    store64(zn + ZN_CTRS, load64(save + ZN_CTRS) + cbase * 8);
    return 0;
}

fn rekha_hint_subzone_restore(ctx, save): i64 {
    var zn = ctx + HC_ZONE1;
    var k = 0;
    while (k < 10) { store64(zn + k * 8, load64(save + k * 8)); k = k + 1; }
    return 0;
}

# What TT_Run_Context does before EVERY program of a load (ref2143/ttinterp.c:7435-7536), each
# component's and the composite's alike: the graphics state to the defaults with the post-`prep`
# snapshot over them, the zone pointers all to the glyph zone, the stack emptied, and the twilight
# bound recomputed for this zone and kept at the load's running minimum. The budget, the call
# depth and the range are rekha_hint_run_range's.
fn rekha_hint_run_begin(ctx): i64 {
    rekha_hint_reset(ctx);
    rekha_hint_gs_restore(ctx);
    var n = rekha_hint_twilight_bound(ctx);
    var cap = load64(ctx + HC_TWCAP);
    if (n > cap) {
        n = cap;
        store64(ctx + HC_ZONE0 + ZN_N, n);
    }
    store64(ctx + HC_TWCAP, n);
    return 0;
}

# Run the glyph program at `off` / `len` of the font bytes over the sub-zone starting at `base`
# with `n` points (phantoms included) and `nc` contours at `cbase`, as the glyph range, with the
# metrics scale `mscale` (HC_SCALE for a simple glyph, 1.0 for a composite) and FreeType's
# `first_point` `first` (HC_FIRSTPT): 0 from rekha_hint_load_simple_at — a simple glyph's program
# is prepared with 0 even as a component (ref2143/ttgload.c:914) — and `base` from
# rekha_hint_load_composite_at (:1240). 1, or 0 with the refusal on the context. The descriptor
# and HC_FIRSTPT are put back either way. ⚠ Nine parameters: the last three go on the stack.
fn rekha_hint_run_glyph(ctx, off, len, base, cbase, n, nc, mscale, first): i64 {
    var save: i64[10];
    rekha_hint_subzone(ctx, base, cbase, n, nc, &save);
    store64(ctx + HC_MSCALE, mscale);
    store64(ctx + HC_FIRSTPT, first);
    rekha_hint_run_begin(ctx);
    var ok = rekha_hint_run_range(ctx, load64(ctx + HC_BUF), off, len, 4);
    store64(ctx + HC_MSCALE, load64(ctx + HC_SCALE));
    store64(ctx + HC_FIRSTPT, 0);
    rekha_hint_subzone_restore(ctx, &save);
    return ok;
}

# ---- FT_Vector_Length, for SCALED_COMPONENT_OFFSET ----
# ⛔ PORTED STEP FOR STEP from ref/fttrigon.c:417-448 (FT_Vector_Length; 2.13.2 = 2.14.3), with its
# three helpers — ft_trig_prenorm :141-165, ft_trig_pseudo_polarize :219-291, ft_trig_downscale
# :62-76 — because an integer square root agrees with this CORDIC on all but 1 in 26,000 of the
# vectors a 2x2 can hold, and the one that differs moves an offset by a 1/64. FT_Hypot (ref2143/
# ftcalc.c:143-152) is this on (x, y).

# The CORDIC's arctangent table (ref/fttrigon.c:47-52), in 16.16 degrees.
fn rekha_hint_trig_atan(i): i64 {
    if (i == 0) { return 1740967; }   if (i == 1) { return 919879; }   if (i == 2) { return 466945; }
    if (i == 3) { return 234379; }    if (i == 4) { return 117304; }   if (i == 5) { return 58666; }
    if (i == 6) { return 29335; }     if (i == 7) { return 14668; }    if (i == 8) { return 7334; }
    if (i == 9) { return 3667; }      if (i == 10) { return 1833; }    if (i == 11) { return 917; }
    if (i == 12) { return 458; }      if (i == 13) { return 229; }     if (i == 14) { return 115; }
    if (i == 15) { return 57; }       if (i == 16) { return 29; }      if (i == 17) { return 14; }
    if (i == 18) { return 7; }        if (i == 19) { return 4; }       if (i == 20) { return 2; }
    return 1;
}

# The length of (x, y) with the rounding FreeType's is measured with. An axis-aligned vector is
# exact; the general case normalises the vector into the CORDIC's safe range (the highest set bit
# of |x| | |y| brought to bit 29), pseudo-polarises it through 22 rotations (the length lands in
# x, scaled by the CORDIC gain), scales that by 0.858785336480436 with a rounding constant, and
# undoes the normalisation. ⚠ The angle the polarisation also computes is not needed and not kept.
fn rekha_hint_vlen(x, y): i64 {
    if (x == 0) {
        if (y < 0) { return 0 - y; }
        return y;
    }
    if (y == 0) {
        if (x < 0) { return 0 - x; }
        return x;
    }
    var ax = x;
    if (ax < 0) { ax = 0 - ax; }
    var ay = y;
    if (ay < 0) { ay = 0 - ay; }
    var shift = rekha_hint_msb((ax | ay) & 0xFFFFFFFF);
    if (shift <= 29) {
        shift = 29 - shift;
        x = x << shift;
        y = y << shift;
    } else {
        shift = shift - 29;
        x = sd_asr(x, shift);
        y = sd_asr(y, shift);
        shift = 0 - shift;
    }
    # into the [-45, 45] degree sector (the quarter turns taken here only matter to the angle)
    var t = 0;
    if (y > x) {
        if (y > (0 - x)) {
            t = y;
            y = 0 - x;
            x = t;
        } else {
            x = 0 - x;
            y = 0 - y;
        }
    } else {
        if (y < (0 - x)) {
            t = 0 - y;
            y = x;
            x = t;
        }
    }
    # 22 pseudo-rotations; the shifts are ARITHMETIC (FT_Fixed is signed)
    var i = 1;
    var b = 1;
    while (i < 23) {
        var xt = 0;
        if (y > 0) {
            xt = x + sd_asr(y + b, i);
            y = y - sd_asr(x + b, i);
        } else {
            xt = x - sd_asr(y + b, i);
            y = y + sd_asr(x + b, i);
        }
        x = xt;
        b = b << 1;
        i = i + 1;
    }
    # downscale by the CORDIC shrink factor 0.858785336480436 * 2^32 (ref/fttrigon.c:37-38, 62-76)
    var neg = 0;
    if (x < 0) { neg = 1; x = 0 - x; }
    x = (x * 0xDBD95B16 + 0x40000000) >> 32;
    if (neg == 1) { x = 0 - x; }
    if (shift > 0) { return sd_asr(x + (1 << (shift - 1)), shift); }
    # the shift < 0 tail (|x| or |y| at or above 2^30) is a 32-bit UNSIGNED shift in FreeType —
    # `(FT_Fixed)((FT_UInt32)v.x << -shift)`, ref/fttrigon.c:447 — so the length is truncated to
    # 32 bits before and after the shift and comes back non-negative; bit-exact, and unreachable
    # from a 2x2 whose entries are F2Dot14 times 4
    return ((x & 0xFFFFFFFF) << (0 - shift)) & 0xFFFFFFFF;
}

# ---- the three loads: empty, simple, composite ----

# An EMPTY glyph at `base` — loca span 0, or numberOfContours 0 — as ref2143/ttgload.c:1535-1541
# and :1594-1608 load it: bbox (0, 0, 0, 0), so pp1 = (-lsb, 0), pp2 = (-lsb + advance, 0), pp3 =
# (0, tsb), pp4 = (0, -ah); the four scaled and NEVER rounded (TT_Hint_Glyph does not run for it —
# which is what makes a USE_MY_METRICS carry from an empty component unrounded, and the empty
# top-level glyph's advance whole only through rekha_hint_advance_px). No points, no contours.
fn rekha_hint_load_empty(ctx, gid, base, lc): i64 {
    if (base + 4 > load64(ctx + HC_GZCAP)) {
        return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph zone cap");
    }
    var zn = ctx + HC_ZONE1;
    var xs = load64(zn + ZN_ORUSX) + base * 8;
    var ys = load64(zn + ZN_ORUSY) + base * 8;
    var tags = load64(zn + ZN_TAGS) + base;
    var k = 0;
    while (k < 4) { store8(tags + k, 0); k = k + 1; }
    rekha_hint_phantoms(ctx, gid, 0, 0, xs, ys);
    rekha_hint_gvar(load64(ctx + HC_FONT), gid, xs, ys, 0, 0, 0);
    rekha_hint_scale_zone(ctx, base, 4);
    store64(lc + LC_NC, 0);
    return 0;
}

# Scale `n` zone-1 points from `base`: cur = FT_MulFix(orus, scale) on both axes (ref2143/
# ttgload.c:958-963), org := cur, tags cleared of everything but the on-curve bit the decoder left.
fn rekha_hint_scale_zone(ctx, base, n): i64 {
    var zn = ctx + HC_ZONE1;
    var sc = load64(ctx + HC_SCALE);
    var ox = load64(zn + ZN_ORUSX);   var oy = load64(zn + ZN_ORUSY);
    var gx = load64(zn + ZN_ORGX);    var gy = load64(zn + ZN_ORGY);
    var cx = load64(zn + ZN_CURX);    var cy = load64(zn + ZN_CURY);
    var i = base;
    while (i < base + n) {
        var x = rekha_hint_mulfix(load64(ox + i * 8), sc);
        var y = rekha_hint_mulfix(load64(oy + i * 8), sc);
        store64(gx + i * 8, x);   store64(gy + i * 8, y);
        store64(cx + i * 8, x);   store64(cy + i * 8, y);
        i = i + 1;
    }
    return 0;
}

# Round the four phantom points at `at` (the first of them) in cur ONLY — pp1.x, pp2.x, pp3.y,
# pp4.y with FT_PIX_ROUND (ref2143/ttgload.c:813-820); org keeps the unrounded scale.
fn rekha_hint_round_phantoms(ctx, at): i64 {
    var zn = ctx + HC_ZONE1;
    var cx = load64(zn + ZN_CURX);
    var cy = load64(zn + ZN_CURY);
    store64(cx + at * 8, rekha_hint_pix_round(load64(cx + at * 8)));
    store64(cx + (at + 1) * 8, rekha_hint_pix_round(load64(cx + (at + 1) * 8)));
    store64(cy + (at + 2) * 8, rekha_hint_pix_round(load64(cy + (at + 2) * 8)));
    store64(cy + (at + 3) * 8, rekha_hint_pix_round(load64(cy + (at + 3) * 8)));
    return 0;
}

# A SIMPLE glyph at `base` / `cbase` — TT_Load_Simple_Glyph, TT_Process_Simple_Glyph and
# TT_Hint_Glyph in order (ref2143/ttgload.c:341-545, 874-1011, 777-860): the header gates and the
# shared decoder put the outline into the zone's font-unit arrays and its on-curve bits into the
# tags; the phantoms follow it; gvar; then every point scaled, org := cur, and — when the load is
# hinting — the phantoms rounded in cur and the glyph's program run on this sub-zone. Under
# INSTCTRL bit 1, and on the reload after a program refused, TT_Hint_Glyph is skipped whole: no
# rounding, no run (:912, :1002). ⚠ org is filled even with no program to run (FreeType leaves
# it stale, :793-794, which nothing observes) so that the zone readers and rekha_hint_run see the
# scaled originals. Answers the point count, or -1.
fn rekha_hint_load_simple_at(ctx, gid, start, end, nc, base, cbase, lc): i64 {
    var font = load64(ctx + HC_FONT);
    var buf = load64(ctx + HC_BUF);
    var h: i64[6];
    if (rekha_glyf_simple_hdr(font, start, end, nc, &h) == 0) {
        return rekha_hint_load_fail(ctx, lc, rekha_font_error(font), rekha_font_error_detail(font));
    }
    var np = load64(&h);
    var pts_left = load64(lc + LC_PTS) - np;
    if (pts_left < 0) { return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph load cap"); }
    store64(lc + LC_PTS, pts_left);
    if (base + np + 4 > load64(ctx + HC_GZCAP)) {
        return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph zone cap");
    }
    if (cbase + nc > load64(ctx + HC_GZCCAP)) {
        return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "contour cap");
    }
    var zn = ctx + HC_ZONE1;
    var xs = load64(zn + ZN_ORUSX) + base * 8;
    var ys = load64(zn + ZN_ORUSY) + base * 8;
    var tags = load64(zn + ZN_TAGS) + base;
    var eps = load64(zn + ZN_CTRS) + cbase * 8;
    var dec = rekha_glyf_decode_simple(buf, &h, nc, eps, xs, ys, tags);
    if (dec == 0) { return rekha_hint_load_fail(ctx, lc, REKHA_ERR_TRUNCATED, "points"); }
    if (dec < 0) { return rekha_hint_load_fail(ctx, lc, REKHA_ERR_BAD_GLYF, "endPts order"); }
    var k = 0;
    while (k < 4) { store8(tags + np + k, 0); k = k + 1; }
    rekha_hint_phantoms(ctx, gid, rekha_rd_i16(buf, start + 2), rekha_rd_i16(buf, start + 8),
      xs + np * 8, ys + np * 8);
    rekha_hint_gvar(font, gid, xs, ys, np, nc, eps);
    rekha_hint_scale_zone(ctx, base, np + 4);
    store64(lc + LC_NC, nc);
    if (load64(lc + LC_HINT) == 0) { return np; }
    rekha_hint_round_phantoms(ctx, base + np);
    var ins_len = load64(&h + 24);
    if (ins_len > 0) {
        var ins_off = load64(&h + 16);
        var sc = load64(ctx + HC_SCALE);
        # first_point 0 whatever `base` is: FreeType prepares a simple glyph's zone on its current
        # glyph, never on the parent's assembly (ref2143/ttgload.c:914)
        if (rekha_hint_run_glyph(ctx, ins_off, ins_len, base, cbase, np + 4, nc, sc, 0) == 0) {
            store64(lc + LC_KIND, 1);
            return 0 - 1;
        }
    }
    return np;
}

# A COMPOSITE glyph at `base` / `cbase` — load_truetype_glyph's composite branch
# (ref2143/ttgload.c:1653-1921) with TT_Process_Composite_Component (:1024-1164) and
# TT_Process_Composite_Glyph (:1178-1249). The records are walked twice with rekha_comp_record:
# once to count them and find the composite's own instruction position, once to load. Per record:
# the component is loaded and hinted at the tail (recursively — a nested composite runs its own
# program on its own sub-zone first); its four phantoms, left just past its points, become the
# composite's under USE_MY_METRICS (un-offset, in the component's own coordinates, rounded and
# program-moved as its run left them, unrounded if it was empty); an empty component is skipped
# whole (:1878-1879); otherwise its points — cur ONLY — go through the record's 2x2 in 16.16 with
# FT_MulFix per term (FT_Vector_Transform; the file's four words are xx, xy, yx, yy in rekha's
# names and rekha's xy multiplies x into y'), then the offset: an XY offset in font units, scaled
# by FT_Hypot of the matrix's columns under SCALED_COMPONENT_OFFSET when the record has any scale
# (the default build ignores UNSCALED, :1086-1091), then by the size's scale, then FT_PIX_ROUND
# under ROUND_XY_TO_GRID while hinting; or point matching — arg1 a point of THIS composite
# assembled so far, arg2 one of the component, on the hinted, transformed pixels, unrounded —
# refused "composite point" past either count. After the records the composite's own phantoms
# (or the carried ones) sit past the points; if the LAST record has WE_HAVE_INSTR, its n_ins is
# not 0 and the components added a point, every component point is untouched, org := cur and
# orus := cur over the whole sub-zone, the phantoms rounded, and the program run at HC_MSCALE 1.0
# (:1902-1913, :796-803) with first_point = `base` (:1240 — 0 at the top level; inside a parent,
# the composite's start point, which only SHZ can observe: see rekha_hint_op_shz for FreeType's
# out-of-bounds walk there and rekha's clamp); else NOTHING more — the phantoms stay unrounded
# and the components' touch bits survive. Answers the point count, or -1.
fn rekha_hint_load_composite_at(ctx, gid, start, end, depth, base, cbase, lc): i64 {
    var font = load64(ctx + HC_FONT);
    var buf = load64(ctx + HC_BUF);
    var zn = ctx + HC_ZONE1;
    var rec: i64[8];
    var n = 0;
    var p = start + 10;
    var more = 1;
    var last_flags = 0;
    while (more != 0) {
        p = rekha_comp_record(buf, p, end, &rec);
        if (p == 0) { return rekha_hint_load_fail(ctx, lc, REKHA_ERR_TRUNCATED, "component"); }
        n = n + 1;
        if (n > load64(lc + LC_LOADS)) {
            return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph load cap");
        }
        last_flags = load64(&rec);
        if ((last_flags & 32) == 0) { more = 0; }
    }
    var ins_pos = p;
    # the composite's own phantoms, in font units, varied through its component offsets.
    # ⛔ INVARIANT: 68 >= REKHA_GLYPH_MAXLOADS + 4 (src/glyf.cyr's load cap, 64). The count loop
    # above refuses once n exceeds LC_LOADS, which is at most REKHA_GLYPH_MAXLOADS - 1 at entry
    # (rekha_hint_load has already taken this glyph's own load), so n <= 63 and the four phantom
    # slots rekha_hint_phantoms writes at n..n+3, and rekha_hint_gvar's n + 4, end at index 66.
    # A Cyrius array length is a literal or an enum constant and the cap is a `var`, so a change
    # to the cap must change this literal with it.
    var cdx: i64[68];
    var cdy: i64[68];
    var k = 0;
    p = start + 10;
    while (k < n) {
        p = rekha_comp_record(buf, p, end, &rec);
        store64(&cdx + k * 8, 0);
        store64(&cdy + k * 8, 0);
        if ((load64(&rec) & 2) != 0) {
            store64(&cdx + k * 8, load64(&rec + 16));
            store64(&cdy + k * 8, load64(&rec + 24));
        }
        k = k + 1;
    }
    rekha_hint_phantoms(ctx, gid, rekha_rd_i16(buf, start + 2), rekha_rd_i16(buf, start + 8),
      &cdx + n * 8, &cdy + n * 8);
    rekha_hint_gvar(font, gid, &cdx, &cdy, n, 0, 0);
    var sc = load64(ctx + HC_SCALE);
    var ppx: i64[4];
    var ppy: i64[4];
    k = 0;
    while (k < 4) {
        store64(&ppx + k * 8, rekha_hint_mulfix(load64(&cdx + (n + k) * 8), sc));
        store64(&ppy + k * 8, rekha_hint_mulfix(load64(&cdy + (n + k) * 8), sc));
        k = k + 1;
    }
    var hinting = load64(lc + LC_HINT);
    var cx = load64(zn + ZN_CURX);
    var cy = load64(zn + ZN_CURY);
    var ctrs = load64(zn + ZN_CTRS);
    var pts = 0;
    var nctr = 0;
    p = start + 10;
    k = 0;
    while (k < n) {
        p = rekha_comp_record(buf, p, end, &rec);
        var flags = load64(&rec);
        var cb = base + pts;
        var m = rekha_hint_load(ctx, load64(&rec + 8), depth + 1, cb, cbase + nctr, lc);
        if (m < 0) { return 0 - 1; }
        var mc = load64(lc + LC_NC);
        if ((flags & 0x200) != 0) {                        # USE_MY_METRICS
            var q = 0;
            while (q < 4) {
                store64(&ppx + q * 8, load64(cx + (cb + m + q) * 8));
                store64(&ppy + q * 8, load64(cy + (cb + m + q) * 8));
                q = q + 1;
            }
        }
        if (m > 0) {
            var xx = load64(&rec + 32) * 4;
            var xy = load64(&rec + 40) * 4;
            var yx = load64(&rec + 48) * 4;
            var yy = load64(&rec + 56) * 4;
            var have_scale = flags & 0xC8;                 # WE_HAVE_A_SCALE | XY_SCALE | 2X2
            if (have_scale != 0) {
                var j = cb;
                while (j < cb + m) {
                    var px = load64(cx + j * 8);
                    var py = load64(cy + j * 8);
                    store64(cx + j * 8, rekha_hint_mulfix(px, xx) + rekha_hint_mulfix(py, yx));
                    store64(cy + j * 8, rekha_hint_mulfix(px, xy) + rekha_hint_mulfix(py, yy));
                    j = j + 1;
                }
            }
            var dx = 0;
            var dy = 0;
            if ((flags & 2) != 0) {                        # ARGS_ARE_XY_VALUES
                dx = load64(&cdx + k * 8);
                dy = load64(&cdy + k * 8);
                if (dx != 0 || dy != 0) {
                    if (have_scale != 0) {
                        if ((flags & 0x800) != 0) {        # SCALED_COMPONENT_OFFSET
                            dx = rekha_hint_mulfix(dx, rekha_hint_vlen(xx, yx));
                            dy = rekha_hint_mulfix(dy, rekha_hint_vlen(yy, xy));
                        }
                    }
                    dx = rekha_hint_mulfix(dx, sc);
                    dy = rekha_hint_mulfix(dy, sc);
                    if ((flags & 4) != 0) {                # ROUND_XY_TO_GRID
                        if (hinting != 0) {
                            dx = rekha_hint_pix_round(dx);
                            dy = rekha_hint_pix_round(dy);
                        }
                    }
                }
            }
            if ((flags & 2) == 0) {                        # point matching
                var pa = load64(&rec + 16);
                var pb = load64(&rec + 24);
                if (pa >= pts) {
                    return rekha_hint_load_fail(ctx, lc, REKHA_ERR_BAD_GLYF, "composite point");
                }
                if (pb >= m) {
                    return rekha_hint_load_fail(ctx, lc, REKHA_ERR_BAD_GLYF, "composite point");
                }
                dx = load64(cx + (base + pa) * 8) - load64(cx + (cb + pb) * 8);
                dy = load64(cy + (base + pa) * 8) - load64(cy + (cb + pb) * 8);
            }
            if (dx != 0 || dy != 0) {
                var j2 = cb;
                while (j2 < cb + m) {
                    store64(cx + j2 * 8, load64(cx + j2 * 8) + dx);
                    store64(cy + j2 * 8, load64(cy + j2 * 8) + dy);
                    j2 = j2 + 1;
                }
            }
            # the component's ends, relative to it, become relative to this composite
            var c = 0;
            while (c < mc) {
                var e = ctrs + (cbase + nctr + c) * 8;
                store64(e, load64(e) + pts);
                c = c + 1;
            }
        }
        pts = pts + m;
        nctr = nctr + mc;
        k = k + 1;
    }
    if (base + pts + 4 > load64(ctx + HC_GZCAP)) {
        return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph zone cap");
    }
    var pts_left = load64(lc + LC_PTS) - pts;
    if (pts_left < 0) { return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph load cap"); }
    store64(lc + LC_PTS, pts_left);
    # the composite's phantoms past its points: cur, org and orus alike, tags clear
    var ox = load64(zn + ZN_ORUSX);   var oy = load64(zn + ZN_ORUSY);
    var gx = load64(zn + ZN_ORGX);    var gy = load64(zn + ZN_ORGY);
    var tags = load64(zn + ZN_TAGS);
    k = 0;
    while (k < 4) {
        var at = base + pts + k;
        store64(cx + at * 8, load64(&ppx + k * 8));   store64(cy + at * 8, load64(&ppy + k * 8));
        store64(gx + at * 8, load64(&ppx + k * 8));   store64(gy + at * 8, load64(&ppy + k * 8));
        store64(ox + at * 8, load64(&ppx + k * 8));   store64(oy + at * 8, load64(&ppy + k * 8));
        store8(tags + at, 0);
        k = k + 1;
    }
    store64(lc + LC_NC, nctr);
    if (hinting == 0) { return pts; }
    if ((last_flags & 0x100) == 0) { return pts; }         # no WE_HAVE_INSTR
    if (pts == 0) { return pts; }
    if (ins_pos + 2 > end) {
        return rekha_hint_load_fail(ctx, lc, REKHA_ERR_TRUNCATED, "composite instructions");
    }
    var n_ins = rekha_rd_u16(buf, ins_pos);
    if (n_ins == 0) { return pts; }
    if (ins_pos + 2 + n_ins > end) {
        return rekha_hint_load_fail(ctx, lc, REKHA_ERR_TRUNCATED, "composite instructions");
    }
    # untouch every component point; the originals become the assembled pixels (:1245-1246, :798-803)
    k = base;
    while (k < base + pts) {
        store8(tags + k, load8(tags + k) & REKHA_TAG_ONCURVE);
        store64(gx + k * 8, load64(cx + k * 8));   store64(gy + k * 8, load64(cy + k * 8));
        store64(ox + k * 8, load64(cx + k * 8));   store64(oy + k * 8, load64(cy + k * 8));
        k = k + 1;
    }
    rekha_hint_round_phantoms(ctx, base + pts);
    # first_point = base: FreeType prepares a composite's zone at its start point in the
    # assembly (ref2143/ttgload.c:1240), which is what its SHZ defect is measured against
    if (rekha_hint_run_glyph(ctx, ins_pos + 2, n_ins, base, cbase, pts + 4, nctr, 0x10000, base) == 0) {
        store64(lc + LC_KIND, 1);
        return 0 - 1;
    }
    return pts;
}

# Load glyph `gid` into zone 1 at point `base` / contour `cbase`, at recursion `depth` — the
# dispatcher of the three loads above, with the caps of rekha_load_glyph_d on the load context:
# depth, loads, a gid already on this component path (a cycle; a sibling reusing a component is
# not one), each a structural refusal "glyph load cap". A gid the font does not have, or a loca /
# glyf the span reader refuses, is refused with the span reader's own code. Answers the points it
# added (0 for an empty glyph, its four phantoms written all the same) with the contour count at
# lc + LC_NC, or -1.
fn rekha_hint_load(ctx, gid, depth, base, cbase, lc): i64 {
    if (depth > REKHA_COMPOSITE_MAXDEPTH) {
        return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph load cap");
    }
    var loads = load64(lc + LC_LOADS);
    if (loads <= 0) { return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph load cap"); }
    var d = 0;
    while (d < depth) {
        if (load64(lc + LC_GIDS + d * 8) == gid) {
            return rekha_hint_load_fail(ctx, lc, REKHA_ERR_OOM, "glyph load cap");
        }
        d = d + 1;
    }
    store64(lc + LC_LOADS, loads - 1);
    store64(lc + LC_GIDS + depth * 8, gid);
    var font = load64(ctx + HC_FONT);
    var span: i64[2];
    if (rekha_glyf_span(font, gid, &span) == 0) {
        if (rekha_font_error(font) != REKHA_OK) {
            return rekha_hint_load_fail(ctx, lc, rekha_font_error(font), rekha_font_error_detail(font));
        }
        return rekha_hint_load_empty(ctx, gid, base, lc);
    }
    var start = load64(&span);
    var end = start + load64(&span + 8);
    if (start + 10 > end) { return rekha_hint_load_fail(ctx, lc, REKHA_ERR_TRUNCATED, "glyf header"); }
    var nc = rekha_rd_i16(load64(ctx + HC_BUF), start);
    if (nc == 0) { return rekha_hint_load_empty(ctx, gid, base, lc); }
    if (nc > 0) { return rekha_hint_load_simple_at(ctx, gid, start, end, nc, base, cbase, lc); }
    return rekha_hint_load_composite_at(ctx, gid, start, end, depth, base, cbase, lc);
}

# ---- the load as a whole ----

# What TT_Load_Context does once per FT_Load_Glyph (ref2143/ttinterp.c:276-300): the control
# values and the storage area back to the SIZE's arrays, forgetting the previous load's private
# copies; the twilight bound back to the font's declaration; the metrics scale to the size's.
fn rekha_hint_load_reset(ctx): i64 {
    store64(ctx + HC_CVT, load64(ctx + HC_CVTS));
    store64(ctx + HC_STORE, load64(ctx + HC_STOS));
    store64(ctx + HC_TWCAP, load64(load64(ctx + HC_FONT) + 800));
    store64(ctx + HC_MSCALE, load64(ctx + HC_SCALE));
    return 0;
}

# The INSTCTRL bits `prep` left, in tt_loader_init's order (ref2143/ttgload.c:2269-2274): bit 1
# is tested FIRST and turns every program and every phantom rounding of THIS load off; then bit 2
# replaces the snapshot with the defaults for this load and every later one until the next
# `prep` — so a prep that set both disables glyph programs for exactly one load. Answers the
# hinting flag.
fn rekha_hint_load_instctrl(ctx): i64 {
    var hinting = 1;
    var ic = load64(ctx + HC_GSSAVE + 56);                  # HC_INSTCTL is the eighth of the ten
    if ((ic & 1) != 0) { hinting = 0; }
    if ((ic & 2) != 0) {
        # rekha_hint_reset's values for the ten, into the snapshot alone (the live state is
        # rebuilt from it before the next run anyway)
        store64(ctx + HC_GSSAVE, 64);        store64(ctx + HC_GSSAVE + 8, 68);
        store64(ctx + HC_GSSAVE + 16, 0);    store64(ctx + HC_GSSAVE + 24, 0);
        store64(ctx + HC_GSSAVE + 32, 1);
        store64(ctx + HC_GSSAVE + 40, 9);    store64(ctx + HC_GSSAVE + 48, 3);
        store64(ctx + HC_GSSAVE + 56, 0);
        store64(ctx + HC_GSSAVE + 64, 0);    store64(ctx + HC_GSSAVE + 72, 0);
    }
    return hinting;
}

# One whole load of `gid` at the top of zone 1 with the load context initialised: the points, or
# -1 with the kind on the context.
fn rekha_hint_load_root(ctx, gid, hinting, lc): i64 {
    store64(lc + LC_LOADS, REKHA_GLYPH_MAXLOADS);
    store64(lc + LC_PTS, REKHA_GLYPH_MAXPOINTS_TOTAL);
    store64(lc + LC_KIND, 0);
    store64(lc + LC_HINT, hinting);
    store64(lc + LC_NC, 0);
    rekha_hint_load_reset(ctx);
    var n = rekha_hint_load(ctx, gid, 0, 0, 0, lc);
    if (n < 0) { return 0 - 1; }
    store64(ctx + HC_ZONE1 + ZN_N, n + 4);
    store64(ctx + HC_ZONE1 + ZN_NC, load64(lc + LC_NC));
    return n;
}

# After a load: every cur.x — the n points AND the four phantoms — translated by minus the left
# phantom's, which is FT_Outline_Translate after the run (ref2143/ttgload.c:2578-2583), so the
# outline's origin is the rounded (and possibly program-moved) pp1 and the advance pp2 - pp1 is
# unchanged; the on-curve bytes from the tags, since FLIPPT may have changed them; the view's
# counts; the gid.
fn rekha_hint_finish(ctx, gid, n): i64 {
    var zn = ctx + HC_ZONE1;
    var cx = load64(zn + ZN_CURX);
    var t = load64(cx + n * 8);
    var i = 0;
    if (t != 0) {
        while (i < n + 4) {
            store64(cx + i * 8, load64(cx + i * 8) - t);
            i = i + 1;
        }
    }
    var tags = load64(zn + ZN_TAGS);
    var oc = load64(ctx + HC_VIEW + 40);
    i = 0;
    while (i < n) {
        store8(oc + i, load8(tags + i) & REKHA_TAG_ONCURVE);
        i = i + 1;
    }
    store64(ctx + HC_VIEW, load64(zn + ZN_NC));
    store64(ctx + HC_VIEW + 8, n);
    store64(ctx + HC_GZGID, gid);
    return 0;
}

# @public — load glyph `gid` into the glyph zone at this context's size and hint it: the outline
# in font units (gvar applied), scaled to F26Dot6, the four phantom points appended from the
# glyph header's bbox and hmtx (and vmtx, else OS/2, else hhea) and rounded to the grid, the
# glyph's program run under FreeType's glyph-range rules with IUP — for a composite each component
# on its own first, then the composite's own program over the assembled pixels — then every x
# translated so that the left phantom is the origin, exactly as FreeType's glyph slot reports it.
# 1 when zone 1 holds what the font's bytecode intends at this size: a glyph with no program, an
# empty glyph (its advance is real), a composite without a program, and a size whose `prep`
# disabled glyph programs through INSTCTRL bit 1 all count. 0 when rekha REFUSED, in one of three
# ways `rekha_hint_error` distinguishes:
#   · a standing `fpgm` / `prep` refusal, re-raised — zone 1 empty, nothing to draw hinted at
#     this size (the consumer draws the run through the unhinted seam);
#   · a PROGRAM refused (REKHA_ERR_BAD_HINT naming the instruction, or a truncated program), in
#     any component's program or the composite's — and then zone 1 holds the glyph RELOADED
#     UNHINTED: scaled, no program run anywhere, phantoms unrounded, translated all the same, so
#     rekha_hint_outline, rekha_hint_to_sdpath and rekha_hint_advance_px still answer, the way
#     FreeType answers a glyph whose programs are off. ⚠ Stated divergence: FreeType outside its
#     pedantic mode keeps that component's PARTIALLY hinted points and carries on; rekha keeps
#     none of the moves (docs/development/roadmap.md);
#   · anything else — a gid the font does not have, a truncated or malformed glyph or component
#     record, a cyclic or over-cap composite, a glyph past the zone's maxp capacity ("glyph zone
#     cap" / "contour cap"), a point-matching index past the assembled points ("composite point")
#     — with zone 1 EMPTY: `rekha_hint_gid` answers -1, the outline is 0 and the path call refuses.
# `rekha_font_error(font)` mirrors the code either way. Allocates nothing.
# ⛔ EVERY CALL INVALIDATES THE PREVIOUS GLYPH, success or not, as does rekha_hint_run_prep and a
# size change through rekha_hint_ctx: the view, the zone and the advance describe the LAST call.
# ⚠ `gasp` is not consulted, exactly as FreeType's loader never consults it: whether to hint at
# this size at all is `rekha_should_gridfit`'s question, and the consumer's.
# ⚠ THE ADVANCE OF A HINTED RUN IS rekha_hint_advance_px's, per glyph, not rekha_glyph_advance_px's:
# a glyph program is free to move the right phantom (Liberation Sans 'H' at 16 ppem is 12 px there
# and 11 here), and a composite with USE_MY_METRICS takes its component's.
# ⚠ Variation instances are hinted OFF-REFERENCE, and stated: the cvt has no `cvar`, and the
# outline's deltas are rounded per tuple and scaled from whole units. The phantoms follow
# FreeType: the advance carries its HVAR delta, the left phantom the UNVARIED lsb
# (rekha_hint_hmetrics) — where rekha_left_side_bearing, the metric reader, applies the lsb map.
# After an axis change call rekha_hint_ctx again, at the same ppem if you like: the setters mark
# the context stale and that call re-runs `prep` for the new instance (rekha_hint_axes_changed).
# A hinted glyph at the default location is bit-exact.
public fn rekha_hint_glyph(ctx, gid): i64 {
    if (ctx == 0) { return 0; }
    var font = load64(ctx + HC_FONT);
    rekha_hint_error_clear(ctx);
    rekha_font_error_clear(font);
    rekha_hint_view_clear(ctx);
    var code = load64(ctx + HC_FPGMERR);
    var det = load64(ctx + HC_FPGMDET);
    if (code == REKHA_OK) {
        code = load64(ctx + HC_PREPERR);
        det = load64(ctx + HC_PREPDET);
    }
    if (code != REKHA_OK) {
        rekha_hint_fail(ctx, code, det);
        return rekha_fail(font, code, det);
    }
    var hinting = rekha_hint_load_instctrl(ctx);
    var lc: i64[12];
    var n = rekha_hint_load_root(ctx, gid, hinting, &lc);
    if (n >= 0) {
        rekha_hint_finish(ctx, gid, n);
        return 1;
    }
    if (load64(&lc + LC_KIND) == 1) {
        # a program refused: the glyph again, with nothing run, and the refusal kept
        code = load64(ctx + HC_ERR);
        det = load64(ctx + HC_DETAIL);
        rekha_hint_error_clear(ctx);
        rekha_font_error_clear(font);
        n = rekha_hint_load_root(ctx, gid, 0, &lc);
        if (n >= 0) {
            rekha_hint_finish(ctx, gid, n);
            rekha_hint_fail(ctx, code, det);
            return rekha_fail(font, code, det);
        }
    }
    rekha_hint_view_clear(ctx);
    return rekha_fail(font, load64(ctx + HC_ERR), load64(ctx + HC_DETAIL));
}

# ⛔ A TEST SEAM, NOT SURFACE — every fn in dist/rekha.cyr links, and the name is kept for the
# suite, but a consumer must not mistake this for rekha_hint_glyph: its view is UNTRANSLATED
# (cur x as scaled, the left phantom wherever hmtx put it, never moved to the origin) and no
# program has run, so it is meaningful only to a caller that runs bytes itself and translates by
# cur[pp1].x itself. It is the fill of a SIMPLE glyph exactly as TT_Hint_Glyph finds it before
# the run — orus, scale, phantoms, org, the phantoms rounded, tags, HC_GZGID, the view — on a
# context ready to run bytes: the load's pointers reset, the graphics state restored from the
# snapshot, the stack empty. programs/hint_test.cyr's group K loads the unit font's glyph through
# it and runs FreeType-measured bytes through rekha_hint_run (range 3). An EMPTY gid loads its
# four phantoms UNROUNDED, as rekha_hint_glyph leaves them: TT_Hint_Glyph, and with it the phantom
# rounding, never runs for an empty glyph (ref2143/ttgload.c:1535-1541, 1597-1608). A composite
# is refused (REKHA_ERR_OTHER "simple glyph"), as is anything rekha_hint_glyph refuses
# structurally. 1 or 0. Not @public.
fn rekha_hint_load_simple(ctx, gid): i64 {
    if (ctx == 0) { return 0; }
    var font = load64(ctx + HC_FONT);
    rekha_hint_error_clear(ctx);
    rekha_hint_view_clear(ctx);
    var code = load64(ctx + HC_FPGMERR);
    var det = load64(ctx + HC_FPGMDET);
    if (code == REKHA_OK) {
        code = load64(ctx + HC_PREPERR);
        det = load64(ctx + HC_PREPDET);
    }
    if (code != REKHA_OK) { return rekha_hint_fail(ctx, code, det); }
    rekha_hint_load_instctrl(ctx);
    var lc: i64[12];
    store64(&lc + LC_LOADS, REKHA_GLYPH_MAXLOADS);
    store64(&lc + LC_PTS, REKHA_GLYPH_MAXPOINTS_TOTAL);
    store64(&lc + LC_KIND, 0);
    store64(&lc + LC_HINT, 0);
    store64(&lc + LC_NC, 0);
    rekha_hint_load_reset(ctx);
    var span: i64[2];
    var n = 0 - 2;
    var empty = 0;
    if (rekha_glyf_span(font, gid, &span) == 0) {
        if (rekha_font_error(font) != REKHA_OK) {
            return rekha_hint_fail(ctx, rekha_font_error(font), rekha_font_error_detail(font));
        }
        n = rekha_hint_load_empty(ctx, gid, 0, &lc);
        empty = 1;
    }
    if (n == (0 - 2)) {
        var start = load64(&span);
        var end = start + load64(&span + 8);
        if (start + 10 > end) { return rekha_hint_fail(ctx, REKHA_ERR_TRUNCATED, "glyf header"); }
        var nc = rekha_rd_i16(load64(ctx + HC_BUF), start);
        if (nc < 0) { return rekha_hint_fail(ctx, REKHA_ERR_OTHER, "simple glyph"); }
        if (nc == 0) { n = rekha_hint_load_empty(ctx, gid, 0, &lc); empty = 1; }
        if (nc > 0) { n = rekha_hint_load_simple_at(ctx, gid, start, end, nc, 0, 0, &lc); }
    }
    if (n < 0) { return 0; }
    # the rounding TT_Hint_Glyph would do before the run — not for an empty glyph, for which it
    # never runs (rekha_hint_load_empty)
    if (empty == 0) { rekha_hint_round_phantoms(ctx, n); }
    store64(ctx + HC_ZONE1 + ZN_N, n + 4);
    store64(ctx + HC_ZONE1 + ZN_NC, load64(&lc + LC_NC));
    rekha_hint_run_begin(ctx);
    var tags = load64(ctx + HC_ZONE1 + ZN_TAGS);
    var oc = load64(ctx + HC_VIEW + 40);
    var i = 0;
    while (i < n) {
        store8(oc + i, load8(tags + i) & REKHA_TAG_ONCURVE);
        i = i + 1;
    }
    store64(ctx + HC_VIEW, load64(&lc + LC_NC));
    store64(ctx + HC_VIEW + 8, n);
    store64(ctx + HC_GZGID, gid);
    return 1;
}

# @public — the loaded glyph as a RekhaOutline VIEW into zone 1: n_points EXCLUDING the four
# phantoms, n_contours, end_pts (absolute, phantoms never inside), xs / ys = the zone's cur in
# F26Dot6 with x translated so that the left phantom is the origin, on_curve one byte per point.
# The record lives in the context and is REWRITTEN BY EVERY rekha_hint_glyph, rekha_hint_run_prep
# and size change: read it before the next, never keep it. 0 for a null context or when no glyph
# is loaded (rekha_hint_gid is -1). It goes through rekha_outline_to_sdpath with scale 1024 —
# F26Dot6 times 1024 IS 16.16 exactly — which is what rekha_hint_to_sdpath does.
# ⚠ The on-curve byte is the tag's bit 0 alone. The touch bits a program left (REKHA_TAG_TOUCHX /
# TOUCHY, rekha_hint_point's REKHA_PT_TAGS) are the zone's; FreeType's outline tags carry them as
# 8 / 16 and, on the first point of every instructed glyph, a scan-mode marker rekha does not
# keep — the oracle masks FreeType's byte with 0x19 to compare.
public fn rekha_hint_outline(ctx): i64 {
    if (ctx == 0) { return 0; }
    if (load64(ctx + HC_GZGID) < 0) { return 0; }
    return ctx + HC_VIEW;
}

# @public — the gid zone 1 holds, or -1 when it holds no glyph.
public fn rekha_hint_gid(ctx): i64 {
    if (ctx == 0) { return 0 - 1; }
    return load64(ctx + HC_GZGID);
}

# @public — the loaded glyph as a positioned sadish SdPath: sd_x = ox + cur_x * 1024, sd_y = oy -
# cur_y * 1024 (F26Dot6 to 16.16, y flipped), so pass ox / oy on WHOLE PIXELS (n << 16) or the fit
# the program made is lost. A fresh path each call, exactly sized; an empty glyph gives an empty
# path with its advance still on rekha_hint_advance_px. 0 for a null context or no glyph loaded
# (REKHA_ERR_OTHER "no glyph" on the context and the font, nothing allocated) and when an
# allocation is refused (REKHA_ERR_OOM "sdpath") — never a truncated path.
public fn rekha_hint_to_sdpath(ctx, ox, oy): i64 {
    if (ctx == 0) { return 0; }
    var font = load64(ctx + HC_FONT);
    if (load64(ctx + HC_GZGID) < 0) {
        rekha_hint_fail(ctx, REKHA_ERR_OTHER, "no glyph");
        return rekha_fail(font, REKHA_ERR_OTHER, "no glyph");
    }
    var p = rekha_outline_to_sdpath(ctx + HC_VIEW, 1024, ox, oy);
    if (p == 0) {
        rekha_hint_fail(ctx, REKHA_ERR_OOM, "sdpath");
        return rekha_fail(font, REKHA_ERR_OOM, "sdpath");
    }
    return p;
}

# @public — the advance the loaded glyph was fitted to, in WHOLE PIXELS: the right phantom minus
# the left, rounded to the grid the way FreeType's base layer rounds a hinted slot's advance
# (ft_glyphslot_grid_fit_metrics, ref2143/ftobjs.c:898, FT_PIX_ROUND). THIS is what a hinted run
# adds to its pen for every glyph — a program may have moved the right phantom, a USE_MY_METRICS
# composite carries its component's, an empty glyph and a program-less composite are whole only
# through this rounding. 0 for a null context or no glyph loaded.
# ⚠ `hdmx` IS NOT READ, AND THIS IS WHERE IT WOULD MATTER (a roadmap pin): on a face with an
# hdmx and a ppem it lists, FreeType reports the table's byte as the hinted slot's advance
# (ref2143/ttgload.c:2302-2313 picks the size's device record for a hinted, non-fixed-pitch load
# and :1974-1975 takes the advance from it instead of pp2 - pp1), where this answers the hinted
# phantom distance — equal only when the table is a faithful cache of the programs. Unmeasured
# on the host, which has no hinted hdmx face; the embedded face carries none.
public fn rekha_hint_advance_px(ctx): i64 {
    if (ctx == 0) { return 0; }
    if (load64(ctx + HC_GZGID) < 0) { return 0; }
    var zn = ctx + HC_ZONE1;
    var n = load64(zn + ZN_N) - 4;
    if (n < 0) { return 0; }
    var cx = load64(zn + ZN_CURX);
    var d = load64(cx + (n + 1) * 8) - load64(cx + n * 8);
    return rekha_hint_pix_round(d) / 64;
}

# ================================================================
# Reading the graphics state.
# ⭐ ONE ACCESSOR, NOT TWENTY-SEVEN. The fields are laid out in this exact order from HC_PVX, so an
# index IS the offset, and a surface frozen at 0.9.0 gained one name instead of a getter per
# field. ⚠ The bytecode can read four of these itself (GPV, GFV, and MPPEM / MPS for the size);
# the other twenty-three are write-only from inside a program, which is why a consumer — or a
# test — that wants to see what `prep` decided needs this.
# ================================================================

# @public — the field indices rekha_hint_gs takes, and REKHA_GS_COUNT, their bound. ⛔ Frozen
# with their values: the order of the graphics-state slots is part of the promise.
public var REKHA_GS_PVX        = 0;    # projection vector, F2Dot14
public var REKHA_GS_PVY        = 1;
public var REKHA_GS_FVX        = 2;    # freedom vector
public var REKHA_GS_FVY        = 3;
public var REKHA_GS_DVX        = 4;    # dual projection vector
public var REKHA_GS_DVY        = 5;
public var REKHA_GS_RP0        = 6;    # the three reference points
public var REKHA_GS_RP1        = 7;
public var REKHA_GS_RP2        = 8;
public var REKHA_GS_ZP0        = 9;    # the three zone pointers: 0 twilight, 1 glyph
public var REKHA_GS_ZP1        = 10;
public var REKHA_GS_ZP2        = 11;
public var REKHA_GS_LOOP       = 12;
public var REKHA_GS_ROUND      = 13;   # one of the REKHA_RND_* states
public var REKHA_GS_PERIOD     = 14;   # SROUND's decomposition, all three F26Dot6
public var REKHA_GS_PHASE      = 15;
public var REKHA_GS_THRESHOLD  = 16;
public var REKHA_GS_MINDIST    = 17;   # F26Dot6
public var REKHA_GS_CVTCUTIN   = 18;   # F26Dot6
public var REKHA_GS_SWCUTIN    = 19;   # F26Dot6
public var REKHA_GS_SWVALUE    = 20;   # F26Dot6, scaled from font units by SSW
public var REKHA_GS_AUTOFLIP   = 21;
public var REKHA_GS_DELTABASE  = 22;   # unsigned 16-bit, as SDB stores it (FreeType's FT_UShort delta_base)
public var REKHA_GS_DELTASHIFT = 23;
public var REKHA_GS_INSTCTRL   = 24;
public var REKHA_GS_SCANCTRL   = 25;
public var REKHA_GS_SCANTYPE   = 26;
public var REKHA_GS_COUNT      = 27;

# @public — one graphics-state field by its REKHA_GS_* index. 0 for a null context or an index
# outside the set, which is also a legal value for most of them.
public fn rekha_hint_gs(ctx, field): i64 {
    if (ctx == 0) { return 0; }
    if (field < 0) { return 0; }
    if (field >= REKHA_GS_COUNT) { return 0; }
    return load64(ctx + HC_PVX + field * 8);
}

# ================================================================
# Reading the zones.
# ⭐ ONE ACCESSOR AGAIN, in the rekha_hint_gs shape: a zone (0 twilight, 1 glyph), a point, and a
# REKHA_PT_* field. Nothing inside a program can read a twilight point's tags or a point's
# font-unit position back, and a consumer — or programs/hint_test.cyr — that wants to see what
# `prep` planted in the twilight zone, or where a program left a point, needs this.
# ================================================================

# @public — one field of point `i` of zone `zone`. 0 for a null context, a zone other than 0 or
# 1, a point the zone does not have, or a field outside REKHA_PT_*; 0 is also a legal value for
# every field. The glyph zone holds nothing until rekha_hint_glyph (or rekha_hint_load_simple)
# loads a glyph into it, and then its n real points followed by the four phantom points, cur x
# already translated so that the left phantom is the origin after rekha_hint_glyph.
public fn rekha_hint_point(ctx, zone, i, field): i64 {
    if (ctx == 0) { return 0; }
    if (zone < 0) { return 0; }
    if (zone > 1) { return 0; }
    if (field < 0) { return 0; }
    if (field >= REKHA_PT_COUNT) { return 0; }
    var zn = rekha_hint_zone(ctx, zone);
    if (i < 0) { return 0; }
    if (i >= load64(zn + ZN_N)) { return 0; }
    if (field == REKHA_PT_TAGS) { return load8(load64(zn + ZN_TAGS) + i); }
    return load64(load64(zn + ZN_ORUSX + field * 8) + i * 8);
}

# @public — how many points a zone holds, and how many contours. For the twilight zone the point
# count is the per-run bound (see rekha_hint_twilight_bound) and the contour count 0; for the
# glyph zone both are 0 until a glyph is loaded, the four phantom points included when one is (an
# empty glyph holds exactly four).
public fn rekha_hint_zone_points(ctx, zone): i64 {
    if (ctx == 0) { return 0; }
    if (zone < 0) { return 0; }
    if (zone > 1) { return 0; }
    return load64(rekha_hint_zone(ctx, zone) + ZN_N);
}

# @public — how many contours the zone holds (the twilight zone: 0).
public fn rekha_hint_zone_contours(ctx, zone): i64 {
    if (ctx == 0) { return 0; }
    if (zone < 0) { return 0; }
    if (zone > 1) { return 0; }
    return load64(rekha_hint_zone(ctx, zone) + ZN_NC);
}
